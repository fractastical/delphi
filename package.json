{
  "name": "delphisci-mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "MCP server and CLI for querying delphisci claims (nanopubs, math, assessment rankings, the claim graph's truth scores) and the project's versioned Lean laws (lean_* tools).",
  "bin": {
    "delphisci-mcp": "mcp/server.mjs"
  },
  "files": [
    "mcp/*.mjs",
    "docs/claims.json",
    "test-data/organisms/merged/*.json",
    "test-data/*/nanopubs/unsigned/*.trig",
    "test-data/*/nanopubs/*-unsigned/*.trig",
    "claim-sources/*/nanopubs/unsigned/*.trig",
    "claim-sources/*/nanopubs/*-unsigned/*.trig",
    "lib/lean-source.mjs",
    "lib/lean-scope.mjs",
    "sim-engine/tools/lean-tools.mjs",
    "sim-engine/lib/envelope.mjs",
    "sim-engine/lean-cli.mjs",
    "lean/registry/registry-lib.mjs",
    "lean/registry/laws/*.json",
    "lean/registry/lawsets/*.json",
    "lean/laws.json",
    "lean/constraints.json",
    "lean/empirical.json",
    "lean/eliminate/browser-check.mjs",
    "lean/Delphi/**/*.lean"
  ],
  "scripts": {
    "mcp": "node mcp/server.mjs",
    "cli": "node mcp/cli.mjs",
    "forum": "node --no-warnings forum/server.mjs",
    "forum:seed": "node --no-warnings forum/seed.mjs",
    "forum:harvest": "node scripts/forum/harvest.mjs",
    "claims:manifest": "node scripts/exec/build-manifest.mjs",
    "claims:exec": "node scripts/exec/run.mjs",
    "status": "node scripts/release/status.mjs",
    "export:claims": "node scripts/site/build-export.mjs",
    "mcp:usage": "node scripts/usage/mcp-usage.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "oxigraph": "^0.5.13",
    "zod": "^4.6.7"
  }
}
