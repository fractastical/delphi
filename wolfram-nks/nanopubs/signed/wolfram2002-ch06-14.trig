sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch06-14> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The randomness of class 3 systems is not merely inherited from random initial conditions: random behavior can be generated even when the initial conditions contain no randomness at all.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Class 3 randomness can arise without randomness in initial conditions";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Randomness in Class 3 Systems” (from p. 261), p. 261. Scope: class 3 cellular automata such as rule 30 and rule 22"
}
