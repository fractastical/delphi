sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch09-24> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In a large network approximating d-dimensional space, the leading correction to the number of nodes reached within distance r is proportional to the Ricci scalar curvature times r^(d+1), so curvature can be determined purely from network connectivity.";
    dc:type "mathematical";
    <http://www.w3.org/2000/01/rdf-schema#label> "Network curvature appears in node counts via the Ricci scalar";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “The Phenomenon of Gravity” (from p. 530), p. 533. Scope: large networks approximating curved Riemannian spaces"
}
