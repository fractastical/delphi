<https://w3id.org/delphi/resource/claim/wolfram2002-ch04-13> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Beyond square roots, almost all cube roots, fourth roots, logarithms and exponentials of simple numbers also have apparently random digit sequences.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Cube roots, logarithms and exponentials also have random-looking digits";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Mathematical Constants” (from p. 136), p. 141. Scope: digit sequences of higher roots, logarithms and exponentials of small integers"
}
