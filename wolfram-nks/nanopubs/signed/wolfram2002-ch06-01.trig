sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch06-01> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Many simple-rule systems such as cellular automata, when started from completely random initial conditions, spontaneously organize themselves and produce behavior with many distinctly non-random features.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Simple systems self-organize from random initial conditions";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “The Emergence of Order” (from p. 223), p. 223. Scope: cellular automata and similar simple programs started from random initial conditions"
}
