sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch12-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Whereas solving pure polynomial equations allows no computation beyond that of ordinary discrete systems, once trigonometric functions are allowed one can construct equations whose solution is equivalent to finding the outcome of infinitely many steps of a system like a cellular automaton.";
    dc:type "mathematical";
    <http://www.w3.org/2000/01/rdf-schema#label> "Equations with trigonometric functions can encode infinite computations";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “The Validity of the Principle” (from p. 726), pp. 731–732. Scope: equations built from standard mathematical functions"
}
