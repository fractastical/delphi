sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch04-25> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Complex behavior of the kind seen in simple programs is not restricted to discrete systems: some fairly simple partial differential equations, found by searching, produce highly complex patterns, even with apparently discrete patches.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Simple partial differential equations can show complex behavior";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Partial Differential Equations” (from p. 161), p. 164. Scope: one-dimensional nonlinear partial differential equations"
}
