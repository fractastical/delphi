sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch03-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Two-color Turing machines with four head states can produce seemingly random behavior (about five in every million such rules), and allowing more than four states makes apparent randomness only slightly more common without changing the kinds of behavior seen.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Four head states suffice for random-looking Turing machine behavior";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 3, “The World of Simple Programs”; section “Turing Machines” (from p. 78), p. 79. Scope: two-color Turing machines with four or more head states, blank initial tape"
}
