sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch06-18> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "It is common for a cellular automaton to have special initial conditions under which it behaves exactly like some other cellular automaton; for example rule 126 behaves like rule 90 when started from paired-cell blocks, and class 3 rules can thereby act like class 2 rules.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Special initial conditions often make one cellular automaton emulate another";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Special Initial Conditions” (from p. 266), p. 269. Scope: cellular automata and their block emulations"
}
