sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch03-14> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Some cyclic tag systems with two alternating blocks, started from a single black element, produce sequences whose average growth is steady but whose fluctuations about that growth are in many respects random.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Simple cyclic tag systems show random fluctuations in sequence growth";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 3, “The World of Simple Programs”; section “Cyclic Tag Systems” (from p. 95), p. 95. Scope: cyclic tag systems with two blocks"
}
