sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch06-22> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "A crucial feature of any class 4 cellular automaton is that, although most structures that form eventually die out, there must always be certain structures that can persist forever in it.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Class 4 systems always have structures that persist forever";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Structures in Class 4 Systems” (from p. 281), p. 281. Scope: class 4 cellular automata"
}
