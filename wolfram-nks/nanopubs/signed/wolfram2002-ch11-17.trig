sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch11-17> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Any cellular automaton showing class 4 behavior (localized structures moving and interacting in complicated ways) will, like rule 110, turn out to be universal, because such rules eventually yield localized structures rich enough to support universality.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "All class 4 cellular automata are expected to be universal";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “Class 4 Behavior and Universality” (from p. 691), p. 691. Scope: class 4 cellular automata"
}
