sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch03-19> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Systems with sufficiently simple rules show only repetition, slightly more complicated rules often add nesting, and complex behavior requires crossing a threshold in rule complexity, but in every kind of system studied this threshold is extremely low.";
    dc:type "general-principle";
    <http://www.w3.org/2000/01/rdf-schema#label> "The rule-complexity threshold for complex behavior is very low";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 3, “The World of Simple Programs”; section “Some Conclusions” (from p. 105), p. 106. Scope: all kinds of simple programs"
}
