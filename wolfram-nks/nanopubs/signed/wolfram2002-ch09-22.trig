sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch09-22> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Elementary particles are analogs of the localized structures seen in class 4 cellular automata: persistent structures (such as tangles or non-planar cores) in the network of space, so that the fundamental rules need make no reference to particular particles.";
    dc:type "physical-hypothesis";
    <http://www.w3.org/2000/01/rdf-schema#label> "Elementary particles are persistent localized structures in the network";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “Elementary Particles” (from p. 525), p. 525. Scope: elementary particles of physics"
}
