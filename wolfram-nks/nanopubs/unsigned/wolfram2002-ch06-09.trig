sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-09> a delphi:Claim ;
    rdfs:label "The four classes respond differently to small changes in initial conditions" ;
    dct:description "Changing one cell of the initial condition has characteristically different effects by class: in class 1 the change dies out, in class 2 it stays localized, in class 3 it spreads at a uniform rate to affect the whole system, and in class 4 it spreads only sporadically." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Sensitivity to Initial Conditions” (from p. 250), p. 250. Scope: cellular automata of all four classes" ;
    dct:type "computational-observation" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <http://www.wikidata.org/entity/Q60413467> , sub:quote ;
