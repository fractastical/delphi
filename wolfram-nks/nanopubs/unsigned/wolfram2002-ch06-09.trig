    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "In class 1, changes always die out, and in fact exactly the same final state is reached regardless of what initial conditions were used. In class 2, changes may persist, but they always remain localized in a small region of the system." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q60413467> ;
    prov:hadPrimarySource <https://www.wolframscience.com/nks/p250--sensitivity-to-initial-conditions/> ;
