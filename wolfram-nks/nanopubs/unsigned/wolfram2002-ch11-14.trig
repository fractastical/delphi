sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-14> a delphi:Claim ;
    rdfs:label "Elementary cellular automaton rule 110 is universal" ;
    dct:description "Rule 110, a two-color nearest-neighbor elementary cellular automaton, is universal: by arranging its naturally occurring localized structures as components, it can be made to emulate any cyclic tag system, and hence any Turing machine." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “The Rule 110 Cellular Automaton” (from p. 675), p. 678. Scope: the rule 110 elementary cellular automaton" ;
    dct:type "mathematical" .
}

