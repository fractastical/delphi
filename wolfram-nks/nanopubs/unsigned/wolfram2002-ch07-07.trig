sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-07> a delphi:Claim ;
    rdfs:label "Maximal-period linear congruential generators still show strong nonrandomness" ;
    dct:description "Linear congruential random number generators designed to have maximal repetition period have repeatedly turned out to deviate substantially from perfect randomness (for example, successive outputs plotted as points fall on regular stripes), because the mathematical tractability that guarantees their period also implies regularity." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 7, “Mechanisms in Programs and Nature”; section “The Intrinsic Generation of Randomness” (from p. 315), p. 318. Scope: linear congruential pseudorandom number generators" ;
    dct:type "computational-observation" .
}

