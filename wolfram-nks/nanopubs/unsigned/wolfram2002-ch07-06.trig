sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-06> a delphi:Claim ;
    rdfs:label "Solar system motion should show sensitive dependence over millions of years" ;
    dct:description "Although planetary motion looks regular on human timescales, sensitive dependence on initial conditions should ultimately occur in the solar system, producing significant randomness over a few million years that may explain some present-day features of the solar system." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 7, “Mechanisms in Programs and Nature”; section “Chaos Theory and Randomness from Initial Conditions” (from p. 304), p. 314. Scope: orbital dynamics of planets and other bodies in the solar system" ;
    dct:type "prediction" .
}

