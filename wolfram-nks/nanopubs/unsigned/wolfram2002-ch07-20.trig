sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-20> a delphi:Claim ;
    rdfs:label "Rule complexity does not determine behavioral complexity" ;
    dct:description "There is no direct correspondence between the complexity of a system's underlying rules and the complexity of its behavior: some of the simplest rules yield highly complex behavior, fairly complicated rules often yield simple behavior, and rules differing at a single position can behave very differently." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 7, “Mechanisms in Programs and Nature”; section “Origins of Simple Behavior” (from p. 351), p. 351. Scope: simple programs such as cellular automata, and by extension natural systems" ;
    dct:type "computational-observation" .
}

