    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Traditional intuition might have made one assume that there must be a direct correspondence between the complexity of observed behavior and the complexity of underlying rules. But one of the central discoveries of this book is that in fact there is not." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q60413467> ;
    prov:hadPrimarySource <https://www.wolframscience.com/nks/p351--origins-of-simple-behavior/> ;
