sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-01> a delphi:Claim ;
    rdfs:label "Simple systems self-organize from random initial conditions" ;
    dct:description "Many simple-rule systems such as cellular automata, when started from completely random initial conditions, spontaneously organize themselves and produce behavior with many distinctly non-random features." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “The Emergence of Order” (from p. 223), p. 223. Scope: cellular automata and similar simple programs started from random initial conditions" ;
    dct:type "computational-observation" .
}

