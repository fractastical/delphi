sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-06> a delphi:Claim ;
    rdfs:label "Non-local arithmetic rules still behave like local cellular automata" ;
    dct:description "Although arithmetic operations are non-local in digits (carries can propagate arbitrarily far) while cellular automaton rules are local, the overall behavior of number-based systems is very similar to that of cellular automata, so the details of underlying rules do not crucially affect the kinds of behavior that occur." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Elementary Arithmetic” (from p. 117), p. 125. Scope: number-based systems compared with cellular automata and other simple programs" ;
    dct:type "general-principle" .
}

