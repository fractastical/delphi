sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-31> a delphi:Claim ;
    rdfs:label "All 3-state 2-color Turing machines behave simply from blank tape" ;
    dct:description "With blank initial conditions all 2,985,984 Turing machines with 3 states and 2 colors quickly produce simple repetitive or nested behavior, and even with more complicated initial conditions their behavior eventually seems to resolve into a simple form." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “Universality in Turing Machines and Other Systems” (from p. 706), p. 710. Scope: 3-state 2-color Turing machines" ;
    dct:type "computational-observation" .
}

