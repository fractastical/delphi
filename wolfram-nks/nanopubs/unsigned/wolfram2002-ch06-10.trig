sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-10> a delphi:Claim ;
    rdfs:label "Natural systems can be understood by how they handle information" ;
    dct:description "Some of the most important features of natural systems can often be understood just by identifying which cellular automaton class their handling of information (forgetting, localized retention, long-range communication) corresponds to." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Sensitivity to Initial Conditions” (from p. 250), p. 252. Scope: natural systems in general" ;
    dct:type "general-principle" .
}

