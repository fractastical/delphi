sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-06> a delphi:Claim ;
    rdfs:label "Rule 30 from a single cell contains every possible block" ;
    dct:description "The pattern generated by the rule 30 cellular automaton from a single black cell appears to contain every possible block of cells eventually, so that essentially any possible computation exists somewhere within this single pattern." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “The Content of the Principle” (from p. 719), p. 725. Scope: rule 30 elementary cellular automaton started from a single black cell" ;
    dct:type "computational-observation" .
}

