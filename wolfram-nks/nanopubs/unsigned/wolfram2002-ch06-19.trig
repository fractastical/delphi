sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-19> a delphi:Claim ;
    rdfs:label "Nested patterns arise from rules that emulate themselves" ;
    dct:description "A cellular automaton whose blocks of cells evolve by the same rule as individual cells must produce patterns that are either essentially uniform or nested; this self-emulation is why rule 90 and rules that emulate it produce nested patterns." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Special Initial Conditions” (from p. 266), p. 271. Scope: self-emulating cellular automata" ;
    dct:type "mathematical" .
}

