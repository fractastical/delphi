sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-13> a delphi:Claim ;
    rdfs:label "Genetic programs for complex pigment patterns are short" ;
    dct:description "The genetic programs that generate patterns such as those on mollusc shells are short, as indicated by the large variety of patterns within species, and molecular biology should be able to isolate them and confirm their brevity." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “Fundamental Issues in Biology” (from p. 383), p. 390. Scope: genetic control of pigmentation patterns, especially on mollusc shells" ;
    dct:type "prediction" .
}

