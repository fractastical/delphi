sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-26> a delphi:Claim ;
    rdfs:label "Perhaps as many as 27 of the 256 elementary rules are universal" ;
    dct:description "Since elementary cellular automata whose behavior looks complex can do computations as sophisticated as desired, they are expected to be universal, so perhaps as many as 27 of the 256 elementary rules are universal." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “The Threshold of Universality in Cellular Automata” (from p. 694), p. 705. Scope: the 256 elementary cellular automata" ;
    dct:type "prediction" .
}

