sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-22> a delphi:Claim ;
    rdfs:label "Constraint-like equations helped hide complexity from traditional science" ;
    dct:description "Because describing complex behavior with constraints requires fairly complicated constraints, the traditional focus of science and mathematics on equations that act like constraints is another reason they failed to identify the phenomenon of complexity." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Systems Based on Constraints” (from p. 210), p. 221. Scope: methods of traditional science and mathematics" ;
    dct:type "conceptual" .
}

