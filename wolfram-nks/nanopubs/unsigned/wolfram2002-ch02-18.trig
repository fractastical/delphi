sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-18> a delphi:Claim ;
    rdfs:label "Complexity from simple programs was never discovered before despite many hints" ;
    dct:description "Although there were many hints over several centuries, including primes, digits of pi, iterated maps and the Game of Life, the basic phenomenon of simple programs producing complex behavior was never identified before Wolfram's work." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 2, “The Crucial Experiment”; section “Why These Discoveries Were Not Made Before” (from p. 42), p. 50. Scope: history of science and mathematics" ;
    dct:type "conceptual" .
}

