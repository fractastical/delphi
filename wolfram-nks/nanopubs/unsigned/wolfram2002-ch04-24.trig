sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-24> a delphi:Claim ;
    rdfs:label "Partial differential equations predominate largely by historical accident" ;
    dct:description "The dominance of partial differential equations as models in science is in many respects a historical accident of their being solvable by explicit formulas before computers; had computers come earlier, scientific modeling would probably be very different." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Partial Differential Equations” (from p. 161), p. 162. Scope: history of mathematical modeling in physics and other sciences" ;
    dct:type "conceptual" .
}

