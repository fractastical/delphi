sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-19> a delphi:Claim ;
    rdfs:label "Plant branching patterns come from simple substitution-system growth rules" ;
    dct:description "The overall branching patterns of plants, from algae to ferns to trees and flowering plants, are produced by simple growth rules in which each stem tip repeatedly splits into smaller copies of itself at fixed relative lengths and angles." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “Growth of Plants and Animals” (from p. 400), p. 401. Scope: overall branching architecture of plants" ;
    dct:type "model-of-nature" .
}

