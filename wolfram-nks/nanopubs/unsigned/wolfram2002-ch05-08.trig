sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-08> a delphi:Claim ;
    rdfs:label "Fractal geometry misses complexity by excluding interactions between elements" ;
    dct:description "Traditional fractal geometry does not consider interactions between elements, which is why all patterns it produces are purely nested; allowing replacements to depend on neighbors on a grid readily yields complicated, non-nested patterns." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Substitution Systems and Fractals” (from p. 187), p. 190. Scope: fractal geometry and two-dimensional neighbor-dependent substitution systems" ;
    dct:type "conceptual" .
}

