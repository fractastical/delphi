sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-13> a delphi:Claim ;
    rdfs:label "Past the threshold of universality, more complex rules add no capability" ;
    dct:description "As systems of a given type are given progressively greater computational capabilities they eventually pass a threshold of universality, after which the set of computations they can perform is always the same, so more sophisticated rules gain nothing further and a universal system's capabilities are independent of the details of its construction." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “The Rule 110 Cellular Automaton” (from p. 675), p. 675. Scope: all universal systems, of any type" ;
    dct:type "general-principle" .
}

