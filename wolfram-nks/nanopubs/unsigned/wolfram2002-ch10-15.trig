sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-15> a delphi:Claim ;
    rdfs:label "Rule 30 center column and digits of pi pass statistical tests for randomness" ;
    dct:description "The center column of the rule 30 cellular automaton and the base 2 digits of pi show no detectable deviation from randomness under block-frequency statistics or under analysis by simple cellular automata, even though both are generated by simple rules." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Statistical Analysis” (from p. 588), p. 596. Scope: the rule 30 center-column sequence and the binary expansion of pi" ;
    dct:type "computational-observation" .
}

