sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-25> a delphi:Claim ;
    rdfs:label "Complex elementary rules can emulate one step of every elementary rule" ;
    dct:description "Using block encodings, elementary rules with complex behavior such as rules 22, 30 and 110 can be made to emulate a single step of all 256 elementary cellular automata, whereas rules with simple behavior such as 90 and 184 can emulate only a few; this supports the idea that complex-looking cellular automata can do arbitrarily sophisticated computations." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “The Threshold of Universality in Cellular Automata” (from p. 694), p. 705. Scope: single-step block emulation among the 256 elementary cellular automata" ;
    dct:type "computational-observation" .
}

