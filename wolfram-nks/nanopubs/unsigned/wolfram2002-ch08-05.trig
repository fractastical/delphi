sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-05> a delphi:Claim ;
    rdfs:label "Randomness of fracture surfaces comes from a material-independent intrinsic mechanism" ;
    dct:description "The roughness and randomness of fracture paths does not come from random irregularities in a material but from a general mechanism in which deterministic interactions of element displacements around a moving crack intrinsically generate randomness, as in a simple cellular automaton model." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “The Breaking of Materials” (from p. 374), p. 375. Scope: fracture of solids, from single crystals to geological faults" ;
    dct:type "model-of-nature" .
}

