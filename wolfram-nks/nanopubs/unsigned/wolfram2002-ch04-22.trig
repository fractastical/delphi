sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-22> a delphi:Claim ;
    rdfs:label "Continuous cellular automata show the same complexity as discrete ones" ;
    dct:description "Cellular automata whose cells take a continuous range of gray levels, updated by simple maps of the neighborhood average, show the same kind of complexity as ordinary discrete cellular automata, and can even show localized structures." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Continuous Cellular Automata” (from p. 155), p. 157. Scope: one-dimensional continuous-valued cellular automata" ;
    dct:type "computational-observation" .
}

