sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-28> a delphi:Claim ;
    rdfs:label "Animal coat patterns arise from local activation and longer-range inhibition rules" ;
    dct:description "The few recurring kinds of animal pigmentation patterns (spots, labyrinths, stripes) are produced by a simple rule in which each element tends to match the average color of nearby elements and oppose that of elements further away, as in a two-dimensional cellular automaton." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “Biological Pigmentation Patterns” (from p. 422), p. 427. Scope: pigmentation patterns on animal skins and coats" ;
    dct:type "model-of-nature" .
}

