sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-10> a delphi:Claim ;
    rdfs:label "Intuition that complex results need complex plans comes from engineering" ;
    dct:description "The intuition that complex objects require complex construction plans fails because it derives from engineering, where designers restrict themselves to systems whose behavior they can understand and predict, a constraint nature does not share." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 2, “The Crucial Experiment”; section “The Need for a New Intuition” (from p. 39), p. 40. Scope: human intuition about complexity and the practice of engineering" ;
    dct:type "conceptual" .
}

