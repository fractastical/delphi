sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-08> a delphi:Claim ;
    rdfs:label "Data compression methods all compress repetition and nesting but little else" ;
    dct:description "Structurally different lossless data compression methods (run-length, block/Huffman, pointer-based and two-dimensional schemes) have remarkably similar capabilities: they compress uniform regions, repetitive behavior and to some extent nested behavior, but achieve no substantial compression of more complex behavior even when it is generated by very short programs." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Data Compression” (from p. 560), p. 570. Scope: lossless data compression algorithms applied to patterns from simple programs" ;
    dct:type "computational-observation" .
}

