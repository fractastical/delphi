sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch12-02: partially-resolvable, resolvability 0.34";
    dc:description "Restricted to a small formal family, the principle becomes a statement about what fraction of non-simple rules are universal, and a few rules on each side are already classified. The stated scope is almost all processes in nature, mathematics, and engineering, for which no such classification exists. Intermediate degrees are a published rival formalization, so even the mathematical reading is not unique.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Operationalize obviously simple as proved repetitive or nested behavior, and equivalent sophistication as Turing universality. Inside a finite rule family, estimate the fraction of non-simple rules that are universal. The principle is supported if that fraction is near one across families and if sampled natural processes match it, and it is refuted by a large class of non-simple, non-universal processes.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A system can look complex for decades without a universality proof, and that delay is compatible with the principle.", "Almost all, obviously simple, and sophistication admit several formalizations, including intermediate degrees and complexity classes.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-02--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.34"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: UniversalityDB";
    dc:description "partial census of systems proved universal, the proposed single highest level";
    prov:wasDerivedFrom <https://github.com/WolframInstitute/UniversalityDB>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Stanford Encyclopedia of Philosophy, Church-Turing thesis";
    dc:description "background distinction between one maximal computable level and intermediate degrees";
    prov:wasDerivedFrom <https://plato.stanford.edu/entries/church-turing/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch12-02 by Grok 4.7: 0.25";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.25"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-02--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch12-02 by Grok 4.7: 0.25";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.25"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-02--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-02--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch12-02 by Grok 4.7: 0.45";
