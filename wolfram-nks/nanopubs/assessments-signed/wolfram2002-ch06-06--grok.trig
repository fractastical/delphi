sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch06-06: partially-resolvable, resolvability 0.71";
    dc:description "Activity is a direct time series, and the book's one-parameter sequences are fully specified, so the intermediate-activity pattern can be measured in days on those sequences. Commonly over sequences of rules, discrete and continuous, is wider than any one family, and class labels remain partly visual. The ordering is a real test on the published sequences and a sample beyond them.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define activity as the fraction of cells that change per step, assign classes by localized structures rather than by activity, and test whether class 4 sits between class 2 and class 3 along stated one-parameter rule sequences. A class 4 stretch whose activity matches class 3, or a sequence whose class 4 rules sit outside the class 2 to class 3 boundary, would challenge the claim in that family.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A single class 4 run wavers, so the comparison needs a time average.", "Commonly depends on how rule sequences are parametrized.", "The ordering is informative only when class labels are not themselves activity thresholds.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-06--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.706"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-06--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "measure activity along totalistic and elementary rule sequences";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-06--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: A New Kind of Science online";
    dc:description "the four-color totalistic sequence in which class 4 is said to sit between class 2 and class 3";
    prov:wasDerivedFrom <https://www.wolframscience.com/nks/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch06-06 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch06-06 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch06-06 by Grok 4.7: 0.88";
