<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-23--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-23: partially-resolvable, resolvability 0.56";
    dc:description "Modern developmental atlases contain regulatory states and sometimes spatial trajectories suitable for selected embryos. Coverage across animals and complete lineage-scale information remain limited. The proposed causal implication is confounded by other mechanisms that also yield hierarchical development.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Track lineage, spatial domain size, morphogen gradients, and regulatory state in embryo atlases to test whether fate domains recursively subdivide near a fixed length scale and whether proximal regions consistently precede distal subregions. Variable scales or nonhierarchical specification would refute necessity.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Developmental length scales vary among tissues, stages, and species.", "Hierarchical description does not isolate fixed scale as the cause.", "Single-cell atlases often lack continuous spatial and lineage information.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-23--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-23--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.562"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-23--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EMBL-EBI Single Cell Expression Atlas";
    dc:description "public developmental single-cell expression datasets across organisms";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/gxa/sc/home>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-23--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioStudies";
    dc:description "public imaging and supplementary developmental datasets";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biostudies/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-23--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-23 by GPT-5.6 Sol: 0.5";
