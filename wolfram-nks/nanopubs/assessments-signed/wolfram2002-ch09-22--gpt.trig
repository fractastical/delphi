    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch09-22: needs-new-data, resolvability 0.41";
    dc:description "Observed particle properties provide a demanding comparison target, and candidate rules can be simulated. The missing rule and absence of distinctive microscopic observations prevent resolution of the ontological claim today.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Specify a network dynamics, enumerate its persistent localized structures, and derive their masses, charges, spins, interactions, and scattering signatures. A stable spectrum matching observed particles without particle-specific rules would support the claim; failure to reproduce those properties would refute that model.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Existing data do not reveal substructure at the proposed scale.", "Many localized structures can be engineered without matching particle phenomenology.", "No specific fundamental network rule is given.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-22--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-22--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.407"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-22--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Particle Data Group";
    dc:description "public reference measurements of particle properties for model comparison";
    prov:wasDerivedFrom <https://pdg.lbl.gov/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-22--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: HEPData";
    dc:description "public particle scattering and collider measurements";
    prov:wasDerivedFrom <https://www.hepdata.net/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
