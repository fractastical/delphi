<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-41--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-41: resolvable-now, resolvability 0.73";
    dc:description "The bounded enumeration behind the pictures can be reproduced with public model-finding software in weeks. Claims of unique form over unbounded models may require theorem proving, but the stated vast-majority computational observation is directly checkable under explicit search bounds.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate the stated bounded class of short binary-operator identities, use finite model finding and theorem proving to count non-isomorphic operator models, and compare the fraction with one versus many models. Alternative counts under the same bounds directly refute or confirm the observation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Failure to find additional finite models does not prove uniqueness over all models.", "The bounds defining simple systems and model size must be specified.", "The logic example depends on equivalence conventions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-41--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.729"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
