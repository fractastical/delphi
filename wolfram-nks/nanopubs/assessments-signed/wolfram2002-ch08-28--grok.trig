sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-28--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch08-28: partially-resolvable, resolvability 0.53";
    dc:description "Public images show that a few pattern classes recur, and zebrafish experiments test local activation and longer-range inhibition directly. Those experiments support the mechanism family and do not single out one weighted cellular-automaton rule among many models with the same interaction. The claim is partly resolved at the level of the interaction and not at the level of the exact rule.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Simulate the local-activation, longer-range-inhibition rule across a grid of distance weights and compare the resulting spots, labyrinths, and stripes with measured animal patterns, including experimental shifts in wavelength when the inhibitor is perturbed. A match of pattern class and of the experimental wavelength shift would support the mechanism family; patterns or perturbations outside that family would count against this rule.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Many reaction-diffusion and cell-movement models produce the same three pattern classes.", "The specific cellular-automaton weights are not identifiable from adult coat photographs.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.53"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: ZFIN";
    dc:description "zebrafish pigment-pattern genetics and images, the best-studied experimental case";
    prov:wasDerivedFrom <https://zfin.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iNaturalist";
    dc:description "photographs of spots, stripes, and labyrinths across animals";
    prov:wasDerivedFrom <https://www.inaturalist.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-28--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-28 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-28--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-28--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
