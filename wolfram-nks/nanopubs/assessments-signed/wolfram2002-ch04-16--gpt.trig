<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-16--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-16: partially-resolvable, resolvability 0.76";
    dc:description "Terms are directly computable and the square-root periodicity component is rigorously settled. The claims about pi and higher roots can be tested deeply but not resolved asymptotically with current results.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compute long continued fractions and test term frequencies, dependence, growth, and compressibility against explicit stochastic models, while checking the proven periodicity theorem for quadratic irrationals. Results resolve finite-scale appearance but not unrestricted asymptotic randomness.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cube roots form an infinite family.", "Random has no canonical model for continued-fraction terms.", "Statistical behavior of pi's continued fraction remains largely unproved.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-16--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-16--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.764"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
