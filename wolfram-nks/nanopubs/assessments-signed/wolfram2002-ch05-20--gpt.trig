    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-20--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch05-20: resolvable-now, resolvability 0.83";
    dc:description "The forcing construction and equivalence to rule 30 are finite local statements amenable to a checkable proof. The randomness adjective is only partially operational, but it is not needed to verify the central construction.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Encode rule 30 space-time diagrams as tilings by the stated 56 allowed 3×3 blocks and prove both directions: every valid tiling corresponds to the intended evolution and every intended evolution satisfies the templates. Search or proof can test uniqueness subject to the stated boundary condition.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Uniqueness depends on boundary or required-template conditions.", "“Largely random” is not mathematically decisive.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.83"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-20--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-20--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.829"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-20--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Atlas of Simple Programs";
    dc:description "public rule 30 definitions and computed evolutions";
    prov:wasDerivedFrom <https://atlas.wolfram.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-20--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
