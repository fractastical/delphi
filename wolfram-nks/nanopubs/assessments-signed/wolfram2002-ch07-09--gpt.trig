    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-09--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch07-09: needs-new-data, resolvability 0.37";
    dc:description "The claimed mechanism-frequency relationship is testable in principle with controlled repeated experiments. Public data are piecemeal and lack the interventions and population coverage required for the stated generality.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define production rate as entropy rate per active component and classify mechanisms using interventions that hold initial state fixed while shielding or varying environmental inputs. Across a representative sample, test whether high-rate systems overwhelmingly show repeatable deterministic internal generation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Existing observations rarely isolate all three mechanisms.", "No representative dataset spans natural and engineered systems.", "System boundaries determine what counts as intrinsic.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-09--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.369"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-09--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "public repeated-run experimental data for selected systems";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-09--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Zenodo";
    dc:description "public repository for selected physical and engineered random-system records";
    prov:wasDerivedFrom <https://zenodo.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-09--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
