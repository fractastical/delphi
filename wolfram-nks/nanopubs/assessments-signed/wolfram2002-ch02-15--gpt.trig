<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-15--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch02-15: partially-resolvable, resolvability 0.52";
    dc:description "Historical hardware and literature records can test feasibility and chronology. They cannot cleanly quantify the relative causal importance of computing power versus conceptual and social factors.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct pre-1980 computing capabilities, published explorations, and researchers' stated constraints, then estimate whether the relevant enumerations and visualizations were technically feasible. Compare the technology account with institutional, conceptual, and priority-based alternatives.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Main reason is a counterfactual causal attribution.", "Publication records incompletely capture unpublished exploration and intuition.", "Small earlier computations may have sufficed for some discoveries.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-15--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-15--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.52"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
