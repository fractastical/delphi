    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-13--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-13--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of wolfram2002-ch11-13 by Grok 4.7: 0.7";
