<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch02-07: partially-resolvable, resolvability 0.71";
    dc:description "Particular outcomes are computable now, and some formal prediction questions permit proofs. The sweeping assertion that simulation is the only reliable method requires difficult lower bounds and varies with the question and input representation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Formalize the fate question for a specified initial condition and compare direct simulation with symbolic algorithms or prove a computational lower bound or undecidability result. Any reliable shortcut refutes the only-method wording for that case; a lower-bound theorem supports it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No known shortcut is not evidence that no shortcut exists.", "Some finite initial conditions can be resolved by inspection or finite simulation.", "Universal rule 110 prediction questions can be undecidable.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-07--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.708"^^xsd:double;
