sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-21--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch03-21: not-empirically-resolvable, resolvability 0.23";
    dc:description "The sentence is a methodological consequence Wolfram draws from universality: one might describe a natural system without knowing its parts. Nothing in the wording picks a system, a measurement, or a result that would favor this over the rival view that the important features are system-specific. Public data about particular natural systems therefore do not contain the variables the claim would need, because those variables were never specified.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/none";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: No specific natural system, observable, or decision threshold is fixed by the claim. A comparison of one phenomenon with a simple program would neither confirm that overall behavior can be stated without internal details nor refute it, because 'important features' and 'usually' can be reassigned after the fact.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A failed simple-program model can be set aside as not the relevant feature, and a successful one does not show that the internals were unnecessary.", "The claim names no natural system and no observable that would count as an important feature.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.233"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "not-empirically-resolvable".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-21--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch03-21 by Grok 4.7: 0.25";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.25"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-21--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-21--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
