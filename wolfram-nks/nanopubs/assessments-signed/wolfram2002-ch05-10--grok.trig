    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-10--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-10--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
