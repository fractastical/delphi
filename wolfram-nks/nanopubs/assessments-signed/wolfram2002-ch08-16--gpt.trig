<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-16: partially-resolvable, resolvability 0.53";
    dc:description "Public images, morphology matrices, and phylogenies support analyses in selected clades. Coverage and trait homology are uneven, and the proposed contrast between rapid change and selection is causally problematic. Existing resources can test correlations but not the almost-always or causal components.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across related species, estimate phylogenetic rates for homologous traits, assign quantitative pattern-complexity scores, and test their association while separately estimating evidence of stabilizing or directional selection. The claim predicts a near-universal positive rate-complexity relationship and low rates for selected features.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Obvious complexity is observer- and metric-dependent.", "Rapid change can itself be driven by selection.", "Species differences do not directly measure evolutionary rate without dense phylogenies.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.534"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "public morphological matrices and images for cross-species trait comparisons";
    prov:wasDerivedFrom <https://morphobank.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "public phylogenies for estimating trait-change rates";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iNaturalist";
    dc:description "public organism images for pigmentation and texture measurements";
    prov:wasDerivedFrom <https://www.inaturalist.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
