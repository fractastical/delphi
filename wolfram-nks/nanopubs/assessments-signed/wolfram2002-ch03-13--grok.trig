sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch03-13: resolvable-now, resolvability 0.88";
    dc:description "Removing one symbol at a time and appending a block determined by that symbol reproduces a color-only substitution, just more slowly, so the nested or repetitive conclusion follows from the substitution argument. The two-element clause is existential and is settled by resimulating a published example. Both halves have a finite, checkable form.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Show that deleting one element per step walks through the string and rewrites each symbol by a block that depends only on that symbol, which is a neighbor-independent substitution and therefore nested or repetitive. Separately, exhibit one two-element-deletion tag system with incompressible evolution. The first half is refuted by a one-element tag system outside that reduction; the second by failure of the exhibited examples.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.85"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-13--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.879"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: A New Kind of Science online";
    dc:description "published one-element and two-element tag-system diagrams that state the reduction and the complex examples";
    prov:wasDerivedFrom <https://www.wolframscience.com/nks/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS A010060";
    dc:description "Thue-Morse sequence, a model of the nested substitution behavior to which one-element tag systems reduce";
    prov:wasDerivedFrom <https://oeis.org/A010060>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch03-13 by Grok 4.7: 0.9";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.9"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
