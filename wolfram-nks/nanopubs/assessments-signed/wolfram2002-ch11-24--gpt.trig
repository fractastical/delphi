<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-24--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch11-24: needs-new-data, resolvability 0.55";
    dc:description "The claim is precise enough once universality is standardly defined, but public simulations do not settle it. New mathematical constructions or impossibility results are required.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Construct a computable encoding and simulation of a known universal machine in each of rules 30 and 45, or prove an invariant that makes such simulation impossible. Simulations can search for components but cannot by themselves establish universality.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Class-3 information spreading obstructs known construction methods.", "No accepted universality proof is available for these rules.", "Universality cannot be confirmed by bounded runs.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.89"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-24--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.548"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
