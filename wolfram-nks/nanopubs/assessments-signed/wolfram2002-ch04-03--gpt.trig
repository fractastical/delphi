<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-03: partially-resolvable, resolvability 0.81";
    dc:description "Arbitrarily many exact digits can be generated cheaply and tested with public standard software. The phrase for all practical purposes is test-relative, so existing computation strongly resolves operationalized versions but not an unrestricted randomness assertion.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Generate binary expansions of 3^n over large preregistered ranges and test digit frequencies, runs, correlations, compressibility, and two-dimensional pattern statistics against matched random sequences. Significant persistent deviations refute practical randomness under those tests; passing supports but cannot prove it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Passing finite statistical tests cannot establish randomness.", "The two-dimensional arrangement across powers admits many analysis choices.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-03--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.812"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-03--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Statistical Test Suite";
    dc:description "public software and documented tests for statistical randomness of bit sequences";
    prov:wasDerivedFrom <https://csrc.nist.gov/projects/random-bit-generation/documentation-and-software>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-03--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch04-03 by GPT-5.6 Sol: 0.98";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
