    <https://w3id.org/delphi/ontology/hasScore> "0.68"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok>.
<https://w3id.org/delphi/resource/claim/wolfram2002-ch10-12> <https://w3id.org/delphi/ontology/hasAssessment> <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok>, <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--analysis-feasibility>, <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--data-adequacy>, <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--data-existence>, <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--discriminating-power>, <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--operationalizability>
