sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-19--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch10-19: partially-resolvable, resolvability 0.45";
    dc:description "Behavioral and neural datasets can test whether memory retrieval is organized by similarity, which is the functional half of the claim. They do not resolve the proposed implementation, successive layers hashing random fixed input sets into codes stable under small changes. That mechanism remains one model among others consistent with the same public data.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Test whether successive neural populations, each depending on a fixed random subset of its inputs, produce codes that are stable under small input changes and that predict similarity-based retrieval. Such a layered random code matching behavior would support the mechanism; retrieval by similarity with a different circuit would leave the specific hashing claim unconfirmed.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Present recordings do not resolve whether each layer samples a fixed random set of inputs.", "Similarity-based retrieval is compatible with several circuit designs.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-19--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-19--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.445"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-19--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: CRCNS";
    dc:description "public neural recordings during memory and sensory tasks";
    prov:wasDerivedFrom <https://crcns.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-19--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Human Connectome Project";
    dc:description "public human brain-connectivity and behavioral data, at a coarser scale than layered hashing";
    prov:wasDerivedFrom <https://www.humanconnectome.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-19--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch10-19 by Grok 4.7: 0.38";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.38"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-19--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-19--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch10-19 by Grok 4.7: 0.34";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.34"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-19--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-19--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch10-19 by Grok 4.7: 0.56";
