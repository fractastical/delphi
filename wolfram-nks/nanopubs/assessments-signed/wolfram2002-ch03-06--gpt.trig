<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch03-06: resolvable-now, resolvability 0.92";
    dc:description "The basic rule space is finite and computationally modest, enabling exhaustive reproduction and targeted proof for long transients. The extension's rarity can likewise be estimated or counted under explicit criteria.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate all 65,536 specified mobile-automaton rules from the stated initial condition, classify each trajectory for periodicity, nesting, and stronger complexity metrics, then enumerate the neighbor-updating extension. Any qualifying complex trajectory in the basic class refutes the absolute count.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Complex behavior requires a declared criterion.", "Ultimate simplicity may not be inferable from a fixed finite horizon.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.92"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-06--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.915"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
