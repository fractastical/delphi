    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Choose a representative benchmark of simple and complex phenomena, define equation, evolutionary, and program model classes, and compare predictive performance at matched description length. A sharply declining performance of the first two classes only on complex targets would support the restricted empirical claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A representative benchmark for all existing sciences does not exist.", "Meaningful statement and complex behavior lack unique metrics.", "Programs and equations can encode one another.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-04--gpt--dataset-1>;
