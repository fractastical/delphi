sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch10-15: resolvable-now, resolvability 0.81";
    dc:description "Both sequences are published to great length, and block-frequency tests plus short cellular-automaton filters are standard computations. The claim asserts only that these analyses show no detectable deviation, which a significant failure would refute and a pass would support. It does not assert a proof that the sequences are random in every sense.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Apply block-frequency tests and a declared set of simple cellular automata to the center column of rule 30 and to a long prefix of the binary expansion of pi. A statistically significant deviation on either sequence refutes the claim for that analysis; passage of both analyses supports the claim as a statement about detectable deviation, not as a proof of randomness.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Passing a finite battery of tests does not prove that no regularity exists.", "The cellular-automaton analysis has to be limited to a stated class of simple rules.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-15--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-15--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS rule 30 center column";
    dc:description "published center-column bits of elementary cellular automaton rule 30";
    prov:wasDerivedFrom <https://oeis.org/A051023>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-15--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS binary expansion of pi";
    dc:description "published binary digits of pi";
    prov:wasDerivedFrom <https://oeis.org/A004601>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-15--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Random Bit Generation";
    dc:description "public statistical test procedures for deviation from randomness";
    prov:wasDerivedFrom <https://csrc.nist.gov/projects/random-bit-generation>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch10-15 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-15--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-15--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch10-15 by Grok 4.7: 0.76";
