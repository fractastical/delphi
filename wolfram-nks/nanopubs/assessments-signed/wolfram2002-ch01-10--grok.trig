sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch01-10: partially-resolvable, resolvability 0.60";
    dc:description "Universality of a simple rule is published, and undecidable questions about that rule follow by the usual reduction. That is the Gödel-like half of the claim, and it is checkable. The further assertion that these limits matter well outside existing mathematics is a judgment about relevance, and neither the proof nor any dataset decides it.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: From a universality proof for a simple system, derive a concrete undecidable question about that system, such as whether a given finite pattern ever appears. That settles the existence of Gödel-like limits inside simple programs. It does not settle whether those limits are relevant well beyond the current scope of mathematics.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Relevance beyond the current scope of mathematics has no formal or empirical decision criterion.", "Undecidability of one encoded question does not measure how often ordinary mathematical questions are blocked.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-10--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.597"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cook 2004, Universality in Elementary Cellular Automata";
    dc:description "published universality proof from which undecidable questions about a one-sentence cellular automaton follow";
    prov:wasDerivedFrom <https://doi.org/10.25088/complexsystems.15.1.1>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch01-10 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-10--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
