<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch01-09: not-empirically-resolvable, resolvability 0.04";
    dc:description "The statement links a formal property of some dynamical systems to a meaningful attribution of free will. No public dataset records that attribution in a way that would separate this story from other compatibilist stories. The claim can be argued and cannot be confirmed or refuted by observation or computation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/none";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: The claim offers computational irreducibility as an account of free will. Free will, in the sense used here, has no measurement that would confirm this explanation or favor a rival compatibilist account.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Every deterministic and irreducible human-scale process is compatible with the explanation and with its rivals.", "Free will is a philosophical predicate without an agreed observable.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.038"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "not-empirically-resolvable".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
