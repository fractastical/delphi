    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-22--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch10-22: partially-resolvable, resolvability 0.56";
    dc:description "Contemporary general and specialized systems provide relevant comparative evidence. However, the prediction concerns ease of reproduction at an unspecified level and bundles a separate claim about experience, so existing benchmarks resolve only proxies.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define comparable engineering budgets and benchmarks for broad human-like agents versus agents restricted to selected tasks, then compare development cost, sample efficiency, and performance, with and without human-like experience corpora. Lower cost for broad agents would support the prediction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Current systems and benchmarks are selected by research incentives.", "Historical engineering effort is not standardized.", "Human-like thinking has no agreed metric.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-22--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-22--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.563"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-22--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Papers with Code";
    dc:description "public benchmark results and model records across general and task-specific AI";
    prov:wasDerivedFrom <https://paperswithcode.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-22--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
