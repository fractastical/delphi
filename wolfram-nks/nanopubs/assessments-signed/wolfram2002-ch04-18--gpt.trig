    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-18: resolvable-now, resolvability 0.90";
    dc:description "The zero sets and continued fractions are exact mathematical objects, and the asserted correspondence admits direct derivation and symbolic verification. No empirical dataset or unbounded numerical inference is required once conventions are fixed.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Derive the ordered zero-crossing word for sin(x)+sin(a x), construct the generalized substitution directive sequence from the continued fraction of (a-1)/(a+1), and prove equality or find a counterexample. For quadratic irrational a, verify that eventual periodicity of the continued fraction induces a nested substitution pattern.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Degenerate parameter values and coincident zeros require explicit conventions.", "Generalized substitution system must be formally defined.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.89"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-18--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.901"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
