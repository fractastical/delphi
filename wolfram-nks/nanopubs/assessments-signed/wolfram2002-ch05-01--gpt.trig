    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Construct matched rule ensembles in one, two, and three dimensions for specified formalisms, classify behavior with common complexity measures, and compare prevalence and attainable classes. Similar rates support dimension-independence within those ensembles; large systematic differences refute it there.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fundamentally change and significant complexity are vague.", "Rule ensembles across dimensions are not canonically comparable.", "The scope spans several infinite formalism classes.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-01--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.592"^^xsd:double;
