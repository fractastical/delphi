sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch10-21: needs-new-data, resolvability 0.29";
    dc:description "The claim is that thinking has a core of simple rules largely independent of how neurons are built. Brain and behavior datasets record the neural detail and some performance, but they do not contain that core or a test of its implementation independence. Deciding the claim needs an explicit rule-level account that has not been produced.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Specify a small rule set claimed to be the core of thinking, show that its behavior is unchanged under changes of neural implementation, and compare it with human performance. A core that survives implementation changes and matches behavior would support the claim; essential dependence on particular neural detail would refute independence.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Rather simple rules' and 'a definite core' are not tied to a stated formal system.", "Existing brain maps record neural detail; they do not contain a demonstration that thinking is independent of it.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.5"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-21--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.29"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-21--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Human Connectome Project";
    dc:description "public measurements of human brain structure and behavior, without an identified simple-rule core";
    prov:wasDerivedFrom <https://www.humanconnectome.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-21--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Allen Brain Map";
    dc:description "public neural-circuit detail of the kind the claim says the core does not depend on";
    prov:wasDerivedFrom <https://portal.brain-map.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch10-21 by Grok 4.7: 0.24";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.24"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch10-21 by Grok 4.7: 0.2";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.2"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch10-21 by Grok 4.7: 0.36";
