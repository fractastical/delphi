    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-26--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch09-26: partially-resolvable, resolvability 0.43";
    dc:description "Individual quantum phenomena can be sought computationally and compared with existing experiments. The unrestricted prediction that these programs will ultimately reproduce many or all features is too vague and broad for full resolution.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For specified causal-invariant network models, derive quantitative counterparts of superposition, interference, entanglement, measurement statistics, and unitary evolution, then compare with benchmark quantum experiments. Failure on any claimed key feature refutes that model; joint quantitative agreement would support it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Qualitative resemblance has weak discriminating power.", "Selected quantum predictions do not establish equivalence to quantum theory.", "The model class and 'key features' are open-ended.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-26--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-26--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.435"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-26--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Physics Project Technical Documents";
    dc:description "public model definitions and proposed derivations of quantum phenomena";
    prov:wasDerivedFrom <https://www.wolframphysics.org/technical-documents/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-26--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: HEPData";
    dc:description "public quantum and particle-physics measurements for quantitative comparison";
    prov:wasDerivedFrom <https://www.hepdata.net/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-26--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
