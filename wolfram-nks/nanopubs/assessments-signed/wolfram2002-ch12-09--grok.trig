    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-09--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-09--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
