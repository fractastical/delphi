sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch07-22: resolvable-now, resolvability 0.79";
    dc:description "Annihilating and coalescing boundaries are a standard stochastic process, and the named cellular automata are small computations. The genealogy of mergers is a concrete object, so the nested-tree description can be confirmed or replaced by a counterexample inside the stated class. That is a computation, not a new observation of nature.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Simulate rules 184 and 110 and a family of domain models whose boundaries annihilate on contact, including random-walk boundaries, and test whether the merger genealogy is a nested tributary tree. A nested merger tree across that family would support the claim; a broad class of independently growing, then merging, domains whose genealogy is not nested would refute the essentially any quantifier.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fairly independently has to be defined before the family of systems is closed.", "Nesting in rule 110 is approximate once the localized structures are coarse-grained.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-22--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.789"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-22--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Atlas of Simple Programs";
    dc:description "published evolutions of rules 184 and 110 from random initial conditions";
    prov:wasDerivedFrom <https://atlas.wolfram.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-22--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NetLogo";
    dc:description "open simulator for annihilating domains and random-walk boundaries";
    prov:wasDerivedFrom <https://ccl.northwestern.edu/netlogo/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-22 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
