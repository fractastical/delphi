    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-05--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch07-05: partially-resolvable, resolvability 0.48";
    dc:description "Existing records and simulations can test selected chaotic systems and estimate finite predictability horizons. They do not support the broad physical generalization or the specific pegboard scale without richer controlled measurements.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For specified chaotic apparatuses, combine measured initial-state precision and environmental-noise spectra with validated dynamical models to compute the predictability horizon and the scale reached by amplified uncertainty. Test whether initial uncertainty dominates only for roughly the stated number of collisions.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Attribution after divergence is model-dependent.", "Public data rarely record microscopic initial conditions and environmental perturbations together.", "The horizon is apparatus- and precision-dependent.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-05--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.477"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
