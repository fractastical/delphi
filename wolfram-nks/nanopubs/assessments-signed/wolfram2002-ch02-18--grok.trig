<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch02-18: partially-resolvable, resolvability 0.48";
    dc:description "Priority claims are refuted by a single earlier publication that states the phenomenon, and a large digitized literature makes that search possible. The source text itself lists hints, so the boundary between a hint and a discovery has to be fixed before the search decides anything. Coverage of the historical record is incomplete, which blocks a confident confirmation of 'never.'";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Search the published record before the 1980s for a statement that simple programs systematically produce complex behavior of the kinds later classified. A clear prior statement refutes the priority claim. Failure to find one supports it only inside the searched corpus and under the chosen reading of 'identified.'";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Undigitized and non-English sources are missing from any practical search.", "What counts as identifying the phenomenon, as opposed to exhibiting a hint such as the Game of Life or the digits of pi, is disputed.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-18--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.483"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Internet Archive";
    dc:description "digitized historical scientific and mathematical literature in which a prior identification would appear";
    prov:wasDerivedFrom <https://archive.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch02-18 by Grok 4.7: 0.45";
