<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-21--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch11-21: resolvable-now, resolvability 0.81";
    dc:description "The finite rule and initial-condition range can be regenerated with standard computation. Some interpretation is required, but the bounded historical observation is reproducible rather than a claim about all time.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct the stated enumeration order, evolve rule 54 from each of the first 100 million finite initial conditions to a prespecified horizon, and classify each trace using explicit periodicity and nesting tests. One certified counterexample refutes the observation; exhaustive agreement confirms it only for the chosen horizon and definitions.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fundamental complexity and nesting require operational definitions.", "The simulation horizon is not stated.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-21--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.808"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
