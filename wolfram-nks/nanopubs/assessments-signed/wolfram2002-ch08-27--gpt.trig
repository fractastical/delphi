<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-27--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-27: partially-resolvable, resolvability 0.36";
    dc:description "Existing occurrence, image, and phylogenetic resources can test whether patterns are visible and phylogenetically structured in restricted groups. They contain little direct evidence about rule choice, predation, mating, or fitness. Thus some adaptive alternatives can be tested, but the random-rule explanation remains weakly identified.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across mollusc phylogenies, compare shell-pattern visibility, predator and mate exposure, fitness associations, and inferred developmental-rule transitions against a neutral random-choice model over explicitly defined simple rules. Strong repeated fitness effects and nonneutral transitions would refute random choice.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A random distribution over generating rules is undefined.", "Fitness and exposure data are sparse across species.", "Hidden patterns can have pleiotropic, developmental, or nonvisual functions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-27--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-27--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-27--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.357"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-27--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
