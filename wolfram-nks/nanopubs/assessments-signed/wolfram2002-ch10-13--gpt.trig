    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Generate data from a preregistered set of deterministic cellular automata, fit block-frequency, Markov, and probabilistic-CA models, and compare held-out higher-order statistics and visual structure. Greater entropy and loss of detailed features in most fitted samples would support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Best fit' depends on model order and objective.", "Most-cases prevalence depends on the sampled rule distribution.", "Visual randomness needs quantitative metrics.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-13--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.864"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
