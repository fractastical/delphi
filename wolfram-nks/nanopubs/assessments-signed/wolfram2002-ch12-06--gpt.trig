    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-06: needs-new-data, resolvability 0.71";
    dc:description "The property is mathematically precise and arbitrarily large finite searches are easy. Existing results do not resolve the infinite quantifier, so a new theorem or counterexample is needed.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For every finite binary word, prove that some row of the single-seed rule 30 spacetime diagram contains it, or find a finite word and prove it never occurs. Enumeration can confirm occurrence only up to finite block length.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Finite simulation cannot establish the all-blocks quantifier.", "No known general occurrence proof or forbidden-block proof settles the claim.", "The computation-directory interpretation is stronger than block occurrence alone.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-06--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.708"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
