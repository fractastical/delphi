    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch03-09: partially-resolvable, resolvability 0.75";
    dc:description "The existence of four-state random-looking examples and an approximate rate can be tested with current computation. The assertion over every larger state count and unchanged behavior taxonomy cannot be exhaustively covered.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Sample or enumerate four-state and larger two-color machines from blank tape, apply fixed randomness statistics to their spacetime outputs, and estimate qualifying frequencies with confidence intervals. Compare discovered behavior classes and rates across state counts.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "More than four states has no upper bound.", "Seemingly random depends on test choices and runtime.", "The four-state rule space and larger spaces grow rapidly.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-09--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.748"^^xsd:double;
