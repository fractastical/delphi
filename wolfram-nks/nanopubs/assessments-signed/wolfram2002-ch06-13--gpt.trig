    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-13--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch06-13: partially-resolvable, resolvability 0.78";
    dc:description "Exact period computation is straightforward for moderate sizes and public sequence resources aid replication. The asymptotic and uniqueness components require proof or much broader enumeration than standard analyses provide.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate cyclic lattices across increasing n for every elementary rule and specified initial-state sampling, compute transient and cycle lengths, and compare growth rates and fluctuations by class. Search explicitly for rules besides 45 whose periods remain near 2^n over the tested range.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Finite n cannot prove an all-n statement about rule 45.", "The initial-state convention affects measured periods.", "“Characteristic” and “near maximum” need thresholds.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-13--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-13--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.777"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-13--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Atlas of Simple Programs";
    dc:description "public elementary cellular-automaton definitions and behavior";
    prov:wasDerivedFrom <https://atlas.wolfram.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-13--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
