<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch02-11: partially-resolvable, resolvability 0.29";
    dc:description "Some natural systems can be tested using existing time series, but available observations are highly selective and often lack causal resolution. They cannot establish prevalence across nature as stated.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define a representative sample of natural systems, infer compact local rules from time-resolved observations, and quantify whether those rules generate high-complexity trajectories. Compare prevalence against a prespecified threshold and against non-program mechanistic models.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Inferred simple rules are model-dependent.", "No representative inventory of natural systems exists.", "Very common has no stated prevalence threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-11--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.288"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
