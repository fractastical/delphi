    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-32--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch11-32: resolvable-now, resolvability 0.85";
    dc:description "Combinator rules and initial expressions are exact and publicly reproducible, and universality is already established independently. Standard symbolic software can test the concrete growth and emulation components.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reduce the stated length-8 S-K expression while measuring term size and structural statistics, and verify a formal encoding of rule 110 in combinator reduction. Exponential growth and the emulation construction test the concrete claims, while perceived randomness requires chosen statistics.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Highly complex' and 'seemingly random' are metric-dependent.", "Naive combinator reduction can cause severe expression growth.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-32--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.851"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
