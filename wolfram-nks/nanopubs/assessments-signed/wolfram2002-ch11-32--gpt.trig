    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cook, Universality in Elementary Cellular Automata";
    dc:description "universal source system for checking the claimed combinator emulation";
    prov:wasDerivedFrom <https://doi.org/10.25088/ComplexSystems.15.1.1>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-32--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
