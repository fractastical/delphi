sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-19--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch05-19: partially-resolvable, resolvability 0.46";
    dc:description "The sentence is carefully limited to millions tested, so it is a sample claim rather than a universal theorem, but that sample is not deposited as data. A new sample of millions is a proxy, and millions remain a thin slice of 137,438,953,472 constraints. Finding a clearly non-nested coloring would refute the intended content; failing to find one would not close it.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Draw a large explicit sample of required-template constraints, search each for a satisfying coloring, and classify that coloring as repetitive, nested, or neither by a stated substitution or automata test. One coloring that fails both repetitive and nested tests would refute the sample claim; a clean sample only supports it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A negative search leaves the other constraints in the 137 billion untouched.", "Nested versus more complicated is a judgment unless a formal class such as automatic sequences is fixed in advance.", "The millions actually tested are not archived as a list.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-19--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.458"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-19--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: A New Kind of Science online";
    dc:description "the template scheme and the nested example used as the complexity ceiling in this census";
    prov:wasDerivedFrom <https://www.wolframscience.com/nks/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-19--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch05-19 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
