sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-30--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch11-30: partially-resolvable, resolvability 0.65";
    dc:description "A detailed public proof, later machine-checked in parts, addresses the universality of this specific machine, so that conjunct is open to audit now. Whether the machine is the simplest depends on the size measure and on open neighbors such as 3-state 2-color machines, which a 2-state 2-color classification does not close. The claim as a conjunction is therefore only partly decided.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Check a reduction from cyclic tag systems or Turing machines to machine 596,440, including the initial-condition encoding. Universality is confirmed if every computation is emulated and the encoding itself is not doing the computation. Simplest is confirmed only relative to a stated size measure and a completed proof that every smaller machine is non-universal.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "By most measures is undefined, and 3-state 2-color machines have the same number of transitions and are not fully classified.", "The proof uses a non-periodic infinite initial condition, so it can be rejected by a definition of universality that requires a periodic background.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-30--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-30--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-30--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.653"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-30--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Smith 2007 proof commentary";
    dc:description "public outline of the proof that machine 596,440 emulates cyclic tag systems";
    prov:wasDerivedFrom <https://www.wolframscience.com/prizes/tm23/solution_technical.html>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-30--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Smith, Universality of Wolfram's 2, 3 Turing Machine";
    dc:description "published version of the universality argument for this machine";
    prov:wasDerivedFrom <https://www.complex-systems.com/abstracts/v29_i01_a01/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-30--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Busy Beaver Challenge";
    dc:description "classification of smaller 2-symbol machines against which simplest can be compared";
    prov:wasDerivedFrom <https://bbchallenge.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-30--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch11-30 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-30--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-30--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch11-30 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
