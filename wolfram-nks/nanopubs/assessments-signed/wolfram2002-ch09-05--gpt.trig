<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-05--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch09-05: partially-resolvable, resolvability 0.80";
    dc:description "The rule is explicit and inexpensive to simulate, so substantial evidence is available immediately. The indefinite statement and the phrase 'for practical purposes' prevent finite computation from fully resolving it.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Simulate rule 37R over many finite sizes, initial conditions, and long durations, measuring entropy, compressibility, and recurrence. A robust monotone rise to equilibrium would refute the claim, while persistent bidirectional fluctuations would support it over the sampled regimes.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Finite simulations cannot establish indefinite behavior.", "Randomness and order admit several inequivalent measures.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-05--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.798"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
