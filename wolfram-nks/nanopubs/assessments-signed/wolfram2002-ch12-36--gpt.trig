    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-36--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-36: needs-new-data, resolvability 0.42";
    dc:description "Existing problem catalogs can define a sample but do not contain the independence proofs needed for resolution. The necessary mathematical results would be major new knowledge, and the vague prevalence threshold further lowers operationalizability.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Create a dated census of seriously studied open number-theory statements formalized in a fixed arithmetic theory, then prove independence or derivability for each and compute the independent fraction. A low fraction refutes, and a prespecified substantial fraction confirms, the prediction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "\"Fair fraction\" and \"seriously studied\" are unspecified.", "Most independence results are unknown.", "The denominator changes over time and with problem formulation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-36--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.424"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-36--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Problem Garden";
    dc:description "public catalog from which a transparent subset of number-theory open problems could be sampled";
    prov:wasDerivedFrom <https://www.openproblemgarden.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-36--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
