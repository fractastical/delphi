    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-14--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-14--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
