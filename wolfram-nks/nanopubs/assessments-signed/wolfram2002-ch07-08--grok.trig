sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch07-08: partially-resolvable, resolvability 0.47";
    dc:description "Linear congruential generators and linear-feedback registers are public, analyzed, and known to carry detectable regularities, so the intended examples can be checked. The sentence says that the possibility of detailed analysis tends to imply a deviation from perfect randomness, and finding such a deviation is largely what detailed analysis means. The example families are testable; the general tendency is not a separate empirical claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Take generator families with published closed-form analyses and test their outputs for proved regularities such as lattices or linear structure. A fully analyzed family that also passed every declared randomness test would challenge the tendency inside that collection.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A system can be analyzed in one respect and still pass a fixed test battery.", "Detecting a deviation is itself a piece of analysis, so the sentence is close to a tautology.", "Tends to states no rate.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.54"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-08--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.475"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TestU01";
    dc:description "compare analyzable generators such as linear congruential and linear-feedback families with less analyzable rules";
    prov:wasDerivedFrom <https://simul.iro.umontreal.ca/testu01/tu01.html>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-08 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-08--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-08--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch07-08 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
