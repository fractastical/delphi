    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-08--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-08--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch07-08 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
