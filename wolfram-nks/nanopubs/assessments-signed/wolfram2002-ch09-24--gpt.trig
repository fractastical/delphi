    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch09-24: resolvable-now, resolvability 0.97";
    dc:description "This is a standard geometric asymptotic claim and is decidable by derivation, with computational checks on discretizations. In particular, the stated exponent can be directly compared with the known curvature correction rather than inferred statistically.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use the small-geodesic-ball expansion in a d-dimensional Riemannian manifold and its graph approximation to derive the first curvature-dependent term, checking both its power of r and coefficient. A different leading exponent or dependence provides a direct refutation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Graph distance and continuum geodesic distance require a controlled scaling limit.", "The statement may conflate ball volume with shell counts.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.94"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-24--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.969"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
