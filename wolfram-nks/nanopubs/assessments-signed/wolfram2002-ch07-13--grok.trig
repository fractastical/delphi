    <https://w3id.org/delphi/ontology/hasScore> "0.65"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-13--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
