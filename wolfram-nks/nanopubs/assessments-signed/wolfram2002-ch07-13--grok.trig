sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch07-13: partially-resolvable, resolvability 0.62";
    dc:description "The timescale comparison is a well-posed simulation inside the growth and coarsening models named in the section. A sample can refute a claimed necessary condition, but it cannot establish the condition for every discrete system. Coverage of the full general principle is therefore only partial.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In ensembles of discrete growth and coarsening models, vary the ratio of the small-scale mixing time to the large-scale growth time and measure a continuity statistic of the large-scale interface. A sharp loss of continuity below a modest timescale separation would support the proposed necessary condition inside those ensembles; continuity without that separation would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Continuous, slow, and random each need a definition before the threshold is meaningful.", "The universal quantifier over every discrete system is not settled by any finite ensemble.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-13--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.618"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Atlas of Simple Programs";
    dc:description "reference cellular-automaton rules for growth and domain coarsening";
    prov:wasDerivedFrom <https://atlas.wolfram.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NetLogo";
    dc:description "open simulator for sweeping noise rate against growth rate";
    prov:wasDerivedFrom <https://ccl.northwestern.edu/netlogo/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-13 by Grok 4.7: 0.65";
