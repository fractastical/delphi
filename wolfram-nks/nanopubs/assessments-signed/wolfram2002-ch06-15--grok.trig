sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch06-15: resolvable-now, resolvability 0.91";
    dc:description "Rule 90 is left XOR right, so additivity and superposition of the single-cell nested pattern are a short algebraic proof covering every initial condition. The low-density contrast with rule 22 is the same fact read off a simulation and can be reproduced in minutes. The scope is these two rules, which the proof and the runs cover.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Check that rule 90 is linear over GF(2), hence every spacetime diagram is the XOR of single-cell diagrams, and compare a low-density random seed under rule 90 and rule 22. Persistent density modulation in rule 90 and its disappearance in rule 22 confirm the contrast; a nonlinear identity, or a low-density effect that dies in rule 90, would refute the corresponding clause.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cannot generate randomness intrinsically is settled by the superposition theorem, not by a statistical test.", "The density picture is a finite run; the persistence claim itself follows from linearity.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-15--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.911"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SageMath";
    dc:description "verify linearity of rule 90 over GF(2) and the superposition identity";
    prov:wasDerivedFrom <https://www.sagemath.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-15--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "compare low-density evolution under rule 90 and rule 22";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch06-15 by Grok 4.7: 0.92";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.92"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch06-15 by Grok 4.7: 0.92";
