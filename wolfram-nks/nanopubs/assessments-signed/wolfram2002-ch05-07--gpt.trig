    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch05-07: resolvable-now, resolvability 0.84";
    dc:description "For deterministic context-free substitution systems, hierarchical nesting follows directly from the construction and is amenable to a general proof. The claim is resolvable once its intended replacement class is formalized, with edge cases explicitly excluded or tested.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Formalize independent replacement as iteration of a fixed morphism or iterated function system, then prove that every finite-scale component is generated by recursive composition of the same replacements. A valid independently replaced system lacking this self-similar hierarchy would be a counterexample.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Purely nested needs a precise structural definition.", "Variable or stochastic replacements may fall outside the intended fixed-rule class.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-07--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.838"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
