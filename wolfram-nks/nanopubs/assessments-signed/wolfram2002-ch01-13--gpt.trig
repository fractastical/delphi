    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-13--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch01-13: partially-resolvable, resolvability 0.40";
    dc:description "Existing genomic and phylogenetic data can test restricted associations between selection and specified complexity measures. They cannot cleanly resolve the broad causal partition or the assertion that intrinsic program behavior explains most biological complexity.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define biological complexity metrics and estimate their changes under measured selection across phylogenies, experiments, and genomic time series. Compare selection-based models with intrinsic program-complexity models using out-of-sample causal predictions.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Biological complexity has no single accepted metric.", "Most great complexity is a scope-wide causal attribution.", "Selection, drift, development, and environment are strongly confounded.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-13--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-13--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.397"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-13--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI GenBank";
    dc:description "public sequence data for comparative measures of genomic evolution";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-13--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
