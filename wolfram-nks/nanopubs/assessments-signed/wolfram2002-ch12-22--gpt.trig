    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-22: resolvable-now, resolvability 0.86";
    dc:description "This is a sharply defined decision-problem threshold that can be settled by published proof under explicit conventions. Public literature and proof checking are sufficient today, although the claim's wording conflates irreducibility with undecidability.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Formalize Post Correspondence Problem instances restricted to at most three pairs and establish either a decision algorithm or a reduction proving undecidability. A valid proof directly resolves the threshold claim, while enumeration can independently check bounded cases.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Computational irreducibility is not equivalent to undecidability.", "The exact encoding restrictions on words and alphabets affect the threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-22--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.863"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
