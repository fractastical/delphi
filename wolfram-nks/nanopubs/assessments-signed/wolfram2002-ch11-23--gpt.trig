<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-23--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch11-23: partially-resolvable, resolvability 0.43";
    dc:description "Damage spreading and localized structures are computable for finite samples. Existing analyses cannot cleanly establish that uncontrolled flow causes proof difficulty in general or excludes other proof methods.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure damage spreading from single-cell perturbations and compare the availability of persistent localized structures and proof constructions across classified rules. A strong association between spreading and failed component-based constructions would support this particular methodological mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Failure to find components does not imply none exist.", "Not every class 3 rule has identical perturbation dynamics.", "Proof difficulty is partly sociological and method-dependent.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-23--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.435"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
