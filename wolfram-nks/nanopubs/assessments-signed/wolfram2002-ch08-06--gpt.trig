    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--gpt>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--gpt--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
