    <https://w3id.org/delphi/ontology/hasScore> "0.82"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-03--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-03--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
