    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-25--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch11-25: resolvable-now, resolvability 0.95";
    dc:description "Positive single-step emulations are finite certificates that are easy to verify. Claims that simple rules emulate only a few require either a proven bound or careful restriction to the reported search.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate block sizes and encodings for each underlying rule and verify whether one encoded update reproduces each of the 256 elementary target-rule truth tables. The finite list of successful target rules directly confirms or refutes the stated contrast.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A failed bounded search does not prove impossibility.", "The allowed block encodings and maximum searched block size must match the claim.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.92"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-25--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.949"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
