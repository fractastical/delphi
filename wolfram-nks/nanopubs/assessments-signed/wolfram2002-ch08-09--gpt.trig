    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-09--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-09: needs-new-data, resolvability 0.51";
    dc:description "The prediction admits a clean repeated-experiment test with strong discriminating power. Public databases predominantly provide single experiments or simulations, not the required replicated physical runs under carefully matched conditions. New laboratory data are therefore needed.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Repeat a turbulent-flow experiment from independently reset initial conditions, quantify apparent randomness using preregistered statistics, and measure spatial-temporal similarity across runs. Random-looking patterns with reproducibility far above a stochastic-input baseline support the prediction; ordinary run-to-run divergence refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Effective repeatability needs spatial, temporal, and tolerance definitions.", "Existing turbulence archives rarely contain independently repeated, meticulously reset runs.", "Residual preparation differences may dominate chaotic divergence.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.506"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-09--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-09 by GPT-5.6 Sol: 0.45";
