sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-48> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-48--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-48--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-48: partially-resolvable, resolvability 0.41" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.415"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "Public shape and organism repositories can support a statistical comparison of how regular designed objects look relative to natural ones, which is the observable surface of the claim. They do not record whether a designer needed a predictive theory, and many non-computational constraints produce simple artifacts. The available comparison is a proxy with serious confounds." ;
    rdfs:comment "Proposed test with existing data: Compare compressibility or geometric regularity of human-designed objects with natural objects in matched shape or image corpora. A robust simplicity gap is the surface prediction. The causal clause, that engineers must foresee behavior, needs a contrast with designed objects that were not required to be predictable." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Artifact and organism collections are unmatched samples.", "Materials, style, and function produce simple forms without any appeal to computational reducibility.", "A photograph does not measure whether a natural system is computationally irreducible." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-48--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-48--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-48--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-48 by Grok 4.7: 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.48"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-48--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-48> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-48--grok--operationalizability> .
