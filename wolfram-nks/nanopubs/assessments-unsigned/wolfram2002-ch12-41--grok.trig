sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-41> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-41--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-41--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-41: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.779"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The observation is a finite model-enumeration of the kind Mace4 performs, matching the book's tables for two, three, and four elements. A re-run either reproduces a strong majority of multi-model axioms or it does not. Infinite models are a further question; the claim as illustrated is about these finite operator forms, and that enumeration is feasible now." ;
    rdfs:comment "Proposed test with existing data: Enumerate short equational axioms for one binary operator and, with a finite-model finder, list the multiplication tables on two, three, and four elements that satisfy each axiom. The claim holds if, under an explicit simplicity ordering, most axioms admit many inequivalent tables and only a few force a single table." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Vast majority depends on the length cutoff and the ordering of axioms.", "Isomorphism pruning on three and four elements changes counts and leaves a qualitative majority meaningful.", "Finite domains omit operators whose only distinguishing models are infinite." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-41--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-41--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-41 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-41--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-41> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-41--grok--operationalizability> .
