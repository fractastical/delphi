sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-06: partially-resolvable, resolvability 0.41" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.411"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Public cell images and quantitative compilations establish that organisms are partitioned by membranes and that local order exists while cells persist. They do not separate that partitioning from energy flux, export of entropy, or self-organization in open systems, which are the serious rivals. The causal 'mainly' claim is therefore only partly approachable with existing data." ;
    rdfs:comment "Proposed test with existing data: Compare measures of spatial order inside living systems with the presence and lifetime of membrane-bounded compartments, holding energy throughput fixed. The claim would be supported if compartmentalization accounted for more of the maintained order than open-system free-energy flux; it would be weakened if order tracked metabolism across uncompartmentalized or membrane-disrupted systems." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Compartmentalization is confounded with metabolism and free-energy throughput.", "'The main mechanism' has no agreed partition of credit across biological systems." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-06 by Grok 4.7: 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.42"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-06--grok--operationalizability> .
