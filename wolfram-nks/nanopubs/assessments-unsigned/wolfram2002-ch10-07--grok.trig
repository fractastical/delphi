sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-07--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-07: partially-resolvable, resolvability 0.43" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.433"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.52"^^xsd:double ;
    dct:description "Intermediate-complexity preference is a known empirical question, and looking time is a measurable variable. Existing public materials do not line up with the specific contrast among random images, simply patterned images, and images whose features split into describable and indescribable. The claim is testable in part through related studies and is not settled by one open dataset." ;
    rdfs:comment "Proposed test with existing data: Classify images by whether human observers have a short description of some features but not others, then measure looking time and preference against purely random and purely simple controls. Preference peaking on the mixed class would support the claim; equal or higher preference for random or purely simple images would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Aesthetic preference and attention are task-dependent, and 'aesthetically pleasing' has several competing scales.", "No single public dataset uses Wolfram's partition into simply describable versus indescribable features." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-07--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-07 by Grok 4.7: 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.56"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-07--grok--operationalizability> .
