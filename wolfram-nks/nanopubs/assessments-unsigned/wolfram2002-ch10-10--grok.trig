    rdfs:label "Analysis feasibility of wolfram2002-ch10-10 by Grok 4.7: 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/analysis-feasibility" ;
    delphi:hasScore "0.66"^^xsd:double ;
