  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok--analysis-feasibility> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-10--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Laboratory for Computational Vision texture collection" ;
    dct:description "public textures and parametric models used to test local-feature accounts of texture discrimination" ;
    prov:wasDerivedFrom <https://www.cns.nyu.edu/~lcv/texture/> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-10--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Allen Brain Map" ;
    dct:description "public cortical cell data relevant to whether visual cells act as fixed local templates" ;
    prov:wasDerivedFrom <https://portal.brain-map.org/> .
  <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent ;
