sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-10: partially-resolvable, resolvability 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.677"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "Texture discrimination by local-feature statistics is a standard, operational hypothesis, and public texture sets plus cortical atlases contain the relevant variables. Those data support a density or summary-statistic account for many textures and also contain known counterexamples that need higher-order structure. The claim's extension to perception in general, by analogy with color, is wider than this test." ;
    rdfs:comment "Proposed test with existing data: Represent textures by densities of a fixed set of local templates and test whether those densities predict human discrimination as well as joint statistics or less structured image measures. Prediction from densities, with cortical responses matching the templates, would support the claim; systematic failures on textures that share densities but differ in dependencies would refute the density account." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Some texture pairs are discriminated by joint statistics even when marginal feature densities match.", "The broader claim that perception in general ignores everything but fixed features exceeds texture data." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-10--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-10 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch10-10 by Grok 4.7: 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/data-existence" ;
    delphi:hasScore "0.76"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of wolfram2002-ch10-10 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/data-adequacy" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok--data-adequacy> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-10--grok--discriminating-power> a delphi:LLMClaimAssessment ;
    rdfs:label "Discriminating power of wolfram2002-ch10-10 by Grok 4.7: 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-discriminating-power> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/discriminating-power" ;
