sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-17--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-17--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-17: needs-new-data, resolvability 0.31" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.306"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Phylogenies and morphology can identify recurrence but do not discriminate developmental commonness from adaptive optimality. The required baseline over programs is undefined and lineage-specific causal data are sparse. New developmental and fitness studies would be necessary." ;
    rdfs:comment "Proposed test with existing data: For independently evolved structures, estimate their frequency under an explicit distribution of developmental programs and measure fitness effects in each lineage. Recurrence despite rarity in program space and consistent adaptive advantage would refute the proposed explanation; common program outputs without advantage would support it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "There is no agreed probability distribution over possible developmental programs.", "Developmental accessibility and optimality can jointly cause convergence.", "Fitness and developmental mechanism data are absent for most convergences." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-17--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-17--gpt--dataset-2> .
