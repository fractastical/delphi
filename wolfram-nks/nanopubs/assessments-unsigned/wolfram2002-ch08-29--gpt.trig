sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-29> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-29: partially-resolvable, resolvability 0.63" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.627"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.81"^^xsd:double ;
    dct:description "Prices, order flow, and some external events are directly measurable, and substantial market data exist. Fully public high-resolution coverage is limited, while unobserved information prevents a clean classification of all shocks. Current resources can estimate endogenous shares for selected markets and periods, not settle the broad claim." ;
    rdfs:comment "Proposed test with existing data: Align high-frequency trade and quote changes with timestamped public news and scheduled information releases, then decompose short-horizon price variance using market-interaction models and exogenous-event controls. A dominant residual attributable to endogenous order-flow feedback would support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Comprehensive high-frequency order books are often paid rather than openly downloadable.", "Unobserved private information and news confound endogenous attribution.", "Variance decomposition depends on the causal market model." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-29--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-29 by GPT-5.6 Sol: 0.72" ;
