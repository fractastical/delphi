    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.57"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Large finite catalogs permit informative comparisons after substantial interpretation. The broad “almost all” conclusion is representation-dependent and cannot be settled across unspecified formalisms." ;
    rdfs:comment "Proposed test with existing data: Choose matched finite grammars of constraints and evolution rules, a sampling measure, and complexity metrics for their generated patterns, then compare the frequency of high-complexity outcomes. The claim is supported only if the result is robust across reasonable encodings and metrics." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "No canonical measure over “simple” systems.", "Pattern complexity has competing definitions.", "Rule and constraint formalisms are difficult to match fairly." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-21--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-21--gpt--dataset-2> .
