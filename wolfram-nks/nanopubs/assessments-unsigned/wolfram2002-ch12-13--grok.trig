sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-13--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-13: not-empirically-resolvable, resolvability 0.13" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.128"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    dct:type "resolution-route/none" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Wolfram introduces computational irreducibility as the situation in which prediction takes about as much work as the evolution itself. Scored as stated, the sentence is that definition, so a simulation of any particular rule only illustrates it. Public computation supplies examples and does not supply an independent confirming or refuting outcome." ;
    rdfs:comment "Proposed test with existing data: Call a system irreducible only when no predictor uses substantially fewer steps than the system, then ask whether prediction still takes nearly that many steps. That test repeats the definition." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The sentence applies the definition of computational irreducibility to systems already labeled irreducible.", "Without a separate criterion for irreducibility, every outcome fits the claim." .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-13 by Grok 4.7: 0.2" ;
