sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-14: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.473"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "Repetitive and nested elementary rules have known shortcuts that a public simulator can check against direct evolution, so the first clause is testable inside that class. The second clause quantifies over practically all remaining behavior, including natural systems, and a missed formula is weak evidence of irreducibility. Existing enumerations therefore probe a restricted proxy." ;
    rdfs:comment "Proposed test with existing data: Classify small cellular automata as repetitive, nested, or neither, and check whether the first two classes have shortcuts while the others lack any procedure shorter than direct evolution. A nested rule with no shortcut, or a complex-looking rule with a large shortcut, would count against the corresponding clause." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Failure to find a shortcut leaves open whether a shortcut exists.", "Practically all and obviously simple are not tied to a measure over systems.", "Elementary-rule enumerations cover a small slice of the stated scope." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-14--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-14 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok--operationalizability> .
