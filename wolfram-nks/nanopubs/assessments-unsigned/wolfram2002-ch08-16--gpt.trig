sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-16: partially-resolvable, resolvability 0.53" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.534"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "Public images, morphology matrices, and phylogenies support analyses in selected clades. Coverage and trait homology are uneven, and the proposed contrast between rapid change and selection is causally problematic. Existing resources can test correlations but not the almost-always or causal components." ;
    rdfs:comment "Proposed test with existing data: Across related species, estimate phylogenetic rates for homologous traits, assign quantitative pattern-complexity scores, and test their association while separately estimating evidence of stabilizing or directional selection. The claim predicts a near-universal positive rate-complexity relationship and low rates for selected features." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Obvious complexity is observer- and metric-dependent.", "Species differences do not directly measure evolutionary rate without dense phylogenies.", "Rapid change can itself be driven by selection." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--gpt--dataset-3> .
