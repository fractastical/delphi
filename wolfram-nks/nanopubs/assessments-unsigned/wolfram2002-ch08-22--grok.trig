sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-22--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-22--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-22: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.648"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The model is a small parameter sweep, and public specimen portals contain large numbers of shells across the classical morphospace. That is enough to test occupation of much of the model. It is not enough to certify that essentially every generated form occurs, because rare geometries and photographic gaps remain. The claim is resolvable in large part and not in full." ;
    rdfs:comment "Proposed test with existing data: Sample the few-parameter shell-growth model on a grid of expansion, translation, and aperture shape, and ask what fraction of occupied cells have a matching specimen. A match for essentially every cell would support the claim; a substantial region of the model with no real shell would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Image coverage is uneven, so an empty cell in the model may be a gap in digitization.", "Matching a geometric parameter to a shell is partly a judgment about which coiling features count." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-22--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-22--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-22--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-22 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-22--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-22--grok--operationalizability> .
