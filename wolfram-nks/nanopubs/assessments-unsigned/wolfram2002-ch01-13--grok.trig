sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-13--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch01-13: partially-resolvable, resolvability 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.377"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Genome archives and digital-evolution software let a team estimate some complexity trends with and without selection. Both are partial proxies: genomes are not a direct complexity measure, and Avida is not wild biology. Selection and complexity are statistically confounded in comparative data, so existing resources can challenge extreme versions and cannot show what produces most biological complexity." ;
    rdfs:comment "Proposed test with existing data: Measure a declared complexity statistic along lineages with estimated selection intensity, in organisms and in digital evolution, and test the sign of the association. The claim is supported if complexity falls or stalls where selection is effective and rises where simple-program dynamics run without selection. It is refuted if selection systematically increases that statistic after the program-intrinsic contribution is controlled for." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Genome size and morphological disparity are contested proxies for complexity.", "Selection intensity is usually inferred from the same traits whose complexity is at issue.", "Digital evolution tests an abstract analogue, not most biological complexity." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch01-13 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-13--grok--operationalizability> .
