sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-06: resolvable-now, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.743"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Mass and momentum conservation plus molecular chaos is the standard route to the Navier-Stokes equations, and lattice-gas rules can be rerun and compared with public turbulence fields. Breaking a conservation law changes the large-scale equation, which is a clean control. For ordinary fluids the claim can be confirmed or refuted with existing theory and data." ;
    rdfs:comment "Proposed test with existing data: Derive or simulate the large-scale momentum equation for particle or lattice-gas rules that conserve mass and momentum, and compare the resulting flow, at matched Reynolds number, with laboratory or direct numerical solutions of ordinary fluids. Universal Navier-Stokes behavior when the conservation laws and a randomness condition hold, and a different large-scale law when they are broken, would support the claim; a conserved, sufficiently random particle system whose large-scale flow is not hydrodynamic would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The hydrodynamic limit assumes enough randomness and isotropy; some conserving rules stay correlated and do not yield simple viscosity.", "Complex fluids are outside the ordinary fluids the claim is aimed at." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-06 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok--operationalizability> .
