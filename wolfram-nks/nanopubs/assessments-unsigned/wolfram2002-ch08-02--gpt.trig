sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-02--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-02--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-02: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.559"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "The cellular automaton is straightforward to simulate and snow-crystal images permit morphology comparison. Existing public imagery is less suitable for testing the proposed latent-heat mechanism, and shape fit has limited discrimination among rival crystal-growth models. Thus only the phenomenological part is currently approachable." ;
    rdfs:comment "Proposed test with existing data: Compare preregistered geometric descriptors of time-resolved snow-crystal images with outputs from the exact hexagonal rule and rival diffusion and heat-transport models. Support requires reproduction of the main descriptors plus an observed relation between local latent-heat conditions and growth suppression; visual similarity alone is insufficient." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Archival final images lack local temperature and vapor histories.", "Many distinct growth mechanisms can produce similar hexagonal morphology.", "Main features is underspecified." .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-02--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-02 by GPT-5.6 Sol: 0.7" ;
