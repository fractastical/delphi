sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-25> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-25--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-25--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-25: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.802"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "The empirical content is the collision phenomenology of rule 110, and both the structures and a collision that takes more than 4000 steps are specified well enough to rerun in Golly. A small team can measure transient lengths and outgoing objects in days. That decides the rule 110 claim; the phrase class 4 systems like rule 110 is carried by this exemplar rather than by a survey." ;
    rdfs:comment "Proposed test with existing data: Resimulate the published rule 110 collisions, including the collision whose outcome is unresolved for thousands of steps, and record transient length and the number of outgoing objects. Long input-sensitive cascades support the claim; uniformly short, simple scattering would refute it for this rule." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Immense is pinned here to the book's own transients of thousands of steps.", "A finite collision catalogue does not describe every interaction.", "Complexity of an outcome still depends on which description length is used." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-25--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-25--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-25--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-25 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-25--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-25> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-25--grok--operationalizability> .
