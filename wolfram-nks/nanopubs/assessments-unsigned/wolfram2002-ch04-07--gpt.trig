sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-07--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-07--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch04-07: partially-resolvable, resolvability 0.83" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.827"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    dct:description "The exact process is cheap to reproduce and its finite pattern can be independently analyzed. Current finite computation can support the observation but does not by itself resolve its asymptotic wording." ;
    rdfs:comment "Proposed test with existing data: Reproduce base-2 reverse-and-add from 512, quantify spatially persistent local motifs, and search the exact trajectory for eventual periodicity over a long horizon. The visible-structure claim is directly checkable, while a proof of eventual periodicity or nonperiodicity is needed for the unbounded repetition claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Localized structure needs a declared detector.", "Finite absence of repetition cannot prove never-repetitive behavior." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-07--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-07--gpt--operationalizability> a delphi:LLMClaimAssessment ;
