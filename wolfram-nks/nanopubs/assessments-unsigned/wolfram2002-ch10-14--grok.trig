sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-14--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-14: resolvable-now, resolvability 0.91" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.913"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "The claim is the negation of a proposed universal test, and it is settled by counterexample. Shift-register sequences and digit concatenations are public, simply generated, and known to have balanced block frequencies while remaining non-random by an independent check. One verified counterexample refutes universality; no broader dataset is required." ;
    rdfs:comment "Proposed test with existing data: Take an explicit sequence such as a linear-feedback shift-register output or the concatenation of the binary representations of the integers, compute block frequencies, and apply a second regularity test such as the spread of those frequencies or the linear recurrence. Accurate block frequencies together with a detected regularity refute the claim that equal block frequencies are a universal randomness test." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Equality of frequencies for every block length is an infinite condition; a proof uses the construction rather than a finite table of counts." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-14--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-14 by Grok 4.7: 0.93" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.93"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-14--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-14--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-14--grok--data-existence> a delphi:LLMClaimAssessment ;
