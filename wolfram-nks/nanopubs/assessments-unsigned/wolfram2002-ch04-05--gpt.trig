sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-05--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-05--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch04-05: partially-resolvable, resolvability 0.81" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.812"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.88"^^xsd:double ;
    dct:description "The trajectories and their sizes are exactly computable, making the finite observational content highly accessible. The asymptotic no-repetition implication and unqualified randomness cannot generally be established by finite runs." ;
    rdfs:comment "Proposed test with existing data: Iterate the stated piecewise integer maps from specified seeds and analyze the scalar size series for periodicity, recurrence, entropy rate, autocorrelation, and compression. Irregular size fluctuations over long ranges confirm finite-behavior complexity, whereas a proved cycle would refute the no-repetition component." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "No observed repetition over a finite horizon does not prove nonrepetition.", "Complex and apparently random are metric-dependent." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-05--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-05--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-05 by GPT-5.6 Sol: 0.75" ;
