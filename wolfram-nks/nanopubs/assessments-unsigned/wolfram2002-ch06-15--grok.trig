sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-15: resolvable-now, resolvability 0.91" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.911"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.88"^^xsd:double ;
    dct:description "Rule 90 is left XOR right, so additivity and superposition of the single-cell nested pattern are a short algebraic proof covering every initial condition. The low-density contrast with rule 22 is the same fact read off a simulation and can be reproduced in minutes. The scope is these two rules, which the proof and the runs cover." ;
    rdfs:comment "Proposed test with existing data: Check that rule 90 is linear over GF(2), hence every spacetime diagram is the XOR of single-cell diagrams, and compare a low-density random seed under rule 90 and rule 22. Persistent density modulation in rule 90 and its disappearance in rule 22 confirm the contrast; a nonlinear identity, or a low-density effect that dies in rule 90, would refute the corresponding clause." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The density picture is a finite run; the persistence claim itself follows from linearity.", "Cannot generate randomness intrinsically is settled by the superposition theorem, not by a statistical test." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-15--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-15 by Grok 4.7: 0.92" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.92"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-15--grok--operationalizability> .
