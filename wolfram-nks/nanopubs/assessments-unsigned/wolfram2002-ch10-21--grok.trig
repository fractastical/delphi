sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-21: needs-new-data, resolvability 0.29" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.29"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "The claim is that thinking has a core of simple rules largely independent of how neurons are built. Brain and behavior datasets record the neural detail and some performance, but they do not contain that core or a test of its implementation independence. Deciding the claim needs an explicit rule-level account that has not been produced." ;
    rdfs:comment "Proposed test with existing data: Specify a small rule set claimed to be the core of thinking, show that its behavior is unchanged under changes of neural implementation, and compare it with human performance. A core that survives implementation changes and matches behavior would support the claim; essential dependence on particular neural detail would refute independence." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'Rather simple rules' and 'a definite core' are not tied to a stated formal system.", "Existing brain maps record neural detail; they do not contain a demonstration that thinking is independent of it." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-21 by Grok 4.7: 0.34" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.34"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-21--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch10-21 by Grok 4.7: 0.36" ;
