  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-21--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Human Connectome Project" ;
    dct:description "public measurements of human brain structure and behavior, without an identified simple-rule core" ;
    prov:wasDerivedFrom <https://www.humanconnectome.org/> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-21--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Allen Brain Map" ;
    dct:description "public neural-circuit detail of the kind the claim says the core does not depend on" ;
    prov:wasDerivedFrom <https://portal.brain-map.org/> .
