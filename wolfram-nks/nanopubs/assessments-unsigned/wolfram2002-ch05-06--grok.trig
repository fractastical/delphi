sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch05-06: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.658"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The numerical claim, a few complex rules per million at four states and only simple behavior at two or three, is a sampling statement that a small team can replicate. Two-state machines are small enough for a near-census; four-state machines are not, and the result hinges on an automatic behavior classifier. That replication can confirm the order of magnitude or refute it, with a serious classification confound, so it resolves the claim only in part." ;
    rdfs:comment "Proposed test with existing data: Sample millions of two-dimensional Turing machines with two, three, and four head states and two colors, and classify each run as repetitive, nested, or complex. A complex fraction near a few per million at four states, and none at two or three states in a large sample, would support the claim; a complex fraction of many percent would refute 'rare.'" ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Long-period nested motion is easily misclassified as complex, which moves the estimated rate by more than 'a few per million.'", "The four-state, two-color, four-direction rule space is far too large to exhaust, so the rate is a sample estimate." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch05-06 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-06--grok--operationalizability> .
