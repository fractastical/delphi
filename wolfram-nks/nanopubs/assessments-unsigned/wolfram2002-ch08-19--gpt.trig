sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-19--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-19--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-19: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.605"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Plant architecture and recursive-model parameters are measurable, and existing repositories cover some taxa. They do not provide uniform time-resolved developmental data across algae, ferns, trees, and flowering plants. Model fit alone also has limited power to establish the actual growth mechanism." ;
    rdfs:comment "Proposed test with existing data: Fit recursive fixed-angle, fixed-ratio branching models to time-resolved and mature plant architectures across major lineages, then compare held-out geometry with models allowing nonrecursive developmental control and environmental plasticity. Systematic predictive success with few fixed parameters would support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Public data emphasize mature form rather than repeated tip-splitting trajectories.", "Branching responds strongly to light, damage, hormones, and resource gradients.", "Most overall patterns spans very different plant lineages." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-19--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-19--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-19--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-19 by GPT-5.6 Sol: 0.65" ;
