sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-17--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-17: resolvable-now, resolvability 0.90" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.9"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Non-overlap is a syntactic condition, and the causal network is a finite combinatorial object of the rewrite history. Non-interfering rewrites are order-independent by a short confluence argument, and overlapping blocks supply counter-models. Both the proof and an exhaustive check of small rule sets are within standard methods." ;
    rdfs:comment "Proposed test with existing data: Prove that replacement rules whose blocks cannot overlap themselves or each other never interfere, and check that every application order builds the same causal network; compare with an overlapping block that yields two networks. Identity of the networks confirms the claim; a non-overlapping rule with two causal networks refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Wolfram's weaker proviso, that overlaps need only be absent on strings the system actually generates, must be checked separately from purely syntactic non-overlap." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-17--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-17 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-17--grok--operationalizability> .
