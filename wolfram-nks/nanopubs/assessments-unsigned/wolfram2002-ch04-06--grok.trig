sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch04-06: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.555"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Both sides of the comparison are simulable, and one can score arithmetic orbits and cellular automata with one classifier. The claim that the kinds of behavior are very similar, and that rule details therefore do not matter, is a qualitative summary of those pictures rather than a criterion with an obvious refutation. A matched sample is informative and still confounded by how the classes are drawn." ;
    rdfs:comment "Proposed test with existing data: Classify ensembles of simple arithmetic iterations and of local cellular automata with the same behavior taxonomy, and compare the frequencies of repetition, nesting, irregularity, and localized structures. A large, robust difference in those frequencies would challenge 'very similar'; agreement would support it for the sampled families." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'Very similar' and 'do not crucially affect' have no sharp distance between behavior classes.", "Carries are non-local, so a similarity of pictures can coexist with different mechanisms, and both readings fit the same outputs." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-06 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-06--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-06--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch04-06 by Grok 4.7: 0.75" ;
