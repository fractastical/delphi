sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-20: resolvable-now, resolvability 0.89" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.89"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "The claim is a statement about simple programs, and the elementary cellular automata are a finite public object. Recomputing the Gray-code sequence of neighboring rules and scoring their output takes days with standard tools. A direct correspondence would show up as a strong correlation; its absence is a decisive result for the stated scope." ;
    rdfs:comment "Proposed test with existing data: Enumerate small cellular-automaton rule spaces, measure rule-table complexity against a behavioral-complexity statistic such as spacetime compressibility or Wolfram class, and compare rules that differ by one table entry. A weak or absent correlation, with adjacent rules in different classes, would support the claim; a tight monotone relation between rule complexity and behavioral complexity would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Behavioral complexity has several inequivalent measures, though the qualitative mismatch is stable across the usual ones." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-20--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-20--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-20 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok--operationalizability> .
