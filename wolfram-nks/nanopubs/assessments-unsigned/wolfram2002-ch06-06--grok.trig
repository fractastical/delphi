sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-06: partially-resolvable, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.706"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Activity is a direct time series, and the book's one-parameter sequences are fully specified, so the intermediate-activity pattern can be measured in days on those sequences. Commonly over sequences of rules, discrete and continuous, is wider than any one family, and class labels remain partly visual. The ordering is a real test on the published sequences and a sample beyond them." ;
    rdfs:comment "Proposed test with existing data: Define activity as the fraction of cells that change per step, assign classes by localized structures rather than by activity, and test whether class 4 sits between class 2 and class 3 along stated one-parameter rule sequences. A class 4 stretch whose activity matches class 3, or a sequence whose class 4 rules sit outside the class 2 to class 3 boundary, would challenge the claim in that family." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The ordering is informative only when class labels are not themselves activity thresholds.", "Commonly depends on how rule sequences are parametrized.", "A single class 4 run wavers, so the comparison needs a time average." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-06 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--grok--operationalizability> .
