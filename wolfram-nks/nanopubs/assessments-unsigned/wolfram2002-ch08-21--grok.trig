sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-21--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-21: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.658"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "The angle is a sharp prediction, and both the inhibition model and nonliving experiments that produce it are reproducible with public methods and published measurements. Those measurements are dispersed rather than deposited as one dataset, and photographs do not replace goniometry. The mechanism is testable now for well-studied plants; the further denial of any optimizing role for selection is not settled by the same evidence." ;
    rdfs:comment "Proposed test with existing data: Measure divergence angles in a wide sample of plants and run the local-depletion model, testing whether it converges to about 137.5 degrees and whether physical or chemical inhibition experiments do the same without a fitness search. Convergence to that angle under inhibition, including in nonliving analogs, would support the growth mechanism; a different angle, or an angle that appears only when a shading optimum is imposed, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "There is no single open archive of measured divergence angles across the plant kingdom.", "Showing that a growth rule yields the angle does not by itself prove that selection played no role in retaining it." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-21 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-21--grok--operationalizability> .
