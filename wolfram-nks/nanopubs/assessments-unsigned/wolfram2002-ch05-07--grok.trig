sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-07--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch05-07: resolvable-now, resolvability 0.81" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.813"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "The claim is that independent replacement forces a nested pattern, and that follows from the definition of an iterated function system: each stage is an assembly of copies of the previous stage. The argument covers grids and free geometric rules, including the overlapping cases Wolfram mentions. Examples can be drawn to illustrate it; the proof is what settles the universal wording." ;
    rdfs:comment "Proposed test with existing data: A neighbor-independent replacement rule sends each element to a fixed finite configuration of smaller elements, so the pattern at step n is a union of scaled copies of the pattern at step n-1. That is nested structure. A deterministic neighbor-independent geometric rule whose construction is not self-similar would refute the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Heavy overlaps can make the drawn picture look solid rather than nested even though the construction is still hierarchical.", "Random or neighbor-dependent replacements are outside the claim and are not counterexamples." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-07--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch05-07 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-07--grok--operationalizability> .
