sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch02-04: partially-resolvable, resolvability 0.32" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.316"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The phenomenon of complexity from simple rules is computable, but responsibility for most natural complexity is a causal claim about the world. Public morphology covers a biased slice of biological form and does not record the rules that generated it. Existing material can support scattered lookalike comparisons and cannot confirm or refute the universal causal wording." ;
    rdfs:comment "Proposed test with existing data: Inventory complex natural phenomena, determine the actual rules and initial conditions of each, and test whether most of them are simple rules started from simple states. Confirmation requires that causal inventory. Matching a program's output to a photograph tests only a proxy on a few systems." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The generative rules of most natural systems are not known.", "Similar-looking complexity is produced by selection and by continuum physics.", "There is no agreed catalogue of 'most of the complexity seen in nature.'" ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch02-04 by Grok 4.7: 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.35"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok--operationalizability> .
