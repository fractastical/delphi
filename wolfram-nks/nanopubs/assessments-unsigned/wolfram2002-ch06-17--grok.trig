sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-17--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-17: resolvable-now, resolvability 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.949"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.92"^^xsd:double ;
    dct:description "The argument in the text is a complete proof: spatial period n plus a deterministic local rule reduces each block to a finite ring of 2^n states, which must cycle. It applies to every cellular automaton, which is the stated scope, and the counting step is immediate. Concrete rules can be spot-checked in Golly, but the general claim does not depend on those runs." ;
    rdfs:comment "Proposed test with existing data: A spatially periodic seed of period n makes every length-n block identical, so one block evolves as a 2^n-state deterministic system and the temporal period is at most 2^n. A cellular automaton and a repeated block whose evolution never cycled within that bound would refute the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The bound is an upper limit, not the period that a given block actually attains.", "The factor 2^n is for two colors; the same argument with k colors gives k^n." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-17--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-17 by Grok 4.7: 0.98" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.98"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-17--grok--operationalizability> .
