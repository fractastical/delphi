sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-19--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-19--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch04-19: resolvable-now, resolvability 0.90" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.895"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    dct:description "The shift map is the left shift on binary digits, which is a short exact identity rather than an empirical tendency. It covers every seed in the unit interval, so scope and discriminating power match the claim: simple seeds stay simple, and irregular output is copied from irregular seeds. Numerical checks illustrate the identity; the proof settles it." ;
    rdfs:comment "Proposed test with existing data: Prove that the doubling map modulo 1 shifts the base-2 expansion one place to the left. The orbit of a dyadic rational such as 1/2 is then eventually zero, and the orbit looks random only when the seed's digits already do. An orbit of a simple seed that is random in the leading bits would refute the identity." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The phrase 'no randomness of its own' is philosophical if randomness is not located in the digit sequence, but that is the location the claim uses." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-19--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-19--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-19--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-19 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-19--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-19--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-19--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch04-19 by Grok 4.7: 0.85" ;
