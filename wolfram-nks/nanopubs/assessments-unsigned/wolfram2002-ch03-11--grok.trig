sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-11--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-11: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.595"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The existence of complicated three- and four-color examples is a finite check of published rules. The claim that every slow-growth two-color deleting substitution is merely repetitive ranges over an open-ended format and, in the source, rests on observation of the rules that were tried. Short rules can be re-enumerated now; the unrestricted two-color statement cannot be closed by that enumeration." ;
    rdfs:comment "Proposed test with existing data: Resimulate the published three- and four-color slow-growth substitution systems and test them for randomness-like statistics; that checks the existence half. For two colors, either prove that every slow-growth deleting rule is eventually periodic or exhaust a declared finite subclass. An incompressible two-color slow-growth example refutes the restrictive half." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Block length is unbounded, so the two-color family is infinite and a search of short rules does not cover it.", "Slow growth and simple repetitive pattern need numeric definitions.", "The source presents the two-color statement as what the search found, which is weaker than a proof." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-11--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-11 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-11--grok--operationalizability> .
