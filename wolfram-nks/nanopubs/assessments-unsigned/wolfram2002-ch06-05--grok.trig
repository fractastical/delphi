sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-05--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-05: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.601"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "The positive half, that some syntactic families never leave class 1 or 2, is a finite proof of the sort the text sketches and can be checked. The negative half, that most rules have no easy class readout, is an absence claim: public rule tables let one try predictors, and a strong predictor would hurt it, but unsuccessful trials leave it open. The two halves therefore resolve to different degrees." ;
    rdfs:comment "Proposed test with existing data: Prove the syntactic restrictions that the text says yield only class 1 or 2, and separately train simple predictors from the rule table to the class on a held-out finite family. A predictor that is short and accurate on most of that family would challenge the no-easy-way clause; the syntactic proofs stand or fall on their own." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Failure of several predictors does not prove that no easy predictor exists.", "Undecidability applies to infinite families, not to one fixed finite rule table.", "Easy way is a family of formalizations, not a single test." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-05 by Grok 4.7: 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.52"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-05--grok--operationalizability> .
