sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-05: partially-resolvable, resolvability 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.548"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Standard test suites and large sequence archives exist, and enumerating very short programs is feasible. That can estimate how often a further short program finds structure after a few standard tests fail, for a bounded class. It cannot cover every simple program, so the claim's unrestricted rarity statement stays only partly tested." ;
    rdfs:comment "Proposed test with existing data: Take sequences and images that pass a fixed set of standard tests, then enumerate simple programs up to a length cutoff and measure how often another program detects a regularity. A high rate of extra detections would refute 'extremely rare'; a near-zero rate inside the cutoff supports the claim only inside that cutoff." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The space of simple programs is unbounded, so 'any other simple program' can be searched only up to a size limit.", "A regularity can be invisible to every test in a chosen finite set without being absent." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-05 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok--operationalizability> .
