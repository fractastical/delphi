sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-46> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-46--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-46--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-46: not-empirically-resolvable, resolvability 0.25" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.253"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    dct:type "resolution-route/none" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "Memory-like persistence in a cellular automaton or a fluid is easy to simulate and puts pressure on particular proposed marks of intelligence. The sentence concludes that every workable definition must collapse into human particulars. Failed proposals do not distinguish that conclusion from the existence of a definition not yet stated." ;
    rdfs:comment "Proposed test with existing data: For each candidate feature, such as learning, adaptation, or abstraction, either exhibit it in a system nobody counts as intelligent or show that humans lack it. Any finite list of features leaves open whether some other general definition works." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A proposed definition can be revised after each counterexample.", "Workable, and what we normally think of as intelligence, are judgments." .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-46--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-46 by Grok 4.7: 0.25" ;
