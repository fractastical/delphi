  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-44--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch12-44: partially-resolvable, resolvability 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.675"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Existing formal and textbook resources permit a reproducible comparison for a chosen corpus and ordering. They cannot establish the claim invariantly because both the complexity measure and historical textbook sample materially affect the result." ;
    rdfs:comment "Proposed test with existing data: Fix a syntax-based theorem complexity ordering, compute which tautologies are not derivable from earlier selected theorems under the intended basis criterion, and compare that set with named laws from a preregistered textbook corpus. Precision, recall, and null-ordering comparisons quantify the match." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "The result depends strongly on notation and complexity ordering.", "The textbook sample and meaning of interesting may be selected after seeing results.", "Named laws are historically dependent." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-44--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-44--gpt--dataset-2> .
