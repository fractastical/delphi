sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-02--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch04-02: resolvable-now, resolvability 0.81" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.808"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "The claim is existential and the examples are elementary iterations. Public arbitrary-precision arithmetic recomputes them far past the pictures in the book, and a detected closed form or eventual period would refute a specific example while a persistent irregular pattern confirms the 'can.' That is enough to settle the claim as stated, with the usual limit that statistical tests do not prove infinite randomness." ;
    rdfs:comment "Proposed test with existing data: Compute long orbits of simple arithmetic iterations, including successive powers of 3 in base 2, and test the digit arrays and size series for periodicity, nesting, and statistical irregularity. A long irregular orbit confirms that simple number systems can be complex; every simple arithmetic system in a declared class collapsing to a short closed form would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A finite irregular prefix can still have a regularity that appears only at larger scales.", "'Highly complex' has to be read as failing standard periodicity and compression tests rather than as a proved absence of a formula." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-02--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-02 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-02--grok--operationalizability> .
