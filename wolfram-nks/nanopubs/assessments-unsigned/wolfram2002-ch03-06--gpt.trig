    delphi:hasScore "0.915"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.92"^^xsd:double ;
    dct:description "The basic rule space is finite and computationally modest, enabling exhaustive reproduction and targeted proof for long transients. The extension's rarity can likewise be estimated or counted under explicit criteria." ;
    rdfs:comment "Proposed test with existing data: Enumerate all 65,536 specified mobile-automaton rules from the stated initial condition, classify each trajectory for periodicity, nesting, and stronger complexity metrics, then enumerate the neighbor-updating extension. Any qualifying complex trajectory in the basic class refutes the absolute count." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Ultimate simplicity may not be inferable from a fixed finite horizon.", "Complex behavior requires a declared criterion." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-06--gpt--dataset-1> .
