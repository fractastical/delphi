sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-51> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-51--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-51--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-51: partially-resolvable, resolvability 0.40" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.395"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.52"^^xsd:double ;
    dct:description "A short program, and the recorded prime sequence, show that primes are produced by systems with no claim to intelligence, so that half is resolvable by computation. The stellar-turbulence comparison is quantitative and physical. Public turbulence databases support order-of-magnitude estimates for earthly flows, and they do not settle an accounting of computation around a star against human intellectual history." ;
    rdfs:comment "Proposed test with existing data: Fix a measure of computation and compare a model of turbulence in stellar gas with an estimate for recorded human calculation, and separately exhibit non-designed systems that output the primes. The primes half is immediate; the turbulence comparison is only approximated by existing flow databases." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Amount of computation is left as most measures, and those measures disagree.", "Laboratory turbulence is a proxy for gas around a star, and human intellectual history is not a standard dataset.", "A short prime generator settles only the easier half of the claim." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-51--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-51--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-51--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-51 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-51--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-51> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-51--grok--operationalizability> .
