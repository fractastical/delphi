sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-42> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-42--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-42--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-42: resolvable-now, resolvability 0.79" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.794"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Short single axioms for Nand logic are a finite search plus a proof of equivalence, both standard, and both carried through for the six-Nand axioms. Model finders reproduce the screening step, and a formal derivation can check that a candidate axiomatizes propositional logic. The likelihood remark is then the position of those axioms in the same enumeration." ;
    rdfs:comment "Proposed test with existing data: Search single equations with at most six Nands, test which small finite operators they allow, and confirm a survivor by a proof that it axiomatizes propositional logic. Finding such an axiom among the shortest few thousand candidates, and none shorter, supports the claim; a gap in the equivalence proof removes that candidate." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The simplest few thousand depends on the enumeration order of axioms.", "Allowing only Nand and Nor on a small domain is a screen; equivalence to propositional logic still needs a proof." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-42--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-42--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-42--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-42 by Grok 4.7: 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.86"^^xsd:double ;
