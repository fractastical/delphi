sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-01--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch05-01: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.597"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "One-dimensional elementary cellular automata are fully enumerable, and two-dimensional totalistic rules are searchable with public software, so a dimension comparison is a real computation. Three-dimensional samples and the words 'does not fundamentally change' keep the result from covering the whole claim. The test can detect a gross dimension effect and cannot certify that no such effect exists outside the sampled families." ;
    rdfs:comment "Proposed test with existing data: For matched families of cellular automata, Turing machines, and substitution systems in one, two, and three dimensions, estimate the fraction of small rules with irregular behavior. A sharp drop or jump in that fraction with dimension would challenge 'does not fundamentally change'; stable fractions would support it inside those families." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Three-dimensional and large-neighborhood rule spaces can only be sampled, and the sample can miss rare complex rules.", "'Fundamentally' and 'not much effect' move with the classifier and with how rules are paired across dimensions." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-01--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch05-01 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-01--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-01--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch05-01 by Grok 4.7: 0.75" ;
