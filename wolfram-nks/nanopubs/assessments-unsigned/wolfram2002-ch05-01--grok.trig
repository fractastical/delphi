    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-01--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-01--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of wolfram2002-ch05-01 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy> ;
