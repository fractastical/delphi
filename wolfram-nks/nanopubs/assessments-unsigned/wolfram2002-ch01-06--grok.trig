sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch01-06: partially-resolvable, resolvability 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.381"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Thermodynamic tables and reversible-automaton simulations both exist, so the computational illustration and the numerical facts of thermodynamics can be put side by side. They do not isolate this explanation from the Boltzmann and ergodic accounts, which predict the same increase of entropy. The claim that the program picture resolves the foundational difficulty therefore stays only partly testable." ;
    rdfs:comment "Proposed test with existing data: Derive a second-law statement from an explicit simple-program model, then compare its entropy production and equilibrium statistics with laboratory thermodynamic data and with the Boltzmann account. Confirmation requires a distinguishing prediction that the data favor; a simulation that merely increases a coarse-grained entropy does not." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Entropy increase in a typical reversible system is also predicted by ordinary statistical mechanics.", "Resolving a conceptual difficulty is not a dataset outcome.", "Coarse-graining choices can manufacture or remove an entropy increase." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch01-06 by Grok 4.7: 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.38"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-06--grok--operationalizability> .
