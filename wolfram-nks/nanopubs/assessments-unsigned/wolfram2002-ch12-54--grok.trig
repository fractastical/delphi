sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-54> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-54--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-54--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-54: partially-resolvable, resolvability 0.41" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.414"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.53"^^xsd:double ;
    dct:description "DNA self-assembly has produced cellular-automaton-like patterns, including Sierpinski triangles, so a chemical medium that carries simple-rule computation is already experimental fact at molecular scale. The sentence specifies a rule 110-like universal computer at one or a few atoms per cell, assembled by a simple chemical process. That object is not in any public dataset, and the coarser demonstrations constrain plausibility only weakly." ;
    rdfs:comment "Proposed test with existing data: Assemble, by a simple chemical process, a lattice whose update is rule 110 or an equivalent universal cellular automaton, with one or a few atoms or molecules per cell, and run a non-trivial computation. Success would confirm the claim. Existing DNA-tile automata confirm a coarser molecular construction." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "DNA tiles show programmed self-assembly of a nested pattern, not a universal computer with one atom per cell.", "Plausible and likely have no numerical threshold.", "A failed laboratory attempt is compatible with the claim that some simple chemical process could succeed." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-54--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-54--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-54--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-54 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-54--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-54> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-54--grok--operationalizability> .
