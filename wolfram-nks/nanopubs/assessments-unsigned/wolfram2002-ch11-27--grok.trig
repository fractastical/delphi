sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-27> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-27--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-27--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-27: resolvable-now, resolvability 0.89" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.888"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.85"^^xsd:double ;
    dct:description "The machine is a finite table, and the proposed emulation is a concrete head motion that can be compared with rule 110 for any number of sweeps. That comparison, together with the published universality of rule 110, is a complete proof. Both the table and the rule-110 proof are public." ;
    rdfs:comment "Proposed test with existing data: Take the published 2-state 5-color transition table and the sweep encoding of a rule-110 row. Confirm if each completed sweep updates the tape by exactly one rule-110 step; universality follows because rule 110 is universal. A sweep that mismatches rule 110 refutes the reduction." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The reduction shows universality relative to the rule-110 proof; an error in that proof would carry over." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-27--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-27--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-27--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-27 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-27--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-27> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-27--grok--operationalizability> .
