sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-25> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-25--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-25--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-25: partially-resolvable, resolvability 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.355"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "The computational phenomenon, that nearby simple rules diverge in form, is immediate to check. The biological claim that most diversity and complexity come from essentially random sampling of such rules is a historical cause that images and program catalogs do not record. Existing resources illustrate the mechanism and do not resolve its responsibility for most organismal form." ;
    rdfs:comment "Proposed test with existing data: Show that small changes in simple growth rules change simulated form sharply, then ask whether real diversity is concentrated among traits whose genetic differences look like draws from a short random rule rather than like selected parameter tuning. A match between observed form diversity and the random-rule ensemble, without a selection signal, would support the claim; diversity that tracks measured functional optima would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Randomly picked is not observable from adult form.", "Sensitivity of a model to its parameters does not show that evolution samples rules that way." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-25--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-25--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-25--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-25 by Grok 4.7: 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.35"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-25--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-25> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-25--grok--operationalizability> .
