sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-04--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-04: partially-resolvable, resolvability 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.553"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "Deviation from perfect randomness is operational in the NIST and TestU01 batteries, and published evaluations of noise-based generators are real but scattered. Those evaluations over-represent modern diodes relative to the spark gaps and vacuum tubes named in the text, and they rarely separate relaxation from environmental correlation. The sample can test a proxy for consistently; it does not cover the historical class." ;
    rdfs:comment "Proposed test with existing data: Run a standard randomness battery on bitstreams from noise-amplifying hardware, and where the device physics is documented, test dead time and environmental correlation as causes. Systematic battery failures support deviations; a large public set of historically relevant devices that pass would challenge consistently." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A failed battery shows a deviation; a passed battery does not prove perfect randomness.", "Open streams cover modern semiconductor devices far better than spark gaps and vacuum tubes.", "Dead time and environmental correlation are confounded in most published bitstreams." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-04 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-04--grok--operationalizability> .
