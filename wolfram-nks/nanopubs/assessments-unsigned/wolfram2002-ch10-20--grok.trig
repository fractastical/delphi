  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: OpenNeuro" ;
    dct:description "public neuroimaging of reasoning and memory tasks, covering only some of the claimed cognitive domains" ;
    prov:wasDerivedFrom <https://openneuro.org/> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Human Connectome Project" ;
    dct:description "public behavioral and imaging measures related to cognition, not a partition of thought into memory versus logic" ;
    prov:wasDerivedFrom <https://www.humanconnectome.org/> .
