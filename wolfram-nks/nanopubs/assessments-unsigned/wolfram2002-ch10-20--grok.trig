sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-20: partially-resolvable, resolvability 0.37" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.372"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.48"^^xsd:double ;
    dct:description "Cognitive datasets can address particular contrasts, such as analogy versus application of a stated rule. The claim says memory retrieval underlies almost all thinking and that logic itself is retrieved argument patterns. Those public resources cover fragments of that list, and most outcomes can be described in either the memory language or the rule language." ;
    rdfs:comment "Proposed test with existing data: Across tasks that operationalize generalization, analogy, intuition, and deduction, test whether performance is predicted by similarity to stored instances rather than by application of content-free rules. A consistent memory-similarity account would support the claim; a dissociation in which logical performance tracks rule use and not retrieval would limit it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Almost any reasoning trace can be redescribed as retrieval of a learned pattern.", "'Almost every major aspect of human thinking' has no fixed task list." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-20 by Grok 4.7: 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.38"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch10-20 by Grok 4.7: 0.5" ;
