  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-14--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch09-14: needs-new-data, resolvability 0.36" ;
