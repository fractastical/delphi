sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-23> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-23--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-23--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-23: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.802"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "The search space is finite and small, and classifying two-state two-color machines is within standard exhaustive methods. Re-running the census under the stated convention confirms or refutes the list of growth rates directly. Blank-tape busy-beaver tables check the same family of machines and use a different input convention, so the exact census is recomputed rather than downloaded." ;
    rdfs:comment "Proposed test with existing data: Enumerate all 4096 two-state two-color machines under the head-exits-right convention, group them by the function computed, and compare maximum halting time with input length. The claim holds if those maxima are only linear, quadratic, or exponential and every exponential machine has a partner computing the same function in a bounded number of steps." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Asymptotic growth has to be proved for each machine, beyond plots for short inputs.", "Wolfram's halting convention, the head leaving to the right, must be matched or the census answers a different question." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-23--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-23--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-23 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
