sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-24--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-24--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-24: partially-resolvable, resolvability 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.42"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Both rules are fully specified, so universality is a sharp mathematical property, and pieces of evidence such as one-step emulation can be recomputed. No proof that either rule is universal or that either is not is available as a finished, checkable argument. Those partial experiments are exactly the ones the book says do not settle the prediction." ;
    rdfs:comment "Proposed test with existing data: Universality means a computable encoding under which rule 30, and likewise rule 45, emulates every Turing machine. A published encoding would confirm each rule; a proof that some Turing computation is impossible in that rule would refute it. Equal-speed gliders on periodic backgrounds can be searched separately and do not decide the question." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The natural glider proof used for rule 110 does not apply if every localized structure has the same velocity, but that does not decide universality.", "A finite search cannot exhaust encodings, and non-universality of these rules is not known to be finitely checkable." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-24--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-24--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-24--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-24 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-24--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-24--grok--operationalizability> .
