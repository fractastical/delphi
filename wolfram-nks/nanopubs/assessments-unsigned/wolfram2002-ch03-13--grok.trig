sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-13: resolvable-now, resolvability 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.879"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.85"^^xsd:double ;
    dct:description "Removing one symbol at a time and appending a block determined by that symbol reproduces a color-only substitution, just more slowly, so the nested or repetitive conclusion follows from the substitution argument. The two-element clause is existential and is settled by resimulating a published example. Both halves have a finite, checkable form." ;
    rdfs:comment "Proposed test with existing data: Show that deleting one element per step walks through the string and rewrites each symbol by a block that depends only on that symbol, which is a neighbor-independent substitution and therefore nested or repetitive. Separately, exhibit one two-element-deletion tag system with incompressible evolution. The first half is refuted by a one-element tag system outside that reduction; the second by failure of the exhibited examples." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-13 by Grok 4.7: 0.93" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.93"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-13--grok--operationalizability> .
