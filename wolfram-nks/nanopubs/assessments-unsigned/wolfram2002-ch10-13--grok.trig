sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-13--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-13: resolvable-now, resolvability 0.81" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.806"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.77"^^xsd:double ;
    dct:description "The model classes and the data source are fully specified, and both fitting and resampling are standard. Agreement on the fitted statistics together with a loss of detailed structure is a direct confirming pattern; reproduction of those details is a direct refutation. The check is a computation on generated data, not a new experiment." ;
    rdfs:comment "Proposed test with existing data: Fit block-frequency, Markov, and probabilistic cellular-automaton models to data from deterministic cellular automata, matching the statistics used in the fit, then compare typical model samples with the original on features not in the fit. Samples that match the fitted statistics but are more random and miss the detailed features confirm the claim; samples that reproduce those features refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A probabilistic model with enough hidden state can be made to copy the data, so the model class has to stay the ones named.", "'More random' needs a pre-registered feature score beyond the fitted statistics." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-13 by Grok 4.7: 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.86"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-13--grok--operationalizability> .
