sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-12--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-12: partially-resolvable, resolvability 0.57" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.572"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.52"^^xsd:double ;
    dct:description "Particular three-replacement systems in the published figures can be rerun and scored, so the existence of complex search-and-replace behavior is checkable. The numerical rate and the universal claim about two replacements depend on a sampling scheme and a length bound that the claim does not state. Reconstructing a plausible ensemble tests a proxy for those clauses." ;
    rdfs:comment "Proposed test with existing data: Resimulate sequential substitution systems with three short replacements, starting from BAB, and test for incompressible growth; one such rule confirms that text-editor operations can be complex. The rate of about one in 10,000, and the claim that two replacements never get much more complicated, require the original distribution over rule lengths, which the sentence does not fully fix." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Randomly selected rules does not specify string length or the measure over rules.", "Two replacements never is an infinite family once replacement strings may be arbitrarily long.", "Seemingly random behavior is test-relative." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-12--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-12 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-12--grok--operationalizability> .
