sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-15--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-15: resolvable-now, resolvability 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.746"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Every integer in the claim is a count over an explicitly defined finite set of two-register programs. An optimized interpreter classifies the short lengths quickly and the length-eight set, about 1.1 times 10 to the 10 programs, within the reach of a small team in weeks because almost all programs are rejected by a short cycle check. The soft phrase 'substantially more complicated' at length seven is the main source of classifier risk; the length-eight count is then a direct comparison with 126." ;
    rdfs:comment "Proposed test with existing data: Enumerate two-register increment and decrement-jump programs by length, up to eight instructions, and classify each as repetitive, nested, or complex under a fixed detector. The claim is confirmed if the short lengths match the stated census (all programs through four instructions repetitive, two nested programs at length five, none substantially more complex through seven, and 126 complex programs among 11,019,960,576 of length eight) and refuted if those integers change." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The count of 126 moves if the boundary between nested and complex programs moves.", "Length-eight exhaustive search is large, though most programs die or cycle in a few dozen steps." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-15--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-15 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-15--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-15--grok--operationalizability> .
