sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-20: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.503"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "It is a short computation to show that small parameter changes in a branching rule swing the outline from smooth to prickly. Matching those outlines to real leaves can be attempted with public images and trait data, but resemblance is a weak test against other developmental models. Existing data do not establish that leaves and whole plants are produced by the same process." ;
    rdfs:comment "Proposed test with existing data: Generate leaf outlines from the same branching-parameter family used for whole-plant form, and compare them with measured leaf contours across smooth, toothed, and lobed species. Recovery of the outline range by small parameter changes would support the geometric half; outlines that stay outside that family, or developmental maps that build the margin by a different process, would count against the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Outline similarity is produced by several margin-growth models and does not identify the branching process.", "Leaf shape is usually fixed inside the bud by marginal patterning, which is not the same measurement as a stem-substitution rule." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-20--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-20--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-20 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok--operationalizability> .
