sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-21--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-21: resolvable-now, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.71"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "The claim is a finite census, not an assertion that rule 54 is simple for every seed. Regenerating a hundred million short evolutions is ordinary computation, and the book already supplies formulas for the patterns it highlights. The judgment more complicated must be frozen into a classifier, but once that is done the census can confirm or refute the stated bound." ;
    rdfs:comment "Proposed test with existing data: Enumerate rule 54's initial conditions in the book's order through the hundred millionth, run each to a pre-set horizon, and classify the evolution as periodic, nested with an explicit formula, or neither. Finding one evolution that is neither refutes the report; agreement through the whole range confirms it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A finite time cutoff can mistake a long transient for nesting, or miss structure that appears later.", "Fundamentally more complicated has to be replaced by a mechanical classifier before two reruns must agree." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-21 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-21--grok--operationalizability> .
