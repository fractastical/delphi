sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-23> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-23--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-23--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-23: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.655"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Gradient ranges, Hox expression, and proximal-before-distal differentiation are standard measurements in public model-organism databases. Those data can confirm the hierarchical pattern for insects and vertebrates and can reveal exceptions. They do not cover animal embryos in general, so the claim of an almost inevitable hierarchy for animals is only partly resolved." ;
    rdfs:comment "Proposed test with existing data: Measure the spatial range of morphogen gradients and the order in which region-specific genes, including Hox genes, become distinct, and test whether subdivisions appear only after a region reaches a few tenths of a millimeter, with proximal regions before distal ones. That order across animals would support the claim; simultaneous specification, or a length scale that changes freely with embryo size, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The length scale and the genetic cascade are well measured in model species and poorly measured in most phyla.", "Necessarily is a theoretical inference; some lineages specify fate in ways that do not follow a single fixed length." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-23--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-23--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-23--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-23 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-23--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-23> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-23--grok--operationalizability> .
