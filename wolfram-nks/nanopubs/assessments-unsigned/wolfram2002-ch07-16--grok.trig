sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-16--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-16--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-16: partially-resolvable, resolvability 0.34" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.342"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.52"^^xsd:double ;
    dct:description "The computational premise, that exact satisfaction of hard discrete constraints is not reached by casual search, can be checked on public benchmark instances. The natural-history quantifier has no dataset that enumerates phenomena and their best explanations, and predictive comparisons exist only for scattered case studies. The claim can be probed for particular systems and not as a statement about almost all complex behavior." ;
    rdfs:comment "Proposed test with existing data: For a pre-registered list of complex natural patterns, compare held-out predictive error of an explicit growth or evolution model with that of a constraint-satisfaction model, and separately measure how close random or locally improved configurations come to meeting the constraint. A large predictive gap in favor of explicit dynamics, together with search that stalls far from solutions, would support the claim on that list; the reverse would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Best explained is not fixed by predictive error alone, so rival explanations can be redrawn after the fact.", "There is no census of complex natural behavior on which almost none could be counted." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-16--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-16--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-16 by Grok 4.7: 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.35"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-16--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-16--grok--operationalizability> .
