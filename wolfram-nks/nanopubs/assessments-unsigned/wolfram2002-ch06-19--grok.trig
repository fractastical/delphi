sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-19--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-19--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-19: resolvable-now, resolvability 0.83" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.834"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Exact self-emulation means the spacetime diagram is unchanged by a fixed rescaling, and the configurations with that invariance are the uniform and the hierarchically nested ones. That is a short structural proof once the blocking is formalized, and rule 90 supplies a fully checkable instance. The argument covers the conditional scope the sentence actually states." ;
    rdfs:comment "Proposed test with existing data: Assume a blocking under which blocks obey the same rule as cells, and require the spacetime diagram to equal its own rescaling. The configurations invariant under that rescaling are the uniform and the nested ones; a self-emulating rule with a spacetime diagram outside those two forms would refute the dichotomy." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Nested has to mean invariance under the same blocking the rule emulates.", "The dichotomy covers exact self-emulation, not a merely similar picture." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-19--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-19--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-19--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-19 by Grok 4.7: 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.82"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-19--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-19--grok--operationalizability> .
