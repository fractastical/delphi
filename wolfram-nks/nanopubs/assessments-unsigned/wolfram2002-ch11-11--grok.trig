  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-11--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: MathWorld FRACTRAN" ;
    dct:description "public account of a remainder-and-arithmetic system already shown to be universal" ;
    prov:wasDerivedFrom <https://mathworld.wolfram.com/FRACTRAN.html> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-11--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: A New Kind of Science online" ;
