sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-11--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-11: resolvable-now, resolvability 0.89" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.893"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.85"^^xsd:double ;
    dct:description "The system is a concrete integer map with a stated correspondence to register-machine steps, the same idea as FRACTRAN. Traces can be compared for as many steps as one wants, and the reduction to a universal register machine is finite. That is a constructive proof, checkable by a short program." ;
    rdfs:comment "Proposed test with existing data: Encode a register-machine state as an integer of the published form and apply the remainder-selected arithmetic map. Confirm if successive integers track the program counter and both registers for a universal register machine; refute if the map diverges from that trace. Universality then follows from the known universality of register machines." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The encoding uses a particular modulus and prime powers, so a checker has to test that program, not an arbitrary Collatz-like map." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-11 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-11--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-11--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch11-11 by Grok 4.7: 0.9" ;
