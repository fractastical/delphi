sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-12--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch02-12: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.473"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Open museum collections and digitized pattern books are large enough for a systematic image search, and a single convincing match would refute the claim that such patterns were never used. They are a biased fraction of historical ornament, and the pattern classes need an explicit encoder. The universal historical negative is therefore only partly testable." ;
    rdfs:comment "Proposed test with existing data: Encode repetitive, nested, and rule-30-like classes as image statistics and search digitized historical ornament for each class. A clear rule-30-like ornamental pattern refutes the universal absence. Finding none in the digitized corpus supports the claim only inside that corpus." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Survival and digitization favor some cultures and media, so absence in the corpus is not absence in history.", "Stylized script and geometric craft can be misread as cellular-automaton patterns, and the reverse." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch02-12 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-12--grok--operationalizability> .
