sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-05--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-05: resolvable-now, resolvability 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.823"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "The population size, 2187, is small, and each evolution is a nearest-neighbor totalistic rule that standard software already runs. The 85 percent figure is approximate and can be reproduced or missed by a uniform classifier. A few rules in the source itself resolve only after thousands of steps, which is still inside a weeks-scale rerun." ;
    rdfs:comment "Proposed test with existing data: Simulate all 2187 three-color nearest-neighbor totalistic rules from a single gray cell for a horizon of many thousands of steps, and label each as ultimately periodic or nested, apparently random, or structure-forming. The claim is confirmed if about 85 percent fall in the regular class, and refuted if the regular share is far from 85 percent once long transients are included." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Ultimately regular can be hidden by transients of thousands of steps, so the horizon has to be long and the holdouts inspected.", "A minority of rules may still be ambiguous at any practical cutoff." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-05 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-05--grok--operationalizability> .
