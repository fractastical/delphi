sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-21--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-21--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-21: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.583"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Phyllotactic angles and molecular perturbations are measurable, and public studies can test portions of the inhibitory mechanism. Existing data are scattered and do not cover the claimed universality. Similar predictions from rival models reduce causal discrimination." ;
    rdfs:comment "Proposed test with existing data: Measure successive organ angles and inhibitory-field markers in shoot apical meristems, perturb the relevant transport or signaling process, and compare trajectories with the specified depletion model and optimization alternatives. Recovery of approximately 137.5 degrees from measured dynamics and predicted perturbation responses would support the mechanism." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "The chemical concentration in the claim is not uniquely specified.", "Multiple inhibitory and mechanical models predict golden-angle phyllotaxis.", "Near-universal and inevitable overstate known taxonomic and dynamical variation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-21--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-21--gpt--dataset-2> .
