    delphi:hasScore "0.86"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of wolfram2002-ch09-24 by Grok 4.7: 0.84" ;
