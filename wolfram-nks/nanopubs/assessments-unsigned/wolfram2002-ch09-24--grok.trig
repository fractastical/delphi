    rdfs:label "Candidate dataset: MathWorld: Scalar Curvature" ;
    dct:description "public reference for the Ricci scalar in the standard geometric expansion" ;
    prov:wasDerivedFrom <https://mathworld.wolfram.com/ScalarCurvature.html> .
