sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-24: resolvable-now, resolvability 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.855"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "Wolfram counts nodes reached at distance r, a shell growing as r^(d-1), and states that the first correction is the Ricci scalar times r^(d+1). That is the standard area expansion of geodesic spheres, which is a published theorem, not a fit to a picture. Example networks with positive and negative curvature can be counted as a numerical check of the same expansion." ;
    rdfs:comment "Proposed test with existing data: Expand the number of nodes at graph distance r, which Wolfram takes to grow as r^(d-1) in flat space, and compare the first correction with the Riemannian expansion of geodesic-sphere area in the scalar curvature. A leading correction proportional to the Ricci scalar times r^(d+1), and to no other curvature invariant, confirms the claim; a different exponent or a leading tensor invariant refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The expansion assumes a smooth Riemannian limit at large r; a raw network matches it only after that limit.", "Wolfram's count is the shell at distance r, whose correction scales as r^(d+1); the ball volume correction scales differently." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-24--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-24--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-24 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-24--grok--data-existence> a delphi:LLMClaimAssessment ;
