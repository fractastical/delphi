sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-08--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch05-08: partially-resolvable, resolvability 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.617"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "The computational half is direct: neighbor-dependent grid substitutions can be run, and non-nested outputs confirm that allowing interactions produces patterns outside pure nesting. The claim that traditional fractal geometry misses complexity because it excludes interactions is a characterization of a field, and a simulation does not decide how that field is defined. Existing computation therefore settles the constructive half only." ;
    rdfs:comment "Proposed test with existing data: Simulate two-dimensional substitution rules in which the replacement depends on neighboring cells, and test whether the result is a purely nested self-similar pattern. A persistent non-nested pattern confirms the computational half; the historical claim that traditional fractal geometry excludes interactions is a separate judgment about the literature." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "What 'traditional fractal geometry' considers is a historical classification and can be disputed by pointing at exceptions in the literature.", "A neighbor-dependent rule can still be nested, so one nested example does not refute 'readily yields' non-nested patterns." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-08--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch05-08 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-08--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-08--grok--data-existence> a delphi:LLMClaimAssessment ;
