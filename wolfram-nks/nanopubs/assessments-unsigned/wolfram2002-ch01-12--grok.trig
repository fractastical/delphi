sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch01-12: partially-resolvable, resolvability 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.517"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Published universality shows that some sophisticated computations have very small rule tables, so the existential reading is checkable now. The claim that extremely simple rules are often all that engineering needs, and that they are implementable directly at atomic scale, ranges over technology that has not been catalogued in that form. Existing proofs therefore settle a weakened reading and leave the practical frequency open." ;
    rdfs:comment "Proposed test with existing data: Take a list of sophisticated computational tasks and ask whether each has an implementation whose rule text is short, with task complexity counted separately from the initial condition. The weak reading is confirmed by one universal one-sentence rule. The engineering reading, including atomic-scale implementation, needs a demonstrated device whose physical rule, not only its abstract encoding, is extremely simple." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A universal rule shifts the task's complexity into the initial condition.", "Atomic-scale implementation is an engineering prediction without a systematic public inventory of such devices." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch01-12 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok--operationalizability> .
