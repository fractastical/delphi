sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-03--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch02-03: resolvable-now, resolvability 0.93" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.931"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    dct:description "The claim is existential: simple rules and simple initial conditions can produce highly complex behavior. Rule 30 from one black cell is a fully specified witness, and both simulation and a published sequence make the check immediate. Existence does not require a survey of every simple system." ;
    rdfs:comment "Proposed test with existing data: Exhibit one system with a short rule and a simple seed whose evolution fails periodicity and nesting tests over a long horizon. One such witness confirms the possibility claim; it is refuted only if every simple rule and simple seed yields a simple pattern under the same tests." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A single witness uses one operational test of complexity; a different test could judge that witness simple." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch02-03 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
