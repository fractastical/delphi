sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-22: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.586"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "For Life and rule 110, persistent objects are already catalogued and can be rechecked, so the existential half holds for the standard exemplars. The sentence says any class 4 system must have such an object, and systems are placed in that class largely because persistent interacting objects are visible. A search confirms exemplars; it does not separate the sentence from the definition of the class." ;
    rdfs:comment "Proposed test with existing data: For a rule labeled class 4 by its interacting objects, search finite seeds for a spatially localized periodic, possibly moving, object. Finding one supports the claim for that rule; a proof that every finite object dies would refute it for that rule." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Persistent localized structures are close to the visual definition of class 4.", "A finite search can miss a very large immortal object and cannot prove that none exists.", "Any class 4 system is not a closed list." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-22--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-22 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok--operationalizability> .
