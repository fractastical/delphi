sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-03--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-03: resolvable-now, resolvability 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.853"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "The integers 10 and 24 are claims about a finite, fully enumerable set. Re-running every elementary rule and applying a fixed randomness test and a fixed nesting test either reproduces those counts or replaces them. Subjectivity in the tests lowers discriminating power and does not make the census impractical." ;
    rdfs:comment "Proposed test with existing data: Classify all 256 single-seed elementary evolutions with explicit tests for apparent randomness and for nesting, then cluster the positive cases up to left-right and black-white symmetry. The claim is confirmed if the clusters contain 10 random-looking rules in three forms and 24 nested rules in three forms, and refuted if the counts or the number of forms differ." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Apparent randomness is test-relative, so the count of 10 can shift if the statistical battery changes.", "Fundamentally different is a symmetry classification and needs an explicit equivalence relation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-03 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-03--grok--operationalizability> .
