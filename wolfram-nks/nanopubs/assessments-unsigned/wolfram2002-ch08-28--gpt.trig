sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-28> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-28--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-28--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-28: partially-resolvable, resolvability 0.61" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.608"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.81"^^xsd:double ;
    dct:description "Large image resources permit robust description of recurring pattern classes and model fitting. Public molecular and perturbation evidence is narrow compared with animal diversity. Mechanistic discrimination requires developmental predictions, so only a subset of the claim is presently resolvable." ;
    rdfs:comment "Proposed test with existing data: Quantify wavelength, topology, and developmental dynamics of coat patterns, fit a local-activation/long-range-inhibition model, and compare perturbation predictions with alternative mechanisms. The claim is supported if one parameterized rule reproduces recurring pattern classes and correctly predicts genetic or chemical perturbations." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Final images alone cannot identify activation-inhibition dynamics.", "Different reaction-diffusion, cellular, and mechanical models share morphology.", "Developmental perturbation data cover few species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--gpt--dataset-2> .
