sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-05--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-05--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-05: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.509"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "Fracture roughness and displacement fields are standard observables, and some public datasets exist. The broad material-independence and causal exclusion of irregularities are much harder to test than roughness itself. Current data support restricted comparisons but not the full scope." ;
    rdfs:comment "Proposed test with existing data: Analyze crack trajectories and displacement fields in specimens with independently mapped heterogeneity, comparing deterministic fracture models with heterogeneity-driven models across material classes and scales. A material-independent residual roughness law predicted by the interaction model would support the claim; strong dependence on mapped disorder would oppose it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Microscopic material disorder is difficult to measure completely before fracture.", "Similar roughness exponents can arise from different mechanisms.", "Coverage from crystals to geological faults is inadequate." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-05--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-05--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-05 by GPT-5.6 Sol: 0.58" ;
