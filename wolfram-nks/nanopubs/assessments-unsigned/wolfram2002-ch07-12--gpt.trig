sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-12--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-12--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch07-12: partially-resolvable, resolvability 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.763"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.83"^^xsd:double ;
    dct:description "The computational examples can be reproduced and extended with standard simulation. Noise-source interventions have useful discriminating power for specified model classes. The broad extension to fluids and the assertion that averaging is the main cause remain only partially covered." ;
    rdfs:comment "Proposed test with existing data: Simulate discrete growth and transport models with matched noise amplitudes supplied externally, pseudorandomly, or by deterministic chaotic rules, and measure anisotropy and interface roughness after coarse-graining. Convergence to the same smooth macroscopic observables would support mechanism-independence, while systematic source-dependent differences would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Smoothness, large scale, and mainly are model-dependent.", "A finite model survey cannot establish the assertion for all discrete systems." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-12--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-12--gpt--operationalizability> a delphi:LLMClaimAssessment ;
