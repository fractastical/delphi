  <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-10--claim-test--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Data from: Iterative ontogenetic development of ammonoid conch shapes from the Devonian through to the Jurassic (Walton & Korn)" ;
    dct:description "ammonoid per-revolution expansion ratio per species" ;
