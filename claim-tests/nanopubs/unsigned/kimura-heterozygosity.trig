sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/kimura-heterozygosity> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-kimura-heterozygosity> .
  <https://w3id.org/delphi/resource/evidence/claim-test-kimura-heterozygosity> a delphi:EvidenceItem ;
    rdfs:label "Refuted: nucleotide diversity rises with census population size about ten times more slowly than the law predicts (log-log slope 0.107, 95% CI 0.078 to 0.137, not about 1)" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If neutral equilibrium heterozygosity H = theta/(1+theta) with theta = 4*Ne*mu holds and effective size scales with census size across species, then genome-wide nucleotide diversity (pi, the per-site heterozygosity) across metazoan species rises with census population size N: for pi << 1, H is approximately 4*Ne*mu, so log10(pi) should increase with log10(N) with a slope near 1 when mu and Ne/N are comparable across species, and the rank correlation between pi and N should be strongly positive." ;
    delphi:statisticalTest "Ordinary least squares of log10 nucleotide diversity on log10 census size across 160 non-bird metazoan species with a t-based 95% confidence interval on the slope; Spearman rank correlation reported alongside (rho 0.49, p 3.9e-11)" ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:measured, sub:n, sub:uncertainty, sub:preregRule, sub:evNspecies ;
    rdfs:comment "Census size stands in for effective size and per-site mutation rate is not included, so the refutation is of the law as operationalized (diversity should track census size), which is exactly Lewontin's paradox: diversity does rise with N (rho about 0.5, p < 1e-10) but roughly ten times too slowly on a log scale, across 12 orders of magnitude of N." ;
    rdfs:comment "Census sizes are model-based estimates (species range times a body-size-predicted density) with large uncertainty; measurement error in N attenuates the slope, but not by the factor of ten needed to rescue the law (Buffalo 2021 reaches the same conclusion with error-in-variables models)." ;
    rdfs:comment "Diversity estimates mix synonymous, non-coding and genome-wide measures from three collations, and are averaged where several entries exist for a species." ;
    rdfs:comment "Class Aves (13 species) was excluded before fitting at the holdout thread's request and can be scored later with 'analysis.py --exam'. The first run of the script, before the gate was added, printed the birds' mean residual once; it was not used to change anything." ;
    rdfs:comment "This is a cross-species pattern; it does not test the within-model derivation H = theta/(1+theta), which is a theorem." ;
    rdfs:comment "Post-hoc discriminating-power check (perturbation.py, added 2026-10-31 after the result; simulation, not observation): with the observed census sizes and residual scatter, the pre-registered rule returns 'supports' in 100% of 2000 simulated datasets when the true slope is 1.0 or 0.75 and in 97.6% at 0.5, 'mixed' in 97.6% at 0.25, and 'refutes' in 100% at slope 0; the observed slope of 0.107 returns 'refutes'. The refutation is therefore not a failure of test sensitivity." ;
    prov:used <https://w3id.org/delphi/resource/dataset/buffalo2021-paradox-variation-combined-data> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/00ba7c56fd6ffa0ae1e345c9a6a20e5298a9f814/claim-tests/math-bio-theorems/kimura-heterozygosity/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "Species with bigger populations should carry proportionally more genetic variation; across 160 animal species, variation does rise with population size, but about ten times too slowly." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "refuted" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: refutes" .
  sub:measured a schema:PropertyValue ; schema:propertyID "measured_value" ; schema:value "0.10731485075894663"^^xsd:double ; schema:unitText "OLS slope of log10(pi) on log10(census N); the law with Ne proportional to N predicts about 1" ; schema:description "Observation: the primary pre-registered quantity, computed by analysis.py from the retrieved files; further computed quantities are in result.json measured.extra." .
  sub:n a schema:PropertyValue ; schema:propertyID "sample" ; schema:value "160 non-bird metazoan species (diversity sources: {'Leffler et al.': 90, 'Romiguier et al.': 58, 'Corbett-Detig et al.': 12})" ; schema:description "Observation: what was analysed after the pre-registered filters." .
  sub:uncertainty a schema:PropertyValue ; schema:propertyID "uncertainty" ; schema:value "95% CI [0.078, 0.137]; SE 0.0150" ; schema:description "Observation: uncertainty or secondary statistics as reported in result.json." .
  sub:preregRule a schema:PropertyValue ; schema:propertyID "pre_registered_rule" ; schema:value "PASS: Pre-registered. Data: Buffalo (2021) combined_data.tsv from github.com/vsbuffalo/paradox_variation (commit b8f91d5, 2021-09-27), metazoan species (kingdom == Animalia) with a non-missing diversity value (pairwise nucleotide diversity, column 'diversity') and a non-missing census-size estimate (column 'log10_popsize', the posterior mean of log10 census size from the author's range x density model; if the file carries another census-size point estimate instead, the column actually used is recorded in 'method'). One row per species. SUPPORTS if Spearman rho(log10 pi, log10 N) > 0.5 with p < 0.001 AND the ordinary-least-squares slope of log10 pi on log10 N has a point estimate >= 0.3 with a 95% confidence interval that includes some value >= 0.5 (diversity rises at least about a third as fast as census size on a log scale, i.e. within a factor of about 3 of the law's slope of 1). AMENDMENT (2026-10-31, before any data were downloaded, at the request of the holdout thread): species of class Aves are excluded from the primary analysis and from all criteria above; bird rows are held out and only reported separately, unfitted, as a holdout check. The taxonomic class is taken from the file's own taxonomy columns. FAIL: Pre-registered. REFUTES if the 95% confidence interval of the slope lies entirely below 0.25 (diversity rises less than a quarter as fast as census size on a log scale, so the law with N as the proxy for Ne is quantitatively wrong by orders of magnitude across the range of N: the Lewontin's-paradox pattern) OR rho <= 0. MIXED otherwise. INCONCLUSIVE (underpowered) if fewer than 50 species qualify; INCONCLUSIVE (data-unavailable) if the file cannot be downloaded." ; schema:description "Assumption and decision rule fixed before the data were opened (see the pre-registration commit in the provenance graph); not an observation." .
  sub:evNspecies a schema:PropertyValue ; schema:propertyID "n_species" ; schema:value 13 ; schema:description "Count of species as stated in this record's text, taken from result.json." .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "Does not test the within-model theorem H = theta/(1+theta), which is proved; it refutes the cross-species operationalization in which census size stands in for effective size and the per-site mutation rate is not included (Lewontin's paradox). Birds (13 species) were held out and not scored." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 171863 ; schema:description "Total byte size of the retrieved files." .
  <https://w3id.org/delphi/resource/dataset/buffalo2021-paradox-variation-combined-data> a dcat:Dataset ;
    rdfs:label "Buffalo (2021) 'Why do species get a thin slice of pi?' combined species table: pairwise nucleotide diversity (collated from Leffler et al. 2012, Romiguier et al. 2014, Corbett-Detig et al. 2015) and census population size estimates (range x density model) for 300 metazoan species" ;
    schema:additionalProperty sub:ds1Nfiles, sub:ds1Nbytes ;
    dct:identifier "10.7554/eLife.67509" ;
    owl:sameAs <https://doi.org/10.7554/eLife.67509> ;
    dcat:landingPage <https://github.com/vsbuffalo/paradox_variation> ;
    dcat:version "git commit b8f91d5c34675733db8cae8dcab625dcbb55c30a (2021-09-27)" ;
    dct:rights "not stated in the repository; the article is CC BY 4.0" ;
    dct:license "not stated in the repository; the article is CC BY 4.0" ;
    rdfs:comment "Role in this test: per-species diversity (column 'diversity') and log10 census size (column 'log10_popsize', posterior mean)" ;
    dcat:distribution sub:ds1f1 .
  sub:ds1f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://raw.githubusercontent.com/vsbuffalo/paradox_variation/b8f91d5c34675733db8cae8dcab625dcbb55c30a/data/combined_data.tsv> ;
    dcat:byteSize "171863"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T05:57:45Z"^^xsd:dateTime ;
    spdx:checksum sub:ds1f1sum .
  sub:ds1f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "df559451dad94b53ba8675e09811708107a57eeb6ffe8f72b944bcbbf3a1f2eb"^^xsd:hexBinary .
}

