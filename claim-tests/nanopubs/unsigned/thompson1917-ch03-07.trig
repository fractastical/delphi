    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-07> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-thompson1917-ch03-07> .
  <https://w3id.org/delphi/resource/evidence/claim-test-thompson1917-ch03-07> a delphi:EvidenceItem ;
    rdfs:label "Supported: the log-log exponent of mean weight on mean height across ages 2 to 19 is 2.74 for males (95% CI 2.59 to 2.89) and 2.86 for females, inside the pre-registered 2.5 to 3.5 band; a pure cubic model explains 98 to 99% of the variance in mean weight" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If weight varies as the cube of a linear dimension during growth, then across childhood and adolescence the population mean body weight scales with the population mean stature with a log-log exponent near 3, so the weight-for-age curve is approximately the cube of the stature-for-age curve." ;
    delphi:statisticalTest "Ordinary least squares of log mean weight on log mean height over 18 one-year age bins per sex (NHANES 2013 to 2018, survey-weighted means) with a t-based 95% confidence interval; R-squared of the cubic model on the original scale" ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:measured, sub:n, sub:uncertainty, sub:preregRule ;
    rdfs:comment "The free exponent is below 3 in both sexes (2.74 and 2.86) and the male CI excludes 3, so weight grows a little slower than the cube of stature across childhood; Thompson's 'mainly (though not wholly)' is borne out literally: the cube reproduces the weight curve with R^2 of 0.98-0.99 but is not exact." ;
    rdfs:comment "Cross-sectional population means from 2013-2018 US children, who are heavier at given height than Thompson's early-20th-century tables; the exponent, not the constant k, is what the claim concerns." ;
    rdfs:comment "Binned means over 18 ages leave 16 degrees of freedom; the CI reflects bin-to-bin scatter, not individual variation." ;
    rdfs:comment "Post-hoc discriminating-power check (perturbation.py, added 2026-10-31 after the result; simulation, not observation): with the observed mean heights and bin scatter, the pre-registered rule passes in 100% (males) and 99.95% (females) of 2000 simulations under the cube law, in 0% under an exponent of 2 or 4, and in about 47 to 49% at the band edges 2.5 and 3.5; so the rule rejects surface-law and fourth-power alternatives and is indifferent only at its own pre-registered boundaries." ;
    rdfs:comment "Cross-check (cross_check.py, added 2026-10-31 after the result; verdict unchanged): the collaborator swarm's test of this claim (origin/main, run cursor/claim-tests-thompson-efb7, NHANES 2007-2018, ages 0 to 19.99 with recumbent length under 24 months) reports a pooled individual-level exponent of 2.408 (95% CI 2.399 to 2.416, n = 23540) and 'mixed'. On this test's own sample the individual-level exponent is 2.755 (CI 2.736 to 2.775, n = 9715; males 2.716, females 2.812), within 0.03 of the age-bin values, so the unit of analysis (bins versus individuals) is not the cause. The cause is the age range: the collaborator's own 2-20 year window gives 2.736 (CI 2.723 to 2.750, n = 19714), reproducing this test, while their 0-2 year window gives 2.098 and pulls the pooled exponent below the 2.5 edge of the band both tests pre-registered. The 'supports' verdict is therefore conditional on the scope fixed at pre-registration (ages 2 to 19, standing stature); including infancy in Thompson's 'during growth' makes it 'mixed'. Whether infancy is inside the claim is a reading of the claim, not a measurement." ;
    prov:used <https://w3id.org/delphi/resource/dataset/nhanes-2013-2018-body-measures-demographics> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/c364a3d8391d6a805eff6225a420e7443bec95ef/claim-tests/thompson-growth-form/thompson1917-ch03-07--delphi-claims/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "As children grow, their weight rises roughly with the cube of their height; a US survey of 2 to 19 year olds gives an exponent of 2.7 to 2.9." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "supported" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: supports" .
  sub:measured a schema:PropertyValue ; schema:propertyID "measured_value" ; schema:value "2.7420799020169984"^^xsd:double ; schema:unitText "log-log exponent of mean weight on mean height across ages 2-19, males (pre-registered band 2.5-3.5); females given in extra" ; schema:description "Observation: the primary pre-registered quantity, computed by analysis.py from the retrieved files; further computed quantities are in result.json measured.extra." .
  sub:n a schema:PropertyValue ; schema:propertyID "sample" ; schema:value "4905 males and 4810 females in 18 age bins each" ; schema:description "Observation: what was analysed after the pre-registered filters." .
  sub:uncertainty a schema:PropertyValue ; schema:propertyID "uncertainty" ; schema:value "males 95% CI [2.59, 2.89]; females b = 2.86, CI [2.66, 3.06]" ; schema:description "Observation: uncertainty or secondary statistics as reported in result.json." .
  sub:preregRule a schema:PropertyValue ; schema:propertyID "pre_registered_rule" ; schema:value "PASS: Pre-registered. Data: US NHANES examination data, cycles 2013-2014, 2015-2016 and 2017-2018 (Body Measures BMX_H/I/J and Demographics DEMO_H/I/J XPT files), examined participants aged 2 to 19 years with measured standing height (BMXHT, cm) and weight (BMXWT, kg). For each sex, compute MEC-exam-weighted (WTMEC2YR) mean height and mean weight in 1-year age bins (18 bins), regress log(mean weight) on log(mean height) by ordinary least squares, and also fit the constrained model weight = k * height^3 with k estimated by least squares on the log scale. SUPPORTS if, for both sexes, the free exponent b lies in [2.5, 3.5] AND the cubic model reproduces the age-bin mean weights with R^2 >= 0.90 on the original scale. FAIL: Pre-registered. REFUTES if, for either sex, b lies outside [2.5, 3.5] OR the cubic model's R^2 on the age-bin weight curve is < 0.90. MIXED is not possible under this rule except as follows: if the two sexes disagree (one passes, the other fails) the verdict is MIXED. INCONCLUSIVE (data-unavailable) if the files cannot be downloaded." ; schema:description "Assumption and decision rule fixed before the data were opened (see the pre-registration commit in the provenance graph); not an observation." .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "The exponent is below 3 in both sexes and the male interval excludes 3, so the cube is an approximation, as Thompson's 'mainly (though not wholly)' allows; cross-sectional population means, not individual growth; 16 degrees of freedom per sex." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 6 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 16503520 ; schema:description "Total byte size of the retrieved files." .
  <https://w3id.org/delphi/resource/dataset/nhanes-2013-2018-body-measures-demographics> a dcat:Dataset ;
    rdfs:label "US National Health and Nutrition Examination Survey (NHANES) 2013-2014, 2015-2016 and 2017-2018: Body Measures (BMX) and Demographics (DEMO) files" ;
    schema:additionalProperty sub:ds1Nfiles, sub:ds1Nbytes ;
    dct:identifier "https://wwwn.cdc.gov/nchs/nhanes/" ;
    dcat:landingPage <https://wwwn.cdc.gov/nchs/nhanes/> ;
    dcat:version "public release XPT files as served 2026-10-31" ;
    dct:rights "public domain (US federal government data)" ;
    dct:license "public domain (US federal government data)" ;
    rdfs:comment "Role in this test: measured standing height and weight with age, sex and MEC exam weights" ;
    dcat:distribution sub:ds1f1, sub:ds1f2, sub:ds1f3, sub:ds1f4, sub:ds1f5, sub:ds1f6 .
  sub:ds1f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://wwwn.cdc.gov/Nchs/Data/Nhanes/Public/2013/DataFiles/BMX_H.xpt> ;
    dcat:byteSize "2045520"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T06:14:09Z"^^xsd:dateTime ;
