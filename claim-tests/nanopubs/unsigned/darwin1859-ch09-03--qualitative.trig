sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch09-03> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-darwin1859-ch09-03--qualitative> .
  <https://w3id.org/delphi/resource/evidence/claim-test-darwin1859-ch09-03--qualitative> a delphi:EvidenceItem ;
    rdfs:label "Not tested: the qualitative reading of darwin1859-ch09-03 (geological time is immense) had no pre-registered pass or fail criterion, so no verdict is recorded" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If Darwin's denudation argument holds, the time elapsed since the latter part of the Secondary (Mesozoic) period, i.e. since the youngest Chalk, is roughly 300 million years or more on the modern radiometrically calibrated timescale." ;
    delphi:statisticalTest "None. The readings check (added after the numeric result, no number or threshold changed) notes that the modern timescale is consistent with this reading (the Mesozoic began about 252 Ma; the Earth is about 4.5 Gyr old), but the pre-registered test operationalized only the 300 million year figure" ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:reading ;
    rdfs:comment "Darwin's 300 million years is 4.6 times the radiometric age of the end of the Chalk; Darwin withdrew the calculation in the third edition after Phillips's criticism, so this refutes the claim as stated in the first edition, which is how the claim graph records it." ;
    rdfs:comment "The test uses the ICS ages through Macrostrat's API rather than the chart PDF; the two agree for these stages and the version is recorded." ;
    rdfs:comment "This is a one-number test with no sampling uncertainty; it does not evaluate Darwin's erosion rate, only the duration he inferred." ;
    rdfs:comment "Readings check: under the three numeric readings of Darwin's figure (lower bound since the end of the Chalk; duration of the Weald denudation; time since the start of the Late Cretaceous) the measured age is 3.1 to 4.6 times smaller than 300 Myr, so the verdict is unchanged; only the purely qualitative reading ('geological time is immense') would be supported, and the claim graph's statement is the numeric one." ;
    prov:used <https://w3id.org/delphi/resource/dataset/ics-chronostratigraphic-ages-via-macrostrat-api> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/c364a3d8391d6a805eff6225a420e7443bec95ef/claim-tests/darwin-origin/darwin1859-ch09-03--delphi-claims/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "Darwin's underlying point was that geological time is immense, far longer than the physics of his day allowed; that reading was not put to a pre-registered test." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "inconclusive" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: refutes; this record covers the qualitative reading of the claim only" .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "Establishes nothing on its own. It records that the numeric refutation (darwin1859-ch09-03--numeric) does not touch the qualitative reading, and that this reading would need its own pre-registered criterion before any verdict is given." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:reading a schema:PropertyValue ; schema:propertyID "reading_of_claim" ; schema:value "qualitative" ; schema:description "Which reading of the source claim this record evaluates; the other reading has its own record linked to the same claim." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 33145 ; schema:description "Total byte size of the retrieved files." .
  <https://w3id.org/delphi/resource/dataset/ics-chronostratigraphic-ages-via-macrostrat-api> a dcat:Dataset ;
    rdfs:label "International Chronostratigraphic Chart boundary ages (ICS), as served by the Macrostrat API (defs/intervals, timescale 'international ages')" ;
    schema:additionalProperty sub:ds1Nfiles, sub:ds1Nbytes ;
    dct:identifier "https://stratigraphy.org/chart" ;
    dcat:landingPage <https://stratigraphy.org/chart> ;
    dcat:version "Macrostrat API v2 response of 2026-10-31 (ages match ICS chart v2023/09)" ;
    dct:rights "CC-BY 4.0" ;
    dct:license "CC-BY 4.0" ;
    rdfs:comment "Role in this test: top and base ages (Ma) of the Maastrichtian and Campanian stages" ;
    dcat:distribution sub:ds1f1 .
  sub:ds1f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://macrostrat.org/api/v2/defs/intervals?timescale=international%20ages> ;
    dcat:byteSize "33145"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T06:14:01Z"^^xsd:dateTime ;
    spdx:checksum sub:ds1f1sum .
  sub:ds1f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "4900709f37f77efcf5ed5abf14b910db91204a1328bbd1625c5dce4a742d6e73"^^xsd:hexBinary .
}

