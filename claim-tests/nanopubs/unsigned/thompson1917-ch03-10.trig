sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-10> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-thompson1917-ch03-10> .
  <https://w3id.org/delphi/resource/evidence/claim-test-thompson1917-ch03-10> a delphi:EvidenceItem ;
    rdfs:label "Partially supported: an asymptotic growth model is favoured in 7 of 11 North Sea species (0.636, pre-registered threshold two thirds) and 76% of late-age length increments are positive (threshold 75%)" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If fishes approach a maximal size only asymptotically, then mean length at age in well-sampled wild fish populations keeps increasing, by ever smaller but still positive increments, through the oldest well-sampled ages, and an asymptotic growth model fits the length-at-age means better than a model in which length reaches a fixed maximum at a finite age and then stays there." ;
    delphi:statisticalTest "AIC comparison of a von Bertalanffy fit against a quadratic-plateau (reached-maximum) fit to weighted mean length at age per species (ICES DATRAS NS-IBTS 2000 to 2024, 1111408 aged fish); sign of the last three increments per species" ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:measured, sub:n, sub:uncertainty, sub:preregRule, sub:supportedComponent, sub:unsupportedComponent ;
    rdfs:comment "The pre-registered supports condition was narrowly missed: 7/11 = 0.636 species favour the asymptotic model against the required 2/3, while the late-increment condition (0.758 >= 0.75) was met. The result is therefore 'mixed' by rule, although most of the evidence points toward protracted growth." ;
    rdfs:comment "In the two species where the reached-maximum model wins (whiting, lemon sole) mean length at age actually declines over the oldest ages, which neither model predicts for individual growth; the most likely cause is size-selective (fishing) mortality removing the faster growers (Lee's phenomenon) and ageing error, not cessation of growth. This biases the test against the claim." ;
    rdfs:comment "Cross-sectional survey means pool cohorts and years (2000-2024, Q1 and Q3) and so mix cohort effects with age effects; the oldest age classes are sparsely sampled (>= 50 fish required) and trawl gear under-samples the largest fish." ;
    rdfs:comment "The determinate alternative had to be given a specific functional form (quadratic rise to a plateau); a different plateau model could change individual dAIC values. Model selection used AIC on 7-18 age-class means, not individual-level likelihoods." ;
    rdfs:comment "Scope: North Sea marine teleosts only (11 species); Thompson's scope was cold-blooded animals in general. For saithe and cod the oldest well-sampled fish are at only 48-65% of the fitted Linf, i.e. the data do not reach the asymptotic region at all." ;
    rdfs:comment "DATRAS is a live database; the API extract is reproducible only to the extent that ICES does not revise the 2000-2024 records. The 50 file checksums of the extract used are in derived/datras_file_manifest.json and in this file." ;
    rdfs:comment "DATRAS 'Species' names are taken as delivered (AphiaID-based) and no taxonomic harmonisation was done." ;
    prov:used <https://w3id.org/delphi/resource/dataset/ices-datras-ns-ibts-ca-2000-2024-q1q3> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/f8f6ec26339e70acd5737c5a80d07cf866a6640e/claim-tests/thompson-growth-form/thompson1917-ch03-10/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "Fish keep growing throughout life, only ever approaching a maximum size; in 7 of 11 North Sea species the survey data agree, just short of the pre-set bar." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "partially supported" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: mixed" .
  sub:measured a schema:PropertyValue ; schema:propertyID "measured_value" ; schema:value "0.6363636363636364"^^xsd:double ; schema:unitText "fraction of qualifying species in which the asymptotic model is favoured by dAIC > 2 (pre-registered threshold 2/3); fraction of late-age increments positive = 0.758 (threshold 0.75)" ; schema:description "Observation: the primary pre-registered quantity, computed by analysis.py from the retrieved files; further computed quantities are in result.json measured.extra." .
  sub:n a schema:PropertyValue ; schema:propertyID "sample" ; schema:value "11 species, 33 late-age increments, 1111408 aged fish from 986385 CA rows" ; schema:description "Observation: what was analysed after the pre-registered filters." .
  sub:uncertainty a schema:PropertyValue ; schema:propertyID "uncertainty" ; schema:value "species-level counts: 7 of 11 favour the asymptotic model, 2 of 11 (Merlangius merlangus, Microstomus kitt) favour the reached-maximum model, 2 indeterminate (|dAIC| <= 2); 25 of 33 late increments > 0" ; schema:description "Observation: uncertainty or secondary statistics as reported in result.json." .
  sub:preregRule a schema:PropertyValue ; schema:propertyID "pre_registered_rule" ; schema:value "PASS: Pre-registered. Data: ICES DATRAS North Sea IBTS (NS-IBTS) age records (CA record type), quarters 1 and 3, survey years 2000-2024, all species; length class converted to cm; records with a plus-group flag or missing age excluded. A species qualifies if it has at least 7 consecutive age classes starting at age 1, each with at least 50 aged fish (sum of CANoAtLngt); the included age range ends at the oldest class with at least 50 fish. For each species, mean length at age is computed (weighted by CANoAtLngt) and two 3-parameter models are fitted by weighted least squares (weights = number of fish): (i) asymptotic von Bertalanffy L = Linf (1 - exp(-K (a - t0))) with K > 0, and (ii) determinate quadratic-plateau L = Lmax - c (tc - a)^2 for a < tc, L = Lmax for a >= tc, with tc constrained to at most (oldest included age - 1) so that the model asserts a maximum actually reached inside the data. dAIC = AIC_det - AIC_VB (positive favours the asymptotic model). Late-age increments are the three increments of mean length between the last four included age classes. SUPPORTS if the asymptotic model is favoured (dAIC > 2) in at least two thirds of qualifying species AND at least 75% of all late-age increments pooled across species are positive. Requires at least 5 qualifying species; otherwise inconclusive (underpowered). FAIL: Pre-registered. REFUTES if the determinate model is favoured (dAIC < -2) in at least half of the qualifying species, OR if at least half of the pooled late-age increments are zero or negative (growth has stopped at a reached maximum while fish are still well sampled). Anything between the supports and refutes conditions is 'mixed'. If the DATRAS download API is unreachable the verdict is inconclusive with reason data-unavailable." ; schema:description "Assumption and decision rule fixed before the data were opened (see the pre-registration commit in the provenance graph); not an observation." .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "Cross-sectional survey means mix cohorts and years; size-selective fishing mortality and ageing error can mimic growth cessation; the reached-maximum alternative had to be given one specific functional form; 11 North Sea teleosts, not cold-blooded animals in general; DATRAS is a live database." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:supportedComponent a schema:PropertyValue ; schema:propertyID "supported_component" ; schema:value "25 of 33 pooled late-age increments are positive (0.758, at or above the 0.75 threshold) and the median dAIC favouring the asymptotic model is 13.9." ; schema:description "The part of the pre-registered prediction that the data meet." .
  sub:unsupportedComponent a schema:PropertyValue ; schema:propertyID "unsupported_component" ; schema:value "Only 7 of 11 species (0.636) favour the asymptotic model against the pre-registered two thirds; in whiting and lemon sole mean length at age declines over the oldest ages, which neither model predicts." ; schema:description "The part of the pre-registered prediction that the data do not meet." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 50 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 13615778 ; schema:description "Total byte size of the retrieved files." .
  <https://w3id.org/delphi/resource/dataset/ices-datras-ns-ibts-ca-2000-2024-q1q3> a dcat:Dataset ;
    rdfs:label "ICES DATRAS, North Sea International Bottom Trawl Survey (NS-IBTS), age-based biological records (CA), 2000-2024, quarters 1 and 3" ;
