    dcat:version "DATRAS Download API extract of 2026-10-31 (database is updated continuously; see caveats)" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rights "CC BY 4.0 (ICES Data Policy, open access data)" ;
    rdfs:comment "Role in this test: individual-level aged fish (length class, age, number at length) for mean length at age per species" ;
