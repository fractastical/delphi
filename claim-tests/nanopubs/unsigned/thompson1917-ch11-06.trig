sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-06> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-thompson1917-ch11-06> .
  <https://w3id.org/delphi/resource/evidence/claim-test-thompson1917-ch11-06> a delphi:EvidenceItem ;
    rdfs:label "Refuted: at least one conch shape index changes by 50% or more over post-embryonic growth in 94% of 179 ammonoid series (177 species); only 1 series is gnomonic" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If every increment of a spirally grown shell is a gnomon to the whole structure before it (the enlarged whole stays similar to itself), then a molluscan shell is geometrically self-similar through growth: dimensionless shape indices of the conch measured at successive diameters along one specimen's ontogeny (conch width index CWI = ww/dm, umbilical width index UWI = uw/dm, whorl expansion rate WER) stay constant, apart from measurement noise, from the end of the embryonic shell to maturity." ;
    delphi:statisticalTest "Per-series monotonic trend (Spearman |rho| >= 0.7, p < 0.05) and percentage change over ontogeny in conch width index, umbilical width index and whorl expansion rate; classification allometric / intermediate / gnomonic by pre-registered thresholds" ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:measured, sub:n, sub:uncertainty, sub:preregRule, sub:evNspecies ;
    rdfs:comment "The refutation is carried almost entirely by the umbilical width index: UWI changes by >= 50% in 92% of series (median change 204%), whereas the whorl expansion rate, which encodes the spiral angle, stays within 25% in 80% of series (median change 17%). The spiral itself is therefore close to logarithmic (gnomonic in Thompson's sense), while the whorl section and the degree of involution change through growth, so the enlarged conch is not similar to its earlier self. Dropping UWI, only 34% of series (27% at dm >= 5 mm) are allometric and the pre-registered rule would give 'mixed'." ;
    rdfs:comment "Walton & Korn chose their 177 species to study pachyconic and globular ammonoids with phased ontogenies, so the sample is probably enriched in species with strong ontogenetic shape change relative to ammonoids at large." ;
    rdfs:comment "UWI is the noisiest index at small diameters (small umbilical widths); the 2 mm cut-off and the requirement of a monotonic trend (met by 94% of series) limit but do not remove this effect; at dm >= 5 mm the allometric fraction is still 84%." ;
    rdfs:comment "Scope: Palaeozoic-Jurassic ammonoid conchs only; Thompson's gnomon claim also covers gastropod and bivalve shells, opercula, foraminiferal chambers, horns and tusks, which were not tested. The 25% and 50% thresholds are pre-registered conventions, not derived from Thompson." ;
    rdfs:comment "Thompson himself notes elsewhere (ch. XI, changes of spiral angle with age) that some ammonoids change their spiral angle during growth; this test shows that even where the spiral angle is nearly constant, the conch shape generally is not." ;
    prov:used <https://w3id.org/delphi/resource/dataset/dryad-c17p8-walton-korn-2018-ammonoid-conch-ontogeny> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/aac1741f05a9c87d719e9666f2116809b803e8e0/claim-tests/thompson-growth-form/thompson1917-ch11-06/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "Thompson said a shell grows by adding pieces that keep its overall shape the same; ammonoid shells change shape as they grow." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "refuted" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: refutes" .
  sub:measured a schema:PropertyValue ; schema:propertyID "measured_value" ; schema:value "0.939"^^xsd:double ; schema:unitText "fraction of qualifying ammonoid series in which at least one conch shape index changes by >= 50% over post-embryonic growth (pre-registered refutes threshold 2/3); fraction gnomonic = 0.006 (supports threshold 2/3)" ; schema:description "Observation: the primary pre-registered quantity, computed by analysis.py from the retrieved files; further computed quantities are in result.json measured.extra." .
  sub:n a schema:PropertyValue ; schema:propertyID "sample" ; schema:value "179 series (177 species), Devonian-Jurassic" ; schema:description "Observation: what was analysed after the pre-registered filters." .
  sub:uncertainty a schema:PropertyValue ; schema:propertyID "uncertainty" ; schema:value "168 allometric, 10 intermediate, 1 gnomonic (Eurites permutus); 93.9% of series show a monotonic trend (|Spearman rho| >= 0.7, p < 0.05) in at least one index" ; schema:description "Observation: uncertainty or secondary statistics as reported in result.json." .
  sub:preregRule a schema:PropertyValue ; schema:propertyID "pre_registered_rule" ; schema:value "PASS: Pre-registered. Data: Walton & Korn (2018) ontogenetic conch-parameter series for 177 Devonian-Jurassic ammonoid species (Dryad 10.5061/dryad.c17p8), measured on median cross-sections at successive diameters dm. For each species keep the post-embryonic points (dm >= 2 mm) and require at least 4 points spanning at least a fourfold range of dm. For each retained index compute the log-range D = max ln(index) - min ln(index) over the series. A species is 'gnomonic' if D <= ln(1.25) (at most 25% change) for CWI, UWI and WER alike; 'allometric' if D >= ln(1.5) (at least 50% change) for at least one index; otherwise intermediate. SUPPORTS if at least two thirds of the qualifying species are gnomonic. As a secondary descriptor, the fraction of species whose indices show a monotonic trend with ln dm (|Spearman rho| >= 0.7, p < 0.05, for at least one index) is reported; it does not enter the verdict. FAIL: Pre-registered. REFUTES if at least two thirds of the qualifying species are allometric (at least one shape index changes by 50% or more over post-embryonic growth, so successive increments are not gnomons of the pre-existing conch). Otherwise 'mixed'. Fewer than 30 qualifying species: inconclusive (underpowered). File unobtainable: inconclusive, data-unavailable." ; schema:description "Assumption and decision rule fixed before the data were opened (see the pre-registration commit in the provenance graph); not an observation." .
  sub:evNspecies a schema:PropertyValue ; schema:propertyID "n_species" ; schema:value 177 ; schema:description "Count of species as stated in this record's text, taken from result.json." .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "The refutation is carried almost entirely by the umbilical width index; the whorl expansion rate, which encodes the spiral angle, stays within 25% in 80% of series, so the spiral itself is close to logarithmic; without UWI the rule would give 'mixed'; ammonoids only, from a sample chosen for phased ontogenies; gastropods, bivalves, horns and tusks untested." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 215481 ; schema:description "Total byte size of the retrieved files." .
  <https://w3id.org/delphi/resource/dataset/dryad-c17p8-walton-korn-2018-ammonoid-conch-ontogeny> a dcat:Dataset ;
    rdfs:label "Data from: Iterative ontogenetic development of ammonoid conch shapes from the Devonian through to the Jurassic (Walton & Korn 2018, Palaeontology 61, doi:10.1111/pala.12308)" ;
    schema:additionalProperty sub:ds1Nfiles, sub:ds1Nbytes ;
    dct:identifier "10.5061/dryad.c17p8" ;
    owl:sameAs <https://doi.org/10.5061/dryad.c17p8> ;
    dcat:landingPage <https://datadryad.org/dataset/doi:10.5061/dryad.c17p8> ;
    dcat:version "Dryad version id 7242 = dataset version 1 (published 2018-05-16), the only publicly listed version" ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:rights "CC0 1.0" ;
    rdfs:comment "Role in this test: ontogenetic series of conch diameter and the shape indices CWI (ww/dm), UWI (uw/dm) and WER along individual ammonoid cross-sections" ;
    dcat:distribution sub:ds1f1 .
  sub:ds1f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://datadryad.org/api/v2/versions/7242/download> ;
    dcat:byteSize "215481"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T04:42:46Z"^^xsd:dateTime ;
    rdfs:comment "zip assembly of the version containing Ontogenetic_Conch_Parameter_Data.xlsx (215182 bytes; sheets Species, dm, CWI, UWI, WER; 179 series for 177 species, values at successive half-whorls)" ;
    schema:additionalProperty sub:ds1f1Nspecies ;
    spdx:checksum sub:ds1f1sum .
  sub:ds1f1Nspecies a schema:PropertyValue ; schema:propertyID "n_species" ; schema:value 177 ; schema:description "Count of species as stated in this record's text, taken from result.json." .
  sub:ds1f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "944359c1887e4aa67867ead469a5e895dd4efe9a0d3d2cc1ae8d7a1518aae077"^^xsd:hexBinary .
}

