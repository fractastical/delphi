sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/fisher-infinitesimal> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-fisher-infinitesimal> .
  <https://w3id.org/delphi/resource/evidence/claim-test-fisher-infinitesimal> a delphi:EvidenceItem ;
    rdfs:label "Supported: residual variance of child height is constant across mid-parent terciles (ratio 1.08, Levene p 0.96), residuals are near-Gaussian (skew -0.12, excess kurtosis 0.46), and the sibling correlation 0.39 is at least the parent-offspring correlation 0.35" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If adult height is governed by many Mendelian loci of small additive effect, then (a) a child's height given the parents' heights is approximately Gaussian with a residual variance (segregation plus environment) that does not depend on the parental mean, and (b) full siblings are correlated at least as strongly as parent and offspring, because dominance and shared environment add to the sibling covariance but not to the parent-offspring covariance." ;
    delphi:statisticalTest "Levene test for equality of residual variance across mid-parent terciles of 934 children in 205 Galton families; sibling intraclass correlation versus implied parent-offspring correlation" ;
    delphi:pValue "0.956"^^xsd:double ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:measured, sub:n, sub:uncertainty, sub:preregRule ;
    rdfs:comment "In-sample classic data: Fisher (1918) built the model to explain exactly these biometric regularities, so the test shows the model's distributional predictions hold on Galton's families, not that they hold out of sample." ;
    rdfs:comment "The sibling correlation (0.39) exceeds the implied parent-offspring correlation (0.35) as predicted, but shared family environment, not only dominance, can produce that excess; the two are not separable here." ;
    rdfs:comment "Heteroscedasticity could be masked by the modest sample (about 311 children per tercile) and by Galton's rounding of heights; the variance ratio of 1.08 is nonetheless close to 1." ;
    rdfs:comment "Galton's 1.08 female adjustment and the assumption of uncorrelated parents (observed father-mother r = 0.10) are approximations." ;
    prov:used <https://w3id.org/delphi/resource/dataset/galton1886-families-histdata> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/c330f91dd8e6ad84365d92ac34dbee89d0a19cbe/claim-tests/math-bio-theorems/fisher-infinitesimal/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "If height comes from many genes of tiny effect, children's heights should scatter around their parents' average by the same amount whatever the parents' height, and siblings should resemble each other at least as much as parent and child; Galton's families fit this." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "supported" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: supports" .
  sub:measured a schema:PropertyValue ; schema:propertyID "measured_value" ; schema:value "1.07764604189515"^^xsd:double ; schema:unitText "ratio of largest to smallest residual variance across mid-parent terciles (model predicts 1)" ; schema:description "Observation: the primary pre-registered quantity, computed by analysis.py from the retrieved files; further computed quantities are in result.json measured.extra." .
  sub:n a schema:PropertyValue ; schema:propertyID "sample" ; schema:value "934 children in 205 families (172 families with 2+ children)" ; schema:description "Observation: what was analysed after the pre-registered filters." .
  sub:uncertainty a schema:PropertyValue ; schema:propertyID "uncertainty" ; schema:value "Levene p = 0.956" ; schema:description "Observation: uncertainty or secondary statistics as reported in result.json." .
  sub:preregRule a schema:PropertyValue ; schema:propertyID "pre_registered_rule" ; schema:value "PASS: Pre-registered. Data: Galton's 1886 family height records as distributed in the R HistData package (GaltonFamilies: 934 adult children in 205 families with father, mother and child heights in inches and child sex). Female child heights are multiplied by 1.08, as Galton did, to put both sexes on a common scale; mid-parent height is (father + 1.08*mother)/2. Residuals r are taken from the ordinary-least-squares regression of adjusted child height on mid-parent height. Criterion A (homoscedasticity): Levene's test (median-centred, Brown-Forsythe) of residual variance across the three mid-parent terciles gives p > 0.05 AND the ratio of the largest to the smallest tercile residual variance is < 1.5. Criterion B (normality): residual sample skewness |g1| < 0.5 and excess kurtosis |g2| < 1.0. Criterion C (sibling vs parent-offspring): the full-sibling intraclass correlation of adjusted height (one-way random-effects ANOVA estimator over families with >= 2 children) is >= r_po - 0.05, where r_po is the single-parent-offspring correlation implied by the child-on-mid-parent correlation r_mp as r_po = r_mp / sqrt(2) (which assumes uncorrelated parents). SUPPORTS if A, B and C all hold. FAIL: Pre-registered. REFUTES if A fails strongly (variance ratio > 2 or Levene p < 0.001) OR B fails strongly (|g1| > 1 or |g2| > 2) OR the sibling correlation is more than 0.15 below r_po. MIXED otherwise. INCONCLUSIVE (data-unavailable) if the file cannot be downloaded." ; schema:description "Assumption and decision rule fixed before the data were opened (see the pre-registration commit in the provenance graph); not an observation." .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "An in-sample test on the classic data Fisher built the model to explain, not an out-of-sample test; shared family environment cannot be separated from dominance in the sibling excess; heights are Galton's rounded values." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 34722 ; schema:description "Total byte size of the retrieved files." .
  sub:ds1Nfamilies a schema:PropertyValue ; schema:propertyID "n_families" ; schema:value 205 ; schema:description "Count of families as stated in this record's text, taken from result.json." .
  <https://w3id.org/delphi/resource/dataset/galton1886-families-histdata> a dcat:Dataset ;
    rdfs:label "Galton's 1886 family height records (934 adult children of 205 families), as distributed in the R package HistData (GaltonFamilies), via the Rdatasets CSV mirror" ;
    schema:additionalProperty sub:ds1Nfiles, sub:ds1Nbytes, sub:ds1Nfamilies ;
    dct:identifier "https://vincentarelbundock.github.io/Rdatasets/doc/HistData/GaltonFamilies.html" ;
    dcat:landingPage <https://vincentarelbundock.github.io/Rdatasets/doc/HistData/GaltonFamilies.html> ;
    dcat:version "Rdatasets master, retrieved 2026-10-31" ;
    dct:rights "GPL (HistData package); the 1886 data are public domain" ;
    dct:license "GPL (HistData package); the 1886 data are public domain" ;
    rdfs:comment "Role in this test: father, mother and adult child heights (inches) with child sex and family id" ;
    dcat:distribution sub:ds1f1 .
  sub:ds1f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://raw.githubusercontent.com/vincentarelbundock/Rdatasets/master/csv/HistData/GaltonFamilies.csv> ;
    dcat:byteSize "34722"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T05:57:48Z"^^xsd:dateTime ;
    spdx:checksum sub:ds1f1sum .
  sub:ds1f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "b1fc91e4d4b9604661967dcc62ff1055eaa3020c4d5c42d1f9d588f74b9b3317"^^xsd:hexBinary .
}

