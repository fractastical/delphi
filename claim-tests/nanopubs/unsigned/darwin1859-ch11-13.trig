sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-13> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-darwin1859-ch11-13> .
  <https://w3id.org/delphi/resource/evidence/claim-test-darwin1859-ch11-13> a delphi:EvidenceItem ;
    rdfs:label "Supported: 38% of the last 2.6 million years lies in cold, ice-rich states, 34 such intervals last at least 10 thousand years, the last glacial maximum is among the coldest, and Antarctic temperature tracks global ice volume (correlation 0.88 at a 2 kyr lag)" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If the Glacial period lasted a very long time at each place and was at least in part simultaneous across the whole world, then (a) a globally mixed marine proxy of ice volume and deep-water temperature (benthic d18O) shows prolonged cold, ice-rich states lasting well over 10 thousand years and recurring through the Pleistocene, with the last glacial maximum in such a state, and (b) a southern-hemisphere high-latitude temperature record (Antarctic ice core) is cold at the same times as the global proxy is ice-rich, within age-model uncertainty." ;
    delphi:statisticalTest "Fraction of the 0 to 2600 ka LR04 benthic d18O stack at or above 4.0 per mil; count of contiguous intervals of at least 10 kyr; Pearson correlation of EPICA Dome C temperature with negative LR04 d18O over 0 to 800 ka at lags of -6 to +6 kyr" ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:measured, sub:n, sub:uncertainty, sub:preregRule ;
    rdfs:comment "Darwin pictured one long Glacial period; the record shows dozens of glacial cycles. The test asks only whether long (>= 10 kyr), globally registered cold states recur and whether the southern high latitudes are cold at the same times, which they are (correlation 0.88 at a 2 kyr lag)." ;
    rdfs:comment "Benthic d18O mixes ice volume (mostly northern hemisphere ice sheets) with deep-water temperature; the Antarctic record is a single site. Simultaneity is shown at orbital (10-100 kyr) resolution and does not speak to millennial-scale bipolar anti-phasing." ;
    rdfs:comment "The 4.0 and 4.5 per mil thresholds are absolute values of a stack whose mean level drifts over 2.6 Myr; early Pleistocene glacials are shallower, which the 20% criterion absorbs." ;
    rdfs:comment "Darwin's 'whole world' includes the tropics and the ocean, which these two records do not resolve." ;
    prov:used <https://w3id.org/delphi/resource/dataset/lr04-benthic-d18o-stack-lisiecki-raymo-2005>, <https://w3id.org/delphi/resource/dataset/epica-dome-c-edc3-deuterium-temperature-jouzel-2007> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/cc65b2c0fa6992ecc232fd68c5c451d2f65334f3/claim-tests/darwin-origin/darwin1859-ch11-13/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "Ice ages lasted a very long time and happened in both hemispheres at once; the deep-sea record and the Antarctic ice record agree on this." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "supported" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: supports" .
  sub:measured a schema:PropertyValue ; schema:propertyID "measured_value" ; schema:value "0.37985390234525185"^^xsd:double ; schema:unitText "fraction of the last 2.6 Myr with benthic d18O >= 4.0 per mil (pre-registered threshold 0.20)" ; schema:description "Observation: the primary pre-registered quantity, computed by analysis.py from the retrieved files; further computed quantities are in result.json measured.extra." .
  sub:n a schema:PropertyValue ; schema:propertyID "sample" ; schema:value "2115 LR04 points, 5785 EDC points" ; schema:description "Observation: what was analysed after the pre-registered filters." .
  sub:uncertainty a schema:PropertyValue ; schema:propertyID "uncertainty" ; schema:value "LR04 standard errors are 0.03-0.1 per mil per point, small relative to the 4.0 threshold" ; schema:description "Observation: uncertainty or secondary statistics as reported in result.json." .
  sub:preregRule a schema:PropertyValue ; schema:propertyID "pre_registered_rule" ; schema:value "PASS: Pre-registered. Data: (1) LR04 benthic d18O stack of Lisiecki and Raymo (2005), the LR04stack.txt file served by the author (columns: age in ka, benthic d18O in per mil, error), and (2) EPICA Dome C deuterium-derived temperature anomaly on the EDC3 age scale (Jouzel et al. 2007), the NOAA paleoclimatology file edc3deuttemp2007.txt. Criterion A (long-lasting cold states): with d18O linearly interpolated to a 1-kyr grid over 0-2600 ka, d18O >= 4.0 per mil during at least 20% of the interval AND at least 5 separate contiguous intervals with d18O >= 4.0 per mil each lasting >= 10 kyr. Criterion B (last glacial maximum): mean d18O over 18-26 ka >= 4.5 per mil. Criterion C (simultaneity, north-dominated ice volume vs southern temperature): both series interpolated to a 1-kyr grid over 0-800 ka; the maximum Pearson correlation between EDC temperature anomaly and negative d18O across lags of -6 to +6 kyr (to allow for independent age models) is >= 0.6. SUPPORTS if A, B and C all hold. FAIL: Pre-registered. REFUTES if d18O >= 4.0 per mil covers < 10% of 0-2600 ka, OR fewer than 2 contiguous >= 4.0 per mil intervals last >= 10 kyr, OR the 18-26 ka mean d18O is < 4.2 per mil, OR the maximum lagged correlation in criterion C is < 0.3 (southern temperature not in step with global ice volume). MIXED otherwise (values between the support and refute thresholds, or A and B holding while C is between 0.3 and 0.6). INCONCLUSIVE (data-unavailable) if either file cannot be downloaded." ; schema:description "Assumption and decision rule fixed before the data were opened (see the pre-registration commit in the provenance graph); not an observation." .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "Shows many glacial cycles rather than Darwin's single long Glacial period; simultaneity is shown at orbital resolution for two records (a global benthic stack dominated by northern ice and one Antarctic site), not for the tropics, the ocean surface or millennial-scale bipolar anti-phasing." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 37431 ; schema:description "Total byte size of the retrieved files." .
  <https://w3id.org/delphi/resource/dataset/lr04-benthic-d18o-stack-lisiecki-raymo-2005> a dcat:Dataset ;
    rdfs:label "LR04: Pliocene-Pleistocene stack of 57 globally distributed benthic d18O records (Lisiecki and Raymo 2005), author's distribution file LR04stack.txt" ;
    schema:additionalProperty sub:ds1Nfiles, sub:ds1Nbytes ;
    dct:identifier "10.1029/2004PA001071" ;
    owl:sameAs <https://doi.org/10.1029/2004PA001071> ;
    dcat:landingPage <https://lorraine-lisiecki.com/stack.html> ;
    dcat:version "LR04 (2005) as served 2026-10-31" ;
    dct:rights "not stated on the file; published data, cite the paper" ;
    dct:license "not stated on the file; published data, cite the paper" ;
    rdfs:comment "Role in this test: global ice-volume and deep-water temperature proxy, 0-5320 ka at 1-5 kyr steps" ;
    dcat:distribution sub:ds1f1 .
  sub:ds1f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://lorraine-lisiecki.com/LR04stack.txt> ;
    dcat:byteSize "37431"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T06:14:04Z"^^xsd:dateTime ;
    spdx:checksum sub:ds1f1sum .
  sub:ds1f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "7d1a6ca7ffc033e45e20fb76a7f39c8d99df87baa1094260f9dbdc09f0bb8945"^^xsd:hexBinary .
  sub:ds2Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds2Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 357470 ; schema:description "Total byte size of the retrieved files." .
  <https://w3id.org/delphi/resource/dataset/epica-dome-c-edc3-deuterium-temperature-jouzel-2007> a dcat:Dataset ;
    rdfs:label "EPICA Dome C ice core 800 kyr deuterium and temperature estimates on the EDC3 age scale (Jouzel et al. 2007), NOAA World Data Service for Paleoclimatology file edc3deuttemp2007.txt" ;
    schema:additionalProperty sub:ds2Nfiles, sub:ds2Nbytes ;
    dct:identifier "10.1126/science.1141038" ;
    owl:sameAs <https://doi.org/10.1126/science.1141038> ;
    dcat:landingPage <https://www.ncei.noaa.gov/access/paleo-search/study/6080> ;
    dcat:version "NOAA file last updated 2007-11-26 (EDC3 age model)" ;
    dct:rights "public domain (NOAA NCEI)" ;
    dct:license "public domain (NOAA NCEI)" ;
    rdfs:comment "Role in this test: Antarctic temperature anomaly, 0-802 ka" ;
    dcat:distribution sub:ds2f1 .
  sub:ds2f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://www.ncei.noaa.gov/pub/data/paleo/icecore/antarctica/epica_domec/edc3deuttemp2007.txt> ;
    dcat:byteSize "357470"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T06:14:04Z"^^xsd:dateTime ;
    spdx:checksum sub:ds2f1sum .
  sub:ds2f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "b801fc2e422d427524619be25b50ee86fd63b36eb440eb5044d9bec12a4d1747"^^xsd:hexBinary .
}

