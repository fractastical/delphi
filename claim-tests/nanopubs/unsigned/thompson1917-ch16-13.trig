sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-13> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-thompson1917-ch16-13> .
  <https://w3id.org/delphi/resource/evidence/claim-test-thompson1917-ch16-13> a delphi:EvidenceItem ;
    rdfs:label "Supported: the pinniped withers index is about 1.0 against 1.24 to 2.99 in 40 terrestrial carnivorans (one-sided Mann-Whitney p 0.0012), and all 74 cetacean species fall below the terrestrial minimum" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If buoyancy has removed the tall arched neural spines over the withers and haunches, then secondarily aquatic mammals (pinnipeds, cetaceans) should show no anterior-thoracic ('withers') peak of relative neural-spine height along the thoracolumbar column, and their anterior-thoracic spines should be relatively shorter than those of terrestrial quadrupeds; the haunch (posterior lumbar) spines should likewise not be elevated." ;
    delphi:statisticalTest "Exact one-sided Mann-Whitney U test, pinnipeds (n = 2 species) below terrestrial carnivorans (n = 40), on the withers index (mean relative neural-spine height T1-T4 over T10-T13); cetacean withers index compared with the terrestrial distribution" ;
    delphi:pValue "0.0012"^^xsd:double ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:measured, sub:n, sub:uncertainty, sub:preregRule, sub:evNspecies ;
    rdfs:comment "Only two pinniped species (one phocid, one otariid) are in the carnivoran dataset; sirenians are absent from both datasets, and the bird-pelvis half of the claim was not tested at all. The verdict therefore covers pinnipeds and cetaceans only, not Thompson's 'all aquatic mammals'." ;
    rdfs:comment "The 'haunch' part is not discriminating in Carnivora: terrestrial carnivorans themselves show no posterior-lumbar spine peak (median HI 0.80 < 1), and pinniped HI falls inside the terrestrial range (p = 0.77). Thompson's haunch spines refer mainly to ungulates, for which no comparable public data were used." ;
    rdfs:comment "Pinniped anterior-thoracic spines are reduced (W 2.3-2.7 vs terrestrial 2.6-5.3) and the withers peak is absent (WI about 1.0), but the spines have not literally 'entirely disappeared'; Otaria byronia's W lies above the lowest terrestrial species (Martes foina)." ;
    rdfs:comment "Relative spine height from landmarks includes the neural arch and depends on where the authors placed the spinous-process landmarks; the cetacean values come from a different measurement protocol, so only the within-column ratio WI is compared across datasets." ;
    rdfs:comment "No phylogenetic comparative model was fitted (two pinniped species cannot support one); the Mann-Whitney test treats species as independent." ;
    rdfs:comment "Semi-aquatic carnivorans (otters, mink) retain a terrestrial-grade withers index (1.6-1.7), consistent with Thompson's restriction to animals whose weight is carried by water, but they were excluded from the terrestrial reference set by a decision taken before analysis; including them does not change the result." ;
    rdfs:comment "Gillet et al. label 74 species where the paper reports 73 (one specimen label is spelled 'Feresa_attenuta'); species means were taken as labelled." ;
    prov:used <https://w3id.org/delphi/resource/dataset/dryad-3j9kd51ft-figueirido-2021-carnivoran-vertebrae>, <https://w3id.org/delphi/resource/dataset/dryad-7dj6850-gillet-2019-cetacean-vertebrae> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/60aa6c10a4a039d446b32c24b094c586209cb79b/claim-tests/thompson-growth-form/thompson1917-ch16-13/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "Mammals that returned to the sea lost the tall spines over the shoulders that land mammals have; seals and whales show no such peak." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "supported" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: supports" .
  sub:measured a schema:PropertyValue ; schema:propertyID "measured_value" ; schema:value "1.023"^^xsd:double ; schema:unitText "withers index WI (mean of the two pinniped species); terrestrial carnivoran WI min 1.238, median 1.910" ; schema:description "Observation: the primary pre-registered quantity, computed by analysis.py from the retrieved files; further computed quantities are in result.json measured.extra." .
  sub:n a schema:PropertyValue ; schema:propertyID "sample" ; schema:value "45 carnivoran species (951 vertebrae) incl. 2 pinnipeds; 74 cetacean species (204 specimens, 8722 vertebrae)" ; schema:description "Observation: what was analysed after the pre-registered filters." .
  sub:uncertainty a schema:PropertyValue ; schema:propertyID "uncertainty" ; schema:value "exact one-sided Mann-Whitney U, pinnipeds < terrestrial: W p = 0.0023, WI p = 0.0012 (n = 2 vs 40; smallest attainable p = 0.0012)" ; schema:description "Observation: uncertainty or secondary statistics as reported in result.json." .
  sub:preregRule a schema:PropertyValue ; schema:propertyID "pre_registered_rule" ; schema:value "PASS: Pre-registered. Per vertebra, relative spine height h = (neural spine apex to centrum reference distance) / cranial centrum height. Per species: W = mean h over T1-T4 ('withers'); P = mean h over the posterior thoracics T10-T13 (terrestrial trough region); WI = W/P ('withers index'); HI = mean h over the last three lumbars / P ('haunch index'). Test A (Carnivora landmark data, Figueirido et al. 2021): SUPPORTS-component if every pinniped species has W below the 25th percentile of terrestrial carnivoran W and one-sided Mann-Whitney U tests give p < 0.05 for pinnipeds < terrestrial on both W and WI. Test B (cetacean linear data, Gillet et al. 2019, h = Lnp/Hc; W over the first three thoracics, P over the last three thoracics, WI = W/P): SUPPORTS-component if the median cetacean WI <= 1 and at least 80% of cetacean species have WI below the minimum WI of the terrestrial carnivorans from Test A. Overall verdict 'supports' only if both components support. FAIL: Pre-registered. Because the claim says the spines have 'entirely disappeared' in 'all aquatic mammals', a single aquatic group retaining a terrestrial-grade withers refutes it. REFUTES if (A) any pinniped species has W >= the terrestrial carnivoran median W, or (B) at least 20% of cetacean species have WI >= the terrestrial carnivoran median WI (an anterior-thoracic peak of terrestrial proportions). If neither the supports nor the refutes conditions are met, the verdict is 'mixed'. If a required measurement (spine landmarks, Lnp or Hc) is missing from the files, that component is 'inconclusive / data-unavailable'." ; schema:description "Assumption and decision rule fixed before the data were opened (see the pre-registration commit in the provenance graph); not an observation." .
  sub:evNspecies a schema:PropertyValue ; schema:propertyID "n_species" ; schema:value 74 ; schema:description "Count of species as stated in this record's text, taken from result.json." .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "Only two pinniped species are available; sirenians and the bird-pelvis half of the claim were not tested; the spines are reduced, not literally vanished; no phylogenetic comparative model was fitted; the two datasets use different spine-height protocols, so only the within-column ratio is compared." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 968281 ; schema:description "Total byte size of the retrieved files." .
  <https://w3id.org/delphi/resource/dataset/dryad-3j9kd51ft-figueirido-2021-carnivoran-vertebrae> a dcat:Dataset ;
    rdfs:label "Data from: Serial disparity in the carnivoran backbone unveil a complex adaptive role in metameric evolution (Figueirido et al. 2021, Communications Biology)" ;
    schema:additionalProperty sub:ds1Nfiles, sub:ds1Nbytes ;
    dct:identifier "10.5061/dryad.3j9kd51ft" ;
    owl:sameAs <https://doi.org/10.5061/dryad.3j9kd51ft> ;
    dcat:landingPage <https://datadryad.org/dataset/doi:10.5061/dryad.3j9kd51ft> ;
    dcat:version "Dryad version id 72212 = dataset version 1 (2020-08-10), the only publicly listed version" ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:rights "CC0 1.0" ;
    rdfs:comment "Role in this test: 3D landmarks on every thoracic and lumbar vertebra of 45 carnivoran species (after merging Felis_concolor/Puma_concolor labels), including the pinnipeds Phoca vitulina and Otaria byronia; source of relative neural-spine heights for Test A and of the terrestrial reference distribution" ;
    dcat:distribution sub:ds1f1 .
  sub:ds1f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://datadryad.org/api/v2/versions/72212/download> ;
    dcat:byteSize "968281"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T04:26:02Z"^^xsd:dateTime ;
    rdfs:comment "zip assembly of the version; contains Data.zip (967935 bytes) with IDAV Landmark exports Thoracic_Complete-1.txt (651 vertebrae x 32 landmarks) and Lumbar_Complete-1.txt (300 vertebrae x 36 landmarks) plus cervical files not used" ;
    spdx:checksum sub:ds1f1sum .
  sub:ds1f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "be2e0a6a2ce43d8d6b7e95ddd10a710a9a936dff4454b4fb2212ae651baa55fa"^^xsd:hexBinary .
  sub:ds2Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds2Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 960421 ; schema:description "Total byte size of the retrieved files." .
  sub:ds2Nspecies a schema:PropertyValue ; schema:propertyID "n_species" ; schema:value 74 ; schema:description "Count of species as stated in this record's text, taken from result.json." .
  <https://w3id.org/delphi/resource/dataset/dryad-7dj6850-gillet-2019-cetacean-vertebrae> a dcat:Dataset ;
    rdfs:label "Data from: Divergent evolutionary morphology of the axial skeleton as a potential key innovation in modern cetaceans (Gillet, Frédérich & Parmentier 2019, Proceedings B)" ;
    schema:additionalProperty sub:ds2Nfiles, sub:ds2Nbytes, sub:ds2Nspecies ;
    dct:identifier "10.5061/dryad.7dj6850" ;
    owl:sameAs <https://doi.org/10.5061/dryad.7dj6850> ;
    dcat:landingPage <https://datadryad.org/dataset/doi:10.5061/dryad.7dj6850> ;
    dcat:version "Dryad version id 41370 = dataset version 3 (2019-10-31), the only publicly listed version" ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:rights "CC0 1.0" ;
    rdfs:comment "Role in this test: Calliper neural-spine height (Lnp) and centrum height (Hc) for every thoracic, lumbar and anterior caudal vertebra of 204 cetacean specimens (74 species labels); source of the cetacean withers index for Test B" ;
    dcat:distribution sub:ds2f1 .
  sub:ds2f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://datadryad.org/api/v2/versions/41370/download> ;
    dcat:byteSize "960421"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T04:26:04Z"^^xsd:dateTime ;
    rdfs:comment "zip assembly of the version; contains Vertebral_shape.xlsx (944006 bytes; one sheet per specimen, 204 specimens, measurements in cm), Vertebral_count.xlsx and a README" ;
    schema:additionalProperty sub:ds2f1Nspecimens ;
    spdx:checksum sub:ds2f1sum .
  sub:ds2f1Nspecimens a schema:PropertyValue ; schema:propertyID "n_specimens" ; schema:value 204 ; schema:description "Count of specimens as stated in this record's text, taken from result.json." .
  sub:ds2f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "05e8ab68a205c411b4d27cb8a56e040fbbe1bae7bd442727b3a316795741ffbd"^^xsd:hexBinary .
}

