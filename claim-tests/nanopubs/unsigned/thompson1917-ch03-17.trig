    prov:atLocation <https://datras.ices.dk/WebServices/DATRASWebService.asmx/getCAdata?survey=NS-IBTS&year=2016&quarter=1> ;
    delphi:hasChecksum "sha256:d19371a89cfe894da56c65936b9d8f50e53e976f77cea336ff10396354ff863d" ;
    prov:atLocation <https://datras.ices.dk/WebServices/DATRASWebService.asmx/getCAdata?survey=NS-IBTS&year=2017&quarter=1> ;
