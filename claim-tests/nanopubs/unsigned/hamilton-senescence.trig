sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/hamilton-senescence> delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/claim-test-hamilton-senescence> .
  <https://w3id.org/delphi/resource/evidence/claim-test-hamilton-senescence> a delphi:EvidenceItem ;
    rdfs:label "Partially supported: adult mortality rises with age in 20 of 35 non-bird species (57%), above the 50% refute line but below the 80% support line; mean Spearman rho 0.15, below the pre-registered 0.3" ;
    dct:description "Pre-registered test of the claim. Hypothesis as tested: If the force of selection on survival declines with age after reproduction begins so that senescence is inevitable, then in age-structured matrix population models of unmanipulated wild animal populations, age-specific mortality should rise across the adult (reproductive) age classes in the great majority of species." ;
    delphi:statisticalTest "Per-species Spearman correlation between age-class index and adult mortality (1 - column sum of U) over mature classes of unmanipulated wild age-classified COMADRE matrices; fraction of species with rho > 0 and mean rho" ;
    schema:additionalProperty sub:plain, sub:status, sub:doesNotEstablish, sub:measured, sub:n, sub:uncertainty, sub:preregRule, sub:supportedComponent, sub:unsupportedComponent ;
    rdfs:comment "Verdict 'mixed' by the pre-registered rule (57% rising, between the 50% refute and 80% support thresholds): adult mortality rises with age in a majority of species but far from the 'great majority' that 'inevitable senescence' implies, and 13 of 35 species show falling adult mortality. This is the same direction as Jones et al. (2013) but weaker evidence, because matrix models have few age classes and noisy late-age estimates." ;
    rdfs:comment "Sample is small (35 non-bird species, 20 of them mammals) and dominated by well-studied ungulates, carnivores and fishes; it is not a random sample of animal life histories." ;
    rdfs:comment "Published age-classified matrices usually truncate age with a plus group, so the oldest ages, where senescence is strongest, are often missing; this biases the test against the claim. Conversely, class index is calendar age for most studies but not all." ;
    rdfs:comment "The proved part of the claim (the formula for the age-specific force of selection) is not tested; only the biological corollary that mortality must rise with adult age. Class Aves (8 species) is held out and scorable later with 'analysis.py --exam'; the first run of the script, before the gate was added, printed the birds' fraction rising once and it was not used." ;
    prov:used <https://w3id.org/delphi/resource/dataset/comadre-animal-matrix-database-4.26.4.0> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/c330f91dd8e6ad84365d92ac34dbee89d0a19cbe/claim-tests/math-bio-theorems/hamilton-senescence/result.json> .
  sub:plain a schema:PropertyValue ; schema:propertyID "plain_language_statement" ; schema:value "If natural selection weakens with age, death rates should rise with age in almost all wild animals; in matrix population models they rise in 20 of 35 species, a majority but not the great majority." ; schema:description "The tested claim and its outcome in one sentence for a general reader." .
  sub:status a schema:PropertyValue ; schema:propertyID "status" ; schema:value "partially supported" ; schema:description "Outcome under the pre-registered decision rule. result.json verdict field: mixed" .
  sub:measured a schema:PropertyValue ; schema:propertyID "measured_value" ; schema:value "0.5714285714285714"^^xsd:double ; schema:unitText "fraction of qualifying non-bird species with Spearman rho(age, adult mortality) > 0" ; schema:description "Observation: the primary pre-registered quantity, computed by analysis.py from the retrieved files; further computed quantities are in result.json measured.extra." .
  sub:n a schema:PropertyValue ; schema:propertyID "sample" ; schema:value "35 species (classes: {'Mammalia': 20, 'Actinopterygii': 9, 'Amphibia': 2, 'Reptilia': 2, 'Bivalvia': 1, 'Gastropoda': 1})" ; schema:description "Observation: what was analysed after the pre-registered filters." .
  sub:uncertainty a schema:PropertyValue ; schema:propertyID "uncertainty" ; schema:value "20 rising, 13 falling, 2 flat; 12 significantly rising and 6 significantly falling at p < 0.05" ; schema:description "Observation: uncertainty or secondary statistics as reported in result.json." .
  sub:preregRule a schema:PropertyValue ; schema:propertyID "pre_registered_rule" ; schema:value "PASS: Pre-registered. Data: COMADRE Animal Matrix Database v4.26.4.0 (RData file served at compadre-db.org/Data/ComadreDownload; data user agreement and citation guidelines accepted). Matrix selection: MatrixCriteriaAge == 'Yes' (age-classified), MatrixSplit == 'Divided' (U and F submatrices available), MatrixComposite in {'Individual', 'Mean'}, MatrixTreatment == 'Unmanipulated', MatrixCaptivity == 'W' (wild), matrix dimension >= 5, no missing entries in U or F. For each qualifying matrix, survival of age class a is the column sum of U for class a; the last class is dropped from the trend if U has a non-zero diagonal entry there (an open-ended plus group whose survival mixes ages). Mature classes are those whose F column sum is > 0. For each species, qualifying matrices of the same dimension are averaged element-wise (so each species contributes once); species with fewer than 4 mature age classes after dropping the plus group are excluded. Rising adult mortality = Spearman rho between age-class index and mortality (1 - survival) over the mature classes is > 0. SUPPORTS if at least 80% of qualifying species show rising adult mortality AND the mean rho across species is > 0.3. AMENDMENT (2026-10-31, before any data were downloaded, at the request of the holdout thread): species of class Aves are excluded from the primary analysis and from all criteria above; bird species are held out and only reported separately, unfitted, as a holdout check. Class is taken from COMADRE's 'Class' metadata column. FAIL: Pre-registered. REFUTES if fewer than 50% of qualifying species show rising adult mortality. MIXED otherwise (50% to 80%, or >= 80% with mean rho <= 0.3). INCONCLUSIVE (underpowered) if fewer than 15 species qualify; INCONCLUSIVE (data-unavailable) if the file cannot be downloaded or read." ; schema:description "Assumption and decision rule fixed before the data were opened (see the pre-registration commit in the provenance graph); not an observation." .
  sub:doesNotEstablish a schema:PropertyValue ; schema:propertyID "does_not_establish" ; schema:value "Does not test the proved formula for the age-specific force of selection, only the biological corollary; published matrices truncate old ages with a plus group, which biases against the claim; 35 species dominated by well-studied mammals and fishes; birds (8 species) held out and not scored." ; schema:description "Interpretation: the limits of what this evidence shows." .
  sub:supportedComponent a schema:PropertyValue ; schema:propertyID "supported_component" ; schema:value "A majority of species (20 of 35, 12 of them significant at p < 0.05) show adult mortality rising with age, the direction the claim predicts." ; schema:description "The part of the pre-registered prediction that the data meet." .
  sub:unsupportedComponent a schema:PropertyValue ; schema:propertyID "unsupported_component" ; schema:value "13 of 35 species show falling adult mortality (6 significant) and 2 are flat; the mean rho of 0.15 is below the pre-registered 0.3; 'inevitable senescence in the great majority' is not seen in these matrices." ; schema:description "The part of the pre-registered prediction that the data do not meet." .
  sub:ds1Nfiles a schema:PropertyValue ; schema:propertyID "n_files" ; schema:value 1 ; schema:description "Files of this dataset that the test retrieved and checksummed (the distributions listed here)." .
  sub:ds1Nbytes a schema:PropertyValue ; schema:propertyID "byte_size_total" ; schema:value 907304 ; schema:description "Total byte size of the retrieved files." .
  sub:ds1Nspecies a schema:PropertyValue ; schema:propertyID "n_species" ; schema:value 445 ; schema:description "Count of species as stated in this record's text, taken from result.json." .
  <https://w3id.org/delphi/resource/dataset/comadre-animal-matrix-database-4.26.4.0> a dcat:Dataset ;
    rdfs:label "COMADRE Animal Matrix Database v4.26.4.0 (3548 matrix population models, 445 species)" ;
    schema:additionalProperty sub:ds1Nfiles, sub:ds1Nbytes, sub:ds1Nspecies ;
    dct:identifier "10.1111/1365-2656.12482" ;
    owl:sameAs <https://doi.org/10.1111/1365-2656.12482> ;
    dcat:landingPage <https://compadre-db.org/Data/Comadre> ;
    dcat:version "4.26.4.0 (created 2026-04-21)" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rights "CC BY 4.0 (COMPADRE/COMADRE data user agreement)" ;
    rdfs:comment "Role in this test: age-classified U (survival) and F (fertility) submatrices with study metadata" ;
    dcat:distribution sub:ds1f1 .
  sub:ds1f1 a dcat:Distribution, prov:Entity ;
    dcat:downloadURL <https://compadre-db.org/Data/ComadreDownload> ;
    dcat:byteSize "907304"^^xsd:nonNegativeInteger ;
    prov:generatedAtTime "2026-10-31T05:57:53Z"^^xsd:dateTime ;
    spdx:checksum sub:ds1f1sum .
  sub:ds1f1sum a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "490666bacce563c2f8ed43467634b6a60c4fee2d1389900d22b087fe665d313f"^^xsd:hexBinary .
}

