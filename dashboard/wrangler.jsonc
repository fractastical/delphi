{
  "name": "delphi-mission-control",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./public" },
  // Apex and www. The zone delphibio.org has to be on this Cloudflare account before deploy,
  // or wrangler fails and the previous worker stays up. mcp. and forum. are Fly apps, not routes here.
  "routes": [
    { "pattern": "delphibio.org", "custom_domain": true },
    { "pattern": "www.delphibio.org", "custom_domain": true }
  ]
}
