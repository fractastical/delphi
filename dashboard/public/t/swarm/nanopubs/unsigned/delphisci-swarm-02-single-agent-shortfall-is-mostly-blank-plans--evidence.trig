sub:assertion {
  <https://w3id.org/delphi/resource/evidence/delphisci-swarm-02-single-agent-shortfall-is-mostly-blank-plans> a delphi:EvidenceItem ;
    rdfs:label "Per-claim triage of the single agent's shortfall: 8 blank of 8 in experiment 2; 3 blank and 4 named-but-unverified of 7 in experiment 1." ;
    dct:description "Computed from the per_claim tables of swarm/compare/results.json and results2.json (fields dataset_named and verified for the single arm's primary run), which come from the plan files under swarm/compare/runs/single-2026-10-31T06-05-08/plans and swarm/compare/runs/exp2-single-2026-10-31T06-36-43/plans and the verifier records beside them. Tool-call counts come from tool_use events in the CLI stream-json log of the single call. Per-claim triage of the single agent's primary runs. Experiment 2 (fetch required): 12 verified, shortfall 8; blank plans (dataset null with a reason) 8 [darwin1859-ch05-06, darwin1859-ch04-22, darwin1859-ch11-01, darwin1859-ch14-03, darwin1859-ch12-05, thompson1917-ch07-04, thompson1917-ch17-06, thompson1917-ch13-02]; named datasets that failed verification 0. The single agent made 13 WebFetch and 5 WebSearch calls for 20 claims in one context (centralized arm: 35 fetches over 26 calls) and produced 13589 output tokens against the centralized arm's 64948. Experiment 1 (from memory): 13 verified, shortfall 7; blank 3 [thompson1917-ch15-01, thompson1917-ch14-02, thompson1917-ch05-24]; named-but-unverified 4 [darwin1859-ch12-08, darwin1859-ch12-09, darwin1859-ch12-04, darwin1859-ch12-10]; output tokens 25177 vs 74946. So in experiment 2 the whole shortfall was blanks, and in experiment 1 about half of it was. Pre-registration timing, stated here because the header of swarm/PREREG.md is wrong: the header says \"Written 2026-10-31 06:25 UTC\", which would be after the experiment-1 runs. The session transcript shows the file written at 2026-10-31T05:52:04Z, before the first primary run started at 2026-10-31T05:57:46.622Z; the experiment-2 section was appended at 2026-10-31T06:27:23Z, before the first experiment-2 run at 2026-10-31T06:28:12.756Z. The file was not edited because it states it is never changed after runs start; the correction is in DEVIATIONS.md and here. No git commit of the file exists yet (the hub holds all commits for this branch); the commit hash is to be added to this record before signing." ;
    delphi:statisticalTest "Exact counts over 20 claims; no inferential test. Post-hoc breakdown of pre-registered runs." ;
    dct:hasPart sub:q29 , sub:q30 , sub:q31 , sub:q32 , sub:q33 , sub:q34 , sub:q35 , sub:q36 , sub:q37 , sub:q38 , sub:q39 , sub:q40 ;
    prov:wasDerivedFrom <https://delphibio.org/t/swarm/results.json> , <https://delphibio.org/t/swarm/results2.json> , <https://delphibio.org/t/swarm/runs/single/summary.json> , <https://delphibio.org/t/swarm/runs2/single/summary.json> , <https://delphibio.org/t/swarm/runs/centralized/summary.json> , <https://delphibio.org/t/swarm/runs2/centralized/summary.json> , <https://delphibio.org/t/swarm/PREREG.md> , <https://delphibio.org/t/swarm/DEVIATIONS.md> .
  sub:q29 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 2: shortfall from 20 verified (swarm/compare/runs/exp2-single-2026-10-31T06-36-43)" ;
    schema:value "8"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/runs2/single/summary.json> .
  sub:q30 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 2: blank plans (dataset null)" ;
    schema:value "8"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/runs2/single/summary.json> .
  sub:q31 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 2: named datasets that failed verification" ;
    schema:value "0"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/runs2/single/summary.json> .
  sub:q32 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 2: WebFetch calls in the one call" ;
    schema:value "13"^^xsd:integer ;
    schema:unitText "tool calls" ;
    dct:source <https://delphibio.org/t/swarm/runs2/single/summary.json> .
  sub:q33 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 2: WebSearch calls in the one call" ;
    schema:value "5"^^xsd:integer ;
    schema:unitText "tool calls" ;
    dct:source <https://delphibio.org/t/swarm/runs2/single/summary.json> .
  sub:q34 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 2: output tokens" ;
    schema:value "13589"^^xsd:integer ;
    schema:unitText "tokens" ;
    dct:source <https://delphibio.org/t/swarm/runs2/single/summary.json> .
  sub:q35 a schema:QuantitativeValue ;
    schema:name "centralized swarm, experiment 2: output tokens" ;
    schema:value "64948"^^xsd:integer ;
    schema:unitText "tokens" ;
    dct:source <https://delphibio.org/t/swarm/runs2/centralized/summary.json> .
  sub:q36 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 1: shortfall from 20 verified (swarm/compare/runs/single-2026-10-31T06-05-08)" ;
    schema:value "7"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/runs/single/summary.json> .
  sub:q37 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 1: blank plans (dataset null)" ;
    schema:value "3"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/runs/single/summary.json> .
  sub:q38 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 1: named datasets that failed verification" ;
    schema:value "4"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/runs/single/summary.json> .
  sub:q39 a schema:QuantitativeValue ;
    schema:name "single agent, experiment 1: output tokens" ;
    schema:value "25177"^^xsd:integer ;
    schema:unitText "tokens" ;
    dct:source <https://delphibio.org/t/swarm/runs/single/summary.json> .
  sub:q40 a schema:QuantitativeValue ;
    schema:name "centralized swarm, experiment 1: output tokens" ;
    schema:value "74946"^^xsd:integer ;
    schema:unitText "tokens" ;
    dct:source <https://delphibio.org/t/swarm/runs/centralized/summary.json> .
}

