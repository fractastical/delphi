    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/evidence/delphisci-swarm-04-published-delphi-templates-use-legacy-probknow-iris> a delphi:EvidenceItem ;
    rdfs:label "The two served Project Delphi templates (claim, evidence item; 2026-10-23) use pk: terms 11 and 13 times and delphi: terms 0 times; the delphi skill forbids probknow IRIs in new records." ;
    dct:description "Template https://w3id.org/np/RAI0QFH7bCNJIeKxwG3EbX5QKyoOjlaESiJkVZKs8iUc8 (\"Project Delphi claim\", created 2026-10-23T13:08:44Z, creator https://orcid.org/0000-0002-1267-0234) declares @prefix pk: <https://w3id.org/probknow/ontology/> and uses pk: terms 11 times (Claim, context, derivedFromPaper, hasAssessment, weightOfEvidence); it uses no https://w3id.org/delphi/ontology/ IRI. Template https://w3id.org/np/RAG7UB06LpEpmDKX8VFoIbeTwyRg5m9vnadwKwTuahwes (\"Project Delphi evidence item\", created 2026-10-23T13:08:44Z, creator https://orcid.org/0000-0002-1267-0234) uses pk: terms 13 times (EvidenceItem, derivedFromPaper, pValue, statisticalTest, vovkSellkeMaxPRatio, weightOfEvidence), again with no delphi: IRI. Both were fetched from w3id.org with Accept: application/trig on 2026-10-31 and are kept verbatim under swarm/nanopubs/evidence. The delphi skill (https://github.com/knowledgepixels/project-delphi-nanopubs/blob/6c543f4698ca1275247e370cc4c51cb9e09eab12/skills/delphi/SKILL.md, line 26) says: \"The legacy `https://w3id.org/probknow/...` IRIs are never used in new records.\" and that terms come from Delphi ontology v2.0 with prefix delphi: = https://w3id.org/delphi/ontology/. The nanopub skill's check-nanopub-conformance.py therefore reports every delphi: triple as unmatched and the template's required statement st01 (rdf:type pk:Claim or pk:EvidenceItem) as not instantiated, for this repository's records and for its earlier math-bio-theorems drafts alike. Files: swarm/nanopubs/evidence/template-RAI0QFH7-project-delphi-claim.trig, swarm/nanopubs/evidence/template-RAG7UB06-project-delphi-evidence-item.trig, swarm/nanopubs/evidence/delphi-skill-SKILL.md. Counts computed by swarm/nanopubs/build.mjs from those files." ;
    delphi:statisticalTest "Direct inspection and token counts; no statistical test." ;
    dct:hasPart sub:q45 , sub:q46 , sub:q47 , sub:q48 , sub:q49 , sub:q50 ;
    prov:wasDerivedFrom <https://w3id.org/np/RAI0QFH7bCNJIeKxwG3EbX5QKyoOjlaESiJkVZKs8iUc8> , <https://w3id.org/np/RAG7UB06LpEpmDKX8VFoIbeTwyRg5m9vnadwKwTuahwes> , <https://github.com/knowledgepixels/project-delphi-nanopubs/blob/6c543f4698ca1275247e370cc4c51cb9e09eab12/skills/delphi/SKILL.md> , <https://delphibio.org/t/swarm/nanopubs/evidence/template-RAI0QFH7-project-delphi-claim.trig> , <https://delphibio.org/t/swarm/nanopubs/evidence/template-RAG7UB06-project-delphi-evidence-item.trig> , <https://delphibio.org/t/swarm/nanopubs/evidence/delphi-skill-SKILL.md> .
  sub:q45 a schema:QuantitativeValue ;
    schema:name "pk: term uses in the served \"Project Delphi claim\" template (https://w3id.org/np/RAI0QFH7bCNJIeKxwG3EbX5QKyoOjlaESiJkVZKs8iUc8)" ;
    schema:value "11"^^xsd:integer ;
    schema:unitText "occurrences" ;
    dct:source <https://w3id.org/np/RAI0QFH7bCNJIeKxwG3EbX5QKyoOjlaESiJkVZKs8iUc8> .
  sub:q46 a schema:QuantitativeValue ;
    schema:name "distinct pk: terms in the claim template" ;
    schema:value "5"^^xsd:integer ;
    schema:unitText "terms" ;
    dct:source <https://w3id.org/np/RAI0QFH7bCNJIeKxwG3EbX5QKyoOjlaESiJkVZKs8iUc8> .
  sub:q47 a schema:QuantitativeValue ;
    schema:name "delphi: ontology IRIs in the claim template" ;
    schema:value "0"^^xsd:integer ;
    schema:unitText "occurrences" ;
    dct:source <https://w3id.org/np/RAI0QFH7bCNJIeKxwG3EbX5QKyoOjlaESiJkVZKs8iUc8> .
  sub:q48 a schema:QuantitativeValue ;
    schema:name "pk: term uses in the served \"Project Delphi evidence item\" template (https://w3id.org/np/RAG7UB06LpEpmDKX8VFoIbeTwyRg5m9vnadwKwTuahwes)" ;
    schema:value "13"^^xsd:integer ;
    schema:unitText "occurrences" ;
    dct:source <https://w3id.org/np/RAG7UB06LpEpmDKX8VFoIbeTwyRg5m9vnadwKwTuahwes> .
  sub:q49 a schema:QuantitativeValue ;
    schema:name "distinct pk: terms in the evidence item template" ;
    schema:value "6"^^xsd:integer ;
    schema:unitText "terms" ;
    dct:source <https://w3id.org/np/RAG7UB06LpEpmDKX8VFoIbeTwyRg5m9vnadwKwTuahwes> .
  sub:q50 a schema:QuantitativeValue ;
    schema:name "delphi: ontology IRIs in the evidence item template" ;
    schema:value "0"^^xsd:integer ;
    schema:unitText "occurrences" ;
    dct:source <https://w3id.org/np/RAG7UB06LpEpmDKX8VFoIbeTwyRg5m9vnadwKwTuahwes> .
}

