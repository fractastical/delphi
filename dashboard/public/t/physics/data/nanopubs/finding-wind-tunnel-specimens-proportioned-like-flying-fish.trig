sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/hypothesis/park-choi-specimens-fin-proportion-within-flying-fish-range> a delphi:Hypothesis, skos:Concept ;
    rdfs:label "The wind-tunnel fish whose wing loading sets the envelope have fin proportions like real flying fish" ;
    dct:description "Daane et al. 2021 measured pectoral fin length and standard length on 109 preserved beloniform specimens (Harvard MCZ). Recounted from the Genotype thread's per-specimen file: flying fish median pectoral length over standard length 0.687 (range 0.406 to 0.823, n 49), gliding halfbeaks 0.274, halfbeaks 0.140, needlefishes 0.088. The five specimens of Park and Choi (2010) report only tip-to-tip span and dihedral, so fin length over standard length is bounded above by half span over cos(dihedral) over standard length: L1 at most 0.663, L2 at most 0.636, L3 at most 0.648, M at most 0.631. These bounds lie inside the flying-fish range and at or below its median, and far above every halfbeak and needlefish. Status: supported, as a consistency statement." ;
    schema:additionalProperty [ a schema:PropertyValue ; schema:propertyID "n_specimens" ; schema:value 109 ] ;
    delphi:context "Claim under test: thompson1917-ch02-06 (D Arcy Thompson 1917, On Growth and Form, ch. II, Project Gutenberg 55264 lines 1716-1790), with thompson1917-ch02-07 and thompson1917-ch02-10. Taxon: Exocoetidae, NCBI Taxonomy 76072, GBIF 2968. Class Aves is the frozen holdout (holdout/exam.json); no bird value enters this record." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/physics-bridge-fin-proportion> ;
    prov:wasDerivedFrom <https://doi.org/10.1242/jeb.046052>, <https://doi.org/10.1016/j.cub.2021.08.054> ;
    skos:scopeNote "Measured: Daane et al. 2021 lengths (109 specimens) and Park and Choi 2010 spans. Derived: the upper bound, an inequality that needs only body width >= 0." ;
    skos:scopeNote "Say fin enlargement for gliding, never fin-to-wing: the wing is an enlarged pectoral fin." ;
    rdfs:comment "Status: supported. Does not establish: fin area, mass or glide performance for any Daane specimen (lengths only, preserved); that Cypselurus hiraii is in the Daane table (it is not; no synonymy with Cheilopogon is claimed); any length-to-area conversion (none is made, no sourced shape factor exists); anything about the genes beyond the citation: Daane et al. 2021 report that lat4a with kcnh2a reproduces the flying-fish fin proportion in zebrafish, which the Genotype thread records separately." ;
    rdfs:comment "Pre-registration: physics/tests/thompson1917-ch02-06/result.json, written 2026-10-31T18:21:00Z before any wing loading, lifting area or lift coefficient was read, amended 2026-10-31T18:26:00Z before any fit ran (the file lists both and the values seen before each); sha256 at build 0094c084db22278a5f98d96cc2971ccd27813b0acdc458d60cadf7c7b7bcae48. The git commit that timestamps it is pending: the physics thread does not commit; the hub does." ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch06-05> ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/results.json> .
  <https://w3id.org/delphi/resource/evidence/physics-bridge-fin-proportion> a delphi:EvidenceItem ;
    rdfs:label "Recount of Daane et al. 2021 Data S1A ratios and upper bounds for the Park and Choi specimens" ;
    dct:description "Recount agrees with the Genotype thread's summary for all four groups (n and median identical). Bounds use the dihedral angles stated by Park and Choi (22, 12, 7 deg for L1, L2, L3); model M's angle is not legible, so the largest stated angle is used, giving the loosest bound. Body width is not reported, so the true ratio is lower by half the body width over (cos(dihedral) times standard length). Computed by physics/bridge.py into physics/bridge.json." ;
    dct:subject <https://w3id.org/delphi/resource/hypothesis/park-choi-specimens-fin-proportion-within-flying-fish-range> ;
    rdfs:comment "Computed by physics/analysis.py from physics/glide-data.csv (sha256 bc24245b5163723b192e95fccf714ef6e4b3b28e71df4fef3befbaf008a00635) and physics/comparison-data.csv (sha256 e0d3d74639c1fe856fe5128c1783151596fde3acc923a2409be3d3f870cc394a); numbers in physics/results.json (sha256 63336841c0d4c9ae2760ae5c87a9251b97218e3ebfdd453cad4cffb9cdf6ba0b). Every input value carries its source, locator, retrieval time and value kind in those files." ;
    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/results.json>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/data/glide-data.csv>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/data/comparison-data.csv> .
}

