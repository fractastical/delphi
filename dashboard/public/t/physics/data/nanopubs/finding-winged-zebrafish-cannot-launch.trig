sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/hypothesis/winged-zebrafish-could-glide-but-cannot-launch> a delphi:Hypothesis, skos:Concept ;
    rdfs:label "HYPOTHETICAL: a zebrafish with flying-fish fin proportions could glide if launched above six metres per second, but its own modelled muscles do not get it out of the water" ;
    dct:description "An adult zebrafish of 3.0 cm standard length weighs 0.51 g by the FishBase length-weight row for Danio rerio (a 0.01889, b 3.000; an unverified estimate row, like most flying-fish rows). With the Park and Choi fins scaled isometrically to its length its wing loading is 18 N/m2 and its minimum lift-supported speed 6.1 m/s, 205 body lengths per second. In the simulator with the physiology chain scaled to its mass and the launch driven by that power, it peaks at 7.3 m/s, empties its burst store, never becomes airborne, and taxis at 2 m/s. With the flying-fish-tuned launch (unphysical for this body) it glides six times, 12 to 17 m for 1.6 to 2.5 s. Status: supported, as a statement about the model; one panel of the four-way developmental comparison, the other three being the genetics thread's." ;
    delphi:context "Claim under test: thompson1917-ch02-06 (D Arcy Thompson 1917, On Growth and Form, ch. II, Project Gutenberg 55264 lines 1716-1790), with thompson1917-ch02-07 and thompson1917-ch02-10. Taxon: Exocoetidae, NCBI Taxonomy 76072, GBIF 2968. Class Aves is the frozen holdout (holdout/exam.json); no bird value enters this record." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/physics-winged-zebrafish-runs> ;
    prov:wasDerivedFrom <https://www.fishbase.se/>, <https://doi.org/10.1242/jeb.046052> ;
    skos:scopeNote "Hypothetical; isometric scaling of fins and of the chain's physiology by mass is assumed." ;
    rdfs:comment "Status: supported. Does not establish: what a real winged zebrafish would do (the physiology is a chain of proxies scaled by mass; the fins are a geometric scaling; the length-weight row is unverified); anything about development, which is not simulated; anything about birds." ;
    rdfs:comment "Pre-registration: physics/tests/thompson1917-ch02-06/result.json, written 2026-10-31T18:21:00Z before any wing loading, lifting area or lift coefficient was read, amended 2026-10-31T18:26:00Z before any fit ran (the file lists both and the values seen before each); sha256 at build 0094c084db22278a5f98d96cc2971ccd27813b0acdc458d60cadf7c7b7bcae48. The git commit that timestamps it is pending: the physics thread does not commit; the hub does." ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch06-05> ;
    rdfs:seeAlso <https://delphibio.org/t/physics/>, <https://delphibio.org/t/physics/results.json> .
  <https://w3id.org/delphi/resource/evidence/physics-winged-zebrafish-runs> a delphi:EvidenceItem ;
    rdfs:label "Winged-zebrafish parameters and two simulator runs" ;
    dct:description "FishBase Danio rerio length-weight page fetched 2026-10-31T21:14:25Z (one row, n 3, locality not given). Areas and lengths scaled by (3.0/20.3): reference area 2.77e-4 m2, span 0.0386 m, frontal area 1.53e-5 m2 (assumed). Runs: fish=3&phys=1&v2=1 (chain launch): not airborne, peak 7.3 m/s; fish=3 (tuned launch): six glides 12 to 17 m. physics/sim/RUNS.md." ;
    dct:subject <https://w3id.org/delphi/resource/hypothesis/winged-zebrafish-could-glide-but-cannot-launch> ;
    rdfs:comment "Computed by physics/analysis.py from physics/glide-data.csv (sha256 bc24245b5163723b192e95fccf714ef6e4b3b28e71df4fef3befbaf008a00635) and physics/comparison-data.csv (sha256 e0d3d74639c1fe856fe5128c1783151596fde3acc923a2409be3d3f870cc394a); numbers in physics/results.json (sha256 63336841c0d4c9ae2760ae5c87a9251b97218e3ebfdd453cad4cffb9cdf6ba0b). Every input value carries its source, locator, retrieval time and value kind in those files." ;
    prov:wasDerivedFrom <https://delphibio.org/t/physics/results.json>, <https://delphibio.org/t/physics/data/glide-data.csv>, <https://delphibio.org/t/physics/data/comparison-data.csv> .
}

