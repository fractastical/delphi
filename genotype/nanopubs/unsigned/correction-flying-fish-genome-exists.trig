  <https://w3id.org/delphi/resource/dataset/xu-2021-hirundichthys-speculiger-draft-genome> a dcat:Dataset ;
    dct:title "Xu et al. 2021, Draft genome of the mirrorwing flyingfish (Hirundichthys speculiger), Frontiers in Genetics 12:695700" ;
