sub:assertion {
  <https://w3id.org/delphi/resource/claim/genotype-gotcha-bgee-zfin-ensembl-id-mismatch> a delphi:Claim ;
    rdfs:label "Bgee 15.2 and ZFIN's Ensembl 1:1 table use different Ensembl releases, so 1614 zebrafish genes (fgf10a and shha among them) appeared twice under different ids until merged on exact symbol" ;
    dct:description "Status: serendipitous methodological finding, established by enumeration. Mapping Bgee gene ids to ZFIN ids through ZFIN's ensembl_1_to_1 table leaves Bgee genes whose Ensembl id is absent from the table (fgf10a is ENSDARG00000116867 in Bgee and ENSDARG00000030932 in ZFIN's table). Rule adopted: such a gene is merged onto the ZFIN gene with exactly the same symbol when that symbol maps to one ZFIN gene; otherwise it keeps its Ensembl id. Key rules applied: ZFIN ensembl_1_to_1 table: 173269; exact symbol match (Ensembl id absent from ZFIN's 1:1 table): 4332; kept as Ensembl id (no 1:1 row, no unique ZFIN symbol): 13038. What it does not establish: A symbol merge is weaker than an id mapping; a renamed or split gene could be merged wrongly. The count of such errors was not measured. Pre-registration: none: a data-cleaning gotcha." ;
    delphi:context "Found while vetting genotype/map.json after the handover noted fgf10a and shha appearing twice in focus_genes." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/genotype-gotcha-bgee-zfin-ensembl-id-mismatch> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-genotype-thread-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/genotype-gotcha-bgee-zfin-ensembl-id-mismatch> a delphi:EvidenceItem ;
    rdfs:label "Gene-id reconciliation counts between Bgee and ZFIN" ;
    dct:description "Read from genotype/map.vetted.json summary.gene_id_rules." ;
    delphi:statisticalTest "Enumeration of Bgee zebrafish gene ids against the ZFIN 1:1 table and ZFIN symbol tables; no statistical test." ;
    prov:used <https://w3id.org/delphi/resource/dataset/bgee-15-2-expr-calls-zebrafish-medaka>, <https://w3id.org/delphi/resource/dataset/zfin-bulk-downloads-2026-10-31> ;
    prov:wasDerivedFrom sub:map ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/genotype/data.json> .
  <https://w3id.org/delphi/resource/evidence/genotype-gotcha-bgee-zfin-ensembl-id-mismatch> schema:additionalProperty sub:m0 .
  sub:m0 a schema:PropertyValue ; schema:propertyID "status" ; schema:value "serendipitous methodological finding, established by enumeration" ; schema:description "status of this record in the words of AGENTS.md (supported, refuted, mixed, inconclusive, or a descriptive status)" .
  <https://w3id.org/delphi/resource/evidence/genotype-gotcha-bgee-zfin-ensembl-id-mismatch> schema:additionalProperty sub:m1 .
