sub:assertion {
  <https://w3id.org/delphi/resource/claim/genotype-refutation-5-wnt10a-signalling-maintains-the-pectoral-fin-fold> a delphi:Claim ;
    rdfs:label "Not established in zebrafish: wnt10a signalling maintains the pectoral fin fold (ZFA:0005317). — Shown for the MEDIAN fin fold, not the pectoral fin fold. wnt10a mutants collapse the median fin fold and fail adult unpaired fin metamorphosis; the abstract reports no pectoral fin fold phenotype, and the mechanism is loss of distal character (dlx2a, then col1a1a and other ECM genes) and actinotrichia positioning, not a named ligand acting on a receptor in a second tissue." ;
    dct:description "Status: refuted for zebrafish, or shown to hold for a different structure or clade than the one assumed. A subagent working under genotype/AGENT_BRIEF.md was given this interaction as something to verify or refute, taken from what is known in tetrapod limbs, and the fetched zebrafish sources do not support it. What the sources actually say: Shown for the MEDIAN fin fold, not the pectoral fin fold. wnt10a mutants collapse the median fin fold and fail adult unpaired fin metamorphosis; the abstract reports no pectoral fin fold phenotype, and the mechanism is loss of distal character (dlx2a, then col1a1a and other ECM genes) and actinotrichia positioning, not a named ligand acting on a receptor in a second tissue. This matters because the project builds a fin, not a limb, and an arrow carried over from chick or mouse limb biology would have been drawn on a flying fish's pectoral fin with no fish evidence behind it. The verbatim sentences are attached to each cited publication. What it does not establish: It does not establish that the interaction is absent in zebrafish: absence of a fetched source is not absence of the biology, and several of these were searched for rather than tested experimentally. It establishes that the project has no fish evidence for it today, and so must not draw it. Pre-registration: the interaction was named as a thing to verify BEFORE the search, in the subagent task that the hub and the project lead specified, which is why a negative answer counts here rather than being discarded." ;
    delphi:context "From genotype/interactions.json (refuted_or_unsupported entry 5 of 6), produced while mapping tissue-to-tissue and cell-to-cell signalling in the zebrafish pectoral fin and fin bud. The arrows that WERE supported are in the same file: 30 of them, 12 graded mechanism." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/genotype-refutation-5-wnt10a-signalling-maintains-the-pectoral-fin-fold> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-genotype-thread-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-5-wnt10a-signalling-maintains-the-pectoral-fin-fold> a delphi:EvidenceItem ;
    rdfs:label "Zebrafish sources checked for: wnt10a signalling maintains the pectoral fin fold (ZFA:0005317)." ;
    dct:description "Read from genotype/interactions.json, refuted_or_unsupported entry 5, with the verbatim sentence from each cited paper." ;
    delphi:statisticalTest "Literature check under genotype/AGENT_BRIEF.md: the proposed interaction was searched for in zebrafish sources through a logged fetcher; an arrow with no fetched zebrafish source was recorded as unsupported rather than drawn. No statistical test." ;
    dct:source <https://pubmed.ncbi.nlm.nih.gov/37870737/> ;
    prov:wasDerivedFrom sub:interactions ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/genotype/data.json> .
  <https://pubmed.ncbi.nlm.nih.gov/37870737/> a prov:Entity ;
    dct:title "wnt10a is required for zebrafish median fin fold maintenance and adult unpaired fin metamorphosis." ;
    dct:bibliographicCitation "Benard EL 2024 Dev Dyn" ;
    dct:identifier "PMID 37870737" , "doi:10.1002/dvdy.23953" ;
    delphi:context "abstract only: the full text could not be fetched" ;
    rdfs:comment "wnt10a mutant zebrafish embryos display impaired tooth development and a collapsing median fin fold (MFF). Rescue experiments show that wnt10a is essential for MFF maintenance both during embryogenesis and later metamorphosis." .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-5-wnt10a-signalling-maintains-the-pectoral-fin-fold> schema:additionalProperty sub:m0 .
  sub:m0 a schema:PropertyValue ; schema:propertyID "status" ; schema:value "refuted for zebrafish, or shown to hold for a different structure or clade than the one assumed" ; schema:description "status of this record in the words of AGENTS.md (supported, refuted, mixed, inconclusive, or a descriptive status)" .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-5-wnt10a-signalling-maintains-the-pectoral-fin-fold> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ; schema:propertyID "publications_cited" ; schema:value "1"^^xsd:integer ; schema:description "publications whose text was quoted for this refutation" .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-5-wnt10a-signalling-maintains-the-pectoral-fin-fold> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ; schema:propertyID "supported_arrows_in_the_same_file" ; schema:value "30"^^xsd:integer ; schema:description "interactions that did pass the same test" .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-5-wnt10a-signalling-maintains-the-pectoral-fin-fold> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ; schema:propertyID "arrows_needing_orthology_inference" ; schema:value "1"^^xsd:integer ; schema:description "of those, how many had to be inferred from another species (the rest are zebrafish-native)" .
