  <https://w3id.org/delphi/resource/evidence/genotype-correction-ray-interray-null-withdrawn-and-narrowed> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ; schema:propertyID "papers_that_defeat_the_narrowed_claim" ; schema:value "0"^^xsd:integer ; schema:description "of those three, how many name a ligand in one compartment and its receptor in the other" .
  <https://w3id.org/delphi/resource/evidence/genotype-correction-ray-interray-null-withdrawn-and-narrowed> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ; schema:propertyID "papers_already_cited_by_this_thread" ; schema:value "1"^^xsd:integer ; schema:description "of those three, how many the thread already held and had read title-only (PMID 29441573)" .
  <https://w3id.org/delphi/resource/evidence/genotype-correction-ray-interray-null-withdrawn-and-narrowed> schema:additionalProperty sub:m4 .
  sub:m4 a schema:PropertyValue ; schema:propertyID "pectoral_fin_studies_among_them" ; schema:value "0"^^xsd:integer ; schema:description "all three are caudal-fin work" .
  <https://w3id.org/delphi/resource/evidence/genotype-correction-ray-interray-null-withdrawn-and-narrowed> schema:additionalProperty sub:m5 .
  sub:m5 a schema:PropertyValue ; schema:propertyID "public_self_corrections_by_this_thread" ; schema:value "3"^^xsd:integer ; schema:description "the gja5a withdrawal, the flying-fish genome correction, and this one" .
