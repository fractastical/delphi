sub:assertion {
  <https://w3id.org/delphi/resource/claim/genotype-coverage-crosswalk-cap-flying-fish-blueprint> a delphi:Claim ;
    rdfs:label "Proxy-fish gene records reach 14 of the flying-fish blueprint's 257 cell types, and the cause is the ontology crosswalk, not the data: only 16 of the 257 cell types have any zebrafish-anatomy equivalent to map through" ;
    dct:description "Status: established by enumeration of project files and ontology cross-references (descriptive, not a hypothesis test). Coverage per layer against the blueprint's own distinct counts: body 1/1, organ system 8/13, organ 28/67, tissue 29/198, cell 14/257. Zebrafish records (ZFIN) attach to a blueprint node only through Uberon hasDbXref ZFA (from Ubergraph) or ZFA xref CL (from zfa.obo), never by name; Bgee annotates to Uberon and CL itself. 16 blueprint cell types have a ZFA equivalent; 6 more carry only Cell Ontology marker relations, which are curator assertions, not fish data, and are not counted. The Cell Ontology, Uberon and ZFA are the ontologies in question. What it does not establish: It does not establish that uncovered nodes are gene-free: a node with no record is unstudied in these sources. It does not establish anything about flying-fish genes; every record is a proxy-fish record. Pre-registration: none in the sense of a hypothesis: the denominators were fixed by the blueprint file before any gene source was opened, and the attachment rule (ontology cross-references only, never names) is written in the header of genotype/build.py; neither is yet in a commit." ;
    delphi:context "Blueprint: organism-design/examples/a-flying-fish.json (sha256 c526294faebb6fcf791a8fcdc2bcc59beabe53af769842b6c29dccffca87bd6f), taxon NCBITaxon_76072. Proxy species: zebrafish (Danio rerio, ZFIN and Bgee) and medaka (Oryzias latipes, Bgee). No flying-fish (Exocoetidae) record exists in either source." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/genotype-coverage-crosswalk-cap-flying-fish-blueprint> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-genotype-thread-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/genotype-coverage-crosswalk-cap-flying-fish-blueprint> a delphi:EvidenceItem ;
    rdfs:label "Coverage of the flying-fish blueprint by direct proxy-fish gene records, per layer" ;
    dct:description "Computed by genotype/build.py from the Bgee call files, the ZFIN bulk files, zfa.obo and Ubergraph; read from genotype/map.vetted.json." ;
    delphi:statisticalTest "Enumeration: for every blueprint node, count distinct genes with a direct record by link type; a node counts as covered when any direct record exists. No statistical test." ;
    prov:used <https://w3id.org/delphi/resource/dataset/bgee-15-2-expr-calls-zebrafish-medaka>, <https://w3id.org/delphi/resource/dataset/zfin-bulk-downloads-2026-10-31>, <https://w3id.org/delphi/resource/dataset/zfa-obo-2026-07-16>, <https://w3id.org/delphi/resource/dataset/ubergraph-uberon-zfa-xrefs> ;
    prov:wasDerivedFrom sub:map ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/genotype/data.json> .
  <https://w3id.org/delphi/resource/evidence/genotype-coverage-crosswalk-cap-flying-fish-blueprint> schema:additionalProperty sub:m0 .
  sub:m0 a schema:PropertyValue ; schema:propertyID "status" ; schema:value "established by enumeration of project files and ontology cross-references (descriptive, not a hypothesis test)" ; schema:description "status of this record in the words of AGENTS.md (supported, refuted, mixed, inconclusive, or a descriptive status)" .
  <https://w3id.org/delphi/resource/evidence/genotype-coverage-crosswalk-cap-flying-fish-blueprint> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ; schema:propertyID "n_cell_types" ; schema:value "257"^^xsd:integer ; schema:description "blueprint cell types (counts_distinct)" .
  <https://w3id.org/delphi/resource/evidence/genotype-coverage-crosswalk-cap-flying-fish-blueprint> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ; schema:propertyID "n_cell_types_with_direct_record" ; schema:value "14"^^xsd:integer ; schema:description "cell types with at least one direct proxy-fish record" .
