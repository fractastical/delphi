  sub:m3 a schema:PropertyValue ; schema:propertyID "n_cell_types_with_zfa_equivalent" ; schema:value "16"^^xsd:integer ; schema:description "cell types with any ZFA cross-reference (the ceiling for ZFIN records)" .
