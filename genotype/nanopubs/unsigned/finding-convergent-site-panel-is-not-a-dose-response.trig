  sub:seqlayer a prov:Entity ;
    dct:title "genotype/sequence-layer.json (sequence-level layer, built 2026-10-31T22:03:33Z from the sequences thread's reciprocal-best-hit output)" ;
    spdx:checksum sub:sl-sha ;
    schema:contentSize "12473"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T22:03:33Z"^^xsd:dateTime ;
    rdfs:comment "THIS IS A SEQUENCE LAYER AND NOTHING MORE. An orthologue call shows a gene is present in a flying fish. Every other link in this project's map rests on expression or phenotype, which do not exist for any flying fish. Presence is not place of action and not time of action, so a sequence result must never be combined with a phenotype grade into one confidence, and a gene's chain strength is unchanged by having been found in the gene set." .
  sub:sl-sha a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "18c280d1ac64f0c77cbbfb844bd62dc2b02883b62a89977cfe1d6ffb09f20ef5" .
