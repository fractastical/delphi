    dct:title "Annotated Hirundichthys speculiger protein set (Xu et al. 2021; figshare 10.6084/m9.figshare.14600634.v1) and the Daane et al. 2021 convergent-substitution panel (Data S1 sheet G)" ;
    dcat:landingPage <https://doi.org/10.3389/fgene.2021.695700> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:version "as retrieved on 2026-10-31 (see each distribution's time)" ;
