sub:assertion {
  <https://w3id.org/delphi/resource/claim/genotype-pectoral-fin-gene-links-proxy-fish> a delphi:Claim ;
    rdfs:label "In proxy fish, 982 genes are expressed in the pectoral fin, 166 are required for it (a loss-of-function phenotype under standard conditions) and 1 verified gain-of-function gene, kcnk5b, is sufficient to enlarge it" ;
    dct:description "Status: established by enumeration of ZFIN and Bgee records (descriptive). The pectoral fin (UBERON:0000151) is the blueprint organ that matters for gliding: the flying fish's wing is an enlarged pectoral fin. Expressed-in records come from ZFIN wild-type expression and Bgee present calls with data observed in the pectoral fin itself. Required-for records are ZFIN abnormal phenotypes in single-gene fish, homozygous allele or knockdown, no construct, under ZFIN standard conditions (ZECO:0000103), with the loss-of-function evidence class stored on every link. The sufficient-for record is the kcnk5b gain-of-function allele table (PMID 24453984, doi 10.1371/journal.pgen.1004080, Perathoner S 2014, PLoS Genet). What it does not establish: Expressed-in is detection, not causation. Required-for does not mean the gene makes a fin. Nothing here is a flying-fish measurement. Pre-registration: the link-type definitions and the standard-conditions rule are in the header and code of genotype/build.py, written before the vetted build; not yet in a commit." ;
    delphi:context "In the blueprint the pectoral fin has one tissue beneath it and no cell types, so ZFIN records on fin parts (rays, fold, musculature) do not attach. Stage spans are kept apart in the link keys." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/genotype-pectoral-fin-gene-links-proxy-fish> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-genotype-thread-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/genotype-pectoral-fin-gene-links-proxy-fish> a delphi:EvidenceItem ;
    rdfs:label "Direct gene links on the pectoral fin node by link type" ;
    dct:description "Read from genotype/map.vetted.json, layer organ, node UBERON:0000151." ;
    delphi:statisticalTest "Enumeration of direct links on one node by link type; no statistical test." ;
    prov:used <https://w3id.org/delphi/resource/dataset/bgee-15-2-expr-calls-zebrafish-medaka>, <https://w3id.org/delphi/resource/dataset/zfin-bulk-downloads-2026-10-31> ;
    prov:wasDerivedFrom sub:map ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/genotype/data.json> .
  <https://w3id.org/delphi/resource/evidence/genotype-pectoral-fin-gene-links-proxy-fish> schema:additionalProperty sub:m0 .
  sub:m0 a schema:PropertyValue ; schema:propertyID "status" ; schema:value "established by enumeration of ZFIN and Bgee records (descriptive)" ; schema:description "status of this record in the words of AGENTS.md (supported, refuted, mixed, inconclusive, or a descriptive status)" .
  <https://w3id.org/delphi/resource/evidence/genotype-pectoral-fin-gene-links-proxy-fish> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ; schema:propertyID "n_genes_expressed_in_pectoral_fin" ; schema:value "982"^^xsd:integer ; schema:description "distinct genes with a direct expressed-in record" .
  <https://w3id.org/delphi/resource/evidence/genotype-pectoral-fin-gene-links-proxy-fish> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ; schema:propertyID "n_genes_required_for_pectoral_fin" ; schema:value "166"^^xsd:integer ; schema:description "distinct genes with a direct required-for record" .
  <https://w3id.org/delphi/resource/evidence/genotype-pectoral-fin-gene-links-proxy-fish> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ; schema:propertyID "n_genes_sufficient_for_pectoral_fin" ; schema:value "1"^^xsd:integer ; schema:description "distinct genes with a verified gain-of-function record" .
  <https://w3id.org/delphi/resource/evidence/genotype-pectoral-fin-gene-links-proxy-fish> schema:additionalProperty sub:m4 .
  sub:m4 a schema:PropertyValue ; schema:propertyID "n_links_stored_for_pectoral_fin" ; schema:value "378"^^xsd:integer ; schema:description "links stored in the slim map for this node (expressed-in capped)" .
  <https://w3id.org/delphi/resource/evidence/genotype-pectoral-fin-gene-links-proxy-fish> schema:additionalProperty sub:m5 .
  sub:m5 a schema:PropertyValue ; schema:propertyID "n_genes_derived_required_for" ; schema:value "3"^^xsd:integer ; schema:description "genes required for a part of the fin, carried upward (an inference)" .
