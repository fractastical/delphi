sub:assertion {
  <https://w3id.org/delphi/resource/claim/genotype-refutation-2-aer-fgf8-fgf24-signal-back-to-the-mesenchyme-to-maintain-mesenchymal-fgf> a delphi:Claim ;
    rdfs:label "Not established in zebrafish: AER Fgf8/Fgf24 signal back to the mesenchyme to maintain mesenchymal fgf10 expression, as in mouse and chick. — This specific leg is a hypothesis in zebrafish and is contradicted by the one zebrafish experiment that separates the two. Leerberg 2019 writes that it is only 'likely' by analogy to chick and mouse. Camarata 2010 found that in pdlim7 morphants AER fgf8 and fgf24 were lost while fgf10 stayed ON in the mesenchyme (indeed ectopically), so mesenchymal fgf10 did not require AER Fgfs in that experiment." ;
    dct:description "Status: refuted for zebrafish, or shown to hold for a different structure or clade than the one assumed. A subagent working under genotype/AGENT_BRIEF.md was given this interaction as something to verify or refute, taken from what is known in tetrapod limbs, and the fetched zebrafish sources do not support it. What the sources actually say: This specific leg is a hypothesis in zebrafish and is contradicted by the one zebrafish experiment that separates the two. Leerberg 2019 writes that it is only 'likely' by analogy to chick and mouse. Camarata 2010 found that in pdlim7 morphants AER fgf8 and fgf24 were lost while fgf10 stayed ON in the mesenchyme (indeed ectopically), so mesenchymal fgf10 did not require AER Fgfs in that experiment. This matters because the project builds a fin, not a limb, and an arrow carried over from chick or mouse limb biology would have been drawn on a flying fish's pectoral fin with no fish evidence behind it. The verbatim sentences are attached to each cited publication. What it does not establish: It does not establish that the interaction is absent in zebrafish: absence of a fetched source is not absence of the biology, and several of these were searched for rather than tested experimentally. It establishes that the project has no fish evidence for it today, and so must not draw it. Pre-registration: the interaction was named as a thing to verify BEFORE the search, in the subagent task that the hub and the project lead specified, which is why a negative answer counts here rather than being discarded." ;
    delphi:context "From genotype/interactions.json (refuted_or_unsupported entry 2 of 6), produced while mapping tissue-to-tissue and cell-to-cell signalling in the zebrafish pectoral fin and fin bud. The arrows that WERE supported are in the same file: 30 of them, 12 graded mechanism." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/genotype-refutation-2-aer-fgf8-fgf24-signal-back-to-the-mesenchyme-to-maintain-mesenchymal-fgf> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-genotype-thread-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-2-aer-fgf8-fgf24-signal-back-to-the-mesenchyme-to-maintain-mesenchymal-fgf> a delphi:EvidenceItem ;
    rdfs:label "Zebrafish sources checked for: AER Fgf8/Fgf24 signal back to the mesenchyme to maintain mesenchymal fgf10 expression, as in mouse and chick." ;
    dct:description "Read from genotype/interactions.json, refuted_or_unsupported entry 2, with the verbatim sentence from each cited paper." ;
    delphi:statisticalTest "Literature check under genotype/AGENT_BRIEF.md: the proposed interaction was searched for in zebrafish sources through a logged fetcher; an arrow with no fetched zebrafish source was recorded as unsupported rather than drawn. No statistical test." ;
    dct:source <https://pubmed.ncbi.nlm.nih.gov/31175226/>, <https://pubmed.ncbi.nlm.nih.gov/20950450/> ;
    prov:wasDerivedFrom sub:interactions ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/genotype/data.json> .
  <https://pubmed.ncbi.nlm.nih.gov/31175226/> a prov:Entity ;
    dct:title "Fibroblast Growth Factor Receptors Function Redundantly During Zebrafish Embryonic Development" ;
    dct:bibliographicCitation "Leerberg DM 2019 Genetics" ;
    dct:identifier "PMID 31175226" , "doi:10.1534/genetics.119.302345" ;
    delphi:context "full text read" ;
    rdfs:comment "Similar to chick and mouse, it is likely that the AER Fgfs signal back to the fin bud mesenchyme to stabilize fgf10a expression, thus establishing a positive regulatory feedback loop required for fin bud outgrowth (; )." .
  <https://pubmed.ncbi.nlm.nih.gov/20950450/> a prov:Entity ;
    dct:title "Pdlim7 is required for maintenance of the mesenchymal/epidermal Fgf signaling feedback loop during zebrafish pectoral fin development" ;
    dct:bibliographicCitation "Camarata T 2010 BMC Dev Biol" ;
    dct:identifier "PMID 20950450" , "doi:10.1186/1471-213X-10-104" ;
    delphi:context "full text read" ;
    rdfs:comment "Knock-down of pdlim7 causes persistent high levels of nuclear Tbx5 and continued ectopic expression of fgf24 in mesenchymal fin cells, which likely accounts for fgf10 maintenance despite the loss of AER genes such as fgf8." .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-2-aer-fgf8-fgf24-signal-back-to-the-mesenchyme-to-maintain-mesenchymal-fgf> schema:additionalProperty sub:m0 .
  sub:m0 a schema:PropertyValue ; schema:propertyID "status" ; schema:value "refuted for zebrafish, or shown to hold for a different structure or clade than the one assumed" ; schema:description "status of this record in the words of AGENTS.md (supported, refuted, mixed, inconclusive, or a descriptive status)" .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-2-aer-fgf8-fgf24-signal-back-to-the-mesenchyme-to-maintain-mesenchymal-fgf> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ; schema:propertyID "publications_cited" ; schema:value "2"^^xsd:integer ; schema:description "publications whose text was quoted for this refutation" .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-2-aer-fgf8-fgf24-signal-back-to-the-mesenchyme-to-maintain-mesenchymal-fgf> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ; schema:propertyID "supported_arrows_in_the_same_file" ; schema:value "30"^^xsd:integer ; schema:description "interactions that did pass the same test" .
  <https://w3id.org/delphi/resource/evidence/genotype-refutation-2-aer-fgf8-fgf24-signal-back-to-the-mesenchyme-to-maintain-mesenchymal-fgf> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ; schema:propertyID "arrows_needing_orthology_inference" ; schema:value "1"^^xsd:integer ; schema:description "of those, how many had to be inferred from another species (the rest are zebrafish-native)" .
