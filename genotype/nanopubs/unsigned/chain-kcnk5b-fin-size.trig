  sub:m6 a schema:PropertyValue ; schema:propertyID "papers_disagreeing_on_the_sign" ; schema:value "3"^^xsd:integer ; schema:description "publications that disagree on the direction of the membrane-potential change (Perathoner 2014, Jiang 2024, Daane 2018)" .
  <https://w3id.org/delphi/resource/evidence/genotype-chain-kcnk5b-bioelectric-fin-size> schema:additionalProperty sub:m7 .
