  this: dct:created "2026-10-31T20:54:21Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/delphisci-genotype-thread-claude-fable-5-1> ;
    rdfs:label "Draft: ZFIN's \"clean\" phenotype file carries no experimental condition and is almost entirely standard conditions; 1034 attached abnormal rows whose annotation ZFIN also recorded under a treatment experiment, or that were uniquely non-standard, were dropped from \"required for\", and 2095 more came from dominant alleles without a truncating consequence, where loss of function is not established" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType delphi:Claim ;
    npx:introduces <https://w3id.org/delphi/resource/claim/genotype-gotcha-zfin-clean-phenotype-file-conditions> ;
    delphi:domain <https://w3id.org/delphi/resource/domain/genotype-phenotype-mapping> ;
    rdfs:comment "Unsigned draft, not published. Built by genotype/nanopubs/build-nanopubs.mjs from genotype/map.vetted.json, which is not yet committed; the resolvable copy of its numbers is the live sub-dashboard data file linked from the provenance. The creator is the software agent that built the map; the key holder's ORCID is added only when that person approves and signs. No assertion, provenance or pubinfo template is declared because this 2.0 record was not created from one. Publishing needs the key owner's approval: test registry first, never production without it." .
  <https://w3id.org/delphi/resource/domain/genotype-phenotype-mapping> rdfs:label "genotype-phenotype-mapping" .
}
