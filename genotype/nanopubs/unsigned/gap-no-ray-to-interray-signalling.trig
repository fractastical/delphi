sub:assertion {
  <https://w3id.org/delphi/resource/claim/genotype-gap-no-ray-to-interray-arrow-found> a delphi:Claim ;
    rdfs:label "No signalling arrow between a fin ray and the inter-ray tissue could be sourced in any fin of any fish: no fetched paper names a ligand in one compartment and a receptor in the other" ;
    dct:description "Status: measured null: an absence of evidence after a logged search, not a demonstration of absence. The fin ray and the tissue between rays are the two compartments that set a fin's shape, so signalling between them was one of the interactions the project asked for by name. The subagent reported: A ray-to-interray or interray-to-ray signalling arrow in the ADULT pectoral fin. The interray tissue appears in the fetched sources only as a place where rcan2 is expressed during regeneration (Jiang 2024) and as part of a bioelectric size pathway (Lanni 2019, title only); I found no source naming a ligand in one compartment and a receptor in the other, in either direction, in any fin let alone the pectoral. Of 30 interactions recorded in the same run, with 12 graded mechanism, none runs ray to inter-ray. The arrows that do exist run epidermis to pre-osteoblast, mesenchyme to osteoblast, and blastema to osteoblast, all within or across layers rather than between the ray and inter-ray compartments. A further structural gap found in the same run: every regeneration arrow comes from the caudal fin, so the pectoral equivalents do not exist either. What it does not establish: It does not establish that no such signalling exists, nor that nobody has studied it: the search was bounded by what the fetcher could reach, and paywalled full texts were recorded as refusals. It establishes that the project cannot draw this arrow from a source today. Pre-registration: ray and inter-ray signalling was named in the task before the search, so the null is a pre-specified outcome rather than a post-hoc observation." ;
    delphi:context "Searched while building genotype/interactions.json. The project needs this arrow because a viewer zooming into a fin ray should be able to show what the ray exchanges with its neighbourhood; it currently cannot, and that is a statement about the literature." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/genotype-gap-no-ray-to-interray-arrow-found> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-genotype-thread-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/genotype-gap-no-ray-to-interray-arrow-found> a delphi:EvidenceItem ;
    rdfs:label "Logged search for ray-to-inter-ray signalling, and what was found instead" ;
    dct:description "Read from genotype/interactions.json gaps and coverage." ;
    delphi:statisticalTest "Logged literature search for a ligand in one compartment and its receptor in the other, in any fin of any fish, through genotype/agent_fetch.py. No statistical test." ;
    prov:wasDerivedFrom sub:interactions ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/genotype/data.json> .
  <https://w3id.org/delphi/resource/evidence/genotype-gap-no-ray-to-interray-arrow-found> schema:additionalProperty sub:m0 .
  sub:m0 a schema:PropertyValue ; schema:propertyID "status" ; schema:value "measured null: an absence of evidence after a logged search, not a demonstration of absence" ; schema:description "status of this record in the words of AGENTS.md (supported, refuted, mixed, inconclusive, or a descriptive status)" .
  <https://w3id.org/delphi/resource/evidence/genotype-gap-no-ray-to-interray-arrow-found> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ; schema:propertyID "ray_to_interray_arrows_found" ; schema:value "0"^^xsd:integer ; schema:description "arrows found between the ray and inter-ray compartments" .
  <https://w3id.org/delphi/resource/evidence/genotype-gap-no-ray-to-interray-arrow-found> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ; schema:propertyID "interactions_found_in_the_same_run" ; schema:value "30"^^xsd:integer ; schema:description "interactions the same run did support" .
  <https://w3id.org/delphi/resource/evidence/genotype-gap-no-ray-to-interray-arrow-found> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ; schema:propertyID "regeneration_arrows_from_the_pectoral_fin" ; schema:value "0"^^xsd:integer ; schema:description "regeneration arrows measured in the pectoral rather than the caudal fin" .
  <https://w3id.org/delphi/resource/evidence/genotype-gap-no-ray-to-interray-arrow-found> schema:additionalProperty sub:m4 .
  sub:m4 a schema:PropertyValue ; schema:propertyID "gaps_recorded_in_the_same_run" ; schema:value "25"^^xsd:integer ; schema:description "distinct gaps the run recorded" .
  sub:map a prov:Entity ;
    dct:title "genotype/map.vetted.json (vetted, slimmed genotype-phenotype map; built 2026-10-31T21:54:08Z by genotype/build.py)" ;
    spdx:checksum sub:map-sha ;
    schema:contentSize "9199854"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T21:54:08Z"^^xsd:dateTime .
  sub:map-sha a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "42ed31f2317b1dca0e34cffc5c364949f5352a76c312bc00152fed2a0cb0272a" .
  sub:interactions a prov:Entity ;
    dct:title "genotype/interactions.json (tissue-to-tissue and cell-to-cell arrows with a grade and a source on each; built 2026-10-31T20:53:36Z)" ;
