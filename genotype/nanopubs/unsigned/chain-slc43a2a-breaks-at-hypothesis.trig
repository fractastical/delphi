  <https://w3id.org/delphi/resource/evidence/genotype-chain-slc43a2a-lat4a-breaks-at-hypothesis> schema:additionalProperty sub:m5 .
  sub:m5 a schema:PropertyValue ; schema:propertyID "transport_assays_in_zebrafish" ; schema:value "0"^^xsd:integer ; schema:description "measurements of zebrafish Lat4a transport activity in any fetched source" .
  <https://w3id.org/delphi/resource/evidence/genotype-chain-slc43a2a-lat4a-breaks-at-hypothesis> schema:additionalProperty sub:m6 .
  sub:m6 a schema:PropertyValue ; schema:propertyID "publications_full_text" ; schema:value "1"^^xsd:integer ; schema:description "cited publications read in full text" .
  <https://w3id.org/delphi/resource/evidence/genotype-chain-slc43a2a-lat4a-breaks-at-hypothesis> schema:additionalProperty sub:m7 .
  sub:m7 a schema:PropertyValue ; schema:propertyID "publications_abstract_only" ; schema:value "3"^^xsd:integer ; schema:description "cited publications read as abstracts only" .
