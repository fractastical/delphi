  sub:chains a prov:Entity ;
    dct:title "genotype/causal-chains.json (causal chains with a source and an evidence grade on every link; built 2026-10-31T20:53:36Z)" ;
    spdx:checksum sub:chains-sha ;
    schema:contentSize "533418"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T20:53:36Z"^^xsd:dateTime ;
    rdfs:comment "Every link was produced by a subagent working under genotype/AGENT_BRIEF.md: nothing from memory, every statement from a document fetched in that run through the logged fetcher, a verbatim quote per source, and an evidence grade of association (expression only), necessity (loss of function), sufficiency (gain of function), mechanism (a pathway step shown experimentally) or hypothesis (proposed, not shown). A grade is about the link it sits on, not the gene. All of it is zebrafish or other proxy-species work: no flying-fish experiment exists. This file was merged and checked by genotype/assemble_chains.py, which upgrades nothing; validation flags travel with the data." .
  sub:chains-sha a spdx:Checksum ; spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "0ea69c48b36f1c4c76e9e94bcfee1e54f1ef93a30176396dec6455302988944c" .
