  sub:m3 a schema:PropertyValue ; schema:propertyID "publications_behind_every_fin_phenotype" ; schema:value "1"^^xsd:integer ; schema:description "distinct publications supplying the fin phenotypes and all ZFIN rows (PMID 34534441)" .
  <https://w3id.org/delphi/resource/evidence/genotype-chain-slc43a2a-lat4a-breaks-at-hypothesis> schema:additionalProperty sub:m4 .
