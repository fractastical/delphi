  this: dct:created "2026-10-31T18:44:10Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/delphisci-genotype-thread-claude-fable-5-1> ;
    rdfs:label "Draft: The Bgee SPARQL endpoint refused the thread's query with HTTP 403 (a Cloudflare challenge page), so expression came from Bgee's bulk call files instead" ;
