/-
# The formalised theorems as constraints a candidate can be checked against

A Lean theorem does not settle an open problem; an open problem is open because no known theorem
settles it. What a theorem can do is eliminate a **candidate**: a proposed answer or design that commits
to quantities the theorem forbids. This module states, for each formalised law, the exact form of a
commitment that the law rules out, as a lemma whose last hypothesis is a decidable fact about the
committed numbers. A candidate's certificate (`lean/Delphi/Certificates/Eliminations.lean`, generated by
`lean/eliminate/eliminate.mjs`) instantiates one of these lemmas with the candidate's numbers and
discharges that last hypothesis by `norm_num`, so the arithmetic of every elimination is kernel-checked.

Every lemma concludes `False` from the law **plus** the candidate's commitment, so an elimination is only
as strong as the law's own assumptions (its module header; the two-column scope in `lean.json`). A
candidate that does not commit to those assumptions is not eliminated: the checker reports "cannot
rule", never "passes".

Nothing here says a surviving candidate is possible. "Consistent" means only "not ruled out by these
theorems".
-/
import Delphi.Kimura
import Delphi.Favored
import Delphi.Fisher
import Delphi.MaynardSmith
import Delphi.Thompson

namespace Delphi.Constraints

/-- Two quantities confined to disjoint intervals are unequal. -/
theorem ne_of_lt_intervals {x y a b c d : ℝ} (hx : a ≤ x ∧ x ≤ b) (hy : c ≤ y ∧ y ≤ d) (h : b < c) :
    x ≠ y := by
  intro hxy
  linarith [hx.2, hy.1]

/-- **C1, Kimura's rate.** A candidate that commits the neutral substitution rate to `[a, b]` and the
mutation rate to `[c, d]`, with the intervals disjoint, is ruled out: the rate equals `μ`. -/
theorem kimura_rate_rules_out (M : ℕ) (hM : 0 < M) (μ : ℝ) {a b c d : ℝ}
    (hk : a ≤ substitutionRate M μ ((wrightFisher M hM).fixationProbability (oneCopy M hM)) ∧
      substitutionRate M μ ((wrightFisher M hM).fixationProbability (oneCopy M hM)) ≤ b)
    (hμ : c ≤ μ ∧ μ ≤ d) (h : b < c ∨ d < a) : False := by
  rw [neutral_substitution_rate] at hk
  rcases h with h | h <;> linarith [hk.1, hk.2, hμ.1, hμ.2]

/-- **C1b, Kimura's rate between lineages.** Two neutral lineages with the same mutation rate cannot have
substitution rates in a ratio other than `1`: a candidate that commits to equal mutation rates and an
`r`-fold difference in neutral substitution rate (for example "caused by population size") is ruled out. -/
theorem kimura_rate_ratio_rules_out (M₁ M₂ : ℕ) (h₁ : 0 < M₁) (h₂ : 0 < M₂) (μ₁ μ₂ r : ℝ)
    (hμ : μ₁ = μ₂) (hpos : 0 < μ₁)
    (hk : substitutionRate M₂ μ₂ ((wrightFisher M₂ h₂).fixationProbability (oneCopy M₂ h₂)) =
      r * substitutionRate M₁ μ₁ ((wrightFisher M₁ h₁).fixationProbability (oneCopy M₁ h₁)))
    (hr : r ≠ 1) : False := by
  rw [neutral_substitution_rate, neutral_substitution_rate, ← hμ] at hk
  have : r * μ₁ = 1 * μ₁ := by linarith
  exact hr (mul_right_cancel₀ hpos.ne' this)

/-- **C2, neutral fixation.** A candidate that confines the fixation probability of one new neutral
mutant among `M` copies to an interval not containing `1/M` is ruled out. -/
theorem neutral_fixation_rules_out (M : ℕ) (hM : 0 < M) {a b : ℝ}
    (hu : a ≤ (wrightFisher M hM).fixationProbability (oneCopy M hM) ∧
      (wrightFisher M hM).fixationProbability (oneCopy M hM) ≤ b)
    (h : b < 1 / (M : ℝ) ∨ 1 / (M : ℝ) < a) : False := by
  rw [wrightFisher_fixation_one] at hu
  rcases h with h | h <;> linarith [hu.1, hu.2]

/-- **C3, the favored floor.** A candidate that says a mutant selection does not oppose (`s ≥ 0`) fixes
with probability at most `b < 1/M` is ruled out. -/
theorem favored_fixation_rules_out (M : ℕ) (hM : 0 < M) (s : ℝ) (hs : 0 ≤ s) {b : ℝ}
    (hu : (wrightFisherSelection M hM s hs).fixationProbability (oneCopy M hM) ≤ b)
    (h : b < 1 / (M : ℝ)) : False := by
  have := wrightFisherSelection_fixation_one_ge M hM s hs
  linarith

/-- **C3b, the supply ceiling.** A candidate that commits to an expected number of substitutions over
`G` sites and `T` generations above the mutation supply `G · M · μ · T` is ruled out, for any fixation
probability `u ≤ 1`. (An expectation, not a realised count.) -/
theorem supply_rules_out (M : ℕ) (μ u : ℝ) (hμ : 0 ≤ μ) (hu : u ≤ 1) (T : ℕ) {G c : ℝ} (hG : 0 ≤ G)
    (hc : c = G * expectedSubstitutions M μ u T) (h : G * ((M : ℝ) * μ * T) < c) : False := by
  have h1 := expectedSubstitutions_le M μ u hμ hu T
  have h2 := mul_le_mul_of_nonneg_left h1 hG
  linarith

/-- **C3b, interval form.** The mutation rate at most `μh` and the committed expectation at least `cl`:
ruled out when `G · M · μh · T < cl`. -/
theorem supply_rules_out' (M : ℕ) (μ u : ℝ) (hμ : 0 ≤ μ) (hu : u ≤ 1) (T : ℕ) {G cl μh : ℝ} (hG : 0 ≤ G)
    (hμh : μ ≤ μh) (hc : cl ≤ G * expectedSubstitutions M μ u T) (h : G * ((M : ℝ) * μh * T) < cl) :
    False := by
  have h1 := expectedSubstitutions_le M μ u hμ hu T
  have h2 := mul_le_mul_of_nonneg_left h1 hG
  have h3 : G * ((M : ℝ) * μ * T) ≤ G * ((M : ℝ) * μh * T) :=
    mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hμh (Nat.cast_nonneg M))
      (Nat.cast_nonneg T)) hG
  linarith

/-- **C4, Fisher.** A candidate that commits to a change in mean fitness `Δ`, a mean fitness `m > 0` and a
variance in fitness `V` under one round of selection with fixed fitnesses, with `Δ · m ≠ V`, is ruled out. -/
theorem fisher_rules_out {ι : Type*} [Fintype ι] {p w : ι → ℝ} (hp : IsFreq p)
    (hmean : 0 < meanFitness p w) {Δ V m : ℝ}
    (hΔ : meanFitness (select p w) w - meanFitness p w = Δ) (hV : variance p w = V)
    (hm : meanFitness p w = m) (h : Δ * m ≠ V) : False := by
  have := fisher_fundamental_theorem' hp hmean
  rw [hΔ, hV, hm] at this
  exact h this

/-- **C4b, Fisher's sign.** A candidate that says mean fitness falls under one round of selection with
fixed fitnesses is ruled out. -/
theorem fisher_decline_rules_out {ι : Type*} [Fintype ι] {p w : ι → ℝ} (hp : IsFreq p)
    (hmean : 0 < meanFitness p w) {b : ℝ}
    (hΔ : meanFitness (select p w) w - meanFitness p w ≤ b) (h : b < 0) : False := by
  have := mean_fitness_nondecreasing hp hmean
  linarith

/-- **C4c, Fisher with zero variance.** If the variance in fitness is `0`, mean fitness does not change at
all: a candidate that commits to zero variance and a nonzero change is ruled out. -/
theorem fisher_zero_variance_rules_out {ι : Type*} [Fintype ι] {p w : ι → ℝ} (hp : IsFreq p)
    (hmean : 0 < meanFitness p w) (hV : variance p w = 0) {Δ : ℝ}
    (hΔ : meanFitness (select p w) w - meanFitness p w = Δ) (h : Δ ≠ 0) : False := by
  have := fisher_fundamental_theorem hp hmean
  rw [hΔ, hV, zero_div] at this
  exact h this

/-- **C5b, the per-generation factor.** Under equal fecundity and a 1:1 sex ratio the odds of asexual
females grow by exactly `2` per generation: a candidate committing to any other factor is ruled out. -/
theorem twofold_factor_rules_out {q f r : ℝ} (hq0 : 0 < q) (hq1 : q < 1) (hf : 0 < f)
    (hr : odds (asexualNext q f) = r * odds q) (h : r ≠ 2) : False := by
  have h2 := twofold_cost_of_sex hq0 hq1 hf
  have hodds : 0 < odds q := div_pos hq0 (by linarith)
  rw [h2] at hr
  exact h (mul_right_cancel₀ hodds.ne' hr).symm

/-- **C5, the twofold cost.** A candidate that commits the asexual fraction to `q` now and `qn` after `n`
generations, under equal fecundity and a 1:1 sex ratio, with `odds qn ≠ 2^n · odds q`, is ruled out. -/
theorem twofold_rules_out {q f : ℝ} (hq0 : 0 < q) (hq1 : q < 1) (hf : 0 < f) (n : ℕ) {qn : ℝ}
    (hqn : asexualAfter q f n = qn) (h : odds qn ≠ 2 ^ n * odds q) : False := by
  have := twofold_cost_of_sex_n hq0 hq1 hf n
  rw [hqn] at this
  exact h this

/-- **C7, the cube law.** A candidate that commits to isometric scaling at constant density from size
`L₁` to `L₂` with length ratio `ℓ` and weight ratio `r ≠ ℓ^3` is ruled out. (Only the mass side of
Galileo's square–cube argument: strength scaling as `L^2` is not formalised.) -/
theorem cubeLaw_rules_out {W : ℝ → ℝ} {k : ℝ} (h : CubeLaw W k) {L₁ L₂ r ℓ : ℝ} (h₁ : 0 < L₁)
    (h₂ : 0 < L₂) (hr : W L₂ / W L₁ = r) (hℓ : L₂ / L₁ = ℓ) (hne : r ≠ ℓ ^ 3) : False := by
  have := cubeLaw_ratio h h₁ h₂
  rw [hr, hℓ] at this
  exact hne this

/-- **C7, interval form.** Weight ratio confined to `[a, b]` and length ratio to `[c, d]` with `0 ≤ c`:
ruled out when `[a, b]` and `[c^3, d^3]` are disjoint. -/
theorem cubeLaw_rules_out' {W : ℝ → ℝ} {k : ℝ} (h : CubeLaw W k) {L₁ L₂ a b c d : ℝ} (h₁ : 0 < L₁)
    (h₂ : 0 < L₂) (hr : a ≤ W L₂ / W L₁ ∧ W L₂ / W L₁ ≤ b) (hℓ : c ≤ L₂ / L₁ ∧ L₂ / L₁ ≤ d)
    (hc : 0 ≤ c) (hne : b < c ^ 3 ∨ d ^ 3 < a) : False := by
  have hq := cubeLaw_ratio h h₁ h₂
  have hℓ0 : 0 ≤ L₂ / L₁ := le_trans hc hℓ.1
  have hlo : c ^ 3 ≤ (L₂ / L₁) ^ 3 := pow_le_pow_left₀ hc hℓ.1 3
  have hhi : (L₂ / L₁) ^ 3 ≤ d ^ 3 := pow_le_pow_left₀ hℓ0 hℓ.2 3
  rcases hne with hne | hne <;> linarith [hr.1, hr.2]

/-- **C7b, the exponent form.** A log-log exponent confined to an interval not containing `3`, under
isometric scaling at constant density, is ruled out for every `k`. -/
theorem exponent_rules_out {W : ℝ → ℝ} {L₁ L₂ a b : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hne : L₁ ≠ L₂)
    (hb : a ≤ logSlope W L₁ L₂ ∧ logSlope W L₁ L₂ ≤ b) (h : b < 3 ∨ 3 < a) : ∀ k, ¬ CubeLaw W k := by
  intro k hk
  have := cubeLaw_loglog_exponent hk h₁ h₂ hne
  rcases h with h | h <;> linarith [hb.1, hb.2]

end Delphi.Constraints
