/-
# The formalised theorems as constraints a candidate can be checked against

A Lean theorem does not settle an open problem; an open problem is open because no known theorem
settles it. What a theorem can do is eliminate a **candidate**: a proposed answer or design that commits
to quantities the theorem forbids. This module states, for each formalised law, the exact form of a
commitment that the law rules out, as a lemma whose last hypothesis is a decidable fact about the
committed numbers. A candidate's certificate (`lean/Delphi/Certificates/Eliminations.lean`, generated by
`lean/eliminate/eliminate.mjs`) instantiates one of these lemmas with the candidate's numbers and
discharges that last hypothesis by `norm_num`, so the arithmetic of every elimination is kernel-checked.

Every lemma concludes `False` from the law **plus** the candidate's commitment, so an elimination is only
as strong as the law's own assumptions (its module header; the two-column scope in `lean.json`). A
candidate that does not commit to those assumptions is not eliminated: the checker reports "cannot
rule", never "passes".

Nothing here says a surviving candidate is possible. "Consistent" means only "not ruled out by these
theorems".
-/
import Delphi.Kimura
import Delphi.Favored
import Delphi.Fisher
import Delphi.MaynardSmith
import Delphi.Thompson
import Delphi.Scaling
import Delphi.Flight

namespace Delphi.Constraints

/-- Two quantities confined to disjoint intervals are unequal. -/
theorem ne_of_lt_intervals {x y a b c d : ℝ} (hx : a ≤ x ∧ x ≤ b) (hy : c ≤ y ∧ y ≤ d) (h : b < c) :
    x ≠ y := by
  intro hxy
  linarith [hx.2, hy.1]

/-- **C1, Kimura's rate.** A candidate that commits the neutral substitution rate to `[a, b]` and the
mutation rate to `[c, d]`, with the intervals disjoint, is ruled out: the rate equals `μ`. -/
theorem kimura_rate_rules_out (M : ℕ) (hM : 0 < M) (μ : ℝ) {a b c d : ℝ}
    (hk : a ≤ substitutionRate M μ ((wrightFisher M hM).fixationProbability (oneCopy M hM)) ∧
      substitutionRate M μ ((wrightFisher M hM).fixationProbability (oneCopy M hM)) ≤ b)
    (hμ : c ≤ μ ∧ μ ≤ d) (h : b < c ∨ d < a) : False := by
  rw [neutral_substitution_rate] at hk
  rcases h with h | h <;> linarith [hk.1, hk.2, hμ.1, hμ.2]

/-- **C1b, Kimura's rate between lineages.** Two neutral lineages with the same mutation rate cannot have
substitution rates in a ratio other than `1`: a candidate that commits to equal mutation rates and an
`r`-fold difference in neutral substitution rate (for example "caused by population size") is ruled out. -/
theorem kimura_rate_ratio_rules_out (M₁ M₂ : ℕ) (h₁ : 0 < M₁) (h₂ : 0 < M₂) (μ₁ μ₂ r : ℝ)
    (hμ : μ₁ = μ₂) (hpos : 0 < μ₁)
    (hk : substitutionRate M₂ μ₂ ((wrightFisher M₂ h₂).fixationProbability (oneCopy M₂ h₂)) =
      r * substitutionRate M₁ μ₁ ((wrightFisher M₁ h₁).fixationProbability (oneCopy M₁ h₁)))
    (hr : r ≠ 1) : False := by
  rw [neutral_substitution_rate, neutral_substitution_rate, ← hμ] at hk
  have : r * μ₁ = 1 * μ₁ := by linarith
  exact hr (mul_right_cancel₀ hpos.ne' this)

/-- **C2, neutral fixation.** A candidate that confines the fixation probability of one new neutral
mutant among `M` copies to an interval not containing `1/M` is ruled out. -/
theorem neutral_fixation_rules_out (M : ℕ) (hM : 0 < M) {a b : ℝ}
    (hu : a ≤ (wrightFisher M hM).fixationProbability (oneCopy M hM) ∧
      (wrightFisher M hM).fixationProbability (oneCopy M hM) ≤ b)
    (h : b < 1 / (M : ℝ) ∨ 1 / (M : ℝ) < a) : False := by
  rw [wrightFisher_fixation_one] at hu
  rcases h with h | h <;> linarith [hu.1, hu.2]

/-- **C3, the favored floor.** A candidate that says a mutant selection does not oppose (`s ≥ 0`) fixes
with probability at most `b < 1/M` is ruled out. -/
theorem favored_fixation_rules_out (M : ℕ) (hM : 0 < M) (s : ℝ) (hs : 0 ≤ s) {b : ℝ}
    (hu : (wrightFisherSelection M hM s hs).fixationProbability (oneCopy M hM) ≤ b)
    (h : b < 1 / (M : ℝ)) : False := by
  have := wrightFisherSelection_fixation_one_ge M hM s hs
  linarith

/-- **C3b, the supply ceiling.** A candidate that commits to an expected number of substitutions over
`G` sites and `T` generations above the mutation supply `G · M · μ · T` is ruled out, for any fixation
probability `u ≤ 1`. (An expectation, not a realised count.) -/
theorem supply_rules_out (M : ℕ) (μ u : ℝ) (hμ : 0 ≤ μ) (hu : u ≤ 1) (T : ℕ) {G c : ℝ} (hG : 0 ≤ G)
    (hc : c = G * expectedSubstitutions M μ u T) (h : G * ((M : ℝ) * μ * T) < c) : False := by
  have h1 := expectedSubstitutions_le M μ u hμ hu T
  have h2 := mul_le_mul_of_nonneg_left h1 hG
  linarith

/-- **C3b, interval form.** The mutation rate at most `μh` and the committed expectation at least `cl`:
ruled out when `G · M · μh · T < cl`. -/
theorem supply_rules_out' (M : ℕ) (μ u : ℝ) (hμ : 0 ≤ μ) (hu : u ≤ 1) (T : ℕ) {G cl μh : ℝ} (hG : 0 ≤ G)
    (hμh : μ ≤ μh) (hc : cl ≤ G * expectedSubstitutions M μ u T) (h : G * ((M : ℝ) * μh * T) < cl) :
    False := by
  have h1 := expectedSubstitutions_le M μ u hμ hu T
  have h2 := mul_le_mul_of_nonneg_left h1 hG
  have h3 : G * ((M : ℝ) * μ * T) ≤ G * ((M : ℝ) * μh * T) :=
    mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hμh (Nat.cast_nonneg M))
      (Nat.cast_nonneg T)) hG
  linarith

/-- **C4, Fisher.** A candidate that commits to a change in mean fitness `Δ`, a mean fitness `m > 0` and a
variance in fitness `V` under one round of selection with fixed fitnesses, with `Δ · m ≠ V`, is ruled out. -/
theorem fisher_rules_out {ι : Type*} [Fintype ι] {p w : ι → ℝ} (hp : IsFreq p)
    (hmean : 0 < meanFitness p w) {Δ V m : ℝ}
    (hΔ : meanFitness (select p w) w - meanFitness p w = Δ) (hV : variance p w = V)
    (hm : meanFitness p w = m) (h : Δ * m ≠ V) : False := by
  have := fisher_fundamental_theorem' hp hmean
  rw [hΔ, hV, hm] at this
  exact h this

/-- **C4b, Fisher's sign.** A candidate that says mean fitness falls under one round of selection with
fixed fitnesses is ruled out. -/
theorem fisher_decline_rules_out {ι : Type*} [Fintype ι] {p w : ι → ℝ} (hp : IsFreq p)
    (hmean : 0 < meanFitness p w) {b : ℝ}
    (hΔ : meanFitness (select p w) w - meanFitness p w ≤ b) (h : b < 0) : False := by
  have := mean_fitness_nondecreasing hp hmean
  linarith

/-- **C4c, Fisher with zero variance.** If the variance in fitness is `0`, mean fitness does not change at
all: a candidate that commits to zero variance and a nonzero change is ruled out. -/
theorem fisher_zero_variance_rules_out {ι : Type*} [Fintype ι] {p w : ι → ℝ} (hp : IsFreq p)
    (hmean : 0 < meanFitness p w) (hV : variance p w = 0) {Δ : ℝ}
    (hΔ : meanFitness (select p w) w - meanFitness p w = Δ) (h : Δ ≠ 0) : False := by
  have := fisher_fundamental_theorem hp hmean
  rw [hΔ, hV, zero_div] at this
  exact h this

/-- **C5b, the per-generation factor.** Under equal fecundity and a 1:1 sex ratio the odds of asexual
females grow by exactly `2` per generation: a candidate committing to any other factor is ruled out. -/
theorem twofold_factor_rules_out {q f r : ℝ} (hq0 : 0 < q) (hq1 : q < 1) (hf : 0 < f)
    (hr : odds (asexualNext q f) = r * odds q) (h : r ≠ 2) : False := by
  have h2 := twofold_cost_of_sex hq0 hq1 hf
  have hodds : 0 < odds q := div_pos hq0 (by linarith)
  rw [h2] at hr
  exact h (mul_right_cancel₀ hodds.ne' hr).symm

/-- **C5, the twofold cost.** A candidate that commits the asexual fraction to `q` now and `qn` after `n`
generations, under equal fecundity and a 1:1 sex ratio, with `odds qn ≠ 2^n · odds q`, is ruled out. -/
theorem twofold_rules_out {q f : ℝ} (hq0 : 0 < q) (hq1 : q < 1) (hf : 0 < f) (n : ℕ) {qn : ℝ}
    (hqn : asexualAfter q f n = qn) (h : odds qn ≠ 2 ^ n * odds q) : False := by
  have := twofold_cost_of_sex_n hq0 hq1 hf n
  rw [hqn] at this
  exact h this

/-- **C7, the cube law.** A candidate that commits to isometric scaling at constant density from size
`L₁` to `L₂` with length ratio `ℓ` and weight ratio `r ≠ ℓ^3` is ruled out. (Only the mass side of
Galileo's square–cube argument: strength scaling as `L^2` is not formalised.) -/
theorem cubeLaw_rules_out {W : ℝ → ℝ} {k : ℝ} (h : CubeLaw W k) {L₁ L₂ r ℓ : ℝ} (h₁ : 0 < L₁)
    (h₂ : 0 < L₂) (hr : W L₂ / W L₁ = r) (hℓ : L₂ / L₁ = ℓ) (hne : r ≠ ℓ ^ 3) : False := by
  have := cubeLaw_ratio h h₁ h₂
  rw [hr, hℓ] at this
  exact hne this

/-- **C7, interval form.** Weight ratio confined to `[a, b]` and length ratio to `[c, d]` with `0 ≤ c`:
ruled out when `[a, b]` and `[c^3, d^3]` are disjoint. -/
theorem cubeLaw_rules_out' {W : ℝ → ℝ} {k : ℝ} (h : CubeLaw W k) {L₁ L₂ a b c d : ℝ} (h₁ : 0 < L₁)
    (h₂ : 0 < L₂) (hr : a ≤ W L₂ / W L₁ ∧ W L₂ / W L₁ ≤ b) (hℓ : c ≤ L₂ / L₁ ∧ L₂ / L₁ ≤ d)
    (hc : 0 ≤ c) (hne : b < c ^ 3 ∨ d ^ 3 < a) : False := by
  have hq := cubeLaw_ratio h h₁ h₂
  have hℓ0 : 0 ≤ L₂ / L₁ := le_trans hc hℓ.1
  have hlo : c ^ 3 ≤ (L₂ / L₁) ^ 3 := pow_le_pow_left₀ hc hℓ.1 3
  have hhi : (L₂ / L₁) ^ 3 ≤ d ^ 3 := pow_le_pow_left₀ hℓ0 hℓ.2 3
  rcases hne with hne | hne <;> linarith [hr.1, hr.2]

/-- **C7b, the exponent form.** A log-log exponent confined to an interval not containing `3`, under
isometric scaling at constant density, is ruled out for every `k`. -/
theorem exponent_rules_out {W : ℝ → ℝ} {L₁ L₂ a b : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hne : L₁ ≠ L₂)
    (hb : a ≤ logSlope W L₁ L₂ ∧ logSlope W L₁ L₂ ≤ b) (h : b < 3 ∨ 3 < a) : ∀ k, ¬ CubeLaw W k := by
  intro k hk
  have := cubeLaw_loglog_exponent hk h₁ h₂ hne
  rcases h with h | h <;> linarith [hb.1, hb.2]

/-! ### Strength (R7) and flight (R4, R5, R8) -/

/-- **C8, axial strength, dimensional.** A member of cross-section `A` and breaking stress `σ` that is
claimed to carry `n` body weights `W` is ruled out when `σ A < n W`. -/
theorem axial_strength_rules_out {σ A W n F : ℝ} (hF : F = σ * A) (hclaim : n * W ≤ F) (h : σ * A < n * W) :
    False := by
  linarith

/-- **C8b, strength scaling.** Under isometric sections and the same material, breaking load scales as `L²`:
a committed breaking-load ratio `r` at length ratio `ℓ` with `r ≠ ℓ²` is ruled out. -/
theorem strength_ratio_rules_out {A : ℝ → ℝ} {k₃ σ : ℝ} (hA : AreaLaw A k₃) (hσ : 0 < σ) {L₁ L₂ r ℓ : ℝ}
    (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hr : breakLoad σ A L₂ / breakLoad σ A L₁ = r) (hℓ : L₂ / L₁ = ℓ)
    (hne : r ≠ ℓ ^ 2) : False := by
  have := breakLoad_ratio hA hσ h₁ h₂
  rw [hr, hℓ] at this
  exact hne this

/-- **C8c, Galileo's giant.** A body scaled by `ℓ` with unchanged proportions and material, whose reference
member carries `n₀` body weights, is claimed to carry `n` body weights: ruled out when `n₀ < n ℓ`. -/
theorem giant_rules_out {W A : ℝ → ℝ} {k₁ k₃ σ : ℝ} (hW : CubeLaw W k₁) (hA : AreaLaw A k₃) {L₁ L₂ ℓ n₀ n : ℝ}
    (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hℓ : L₂ / L₁ = ℓ) (hn₀ : breakLoad σ A L₁ / W L₁ = n₀)
    (hclaim : n * W L₂ ≤ breakLoad σ A L₂) (h : n₀ < n * ℓ) : False := by
  have hs := safetyFactor_scaled (σ := σ) hW hA h₁ h₂
  rw [hn₀, hℓ] at hs
  have hW₂ : 0 < W L₂ := cubeLaw_pos hW h₂
  have hℓpos : 0 < ℓ := by rw [← hℓ]; positivity
  have h3 : n ≤ breakLoad σ A L₂ / W L₂ := by rw [le_div_iff₀ hW₂]; exact hclaim
  rw [hs, le_div_iff₀ hℓpos] at h3
  linarith

/-- **C8d, stress scaling.** Under R1 and isometric sections, stress `W/A` grows as `L`: a committed stress
ratio `r` at length ratio `ℓ` with `r ≠ ℓ` is ruled out. -/
theorem stress_ratio_rules_out {W A : ℝ → ℝ} {k₁ k₃ : ℝ} (hW : CubeLaw W k₁) (hA : AreaLaw A k₃) {L₁ L₂ r ℓ : ℝ}
    (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hr : (W L₂ / A L₂) / (W L₁ / A L₁) = r) (hℓ : L₂ / L₁ = ℓ) (hne : r ≠ ℓ) :
    False := by
  have := stress_ratio hW hA h₁ h₂
  rw [hr, hℓ] at this
  exact hne this

/-- **C2a, area scaling.** Under isometry an area scales as `L²`: a committed area ratio `r` at length ratio
`ℓ` with `r ≠ ℓ²` is ruled out. -/
theorem area_ratio_rules_out {S : ℝ → ℝ} {k : ℝ} (hS : AreaLaw S k) {L₁ L₂ r ℓ : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂)
    (hr : S L₂ / S L₁ = r) (hℓ : L₂ / L₁ = ℓ) (hne : r ≠ ℓ ^ 2) : False := by
  have := areaLaw_ratio hS h₁ h₂
  rw [hr, hℓ] at this
  exact hne this

lemma log_ratio_ne_zero {L₁ L₂ : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hne : L₁ ≠ L₂) : Real.log (L₂ / L₁) ≠ 0 :=
  Real.log_ne_zero_of_pos_of_ne_one (by positivity) (fun h0 => hne ((div_eq_one_iff_eq h₁.ne').mp h0).symm)

/-- **C2a, area exponent.** Under isometry an area's log-log exponent on `L` is `2`. -/
theorem area_exponent_rules_out {S : ℝ → ℝ} {k : ℝ} (hS : AreaLaw S k) {L₁ L₂ b : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂)
    (hne : L₁ ≠ L₂) (hb : Real.log (S L₂ / S L₁) = b * Real.log (L₂ / L₁)) (h : b ≠ 2) : False := by
  have := areaLaw_log hS h₁ h₂
  rw [hb] at this
  exact h (mul_right_cancel₀ (log_ratio_ne_zero h₁ h₂ hne) this)

/-- **C8e, stress (or wing-loading) exponent.** Under R1 and isometric areas the exponent of `W/A` on `L` is `1`. -/
theorem stress_exponent_rules_out {W A : ℝ → ℝ} {k₁ k₃ : ℝ} (hW : CubeLaw W k₁) (hA : AreaLaw A k₃) {L₁ L₂ b : ℝ}
    (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hne : L₁ ≠ L₂)
    (hb : Real.log ((W L₂ / A L₂) / (W L₁ / A L₁)) = b * Real.log (L₂ / L₁)) (h : b ≠ 1) : False := by
  have := wingLoading_log hW hA h₁ h₂
  rw [hb] at this
  exact h (mul_right_cancel₀ (log_ratio_ne_zero h₁ h₂ hne) this)

/-- **C9c, minimum-speed exponent.** Under R1, R2 and constant `ρ`, `C_L,max`, the exponent of `v_min` on `L` is `1/2`. -/
theorem vmin_exponent_rules_out {W S : ℝ → ℝ} {k₁ k₂ ρ Cmax : ℝ} (hW : CubeLaw W k₁) (hS : AreaLaw S k₂)
    (hρ : 0 < ρ) (hCmax : 0 < Cmax) {L₁ L₂ b : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hne : L₁ ≠ L₂)
    (hb : Real.log (vmin ρ Cmax (W L₂) (S L₂) / vmin ρ Cmax (W L₁) (S L₁)) = b * Real.log (L₂ / L₁))
    (h : b ≠ 1 / 2) : False := by
  have := vmin_log hW hS hρ hCmax h₁ h₂
  rw [hb] at this
  exact h (mul_right_cancel₀ (log_ratio_ne_zero h₁ h₂ hne) this)

/-- **C9, minimum speed.** Steady lift-supported flight at airspeed `v` with `v² < 2W/(ρ S C_L,max)` is ruled
out (`v < v_min`). -/
theorem vmin_rules_out {ρ S C Cmax W v : ℝ} (hρ : 0 < ρ) (hS : 0 < S) (hC : 0 < C) (hCmax : C ≤ Cmax)
    (hv : 0 ≤ v) (hlift : lift ρ v S C = W) (h : v ^ 2 < 2 * W / (ρ * S * Cmax)) : False := by
  have h1 := vmin_le hρ hS hC hCmax hv hlift
  have h2 : v < vmin ρ Cmax W S := by
    unfold vmin
    exact (Real.lt_sqrt hv).mpr h
  linarith

/-- **C9b, minimum-speed scaling.** Under R1, R2 and constant `ρ`, `C_L,max`, `v_min` scales as `√L`: a
committed `v_min` ratio `r ≥ 0` at length ratio `ℓ` with `r² ≠ ℓ` is ruled out. -/
theorem vmin_scaling_rules_out {W S : ℝ → ℝ} {k₁ k₂ ρ Cmax : ℝ} (hW : CubeLaw W k₁) (hS : AreaLaw S k₂)
    (hρ : 0 < ρ) (hCmax : 0 < Cmax) {L₁ L₂ r ℓ : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂)
    (hr : vmin ρ Cmax (W L₂) (S L₂) / vmin ρ Cmax (W L₁) (S L₁) = r) (hℓ : L₂ / L₁ = ℓ) (hr0 : 0 ≤ r)
    (hne : r ^ 2 ≠ ℓ) : False := by
  have := vmin_ratio hW hS hρ hCmax h₁ h₂
  rw [hr, hℓ] at this
  have hℓ0 : 0 ≤ ℓ := by rw [← hℓ]; positivity
  exact hne (by rw [this, Real.sq_sqrt hℓ0])

/-- **C10, power required.** Under R1, R2, constant `ρ`, `C_L,max` and `L/D`, flight at `v_min`: a committed
log-log exponent `b ≠ 7/2` of `P_req` on `L` is ruled out. -/
theorem powerRequired_exponent_rules_out {W S : ℝ → ℝ} {k₁ k₂ ρ Cmax LD : ℝ} (hW : CubeLaw W k₁)
    (hS : AreaLaw S k₂) (hρ : 0 < ρ) (hCmax : 0 < Cmax) (hLD : 0 < LD) {L₁ L₂ b : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂)
    (hne : L₁ ≠ L₂)
    (hb : Real.log (powerRequired (W L₂) (vmin ρ Cmax (W L₂) (S L₂)) LD /
      powerRequired (W L₁) (vmin ρ Cmax (W L₁) (S L₁)) LD) = b * Real.log (L₂ / L₁)) (h : b ≠ 7 / 2) : False := by
  have hlog := powerRequired_log hW hS hρ hCmax hLD h₁ h₂
  rw [hb] at hlog
  have hq : 0 < L₂ / L₁ := by positivity
  have hq1 : L₂ / L₁ ≠ 1 := by
    intro h0
    exact hne ((div_eq_one_iff_eq h₁.ne').mp h0).symm
  have hl : Real.log (L₂ / L₁) ≠ 0 := Real.log_ne_zero_of_pos_of_ne_one hq hq1
  exact h (mul_right_cancel₀ hl hlog)

/-- **C12, bending exponent, body-like load.** Under R9a the exponent of bending stress on `L` is `1`. -/
theorem bending_exponent_rules_out {F ℓ Z : ℝ → ℝ} {kF kℓ kZ : ℝ} (hF : CubeLaw F kF) (hℓ : LeverLaw ℓ kℓ)
    (hZ : SectionModulusLaw Z kZ) {L₁ L₂ b : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hne : L₁ ≠ L₂)
    (hb : Real.log (bendingStress F ℓ Z L₂ / bendingStress F ℓ Z L₁) = b * Real.log (L₂ / L₁)) (h : b ≠ 1) :
    False := by
  have := bendingStress_log_body hF hℓ hZ h₁ h₂
  rw [hb] at this
  exact h (mul_right_cancel₀ (log_ratio_ne_zero h₁ h₂ hne) this)

/-- **C12b, bending ratio, body-like load.** A committed bending-stress ratio `r ≠ ℓ` is ruled out. -/
theorem bending_ratio_rules_out {F ℓ Z : ℝ → ℝ} {kF kℓ kZ : ℝ} (hF : CubeLaw F kF) (hℓ : LeverLaw ℓ kℓ)
    (hZ : SectionModulusLaw Z kZ) {L₁ L₂ r q : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂)
    (hr : bendingStress F ℓ Z L₂ / bendingStress F ℓ Z L₁ = r) (hq : L₂ / L₁ = q) (hne : r ≠ q) : False := by
  have := bendingStress_ratio_body hF hℓ hZ h₁ h₂
  rw [hr, hq] at this
  exact hne this

/-- **C12c, bending exponent, sheet-like load.** Under R9b the exponent is `0`: a candidate with a constant-thickness
lamina that still commits to bending stress rising (or falling) with size is ruled out. -/
theorem bending_exponent_sheet_rules_out {F ℓ Z : ℝ → ℝ} {kF kℓ kZ : ℝ} (hF : AreaLaw F kF) (hℓ : LeverLaw ℓ kℓ)
    (hZ : SectionModulusLaw Z kZ) {L₁ L₂ b : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hne : L₁ ≠ L₂)
    (hb : Real.log (bendingStress F ℓ Z L₂ / bendingStress F ℓ Z L₁) = b * Real.log (L₂ / L₁)) (h : b ≠ 0) :
    False := by
  have := bendingStress_log_sheet hF hℓ hZ h₁ h₂
  rw [hb] at this
  exact h (mul_right_cancel₀ (log_ratio_ne_zero h₁ h₂ hne) this)

/-- **C13, allometric consistency.** If weight and lifting area are power laws with exponents `bW`, `bS`, the
wing-loading exponent is `bW - bS`: a committed triple with `bWS ≠ bW - bS` is ruled out. -/
theorem allometry_consistency_rules_out {W S : ℝ → ℝ} {aW bW aS bS bWS : ℝ} (hW : PowerLaw W aW bW)
    (hS : PowerLaw S aS bS) {L₁ L₂ : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂) (hne : L₁ ≠ L₂)
    (hb : Real.log ((W L₂ / S L₂) / (W L₁ / S L₁)) = bWS * Real.log (L₂ / L₁)) (h : bWS ≠ bW - bS) : False := by
  have := powerLaw_log (powerLaw_div hW hS) h₁ h₂
  rw [hb] at this
  exact h (mul_right_cancel₀ (log_ratio_ne_zero h₁ h₂ hne) this)

/-- **C14, aerobic sustained flight.** A claim of sustained (aerobic) flight at power `P_req = W v/(L/D)` with
`η E Q Ca < P_req` is ruled out. -/
theorem aerobic_flight_rules_out {W v LD P η E Q Ca Cv : ℝ} (hη : 0 ≤ η) (hE : 0 ≤ E) (hQ : 0 ≤ Q) (hCv : 0 ≤ Cv)
    (hsus : P ≤ aerobicPower η E Q Ca Cv) (hflight : powerRequired W v LD ≤ P)
    (h : η * E * Q * Ca < powerRequired W v LD) : False := by
  have := sustained_flight_requires hη hE hQ hCv hsus hflight
  linarith

/-- **C15, glide range.** A claimed steady unpowered glide of distance `x > h (L/D)_max / (1 - δ)` from
height `h` with drag reduced by a fraction `δ` near the surface (`δ = 0` away from it) is ruled out. -/
theorem glide_range_rules_out {W h D x LDmax loss Lift δ : ℝ} (hW : 0 < W) (hD : 0 < D) (hh : 0 ≤ h)
    (hδ0 : 0 ≤ δ) (hδ1 : δ < 1) (hlift : Lift = W) (hLD : Lift / D ≤ LDmax)
    (henergy : W * h = (1 - δ) * D * x + loss) (hloss : 0 ≤ loss) (hx : h * LDmax / (1 - δ) < x) : False := by
  have := glide_range_le_groundEffect hW hD hh hδ0 hδ1 hlift hLD henergy hloss
  linarith

/-- **C16, climb.** A claimed climb rate `c` above `(P_avail - P_req)/W` under the power balance is ruled out. -/
theorem climb_rules_out {W Pavail Preq c loss : ℝ} (hW : 0 < W) (hbal : Pavail = Preq + W * c + loss)
    (hloss : 0 ≤ loss) (h : climbRate W Pavail Preq < c) : False := by
  have := climbRate_le hW hbal hloss
  linarith

/-- **C11, Froude.** At equal Froude number speed scales as `√L`: a committed speed ratio `r ≥ 0` at length
ratio `ℓ` with `r² ≠ ℓ` is ruled out. -/
theorem froude_rules_out {Fr g : ℝ} (hFr : 0 < Fr) (hg : 0 < g) {L₁ L₂ r ℓ : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂)
    (hr : froudeSpeed Fr g L₂ / froudeSpeed Fr g L₁ = r) (hℓ : L₂ / L₁ = ℓ) (hr0 : 0 ≤ r) (hne : r ^ 2 ≠ ℓ) :
    False := by
  have := froude_ratio hFr hg h₁ h₂
  rw [hr, hℓ] at this
  have hℓ0 : 0 ≤ ℓ := by rw [← hℓ]; positivity
  exact hne (by rw [this, Real.sq_sqrt hℓ0])

end Delphi.Constraints
