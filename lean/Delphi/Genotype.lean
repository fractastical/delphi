/-
# Genotype-level checks: the genetic code, developmental ordering, pleiotropy closure, substitution time

Decidable checks the Design Studio's genetic edits need (hub direction A, 2026-10-31), each small and each a
statement about data or about a named model.

## What is proved

* **Genetic code.** `code : Codon → AminoAcid` is the standard code as a 64-case table; `hamming` counts
  differing positions; `minSubst a b` is the least number of nucleotide substitutions turning any codon of `a`
  into any codon of `b`, computed over the table so the kernel can evaluate it. `claimed_substitutions_rules_out`:
  a missense claim "`a` to `b` in `n` substitutions" with `n < minSubst a b` is impossible. Prior Lean work on the
  genetic code exists (arXiv 2610.36343, cited by the hub; not read by this thread), so no first is claimed here.
* **Developmental ordering.** A `develops_from` graph with a stage number per node is well-ordered when every
  derivative is staged strictly after its precursor; then it is acyclic (`Delphi.Blueprint.Graph` with the stage
  as level) and no part is staged before its precursor. The checker `devOrderedB` and its soundness
  `devOrdered_of_check`; a certificate for the fin subtree is generated by `lean/genotype/certify-dev.mjs`.
* **Pleiotropy closure.** An edit to a gene must change every node the map links the gene to:
  `closure_of_check` (list inclusion decided), `closure_violated`.
* **Substitution waiting time.** With `M` copies, mutation rate `μ` per copy per generation and fixation
  probability `u`, independent sequential fixations arrive at rate `M μ u` and `N` of them take `N/(M μ u)`
  generations in expectation (a definition); with `1/M ≤ u ≤ 1` this lies between `N/(M μ)` and `N/μ`, and equals
  `N/μ` for neutral mutations (Kimura). `too_little_time_rules_out`: an available time `T` below `N/(M μ)` is
  ruled out even if every mutant fixed.
* **Haldane's cost of selection**, carried as a NAMED HYPOTHESIS `HaldaneCost`: the number of substitutions by
  selection in `T` generations is at most `e T / c` for a reproductive excess `e` and a cost per substitution
  `c` (Haldane 1957, J. Genet. 55:511, took `c ≈ 30` and about one substitution per 300 generations). The
  inequality is proved from the hypothesis; the hypothesis itself is a contested model, not a law.

## What is assumed, not proved

The standard genetic code (the table is data; mitochondrial and variant codes differ); that stages compare by
their ZFIN stage-series order; that the map's links are the gene's full reach (an unstudied node is not
gene-free); independent sequential fixations with constant `M`, `μ`, `u`; Haldane's model.
-/
import Mathlib
import Delphi.Blueprint
import Delphi.Favored

namespace Delphi
namespace Genotype

/-! ### The standard genetic code -/

inductive Base | A | C | G | U
  deriving DecidableEq, Repr

inductive AminoAcid
  | Ala | Arg | Asn | Asp | Cys | Gln | Glu | Gly | His | Ile | Leu | Lys | Met | Phe | Pro | Ser | Thr | Trp | Tyr | Val | Stop
  deriving DecidableEq, Repr

open Base AminoAcid

abbrev Codon := Base × Base × Base

/-- The standard genetic code (RNA codons), 64 entries. -/
def code : Codon → AminoAcid
  | (U, U, U) => Phe | (U, U, C) => Phe | (U, U, A) => Leu | (U, U, G) => Leu
  | (U, C, _) => Ser
  | (U, A, U) => Tyr | (U, A, C) => Tyr | (U, A, A) => Stop | (U, A, G) => Stop
  | (U, G, U) => Cys | (U, G, C) => Cys | (U, G, A) => Stop | (U, G, G) => Trp
  | (C, U, _) => Leu
  | (C, C, _) => Pro
  | (C, A, U) => His | (C, A, C) => His | (C, A, A) => Gln | (C, A, G) => Gln
  | (C, G, _) => Arg
  | (A, U, U) => Ile | (A, U, C) => Ile | (A, U, A) => Ile | (A, U, G) => Met
  | (A, C, _) => Thr
  | (A, A, U) => Asn | (A, A, C) => Asn | (A, A, A) => Lys | (A, A, G) => Lys
  | (A, G, U) => Ser | (A, G, C) => Ser | (A, G, A) => Arg | (A, G, G) => Arg
  | (G, U, _) => Val
  | (G, C, _) => Ala
  | (G, A, U) => Asp | (G, A, C) => Asp | (G, A, A) => Glu | (G, A, G) => Glu
  | (G, G, _) => Gly

/-- Number of differing positions. -/
def hamming (c d : Codon) : ℕ :=
  (if c.1 = d.1 then 0 else 1) + (if c.2.1 = d.2.1 then 0 else 1) + (if c.2.2 = d.2.2 then 0 else 1)

def allBases : List Base := [A, C, G, U]

lemma mem_allBases (b : Base) : b ∈ allBases := by cases b <;> simp [allBases]

/-- All 64 codons. -/
def allCodons : List Codon :=
  allBases.flatMap fun a => allBases.flatMap fun b => allBases.map fun c => (a, b, c)

lemma mem_allCodons (c : Codon) : c ∈ allCodons := by
  obtain ⟨a, b, d⟩ := c
  simp only [allCodons, List.mem_flatMap, List.mem_map]
  exact ⟨a, mem_allBases a, b, mem_allBases b, d, mem_allBases d, rfl⟩

/-- Codons of an amino acid. -/
def codonsOf (a : AminoAcid) : List Codon := allCodons.filter fun c => code c = a

lemma mem_codonsOf {a : AminoAcid} {c : Codon} (hc : code c = a) : c ∈ codonsOf a := by
  unfold codonsOf
  rw [List.mem_filter]
  exact ⟨mem_allCodons c, by simp [hc]⟩

/-- Least number of substitutions from any codon of `a` to any codon of `b` (`4` if either has no codon). -/
def minSubst (a b : AminoAcid) : ℕ :=
  ((codonsOf a).flatMap fun c => (codonsOf b).map fun d => hamming c d).foldl min 4

lemma hamming_le_three (c d : Codon) : hamming c d ≤ 3 := by
  unfold hamming; split_ifs <;> omega

lemma foldl_min_le_init (l : List ℕ) (init : ℕ) : l.foldl min init ≤ init := by
  induction l generalizing init with
  | nil => simp
  | cons y ys ih => simp only [List.foldl_cons]; exact le_trans (ih _) (min_le_left _ _)

lemma foldl_min_le_of_mem {l : List ℕ} {x : ℕ} (h : x ∈ l) (init : ℕ) : l.foldl min init ≤ x := by
  induction l generalizing init with
  | nil => simp at h
  | cons y ys ih =>
    simp only [List.foldl_cons]
    rcases List.mem_cons.mp h with rfl | h'
    · exact le_trans (foldl_min_le_init ys _) (min_le_right _ _)
    · exact ih h' _

/-- `minSubst` is a lower bound on the distance between any two codons of the two amino acids. -/
theorem minSubst_le {a b : AminoAcid} {c d : Codon} (hc : code c = a) (hd : code d = b) :
    minSubst a b ≤ hamming c d := by
  unfold minSubst
  apply foldl_min_le_of_mem
  rw [List.mem_flatMap]
  exact ⟨c, mem_codonsOf hc, List.mem_map.mpr ⟨d, mem_codonsOf hd, rfl⟩⟩

/-- **A missense claim with too few substitutions is impossible.** -/
theorem claimed_substitutions_rules_out {a b : AminoAcid} {n : ℕ} (h : n < minSubst a b) :
    ¬ ∃ c d : Codon, code c = a ∧ code d = b ∧ hamming c d ≤ n := by
  rintro ⟨c, d, hc, hd, hn⟩
  have := minSubst_le hc hd
  omega

/-- Phe to Leu needs one substitution (e.g. UUU to UUA): the slc43a2a F326L of Daane et al. 2021 is one SNP away. -/
theorem phe_leu_one : minSubst Phe Leu = 1 := by decide +kernel

/-- Trp to Stop needs one; Met to Trp needs two: examples the table decides. -/
theorem trp_stop_one : minSubst Trp Stop = 1 := by decide +kernel
theorem met_trp_two : minSubst Met Trp = 2 := by decide +kernel

/-! ### Developmental ordering -/

open Blueprint in
/-- A `develops_from` graph is well-ordered when every derivative is staged strictly after its precursor
(`stage` is the level; edge `(derivative, precursor)`). Then it is acyclic. -/
theorem devOrdered_acyclic (g : Graph ℕ) (h : g.LevelsDown) : g.Acyclic := g.acyclic_of_levelsDown h

open Blueprint in
/-- The decidable check: every edge strictly down in stage, i.e. no part staged before its precursor. -/
def devOrderedB (g : Graph ℕ) : Bool := g.levelsDownB

open Blueprint in
theorem devOrdered_of_check (g : Graph ℕ) (h : devOrderedB g = true) :
    (∀ a b, g.Edge a b → g.level b < g.level a) ∧ g.Acyclic :=
  ⟨g.levelsDown_of_check h, g.acyclic_of_levelsDown (g.levelsDown_of_check h)⟩

/-! ### Pleiotropy closure -/

/-- Every node the map links to the gene is in the change set. -/
def closureB (mapped changed : List String) : Bool := mapped.all fun n => changed.contains n

theorem closure_of_check {mapped changed : List String} (h : closureB mapped changed = true) :
    ∀ n ∈ mapped, n ∈ changed := by
  intro n hn
  have := List.all_eq_true.mp h n hn
  simpa [List.contains_iff_mem] using this

/-- A change set that omits a mapped node violates closure. -/
theorem closure_violated {mapped changed : List String} {n : String} (hn : n ∈ mapped) (hc : n ∉ changed) :
    closureB mapped changed = false := by
  by_contra h
  have := closure_of_check (Bool.of_not_eq_false h) n hn
  exact hc this

/-! ### Substitution waiting time -/

/-- Expected generations for `N` sequential independent fixations at rate `M μ u` each (a definition). -/
noncomputable def expectedWaitingTime (N : ℝ) (M : ℕ) (μ u : ℝ) : ℝ := N / (substitutionRate M μ u)

theorem expectedWaitingTime_neutral (N : ℝ) (M : ℕ) (hM : 0 < M) (μ : ℝ) :
    expectedWaitingTime N M μ ((wrightFisher M hM).fixationProbability (oneCopy M hM)) = N / μ := by
  unfold expectedWaitingTime; rw [neutral_substitution_rate]

/-- With `1/M ≤ u ≤ 1`, the waiting time lies between `N/(M μ)` and `N/μ`. -/
theorem expectedWaitingTime_bounds (N : ℝ) (hN : 0 ≤ N) (M : ℕ) (hM : 0 < M) (μ : ℝ) (hμ : 0 < μ) {u : ℝ}
    (hu1 : 1 / (M : ℝ) ≤ u) (hu2 : u ≤ 1) :
    N / ((M : ℝ) * μ) ≤ expectedWaitingTime N M μ u ∧ expectedWaitingTime N M μ u ≤ N / μ := by
  unfold expectedWaitingTime substitutionRate
  have hMpos : (0 : ℝ) < M := by exact_mod_cast hM
  have hupos : 0 < u := lt_of_lt_of_le (by positivity) hu1
  constructor
  · apply div_le_div_of_nonneg_left hN (by positivity)
    calc (M : ℝ) * μ * u ≤ (M : ℝ) * μ * 1 := by apply mul_le_mul_of_nonneg_left hu2; positivity
      _ = (M : ℝ) * μ := by ring
  · apply div_le_div_of_nonneg_left hN (by positivity)
    calc μ = (M : ℝ) * μ * (1 / M) := by field_simp
      _ ≤ (M : ℝ) * μ * u := by apply mul_le_mul_of_nonneg_left hu1; positivity

/-- **Too little time.** An available time `T` below `N/(M μ)` cannot suffice even if every mutant fixed. -/
theorem too_little_time_rules_out {N T : ℝ} (hN : 0 ≤ N) (M : ℕ) (hM : 0 < M) (μ : ℝ) (hμ : 0 < μ) {u : ℝ}
    (hu1 : 1 / (M : ℝ) ≤ u) (hu2 : u ≤ 1) (hclaim : expectedWaitingTime N M μ u ≤ T)
    (h : T < N / ((M : ℝ) * μ)) : False := by
  have := (expectedWaitingTime_bounds N hN M hM μ hμ hu1 hu2).1
  linarith

/-- **Haldane's cost of selection, as a named hypothesis**: substitutions by selection over `T` generations
are at most `e T / c` (reproductive excess `e`, cost per substitution `c`). -/
def HaldaneCost (subs T e c : ℝ) : Prop := 0 < c ∧ 0 ≤ e ∧ subs ≤ e * T / c

/-- Under Haldane's hypothesis, `N` selected substitutions need at least `c N / e` generations. -/
theorem haldane_time_lower {N T e c : ℝ} (h : HaldaneCost N T e c) (he : 0 < e) : c * N / e ≤ T := by
  obtain ⟨hc, _, hs⟩ := h
  rw [div_le_iff₀ he]
  have := (le_div_iff₀ hc).mp hs
  linarith

theorem haldane_rules_out {N T e c : ℝ} (h : HaldaneCost N T e c) (he : 0 < e) (hT : T < c * N / e) : False := by
  have := haldane_time_lower h he; linarith

end Genotype
end Delphi
