/-
# Well-formedness of an anatomical blueprint graph

The organism thread's tool (`organism-design/blueprint.mjs`) emits, for a text description, a finite
directed graph of ontology terms: a body root, organ systems, organs, tissues and cell types, each
placed under a whole by a `part_of` statement that Ubergraph served on the retrieval date, after taxon
constraints (`never_in_taxon` on the term, a superclass or a whole; `in_taxon` on the term) removed
structures the ontology says the taxon cannot have. This module states what "well-formed" means for
such a graph and proves that a decidable checker implies it, so that each emitted blueprint can carry a
kernel-checked certificate (`lean/Delphi/Certificates/*.lean`, generated by `lean/blueprint/certify.mjs`).

## What the kernel checks (generic, over any node type `α` with decidable equality)

* `LevelsDown`: every `part_of` edge goes from a strictly deeper level to a shallower one.
* `acyclic_of_levelsDown`: hence the `part_of` relation has no cycle (no term is, transitively, part of
  itself): the transitive closure strictly decreases the level, so it is irreflexive.
* `transGen_trans`: the transitive closure of the stated edges is transitive (if `X part_of* Y` and
  `Y part_of* Z` then `X part_of* Z`), and `transGen_level_lt` shows it respects levels.
* `rooted_of`: if every edge's whole is a node and every node other than the root has a whole, then every
  node reaches the root through `part_of` edges (no orphans). The proof is a strong induction on level.
* `TaxonOk`: no pinned `never_in_taxon` statement reachable from a kept term names an ancestor of the
  blueprint's taxon, and every `in_taxon` or `stated_in_taxon` statement on a kept term names an ancestor.
* `wellFormed_of_check`: the Boolean checker `check` is sound for the conjunction of the above.
* The certificate for a concrete blueprint also fixes, by `decide`, that the node list has no duplicates
  and how many distinct terms sit at each level, which is the count the organism thread's label reports.

## What is assumed, not proved

* That Uberon and the Cell Ontology are right, and that Ubergraph served their `part_of`, `subClassOf`,
  `never_in_taxon` and `in_taxon` statements correctly and completely on the retrieval date. The graph and
  the taxon statements are data; the certificate pins their hashes and the queries that produced them.
* That the levels (body 0, organ system 1, organ 2, tissue 3, cell 4) are the right notion of depth.
  They are the tool's own classification; the theorems use only that edges strictly decrease the level.
* Nothing about any organism: the certificate says the emitted structure is internally coherent under
  its own stated rules. It does not say the fish is real, that the anatomy is correct or complete, or
  that any part of it was measured. It also says nothing about any transition between forms.
-/
import Mathlib

namespace Delphi
namespace Blueprint

/-- A blueprint graph: nodes, a root, a level for each node, and `part_of` edges `(part, whole)`. -/
structure Graph (α : Type) where
  nodes : List α
  root : α
  level : α → ℕ
  partOf : List (α × α)

variable {α : Type}

/-- `a` is stated to be part of `b`. -/
def Graph.Edge (g : Graph α) (a b : α) : Prop := (a, b) ∈ g.partOf

/-- `a part_of* b`: the transitive closure of the stated edges. -/
def Graph.PartOfStar (g : Graph α) : α → α → Prop := Relation.TransGen g.Edge

/-- Every stated edge goes strictly down in level (whole shallower than part). -/
def Graph.LevelsDown (g : Graph α) : Prop := ∀ a b, g.Edge a b → g.level b < g.level a

/-- No term is, transitively, part of itself. -/
def Graph.Acyclic (g : Graph α) : Prop := ∀ a, ¬ g.PartOfStar a a

/-- Every node is the root or reaches the root through `part_of` edges. -/
def Graph.Rooted (g : Graph α) : Prop := ∀ a ∈ g.nodes, a = g.root ∨ g.PartOfStar a g.root

/-- Every edge's part and whole are nodes of the graph. -/
def Graph.Closed (g : Graph α) : Prop := ∀ e ∈ g.partOf, e.1 ∈ g.nodes ∧ e.2 ∈ g.nodes

/-- The transitive closure is transitive: `X part_of* Y → Y part_of* Z → X part_of* Z`. -/
theorem Graph.transGen_trans (g : Graph α) {a b c : α} (h₁ : g.PartOfStar a b) (h₂ : g.PartOfStar b c) :
    g.PartOfStar a c :=
  Relation.TransGen.trans h₁ h₂

/-- A stated edge is in the closure. -/
theorem Graph.partOfStar_of_edge (g : Graph α) {a b : α} (h : g.Edge a b) : g.PartOfStar a b :=
  Relation.TransGen.single h

/-- Along the closure the level strictly decreases. -/
theorem Graph.transGen_level_lt (g : Graph α) (hL : g.LevelsDown) {a b : α} (h : g.PartOfStar a b) :
    g.level b < g.level a := by
  induction h with
  | single hab => exact hL _ _ hab
  | tail _ hbc ih => exact lt_trans (hL _ _ hbc) ih

/-- **Acyclicity.** If every edge goes strictly down in level, nothing is part of itself. -/
theorem Graph.acyclic_of_levelsDown (g : Graph α) (hL : g.LevelsDown) : g.Acyclic :=
  fun _ h => lt_irrefl _ (g.transGen_level_lt hL h)

/-- **No orphans.** If edges go strictly down, every edge's whole is a node, and every non-root node has
a whole, then every node reaches the root. Strong induction on the level. -/
theorem Graph.rooted_of (g : Graph α) (hL : g.LevelsDown) (hC : ∀ e ∈ g.partOf, e.2 ∈ g.nodes)
    (hP : ∀ a ∈ g.nodes, a ≠ g.root → ∃ b, g.Edge a b) : g.Rooted := by
  intro a ha
  induction' hk : g.level a using Nat.strong_induction_on with k ih generalizing a
  by_cases hr : a = g.root
  · exact Or.inl hr
  · obtain ⟨b, hb⟩ := hP a ha hr
    have hlt : g.level b < k := hk ▸ hL a b hb
    have hbn : b ∈ g.nodes := hC (a, b) hb
    rcases ih (g.level b) hlt b hbn rfl with h | h
    · subst h
      exact Or.inr (Relation.TransGen.single hb)
    · exact Or.inr (Relation.TransGen.head hb h)

/-! ### Taxon constraints, as pinned data -/

/-- Taxon statements pinned from the ontology for one blueprint. `ancestors` are the taxa that contain
the blueprint's taxon (itself included); `neverIn` holds `(kept term, forbidden taxon)` for every
`never_in_taxon` statement on the term, a superclass or a whole; `inTaxon` holds `in_taxon` statements on
kept terms; `stated` holds the `stated_in_taxon` evidence the blueprint file itself records. -/
structure TaxonData (α τ : Type) where
  ancestors : List τ
  neverIn : List (α × τ)
  inTaxon : List (α × τ)
  stated : List (α × τ)

variable {τ : Type}

/-- No kept term is excluded from the taxon, and every taxon the blueprint cites contains the taxon. -/
def TaxonData.Ok (D : TaxonData α τ) : Prop :=
  (∀ p ∈ D.neverIn, p.2 ∉ D.ancestors) ∧ (∀ p ∈ D.inTaxon, p.2 ∈ D.ancestors) ∧
    (∀ p ∈ D.stated, p.2 ∈ D.ancestors)

/-! ### The decidable checker and its soundness -/

variable [DecidableEq α] [DecidableEq τ]

def Graph.levelsDownB (g : Graph α) : Bool := g.partOf.all fun e => decide (g.level e.2 < g.level e.1)
def Graph.closedB (g : Graph α) : Bool := g.partOf.all fun e => decide (e.1 ∈ g.nodes) && decide (e.2 ∈ g.nodes)
def Graph.hasParentB (g : Graph α) (a : α) : Bool := g.partOf.any fun e => decide (e.1 = a)
def Graph.rootedB (g : Graph α) : Bool :=
  decide (g.root ∈ g.nodes) && g.nodes.all fun a => decide (a = g.root) || g.hasParentB a
def TaxonData.okB (D : TaxonData α τ) : Bool :=
  D.neverIn.all (fun p => decide (p.2 ∉ D.ancestors)) && D.inTaxon.all (fun p => decide (p.2 ∈ D.ancestors)) &&
    D.stated.all fun p => decide (p.2 ∈ D.ancestors)

/-- The whole check. -/
def check (g : Graph α) (D : TaxonData α τ) : Bool := g.levelsDownB && g.closedB && g.rootedB && D.okB

omit [DecidableEq α] in
theorem Graph.levelsDown_of_check (g : Graph α) (h : g.levelsDownB = true) : g.LevelsDown := by
  intro a b hab
  have := List.all_eq_true.mp h (a, b) hab
  simpa using this

theorem Graph.closed_of_check (g : Graph α) (h : g.closedB = true) : g.Closed := by
  intro e he
  have := List.all_eq_true.mp h e he
  simpa using this

theorem Graph.hasParent_of_check (g : Graph α) (a : α) (h : g.hasParentB a = true) : ∃ b, g.Edge a b := by
  obtain ⟨e, he, hea⟩ := List.any_eq_true.mp h
  refine ⟨e.2, ?_⟩
  have : e.1 = a := by simpa using hea
  show (a, e.2) ∈ g.partOf
  rw [← this]
  exact he

theorem Graph.rooted_of_check (g : Graph α) (hL : g.levelsDownB = true) (hC : g.closedB = true)
    (hR : g.rootedB = true) : g.Rooted := by
  have hr := Bool.and_eq_true_iff.mp hR
  refine g.rooted_of (g.levelsDown_of_check hL) (fun e he => (g.closed_of_check hC e he).2) ?_
  intro a ha hne
  have := List.all_eq_true.mp hr.2 a ha
  rcases Bool.or_eq_true_iff.mp this with h | h
  · exact absurd (by simpa using h) hne
  · exact g.hasParent_of_check a h

omit [DecidableEq α] in
theorem TaxonData.ok_of_check (D : TaxonData α τ) (h : D.okB = true) : D.Ok := by
  have h1 := Bool.and_eq_true_iff.mp h
  have h2 := Bool.and_eq_true_iff.mp h1.1
  refine ⟨fun p hp => ?_, fun p hp => ?_, fun p hp => ?_⟩
  · simpa using List.all_eq_true.mp h2.1 p hp
  · simpa using List.all_eq_true.mp h2.2 p hp
  · simpa using List.all_eq_true.mp h1.2 p hp

/-- Well-formed: edges strictly down, closed, acyclic, rooted, taxon constraints respected. -/
def WellFormed (g : Graph α) (D : TaxonData α τ) : Prop :=
  g.LevelsDown ∧ g.Closed ∧ g.Acyclic ∧ g.Rooted ∧ D.Ok

/-- **Soundness of the checker.** If `check g D` evaluates to `true`, the graph is well-formed. -/
theorem wellFormed_of_check (g : Graph α) (D : TaxonData α τ) (h : check g D = true) : WellFormed g D := by
  unfold check at h
  have h1 := Bool.and_eq_true_iff.mp h
  have h2 := Bool.and_eq_true_iff.mp h1.1
  have h3 := Bool.and_eq_true_iff.mp h2.1
  exact ⟨g.levelsDown_of_check h3.1, g.closed_of_check h3.2,
    g.acyclic_of_levelsDown (g.levelsDown_of_check h3.1), g.rooted_of_check h3.1 h3.2 h2.2,
    D.ok_of_check h1.2⟩

/-- Number of distinct nodes at a level (nodes are counted once each when `g.nodes.Nodup`). -/
def Graph.countLevel (g : Graph α) (k : ℕ) : ℕ := (g.nodes.filter fun a => g.level a = k).length

end Blueprint
end Delphi
