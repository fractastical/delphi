@prefix schema: <https://schema.org/> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/fisher-ftns> dct:description "Proof scope of the kernel-checked statement recorded as fisher-ftns: 2 statement(s) the Lean kernel checked and 3 assumption(s) stated in the module header and not proved. The source's claim (\"Fisher's fundamental theorem of natural selection (partial-change form)\", The Genetical Theory of Natural Selection 1930) is what the statement was written FROM, not what was checked." ;
    skos:scopeNote "Kernel-checked: For one locus with finitely many types, frequencies p (nonneg, summing to 1), fixed fitnesses w and mean fitness > 0: selection p_next = p w / wbar yields wbar_next - wbar = Var(w)/wbar exactly." ;
    skos:scopeNote "Kernel-checked: Corollary: mean fitness never decreases under fixed fitnesses." ;
    skos:scopeNote "Assumed, not proved: Haploid or clonal inheritance, so the variance in fitness IS the additive genetic variance; the diploid average-effect version is not formalised." ;
    skos:scopeNote "Assumed, not proved: Fitnesses constant within the step (partial change): no dominance, epistasis, frequency dependence or environmental change." ;
    skos:scopeNote "Assumed, not proved: Infinite population: deterministic frequencies, no drift, no mutation." ;
    rdfs:comment "The kernel-checked statements are theorems of the model; the assumptions are the model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it. The assumptions it rests on, written in the module header and never proved, are: Haploid or clonal inheritance, so the variance in fitness IS the additive genetic variance; the diploid average-effect version is not formalised; Fitnesses constant within the step (partial change): no dominance, epistasis, frequency dependence or environmental change; Infinite population: deterministic frequencies, no drift, no mutation. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the source is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Fisher.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Fisher.lean> , <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

