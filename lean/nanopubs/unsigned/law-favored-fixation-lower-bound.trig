@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/favored-fixation-lower-bound> a delphi:Concept, skos:Concept ;
    rdfs:label "Fixation is at least i/M when selection does not oppose the mutant (Lean 4, kernel-checked)" ;
    dct:description "In an absorbing chain on 0..M gene copies whose expected copy number never decreases (neutral, or selection for the mutant), including Wright-Fisher sampling with relative fitness 1+s for any s >= 0, a lineage of i copies is eventually fixed with probability at least i/M; so the expected number of substitutions over T generations is at least mu T and at most M mu T." ;
    dct:source "Proved in this project (lean/Delphi/Favored.lean) as an extension of the neutral case of Kimura (1962) to non-opposing selection; no paper states it in this form." ;
    skos:notation "E[X_{t+1} | X_t = i] >= i  =>  u(i) >= i/M ;  mu T <= M mu u T <= M mu T" ;
    skos:definition """/-- **Lower bound on fixation when selection does not oppose the mutant.** A lineage starting from `i` of `M` copies in a favored chain is eventually fixed with probability at least `i / M`. -/
theorem fixationProbability_ge (hM : 0 < M) (i : Fin (M + 1)) :
    ((i : ℕ) : ℝ) / M ≤ C.fixationProbability i"""^^delphi:lean4 ;
    schema:programmingLanguage "Lean 4" ;
    delphi:leanDeclaration "Delphi.FavoredChain" ;
    delphi:leanTheorem "Delphi.FavoredChain.fixationProbability_ge", "Delphi.FavoredChain.fixationProbability_le_one", "Delphi.wrightFisherSelection_fixation_one_ge", "Delphi.neutral_expectedSubstitutions", "Delphi.favored_expectedSubstitutions_ge", "Delphi.expectedSubstitutions_le", "Delphi.wrightFisherSelection_substitutions_bounds" ;
    delphi:leanVerified "true"^^xsd:boolean ;
    skos:scopeNote "A lower bound only. Neutral chains are favored chains, and for them the bound is attained, so no upper bound in terms of s follows from this module." ;
    rdfs:comment "Status: kernel-checked (Lean 4 accepted the module with zero sorry and standard axioms only). Not expert-validated. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it; strict neutrality, constant population size, Wright-Fisher reproduction and independent mutant fates (Kimura), fixed fitnesses and haploid inheritance (Fisher), equal fecundity and a 1:1 sex ratio (Maynard Smith) are assumptions written in the module header, not conclusions. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the paper is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/3617fb32/lean/Delphi/Favored.lean>, <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json>, <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/> .
  <https://w3id.org/delphi/resource/claim/favored-fixation-lower-bound> dct:conformsTo <https://w3id.org/delphi/resource/math-law/favored-fixation-lower-bound> ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/lean-kernel-check-favored-fixation-lower-bound> .
  <https://w3id.org/delphi/resource/evidence/lean-kernel-check-favored-fixation-lower-bound> a delphi:EvidenceItem ;
    rdfs:label "Lean 4 kernel accepted Delphi.FavoredChain.fixationProbability_ge with zero sorry and standard axioms, and rejected 3 deliberately broken variant(s)" ;
    dct:description "Build receipt. Lean (version 4.35.0, x86_64-w64-windows-gnu, commit eb6cafb7290e8bd5f2937522d8d804f58f02bafc, Release); toolchain leanprover/lean4:v4.35.0; Mathlib v4.35.0 (56a005855ea17e0b0958f73ec801ae140b0a1679). lake build exit 0 in 5.5 s with 0 errors; 0 sorry in lean/Delphi/Favored.lean (450 lines). #print axioms for Delphi.FavoredChain.fixationProbability_ge, Delphi.FavoredChain.fixationProbability_le_one, Delphi.wrightFisherSelection_fixation_one_ge, Delphi.neutral_expectedSubstitutions, Delphi.favored_expectedSubstitutions_ge, Delphi.expectedSubstitutions_le, Delphi.wrightFisherSelection_substitutions_bounds: Classical.choice, Quot.sound, propext only (Lean's standard axioms; no sorryAx). Mutation evidence (lean/mutate.mjs, 2026-10-31T21:00:09.361Z): 3 deliberate change(s) to the statement or the model were each rejected by the compiler: [favored-floor-strengthened] Statement changed to claim a favored lineage of i copies fixes with probability at least (i+1)/M instead of i/M. Not true (the neutral chain is favored and fixes with exactly i/M), so the proof must fail. Rejected with 3 error(s): favored-floor-strengthened.lean:233:2: error: linarith failed to find a contradiction [favored-budget-doubled] Statement changed to claim the expected substitutions over T generations are at least 2 mu T instead of mu T. Rejected with 2 error(s): favored-budget-doubled.lean:426:35: error: Application type mismatch: The argument [favored-drift-dropped] Model hypothesis removed: the chain no longer has to keep the expected copy number from falling (favored := True). Selection against the mutant is then allowed, so the lower bound i/M must fail. Rejected with 1 error(s): favored-drift-dropped.lean:107:66: error: Function expected at Controls: 12 of 12 unmodified modules accepted by the same command." ;
    dct:subject <https://w3id.org/delphi/resource/math-law/favored-fixation-lower-bound> ;
    rdfs:comment "This evidence item establishes that the stated theorem follows from the stated model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it; strict neutrality, constant population size, Wright-Fisher reproduction and independent mutant fates (Kimura), fixed fitnesses and haploid inheritance (Fisher), equal fecundity and a 1:1 sex ratio (Maynard Smith) are assumptions written in the module header, not conclusions. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the paper is a separate assessment record, and so far only one assessor provider has run." ;
    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json>, <https://github.com/fractastical/delphisci/blob/3617fb32/lean/mutations.json>, <https://github.com/fractastical/delphisci/blob/3617fb32/lean/Delphi/Audit.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/3617fb32/lean/Delphi/Favored.lean> , <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json> , <https://github.com/fractastical/delphisci/blob/3617fb32/lean/mutations.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

