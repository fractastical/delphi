sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/kimura-fixation-probability> dct:description "Proof scope of the kernel-checked statement recorded as kimura-fixation-probability: 1 statement(s) the Lean kernel checked and 1 assumption(s) stated in the module header and not proved. The source's claim (\"Kimura fixation probability of a mutant allele\", On the probability of fixation of mutant genes in a population 1962) is what the statement was written FROM, not what was checked." ;
    skos:scopeNote "Kernel-checked: Fixation probability i/M for any neutral absorbing chain, hence for the exact finite Wright-Fisher chain (Delphi.NeutralChain.fixedBy_tendsto)." ;
    skos:scopeNote "Assumed, not proved: Neutral case only (s = 0). Kimura 1962 with selection in the diffusion limit is not formalised." ;
    rdfs:comment "The kernel-checked statements are theorems of the model; the assumptions are the model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it. The assumptions it rests on, written in the module header and never proved, are: Neutral case only (s = 0). Kimura 1962 with selection in the diffusion limit is not formalised. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the source is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Kimura.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Kimura.lean> , <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

