sub:assertion {
  <https://w3id.org/delphi/resource/claim/kimura-substitution-rate> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/lean-faithfulness--kimura-substitution-rate--openai> .
  <https://w3id.org/delphi/resource/assessment/lean-faithfulness--kimura-substitution-rate--openai> a delphi:LLMClaimAssessment ;
    rdfs:label "gpt-5-2025-08-07 on the Lean statement of kimura-substitution-rate: faithful-with-narrower-scope" ;
    delphi:evaluatesHypothesis <https://w3id.org/delphi/resource/claim/kimura-substitution-rate> ;
    dct:subject <https://w3id.org/delphi/resource/concept/lean-faithfulness-0.1.0> ;
    delphi:assessmentType "lean-faithfulness/0.1.0" ;
    delphi:hasVerdict "faithful-with-narrower-scope" ;
    dct:date "2026-10-31"^^xsd:date ;
    dct:description "The theorem equates k = M·μ·u to μ with u the fixation probability from one copy, matching Kimura’s k = (number of new mutants per generation) × (fixation probability) and μ as mutation rate per copy. It explicitly assumes neutral Wright–Fisher evolution and uses the fixation probability of a single new mutant (u = 1/M), so independence of population size is captured by “for every M.” However, this is narrower than the law’s general neutral setting (it requires Wright–Fisher sampling and a specific neutral Markov chain) and the independence-of-mutations/steady-state assumptions are only implicit in the substitutionRate definition. The result itself (fixation probability equals initial frequency) is nontrivial, not a tautology of the definitions." ;
    rdfs:comment "Single-provider so far: this is 1 of the 2 assessor providers the project requires (claimsWithTwoProviders: 0 of 7 at build time). It is one model's blind opinion about a translation, not a consensus and not evidence about organisms. Verdict recorded exactly as the assessor returned it." ;
    prov:used <https://w3id.org/delphi/resource/math-law/kimura-substitution-rate> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-faithfulness-assessor-gpt-5-2025-08-07> .
  <https://w3id.org/delphi/resource/assessment/lean-faithfulness--kimura-substitution-rate--openai--same-quantities> a delphi:LLMClaimAssessment ;
    rdfs:label "Same quantities of the Lean statement of kimura-substitution-rate by gpt-5-2025-08-07: 1" ;
    dct:subject <https://w3id.org/delphi/resource/concept/lean-faithfulness-0.1.0-same-quantities> ;
    delphi:assessmentType "lean-faithfulness/0.1.0/same_quantities" ;
    delphi:hasScore "1"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/lean-faithfulness--kimura-substitution-rate--openai> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-faithfulness-assessor-gpt-5-2025-08-07> .
  <https://w3id.org/delphi/resource/claim/kimura-substitution-rate> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/lean-faithfulness--kimura-substitution-rate--openai--same-quantities> .
  <https://w3id.org/delphi/resource/assessment/lean-faithfulness--kimura-substitution-rate--openai--assumptions-match> a delphi:LLMClaimAssessment ;
    rdfs:label "Assumptions match of the Lean statement of kimura-substitution-rate by gpt-5-2025-08-07: 0.5" ;
