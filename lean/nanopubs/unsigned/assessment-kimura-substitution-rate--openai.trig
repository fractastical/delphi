    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-faithfulness-assessor-gpt-5-2025-08-07> .
  <https://w3id.org/delphi/resource/claim/kimura-substitution-rate> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/lean-faithfulness--kimura-substitution-rate--openai--assumptions-match> .
  <https://w3id.org/delphi/resource/assessment/lean-faithfulness--kimura-substitution-rate--openai--scope-stated> a delphi:LLMClaimAssessment ;
    rdfs:label "Scope stated of the Lean statement of kimura-substitution-rate by gpt-5-2025-08-07: 1" ;
    dct:subject <https://w3id.org/delphi/resource/concept/lean-faithfulness-0.1.0-scope-stated> ;
    delphi:assessmentType "lean-faithfulness/0.1.0/scope_stated" ;
    delphi:hasScore "1"^^xsd:double ;
