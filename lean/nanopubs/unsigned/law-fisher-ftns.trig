sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/fisher-ftns> a delphi:Concept, skos:Concept ;
    rdfs:label "Kernel-checked Lean 4 statement about a model: For one haploid or clonal locus with fixed fitnesses, one round of selection raises mean fitness by exactly the variance in fitness divided by the mean fitness." ;
    dct:description "For one haploid or clonal locus with fixed fitnesses, one round of selection raises mean fitness by exactly the variance in fitness divided by the mean fitness." ;
    dct:source "The Genetical Theory of Natural Selection (1930)" ;
    skos:notation "\\Delta_{NS}\\bar{w} = V_A(w)/\\bar{w} (discrete generations); \\left.\\frac{d\\bar{m}}{dt}\\right|_{NS} = V_A(m) for Malthusian fitness m" ;
    skos:definition """/-- **Fisher's fundamental theorem of natural selection** (haploid locus, partial change). The change in mean fitness over one generation of selection, with fitnesses held fixed, equals the variance in fitness divided by the mean fitness. -/
theorem fisher_fundamental_theorem {p w : ι → ℝ} (hp : IsFreq p)
    (hmean : 0 < meanFitness p w) :
    meanFitness (select p w) w - meanFitness p w = variance p w / meanFitness p w"""^^delphi:lean4 ;
    schema:programmingLanguage "Lean 4" ;
    delphi:leanDeclaration "Delphi.meanFitness" ;
    delphi:leanTheorem "Delphi.fisher_fundamental_theorem", "Delphi.fisher_fundamental_theorem'", "Delphi.mean_fitness_nondecreasing" ;
    delphi:leanVerified "true"^^xsd:boolean ;
    skos:scopeNote "One haploid or clonal locus with finitely many types, fitnesses held fixed (partial change). In that population the variance in fitness is the additive genetic variance. The diploid average-effect version is not formalised." ;
    skos:note "The claim as the source states it, which is NOT what the kernel checked: \"Fisher's fundamental theorem of natural selection (partial-change form)\" (The Genetical Theory of Natural Selection, 1930). What was checked is the statement in dct:description, which is about a model." ;

    rdfs:comment "Status: kernel-checked (Lean 4 accepted the module with zero sorry and standard axioms only). Not expert-validated. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it. The assumptions it rests on, written in the module header and never proved, are: Haploid or clonal inheritance, so the variance in fitness IS the additive genetic variance; the diploid average-effect version is not formalised; Fitnesses constant within the step (partial change): no dominance, epistasis, frequency dependence or environmental change; Infinite population: deterministic frequencies, no drift, no mutation. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the source is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Fisher.lean>, <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json>, <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/> .
  <https://w3id.org/delphi/resource/claim/fisher-ftns> dct:conformsTo <https://w3id.org/delphi/resource/math-law/fisher-ftns> ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/lean-kernel-check-fisher-ftns> .
  <https://w3id.org/delphi/resource/evidence/lean-kernel-check-fisher-ftns> a delphi:EvidenceItem ;
    rdfs:label "Lean 4 kernel accepted Delphi.fisher_fundamental_theorem with zero sorry and standard axioms; it also rejected 2 deliberately broken variant(s) of this statement or its model" ;
    dct:description "Build receipt. Lean (version 4.35.0, x86_64-w64-windows-gnu, commit eb6cafb7290e8bd5f2937522d8d804f58f02bafc, Release); toolchain leanprover/lean4:v4.35.0; Mathlib v4.35.0 (56a005855ea17e0b0958f73ec801ae140b0a1679). lake build exit 0 in 5.3 s with 0 errors; 0 sorry in lean/Delphi/Fisher.lean (128 lines). #print axioms for Delphi.fisher_fundamental_theorem, Delphi.fisher_fundamental_theorem', Delphi.mean_fitness_nondecreasing: Classical.choice, Quot.sound, propext only (Lean's standard axioms; no sorryAx). Mutation evidence (lean/mutate.mjs, 2026-10-31T22:57:06.367Z): 2 deliberate change(s) to this statement or its model were each rejected by the compiler: [constraints-fisher-sign-flipped] Lemma statement changed to rule out a RISE in mean fitness (0 < b) instead of a fall; the law says mean fitness never decreases, so this must fail. Rejected with 1 error(s): Constraints.lean:111:2: error: linarith failed to find a contradiction [fisher-no-division] Statement changed to claim the change in mean fitness equals the variance itself, not the variance divided by mean fitness. Rejected with 3 error(s): Fisher.lean:100:67: error: unsolved goals Controls: 17 of 17 unmodified modules accepted by the same command." ;
    dct:subject <https://w3id.org/delphi/resource/math-law/fisher-ftns> ;
    rdfs:comment "This evidence item establishes that the stated theorem follows from the stated model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it. The assumptions it rests on, written in the module header and never proved, are: Haploid or clonal inheritance, so the variance in fitness IS the additive genetic variance; the diploid average-effect version is not formalised; Fitnesses constant within the step (partial change): no dominance, epistasis, frequency dependence or environmental change; Infinite population: deterministic frequencies, no drift, no mutation. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the source is a separate assessment record, and so far only one assessor provider has run." ;
    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json>, <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/mutations.json>, <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Audit.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Fisher.lean> , <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json> , <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/mutations.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

