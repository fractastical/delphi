@prefix schema: <https://schema.org/> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/scaling-strength-law> dct:description "Proof scope of Strength scales as L^2: the missing half of Galileo's square-cube argument (R7): 3 statement(s) the Lean kernel checked and 3 assumption(s) stated in the module header and not proved." ;
    skos:scopeNote "Kernel-checked: F_break = σ A: with AreaLaw A and σ > 0, F_break(L2)/F_break(L1) = (L2/L1)^2 (breakLoad_ratio)." ;
    skos:scopeNote "Kernel-checked: With CubeLaw W: F_break/W = σ k3/(k1 L) (safetyFactor_eq); the safety factor of the scaled body is the reference one divided by the length ratio (safetyFactor_scaled); stress W/A scales as L2/L1 (stress_ratio)." ;
    skos:scopeNote "Kernel-checked: Above L_max = σ k3/(k1 n) the member cannot carry n body weights (cannot_carry)." ;
    skos:scopeNote "Assumed, not proved: Axial loading (bending has the same L^2 dependence with a different constant; not formalised)." ;
    skos:scopeNote "Assumed, not proved: Isometric load-bearing sections and the same material (constant σ): real animals thicken bones with size." ;
    skos:scopeNote "Assumed, not proved: Nothing about any real giant: the checker rules only on a candidate that commits to isometry, the same material and a safety factor." ;
    rdfs:comment "The kernel-checked statements are theorems of the model; the assumptions are the model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it; strict neutrality, constant population size, Wright-Fisher reproduction and independent mutant fates (Kimura), fixed fitnesses and haploid inheritance (Fisher), equal fecundity and a 1:1 sex ratio (Maynard Smith) are assumptions written in the module header, not conclusions. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the paper is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/3617fb32/lean/Delphi/Scaling.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/3617fb32/lean/Delphi/Scaling.lean> , <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

