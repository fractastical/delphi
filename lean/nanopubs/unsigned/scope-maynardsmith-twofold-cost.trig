sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/maynardsmith-twofold-cost> dct:description "Proof scope of Twofold cost of sex: 2 statement(s) the Lean kernel checked and 3 assumption(s) stated in the module header and not proved." ;
    skos:scopeNote "Kernel-checked: For 0 < q < 1 and fecundity f > 0 the odds of asexual to sexual females satisfy odds(q_next) = 2 odds(q), and f cancels." ;
    skos:scopeNote "Kernel-checked: Iterated n generations the odds are 2^n times the initial odds." ;
    skos:scopeNote "Assumed, not proved: Anisogamy: males contribute nothing to offspring number or survival." ;
    skos:scopeNote "Assumed, not proved: Equal fecundity and viability of sexual and asexual females and of their daughters." ;
    skos:scopeNote "Assumed, not proved: Primary sex ratio exactly 1:1 in sexual broods; discrete non-overlapping generations; infinite population (deterministic fractions)." ;
    rdfs:comment "The kernel-checked statements are theorems of the model; the assumptions are the model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it; strict neutrality, constant population size, Wright-Fisher reproduction and independent mutant fates (Kimura), fixed fitnesses and haploid inheritance (Fisher), equal fecundity and a 1:1 sex ratio (Maynard Smith) are assumptions written in the module header, not conclusions. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the paper is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/main/lean/Delphi/MaynardSmith.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/main/lean/Delphi/MaynardSmith.lean> , <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

