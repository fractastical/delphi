sub:assertion {
  <https://w3id.org/delphi/resource/claim/fisher-ftns> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/lean-faithfulness--fisher-ftns--openai> .
  <https://w3id.org/delphi/resource/assessment/lean-faithfulness--fisher-ftns--openai> a delphi:LLMClaimAssessment ;
    rdfs:label "gpt-5-2025-08-07 on the Lean statement of fisher-ftns: faithful-with-narrower-scope" ;
    delphi:evaluatesHypothesis <https://w3id.org/delphi/resource/claim/fisher-ftns> ;
    dct:subject <https://w3id.org/delphi/resource/concept/lean-faithfulness-0.1.0> ;
    delphi:assessmentType "lean-faithfulness/0.1.0" ;
    delphi:hasVerdict "faithful-with-narrower-scope" ;
    dct:date "2026-10-31"^^xsd:date ;
    dct:description "The Lean definitions match the quantities in the law: meanFitness is w̄, select encodes one generation of selection with fixed fitnesses (the partial-change setting), and variance is the weighted variance in fitness which, for a haploid locus, equals the additive genetic variance. The theorem concludes Δ_NS w̄ = Var(w)/w̄, the discrete-generation form of Fisher’s theorem. The scope is explicitly narrower (haploid locus) and clearly stated in the docstring. There is a mild extra technical assumption (0 < meanFitness p w) for division, which is standard but not stated in the biological claim, hence a slight deduction on assumptions_match." ;
    rdfs:comment "Single-provider so far: this is 1 of the 2 assessor providers the project requires (claimsWithTwoProviders: 0 of 13 at build time). It is one model's blind opinion about a translation, not a consensus and not evidence about organisms. Verdict recorded exactly as the assessor returned it." ;
    prov:used <https://w3id.org/delphi/resource/math-law/fisher-ftns> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-faithfulness-assessor-gpt-5-2025-08-07> .
  <https://w3id.org/delphi/resource/assessment/lean-faithfulness--fisher-ftns--openai--same-quantities> a delphi:LLMClaimAssessment ;
    rdfs:label "Same quantities of the Lean statement of fisher-ftns by gpt-5-2025-08-07: 1" ;
    dct:subject <https://w3id.org/delphi/resource/concept/lean-faithfulness-0.1.0-same-quantities> ;
    delphi:assessmentType "lean-faithfulness/0.1.0/same_quantities" ;
    delphi:hasScore "1"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/lean-faithfulness--fisher-ftns--openai> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-faithfulness-assessor-gpt-5-2025-08-07> .
  <https://w3id.org/delphi/resource/claim/fisher-ftns> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/lean-faithfulness--fisher-ftns--openai--same-quantities> .
  <https://w3id.org/delphi/resource/assessment/lean-faithfulness--fisher-ftns--openai--assumptions-match> a delphi:LLMClaimAssessment ;
    rdfs:label "Assumptions match of the Lean statement of fisher-ftns by gpt-5-2025-08-07: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/lean-faithfulness-0.1.0-assumptions-match> ;
    delphi:assessmentType "lean-faithfulness/0.1.0/assumptions_match" ;
