sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/genotype-substitution-time> dct:description "Proof scope of the kernel-checked statement recorded as genotype-substitution-time: 2 statement(s) the Lean kernel checked and 3 assumption(s) stated in the module header and not proved." ;
    skos:scopeNote "Kernel-checked: That the expected time for N substitutions at rate M mu u is N/(M mu u), and that for 1/M <= u <= 1 it lies between N/(M mu) and N/mu, with equality at N/mu for the neutral u = 1/M." ;
    skos:scopeNote "Kernel-checked: That an available time below N/(M mu) contradicts the model even with every mutant fixing." ;
    skos:scopeNote "Assumed, not proved: Independent sequential fixations at Kimura's definition rate with constant M, mu and u: no linkage, no standing variation, no recombination of partial solutions." ;
    skos:scopeNote "Assumed, not proved: That the number of required substitutions is given. It is not defined for any wing claim here, which is why this bound eliminates nothing about the flying fish." ;
    skos:scopeNote "Assumed, not proved: Nothing about whether the required substitutions exist, are favoured, or produce the trait." ;
    rdfs:comment "The kernel-checked statements are theorems of the model; the assumptions are the model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it. The assumptions it rests on, written in the module header and never proved, are: Independent sequential fixations at Kimura's definition rate with constant M, mu and u: no linkage, no standing variation, no recombination of partial solutions; That the number of required substitutions is given. It is not defined for any wing claim here, which is why this bound eliminates nothing about the flying fish; Nothing about whether the required substitutions exist, are favoured, or produce the trait. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the source is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Genotype.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Genotype.lean> , <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

