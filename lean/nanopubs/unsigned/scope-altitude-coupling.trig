sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/altitude-coupling> dct:description "Proof scope of the kernel-checked statement recorded as altitude-coupling: 4 statement(s) the Lean kernel checked and 4 assumption(s) stated in the module header and not proved." ;
    skos:scopeNote "Kernel-checked: That the minimum speed and the power required at it are nondecreasing in height, given only that air density falls with height." ;
    skos:scopeNote "Kernel-checked: That the aerobic supply is nonincreasing in height, given only that oxygen partial pressure falls with height and arterial content is nondecreasing in it." ;
    skos:scopeNote "Kernel-checked: That the feasible heights are downward closed, that infeasibility propagates upward (a ceiling in that sense), and that infeasibility at the ground forces infeasibility everywhere." ;
    skos:scopeNote "Kernel-checked: That a larger lifting area lowers the power required at a fixed height." ;
    skos:scopeNote "Assumed, not proved: A monotone atmosphere: both density and oxygen partial pressure fall with height. No profile, no numbers; the candidates' profile is the physics thread's NASA Glenn fit." ;
    skos:scopeNote "Assumed, not proved: Arterial content nondecreasing in partial pressure (a Hill curve is, but the Hill equation, the Bohr shift and the Root effect are not formalised)." ;
    skos:scopeNote "Assumed, not proved: Everything else held fixed with height: the animal makes no compensation (haematocrit, ventilation, cardiac output), and temperature, humidity and wind are outside the model." ;
    skos:scopeNote "Assumed, not proved: The size of the effect is NOT proved: it is gentle, and the binding constraint for the real fish is the aerobic ceiling at sea level." ;
    rdfs:comment "The kernel-checked statements are theorems of the model; the assumptions are the model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it. The assumptions it rests on, written in the module header and never proved, are: A monotone atmosphere: both density and oxygen partial pressure fall with height. No profile, no numbers; the candidates' profile is the physics thread's NASA Glenn fit; Arterial content nondecreasing in partial pressure (a Hill curve is, but the Hill equation, the Bohr shift and the Root effect are not formalised); Everything else held fixed with height: the animal makes no compensation (haematocrit, ventilation, cardiac output), and temperature, humidity and wind are outside the model; The size of the effect is NOT proved: it is gentle, and the binding constraint for the real fish is the aerobic ceiling at sea level. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the source is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Altitude.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/4ebb56add61de66744fe8b957ecd7c0bcecc8083/lean/Delphi/Altitude.lean> , <https://delphibio.org/t/lean/lean.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

