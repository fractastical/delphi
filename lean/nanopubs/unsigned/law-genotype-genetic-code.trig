@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/math-law/genotype-genetic-code> a delphi:Concept, skos:Concept ;
    rdfs:label "A claimed amino-acid change is impossible below the code distance (Lean 4, kernel-checked)" ;
    dct:description "In the standard genetic code, turning one amino acid into another needs at least a fixed number of nucleotide substitutions, computed over the 64-codon table; a claim of fewer is impossible. Phenylalanine to leucine takes one, tryptophan to a stop codon one, methionine to tryptophan two." ;
    dct:source "Proved in this project (lean/Delphi/Favored.lean) as an extension of the neutral case of Kimura (1962) to non-opposing selection; no paper states it in this form." ;
    skos:notation "n < minSubst a b  =>  not exists codons c d, code c = a and code d = b and hamming c d <= n" ;
    skos:definition """/-- `minSubst` is a lower bound on the distance between any two codons of the two amino acids. -/
theorem minSubst_le {a b : AminoAcid} {c d : Codon} (hc : code c = a) (hd : code d = b) :
    minSubst a b ≤ hamming c d"""^^delphi:lean4 ;
    schema:programmingLanguage "Lean 4" ;
    delphi:leanDeclaration "Delphi.Genotype.minSubst" ;
    delphi:leanTheorem "Delphi.Genotype.minSubst_le", "Delphi.Genotype.claimed_substitutions_rules_out", "Delphi.Genotype.phe_leu_one", "Delphi.Genotype.trp_stop_one", "Delphi.Genotype.met_trp_two" ;
    delphi:leanVerified "true"^^xsd:boolean ;
    skos:scopeNote "The code table is data, not a theorem: mitochondrial and variant codes differ, and selenocysteine and RNA editing are outside it. Reachability in the code is not evidence that a substitution occurred. Prior Lean work formalising the genetic code exists independently (arXiv doi 10.48550/arxiv.2610.36343, cited by the hub and not used here), so no first is claimed." ;
    rdfs:comment "Status: kernel-checked (Lean 4 accepted the module with zero sorry and standard axioms only). Not expert-validated. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it; strict neutrality, constant population size, Wright-Fisher reproduction and independent mutant fates (Kimura), fixed fitnesses and haploid inheritance (Fisher), equal fecundity and a 1:1 sex ratio (Maynard Smith) are assumptions written in the module header, not conclusions. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the paper is a separate assessment record, and so far only one assessor provider has run." ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/3617fb32/lean/Delphi/Genotype.lean>, <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json>, <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/> .
  <https://w3id.org/delphi/resource/claim/genotype-genetic-code> dct:conformsTo <https://w3id.org/delphi/resource/math-law/genotype-genetic-code> ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/lean-kernel-check-genotype-genetic-code> .
  <https://w3id.org/delphi/resource/evidence/lean-kernel-check-genotype-genetic-code> a delphi:EvidenceItem ;
    rdfs:label "Lean 4 kernel accepted Delphi.Genotype.minSubst_le with zero sorry and standard axioms, and rejected 2 deliberately broken variant(s)" ;
    dct:description "Build receipt. Lean (version 4.35.0, x86_64-w64-windows-gnu, commit eb6cafb7290e8bd5f2937522d8d804f58f02bafc, Release); toolchain leanprover/lean4:v4.35.0; Mathlib v4.35.0 (56a005855ea17e0b0958f73ec801ae140b0a1679). lake build exit 0 in 23.2 s with 0 errors; 0 sorry in lean/Delphi/Genotype.lean (224 lines). #print axioms for Delphi.Genotype.minSubst_le, Delphi.Genotype.claimed_substitutions_rules_out, Delphi.Genotype.phe_leu_one, Delphi.Genotype.trp_stop_one, Delphi.Genotype.met_trp_two: Quot.sound, propext only (Lean's standard axioms; no sorryAx). Mutation evidence (lean/mutate.mjs, 2026-10-31T21:58:20.213Z): 2 deliberate change(s) to the statement or the model were each rejected by the compiler: [genetic-code-distance-reversed] Statement reversed: the code distance claimed to be at least the Hamming distance of any codon pair instead of at most it. False for any pair further apart than the nearest, so the proof must fail. Rejected with 2 error(s): Genotype.lean:125:2: error: Tactic `apply` failed: could not unify the conclusion of `@foldl_min_le_of_mem` [genetic-code-distance-wrong] Data claim changed: Phe to Leu said to need 2 substitutions when the table gives 1 (UUU to UUA). The kernel evaluates minSubst on the code table, so it must reject it. Rejected with 1 error(s): Genotype.lean:137:49: error: Tactic `decide` proved that the proposition Controls: 16 of 16 unmodified modules accepted by the same command." ;
    dct:subject <https://w3id.org/delphi/resource/math-law/genotype-genetic-code> ;
    rdfs:comment "This evidence item establishes that the stated theorem follows from the stated model. Does not establish: anything about organisms. The theorem is exact inside the stated model and silent outside it; strict neutrality, constant population size, Wright-Fisher reproduction and independent mutant fates (Kimura), fixed fitnesses and haploid inheritance (Fisher), equal fecundity and a 1:1 sex ratio (Maynard Smith) are assumptions written in the module header, not conclusions. Kernel-checked is not expert-validated: no human expert has validated these statements. Whether the Lean statement faithfully renders the paper is a separate assessment record, and so far only one assessor provider has run." ;
    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json>, <https://github.com/fractastical/delphisci/blob/3617fb32/lean/mutations.json>, <https://github.com/fractastical/delphisci/blob/3617fb32/lean/Delphi/Audit.lean> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> ;
    prov:wasDerivedFrom <https://github.com/fractastical/delphisci/blob/3617fb32/lean/Delphi/Genotype.lean> , <https://delphi-mission-control.ashenoy000.workers.dev/t/lean/lean.json> , <https://github.com/fractastical/delphisci/blob/3617fb32/lean/mutations.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-lean-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci lean thread (Claude Fable 5.1 writing the Lean modules and this builder; the Lean kernel, not the model, checked the proofs)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

