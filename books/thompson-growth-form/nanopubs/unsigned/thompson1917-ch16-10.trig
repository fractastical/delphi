    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-10> a delphi:Claim ;
    rdfs:label "Height of vertebral spines is proportional to the local bending moment" ;
    dct:description "In the vertebral girder, ligaments form the upper tension member, vertebral bodies the lower compression member and the spines the web, and the height of the vertebral spines at each point along the back is proportional to the bending moment at that point." ;
    skos:notation "height of vertebral spine h(x) \\propto bending moment M(x)" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVI, “On Form and Mechanical Efficiency”; topic “Vertebral spines and bending moments”. Scope: vertebral columns of quadrupedal and bipedal vertebrates" ;
    dct:type "mathematical-law" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "secondly we observe that the depth of the web, or distance apart of the principal members,—that is to say the height of the vertebral spines,—must be proportional to the bending-moment at each point along the length of the girder." ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=23185,23189> .

