sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-13> a delphi:Claim ;
    rdfs:label "Form of small organisms is set by surface tension, not gravity, favouring spheres" ;
    dct:description "The form of all small organisms is largely independent of gravity and mainly due to surface tension, acting either now or at an earlier stage before the form was made rigid, so small organisms tend strongly toward spherical and other simple surface-tension forms that do not occur in the external form of large animals." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter II, “On Magnitude”; topic “Surface tension rules small organisms”. Scope: small organisms and individual cells versus large animals" ;
    dct:type "mechanism" .
}

