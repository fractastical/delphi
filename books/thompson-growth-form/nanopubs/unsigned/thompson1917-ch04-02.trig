    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-02> a delphi:Claim ;
    rdfs:label "Mitotic figures require a polarised force like magnetism, not mechanical traction" ;
    dct:description "The spindle and asters of dividing cells are lines of force of a bipolar field made visible by more permeable particles, like iron filings between magnet poles, and they cannot be explained by mere mechanical traction on a protoplasmic web but require some polarised and polarising force analogous to magnetism or electricity." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter IV, “On the Internal Form and Structure of the Cell”; topic “Spindle and asters as lines of force”. Scope: caryokinetic (mitotic) division of animal and plant cells" ;
    dct:type "mechanism" .
}

