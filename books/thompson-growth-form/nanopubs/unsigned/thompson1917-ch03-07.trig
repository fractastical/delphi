sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-07> a delphi:Claim ;
    rdfs:label "Weight tends to vary as the cube of linear dimensions during growth" ;
    dct:description "Whatever the law of increase in a linear dimension, volume and therefore weight tend to vary as the cube of linear dimensions, which mainly (though not wholly) explains why the human weight curve differs in shape from the stature curve." ;
    skos:notation "W \\propto L^3 whatever the law of growth L(t)" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Rate of growth in man”. Scope: growing humans (and organisms generally)" ;
    dct:type "mathematical-law" .
}

