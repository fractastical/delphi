<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-22--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-22: partially-resolvable, resolvability 0.52";
    dc:description "Competing mechanistic models can be formulated and tested in systems with repeated thermal exposure and stress measurements. Existing public datasets are fragmented and usually resolve only selected organisms or proxy damage variables, limiting causal discrimination.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use time-resolved growth and damage or survival markers across temperatures to fit a model combining low-temperature kinetic acceleration with cumulative high-temperature injury, and compare it against a primary optimum-response model. Superior out-of-sample fit and temporal accumulation of damage would support the proposed resultant mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Acclimation, enzyme kinetics and resource limitation produce similar optimum curves.", "Growth and cumulative damage are rarely measured together.", "The proposed mechanism spans diverse processes and taxa.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-22--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-22--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.523"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-22--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "Public thermal-performance experiments for selected plants and animals.";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-22--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioStudies";
    dc:description "Public study datasets that may pair growth responses with molecular or physiological stress measurements.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biostudies/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-22--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-22 by GPT-5.6 Sol: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
