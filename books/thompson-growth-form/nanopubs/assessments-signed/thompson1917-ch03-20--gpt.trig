    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-20--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-20: partially-resolvable, resolvability 0.65";
    dc:description "The optimum and group contrast are directly measurable, but no single open resource appears to contain standardized full response curves for the stated species scope. Existing public studies permit a subset test after harmonization.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For each species, fit root or shoot elongation across experimental temperatures and estimate the temperature of maximum growth, then compare temperate plants with maize, melon and other warm-climate plants. Broad dispersion among temperate optima or no warmer-climate shift would refute the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Optima depend on developmental stage, organ and acclimation.", "TRY does not directly provide complete temperature-response curves for all species.", "Temperature-response experiments are scattered and use different endpoints.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-20--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-20--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.648"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-20--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TRY Plant Trait Database";
    dc:description "Plant trait data that can help identify species and growth-related traits for comparative synthesis.";
    prov:wasDerivedFrom <https://www.try-db.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-20--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Environmental Data Initiative";
    dc:description "Public ecological datasets that include plant growth under environmental gradients in selected studies.";
    prov:wasDerivedFrom <https://edirepository.org/>.
