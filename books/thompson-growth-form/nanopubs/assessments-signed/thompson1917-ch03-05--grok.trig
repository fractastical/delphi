    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of thompson1917-ch03-05 by Grok 4.7: 0.85";
