sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch03-05: resolvable-now, resolvability 0.91";
    dc:description "National examinations and international growth standards record stature by age in very large samples, and velocity is obtained from them by ordinary smoothing. The four-phase pattern is specific enough to fail if the adolescent quickening is absent. Population differences in timing are a real caveat, but they do not prevent a direct confirmation or refutation of the stated sequence.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Plot stature velocity against age from birth to adult height. The claim is confirmed by high infantile velocity, a lower and nearly steady childhood velocity, a distinct acceleration in the early teens, and a decline to zero at adult height. A single smooth peak, or no adolescent acceleration, would refute that phasing.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Populations differ in the age of the adolescent peak, so one universal calendar age is too strict.", "The original description was drawn largely from boys.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-05--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.91"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: WHO Child Growth Standards";
    dc:description "Age-specific stature from birth through childhood, from which velocity phases can be estimated";
    prov:wasDerivedFrom <https://www.who.int/tools/child-growth-standards>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NHANES";
    dc:description "Open measured stature by age from infancy through adulthood for the adolescent acceleration and the final arrest";
    prov:wasDerivedFrom <https://wwwn.cdc.gov/nchs/nhanes/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-05 by Grok 4.7: 0.95";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.95"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch03-05 by Grok 4.7: 0.85";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch03-05 by Grok 4.7: 0.95";
