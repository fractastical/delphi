    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch05-03: partially-resolvable, resolvability 0.57";
    dc:description "Symmetry and dynamics can be measured, and obvious counterexamples could refute a strict reading. Demonstrating the proposed minimal-energy cause rather than developmental regulation requires matched force and energy measurements rarely available broadly.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify symmetry and dynamic equilibrium or shape fluctuations across resting and motile organisms, and test whether departures from equilibrium predict asymmetry after controlling lineage and function. A stable asymmetric organism or symmetric nonequilibrium state would refute the categorical relation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Biological symmetry is inherited and actively maintained.", "Equilibrium and minimal energy are not directly observed from shape alone.", "The claim's exceptions and scope are vague.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.69"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-03--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.568"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
