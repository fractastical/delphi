sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch07-08: resolvable-now, resolvability 0.72";
    dc:description "Regularity against cell-size variation is a direct morphometric comparison, and segmented meristems already contain both variables, including local contrasts between equal and unequal cells. Epithelial volumes and uniform comb cells extend the comparison. The named retinal epithelium is a gap in coverage, not a gap in method, and the outcome would still favour or count against the stated size rule.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Relate polygon regularity, such as variation in side length and angle, to cell-size variation and to directional stretch in surface epithelia and parenchyma. Regular hexagons restricted to regions of uniform cell size and no directional traction, with irregular or elongated polygons where size varies or growth is anisotropic, would support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Average side number near six is expected from topology alone, so the test has to use regularity, not merely the mean.", "Retinal pigment epithelium, Thompson's showcase of regular hexagons, is not a tabulated layer in these sets and would have to be added from other public images.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.65"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-08--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch07-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Arabidopsis shoot-meristem segmentations";
    dc:description "Segmented meristem surfaces where cell-size variation and polygon regularity can be compared locally";
    prov:wasDerivedFrom <https://www.repository.cam.ac.uk/handle/1810/262530>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch07-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Honeycomb X-ray microscopy";
    dc:description "Three-dimensional comb reconstructions of similar-sized hexagonal cells as a uniform-size comparison";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.z8w9ghxmw>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch07-08 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch07-08 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch07-08 by Grok 4.7: 0.75";
