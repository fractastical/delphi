    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
