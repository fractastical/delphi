<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-07: resolvable-now, resolvability 0.90";
    dc:description "Large open anthropometric datasets directly contain the variables across growth. A standard allometric regression cleanly tests the cubic tendency and quantifies the stated qualifications.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit log body weight against log stature through growth and test whether the exponent is near three, with deviations attributable to changing shape or density. An exponent materially different from three or systematic residual trends would refute strict cubic similarity.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Human proportions and tissue composition change with age.", "Repeated cross-sections are not individual trajectories.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.94"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-07--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-07--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.898"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-07--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: CDC National Health and Nutrition Examination Survey";
    dc:description "Public measured height, weight, age and sex for growth allometry.";
    prov:wasDerivedFrom <https://www.cdc.gov/nchs/nhanes/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-07--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: WHO Child Growth Standards";
    dc:description "Public child length, height and weight reference data.";
    prov:wasDerivedFrom <https://www.who.int/tools/child-growth-standards>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-07--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
