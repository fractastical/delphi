<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch14-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch14-03: partially-resolvable, resolvability 0.50";
    dc:description "A predictive developmental model can test a restricted sufficiency claim. Thompson's broad language is partly circular and existing time-lapse data have narrow taxonomic coverage.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use time-lapse meristem datasets to quantify initiation intervals, organ similarity and placement, then test whether these inputs alone predict subsequent helical or spiral arrangements. Accurate out-of-sample prediction supports sufficiency; systematic need for additional interactions refutes the 'necessarily' claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Similarly placed' risks defining the resulting pattern circularly.", "Mechanical and inhibitory interactions are plausible hidden variables.", "Time-resolved organ initiation datasets cover few species.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.69"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-03--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.496"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch14-03--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioStudies";
    dc:description "Public imaging studies that may include developmental meristem time series.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biostudies/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch14-03--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "Open plant-development datasets and supplementary measurements.";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch14-03--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch14-03 by GPT-5.6 Sol: 0.52";
