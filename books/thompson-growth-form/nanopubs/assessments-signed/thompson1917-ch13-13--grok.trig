sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch13-13: partially-resolvable, resolvability 0.66";
    dc:description "Skull archives already contain hundreds of beaks and teeth whose centerlines can be fit with standard curves, which is enough to test the tendency in those structures. The claim also covers nails, claws, and tusks, which are much less completely digitized, and it says the spiral is inconspicuous precisely when the arc is too short to identify. Existing scans can therefore accept or reject the law for elongated dental and rostral structures and only sketch it for the rest.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit logarithmic spirals and alternative curves to centerlines of claws, beaks, incisors, canines, and tusks, and test whether fit improves as the structure subtends a larger angle. The tendency is supported if long structures converge on a constant spiral angle and short ones are the same curve seen over a small arc; consistently better fits by non-logarithmic curves in long structures would refute the universal tendency.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Nails and claws are rarely CT-scanned compared with beaks and teeth.", "Over a short arc, a logarithmic spiral, a circle, and a gentle bend are difficult to tell apart.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-13--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-13--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch13-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "3D skulls, beaks, and teeth across vertebrates";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch13-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: DigiMorph";
    dc:description "CT of skulls and jaws for beak and tooth centerlines";
    prov:wasDerivedFrom <http://digimorph.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch13-13--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iDigBio";
    dc:description "Specimen images that add claws and tusks poorly represented in skeletal CT";
    prov:wasDerivedFrom <https://www.idigbio.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch13-13 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-13--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
