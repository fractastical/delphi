    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch16-16--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch16-16: partially-resolvable, resolvability 0.52";
    dc:description "Stress-form alignment is measurable after substantial choices, and public scans support many case studies. The breadth, causal language and circular dependence of stress on geometry prevent a clean whole-skeleton resolution.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across scales, compare skeletal orientations and material distribution with principal stresses predicted under habitual loading, and quantify variance explained relative to developmental, phylogenetic and neutral alternatives.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Habitual loads are rarely observed.", "Observed form influences calculated stress, creating circularity.", "“Very large extent” has no numerical threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.65"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-16--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-16--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.515"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
