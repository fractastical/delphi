<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch17-03: partially-resolvable, resolvability 0.58";
    dc:description "Existing morphology can test whether a global transformation summarizes variation. The asserted proof of a comprehensive growth law and contrast with natural selection do not follow uniquely from geometric fit, limiting discrimination.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit low-dimensional whole-body deformation models and modular independent-trait models to related-species morphometrics, comparing out-of-sample fit. Superior global fit tests coordinated variation but not a unique causal growth law.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A compact transformation does not prove a developmental cause.", "Natural selection does not require character independence.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.65"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-03--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.578"^^xsd:double;
