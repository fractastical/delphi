sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch09-08: partially-resolvable, resolvability 0.49";
    dc:description "A geodesic on a stated surface is a sharp geometric prediction, and C- and S-shaped spicules can be digitized from existing images. What is missing is the cell at the time of growth, so the test becomes a fit to an assumed ellipsoid rather than a measured confinement. That proxy can reject gross mismatches and cannot separate a true geodesic from other curves that also look like circular or spiral arcs.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct the spicule axis and test whether geodesic curvature on a spherical or ellipsoidal cell surface is indistinguishable from zero, predicting circular, elliptic or helical arcs. Systematic departure from a surface geodesic, or a fit only after implausible cell shapes are assumed, would refute the confinement rule.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Many published figures are drawings, and 2D projections underdetermine a space curve.", "The cell surface that confined growth is almost never preserved with the finished spicule.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-08--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.495"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch09-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: World Porifera Database";
    dc:description "Public taxonomic catalogue with linked sources for curved sponge spicules whose axes can be digitized from images.";
    prov:wasDerivedFrom <https://www.marinespecies.org/porifera/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch09-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "Open morphology projects and images that include spicule form for some sponge matrices.";
    prov:wasDerivedFrom <https://www.morphobank.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch09-08 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-08--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-08--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch09-08 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-08--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-08--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch09-08 by Grok 4.7: 0.4";
