    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-18--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-18--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch17-18 by Grok 4.7: 0.72";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
