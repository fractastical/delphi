sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch06-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch06-05: resolvable-now, resolvability 0.83";
    dc:description "The claim denies that mitochondria and similar granules are special entities and treats them as surface-tension clumps. Open proteomes and image volumes show membrane-bounded organelles with pathway annotations and a cell-wide distribution, which is a direct and standard test of that denial. A counterexample of this clarity resolves the universal claim even though some minor fibrillar inclusions remain less studied.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Ask whether mitochondria are bounded organelles with a characteristic proteome and functions, or unstructured clumps of mixed cytoplasm drawn to a cell pole. A double membrane, a mitochondrial proteome and a distributed network would refute the clump account; granules with no specific composition, gathered and drawn out with the cell axis, would support it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Mammalian cultured cells dominate the image sets relative to germ cells and invertebrate tissues.", "The same resources do not cover every non-mitochondrial fibril the wording also includes.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.833"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MitoCarta3.0";
    dc:description "Inventory of mammalian mitochondrial proteins, sub-compartments and pathways, used to test whether these bodies have a specific identity";
    prov:wasDerivedFrom <https://personal.broadinstitute.org/scalvo/MitoCarta3.0/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Human Protein Atlas";
    dc:description "Subcellular images showing mitochondrial localization across human cell types named in the claim";
    prov:wasDerivedFrom <https://www.proteinatlas.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Allen Cell Explorer";
    dc:description "Three-dimensional images of mitochondria in human cells, for testing whether they are polar clumps or a distributed organelle network";
    prov:wasDerivedFrom <https://www.allencell.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch06-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch06-05 by Grok 4.7: 0.85";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-05--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch06-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch06-05 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
