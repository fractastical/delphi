    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-13--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch12-13: resolvable-now, resolvability 0.76";
    dc:description "The competing mechanisms make distinguishable predictions using paired biological and sedimentological observations. Large public marine repositories contain the needed variables, though harmonization and taphonomic controls are necessary.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Model foraminiferal shell abundance across sediment grain-size and current-speed gradients, including transport and settling traits, and compare hydraulic-sorting predictions with habitat-avoidance models based on living assemblages. Matching dead-shell distributions but different live distributions would support sorting; absence from both after flow controls would support avoidance.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dissolution and sampling gear also alter shell distributions.", "Many assemblage datasets mix living and dead tests.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-13--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-13--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.756"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-13--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PANGAEA";
    dc:description "Open marine sediment, grain-size, current and foraminiferal assemblage datasets.";
    prov:wasDerivedFrom <https://www.pangaea.de/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-13--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OBIS";
    dc:description "Public marine species occurrences for comparing living distributions with sedimentary shells.";
    prov:wasDerivedFrom <https://obis.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-13--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
