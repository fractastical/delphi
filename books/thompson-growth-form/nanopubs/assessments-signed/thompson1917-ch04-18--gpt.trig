    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-18--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch04-18: partially-resolvable, resolvability 0.46";
    dc:description "Modern tissue mechanics and morphogen fields provide measurable partial interpretations. The strong independence from cell number, size, and form is difficult to isolate, and the historical concept admits several non-equivalent operationalizations.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Map tissue-scale stress or morphogen fields together with cell number, size, and shape during morphogenesis, then test whether organismal form remains predictable after those cellular variables are perturbed or controlled. Evidence of long-range patterning robust to cellular rearrangement supports a restricted field interpretation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Field of force' can mean mechanics, signaling, or an abstract pattern.", "Tissue fields are generated and transmitted by cells, complicating independence.", "Whole-organism matched perturbations are sparse.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.69"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-18--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.463"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch04-18--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioImage Archive";
    dc:description "Public whole-embryo imaging and perturbations can quantify tissue fields and cellular geometry.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/bioimage-archive/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-18--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
