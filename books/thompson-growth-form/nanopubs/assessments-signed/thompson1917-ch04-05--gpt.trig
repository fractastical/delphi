<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-05--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch04-05: partially-resolvable, resolvability 0.70";
    dc:description "Foam topology and response to tension are distinct from membrane and cytoskeletal alternatives. Existing imaging can reject broad versions, but exact identification of Thompson's alveoli and matched physical measurements limit complete resolution.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare live and fixed-cell images of alleged alveolar networks and test whether their geometry and dynamics match two-fluid foam predictions and vary with interfacial-tension perturbations. Persistence as membrane- or cytoskeleton-defined structures with incompatible topology would refute the foam mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Interfacial tensions are usually not measured alongside images.", "The historical structure may not map uniquely to a modern organelle.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-05--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch04-05--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioImage Archive";
    dc:description "Open live-cell and ultrastructural imaging can distinguish dynamic droplets or foam from fixed networks.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/bioimage-archive/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch04-05--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Electron Microscopy Public Image Archive";
    dc:description "Public volume electron microscopy provides high-resolution intracellular topology.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/empiar/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-05--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch04-05 by GPT-5.6 Sol: 0.7";
