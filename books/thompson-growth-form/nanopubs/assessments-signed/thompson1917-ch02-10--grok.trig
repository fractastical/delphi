    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-10--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-10--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of thompson1917-ch02-10 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
