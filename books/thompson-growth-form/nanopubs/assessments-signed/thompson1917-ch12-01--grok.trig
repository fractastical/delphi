sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-01--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch12-01: partially-resolvable, resolvability 0.64";
    dc:description "Drop equilibrium is a standard geometric target, and planktonic unilocular tests are already imaged and measured at scale. Those collections barely cover the lagenid shapes Thompson used as the harder cases, and a good geometric fit still leaves calcification timing unmeasured. The comparison can be run on existing images for the planktonic subset within weeks, which is a partial test of the stated scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit outlines and micro-CT surfaces of unilocular tests (Orbulina, Lagena and similar genera) to constant-mean-curvature and sessile-drop profiles, and compare residual error with non-equilibrium shape models. A systematically smaller residual for drop profiles would support the claim; structured residuals concentrated in the neck or aperture would refute a pure fluid-drop equilibrium.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A sphere fits many simple generative models, so agreement for Orbulina alone is weak evidence that surface tension set the shape.", "Open 3D coverage is dominated by planktonic Orbulina and Globigerina, while flask-shaped lagenids are mostly represented by plates and SEM images.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-01--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.639"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-01--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Endless Forams";
    dc:description "Expert-identified light images of modern planktonic foraminifera, including spherical Orbulina, for outline comparison with a free drop";
    prov:wasDerivedFrom <http://www.endlessforams.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-01--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AutoMorph Atlantic planktonic foraminifera";
    dc:description "Open 2D and 3D morphometrics and coordinates for tens of thousands of Recent planktonic tests";
    prov:wasDerivedFrom <https://doi.org/10.5281/zenodo.165514>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-01--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Micro-CT volumes of a few foraminifera, including Orbulina, for a three-dimensional curvature check";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-01--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch12-01 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-01--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-01--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch12-01 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
