    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch05-13: needs-new-data, resolvability 0.49";
    dc:description "A shared instability model could yield discriminating geometric and perturbational predictions. Existing specimens mainly record endpoints and are inadequate to establish surface tension as the cause during formation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Image hydroid calycle rims and stems during secretion, quantify notch and annulation wavelengths, and test whether one surface-tension instability model predicts both geometries and their response to tension perturbation. Distinct developmental patterning or formation after solidification would refute the shared mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Developmental time series and tension perturbations are scarce.", "Final museum morphology does not reveal whether tissue was fluid during patterning.", "The common-cause model lacks a specified parameterization.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.71"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-13--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.49"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-13--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Public 3D specimens can quantify final hydroid cup and stem geometry, but not formation mechanics.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
