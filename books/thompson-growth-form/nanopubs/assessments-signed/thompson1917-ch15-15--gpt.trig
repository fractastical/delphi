    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch15-15: needs-new-data, resolvability 0.54";
    dc:description "The equation is explicit and discriminating. Geometry is public, but the branch-resolved in vivo flow and loss measurements needed across vertebrate arteries are generally absent, making a direct test data-limited.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For each bifurcation, estimate energy loss per unit length in trunk and branch from matched geometry and flow, and compare observed angle with arccos(L/L′). Persistent deviations beyond measurement error would refute the law.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Matched local energy losses and branch angles are rarely available.", "Pulsatile non-Newtonian flow complicates L and L′.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-15--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.535"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
