sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch03-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The human curve of growth in length has a point of inflection about the fifth month of intra-uterine life: before it growth velocity continually increases, and after it, though growth remains rapid, velocity falls away.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Human length growth peaks in velocity around the fifth month before birth";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Pre-natal and post-natal growth”. Scope: human foetus"
}
