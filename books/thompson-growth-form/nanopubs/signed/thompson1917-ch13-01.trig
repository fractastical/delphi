sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch13-01> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The rhinoceros horn grows faster anteriorly than posteriorly in a constant ratio, so it curves as a logarithmic spiral; lying in the median plane, it has no lateral twist and forms a plane spiral.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Rhinoceros horn is a plane logarithmic spiral from constant front-to-back growth ratio";
    <http://www.w3.org/2004/02/skos/core#notation> "v_{ant}/v_{post} = \\text{const} \\Rightarrow plane spiral r = a e^{\\theta\\cot\\alpha}";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XIII, “The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion”; topic “The rhinoceros horn”. Scope: rhinoceros horns"
}
