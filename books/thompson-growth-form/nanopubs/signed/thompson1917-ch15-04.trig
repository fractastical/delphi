sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch15-04> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Peristaltic contraction of the oviduct applies greatest pressure behind the middle of the forming egg, making the anterior end broader and the posterior narrower; the resulting tapered form also favours movement down the oviduct blunt end first.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Peristaltic pressure behind the egg's middle makes the front blunt and rear pointed";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XV, “On the Shapes of Eggs, and of Certain Other Hollow Structures”; topic “Mechanical conformation of the egg”. Scope: birds' eggs"
}
