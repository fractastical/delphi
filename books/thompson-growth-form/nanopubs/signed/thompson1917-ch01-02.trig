sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch01-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The material parts of living things (cells, tissues, shells, bones, leaves, flowers) are portions of matter whose particles have been moved, moulded and shaped in obedience to the laws of physics.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Cells, tissues, shells, bones, leaves and flowers are shaped by the laws of physics";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter I, “Introductory”; topic “Organic form obeys physical law”. Scope: all organisms and their structural parts"
}
