sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch03-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Full adult stature in man lasts only for a time: it begins to decrease well before fifty, is notably lessened by sixty, and is much reduced in extreme old age, so that growth takes a negative value.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Adult human stature declines well before fifty and markedly by old age";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Rate of growth in man”. Scope: adult humans"
}
