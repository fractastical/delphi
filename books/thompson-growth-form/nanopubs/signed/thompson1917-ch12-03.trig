sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch12-03> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Foraminiferal septa are convex outwards and those of Nautilus concave outwards because the pressure each membrane resisted when it set lay on opposite sides; in both cases the septum tends to a surface of minimal area.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Septa are convex outwards in Foraminifera and concave in Nautilus because of pressure side";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XII, “The Spiral Shells of the Foraminifera”; topic “Curvature of septa”. Scope: septa of chambered Foraminifera and chambered cephalopod shells"
}
