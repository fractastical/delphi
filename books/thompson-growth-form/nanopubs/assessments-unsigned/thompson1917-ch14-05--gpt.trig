  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-05--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-05--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch14-05: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.795"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "Both disc size and row counts can be extracted from existing images with standard methods. Adequate within-species replication can directly test the predicted association and listed transitions." ;
    rdfs:comment "Proposed test with existing data: Measure capitulum diameter and parastichy count pairs across sunflower heads within and among species, then model count transitions with size while controlling developmental stage. Positive, ordered transitions such as 34/55 to 55/89 to 89/144 support the claim; size-independent counts refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Size and developmental stage are correlated.", "Very dense high-order spirals require high-resolution images." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-05--gpt--dataset-2> .
