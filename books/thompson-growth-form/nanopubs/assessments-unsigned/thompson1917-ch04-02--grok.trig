sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch04-02: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.555"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Images and perturbation screens can test the part of the claim that denies a mechanical explanation and requires a field force of the magnetic kind. That is a proxy for Thompson's analogy rather than a direct measurement of a magnetic body force, which lowers operationalizability. The mechanical account is discriminable where motors and microtubules are perturbed, and those experiments are public for a limited set of cells." ;
    rdfs:comment "Proposed test with existing data: Ask whether spindle and aster geometry persists when microtubule mechanics and motor traction are removed, and whether a magnetic-like body force is required to keep the figure. Collapse of the figure under mechanical disruption, with no need for a magnetic or electric body force, would refute the claim; a figure that survives loss of traction and tracks an applied polarised field would support it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Reading 'polarised force' as microtubule polarity is a modern gloss on a magnetic or electric analogy.", "Force-ablation measurements are sparser in repositories than the images of the figure.", "Repository coverage is model cell types, not every animal and plant mitosis." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-02--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch04-02 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--grok--operationalizability> .
