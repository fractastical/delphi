sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch07-08: resolvable-now, resolvability 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.72"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "Regularity against cell-size variation is a direct morphometric comparison, and segmented meristems already contain both variables, including local contrasts between equal and unequal cells. Epithelial volumes and uniform comb cells extend the comparison. The named retinal epithelium is a gap in coverage, not a gap in method, and the outcome would still favour or count against the stated size rule." ;
    rdfs:comment "Proposed test with existing data: Relate polygon regularity, such as variation in side length and angle, to cell-size variation and to directional stretch in surface epithelia and parenchyma. Regular hexagons restricted to regions of uniform cell size and no directional traction, with irregular or elongated polygons where size varies or growth is anisotropic, would support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Retinal pigment epithelium, Thompson's showcase of regular hexagons, is not a tabulated layer in these sets and would have to be added from other public images.", "Average side number near six is expected from topology alone, so the test has to use regularity, not merely the mean." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-08--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch07-08 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-08--grok--data-existence> a delphi:LLMClaimAssessment ;
