sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-11--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-11: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.493"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "A three-lineage sample of early embryos can show whether a few cell-partition types are shared. That is a fragment of a claim that also covers organs and the whole of plants and animals, most of which is uncompiled. Shared topology is only weakly discriminating once the number of legal partitions is already small." ;
    rdfs:comment "Proposed test with existing data: Assemble partition topologies of small cell groups and of small organs across plants and animals, and test whether the same few graphs recur with weak phylogenetic signal. The same configurations in distant lineages, and relatedness adding little once topology is constrained, would support the claim; configurations clustering by clade would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "If only a few topologies are possible, recurrence is expected and does not by itself explain why those topologies were used.", "Organs, as opposed to early cell groups, are not coded as partition graphs in these databases." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-11--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-11 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-11--grok--operationalizability> .
