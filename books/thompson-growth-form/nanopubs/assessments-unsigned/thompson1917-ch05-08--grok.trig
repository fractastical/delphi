sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-08--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch05-08: partially-resolvable, resolvability 0.63" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.625"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Endless Forams is large enough to fit chamber outlines of Globigerina-like tests and to ask whether the whole shell is a poorer minimal surface than its newest chamber. That is a real geometric test for planktonic foraminifera. It does not observe the fluid-then-solid sequence, and it omits desmids, so the mechanism and the full scope stay out of reach of this archive alone." ;
    rdfs:comment "Proposed test with existing data: Fit each foraminiferal chamber outline to a surface of constant mean curvature and fit the whole test to the same class of surface. Chambers that match and whole tests that do not would support the geometric claim; chambers that fit no better than the whole shell, or that fit a non-equilibrium family better, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The images are two-dimensional views of three-dimensional chambers.", "A constant-mean-curvature outline does not show that the chamber was fluid when it formed.", "Desmids and many benthic chambered forms are outside this image set." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-08--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch05-08 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-08--grok--operationalizability> .
