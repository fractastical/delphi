sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-02--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-02--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch05-02: partially-resolvable, resolvability 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.52"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Relative force contributions can be estimated in defined systems, but the global ranking is vague and all-cell scope is too broad. Existing data resolve selected cell types and perturbations, not the general claim." ;
    rdfs:comment "Proposed test with existing data: Fit force-balance models to cell shapes using measured cortical or interfacial tension, gravity, pressure, osmosis, adhesion, and wall mechanics, then compare each factor's predictive contribution across representative cell types. Surface tension is paramount only if removing it causes the largest general loss of predictive accuracy." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "'Paramount' needs an imposed quantitative criterion.", "Most datasets do not measure all competing forces.", "Walled and wall-less cells require different models." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-02--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-02--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch05-02 by GPT-5.6 Sol: 0.55" ;
