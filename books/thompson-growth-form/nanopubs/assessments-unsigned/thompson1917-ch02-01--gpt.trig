sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-01--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-01--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch02-01: resolvable-now, resolvability 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.825"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    dct:description "The equation, variables and decision criterion are explicit, and large public fish survey data contain the needed measurements. Direct morphometrics would strengthen attribution specifically to form, but the core relationship is readily testable." ;
    rdfs:comment "Proposed test with existing data: Using repeated or cross-sectional length and weight records, compute k = W/L^3 and test whether it is constant over size or age. Stable k supports geometric similarity at roughly constant density; systematic k changes refute unchanged form or density and can be compared with direct shape data." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Changes in density can alter k without shape change.", "Cross-sectional records can confound growth with cohort or sex." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-01--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-01--gpt--dataset-2> .
