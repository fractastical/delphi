sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-10--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch02-10: partially-resolvable, resolvability 0.57" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.57"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "The shared square-root prediction is precise and could be distinguished from other exponents with size-matched speeds. Open tracking and fisheries databases contain speeds and lengths, but not the three theoretical speeds the derivations name, and similar construction is hard to enforce. A careful subset analysis is feasible; it would not settle all three modes together." ;
    rdfs:comment "Proposed test with existing data: Fit log speed on log length separately for swimming, flight, and walking among animals of similar construction. An exponent near one-half in each case would support the claim; exponents near zero or one would favor the obvious rivals." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Tracked speeds are mostly routine movement, not minimum flight speed, sprint speed, or pendulum walking speed.", "Cross-species samples mix mechanical design with the size effect the claim sets aside." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-10--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch02-10 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-10--grok--operationalizability> .
