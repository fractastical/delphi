sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-06--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch16-06: needs-new-data, resolvability 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.353"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.56"^^xsd:double ;
    dct:description "The claim is a process, not the finished architecture. Public micro-CT can show that trabeculae end up aligned, which several mechanisms share. A decisive test needs longitudinal imaging of the same struts under controlled shear, and that kind of open time series is not available for the analysis Thompson's wording requires." ;
    rdfs:comment "Proposed test with existing data: Track individual trabeculae through time under a known shear field and record whether oblique elements are displaced into the principal-stress directions while aligned elements stay put. Support would be shear-driven relocation on that time scale; loss and replacement by cell remodeling, with no displacement of the existing strut, would fail Thompson's mechanism even if the final pattern matches the stress lines." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Static micro-CT shows the aligned end state and does not record whether shear moved the strut.", "In-vivo loading series that do exist are small, scattered in papers, and rarely deposit the image time series." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch16-06 by Grok 4.7: 0.46" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.46"^^xsd:double ;
