sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-17--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch16-17: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.601"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Independent trees and morphological matrices exist, so homoplasy of single bones can be compared with other characters in living vertebrates. That is a fair proxy for 'unreliable as evidence of blood-relationship'. The fossil illustration cannot be checked with molecules, and habitat-linked convergence is only partly separated from coding decisions." ;
    rdfs:comment "Proposed test with existing data: Using molecular or other independent trees as the reference, compare phylogenetic signal and homoplasy of scapulae and vertebrae with that of other skeletal characters, especially in lineages that changed habitat. The claim is supported if those mechanically loaded bones mislead more often than other characters; equal or higher reliability would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Extinct test cases such as Zeuglodon have no genome, so the reference tree is itself partly morphological.", "Character coding and missing fossils change apparent homoplasy." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-17--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-17--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch16-17 by Grok 4.7: 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.62"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-17--grok--operationalizability> .
