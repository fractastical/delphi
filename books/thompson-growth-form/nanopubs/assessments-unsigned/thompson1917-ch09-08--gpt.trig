  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-08--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch09-08: needs-new-data, resolvability 0.52" ;
