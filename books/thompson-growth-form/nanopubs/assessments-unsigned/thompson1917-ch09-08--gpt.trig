    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.523"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Geodesicity has an explicit geometric test. Existing archives may contain spicule ultrastructure, but likely lack simultaneous high-resolution cell-surface reconstructions needed to resolve the mechanism." ;
    rdfs:comment "Proposed test with existing data: Reconstruct the contemporaneous cell surface and spicule centerline in 3D, then test whether the centerline has near-zero geodesic curvature and fits the shortest surface path better than unconstrained growth models. Multiple developmental stages would test the proposed confinement mechanism." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Adult spicules do not preserve the cell surface that constrained growth.", "Matched developmental 3D images are rare." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-08--gpt--dataset-1> .
