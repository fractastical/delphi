sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-04--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch07-04: resolvable-now, resolvability 0.81" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.808"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Triple-junction angle and wall curvature are standard measurements on segmentations that can already be downloaded. The prediction that angle is independent of cell size while curvature is not is distinguishable from right-angle or random-junction alternatives. A small team can run that test on meristems, embryos and public epithelia with existing tools." ;
    rdfs:comment "Proposed test with existing data: In three-dimensional segmentations of parenchyma, epithelia and early embryos, measure the angles at which walls meet and the curvature of walls between cells of different sizes. Triple junctions near 120 degrees regardless of cell size, with curvature set by the size difference, would support the claim; common four-way junctions, angles far from 120 degrees, or curvature unrelated to neighbouring sizes would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Anisotropic stress and recent divisions are known to pull some junctions off 120 degrees, so the test needs a pre-registered exclusion or a report of that bias.", "Honeycomb and every plant parenchyma type are not in these three collections." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch07-04 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-04--grok--operationalizability> .
