sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch11-11: partially-resolvable, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.742"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.79"^^xsd:double ;
    dct:description "The predicted association is quantitatively testable from existing scans. The word 'only' demands exclusion of correlated geometric factors, and inferred rates make that causal sufficiency less clean." ;
    rdfs:comment "Proposed test with existing data: Estimate outer- and inner-border growth increments from shell growth geometry and regress whorl separation, contact and overlap against their ratio. Test whether other parameters such as aperture shape and translation improve prediction beyond that ratio." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Static geometry only indirectly estimates growth rates.", "Several shell-model parameters can affect apparent overlap." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-11--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--gpt--operationalizability> a delphi:LLMClaimAssessment ;
