sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-04--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-04: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.593"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Age-related disparity is a standard morphometric question, and some public ontogenetic series bear on it. The claim covers related individuals and species, especially mammals traced through fetal stages, and fetal series of that breadth are not in one open collection. Existing scans can test a biased subset, with a real risk that preservation, not biology, produces the gradual pattern." ;
    rdfs:comment "Proposed test with existing data: Measure size and shape disparity among related species at successive ages, including fetal stages. Disparity small in the young and increasing toward the adult would support the claim; disparity already large at the earliest comparable stages would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Fetal and juvenile series are taxonomically sparse next to adult specimens.", "Museum sampling favors adults, which can exaggerate apparent late divergence." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-04--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-04 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
