sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-03--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch17-03: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.514"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.52"^^xsd:double ;
    dct:description "Whole-body transformations versus modular shape change can be compared on open images and scans. That tests the pattern half of the claim. It does not test the historical assertion that the pattern rules out natural selection, because selection is compatible with correlated change across the body." ;
    rdfs:comment "Proposed test with existing data: Fit related species with a low-dimensional coordinate transformation of the whole body and with a model of independent regional changes, and compare held-out landmark error. A large advantage for the global transformation would support an integrated law of growth; the morphological fit would still leave natural selection unrefuted unless selection is separately shown to require part-by-part independence." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A good global fit is also what selection on an integrated phenotype would produce.", "Thompson's rival, independent variation of separate parts, is a historical picture of selection rather than a distinct morphological null." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch17-03 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-03--grok--operationalizability> .
