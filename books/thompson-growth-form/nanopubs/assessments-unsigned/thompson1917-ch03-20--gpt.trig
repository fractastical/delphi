sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-20--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-20--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-20: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.648"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "The optimum and group contrast are directly measurable, but no single open resource appears to contain standardized full response curves for the stated species scope. Existing public studies permit a subset test after harmonization." ;
    rdfs:comment "Proposed test with existing data: For each species, fit root or shoot elongation across experimental temperatures and estimate the temperature of maximum growth, then compare temperate plants with maize, melon and other warm-climate plants. Broad dispersion among temperate optima or no warmer-climate shift would refute the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Temperature-response experiments are scattered and use different endpoints.", "Optima depend on developmental stage, organ and acclimation.", "TRY does not directly provide complete temperature-response curves for all species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-20--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-20--gpt--dataset-2> .
