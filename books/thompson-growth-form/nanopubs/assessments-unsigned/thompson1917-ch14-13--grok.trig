sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-13--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch14-13: not-empirically-resolvable, resolvability 0.21" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.214"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "Thompson's conclusion is a dismissal of a research program: the series, its utility, and a selectionist origin are to be left out of botanical explanation. Parastichy frequencies and packing efficiency can inform narrower questions about function, and they do not decide what deserves a place in the science. The statement as made has no distinguishing empirical consequence." ;
    rdfs:comment "Proposed test with existing data: The claim concludes that the Fibonacci series, its supposed usefulness, and natural selection's role in introducing it deserve no place in botanical explanation. That is a decision about what belongs in a theory, not a result that a count of parastichies or a fitness assay would confirm or refute." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Usefulness and 'a place in the study of botanical phenomena' are not defined as measurable outcomes.", "Evidence that Fibonacci packing has a function would address a different claim from the one that the topic should be excluded." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch14-13 by Grok 4.7: 0.18" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.18"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-13--grok--operationalizability> .
