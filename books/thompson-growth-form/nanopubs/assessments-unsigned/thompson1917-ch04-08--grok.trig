sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-08--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch04-08: partially-resolvable, resolvability 0.40" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.4"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The concrete electrical patterns Thompson cites are measurable, and classic recordings for fish and amphibian eggs can be compiled. They cover few species, and correlation with cleavage does not show that the potential difference does causal work. Clamping experiments that would settle the causal share are sparse, so only a proxy test is available." ;
    rdfs:comment "Proposed test with existing data: Align membrane or pole-to-pole potential of fertilised eggs with the cleavage cycle, and ask whether the animal-vegetal difference reverses at successive divisions and whether chromatin's electrical contrast peaks at mitosis. A large causal contribution, shown by division failing when those differences are clamped, would support the claim; potential fluctuations that are dispensable for division would refute a 'great part' in the process." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'A great part' has no numerical threshold.", "Voltage traces aligned to cleavage exist for a few eggs and are not in one archive.", "Potential changes can be consequences of membrane events rather than drivers of the division plane." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch04-08 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-08--grok--operationalizability> .
