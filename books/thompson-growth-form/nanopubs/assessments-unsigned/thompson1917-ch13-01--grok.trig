sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-01--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch13-01: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.555"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "A plane logarithmic spiral is a direct fit to a horn outline, and photographs of intact sheaths exist in museum portals. Open 3D coverage of complete rhinoceros horns is thin, and growth velocities at the front and back of the germinal surface are not archived. The geometric half can be checked for the specimens that retain the sheath; the growth-ratio mechanism stays an interpretation of that fit." ;
    rdfs:comment "Proposed test with existing data: Fit a plane logarithmic spiral to rhinoceros horn sheaths in lateral view and test whether the axis stays in the median plane. A constant angle lying in that plane would support the geometric claim; a helical component, or an angle that changes along the horn, would refute it. The anterior-to-posterior growth ratio is then read from the angle rather than measured as a growth rate." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Keratin sheaths are often removed from skeletal specimens, so scans capture the core and not the curve Thompson describes.", "A constant spiral angle implies a constant growth ratio only inside Thompson's growth model." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-01--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch13-01 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-01--grok--operationalizability> .
