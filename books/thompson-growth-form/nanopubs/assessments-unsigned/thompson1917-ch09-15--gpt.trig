sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-15--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-15--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch09-15: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.495"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.69"^^xsd:double ;
    dct:description "Material-independence of gross form is measurable from existing morphology. The stronger causal inference to an underlying vesicular structure remains poorly discriminated without developmental observations." ;
    rdfs:comment "Proposed test with existing data: Compare lattice regularity and topology across silica-, celestite- and organic-skeleton taxa using standardized images, then test whether material predicts form after phylogeny and size are controlled. Demonstrating an underlying vesicular template requires direct developmental imaging rather than cross-material convergence alone." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Cross-material convergence is not unique evidence for vesicle moulding.", "The groups differ in phylogeny, ecology and scale." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-15--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-15--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch09-15 by GPT-5.6 Sol: 0.65" ;
