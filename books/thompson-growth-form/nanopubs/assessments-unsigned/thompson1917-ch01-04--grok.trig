sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch01-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-04--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch01-04: partially-resolvable, resolvability 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.378"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Chemistry, surface action, and osmosis are specific enough that a quantitative violation in a well-measured system would count against the claim, and tabulated biophysical numbers exist for those checks. The scope is still all bodily mechanisms of all organisms, the phrase about what is known tracks the literature rather than a dataset, and consistency is weak evidence against a rival that allows rare exceptions. A small team could audit a few laws, not the universal claim." ;
    rdfs:comment "Proposed test with existing data: For named classes of law, compare measured osmotic equilibria, surface stresses, and chemical stoichiometry in cells and tissues with the values ordinary physics requires. A systematic, replicated violation would refute the claim for that law; agreement in a studied system would support only that restricted case." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The claim is an open-ended negative over every law and every organism.", "Agreement in model cells does not rule out a subtle non-physical contribution elsewhere." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch01-04--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch01-04 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch01-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-04--grok--operationalizability> .
