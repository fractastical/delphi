sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-09--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-09--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch02-09: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.645"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "The predicted exponent and outcome are unambiguous, and published public trait records permit a restricted comparative test. Coverage from fleas to horses with matched geometry is inadequate, requiring substantial compilation for the full scope." ;
    rdfs:comment "Proposed test with existing data: Compile maximal jump height, body length and limb geometry for similarly constructed animals, then test whether absolute height has a size exponent of zero after controlling lever ratios. A consistent nonzero scaling exponent would refute the stated law." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Jump-height measurements are sparse and methodologically heterogeneous.", "Finding animals that satisfy similar construction across a wide size range is difficult." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-09--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-09--gpt--operationalizability> a delphi:LLMClaimAssessment ;
