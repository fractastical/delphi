  <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Tallo" ;
    dct:description "Individual tree stem diameter and height for fitting the diameter-height exponent across thousands of species" ;
    prov:wasDerivedFrom <https://github.com/selva-lab-repo/TALLO> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: FIA DataMart" ;
    dct:description "National forest inventory stem diameters and heights, including small stems, for the same allometric test" ;
    prov:wasDerivedFrom <https://apps.fs.usda.gov/fia/datamart/datamart.html> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-3> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Global Wood Density Database" ;
    dct:description "Wood density for thousands of taxa, one material constant in the self-buckling height calculation" ;
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.234> .
