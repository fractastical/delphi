sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-07--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch05-07: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.58"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Yeast budding is heavily imaged and genetically annotated, so the geometric sequence, local expansion then rounding, is testable now. The causal claim is a sudden local fall in surface tension, and the archived variables are genes and shapes rather than tension. Landmark mutants provide a serious rival, which makes the available test informative but one step removed from the force Thompson names." ;
    rdfs:comment "Proposed test with existing data: At the future bud site on a yeast cell, measure local surface tension through bud emergence and test whether a local drop precedes expansion, as against a polarity landmark that directs growth at constant tension. A tension drop that is necessary and sufficient for the bud would support the claim; budding at a marked site with no tension drop, or failure of budding when tension is locally reduced away from the landmark, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Phenotype databases record shape and gene, not local tension.", "Turgor-driven expansion and a tension drop make similar early bulges.", "Coverage is excellent for Saccharomyces and thin for other budding yeasts." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-07--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch05-07 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-07--grok--operationalizability> .
