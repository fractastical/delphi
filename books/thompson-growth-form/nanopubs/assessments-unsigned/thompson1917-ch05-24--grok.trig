sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-24--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-24--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch05-24: resolvable-now, resolvability 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.843"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Biconcave geometry maps directly onto surface curvature, and a large open set of three-dimensional red-cell reconstructions contains the shapes required. A small team can test constant versus varying mean curvature with standard surface analysis. The hedged suggestion of osmotic or fluid-crystal forces is broader than the curvature test, but the negative claim that the corpuscle is not a surface-tension equilibrium figure is decidable now." ;
    rdfs:comment "Proposed test with existing data: Compute mean curvature over reconstructed mammalian red-cell surfaces and compare discocytes with cells that have rounded in hypotonic or spherocytogenic conditions. Constant mean curvature on the biconcave disc would refute the claim; curvature that varies over the disc, together with a shift toward a sphere when the medium is diluted, would support it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The library is human-dominated, so non-mammalian vertebrate corpuscles in the stated scope are thinly covered.", "Its spherocytes are not a controlled dilution series, so the hypotonic-sphering clause needs a separate public experiment." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-24--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-24--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch05-24 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-24--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-24--grok--operationalizability> .
