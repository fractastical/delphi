  <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-05--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Human cardiac diffusion MRI dataset" ;
    dct:description "Adult human myocardial fiber orientations, a proxy for the post-twist heart but not a developmental series." ;
    prov:wasDerivedFrom <https://doi.org/10.25740/yh756nh8583> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-05--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Cardiac Atlas Project" ;
    dct:description "Adult ventricular geometry used to compute geodesics; it does not record the primitive tube or the stomach." ;
    prov:wasDerivedFrom <https://www.cardiacatlas.org/> .
