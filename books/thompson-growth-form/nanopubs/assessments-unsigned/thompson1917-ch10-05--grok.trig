sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch10-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-05--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch10-05: partially-resolvable, resolvability 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.453"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "The adult heart can be checked for geodesic fibers, which is only the end state of a developmental claim about dilatation, twisting and new gastric systems. Open data are adult ventricular diffusion and shape, not a series from the primitive tube and not a comparable stomach dataset. The further claim that the heart works only because fibers take the shortest course is not separated from other working architectures by these measurements." ;
    rdfs:comment "Proposed test with existing data: Test whether adult heart and stomach fibers are geodesics of the twisted surface, whether oblique gastric fibers match a new pouch geodesic, and whether pump performance requires that shortest-path layout. Adult geodesic fits support only the geometric residue of the developmental claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Remaining geodetic after twisting requires the fiber map through development, which these adult datasets do not contain.", "Effective contraction is compatible with non-geodesic architectures, so function does not isolate the shortest path as necessary." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch10-05 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch10-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-05--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-05--grok--data-existence> a delphi:LLMClaimAssessment ;
