sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-11--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch07-11: resolvable-now, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.713"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The claim is a specific geometric description of one structure, the hive-bee cell, and open X-ray volumes of that structure exist. Prism geometry is already implicit in the hexagonal segmentations, and the diagnostic cap angle is measurable if the cell base was scanned. The foundation-comb caveat lowers adequacy without removing the possibility of a direct test." ;
    rdfs:comment "Proposed test with existing data: On three-dimensional reconstructions of hive-bee comb, measure the prism angles in plan and the angles of the three rhombs that close the cell. Prism angles near 120 degrees and a trihedral angle near 109.5 degrees would support the rhombic-dodecahedron description; a flat or differently angled base would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The released tables report cell size and tilt, so the rhombic-cap angle has to be measured from the volumes rather than read off a column.", "Much of the X-ray material was built on experimental foundations, which may alter the base relative to natural comb." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch07-11 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-11--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-11--grok--data-existence> a delphi:LLMClaimAssessment ;
