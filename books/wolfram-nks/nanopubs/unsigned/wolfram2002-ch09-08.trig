    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "And much as in physical systems like fluids, what ultimately leads to this is the presence of small-scale apparent randomness that washes out details of individual cells or molecules—as well as of conserved quantities that force certain overall features not to change too quickly." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q60413467> ;
    prov:hadPrimarySource <https://www.wolframscience.com/nks/p464--conserved-quantities-and-continuum-phenomena/> ;
