sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-19> a delphi:Claim ;
    rdfs:label "Complex biological forms come from growth rules, not selection-driven constraints" ;
    dct:description "Natural selection can produce forms determined by constraint satisfaction only when those forms are rather simple; complex biological forms are associated instead with explicit evolution rules, mostly those governing the growth of an individual organism." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 7, “Mechanisms in Programs and Nature”; section “Origins of Simple Behavior” (from p. 351), p. 351. Scope: biological forms shaped by natural selection and development" ;
    dct:type "model-of-nature" .
}

