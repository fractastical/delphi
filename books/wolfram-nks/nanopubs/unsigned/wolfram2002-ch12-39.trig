sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-39> a delphi:Claim ;
    rdfs:label "Complete and consistent means exactly half of all strings are generated" ;
    dct:description "For a multiway system serving as an axiom system, with negation any length-preserving involution on strings, the system is complete and consistent exactly when half of all possible strings of each length are eventually generated from the string representing true; more than half implies inconsistency and less than half implies incompleteness." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Implications for Mathematics and Its Foundations” (from p. 772), pp. 796–797. Scope: multiway systems treated as axiom systems with length-preserving negation" ;
    dct:type "mathematical" .
}

