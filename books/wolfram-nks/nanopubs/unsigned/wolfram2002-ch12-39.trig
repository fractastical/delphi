    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "the criterion for whether a system is complete and consistent is simply that exactly half the possible strings of a given length are eventually generated if one starts from the string representing \"true\"." ;
