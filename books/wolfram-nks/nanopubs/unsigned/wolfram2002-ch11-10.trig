sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-10> a delphi:Claim ;
    rdfs:label "Any system type that can emulate every cellular automaton has universal members" ;
    dct:description "Since a universal cellular automaton exists, any type of system shown capable of emulating any cellular automaton—including mobile automata, Turing machines, neighbor-dependent and sequential substitution systems, tag systems, cyclic tag systems, symbolic systems and register machines—must contain universal examples." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “Emulating Cellular Automata with Other Systems” (from p. 664), p. 668. Scope: mobile automata, Turing machines, substitution systems, tag and cyclic tag systems, symbolic systems, register machines" ;
    dct:type "mathematical" .
}

