sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-03> a delphi:Claim ;
    rdfs:label "No physical system can compute beyond cellular automata and Turing machines" ;
    dct:description "As a law of nature, no system that can actually be constructed in our universe can carry out explicit computations more sophisticated than those of universal systems such as cellular automata and Turing machines; imaginable hypercomputers (e.g. with infinite tables of results) cannot be built." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “The Content of the Principle” (from p. 719), p. 720. Scope: all physical systems in our universe, including computers and brains" ;
    dct:type "physical-hypothesis" .
}

