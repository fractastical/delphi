sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-13> a delphi:Claim ;
    rdfs:label "Repetition periods of class 3 rules grow rapidly with system size" ;
    dct:description "In cellular automata on a finite cyclic lattice, a rapid increase of repetition period with lattice size is characteristic of class 3 behavior, with large fluctuations as size changes; among elementary rules only rule 45 appears to give periods always near the maximum possible." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Systems of Limited Size and Class 2 Behavior” (from p. 255), p. 258. Scope: elementary cellular automata on cyclic lattices of size n" ;
    dct:type "computational-observation" .
}

