sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-22> a delphi:Claim ;
    rdfs:label "Merging of independently growing domains generically produces nesting" ;
    dct:description "Nesting can arise from random initial conditions through progressive annihilation of randomly placed elements: in essentially any system where domains grow fairly independently and then progressively merge, an overall nested pattern resembling a river-tributary tree forms, even when domain boundaries move as random walks." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 7, “Mechanisms in Programs and Nature”; section “Origins of Simple Behavior” (from p. 351), p. 359. Scope: cellular automata such as rules 184 and 110 and other domain-coarsening systems from random initial conditions" ;
    dct:type "computational-observation" .
}

