sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-03> a delphi:Claim ;
    rdfs:label "Growing snowflakes should alternate between tree-like and faceted shapes" ;
    dct:description "During the growth of an individual snowflake its shape should alternate between tree-like and faceted forms, as new branches grow and then collide with one another." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “The Growth of Crystals” (from p. 369), p. 371. Scope: time course of individual snowflake growth" ;
    dct:type "prediction" .
}

