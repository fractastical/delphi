sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-24> a delphi:Claim ;
    rdfs:label "Some simple Turing machine computations require exponential effort" ;
    dct:description "Exhaustive search of all roughly 4 billion 4-state 2-color Turing machines shows certain computations by such machines cannot be sped up by any machine of that size, suggesting that some computations specified by very simple rules require effort growing exponentially with input length." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Undecidability and Intractability” (from p. 753), p. 764. Scope: Turing machines with up to 4 states and 2 colors" ;
    dct:type "computational-observation" .
}

