sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-12> a delphi:Claim ;
    rdfs:label "Space is discrete below the scales probed by experiment" ;
    dct:description "Space, though experimentally continuous down to about 10^-20 meters, is very likely made of discrete elements at still smaller scales, just as fluids and other seemingly continuous things have turned out to be." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “The Nature of Space” (from p. 472), p. 472. Scope: the structure of physical space at very small distances" ;
    dct:type "physical-hypothesis" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <http://www.wikidata.org/entity/Q60413467> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-wolfram-nks-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Particle physics experiments have shown that space acts as a continuum down to distances of around 10^(-20) meters—or a hundred thousandth the radius of a proton. But there is absolutely no reason to think that discrete elements will not be found at still smaller distances." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q60413467> ;
    prov:hadPrimarySource <https://www.wolframscience.com/nks/p472--the-nature-of-space/> ;
    schema:pagination "p. 472" ;
    dct:rights "Verbatim quotation from A New Kind of Science, © 2002 Stephen Wolfram, LLC, all rights reserved; quoted for scholarly purposes with citation, as the book's copyright notice permits." ;
    rdfs:seeAlso <https://www.wolframscience.com/nks/piv--copyright/> .

