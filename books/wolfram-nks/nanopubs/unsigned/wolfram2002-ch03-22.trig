sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-22> a delphi:Claim ;
    rdfs:label "Computer experiments let one discover phenomena not anticipated in advance" ;
    dct:description "A methodology based on computer experiments, in which one runs precisely specified programs and observes their behavior, can discover genuinely unexpected phenomena that a traditional approach of constructing examples of predefined behavior would miss, while giving results as precise as mathematical statements." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 3, “The World of Simple Programs”; section “How the Discoveries in This Chapter Were Made” (from p. 108), p. 108. Scope: methodology of studying simple programs" ;
    dct:type "conceptual" .
}

