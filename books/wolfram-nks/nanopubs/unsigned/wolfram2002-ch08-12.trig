sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-12> a delphi:Claim ;
    rdfs:label "Complexity of individual organism parts has been roughly constant for eons" ;
    dct:description "The complexity of individual parts of organisms, such as textures and other morphological features, was already present in early fossils and has not changed much in at least several hundred million years." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “Fundamental Issues in Biology” (from p. 383), p. 389. Scope: fossil record of morphological complexity" ;
    dct:type "prediction" .
}

