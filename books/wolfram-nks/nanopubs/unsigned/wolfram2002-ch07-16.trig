sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-16> a delphi:Claim ;
    rdfs:label "Complex natural behavior is almost never best explained by constraints" ;
    dct:description "Almost none of the complex behavior seen in nature is best explained as the satisfaction of constraints, because finding a pattern that satisfies a constraint is usually far too difficult a computation to happen routinely in nature; explicit processes of evolution are the more plausible explanation." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 7, “Mechanisms in Programs and Nature”; section “The Problem of Satisfying Constraints” (from p. 342), p. 342. Scope: complex behavior in physical and other natural systems" ;
    dct:type "general-principle" .
}

