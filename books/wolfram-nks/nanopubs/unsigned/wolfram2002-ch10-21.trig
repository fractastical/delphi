sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-21> a delphi:Claim ;
    rdfs:label "The core of human thinking is based on rather simple rules" ;
    dct:description "Despite the complicated construction of the brain, there is a core to human thinking that is largely independent of neural details and is based on rather simple rules, with nothing fundamentally special about the processes involved." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Human Thinking” (from p. 620), p. 628. Scope: human thinking and its emulation by artificial systems" ;
    dct:type "model-of-nature" .
}

