sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-18> a delphi:Claim ;
    rdfs:label "Axis crossings of Sin[x] + Sin[a x] follow a continued-fraction substitution system" ;
    dct:description "For a sum of two sine functions Sin[x] + Sin[a x], the arrangement of axis crossings is generated by a generalized substitution system whose rule at each step comes from successive continued fraction terms of (a - 1)/(a + 1), giving nested patterns when a is a quadratic irrational." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Mathematical Functions” (from p. 145), p. 146. Scope: zero sets of sums of two sinusoids" ;
    dct:type "mathematical" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <http://www.wikidata.org/entity/Q60413467> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-wolfram-nks-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "for any curve like Sin[x] + Sin[α x] the relative arrangements of these crossing points turn out to be related to the output of a generalized substitution system in which the rule at each step is obtained from a term in the continued fraction representation of (α - 1)/(α + 1)." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q60413467> ;
    prov:hadPrimarySource <https://www.wolframscience.com/nks/p146--mathematical-functions/> ;
    schema:pagination "p. 146" ;
