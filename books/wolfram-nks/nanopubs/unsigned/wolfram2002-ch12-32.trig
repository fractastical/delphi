sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-32> a delphi:Claim ;
    rdfs:label "Every axiom system used in current mathematical research is universal" ;
    dct:description "Basic logic and pure predicate logic are not universal, but adding a function or relation with more than one argument gives universality; arithmetic, set theory, group theory and ring theory are universal, and every axiom system actually used in current mathematical research is known to be universal, while heavily constrained systems such as commutative group theory and simplified real algebra and geometry are not." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Implications for Mathematics and Its Foundations” (from p. 772), p. 784. Scope: standard axiom systems of mathematics (logic, predicate logic, arithmetic, set theory, group theory, ring theory, real algebra, geometry)" ;
    dct:type "mathematical" .
}

