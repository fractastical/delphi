sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch12-14: partially-resolvable, resolvability 0.47";
    dc:description "Repetitive and nested elementary rules have known shortcuts that a public simulator can check against direct evolution, so the first clause is testable inside that class. The second clause quantifies over practically all remaining behavior, including natural systems, and a missed formula is weak evidence of irreducibility. Existing enumerations therefore probe a restricted proxy.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Classify small cellular automata as repetitive, nested, or neither, and check whether the first two classes have shortcuts while the others lack any procedure shorter than direct evolution. A nested rule with no shortcut, or a complex-looking rule with a large shortcut, would count against the corresponding clause.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Elementary-rule enumerations cover a small slice of the stated scope.", "Failure to find a shortcut leaves open whether a shortcut exists.", "Practically all and obviously simple are not tied to a measure over systems.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.65"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-14--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.473"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "open simulator for enumerating elementary and other small cellular automata and comparing direct evolution with shortcut procedures";
    prov:wasDerivedFrom <https://golly.sourceforge.net/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-14--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS";
    dc:description "published closed forms and sequences for repetitive and nested rules, including binomial rows related to rule 60";
    prov:wasDerivedFrom <https://oeis.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch12-14 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch12-14 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-14--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch12-14 by Grok 4.7: 0.6";
