    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-08--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch02-08: resolvable-now, resolvability 0.99";
    dc:description "This is a finite, deterministic claim with a fully specified rule and initial condition. Current software can check it exactly in seconds, including the transient and period.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Simulate rule 110 from a single black cell beyond step 2780 and compare configurations after 240-step shifts while accounting for spatial drift and the stated stripe interaction. Exact recurrence confirms the period and surviving structure; any mismatch refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The spatial region and equivalence convention for repeats must be specified.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.99"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-08--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.992"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-08--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
