sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch06-22: partially-resolvable, resolvability 0.59";
    dc:description "For Life and rule 110, persistent objects are already catalogued and can be rechecked, so the existential half holds for the standard exemplars. The sentence says any class 4 system must have such an object, and systems are placed in that class largely because persistent interacting objects are visible. A search confirms exemplars; it does not separate the sentence from the definition of the class.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For a rule labeled class 4 by its interacting objects, search finite seeds for a spatially localized periodic, possibly moving, object. Finding one supports the claim for that rule; a proof that every finite object dies would refute it for that rule.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A finite search can miss a very large immortal object and cannot prove that none exists.", "Any class 4 system is not a closed list.", "Persistent localized structures are close to the visual definition of class 4.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-22--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.586"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-22--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Catagolue";
    dc:description "public census of persistent localized objects in Life-like rules";
    prov:wasDerivedFrom <https://catagolue.hatsya.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-22--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "search rule 110 and other class 4 rules for oscillators and spaceships";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch06-22 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-22--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
