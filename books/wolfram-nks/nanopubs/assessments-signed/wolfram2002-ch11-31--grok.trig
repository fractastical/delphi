sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-31--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch11-31: partially-resolvable, resolvability 0.62";
    dc:description "The blank-tape half is a finite enumeration inside the reach of existing Turing-machine deciders, and it can be redone. The claim also says that more complicated inputs still resolve into a simple form, which a blank-tape census does not address. Samples of other inputs can support or weaken that half without covering it.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Run all 2,985,984 machines with 3 states and 2 colors from a blank tape and classify each as quickly periodic or nested. That census confirms or refutes the blank-tape sentence. The further sentence, about every more complicated initial condition, is tested only by sampling unless a proof covers all tapes.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Quickly and simple need time and classifier cutoffs before the blank-tape census is unique.", "There are infinitely many non-blank tapes, so examples that eventually simplify do not prove the universal claim.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.65"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-31--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.617"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-31--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Busy Beaver Challenge";
    dc:description "blank-tape enumeration and deciders for 2-symbol Turing machines with few states";
    prov:wasDerivedFrom <https://bbchallenge.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-31--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch11-31 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
