sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch09-10: needs-new-data, resolvability 0.32";
    dc:description "The contrast between generic and rule-specific features is meaningful once a rule class is fixed, and it would be settled by enumeration rather than by new laboratory measurements. Published rule explorations are a small, self-selected sample and do not score gravitation, quantum features, and mass spectra side by side. The necessary computational survey does not exist.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fix a class of candidate universe rules, enumerate a large sample, and score which of continuous space, gravitational and quantum features, particle-mass ratios, and spatial dimension appear. The claim is supported if the first group recurs across many rules while mass ratios and dimension stay rule-specific; it is refuted if those 'generic' features are as rare as the mass spectrum.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A survey large enough to separate generic from rule-specific features is far beyond a weeks-scale computation.", "There is no agreed enumerable class of candidate rules for the universe.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.57"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-10--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.317"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Physics Project";
    dc:description "public sample of evolving candidate rules, too small to estimate which features are generic";
    prov:wasDerivedFrom <https://www.wolframphysics.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch09-10 by Grok 4.7: 0.24";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
