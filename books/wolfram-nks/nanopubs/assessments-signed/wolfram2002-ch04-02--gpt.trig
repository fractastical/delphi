    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-02: resolvable-now, resolvability 0.81";
    dc:description "The existential claim can be settled by reproducible computations on precisely defined maps, with many public sequences available for cross-checking. Standard analyses can confirm complex finite behavior even though they may not prove all asymptotic properties.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Specify simple arithmetic maps and seeds, compute long trajectories, and quantify periodicity, growth, compressibility, and statistical irregularity. A single robust low-description-length example with high behavioral complexity confirms the existential core.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Finite runs can hide eventual periodicity.", "Highly complex remains dependent on chosen metrics.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.87"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-02--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.808"^^xsd:double;
