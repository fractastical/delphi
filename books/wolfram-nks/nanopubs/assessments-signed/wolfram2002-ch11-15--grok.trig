sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch11-15: partially-resolvable, resolvability 0.45";
    dc:description "Rule 110 and a handful of other simple systems are known to be universal, so the prediction can be probed inside small families. Most simple rules are still unclassified, and there is no measure under which an overwhelming share of simple rules has been shown universal. Existing proofs therefore test a sample, not the claim that universality is common across simple programs.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Choose explicit simplicity bounds, such as elementary cellular automata or Turing machines with a bounded state-symbol product, and compute the fraction with a finished universality proof or a finished non-universality proof. The prediction is supported if that fraction is high inside several families, and weakened if proofs keep universality rare among simple rules.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Common, wide range, and rather simple are not given numerical boundaries.", "Failure to prove universality is not evidence of non-universality.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.65"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-15--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.453"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: UniversalityDB";
    dc:description "census of simple systems whose universality has been formally recorded";
    prov:wasDerivedFrom <https://github.com/WolframInstitute/UniversalityDB>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-15--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cook 2004, Universality in Elementary Cellular Automata";
    dc:description "proof for one elementary rule and the small Turing machines reduced to it";
    prov:wasDerivedFrom <https://doi.org/10.25088/complexsystems.15.1.1>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch11-15 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-15--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-15--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch11-15 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-15--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-15--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch11-15 by Grok 4.7: 0.6";
