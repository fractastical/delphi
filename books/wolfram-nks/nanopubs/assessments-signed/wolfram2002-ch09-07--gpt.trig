    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch09-07: partially-resolvable, resolvability 0.40";
    dc:description "Many thermodynamic datasets exist, but only restricted formulations can be tested cleanly. The broad analogy to rule 37R and universal scope make the claim underdetermined without substantial reinterpretation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Specify closed natural systems, coarse-graining, entropy measure, and observation interval, then search existing records for reproducible entropy decreases inconsistent with fluctuation theory. A confirmed violation under those definitions would refute universality; ordinary local ordering with compensating entropy export would not.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Natural systems comparable to rule 37R are unspecified.", "System boundaries and coarse-graining determine apparent violations.", "The claim conflates randomness with thermodynamic entropy.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-07--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.396"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-07--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Science Data Portal";
    dc:description "public physical measurement datasets for narrowly specified thermodynamic tests";
    prov:wasDerivedFrom <https://data.nist.gov/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-07--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
