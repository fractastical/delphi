    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-16--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch02-16: partially-resolvable, resolvability 0.58";
    dc:description "Public software and bug benchmarks allow limited prediction and defect analyses. They are biased toward larger real projects and do not represent all simple programs, so the general prevalence claim remains partial.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Sample programs under a declared simplicity measure and compare human or automated predictions of behavior with actual runs; separately measure defect rates by program complexity. High error for simple programs and an association with bugs would support the operationalized version.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Bug frequency has many causes besides behavioral unpredictability.", "Source-code simplicity is encoding-dependent.", "Usually depends on an unspecified program distribution.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-16--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-16--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.578"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-16--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Software Heritage Archive";
    dc:description "public archive of source code for sampling and static complexity analysis";
    prov:wasDerivedFrom <https://www.softwareheritage.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-16--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Defects4J";
    dc:description "public benchmark of reproducible software bugs";
    prov:wasDerivedFrom <https://github.com/rjust/defects4j>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-16--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch02-16 by GPT-5.6 Sol: 0.6";
