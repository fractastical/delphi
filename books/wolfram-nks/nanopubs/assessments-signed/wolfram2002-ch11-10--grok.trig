sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch11-10: resolvable-now, resolvability 0.84";
    dc:description "The abstract implication is immediate once both lemmas are granted, and each lemma is a published construction rather than an existence guess. Rule 110 supplies a fully argued universal cellular automaton, and the book gives the emulators for the listed families. Reviewing those constructions is specialist work measured in weeks, not an open research problem.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Verify two lemmas: a universal cellular automaton exists, and each listed family has a construction that emulates an arbitrary cellular automaton. The emulator of the universal cellular automaton is then universal. The implication fails only if some listed family cannot emulate every cellular automaton or if no universal cellular automaton exists.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The cyclic-tag route is staged through tag systems and Turing machines, so a check must follow the whole chain rather than one picture.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-10--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.838"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: A New Kind of Science online";
    dc:description "published emulation constructions for mobile automata, Turing machines, substitution systems, tag systems, symbolic systems, and register machines";
    prov:wasDerivedFrom <https://www.wolframscience.com/nks/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-10--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Complex Systems";
    dc:description "archive containing the checked universality proof for rule 110, which supplies one universal cellular automaton";
    prov:wasDerivedFrom <https://www.complex-systems.com/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch11-10 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-10--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
