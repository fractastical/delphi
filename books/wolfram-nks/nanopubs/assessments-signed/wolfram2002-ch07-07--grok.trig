    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.88"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
