    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-07--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-07--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of wolfram2002-ch12-07 by Grok 4.7: 0.5";
