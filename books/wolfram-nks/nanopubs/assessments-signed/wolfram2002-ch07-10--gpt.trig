<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-10--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch07-10: partially-resolvable, resolvability 0.57";
    dc:description "Controlled repeated-run datasets can test selected systems and compare mechanism predictions. Existing public data seldom measure perturbations finely enough, and repeatability is not uniquely diagnostic of intrinsic randomness generation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use repeated runs with measured and tightly controlled initial conditions, align trajectories, and quantify exact or local-pattern reproducibility as perturbation size is varied. Compare with runs receiving controlled environmental noise and with deliberately varied initial states.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Deterministic chaos can make intrinsic dynamics nonrepeatable after tiny perturbations.", "Microscopic state cannot usually be reset exactly.", "Unmeasured environmental inputs can mimic intrinsic sensitivity.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-10--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.57"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-10--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "public repeated-run experimental datasets for selected systems";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-10--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
