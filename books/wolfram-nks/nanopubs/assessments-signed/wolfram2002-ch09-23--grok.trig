sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-23--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch09-23: partially-resolvable, resolvability 0.57";
    dc:description "Observed masses are public and precise, and it is immediate that they do not lie in simple ratios. The claim retreats to unknown fundamental masses after subtracting a scheme-dependent interaction energy, so the tables test only the surface reading. The hedged remainder is not fixed tightly enough for those tables to confirm or refute it.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Test published lepton and quark masses for simple rational or other pre-registered relations, then repeat the test on a stated definition of mass with interaction energy removed. Simple relations among observed masses would confirm the strong reading; their absence only touches the claim if the interaction-energy subtraction is fixed in advance.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'May' plus an allowance for interaction energy makes the claim hard to refute.", "How much of a measured mass is interaction energy depends on the renormalization scheme.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-23--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.569"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-23--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Particle Data Group";
    dc:description "high-precision measured masses of leptons and quarks";
    prov:wasDerivedFrom <https://pdg.lbl.gov/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-23--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
