sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-21--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch04-21: partially-resolvable, resolvability 0.48";
    dc:description "On the shift map the claim is the digit identity already settled by proof: sensitive dependence displays digits that were in the seed. Extending the same moral to every chaotic system, including ones Wolfram thinks generate randomness intrinsically, requires a decomposition of randomness that the simulations do not force. Rivals who treat sensitive dependence as the source of randomness read the same orbits differently, so only the shift-map case is a clean test.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For the shift map, use the digit-shift identity: sensitive dependence only reveals later digits of the seed. For maps that also look random from simple seeds, separate amplified seed differences from irregularity already present at the simple seed. The general claim is confirmed only if that separation can be made; it is refuted if some system produces irregular output from a simple seed with no sensitive dependence, or if sensitive dependence is shown to add new irregularity beyond the seed.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The general principle covers all chaotic systems, while the clean argument is specific to digit shifts.", "Whether sensitive dependence 'produces' randomness depends on whether one describes the state by its size or by its digits.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-21--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-21--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Python";
    dc:description "compare orbits of nearby seeds for the shift map and for the intrinsically irregular maps";
    prov:wasDerivedFrom <https://www.python.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-21--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch04-21 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-21--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-21--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch04-21 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
