    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-01--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-01--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
