sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch04-18: resolvable-now, resolvability 0.79";
    dc:description "Both sides of the claimed correspondence are explicit: a trigonometric zero set and a substitution rule read off a continued fraction. Long numerical comparisons are routine, and the underlying combinatorics is the standard theory of mechanical words for two irrational frequencies. A mismatch of the stated formula would refute this wording even if a nearby formula were true, so the test discriminates the claim as written.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For a range of alpha, compute the sign changes of sin(x) + sin(alpha x) and compare them with the generalized substitution system driven by the continued-fraction terms of (alpha-1)/(alpha+1). Systematic mismatch refutes the identity; agreement on long prefixes, together with the Sturmian coding of two-frequency crossings, confirms it. Quadratic irrationals should additionally yield nested patterns.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Crossings that fall extremely close to zero need validated numerics so that a rounding error is not counted as a mismatch.", "The exact prefactor (alpha-1)/(alpha+1) might differ from the classical slope coding by a transformation that has to be checked rather than assumed.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-18--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.793"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS";
    dc:description "continued-fraction terms and Sturmian or mechanical words used as the predicted crossing patterns";
    prov:wasDerivedFrom <https://oeis.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-18--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Python";
    dc:description "high-precision axis crossings of sums of two sinusoids for comparison with the substitution system";
    prov:wasDerivedFrom <https://www.python.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch04-18 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-18--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-18--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch04-18 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-18--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-18--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch04-18 by Grok 4.7: 0.8";
