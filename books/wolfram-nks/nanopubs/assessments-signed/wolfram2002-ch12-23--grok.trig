sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-23--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch12-23: resolvable-now, resolvability 0.80";
    dc:description "The search space is finite and small, and classifying two-state two-color machines is within standard exhaustive methods. Re-running the census under the stated convention confirms or refutes the list of growth rates directly. Blank-tape busy-beaver tables check the same family of machines and use a different input convention, so the exact census is recomputed rather than downloaded.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate all 4096 two-state two-color machines under the head-exits-right convention, group them by the function computed, and compare maximum halting time with input length. The claim holds if those maxima are only linear, quadratic, or exponential and every exponential machine has a partner computing the same function in a bounded number of steps.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Asymptotic growth has to be proved for each machine, beyond plots for short inputs.", "Wolfram's halting convention, the head leaving to the right, must be matched or the census answers a different question.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-23--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.802"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-23--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Busy Beaver Challenge";
    dc:description "public enumeration and verification framework for small Turing machines, used to cross-check the two-state two-color model under a blank-tape convention";
    prov:wasDerivedFrom <https://bbchallenge.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-23--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch12-23 by Grok 4.7: 0.72";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-23--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-23--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
