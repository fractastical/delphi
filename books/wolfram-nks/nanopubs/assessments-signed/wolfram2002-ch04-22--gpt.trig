    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-22--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.808"^^xsd:double;
