<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-03--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch11-03: not-empirically-resolvable, resolvability 0.14";
    dc:description "Whether a notion is crucial to understanding is not fixed by the existence of universal systems or by pictures of natural patterns. One can study complexity with or without universality and still describe the same observations. The sentence does not entail a measurable difference between it and its rivals.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/none";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: The claim says universality is crucial for characterizing natural complexity. Crucial is a judgment of scientific usefulness, and no pre-specified observation would show that the concept is indispensable rather than merely sometimes helpful.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Explanatory success of particular models would test those models, not the claim that universality is crucial.", "Usefulness of a concept does not have an agreed confirming or refuting measurement.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.143"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "not-empirically-resolvable".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-03--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
