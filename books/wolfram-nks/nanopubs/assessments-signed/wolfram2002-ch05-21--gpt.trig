    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Choose matched finite grammars of constraints and evolution rules, a sampling measure, and complexity metrics for their generated patterns, then compare the frequency of high-complexity outcomes. The claim is supported only if the result is robust across reasonable encodings and metrics.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No canonical measure over “simple” systems.", "Pattern complexity has competing definitions.", "Rule and constraint formalisms are difficult to match fairly.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-21--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-21--gpt--dataset-2>;
