    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-20--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-20: partially-resolvable, resolvability 0.79";
    dc:description "Exact arithmetic and standard tests can decisively examine the named maps and seeds over long finite ranges. They cannot prove unrestricted randomness or fully separate generated complexity from information implicit in mathematical constants and encoding.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Iterate each exactly specified map from low-description-length rational seeds and test trajectories for periodicity, compressibility, and statistical irregularity. Irregular output from a fixed simple seed supports finite-scale intrinsic generation; proof of a simple orbit would refute it for that example.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Finite-precision arithmetic can create spurious cycles.", "Random-looking output is test-relative.", "Simplicity and intrinsic generation depend on representation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.87"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-20--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.787"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-20--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Statistical Test Suite";
    dc:description "public software for testing encoded map trajectories";
    prov:wasDerivedFrom <https://csrc.nist.gov/projects/random-bit-generation/documentation-and-software>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-20--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
