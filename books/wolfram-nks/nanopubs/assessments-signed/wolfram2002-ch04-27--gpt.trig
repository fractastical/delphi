    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-27--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-27: partially-resolvable, resolvability 0.48";
    dc:description "Many proposed correspondences can be sought and reproduced with existing solvers and catalogs. The nearly universal scope and open-ended phenomenon class cannot be exhausted, making only finite subsets resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: List a finite preregistered taxonomy of discrete phenomena, then search specified low-complexity continuous models for robust instances under numerical refinement. Missing phenomena after systematic searches weaken the finite taxonomy claim, while examples confirm individual correspondences.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A complete taxonomy of discrete phenomena is unavailable.", "Essentially all and fairly simple are undefined.", "Failure to find a continuous analogue does not prove absence.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-27--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-27--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.478"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-27--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PDEBench";
    dc:description "public simulation data for several continuous dynamical systems";
    prov:wasDerivedFrom <https://github.com/pdebench/PDEBench>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-27--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Atlas of Simple Programs";
    dc:description "public discrete-system examples defining comparison phenomena";
