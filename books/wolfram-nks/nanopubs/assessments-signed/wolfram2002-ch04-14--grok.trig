    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-14--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-14--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch04-14 by Grok 4.7: 0.85";
