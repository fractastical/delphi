sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-23> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-23--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-23--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-23: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.49"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The spreading clause is an ordinary simulation: one-cell perturbations of rules such as rule 30 can be measured and either stay localized or fill the light cone. The clause about proofs is methodological. Simulation can show that the usual glider-component route lacks stable pieces, without showing that no proof of any kind exists." ;
    rdfs:comment "Proposed test with existing data: For agreed class-3 rules, flip one cell on a random background and measure the fraction of the light cone that eventually differs. Confirm uncontrolled spread if the difference reaches essentially the whole cone; the further claim that this makes component-style proofs very difficult is supported only as a record of which proof techniques succeed." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Very difficult is a judgment about proof search, and a later successful construction would not erase the historical difficulty.", "Class 3 itself is a visual category, so membership of borderline rules is not unique." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-23--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-23--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-23 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
