sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-22--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-22--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-22: partially-resolvable, resolvability 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.553"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Existing proofs resolve the neighboring statements: two pairs are decidable, and five pairs suffice for undecidability. The sentence at issue is the three-pair case, which those proofs explicitly leave open. Machine-checked searches of bounded word lengths show that individual three-pair puzzles can be extremely hard, and a uniform decision procedure or an undecidability reduction is still required for the general claim." ;
    rdfs:comment "Proposed test with existing data: A decision procedure for every three-pair instance would refute undecidability; a reduction from the halting problem to three-pair Post correspondence would confirm it. Published proofs already settle the two-pair case as decidable and the five-pair case as undecidable, and they leave the three-pair threshold open." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The general three-pair problem is open; resolved finite instances leave the infinite family undecided.", "Long minimal solutions show practical difficulty and are compatible with a yet-unknown decision procedure." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-22--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-22--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-22 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-22--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-22--grok--operationalizability> .
