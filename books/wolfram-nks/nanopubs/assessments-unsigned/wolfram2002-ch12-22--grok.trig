  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-22--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Neary, Undecidability of the Post Correspondence Problem for Five Pairs" ;
    dct:description "published proof that five-pair Post correspondence is undecidable, stating that two pairs are decidable and that three and four pairs remained open" ;
    prov:wasDerivedFrom <https://doi.org/10.4230/LIPIcs.STACS.2015.649> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-22--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: PCP[3,4] machine-checked instance proofs" ;
    dct:description "solutions and unsolvability proofs for bounded three-pair instances, a finite fragment of the general three-pair problem" ;
    prov:wasDerivedFrom <https://github.com/Mojashi/pcp-3-4-proofs> .
