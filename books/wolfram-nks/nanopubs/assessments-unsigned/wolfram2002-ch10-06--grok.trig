sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-06: not-empirically-resolvable, resolvability 0.12" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.121"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    dct:type "resolution-route/none" ;
    delphi:hasConfidence "0.83"^^xsd:double ;
    dct:description "Wolfram defines apparent complexity as the failure of our perception and analysis to find a short description of the features we care about. That is a conceptual identification, and the dependence on chosen features is part of the definition rather than a parameter to estimate. No public measurement would confirm or refute it." ;
    rdfs:comment "Proposed test with existing data: The claim equates calling something complex with a failure to find a short description of chosen features. Changing which features are chosen changes the verdict by the claim's own terms, so there is no independent measurement that would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Complexity is defined relative to the observer's chosen features, so the claim cannot fail against an observer-independent dataset.", "The sentence is an account of what the word means, not a prediction about particular objects." .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-06 by Grok 4.7: 0.22" ;
