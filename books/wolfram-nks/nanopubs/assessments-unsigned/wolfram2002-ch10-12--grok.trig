sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-12: partially-resolvable, resolvability 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.515"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Pitch and the hearing of periodic sounds are heavily measured, which covers the positive half of the claim. The negative half, that nested or other non-repetitive structure is heard as noise, needs stimuli built from discrete sequences of the kind Wolfram considers. Those comparisons exist mainly as scattered studies, not as a dataset matched to the claim's scope." ;
    rdfs:comment "Proposed test with existing data: Synthesize sounds from sequences that are periodic, nested, or otherwise non-repetitive but spectrally matched, and test whether listeners identify structure beyond pitch and a few spectral peaks. Identification limited to repetition at definite frequencies would support the claim; reliable detection of nested or other non-repetitive structure would refute 'essentially nothing else'." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Listeners also report timbre, envelope, and speech-like structure, so the stimulus class 'fairly uniform sequences' has to be enforced.", "Sounds that carry nested structure are scarce in existing listening-test archives." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-12--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-12 by Grok 4.7: 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.68"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch10-12 by Grok 4.7: 0.5" ;
