  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-12--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: CRCNS" ;
    dct:description "public auditory-neuroscience datasets; listening tests on nested discrete-sequence sounds are not a standard holding" ;
    prov:wasDerivedFrom <https://crcns.org/> .
