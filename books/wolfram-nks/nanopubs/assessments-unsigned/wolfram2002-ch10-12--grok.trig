    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of wolfram2002-ch10-12 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/data-adequacy" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-12--grok--data-adequacy> .
