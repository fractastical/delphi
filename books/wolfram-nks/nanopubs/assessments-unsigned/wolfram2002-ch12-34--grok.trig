sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-34> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-34--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-34--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-34: resolvable-now, resolvability 0.79" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.787"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Both ingredients are published and checkable: rule 110 is universal by Cook's proof, and incompleteness of arithmetic is a formalized theorem. The distinctive step is the integer equation that emulates rule 110, which is explicit and is a finite certificate a proof-oriented check can accept or reject. The claim is this implication, and the resources to check it exist." ;
    rdfs:comment "Proposed test with existing data: Verify that solutions of the stated exponential Diophantine equation encode rule 110 histories, using the published proof that rule 110 is universal, and apply the standard translation from an undecidable cellular-automaton question to a statement independent of arithmetic. A break in the encoding refutes this derivation; a checked encoding confirms it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The displayed exponential Diophantine equation is large, so checking every clause is specialist work.", "Other proofs of incompleteness exist, so a gap in this encoding would refute the route rather than incompleteness itself." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-34--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-34--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-34--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-34 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.84"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-34--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-34> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-34--grok--operationalizability> .
