  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-14--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Cook 2004, Universality in Elementary Cellular Automata" ;
    dct:description "published proof that rule 110 emulates cyclic tag systems and hence Turing machines" ;
    prov:wasDerivedFrom <https://doi.org/10.25088/complexsystems.15.1.1> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-14--grok--dataset-2> a delphi:EvidenceItem ;
