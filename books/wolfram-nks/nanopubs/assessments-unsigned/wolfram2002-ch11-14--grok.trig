sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-14--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-14: resolvable-now, resolvability 0.89" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.885"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    dct:description "Universality of this one rule is a mathematical statement with a published, cited proof and an explicit glider construction. A competent team can audit that proof and resimulate its components with existing software. The result covers the rule as stated, including emulation of arbitrary cyclic tag systems after the bookkeeping reduction." ;
    rdfs:comment "Proposed test with existing data: Check a published reduction from an arbitrary cyclic tag system, or an arbitrary Turing machine, to initial conditions of rule 110, and check that glider collisions implement the tag steps. Successful emulation confirms universality; a gap that leaves some tag systems unemulated would refute the proof as a proof of the full claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The construction constrains tag blocks and then removes the constraint by a further reduction, so a partial replay of one picture is not the whole proof." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-14--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-14 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-14--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-14--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-14--grok--data-existence> a delphi:LLMClaimAssessment ;
