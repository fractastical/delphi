sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-05--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-05--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch03-05: resolvable-now, resolvability 0.93" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.933"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.95"^^xsd:double ;
    dct:description "The complete rule space is small enough for exhaustive modern computation. Qualitative edge cases require classification choices, but the numerical prevalence and cited behavior types are directly checkable." ;
    rdfs:comment "Proposed test with existing data: Enumerate all 2187 three-color nearest-neighbor totalistic rules from one gray cell and classify trajectories using stated periodicity, randomness, and localized-structure criteria. The exact regular fraction can then be compared with 85 percent and exceptional classes inspected." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Ultimately regular may require long transients or proofs.", "Random-looking and rule-110-like need operational thresholds." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-05--gpt--dataset-2> .
