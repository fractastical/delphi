  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-18--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch06-18: partially-resolvable, resolvability 0.77" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.767"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.79"^^xsd:double ;
    dct:description "Individual block emulations are exact and readily verified using existing rule definitions. Their claimed prevalence is only measurable relative to bounded encoding choices." ;
    rdfs:comment "Proposed test with existing data: Enumerate block encodings up to a fixed width for cellular-automaton pairs and verify the commuting relation between encoded evolution and the emulated rule. Report the proportion of source rules with at least one nontrivial emulation and reproduce the rule 126-to-90 example." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "“Common” requires a measure over rules and encodings.", "Unbounded block widths cannot be exhaustively searched.", "Trivial encodings must be excluded explicitly." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-18--gpt--dataset-1> .
