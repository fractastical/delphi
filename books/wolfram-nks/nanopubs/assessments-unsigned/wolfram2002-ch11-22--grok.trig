sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-22--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-22--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-22: partially-resolvable, resolvability 0.33" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.333"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "Particular systems can be placed on one side or the other when a proof exists, as with rule 110 and the additive rules. The claim covers essentially every non-nested system, and for a typical system neither universality nor a hidden nested form is known. Existing proofs therefore speak to examples, while the general expectation stays out of reach of a finite computation." ;
    rdfs:comment "Proposed test with existing data: Call a system fundamentally repetitive or nested only if every evolution has a proved periodic or substitution form, and call it universal if it emulates a Turing machine. The expectation is refuted by one system outside that class that is proved non-universal, and it is not confirmed by complexity of appearance alone." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "More or less any and in the end make the quantifier and the deadline undefined.", "Absence of a universality proof does not prove non-universality, so failed searches do not refute the expectation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-22--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-22--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-22 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-22--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-22--grok--operationalizability> .
