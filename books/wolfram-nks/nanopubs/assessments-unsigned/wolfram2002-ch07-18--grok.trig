sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-18--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-18: partially-resolvable, resolvability 0.69" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.685"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "The target densities are mathematical and the two-dimensional case is classical, so the comparison itself is sharp. Laboratory results on random close packing are public but dispersed, and they show both jamming under simple agitation and crystallization under more careful driving. The claim is therefore decidable for specified protocols and not as an unqualified never across every way of jiggling." ;
    rdfs:comment "Proposed test with existing data: Compare measured packing fractions of identical disks under lateral compression, and of identical spheres under compression or vibration, with the proved maxima (hexagonal packing in two dimensions, about 0.74 in three). Disks reaching the hexagonal fraction, and spheres remaining well below the three-dimensional maximum under ordinary pushing and jiggling, would support the claim; spheres that routinely crystallize into the densest packing under those protocols would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Outcome depends on the agitation protocol: shearing and slow annealing can crystallize spheres that gentle jiggling leaves jammed.", "Experimental packing fractions are scattered across papers rather than held in one open campaign." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-18 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-18--grok--operationalizability> .
