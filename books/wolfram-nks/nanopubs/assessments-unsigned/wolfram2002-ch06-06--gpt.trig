sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-06--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch06-06: partially-resolvable, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.78"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Activity is directly measurable and parameterized continuous families allow clean transition tests. The assertion that this commonly holds across rule sequences remains dependent on how those sequences are chosen." ;
    rdfs:comment "Proposed test with existing data: Measure asymptotic active-cell density and persistence across ordered parameterized rule sequences, then locate class 4 labels relative to transitions from localized periodic to extensive chaotic activity. Compare transition enrichment against randomized rule orderings." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "There is no canonical ordering of discrete rules.", "Class and transition labels are partly qualitative.", "Finite-time activity can be misleading." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-06--gpt--dataset-2> .
