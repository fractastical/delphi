sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-08--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-08: partially-resolvable, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.707"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The 5-neighbor totalistic rules that preserve a white background are a small finite list, and Life is simulated and censused in public software, so the slice comparison and the white-background clause are practical. The sentence says two-dimensional cellular automata in general show the same four classes, which that list does not cover. Slices are a useful proxy and also a possible confound." ;
    rdfs:comment "Proposed test with existing data: Evolve the small two-dimensional totalistic rules and the Game of Life from random and near-blank seeds, then classify one-dimensional slices by the same activity and damage criteria used in one dimension. Failure of those slices to use all four types, or failure of Life to sustain localized objects on a white background, would challenge the corresponding clause." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A one-dimensional slice can display a class the full two-dimensional field does not.", "Small totalistic codes do not exhaust two-dimensional rules.", "Life is much better archived than the general two-dimensional claim." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-08--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-08 by Grok 4.7: 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.64"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-08--grok--operationalizability> .
