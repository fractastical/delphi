sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-22: resolvable-now, resolvability 0.79" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.789"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "Annihilating and coalescing boundaries are a standard stochastic process, and the named cellular automata are small computations. The genealogy of mergers is a concrete object, so the nested-tree description can be confirmed or replaced by a counterexample inside the stated class. That is a computation, not a new observation of nature." ;
    rdfs:comment "Proposed test with existing data: Simulate rules 184 and 110 and a family of domain models whose boundaries annihilate on contact, including random-walk boundaries, and test whether the merger genealogy is a nested tributary tree. A nested merger tree across that family would support the claim; a broad class of independently growing, then merging, domains whose genealogy is not nested would refute the essentially any quantifier." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Fairly independently has to be defined before the family of systems is closed.", "Nesting in rule 110 is approximate once the localized structures are coarse-grained." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-22--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-22 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-22--grok--operationalizability> .
