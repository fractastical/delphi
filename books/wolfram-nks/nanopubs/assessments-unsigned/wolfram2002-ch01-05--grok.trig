sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-05--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch01-05: resolvable-now, resolvability 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.749"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The asserted finding is that the same overall forms recur across simple programs almost independently of the rule details. Those families are small enough to sample with ordinary simulators, and the book's diagrams fix the conventions. The hedged remark about nature is not the decision criterion for this computational statement. Fuzzy class edges lower operationalizability without making the comparison unrunnable." ;
    rdfs:comment "Proposed test with existing data: Fix four behavior classes (uniform or periodic, nested, apparently random, and localized structures) and apply them to samples of cellular automata, Turing machines, substitution systems, tag systems, and register machines. The claim is confirmed if the same classes recur across families, and refuted if some standard family produces a robustly new kind of overall behavior." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Class boundaries, especially between randomness and localized structure, move with the chosen statistics.", "The suggestion that the same classes govern nature is a further empirical claim and is not settled by the program survey." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch01-05 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-05--grok--operationalizability> .
