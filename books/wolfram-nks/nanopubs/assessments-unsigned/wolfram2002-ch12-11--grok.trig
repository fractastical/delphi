sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-11--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-11: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.465"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "For rule 30, arbitrarily long samples can be generated and subjected to published statistical and algebraic tests, which is enough to hunt specific hidden regularities. A found closed form would refute the claim for that system. No such test, and no universality proof, establishes the general statement that there is no hidden regularity in any large class of complex systems." ;
    rdfs:comment "Proposed test with existing data: Fix a class, such as rule 30 and a list of similar rules, and a catalog of candidate regularities stricter than periodicity and nesting, including algebraic closures, conserved quantities, and standard randomness tests. Discovery of such a regularity in a large subclass refutes the claim for that class; passing the catalog supports only the absence of those particular regularities." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Tests can detect only regularities they are designed to find; passing them does not prove that no regularity exists.", "Any large class is undefined until the class is listed." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-11 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
