sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-21--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-21: partially-resolvable, resolvability 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.425"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "River networks are a clear building-up case with public hydrography, and some organisms have a known branching development. Most nested forms in nature lack the time or mechanism data needed to assign an origin, so a frequency of more common cannot be estimated for the full scope. Existing resources test examples, not the global suspicion." ;
    rdfs:comment "Proposed test with existing data: Assemble nested natural patterns with a recorded growth direction or a time series, and class each as successive splitting or as aggregation and merging. A majority in the building-up class would support the frequency claim inside that sample; a majority of splitting or branching origins would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Many nested forms have no observation that distinguishes splitting from building up.", "More common is undefined without a sampling frame over natural nested patterns." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-21 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-21--grok--operationalizability> .
