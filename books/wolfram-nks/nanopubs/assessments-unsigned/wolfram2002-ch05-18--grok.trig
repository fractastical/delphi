sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-18--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch05-18: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.648"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Constraint 18762389 is explicitly described, and its nested coloring can be checked against the twelve templates in weeks. The claim also says it is the first such constraint after more than 18 million trials and that the coloring is the only one, which is a large search plus an infinite-grid uniqueness argument. Public material settles the single picture much more readily than the priority and uniqueness clauses." ;
    rdfs:comment "Proposed test with existing data: Reconstruct the book's numbering, force constraint 18762389 from its required template, and test whether the resulting coloring is the published base-2 nested pattern and whether any earlier constraint already has no repetitive solution. An earlier aperiodic example, or a second infinite coloring, would refute the corresponding clause." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Uniqueness on the infinite grid needs a forcing argument, not only a finite picture.", "Showing this constraint is first requires the same standard on more than 18 million predecessors.", "The numbering scheme has to be reconstructed before the index can be audited." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-18--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch05-18 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
