sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-18--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-18: needs-new-data, resolvability 0.27" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.267"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.48"^^xsd:double ;
    dct:description "Causal invariance is a sharp property of a rewrite system, and it is checkable for any fully specified rule. The claim applies it to the universe's actual rules, which are not in hand, and the single history we observe does not distinguish that mechanism from standard relativistic spacetime. Settling it requires either those rules or a new signature of non-invariance." ;
    rdfs:comment "Proposed test with existing data: Once a candidate rule for the universe is fixed, test whether every allowed update order produces one causal network. A rule that reproduces observed physics and is causally invariant would support the claim; a rule that reproduces physics only along some orders, with observable branching, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A unique perceived history is also predicted by ordinary continuum spacetime, so it does not isolate causal invariance.", "The actual update rule is unknown, so the property cannot be evaluated on the object the claim is about." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-18 by Grok 4.7: 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.38"^^xsd:double ;
