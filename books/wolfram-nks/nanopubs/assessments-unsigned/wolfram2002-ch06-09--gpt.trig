sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-09--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-09--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch06-09: partially-resolvable, resolvability 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.849"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "Damage spreading has standard measurable variables and is easy to simulate across large catalogs. The characteristic trend is well testable, but universal class-wide assertions require formal class definitions or proofs." ;
    rdfs:comment "Proposed test with existing data: For labeled rules in each class, flip one initial cell and measure damage survival, radius, propagation speed, and intermittency over time and random backgrounds. Compare the distributions with the four predicted signatures." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Universal words such as “always” admit exceptional rules and backgrounds.", "Class labels can be circularly related to perturbation behavior.", "Finite runs miss late spreading." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-09--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-09--gpt--operationalizability> a delphi:LLMClaimAssessment ;
