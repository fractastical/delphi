sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-32> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-32--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-32--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-32: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.775"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "The growth of a particular short combinator and the rule-110 emulator are finite symbolic computations that can be rerun exactly. Universality of the S-K calculus is a classical theorem, and the rule-110 expression is a concrete witness linking that theorem to the pictures. The impression of randomness is the only part that statistical tests cannot finish." ;
    rdfs:comment "Proposed test with existing data: Iterate the S and K rules from the published length-8 expression and measure expression size, and separately apply the published combinator that is supposed to implement one step of rule 110. Exponential growth confirms that instance; a step-by-step match confirms the emulation. Statistical tests of the internal structure address seemingly random without proving the absence of regularity." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Seemingly random internal structure can fail statistical tests and still have an undetected regularity.", "Historical universality of combinators uses the standard S and K calculus; the pictures alone do not re-prove that theorem." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-32--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-32--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-32--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-32 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-32--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-32> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-32--grok--operationalizability> .
