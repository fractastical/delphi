sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-50> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-50--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-50--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-50: needs-new-data, resolvability 0.28" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.277"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.56"^^xsd:double ;
    dct:description "Radio surveys publicly archive astronomical emission and the results of narrowband searches. They do not contain messages identified as extraterrestrial communications, which is the variable the prediction concerns. Until such a corpus exists, a noise-like recording fits both the claim and the hypothesis that the recording is natural." ;
    rdfs:comment "Proposed test with existing data: On signals independently known to be communications of a non-human technological civilization, measure repetition, spectral lines, and compressibility. Essentially no detectable regularities would support the claim for ongoing traffic; stable recognizable carriers in that traffic would refute it. Beacons meant to be noticed are excluded and scored separately." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A noise-like spectrum is the prediction both for compressed messages and for ordinary astrophysical emission.", "No confirmed extraterrestrial communication corpus exists.", "The beacon exception makes non-detection of carriers compatible with the claim." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-50--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-50--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-50--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-50 by Grok 4.7: 0.5" ;
