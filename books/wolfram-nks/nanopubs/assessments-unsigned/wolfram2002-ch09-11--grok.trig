sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-11--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-11: partially-resolvable, resolvability 0.44" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.436"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.56"^^xsd:double ;
    dct:description "Many familiar laws, including continuum thermodynamics and fluid mechanics, already have published derivations from more microscopic models, so that part of the claim can be checked. Particle data show other regularities still put in by hand. Without a census of laws and without the ultimate rule, 'the vast majority' and the claim that their simplicity says little about that rule stay only partly tested." ;
    rdfs:comment "Proposed test with existing data: Classify published physical laws by whether they are derived as large-scale limits of a more microscopic theory or are inputs with no such derivation, then ask whether the simple derived laws constrain the microscopic rule. A census in which most textbook laws are effective theories supports the claim; a finding that most laws are irreducible inputs would refute the 'vast majority'." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'Truly fundamental' is defined only relative to an unknown ultimate rule.", "There is no canonical list of 'physical laws discovered so far' on which to compute a majority." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-11 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-11--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-11--grok--data-existence> a delphi:LLMClaimAssessment ;
