sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-12: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.78"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "For the families actually constructed in the chapter, mutual emulation is a chain of explicit reductions, and the Church-Turing equivalence says they determine the same class of computations. The constructions are public and finite. The word essentially leaves the boundary of the class slightly soft, but not soft enough to block a check of the systems named." ;
    rdfs:comment "Proposed test with existing data: For the named families, check mutual emulation of a universal member. Confirm if each family can realize exactly the Turing-computable input-output maps; refute if some named family computes a non-Turing function or cannot emulate a Turing machine." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Equivalence of computable functions does not settle equivalence of runtime, or of behavior from typical initial conditions." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-12 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok--operationalizability> .
