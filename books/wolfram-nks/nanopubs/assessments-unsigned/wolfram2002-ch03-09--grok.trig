sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-09--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-09: resolvable-now, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.706"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "The numerical claim is a rate, about five per million, in a completely defined ensemble of four-state two-color machines. Sampling millions of short blank-tape runs estimates that rate to within the slack of the word 'about,' and the same sample design compares five or more states. A full enumeration is unnecessary for a rate, and the classifier has to be frozen in advance." ;
    rdfs:comment "Proposed test with existing data: Sample two-color Turing machines with four or more head states on a blank tape, apply a fixed randomness classifier, and estimate the hit rate. The claim is confirmed if four-state rules yield on the order of five random-looking patterns per million and additional states raise that rate only slightly, and refuted if the rate is far from that or jumps sharply with more states." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The four-state space has about four billion rules, so the rate is estimated by sampling rather than by a full census.", "Seemingly random is classifier-dependent, and the same classifier must be used at every state count." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-09--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-09 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
