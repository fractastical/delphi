sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-08--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-08: partially-resolvable, resolvability 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.618"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Deterministic simulations already produce turbulence, which bears directly on the claim that molecular noise is not required. Separating that intrinsic cascade from disturbances that entered through the boundaries is much harder in experiments, and public databases are single realizations of a few geometries. The claim is testable for those flows and not as a statement about turbulent fluids in general." ;
    rdfs:comment "Proposed test with existing data: Compare deterministic Navier-Stokes simulations that contain no molecular noise with the same flows under added microscopic noise or altered inflow perturbations, and attribute the turbulent variance by scale. Turbulence that persists without molecular noise and without external forcing fluctuations would support intrinsic large-scale generation; turbulence that disappears when those sources are removed would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Laboratory inflows and boundaries always inject disturbances, so an external contribution is hard to set to zero.", "Mostly is a partition of variance that different decompositions assign differently." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-08--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-08 by Grok 4.7: 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.65"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-08--grok--operationalizability> .
