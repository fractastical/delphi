  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-13--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: NCBI" ;
    dct:description "mollusc genome assemblies, which do not yet map the pigmentation programs whose length is at issue" ;
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/> .
