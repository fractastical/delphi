sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-13--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-13: needs-new-data, resolvability 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.35"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Program length is a measurable quantity once the responsible regulatory program is identified, so the prediction is testable in principle. Public genomes and taxonomic catalogs do not contain those programs or their lengths, and the diversity proxy does not decide brevity. Resolving the claim requires data that have not been collected." ;
    rdfs:comment "Proposed test with existing data: Identify the gene-regulatory elements that control shell pigmentation and measure their functional length, then test whether that length is short relative to a pre-registered baseline. Within-species pattern variety is only a proxy: high variety together with a short mapped program would support the claim, while a long program would refute it even if patterns vary." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Pattern variety can come from many polymorphic loci in a long program, so diversity does not measure length.", "The pigmentation programs for shell patterns have not been isolated for a representative set of species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-13 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-13--grok--operationalizability> .
