sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-21--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-21--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch06-21: partially-resolvable, resolvability 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.679"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The network size is precise once the regular-language construction is fixed, and representative rules can be computed. Coverage sufficient for “most class 3 and 4 rules” and asymptotic lower bounds is much harder." ;
    rdfs:comment "Proposed test with existing data: Construct minimal finite automata recognizing length-unbounded configurations reachable after t steps and measure node count versus t for classified rules. Fit polynomial and exponential growth models and separately identify surjective rules." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Automaton minimization becomes exponentially expensive.", "Finite t does not establish asymptotic growth.", "Class labels and “most” require sampling choices." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-21--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-21--gpt--operationalizability> a delphi:LLMClaimAssessment ;
