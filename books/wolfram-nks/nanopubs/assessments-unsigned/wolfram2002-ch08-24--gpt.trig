sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-24--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-24--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch08-24: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.651"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Public 3D morphology supports direct tests of smooth geometric relatedness across many taxa. Paired developmental growth-rate data are much less complete, limiting mechanistic inference. Existing resources can resolve geometric and selected developmental subsets, not the broad causal statement." ;
    rdfs:comment "Proposed test with existing data: Register three-dimensional shapes of related animals, fit low-dimensional smooth deformation fields, and compare inferred regional scaling with measured developmental growth rates. The claim is supported when simple growth-rate differences predict held-out adult shape differences better than alternatives." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Adult transformations do not uniquely identify developmental growth processes.", "Time-resolved growth data are sparse relative to mature morphology.", "Largely and simple require variance and complexity thresholds." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-24--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-24--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-24--gpt--operationalizability> a delphi:LLMClaimAssessment ;
