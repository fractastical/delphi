  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-23> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-23--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-23--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch11-23: partially-resolvable, resolvability 0.43" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.435"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "Damage spreading and localized structures are computable for finite samples. Existing analyses cannot cleanly establish that uncontrolled flow causes proof difficulty in general or excludes other proof methods." ;
    rdfs:comment "Proposed test with existing data: Measure damage spreading from single-cell perturbations and compare the availability of persistent localized structures and proof constructions across classified rules. A strong association between spreading and failed component-based constructions would support this particular methodological mechanism." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Proof difficulty is partly sociological and method-dependent.", "Failure to find components does not imply none exist.", "Not every class 3 rule has identical perturbation dynamics." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-23--gpt--dataset-1> .
