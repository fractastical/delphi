sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-24--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-24--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-24: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.491"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The finite half of the claim is a definite enumeration of about four billion rules, large but reproducible with a careful implementation. What that search can show is that no machine of the same size speeds up the cited examples. The further suggestion that very simple rules require exponential effort in general is a lower bound, and public busy-beaver data answer a different question about blank-tape halting." ;
    rdfs:comment "Proposed test with existing data: Re-enumerate four-state two-color machines and test whether any computes the same function as the cited examples in subexponential maximum time. That decides the no-speedup-within-this-size clause. A lower bound against machines of every size is a separate proof the census does not provide." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A search at four states shows the absence of a faster machine only inside that size bound.", "An exponential lower bound against all machines is an open complexity proof.", "Inputs that run off the left must be separated from inputs that are merely very slow." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-24--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-24--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-24 by Grok 4.7: 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.68"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-24--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-24--grok--operationalizability> .
