sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-03--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch04-03: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.797"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "The object is a single explicit sequence, and 'for all practical purposes' matches a large finite computation rather than an unproved normality theorem. Arbitrary-precision powers of 3 are immediate to generate, and either a clear large-scale pattern or its continued absence decides the practical claim. The open number-theoretic question of normality is a stronger statement than the one Wolfram makes." ;
    rdfs:comment "Proposed test with existing data: Compute a very long prefix of the base-2 digits of successive powers of 3, remove the small-scale triangular structure, and run equidistribution, autocorrelation, and compression tests. A stable large-scale regularity refutes 'random for all practical purposes'; its absence on prefixes far beyond practical use confirms the claim as stated." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Tests on a finite prefix cannot prove that the infinite digit array is normal or pattern-free.", "The acknowledged small-scale structure has to be excluded by a declared filter, or it will be counted as a regularity." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-03 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-03--grok--operationalizability> .
