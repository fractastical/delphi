sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-47> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-47: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.543"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Additive rules such as elementary rule 90 and the two-dimensional totalistic rule in the text visibly copy patterns, and simulators make that check routine. Similar exhibitions exist for pattern formation. The step from these examples to almost any proposed feature of life, and to the conclusion that only Earth-like chemical detail counts, is not a result those simulations close." ;
    rdfs:comment "Proposed test with existing data: Take a stated feature, such as self-reproduction, self-organization, or high morphological complexity, and search small cellular automata for a rule that meets a formal criterion for it. Success supports the occurrence claim for that feature; the conclusion about how observers recognize life is a further question." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A feature can be redefined so that the simple system fails it.", "Recognized as life is a human judgment.", "Self-reproduction in an additive rule is a thin case of the biological notion." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-47--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-47 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-47> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok--operationalizability> .
