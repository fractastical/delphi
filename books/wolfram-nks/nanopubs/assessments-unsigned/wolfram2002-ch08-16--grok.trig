sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-16: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.505"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.57"^^xsd:double ;
    dct:description "Phylogenies and image collections make a rate-versus-complexity comparison feasible for particular groups such as molluscs, fishes, or butterflies. Coverage is a subset of related species, and treating conservation as evidence of selection builds the conclusion into the measurement. The pattern can be tested where traits have been coded and not as a general biological rule." ;
    rdfs:comment "Proposed test with existing data: Among species in a clade, estimate evolutionary rate for each trait and score trait complexity independently, then test whether the fastest traits are the most complex and the most conserved traits are those with independent evidence of selection. A positive rate-complexity relationship would support the claim; fast change in simple traits, or slow change in the most complex ones, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Inferring selection from constancy makes the second clause circular.", "Complexity scored from photographs is observer-dependent, and quantitative matrices exist for few clades." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-16--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-16 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-16--grok--operationalizability> .
