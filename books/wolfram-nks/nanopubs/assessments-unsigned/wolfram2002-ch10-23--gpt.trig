  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-23--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch10-23: resolvable-now, resolvability 0.97" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.968"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.96"^^xsd:double ;
    dct:description "Established computability results directly settle the impossibility of a complete general recognizer under standard formalizations. They also permit higher methods to recognize additional restricted regularities without contradicting the theorem." ;
    rdfs:comment "Proposed test with existing data: Formalize a universal recognizer that decides whether arbitrary data have a description below a fixed simplicity bound, then reduce the halting problem or use uncomputability of Kolmogorov complexity to show that no such complete method exists. Constructive recognizers for restricted classes establish the stated qualification." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "The result requires formal definitions of description language and complete generality.", "Finite data always admit trivial literal descriptions." .
