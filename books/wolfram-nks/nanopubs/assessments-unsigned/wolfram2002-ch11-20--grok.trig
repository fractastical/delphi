    rdfs:label "Candidate dataset: Martin, Odlyzko, and Wolfram 1984" ;
    dct:description "algebraic analysis of additive cellular automata, including the superposition structure used in the argument" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF01223745> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-20--grok--dataset-2> a delphi:EvidenceItem ;
