  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-15--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch04-15: partially-resolvable, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.705"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.71"^^xsd:double ;
    dct:description "Strong published results show transcendence for broad classes of nonperiodic automatic or low-complexity expansions. Without a precise substitution class, those results do not necessarily cover every pattern Wolfram calls nested." ;
    rdfs:comment "Proposed test with existing data: Formalize nested sequences as outputs of a specified substitution class and roots as algebraic numbers, then apply or seek transcendence results for the resulting digit expansions. Existing theorems settle important classes; a single algebraic counterexample would refute the unrestricted statement." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Nested digit sequence is not a unique formal class.", "Transcendence results differ across substitution families.", "The unrestricted wording may exceed known theorems." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-15--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-15--gpt--operationalizability> a delphi:LLMClaimAssessment ;
