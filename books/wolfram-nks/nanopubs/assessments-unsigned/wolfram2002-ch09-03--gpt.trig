sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-03--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-03--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch09-03: partially-resolvable, resolvability 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.757"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.83"^^xsd:double ;
    dct:description "Reversible automata are easy to generate and multiple behavioral-complexity metrics can be computed with standard methods. Existing resources permit strong restricted comparisons and clear examples of randomness-like behavior and structures. No finite metric suite establishes equality with every other form of complexity." ;
    rdfs:comment "Proposed test with existing data: Sample matched reversible and nonreversible cellular automata and compare entropy rate, compression, long-range mutual information, and persistence of localized structures over initial-condition ensembles. Reversible systems reaching the upper range of nonreversible systems on preregistered measures support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Just as complex and anywhere else have no unique metric or bounded comparison class.", "Finite spacetime samples can underestimate latent structure.", "Selected reversible constructions may not represent reversible systems generally." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-03--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-03--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-03 by GPT-5.6 Sol: 0.6" ;
