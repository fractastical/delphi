  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-12--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch03-12: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.798"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.85"^^xsd:double ;
    dct:description "Once the grammar and sampling convention are matched, the finite enumerations and existence claims are readily reproduced. Qualitative complexity classifications add uncertainty but do not block a decisive computational assessment." ;
    rdfs:comment "Proposed test with existing data: Enumerate the precisely bounded two- and three-replacement sequential substitution rules, run from standardized seeds, and apply fixed complexity and randomness measures. Verify the absence of complex two-rule cases and estimate the qualifying three-rule frequency against one in 10,000." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Random rule requires an explicit sampling distribution.", "Great complexity and seemingly random need quantitative criteria.", "Long transients can affect classification." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-12--gpt--dataset-1> .
