sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch12-37> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Undecidability and unprovability will begin to occur in practically any area of mathematics almost as soon as one goes beyond questions that are always easy to answer, as a consequence of the Principle of Computational Equivalence.";
    dc:type "general-principle";
    <http://www.w3.org/2000/01/rdf-schema#label> "Undecidability appears in almost any area of mathematics beyond easy questions";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Implications for Mathematics and Its Foundations” (from p. 772), p. 791. Scope: all areas of mathematics"
}
