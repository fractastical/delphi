sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch09-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Space, though experimentally continuous down to about 10^-20 meters, is very likely made of discrete elements at still smaller scales, just as fluids and other seemingly continuous things have turned out to be.";
    dc:type "physical-hypothesis";
    <http://www.w3.org/2000/01/rdf-schema#label> "Space is discrete below the scales probed by experiment";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “The Nature of Space” (from p. 472), p. 472. Scope: the structure of physical space at very small distances"
}
