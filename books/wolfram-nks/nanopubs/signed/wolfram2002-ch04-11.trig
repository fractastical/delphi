sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch04-11> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Despite pi's simple definition, its digit sequence shows no significant regularity in all computed digits and appears for practical purposes completely random.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "The digits of pi are random for practical purposes";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Mathematical Constants” (from p. 136), p. 138. Scope: digit sequence of pi in any base"
}
