sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch06-17> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In any cellular automaton, an initial condition consisting of a fixed block of n cells repeated forever leads to repetitive behavior with period at most 2^n, since each block evolves like a finite cyclic system.";
    dc:type "mathematical";
    <http://www.w3.org/2000/01/rdf-schema#label> "Spatially periodic initial conditions always give repetitive behavior";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Special Initial Conditions” (from p. 266), p. 267. Scope: all cellular automata with spatially periodic initial conditions"
}
