sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch12-56> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "By the Principle of Computational Equivalence, human brains, turbulent fluids, simple cellular automata and the universe as a whole all achieve the same level of computational sophistication, so humans are not fundamentally special in intelligence or complexity.";
    dc:type "general-principle";
    <http://www.w3.org/2000/01/rdf-schema#label> "Humans are not computationally more sophisticated than other systems in nature";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Historical Perspectives” (from p. 844), p. 844. Scope: humans, natural systems, simple programs and the universe"
}
