sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch06-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Any system of limited size made of discrete elements and following definite rules must eventually exhibit repetitive behavior, with repetition period at most equal to its total number of possible states.";
    dc:type "mathematical";
    <http://www.w3.org/2000/01/rdf-schema#label> "Finite discrete deterministic systems must eventually repeat";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Systems of Limited Size and Class 2 Behavior” (from p. 255), p. 255. Scope: finite-state deterministic discrete systems"
}
