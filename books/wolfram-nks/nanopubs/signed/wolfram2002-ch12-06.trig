sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch12-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The pattern generated by the rule 30 cellular automaton from a single black cell appears to contain every possible block of cells eventually, so that essentially any possible computation exists somewhere within this single pattern.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Rule 30 from a single cell contains every possible block";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “The Content of the Principle” (from p. 719), p. 725. Scope: rule 30 elementary cellular automaton started from a single black cell"
}
