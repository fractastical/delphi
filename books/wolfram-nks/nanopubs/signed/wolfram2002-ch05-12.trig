sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch05-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Most multiway systems (which keep all sequences produced by all possible replacements at each step) either grow exponentially fast or do not grow at all; slow growth is rare.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Most multiway systems grow exponentially or not at all";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Multiway Systems” (from p. 204), p. 207. Scope: multiway (non-deterministic string rewriting) systems with simple rules"
}
