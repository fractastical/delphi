sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch05-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Networks in which every node is identical and has exactly two outgoing connections can, purely by the pattern of connections, form structures equivalent to arrays of any number of dimensions, as well as trees and nested structures.";
    dc:type "mathematical";
    <http://www.w3.org/2000/01/rdf-schema#label> "Networks of identical two-connection nodes can form arrays of any dimension";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Network Systems” (from p. 193), p. 196. Scope: directed networks with out-degree two"
}
