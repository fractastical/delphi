    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-02> a delphi:Claim ;
    rdfs:label "Morphogenetic plasticity is not restricted to amphibian or embryonic cells" ;
    dct:description "The ability of adult, somatic, genetically wild-type human cells to form a novel functional anatomy with new behaviours shows that the plasticity seen in Xenobots is not restricted to amphibian or embryonic cells, and is a fundamental feature of wild-type cells that needs no direct genetic manipulation to unlock." ;
    delphi:context "Gumuskaya G, Srivastava P, Cooper BG, Lesser H, Semegran B, Garnier S, Levin M, “Motile Living Biobots Self-Construct from Adult Human Somatic Progenitor Seed Cells”, Advanced science (Weinheim, Baden-Wurttemberg, Germany) (2024), doi:10.1002/advs.202303575; section “Introduction”. Scope: Genetically wild-type cells generally, generalized from adult human airway epithelium and Xenopus embryonic cells" ;
    dct:type "empirical-generalization" .
}

