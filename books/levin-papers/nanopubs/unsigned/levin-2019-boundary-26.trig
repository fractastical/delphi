sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-26> a delphi:Claim ;
    rdfs:label "Bioelectric circuits act as software: multistable states switched without genetic change" ;
    dct:description "Ion channel and gap junction circuits are well suited to the \"software\" of life because they form feedback loops that implement dynamical systems with multiple attractors, which transient signals can switch between without changing the hardware (i.e. without mutating the DNA encoding the channels)." ;
    delphi:context "Levin M, “The Computational Boundary of a \"Self\": Developmental Bioelectricity Drives Multicellularity and Scale-Free Cognition”, Frontiers in psychology (2019), doi:10.3389/fpsyg.2019.02688; section “Discussion”. Scope: Bioelectric networks of ion channels and gap junctions in cells and tissues" ;
    dct:type "mechanism" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.3389/fpsyg.2019.02688> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "What makes electric circuits, whether ion channel-mediated or electronic, good for software is that they easily implement dynamical systems that have multiple attractors and can be made to occupy one physiological state or another by transient inputs (signals), not requiring changing the hardware (i.e., mutating the DNA encoding that hardware)." ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fpsyg.2019.02688> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2019-boundary.txt#line=97,98> .

