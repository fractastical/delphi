  sub:assertion prov:wasDerivedFrom <https://doi.org/10.3390/e26060481> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "The competency of our material means that selection cannot see the quality of genomes clearly46. More evolutionary work thus has to be conducted on the competency mechanisms, not the structural components, leading to a positive feedback loop—an intelligence ratchet based on the remapping of information to new contexts47." ;
