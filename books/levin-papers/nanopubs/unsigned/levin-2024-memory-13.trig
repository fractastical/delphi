sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-memory-13> a delphi:Claim ;
    rdfs:label "Cellular competency hides genome quality from selection, driving an intelligence ratchet" ;
    dct:description "Because competent biological material compensates for defects, selection cannot see genome quality clearly, so more evolutionary change accrues in competency mechanisms than in structural components, producing a positive-feedback intelligence ratchet based on remapping information to new contexts." ;
    delphi:context "Levin M, “Self-Improvising Memory: A Perspective on Memories as Agential, Dynamically Reinterpreting Cognitive Glue”, Entropy (Basel, Switzerland) (2024), doi:10.3390/e26060481; section “6. What It Means, and What Next: A Research Program for Further Development”. Scope: Evolution of multicellular organisms; in silico evolutionary models" ;
    dct:type "historical-inference" .
}

