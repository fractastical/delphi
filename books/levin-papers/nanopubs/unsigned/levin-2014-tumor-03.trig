sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2014-tumor-03> a delphi:Claim ;
    rdfs:label "Remote Kv1.5 hyperpolarization suppresses tumor-like structures from two oncogenes" ;
    dct:description "In Xenopus laevis embryos, misexpressing the hyperpolarizing potassium channel Kv1.5 in a blastomere distant from the oncogene-injected blastomere reduces the incidence of induced tumor-like structures by about 35% for Xrel3 and about 29% for Gli1, indicating the suppression is not specific to one oncogene." ;
    delphi:context "Chernet BT, Levin M, “Transmembrane voltage potential of somatic cells controls oncogene-mediated tumorigenesis at long-range”, Oncotarget (2014), doi:10.18632/oncotarget.1935; section “RESULTS › Long-range hyperpolarization suppresses the formation of ITLS”. Scope: 16-cell-stage Xenopus laevis embryos co-injected with Xrel3 or Gli1 and Kv1.5 mRNA in separate blastomeres, scored at stage 34" ;
    dct:type "experimental-result" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.18632/oncotarget.1935> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Kv1.5-induced long-distance hyperpolarization was also able to significantly suppress Xrel3 and Gli1 ITLS formation by 34.9% (N=225; t-test, P<0.05) and 29.4% (N=292; t-test, P<0.05), respectively (Fig. 2C), suggesting the effect is not specific for just one type of oncogene." ;
    prov:wasQuotedFrom <https://doi.org/10.18632/oncotarget.1935> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2014-tumor.txt#line=34,35> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2014-tumor.txt#line=34,35> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2014-tumor.txt> .

