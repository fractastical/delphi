    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-11> a delphi:Claim ;
    rdfs:label "Many ectopic eye spots but one eye reflect competing goals of neighbouring cell groups" ;
    dct:description "In Xenopus embryos injected with a potassium channel, many ectopic eye spots appear early but typically only one new eye forms; Levin interprets this as bidirectional signalling between channel-induced cells pushed toward an eye setpoint, which recruit neighbours, and uninjected neighbours whose setpoint is still 'gut', which signal to maintain normal fate." ;
    delphi:context "Levin M, “The Multiscale Wisdom of the Body: Collective Intelligence as a Tractable Interface for Next-Generation Biomedicine”, BioEssays : news and reviews in molecular, cellular and developmental biology (2025), doi:10.1002/bies.202400196; section “Bioelectricity as the Interface to Multicellularity › Applications: Modulating Endogenous Bioelectric Cues”. Scope: Xenopus laevis embryos misexpressing potassium channels" ;
    dct:type "mechanism" .
}

