  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1002/bies.202400196> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "At early stages in embryos injected with the potassium channel, many ectopic eye spots are detected, but just one new eye tends to appear at the end. This is the consequence of conversation between morphogenetic agents with different goals." ;
