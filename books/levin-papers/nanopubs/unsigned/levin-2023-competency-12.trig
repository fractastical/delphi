sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-12> a delphi:Claim ;
    rdfs:label "Evolution changes the competency gene more often than any structural gene" ;
    dct:description "In the 1D artificial embryogeny model with evolvable competency, positional changes to cells over 1000 generations resulted from changes to the competency gene significantly more often than from changes to any of the fifty structural genes." ;
    delphi:context "Shreesha L, Levin M, “Cellular Competency during Development Alters Evolutionary Dynamics in an Artificial Embryogeny Model”, Entropy (Basel, Switzerland) (2023), doi:10.3390/e25010131; section “4. Discussion › 4.6. Where the Hard Work Is Done: An Intelligence Ratchet”. Scope: In silico 1D artificial embryos with an evolvable competency gene" ;
    dct:type "simulation-result" .
}

