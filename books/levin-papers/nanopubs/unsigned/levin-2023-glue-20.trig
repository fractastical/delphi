sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-20> a delphi:Claim ;
    rdfs:label "Gap junctions wipe ownership of memory molecules, partly erasing cell individuality" ;
    dct:description "By directly connecting the cytoplasm of neighbouring cells, gap junctions provide an 'owner wiping property' for stress signals and other molecular traces of experience (e.g. calcium flux), so cells cannot tell whether such a signal is their own or a neighbour's; this partly erases individual cell identity and lets the collective scale up measurements, stored goals and actions." ;
    delphi:context "Levin M, “Bioelectric networks: the cognitive glue enabling evolutionary scaling from physiology to mind”, Animal cognition (2023), doi:10.1007/s10071-023-01780-3; section “Basal cognition without neurons: what dynamic bodies think about › E pluribus unum”. Scope: Gap-junction-coupled cells in morphogenetic and neural tissues" ;
    dct:type "mechanism" .
}

