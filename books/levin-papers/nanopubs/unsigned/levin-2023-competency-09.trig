    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-09> a delphi:Claim ;
    rdfs:label "A cost on competency restores a Baldwin effect and genetic assimilation" ;
    dct:description "In the 1D artificial embryogeny model, penalizing fitness in proportion to competency (penalty factors 1×10⁻⁷ to 0.5) produced a Baldwin effect: structural-gene fitness kept improving, selection favoured progressively lower competency, and early competency-based gains were assimilated into the structural genes; the authors note real competency costs are unmeasured." ;
    delphi:context "Shreesha L, Levin M, “Cellular Competency during Development Alters Evolutionary Dynamics in an Artificial Embryogeny Model”, Entropy (Basel, Switzerland) (2023), doi:10.3390/e25010131; section “3. Results › 3.5. A Fitness Penalty for Competency Leads to Continued Improvement of an Embryo’s Structural Genes”. Scope: In silico 1D artificial embryos with a fitness penalty on competency" ;
    dct:type "simulation-result" .
}

