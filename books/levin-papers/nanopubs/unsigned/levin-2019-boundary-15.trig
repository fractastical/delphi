sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-15> a delphi:Claim ;
    rdfs:label "Cells in development minimize surprise and variational free energy like nervous systems" ;
    dct:description "Living systems minimize surprise and optimize variational free energy by tuning internal states to best predict future stimuli, and this holds for individual cells during metazoan development as much as for nervous systems." ;
    delphi:context "Levin M, “The Computational Boundary of a \"Self\": Developmental Bioelectricity Drives Multicellularity and Scale-Free Cognition”, Frontiers in psychology (2019), doi:10.3389/fpsyg.2019.02688; section “The Agent’s Evolutionary Back-Story: Scaling of Information by Bioelectricity”. Scope: Nervous systems and individual cells in metazoan development" ;
    dct:type "mathematical-law" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.3389/fpsyg.2019.02688> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Systems minimize surprise and optimize variational free energy by tuning their internal states in a way that optimally predicts future stimuli (Friston and Ao, 2012; Friston, 2013; Badcock et al., 2019). This is as true for nervous systems as it is for individual cells during metazoan development (Friston et al., 2015; Ramstead et al., 2019)." ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fpsyg.2019.02688> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2019-boundary.txt#line=64,65> .

