  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-16--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2024-anthrobots-16: partially-resolvable, resolvability 0.68" ;
