sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-09--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2020-xenobots-09: needs-new-data, resolvability 0.41" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.41"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Wound closure and shape maintenance are measurable. The published support is an illustrative supplementary figure, and re-inspecting that figure is not a test of rates, sample size, or passive recoil. A quantitative decision needs the original time series or a new assay." ;
    rdfs:comment "Proposed test with existing data: After a standardized laceration, measure wound width over time against uninjured shape landmarks; self-repair holds if the gap closes and the external configuration returns, beyond passive recoil." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The support is a supplementary example, not a deposited series with sample size and controls.", "Tissue recoil and wound contraction can close a gap without a regulated repair response." .
  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2020-xenobots-09 by Grok 4.7: 0.75" ;
