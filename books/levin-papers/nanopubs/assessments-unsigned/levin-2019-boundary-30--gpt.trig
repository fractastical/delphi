sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-30> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-30--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-30--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2019-boundary-30: not-empirically-resolvable, resolvability 0.05" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.046"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.95"^^xsd:double ;
    dct:description "The claim's central content is phenomenal rather than behavioral. Existing tissue recordings can characterize decision-like dynamics but cannot resolve whether there is something it is like to instantiate them." ;
    rdfs:comment "Proposed test with existing data: No behavioral, physiological, or computational measurement can presently distinguish a tissue that has first-person experience from one with identical functions but no experience." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "First-person experience in non-reporting tissue has no agreed observable marker.", "Functional similarity does not discriminate phenomenal experience from its absence." .
