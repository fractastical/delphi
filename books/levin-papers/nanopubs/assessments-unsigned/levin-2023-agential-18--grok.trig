sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-18--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-agential-18: partially-resolvable, resolvability 0.63" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.628"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "The contrast with flies and mice is directly queryable in phenotype databases, and planarian strain reports are public literature. That is enough to test a claim about what is known, including the bioelectric origin of the familiar two-headed lines. It is not a complete census of stocks, and the competency-ratchet explanation of the absence is not tested by the search." ;
    rdfs:comment "Proposed test with existing data: Search FlyBase, Mouse Genome Informatics, and the planarian literature for stable inherited strains whose anatomy differs from wild type in the absence of ongoing RNAi or drug treatment. Morphological mutant strains in flies and mice, and at least one published planarian strain of that kind, would refute the negative planarian clause; a documented absence of such planarian strains, with the only permanent abnormal lines being the bioelectric one-head and two-head forms, would support it as a statement about the public record." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "RNAi phenotypes and transient drug phenotypes are easy to mistake for mutant strains.", "A literature search can refute the negative claim by finding a strain, but cannot prove that no unpublished strain exists.", "Transgenesis attempts after the paper's publication can change the public record without a single dedicated database." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-agential-18 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
