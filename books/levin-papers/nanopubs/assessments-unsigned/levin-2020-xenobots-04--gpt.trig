  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-04--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2020-xenobots-04: partially-resolvable, resolvability 0.70" ;
