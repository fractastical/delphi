sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-21--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2025-wisdom-21: needs-new-data, resolvability 0.26" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.258"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The aging hypothesis can be turned into a longitudinal contrast between voltage-pattern stability and cell-intrinsic aging markers, with a restoration test. Public aging resources contain molecular and clinical clocks and do not contain the endogenous bioelectric patterns the claim treats as the information scaffold. The necessary paired measurements are not available for analysis." ;
    rdfs:comment "Proposed test with existing data: Track tissue-scale resting-potential patterns in the same animals as they age, alongside cell-intrinsic aging markers, and test whether restoring the voltage pattern preserves tissue order when cell-level rejuvenation is held constant. Pattern decay predicting disorder, and pattern restoration preventing it, would support the claim; aging with an intact voltage pattern, or rescue by cell-level factors alone, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public longitudinal dataset pairs bioelectric prepatterns with tissue order across age.", "Aging clocks and expression atlases do not record membrane-voltage pattern memory.", "Pattern memory has to be specified so that ordinary loss of cell function is not counted as evidence." .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2025-wisdom-21 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-21--grok--operationalizability> .
