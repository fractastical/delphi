    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "The simulation result can be checked using public models and a specified perturbation. The biological interpretation is narrower than the numerical result because alternative noise processes may behave differently." ;
