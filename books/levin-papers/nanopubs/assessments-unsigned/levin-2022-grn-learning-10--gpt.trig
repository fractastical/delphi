  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-10--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2022-grn-learning-10: resolvable-now, resolvability 0.83" ;
