sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-agential-11: partially-resolvable, resolvability 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.675"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The homology half can be settled directly from public sequences and structures. The functional phenocopy is a specific Xenopus regeneration result published as experimental measurements, without a deposited animal-level regeneration file in these databases. Voltage as the coarse-grained instructive variable is supported only if the rescue is tied to the bioelectric state rather than to a side effect of proton pumping." ;
    rdfs:comment "Proposed test with existing data: Align yeast plasma-membrane proton-pump sequences and structures with Xenopus V-ATPase subunits, and compare tadpole tail regeneration when the yeast pump is expressed in place of V-ATPase function. Absence of significant sequence and structural homology, together with rescue of regeneration and of the regenerative voltage, would support interchangeability of the voltage state; homology, or rescue without restoration of voltage, would count against voltage as the instructive variable." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The tail-regeneration rescue counts are in the original experimental paper, not in UniProt or the PDB.", "A yeast pump could restore regeneration by changing pH independently of the voltage pattern the claim treats as the signal." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-agential-11 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok--data-existence> a delphi:LLMClaimAssessment ;
