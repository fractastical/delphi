sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-18--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-18: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.513"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The generalization is a fraction over a definable drug list, with coupling as the assay. The Guide to Pharmacology holds the ligand list and some connexin interactions, and the coupling measurements themselves are spread through primary papers. A compilation can test the animal volatile agents that have been assayed and will miss much of the plant half. Multiple targets mean a positive uncoupling result does not show that uncoupling is how anesthesia happens, which the claim treats as support for a binding theory. The fraction is partly compilable now." ;
    rdfs:comment "Proposed test with existing data: Fix a list of general and volatile anesthetics used in animals and in plants, and score each for a dye-transfer or scrape-loading reduction of gap-junction coupling. 'Most' is confirmed if a pre-specified majority reduce coupling in both kingdoms; a majority with no coupling effect, especially among plant anesthetics, would refute the generalization." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Gap-junction uncoupling is not a structured field for most anesthetics.", "Plant anesthesia data are much sparser than mammalian data.", "A drug can close gap junctions and still act clinically through another target." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-18 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-18--grok--operationalizability> .
