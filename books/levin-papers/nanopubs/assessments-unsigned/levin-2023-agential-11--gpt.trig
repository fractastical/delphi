sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-agential-11: partially-resolvable, resolvability 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.676"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "The rescue experiment and its critical controls are highly operational. Existing published data may resolve the specific example, but broad interchangeability and separation of voltage from pH need additional matched evidence." ;
    rdfs:comment "Proposed test with existing data: Compare tail-regeneration frequency and membrane voltage after V-ATPase disruption followed by expression of the unrelated yeast proton pump, using inactive-pump and voltage-mismatched controls. Rescue that tracks restored voltage rather than sequence identity supports voltage as the instructive variable." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Matched voltage, construct expression, and regeneration records may not be public.", "Proton pumps alter pH as well as voltage.", "One substitution does not establish the general coarse-graining claim." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-11--gpt--dataset-2> .
