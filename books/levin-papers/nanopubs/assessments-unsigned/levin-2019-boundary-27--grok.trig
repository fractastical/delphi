sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-27> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-27--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-27--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-27: needs-new-data, resolvability 0.26" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.256"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The author marks this as a testable hypothesis about opioids and cell proximity in simple systems. Receptor catalogs document modern pharmacology and contain none of those aggregation measurements. A historical 'derives from' claim is only weakly tied to a future adhesion result, but the physiological prediction itself is an experiment that has not been deposited. Resolving even the weaker reading needs new assays." ;
    rdfs:comment "Proposed test with existing data: In a basal multicellular model and in stem/somatic co-cultures, measure whether opioids increase cell-cell retention or aggregation relative to receptor-blocked controls, beyond known effects on mammalian reward circuits. A retention effect in those simple systems would support the physiological half; no effect outside nervous systems would undercut the ancient-root hypothesis." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public co-culture or choanoflagellate dataset applies opioids and scores cell proximity.", "Mammalian addiction assays do not establish an ancient cell-keeping function.", "A positive adhesion effect would still be compatible with a later co-option." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-27--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-27--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-27 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-27--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-27> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-27--grok--operationalizability> .
