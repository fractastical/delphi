sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-04--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-competency-04: resolvable-now, resolvability 0.87" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.872"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "Fitness is an explicit inversion count, competency is a bounded bubble-sort, and the competent-versus-hardwired experiment is a public script with hyperparameters. A small team can rerun it in days to weeks and compare time-to-fitness. The claim is about this model, and the code covers that scope." ;
    rdfs:comment "Proposed test with existing data: Rerun the public 1D embryogeny experiment at the published competency levels, including 400, and at the hardwired setting, and record generations until high phenotypic fitness. Competent populations reaching that fitness faster and more consistently, on the order of under 6 generations versus over 200, would confirm the claim; overlapping times would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Exact generation counts depend on the published mutation rate, selection stringency and fitness definition." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-competency-04--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-competency-04 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-competency-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-04--grok--operationalizability> .
