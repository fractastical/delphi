sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-glue-04--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-glue-04: partially-resolvable, resolvability 0.63" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.633"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Paired gene expression and electrophysiology are public for a large set of neurons and can show how much electrical phenotype is readable from transcripts. That tests the neural subset and can refute an absolute version of unreadability. It does not cover non-neural bioelectric maps, proteomics, or the history dependence the mechanism invokes, so the claim's full scope stays only partly tested." ;
    rdfs:comment "Proposed test with existing data: In paired transcriptome and electrophysiology profiles, predict resting or firing features from transcript levels and ask whether distinct channel sets map to the same electrical phenotype. Prediction no better than a permutation null, or identical transcriptomes with different voltage states, would support unreadability; accurate prediction of the electrical phenotype from transcripts or proteins would refute a strict reading." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The atlas covers spiking neurons, not the slow developmental voltage patterns the surrounding argument is about.", "A snapshot cannot test history dependence, and proteins are not paired with voltage in this resource." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-glue-04--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-glue-04 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-glue-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-glue-04--grok--operationalizability> .
