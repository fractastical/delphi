sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-15--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-goals-15: needs-new-data, resolvability 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.364"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "A timescale comparison is well posed only if the late-change events and a baseline regenerative schedule can be aligned animal by animal. The late events are not deposited beyond the paper's summary, so the inference to an unknown slow process cannot be separated from drug, wound, or starvation alternatives with existing public records." ;
    rdfs:comment "Proposed test with existing data: Compare the latency from completed regeneration to spontaneous anatomical change in ERK-inhibited headless Dugesia with the published time to a stable regenerate in untreated fragments of the same species. Latencies of many weeks, well beyond the usual one-to-two-week regenerative window, would support a slower tissue process; latencies inside the ordinary window, or late changes explained by drug persistence or starvation, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The latency distribution is not available as a public individual-level table.", "A slow residual effect of U0126, or injury from late fission, mimics a newly discovered slow tissue process." .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-goals-15 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
