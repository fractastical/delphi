sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-07--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-girardia-07: needs-new-data, resolvability 0.44" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.438"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Return toward the species head after a stated post-regeneration window is a direct longitudinal measurement. The paper describes that window with example images, and the coordinate series needed to recompute the distances is not deposited. An independent public time series of this protocol is also absent." ;
    rdfs:comment "Proposed test with existing data: Track individual induced animals from day 10 to day 30 without further injury and test whether Procrustes distance to wild-type Girardia falls after regeneration is scored complete. A stable induced shape, or continued regenerative growth, would refute remodeling of an already completed head." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Paired day-10 and day-30 landmarks for the same animals are not public.", "Ongoing size change and posture can mimic a return toward the species shape." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-07--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-girardia-07 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
