sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-17--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-17--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-agential-17: partially-resolvable, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.485"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The feedback mechanism is testable in computational models with controlled architectures. Current data cannot establish that it operated to different extents across the named animal lineages or that modeled competency corresponds to biological intelligence." ;
    rdfs:comment "Proposed test with existing data: In explicit evolutionary models, manipulate developmental error correction and measure whether selection shifts from structural parameters toward competency parameters over generations. Test for a monotonic feedback and compare evolved robustness among model lineages under matched mutation and fitness conditions." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Competency and intelligence require model-specific metrics.", "The ratchet may be an artifact of genotype representation.", "Comparing planaria, salamanders, and mammals requires unavailable matched evolutionary histories." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-17--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-17--gpt--operationalizability> a delphi:LLMClaimAssessment ;
