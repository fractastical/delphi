  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2022-tame-19: resolvable-now, resolvability 0.84" ;
