sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-collective-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-collective-02--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-collective-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-collective-02: partially-resolvable, resolvability 0.46" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.46"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Public genomes can test the only sharply dated piece of the hypothesis: whether bioelectric components predate neurons. That analysis is standard and already feasible. It leaves the claim that neural unification into a self is an evolutionary pivot of morphogenetic problem-solving unmeasured, because component age does not establish homology of function." ;
    rdfs:comment "Proposed test with existing data: Date voltage-gated channels, gap-junction proteins and neurotransmitter machinery on metazoan and pre-metazoan genomes, and ask whether those families are present in non-neural lineages before the origin of neurons. Presence before neurons would support reuse of older components; restriction of the families to animals with nervous systems would weaken the temporal-order proxy. Neither result measures whether a neural self is a functional pivot of morphogenetic control." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Ancient shared components are compatible with co-option, convergence or unrelated reuse.", "A centralized self, memories and goals are not variables in genome databases.", "Gene presence is not evidence that the proteins controlled anatomy before they controlled behavior." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2024-collective-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2024-collective-02--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-collective-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-collective-02 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-collective-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2024-collective-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-collective-02--grok--operationalizability> .
