sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-11--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-11: needs-new-data, resolvability 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.381"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "The three percentages and the indistinguishability claim are a straightforward contingency-table test. Those counts were not deposited, and the data statement does not point to a repository. Re-reading Figure 5f repeats the claim rather than testing it. The design would discriminate rescue from a partial improvement once the individual outcomes exist." ;
    rdfs:comment "Proposed test with existing data: Count major brain-morphology defects at stage 45 in untreated controls, nicotine (0.1 mg/mL, stages 10–35), and nicotine plus Hcn2-WT mRNA. Rescue to control levels is confirmed if nicotine is near 60% and the HCN2 arm is statistically indistinguishable from the ~7% control; a residual elevation in the HCN2 arm would refute complete rescue." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The bar graph is not accompanied by an open embryo-level table.", "Major-defect categories can be scored differently by another observer.", "Injection and nicotine timing have to match the stated window." .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-11 by Grok 4.7: 0.92" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.92"^^xsd:double ;
