sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-13--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-anthrobots-13: needs-new-data, resolvability 0.34" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.338"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The morphotype tree is a clustering claim about a defined feature set of about 350 bots. That matrix is not deposited, and cluster count is method-dependent even when the matrix exists. Open figures do not let a third party rerun the principal components or test whether three groups are preferred." ;
    rdfs:comment "Proposed test with existing data: Repeat principal-component analysis and clustering on the eight shape and cilia indices, and compare a three-group solution with two- and four-group solutions by a pre-specified criterion. A stable split of small smooth spheres from larger irregular bots, and a further cilia-pattern split of the large bots, would support the decision tree; a continuum or a different first split would refute three morphotypes in that order." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The eight-index matrix is not public.", "Three clusters and a tree order are sensitive to scaling and to the choice of k.", "Size and shape are partly the same measurement, so the first split can be a size threshold." .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-anthrobots-13 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
