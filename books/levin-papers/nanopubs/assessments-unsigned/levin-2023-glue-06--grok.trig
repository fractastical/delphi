sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-glue-06--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-glue-06: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.488"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Public sequences and divergence times can test whether the named components are older than brains, which is the conservation premise behind the pivot. They cannot show original use in morphospace, nor that neuroscience tools work in the body because of that history. The historical purpose remains an inference beyond the phylogenetic data." ;
    rdfs:comment "Proposed test with existing data: Place ion-channel, gap-junction, and neurotransmitter-synthesis genes on a dated tree of animals and ask whether they predate nervous systems, and compare the timescale of non-neural voltage events with synaptic spikes. Earlier origins and a shift from slow spatial patterns to millisecond spikes would support reuse and speed-up; origins only inside nervous systems would count against the historical premise." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "An ancient gene family can predate nervous systems without having been used for morphogenesis.", "The speed comparison is between living physiological regimes, not a recorded evolutionary transition." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-glue-06 by Grok 4.7: 0.45" ;
