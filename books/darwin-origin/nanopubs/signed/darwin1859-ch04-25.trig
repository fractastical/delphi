sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch04-25> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Through natural selection and divergence of character, the small differences between varieties of a species steadily increase until they equal the larger differences between species of the same genus, or even between genera.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Differences between varieties grow into differences between species and genera";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter IV, “Natural Selection”; section “Summary”. Scope: varieties, species and genera of all organisms"
}
