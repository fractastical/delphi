sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch14-03> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "All living things have much in common in their chemical composition, germinal vesicles, cellular structure, and laws of growth and reproduction, as shown even by the same poison often affecting plants and animals similarly.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "All living things share chemical composition, cell structure and laws of growth";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter XIV, “Recapitulation and Conclusion”; section “How far the theory of natural selection may be extended”. Scope: all living organisms"
}
