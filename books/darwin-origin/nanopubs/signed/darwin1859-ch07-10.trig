sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch07-10> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Hexagonal hive-bee cells result from many bees standing at equal distances from one another, each excavating equal spherical hollows, and building up or leaving unexcavated the planes where these spheres would intersect.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Hive-bee cells form by bees sweeping equal spheres and building at intersections";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter VII, “Instinct”; section “Hive-bee, its cell-making instinct”. Scope: comb construction by the hive-bee (Apis mellifera)"
}
