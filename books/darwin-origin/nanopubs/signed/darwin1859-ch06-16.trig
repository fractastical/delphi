sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch06-16> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The rule that nature makes no leaps is not strictly true of living organisms alone, but if all past organisms are included it must be strictly true.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Nature makes no leaps when past as well as present forms are included";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter VI, “Difficulties on Theory”; section “Natura non facit saltum.”. Scope: all organisms, living and extinct"
}
