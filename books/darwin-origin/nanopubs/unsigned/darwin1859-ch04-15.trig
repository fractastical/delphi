sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch04-15> a delphi:Claim ;
    rdfs:label "Large areas produce more, faster-forming and wider-spreading new species" ;
    dct:description "Although small isolated areas can favour new species, modification is generally faster on large areas, and forms produced there, having beaten many competitors, spread most widely and give rise to the most new varieties and species." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter IV, “Natural Selection”; section “Circumstances favourable and unfavourable to Natural Selection, namely, intercrossing, isolation, number of individuals”. Scope: terrestrial species in continents versus islands and small regions" ;
    dct:type "prediction" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <http://www.wikidata.org/entity/Q20968204> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-darwin-origin-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Finally, I conclude that, although small isolated areas probably have been in some respects highly favourable for the production of new species, yet that the course of modification will generally have been more rapid on large areas; and what is more important, that the new forms produced on large areas, which already have been victorious over many competitors, will be those that will spread most widely" ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q20968204> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/1228/pg1228.txt#line=3418,3425> .

