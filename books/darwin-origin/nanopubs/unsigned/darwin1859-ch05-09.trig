}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch05-09> a delphi:Claim ;
    rdfs:label "Taxonomically important characters may be useless products of correlated growth" ;
    dct:description "Structural differences that systematists treat as highly important, such as differences between outer and inner seeds of Umbelliferae, may arise entirely from unknown laws of correlated growth without being of any use to the species." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter V, “Laws of Variation”; section “Correlation of growth.”. Scope: plants and animals; characters used in classification" ;
    dct:type "mechanism" .
}

