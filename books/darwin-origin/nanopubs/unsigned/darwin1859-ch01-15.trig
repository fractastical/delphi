sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch01-15> a delphi:Claim ;
    rdfs:label "Domestic races differ greatly externally but little internally" ;
    dct:description "Because man can select mainly on externally visible deviations, domestic races differ greatly in external characters and relatively slightly in internal parts or organs." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter I, “Variation under Domestication”; section “Methodical and Unconscious Selection”. Scope: domestic races of animals" ;
    dct:type "empirical-generalization" .
}

