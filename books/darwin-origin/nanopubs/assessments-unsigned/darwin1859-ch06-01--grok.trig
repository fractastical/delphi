sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch06-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-01--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch06-01: partially-resolvable, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.484"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "The process claim requires catching parent and transitional forms in the act of disappearing, which almost no dataset records directly. Fossil ranges and character matrices support a proxy in a few dense clades, and modern abundance series are too short for speciation. Taxonomic practice and missing strata both predict the absence of intermediates, so discrimination is limited." ;
    rdfs:comment "Proposed test with existing data: During intervals when a new form becomes morphologically distinct, test whether parental and transitional populations disappear rather than persist beside it. Early presence and later absence of intermediates, beyond a preservation null, would support the claim; routine coexistence of parent, transitional, and descendant forms would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Transitional varieties are seldom named as populations in the fossil record.", "Incomplete preservation removes intermediates whether or not competition did.", "Modern time series rarely span speciation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-01--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch06-01 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
