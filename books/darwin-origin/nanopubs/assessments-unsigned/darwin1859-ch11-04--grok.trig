sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-04--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch11-04: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.555"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Molecular relatedness of regional faunas and floras is testable with open trees and sequences, and that test is independent of the morphological pattern it is meant to explain. The further split between natural selection and the direct action of conditions does not fall out of those data. The resolvable part is common ancestry of regional biotas, not the mechanism of their differences." ;
    rdfs:comment "Proposed test with existing data: Ask whether regional biotas form phylogenetic clusters on molecular trees built independently of the morphological resemblance naturalists scored, and whether regional trait differences exceed what the physical environment predicts. Shared ancestry can be assessed that way; attributing the differences mainly to natural selection remains weakly separated from other causes." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A tree built from the same traits that display the affinity would make the inheritance test circular.", "Selection, drift, and direct effects of the environment are not separated by present distributions.", "Joint phylogenetic and geographic coverage is partial for the full living and fossil scope." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-04--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-04--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch11-04 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
