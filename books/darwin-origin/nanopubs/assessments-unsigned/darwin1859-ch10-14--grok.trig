sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-14--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch10-14: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.543"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Gap-filling is measurable as a reduction in morphological distance once fossils are added, and public matrices exist for many vertebrate and invertebrate clades. They do not cover all organisms, and the placement of fossils is not fully independent of the gaps. The analysis is realistic for several major groups and not for the universal scope." ;
    rdfs:comment "Proposed test with existing data: In character matrices, measure morphological distances among living orders and families with fossils excluded and again with fossils included. Fossils that sit in the gaps and shrink those distances would support the claim; fossils that only repeat living clusters would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Matrices cover some clades well and most of life poorly.", "The characters that define the gaps are also the characters used to place the fossils.", "Harmonizing many matrices into one analysis takes months." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-14--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch10-14 by Grok 4.7: 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.65"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-14--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-14--grok--operationalizability> .
