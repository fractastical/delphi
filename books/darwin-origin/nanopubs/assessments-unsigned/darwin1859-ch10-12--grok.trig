sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-12--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch10-12: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.778"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Cross-regional marine turnover is densely recorded, and independent age frameworks exist so the test need not use the fossils as their own clock. Agreement within a stage is a concrete criterion matching the broad geological sense of the claim. Coverage is stronger for shelly and microfossil faunas than for every marine group." ;
    rdfs:comment "Proposed test with existing data: Date marine faunal turnovers with radiometric, paleomagnetic, or chemostratigraphic ages and compare their timing across paleocontinents. Turnover coincident within a geological stage worldwide would support the claim; multi-stage diachrony as the usual pattern would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Correlation that uses the fossils themselves makes simultaneity circular.", "Independent dates are dense in some periods and sparse in others." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch10-12 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
