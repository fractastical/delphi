sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch06-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-13--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch06-13: partially-resolvable, resolvability 0.37" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.373"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The refuting observation is well defined, but the variable that would show it, exclusive fitness benefit, is not a field in open interaction databases and is only scattered through experimental papers. GloBI can list mutualisms and antagonisms to examine, which is a partial screen. Coverage across all interacting species is negligible relative to the scope, and compilation would take far longer than weeks." ;
    rdfs:comment "Proposed test with existing data: For structures involved in interspecific interactions, compare fitness effects on the bearer and on the other species. One structure whose only effect is a benefit to another species, with no benefit to the bearer or its kin, would refute the claim; a survey that finds return benefits in candidate mutualisms supports it only weakly." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Interaction records do not contain fitness effects or exclusive beneficiaries.", "Cryptic return benefits and parasite manipulation are hard to separate from a structure evolved for another species.", "A universal negative cannot be confirmed by failing to find a case." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-13--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch06-13 by Grok 4.7: 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.52"^^xsd:double ;
