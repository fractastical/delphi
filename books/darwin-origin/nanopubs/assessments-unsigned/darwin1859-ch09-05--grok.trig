sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch09-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-05--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch09-05: partially-resolvable, resolvability 0.73" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.729"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Gap durations are a native variable of open stratigraphic databases, and computing them against formation durations is a standard analysis a small team can do quickly. That settles whether separations are wide over a large part of the sedimentary record. It does not by itself show that those gaps, rather than the other biases Darwin listed, are the main source of imperfection, which is why the verdict stays partial." ;
    rdfs:comment "Proposed test with existing data: Measure hiatus lengths between successive fossiliferous formations and compare them with the durations of the formations themselves. Gaps as long as or longer than the recorded intervals support wide unrecorded separations; continuously recorded succession would count against that pattern. Ranking gaps as the chief cause requires comparing their contribution with other biases." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Macrostrat coverage is much denser in some continents than worldwide.", "Calling gaps the chief cause requires a model that partitions incompleteness among erosion, non-deposition, facies, and collection bias.", "Unconformities can be brief locally and still look wide in a compiled column." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch09-05 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
