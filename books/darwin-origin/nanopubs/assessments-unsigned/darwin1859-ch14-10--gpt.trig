  <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-10--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on darwin1859-ch14-10: partially-resolvable, resolvability 0.45" ;
