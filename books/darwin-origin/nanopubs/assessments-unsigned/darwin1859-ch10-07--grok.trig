sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-07--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch10-07: resolvable-now, resolvability 0.73" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.728"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Global event horizons versus staggered regional last appearances are measurable with occurrence data and independent section ages. Methods that put confidence intervals on last appearances reduce, without removing, the tendency of incomplete ranges to look gradual. The usual pattern across the later record can be scored even though place-by-place paths exist only for better-sampled groups." ;
    rdfs:comment "Proposed test with existing data: Compare last-appearance timing of species and genera across regions, and the share of extinctions that fall in globally correlated short intervals versus staggered regional losses. Globally synchronous removal as the usual pattern would challenge the claim; regionally staggered losses outside those intervals would support it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The Signor-Lipps effect smears an abrupt extinction backward so that it looks gradual.", "Geographic coverage is too thin to follow most individual species from place to place." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-07--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch10-07 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
