sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch12-05: resolvable-now, resolvability 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.763"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Endemism fractions for island plants are already coded in open flora inventories, and occurrence data can audit whether a species is truly absent elsewhere. Vertebrate islands are similarly tractable. The test is weaker for insects and for tiny islets with incomplete lists, which is a coverage limit inside an otherwise direct comparison." ;
    rdfs:comment "Proposed test with existing data: For oceanic islands, compute the proportion of species found nowhere else and compare that proportion with mainland regions of similar area. Endemism no higher than on continents, after inventory completeness is taken into account, would refute the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Single-island endemics are sensitive to taxonomic splitting and to undersampling of neighbouring islands.", "Insects, where endemism may be highest, are the least completely listed.", "A raw percentage has to be judged against a species-area baseline." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch12-05 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
