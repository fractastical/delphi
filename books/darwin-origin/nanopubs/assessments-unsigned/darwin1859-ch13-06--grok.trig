sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch13-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-06--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch13-06: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.595"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Where pedigrees exist, nested breed groups can be compared with descent without adopting a new definition of variety. Public genomes and breed inventories cover a few domesticated species well and leave most wild varieties out, so only a restricted scope is testable. Genomic data break the circularity of testing morphology with groups that morphology defined, at the cost of months of cross-study harmonization." ;
    rdfs:comment "Proposed test with existing data: For domestic breeds and wild varieties with known pedigrees or genomic relationships, test whether morphology and named subgroups form a nested hierarchy that matches descent, with deeper splits corresponding to greater modification. The claim is confirmed if breed groups recover the pedigree better than a non-hierarchical clustering, and refuted if varieties of known close descent are morphologically scattered among distant breeds." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Breeds were often defined by the same external traits used to test nested morphological groups, which makes a purely morphological test circular.", "Genomic pedigrees are dense for dogs, horses, chickens and a few crops, and sparse for most domesticated and wild varieties.", "Wild 'varieties' are delimited inconsistently, so the natural-variety half of the scope is much weaker than the breed half." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-06--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-06--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch13-06 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
