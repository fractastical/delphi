  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-08--gpt> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-08--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on darwin1859-ch12-08: resolvable-now, resolvability 0.89" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.893"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.93"^^xsd:double ;
    dct:description "The distributional statement has clear counterexamples and comprehensive modern databases. The seawater mechanism can also be checked experimentally from published data, making the claim strongly resolvable." ;
    rdfs:comment "Proposed test with existing data: Inventory native amphibians on geologically oceanic islands, distinguish introductions, and relate presence to island origin and sea-crossing distance; combine this with saltwater survival experiments for adults and spawn. Native records on remote true oceanic islands or high salt tolerance would refute the strong claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Some island geological classifications are disputed.", "Ancient rafting events can occur despite generally low salt tolerance.", "Introduced populations must be removed." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-08--gpt--dataset-2> .
