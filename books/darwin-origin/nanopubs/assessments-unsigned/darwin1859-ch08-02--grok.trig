sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch08-02: resolvable-now, resolvability 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.75"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "Fertility and inbreeding coefficient are measured together in more than one public pedigree, and the decision rule is a standard regression that a small team can run quickly. The same negative relationship is widely tabulated for other animals and for plants, so the stated generality is not hanging on one species. What the datasets do not settle is Darwin's use of the pattern to explain multi-generation hybrid decline in particular." ;
    rdfs:comment "Proposed test with existing data: Regress fertility or offspring number on pedigree or genomic inbreeding coefficient, treating low inbreeding as the occasional cross with a less related mate. A negative slope confirms that closer interbreeding lowers fertility and that less related matings raise it; a flat or positive slope would refute the relationship." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "These open pedigrees are animals; plant inbreeding-depression tables are more scattered.", "The further application to hybrids kept for several generations is not the design of these wild pedigrees.", "Environmental stress changes the slope, so a single population is not the whole relationship." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch08-02 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
