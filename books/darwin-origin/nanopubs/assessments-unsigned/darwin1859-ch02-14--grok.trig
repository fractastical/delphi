sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-14--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch02-14: partially-resolvable, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.482"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "The component patterns can be measured with trees, floras, and ranges, so the factual bundle is partly open to analysis. The contrast with independent creation is poorly discriminating because that rival does not forbid a specific outcome. A missing bundle would hurt the argument, while a present bundle would still be compatible with more than one historical story." ;
    rdfs:comment "Proposed test with existing data: Test the bundle of variety-like statistics for species in large genera (more infraspecific forms, small unequal gaps, restricted ranges of close allies) and ask whether that bundle is predicted by descent of species from varieties. Failure of the bundle would undermine the explanatory claim; success would favour descent only relative to a creation hypothesis that forbids variety-like structure." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Independent creation can be adjusted to produce any observed pattern, so confirmation is weak.", "The analogies are the same facts used in the neighbouring variety-and-genus claims, and a joint test double-counts them.", "Descent predicts the bundle only after extra assumptions about rates and extinction." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-14--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-14--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch02-14 by Grok 4.7: 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.42"^^xsd:double ;
