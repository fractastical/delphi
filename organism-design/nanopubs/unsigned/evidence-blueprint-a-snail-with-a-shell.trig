  <https://w3id.org/delphi/resource/evidence/organism-blueprint-a-snail-with-a-shell-queries/q05> <https://schema.org/text> "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#> SELECT ?s ?l WHERE { VALUES ?s { <http://purl.obolibrary.org/obo/UBERON_0006612> } ?s rdfs:label ?l . FILTER NOT EXISTS { { ?s obo:RO_0002161 ?nt } UNION { ?s rdfs:subClassOf ?anc . ?anc obo:RO_0002161 ?nt } UNION { ?s obo:BFO_0000050 ?anc . ?anc obo:RO_0002161 ?nt } obo:NCBITaxon_6448 rdfs:subClassOf ?nt } FILTER NOT EXISTS { ?s obo:RO_0002162 ?it . FILTER(REGEX(STR(?it),'NCBITaxon_[0-9]+$')) FILTER NOT EXISTS { obo:NCBITaxon_6448 rdfs:subClassOf ?it } FILTER NOT EXISTS { ?it rdfs:subClassOf obo:NCBITaxon_6448 } } FILTER NOT EXISTS { ?s oio:inSubset <http://purl.obolibrary.org/obo/uberon/core#vertebrate_core> } }" .
