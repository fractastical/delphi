  <https://w3id.org/delphi/resource/evidence/organism-blueprint-a-snail-with-a-shell-queries/q09> <https://schema.org/text> "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#> SELECT ?o ?t ?l (COUNT(DISTINCT ?sup) AS ?depth) WHERE { VALUES ?o { <http://purl.obolibrary.org/obo/UBERON_0000970> <http://purl.obolibrary.org/obo/UBERON_0004859> <http://purl.obolibrary.org/obo/UBERON_0007770> <http://purl.obolibrary.org/obo/UBERON_0006583> <http://purl.obolibrary.org/obo/UBERON_0002365> <http://purl.obolibrary.org/obo/UBERON_0001044> <http://purl.obolibrary.org/obo/UBERON_0000409> <http://purl.obolibrary.org/obo/UBERON_0001829> <http://purl.obolibrary.org/obo/UBERON_0008974> <http://purl.obolibrary.org/obo/UBERON_0007802> <http://purl.obolibrary.org/obo/UBERON_0003134> <http://purl.obolibrary.org/obo/UBERON_0003975> <http://purl.obolibrary.org/obo/UBERON_0005398> <http://purl.obolibrary.org/obo/UBERON_0005056> <http://purl.obolibrary.org/obo/UBERON_0005399> <http://purl.obolibrary.org/obo/UBERON_0003135> <http://purl.obolibrary.org/obo/UBERON_0000989> <http://purl.obolibrary.org/obo/UBERON_0004054> <http://purl.obolibrary.org/obo/UBERON_0004053> <http://purl.obolibrary.org/obo/UBERON_0004765> <http://purl.obolibrary.org/obo/UBERON_0007844> <http://purl.obolibrary.org/obo/UBERON_0006612> } ?o obo:RO_0002162 ?t . ?t rdfs:label ?l . FILTER(REGEX(STR(?t),'NCBITaxon_[0-9]+$')) FILTER(?t NOT IN (obo:NCBITaxon_1, obo:NCBITaxon_131567, obo:NCBITaxon_2759, obo:NCBITaxon_33154)) obo:NCBITaxon_6448 rdfs:subClassOf ?t . ?t rdfs:subClassOf ?sup . } GROUP BY ?o ?t ?l" .
