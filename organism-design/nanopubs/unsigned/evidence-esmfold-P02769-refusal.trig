<http://purl.org/nanopub/temp/np1/assertion> {
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/delphi/ontology/EvidenceItem> .
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <http://www.w3.org/2000/01/rdf-schema#label> "Recorded refusal from the hosted BioNeMo ESMFold endpoint for Albumin (P02769)" .
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <http://purl.org/dc/terms/description> "One request to https://health.api.nvidia.com/v1/biology/nvidia/esmfold on 2026-10-31T13:18:56.765Z, carrying 583 residues (25-607) of Albumin from Bos taurus, UniProt P02769 sequence version 4, sequence SHA-256 b716bd10369cf2056d15dc45b0402e4c39a40f53bbafa8f9185a3f2f6a2cb731. The service answered HTTP 401. Its message, verbatim: API answered 401: {\"status\":401,\"title\":\"Unauthorized\",\"detail\":\"Invalid JWT serialization: Missing dot delimiter(s)\"}. The API key was read from the process environment only and was never written to the repository; the run record holds no key. The key string supplied began \"bak-\", while NVIDIA keys begin \"nvapi-\", so it was a credential for a different service or a truncated paste. Status recorded as \"refused\" in organism-design/esmfold/runs/P02769/result.json (SHA-256 4b9861d5e1390ec63ae6e5312447987d7ea6aaf0510f33b547e1ef1c033b62e9)." .
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <http://purl.org/dc/terms/source> "organism-design/esmfold/runs/P02769/result.json" .
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <http://purl.org/dc/terms/identifier> "sha256:4b9861d5e1390ec63ae6e5312447987d7ea6aaf0510f33b547e1ef1c033b62e9" .
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <http://www.w3.org/ns/prov#wasDerivedFrom> <https://health.api.nvidia.com/v1/biology/nvidia/esmfold> .
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <http://purl.org/dc/terms/references> <https://www.uniprot.org/uniprotkb/P02769> .
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <http://www.w3.org/2000/01/rdf-schema#seeAlso> <https://build.nvidia.com/meta/esmfold> .
  <https://w3id.org/delphi/resource/evidence/organism-esmfold-P02769-refusal-record> <https://schema.org/codeRepository> <https://github.com/fractastical/delphi> .
}
