://purl.obolibrary.org/obo/UBERON_0000382> <http://purl.obolibrary.org/obo/UBERON_0000029> <http://purl.obolibrary.org/obo/UBERON_0002524> <http://purl.obolibrary.org/obo/UBERON_0001474> <http://purl.obolibrary.org/obo/UBERON_0004765> <http://purl.obolibrary.org/obo/UBERON_0001091> <http://purl.obolibrary.org/obo/UBERON_0007844> <http://purl.obolibrary.org/obo/UBERON_0002513> <http://purl.obolibrary.org/obo/UBERON_0002328> <http://purl.obolibrary.org/obo/UBERON_0000955> <http://purl.obolibrary.org/obo/UBERON_0002240> <http://purl.obolibrary.org/obo/UBERON_0000007> <http://purl.obolibrary.org/obo/UBERON_0002360> <http://purl.obolibrary.org/obo/UBERON_0000391> <http://purl.obolibrary.org/obo/UBERON_0002518> <http://purl.obolibrary.org/obo/UBERON_0002113> <http://purl.obolibrary.org/obo/UBERON_0000057> <http://purl.obolibrary.org/obo/UBERON_0000056> <http://purl.obolibrary.org/obo/UBERON_0001255> <http://purl.obolibrary.org/obo/UBERON_0000080> <http://purl.obolibrary.org/obo/UBERON_0000081> <http://purl.obolibrary.org/obo/UBERON_0000991> <http://purl.obolibrary.org/obo/UBERON_0002367> <http://purl.obolibrary.org/obo/UBERON_0003133> <http://purl.obolibrary.org/obo/UBERON_0003134> <http://purl.obolibrary.org/obo/UBERON_0003937> <http://purl.obolibrary.org/obo/UBERON_0000992> <http://purl.obolibrary.org/obo/UBERON_0002048> <http://purl.obolibrary.org/obo/UBERON_0000171> <http://purl.obolibrary.org/obo/UBERON_0007196> <http://purl.obolibrary.org/obo/UBERON_0005203> <http://purl.obolibrary.org/obo/UBERON_0001103> <http://purl.obolibrary.org/obo/UBERON_0005204> <http://purl.obolibrary.org/obo/UBERON_0007379> } ?o obo:RO_0002162 ?t . ?t rdfs:label ?l . FILTER(REGEX(STR(?t),'NCBITaxon_[0-9]+$')) FILTER(?t NOT IN (obo:NCBITaxon_1, obo:NCBITaxon_131567, obo:NCBITaxon_2759, obo:NCBITaxon_33154)) obo:NCBITaxon_8342 rdfs:subClassOf ?t . ?t rdfs:subClassOf ?sup . } GROUP BY ?o ?t ?l" .
