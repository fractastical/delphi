  <https://w3id.org/delphi/resource/evidence/organism-blueprint-a-frog-that-lays-eggs-in-water-queries/q08> <https://schema.org/text> "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#> SELECT ?o ?s ?l WHERE { VALUES ?o { <http://purl.obolibrary.org/obo/UBERON_0007379> } ?o obo:BFO_0000050 ?s . ?s rdfs:subClassOf obo:UBERON_0000467 ; rdfs:label ?l . FILTER(?s != obo:UBERON_0000467) FILTER(STRSTARTS(STR(?s),'http://purl.obolibrary.org/obo/UBERON_')) FILTER NOT EXISTS { { ?s obo:RO_0002161 ?nt } UNION { ?s rdfs:subClassOf ?anc . ?anc obo:RO_0002161 ?nt } UNION { ?s obo:BFO_0000050 ?anc . ?anc obo:RO_0002161 ?nt } obo:NCBITaxon_8342 rdfs:subClassOf ?nt } FILTER NOT EXISTS { ?s obo:RO_0002162 ?it . FILTER(REGEX(STR(?it),'NCBITaxon_[0-9]+$')) FILTER NOT EXISTS { obo:NCBITaxon_8342 rdfs:subClassOf ?it } FILTER NOT EXISTS { ?it rdfs:subClassOf obo:NCBITaxon_8342 } } }" .
