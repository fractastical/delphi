  <https://w3id.org/delphi/resource/evidence/organism-blueprint-a-frog-that-lays-eggs-in-water-queries/q07> <https://schema.org/text> "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#> SELECT DISTINCT ?s ?l WHERE { ?s rdfs:subClassOf obo:UBERON_0000467 . FILTER(?s != obo:UBERON_0000467) FILTER(STRSTARTS(STR(?s),'http://purl.obolibrary.org/obo/UBERON_')) ?s oio:inSubset ?ss . FILTER(?ss IN (<http://purl.obolibrary.org/obo/uberon/core#uberon_slim>,<http://purl.obolibrary.org/obo/uberon/core#efo_slim>,<http://purl.obolibrary.org/obo/uberon/core#vertebrate_core>)) FILTER NOT EXISTS { { ?s obo:RO_0002161 ?nt } UNION { ?s rdfs:subClassOf ?anc . ?anc obo:RO_0002161 ?nt } UNION { ?s obo:BFO_0000050 ?anc . ?anc obo:RO_0002161 ?nt } obo:NCBITaxon_8342 rdfs:subClassOf ?nt } FILTER NOT EXISTS { ?s obo:RO_0002162 ?it . FILTER(REGEX(STR(?it),'NCBITaxon_[0-9]+$')) FILTER NOT EXISTS { obo:NCBITaxon_8342 rdfs:subClassOf ?it } FILTER NOT EXISTS { ?it rdfs:subClassOf obo:NCBITaxon_8342 } } ?s rdfs:label ?l . FILTER NOT EXISTS { ?s rdfs:subClassOf ?o . FILTER(?o != ?s) ?o rdfs:subClassOf obo:UBERON_0000467 . FILTER(?o != obo:UBERON_0000467) FILTER(STRSTARTS(STR(?o),'http://purl.obolibrary.org/obo/UBERON_')) ?o oio:inSubset ?os . FILTER(?os IN (<http://purl.obolibrary.org/obo/uberon/core#uberon_slim>,<http://purl.obolibrary.org/obo/uberon/core#efo_slim>,<http://purl.obolibrary.org/obo/uberon/core#vertebrate_core>)) FILTER NOT EXISTS { { ?o obo:RO_0002161 ?nt } UNION { ?o rdfs:subClassOf ?anc . ?anc obo:RO_0002161 ?nt } UNION { ?o obo:BFO_0000050 ?anc . ?anc obo:RO_0002161 ?nt } obo:NCBITaxon_8342 rdfs:subClassOf ?nt } FILTER NOT EXISTS { ?o obo:RO_0002162 ?it . FILTER(REGEX(STR(?it),'NCBITaxon_[0-9]+$')) FILTER NOT EXISTS { obo:NCBITaxon_8342 rdfs:subClassOf ?it } FILTER NOT EXISTS { ?it rdfs:subClassOf obo:NCBITaxon_8342 } } } FILTER NOT EXISTS { ?s obo:BFO_0000050 ?w . FILTER(?w != ?s) ?w rdfs:subClassOf obo:UBERON_0000467 . FILTER(?w != obo:UBERON_0000467) FILTER(STRSTARTS(STR(?w),'http://purl.obolibrary.org/obo/UBERON_')) ?w oio:inSubset ?ws . FILTER(?ws IN (<http://purl.obolibrary.org/obo/uberon/core#uberon_slim>,<http://purl.obolibrary.org/obo/uberon/core#efo_slim>,<http://purl.obolibrary.org/obo/uberon/core#vertebrate_core>)) FILTER NOT EXISTS { { ?w obo:RO_0002161 ?nt } UNION { ?w rdfs:subClassOf ?anc . ?anc obo:RO_0002161 ?nt } UNION { ?w obo:BFO_0000050 ?anc . ?anc obo:RO_0002161 ?nt } obo:NCBITaxon_8342 rdfs:subClassOf ?nt } FILTER NOT EXISTS { ?w obo:RO_0002162 ?it . FILTER(REGEX(STR(?it),'NCBITaxon_[0-9]+$')) FILTER NOT EXISTS { obo:NCBITaxon_8342 rdfs:subClassOf ?it } FILTER NOT EXISTS { ?it rdfs:subClassOf obo:NCBITaxon_8342 } } } } ORDER BY ?l" .
