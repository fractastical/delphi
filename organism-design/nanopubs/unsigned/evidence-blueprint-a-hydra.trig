  <https://w3id.org/delphi/resource/evidence/organism-blueprint-a-hydra-queries/q08> <https://schema.org/text> "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#> SELECT ?o ?t ?l (COUNT(DISTINCT ?c) AS ?ncells) WHERE { VALUES ?o { <http://purl.obolibrary.org/obo/UBERON_0000970> <http://purl.obolibrary.org/obo/UBERON_0004859> <http://purl.obolibrary.org/obo/UBERON_0006583> <http://purl.obolibrary.org/obo/UBERON_0002365> <http://purl.obolibrary.org/obo/UBERON_0000409> <http://purl.obolibrary.org/obo/UBERON_0008974> <http://purl.obolibrary.org/obo/UBERON_0003134> <http://purl.obolibrary.org/obo/UBERON_0003975> <http://purl.obolibrary.org/obo/UBERON_0005398> <http://purl.obolibrary.org/obo/UBERON_0005056> <http://purl.obolibrary.org/obo/UBERON_0005399> <http://purl.obolibrary.org/obo/UBERON_0003135> <http://purl.obolibrary.org/obo/UBERON_0004054> <http://purl.obolibrary.org/obo/UBERON_0004053> <http://purl.obolibrary.org/obo/UBERON_0004765> <http://purl.obolibrary.org/obo/UBERON_0007844> } ?t obo:BFO_0000050 ?o ; rdfs:subClassOf obo:UBERON_0000479 ; rdfs:label ?l . FILTER(STRSTARTS(STR(?t),'http://purl.obolibrary.org/obo/UBERON_')) FILTER NOT EXISTS { { ?t obo:RO_0002161 ?nt } UNION { ?t rdfs:subClassOf ?anc . ?anc obo:RO_0002161 ?nt } UNION { ?t obo:BFO_0000050 ?anc . ?anc obo:RO_0002161 ?nt } obo:NCBITaxon_6083 rdfs:subClassOf ?nt } FILTER NOT EXISTS { ?t obo:RO_0002162 ?it . FILTER(REGEX(STR(?it),'NCBITaxon_[0-9]+$')) FILTER NOT EXISTS { obo:NCBITaxon_6083 rdfs:subClassOf ?it } FILTER NOT EXISTS { ?it rdfs:subClassOf obo:NCBITaxon_6083 } } FILTER NOT EXISTS { ?t oio:inSubset <http://purl.obolibrary.org/obo/uberon/core#vertebrate_core> } OPTIONAL { ?c obo:BFO_0000050 ?t . FILTER(STRSTARTS(STR(?c),'http://purl.obolibrary.org/obo/CL_')) } } GROUP BY ?o ?t ?l ORDER BY ?o DESC(?ncells) ?l" .
