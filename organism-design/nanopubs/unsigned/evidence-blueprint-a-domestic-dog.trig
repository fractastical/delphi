  <https://w3id.org/delphi/resource/evidence/organism-blueprint-a-domestic-dog-queries/q06> <https://schema.org/text> "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX obo: <http://purl.obolibrary.org/obo/> PREFIX oio: <http://www.geneontology.org/formats/oboInOwl#> SELECT ?sys ?o ?l (MAX(IF(?os = <http://purl.obolibrary.org/obo/uberon/core#major_organ>, 1, 0)) AS ?major) (COUNT(DISTINCT ?c) AS ?ncells) WHERE { VALUES ?sys { <http://purl.obolibrary.org/obo/UBERON_0001009> <http://purl.obolibrary.org/obo/UBERON_0001007> <http://purl.obolibrary.org/obo/UBERON_0004456> <http://purl.obolibrary.org/obo/UBERON_0002330> <http://purl.obolibrary.org/obo/UBERON_0004122> <http://purl.obolibrary.org/obo/UBERON_0001033> <http://purl.obolibrary.org/obo/UBERON_0002390> <http://purl.obolibrary.org/obo/UBERON_0002416> <http://purl.obolibrary.org/obo/UBERON_0002465> <http://purl.obolibrary.org/obo/UBERON_0002204> <http://purl.obolibrary.org/obo/UBERON_0001016> <http://purl.obolibrary.org/obo/UBERON_0001008> <http://purl.obolibrary.org/obo/UBERON_0000990> <http://purl.obolibrary.org/obo/UBERON_0001004> } ?o obo:BFO_0000050 ?sys ; rdfs:subClassOf obo:UBERON_0000062 ; rdfs:label ?l ; oio:inSubset ?os . FILTER(?os IN (<http://purl.obolibrary.org/obo/uberon/core#major_organ>,<http://purl.obolibrary.org/obo/uberon/core#organ_slim>,<http://purl.obolibrary.org/obo/uberon/core#efo_slim>,<http://purl.obolibrary.org/obo/uberon/core#vertebrate_core>)) FILTER NOT EXISTS { ?o oio:inSubset ?bad . FILTER(?bad IN (<http://purl.obolibrary.org/obo/uberon/core#grouping_class>, <http://purl.obolibrary.org/obo/uberon/core#non_informative>, <http://purl.obolibrary.org/obo/uberon/core#upper_level>)) } FILTER(STRSTARTS(STR(?o),'http://purl.obolibrary.org/obo/UBERON_')) FILTER NOT EXISTS { { ?o obo:RO_0002161 ?nt } UNION { ?o rdfs:subClassOf ?anc . ?anc obo:RO_0002161 ?nt } UNION { ?o obo:BFO_0000050 ?anc . ?anc obo:RO_0002161 ?nt } obo:NCBITaxon_9615 rdfs:subClassOf ?nt } FILTER NOT EXISTS { ?o obo:RO_0002162 ?it . FILTER(REGEX(STR(?it),'NCBITaxon_[0-9]+$')) FILTER NOT EXISTS { obo:NCBITaxon_9615 rdfs:subClassOf ?it } FILTER NOT EXISTS { ?it rdfs:subClassOf obo:NCBITaxon_9615 } } OPTIONAL { ?c obo:BFO_0000050 ?o . FILTER(STRSTARTS(STR(?c),'http://purl.obolibrary.org/obo/CL_')) } } GROUP BY ?sys ?o ?l ORDER BY ?sys DESC(?major) DESC(?ncells) ?l" .
