rdfs:subClassOf ?nt } FILTER NOT EXISTS { ?o obo:RO_0002162 ?it . FILTER(REGEX(STR(?it),'NCBITaxon_[0-9]+$')) FILTER NOT EXISTS { obo:NCBITaxon_32443 rdfs:subClassOf ?it } FILTER NOT EXISTS { ?it rdfs:subClassOf obo:NCBITaxon_32443 } } OPTIONAL { ?c obo:BFO_0000050 ?o . FILTER(STRSTARTS(STR(?c),'http://purl.obolibrary.org/obo/CL_')) } } GROUP BY ?sys ?o ?l ORDER BY ?sys DESC(?major) DESC(?ncells) ?l" .
