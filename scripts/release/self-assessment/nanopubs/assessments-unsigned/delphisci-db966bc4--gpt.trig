sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://github.com/fractastical/delphi/tree/db966bc45986743c3cde6d87ef6b567099bb3b7b> a prov:Entity, schema:SoftwareSourceCode ;
    rdfs:label "delphisci (fractastical/delphi) at commit db966bc45986743c3cde6d87ef6b567099bb3b7b" ;
    schema:codeRepository <https://github.com/fractastical/delphi> ;
    dct:description "Project snapshot assessed through the frozen evidence pack (sha256 009970e344904cd1546e2f2890cb438667be100be1acd5c62083a4d2cf5dc701), captured 2026-10-31T22:07:43.964Z." ;
    delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt> .
  <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on delphisci@db966bc4 (Science Claw rubric): 60/100, bonus 0/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0" ;
    delphi:hasScore "0.6"^^xsd:double ;
    delphi:hasConfidence "0.93"^^xsd:double ;
    dct:description "DELPHI addresses an unusually difficult and meaningful problem and has built a real, queryable scientific system with many claims, proofs and data tests. Its strongest weakness under this rubric is not implementation but evidence that decentralization itself adds capability: the pack contains no measured collective-versus-single comparison and no documented outside-team reuse." ;
    rdfs:comment "Weighted total 60/100 (weights problem-significance 0.2, scientific-impact 0.25, decentralized-agency 0.2, collective-capability 0.25, execution-validation 0.1); collaboration bonus 0/10 scored separately. Comparison multi- vs single-agent found: no. Issue #41 claims two four-arm experiments exist, but the evidence pack includes no measured outputs or result table; issue #61 explicitly acknowledges that the quantitative multi-agent versus single-agent comparison is missing. Top fixes: 1. Run and include one pre-registered four-arm collective-versus-single comparison with quality, time, cost and defect metrics. 2. Secure one documented outside-team reuse of the hosted MCP or a dataset that contributes to that team's result. 3. Re-run a broad executable-claim sample, fix drift, and publish a concise reproducibility pass rate with independent faithfulness review." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--problem-significance> a delphi:LLMClaimAssessment ;
    rdfs:label "Problem significance & complexity of delphisci@db966bc4 by GPT-5.6 Sol: 9/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-problem-significance> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/problem-significance" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:description "The project tackles a genuinely hard and consequential problem: converting broad biological laws into source-traceable, formalizable and empirically testable claims across organisms. The snapshot shows the difficulty rather than merely asserting it: evidence/captured/mcp-overview.json reports 1,702 graph claims, 162 mathematical claims, only 63 theorems, only 2 mathematical claims supported by organism data, and 1,508 claims neither proved nor tested; evidence/captured/mcp-organisms.json further shows 1,036 matched taxa but only 2 with bioelectric coverage. This is an ambitious open scientific-infrastructure problem with clear unresolved scientific content, although the pack does not show that solving the whole claim inventory would directly change a working scientist's decisions." ;
    delphi:evidenceAgainst "Show two or three concrete decisions by working biologists that the graph changes, rather than only the size of the unresolved inventory.", "Prioritize a narrow law family with a stated scientific consequence if confirmed or refuted across organisms." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/db966bc45986743c3cde6d87ef6b567099bb3b7b> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--problem-significance> .
  <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--scientific-impact> a delphi:LLMClaimAssessment ;
    rdfs:label "Scientific/technical impact of delphisci@db966bc4 by GPT-5.6 Sol: 7/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-scientific-impact> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/scientific-impact" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:description "Substantial usable outputs exist: evidence/repo/README.md reports 880 production nanopubs, 63 theorems (47 Lean-checked and 16 literature-proved), and 133 claims tested against data; evidence/repo/test-data/claim-tests/SUMMARY.md gives the non-cherry-picked verdict distribution of 78 supports, 25 mixed, 21 refutes and 9 inconclusive, including concrete counter-results such as darwin1859-ch09-03 and thompson1917-ch15-08. The organism layer is also large and queryable, and evidence/captured/mcp-morpholib-live.json identifies 109 production MorphoEval audits with stable trusty IRIs such as https://w3id.org/np/RAtXAz-snj7Cj_FaWUUMcagskmw5GaJa2biZxCtyVyp5c. However, only 66 claims were tested on organisms, 1,508 claims remain neither proved nor tested, issue #37 documents false template-provenance declarations in some production records, and the pack does not establish novelty or independent scientific adoption of the results." ;
    delphi:evidenceAgainst "Obtain independent expert review of a representative sample of extracted claims, Lean faithfulness and biological test interpretations.", "Move more mathematical claims through organism-level tests; the pack shows only 2 currently supported on organism data.", "Remediate and supersede production nanopubs affected by the false template-provenance defect in issue #37." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/db966bc45986743c3cde6d87ef6b567099bb3b7b> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--scientific-impact> .
  <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--decentralized-agency> a delphi:LLMClaimAssessment ;
    rdfs:label "Decentralized agency of delphisci@db966bc4 by GPT-5.6 Sol: 5/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-decentralized-agency> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/decentralized-agency" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:description "The work is meaningfully distributed but centrally directed. Evidence/repo/chats/README.md records 22 parent chats and 119 subagent runs, evidence/captured/subagent-sessions.txt shows distinct extraction, assessment and Lean roles, and evidence/repo/BEST_PRACTICES.md enforces blind assessor != builder and multiple providers. But issue #53 assigns named workstreams and deadlines from a central plan, the git shortlog is dominated by Cursor Agent and Joel Dietz (367 and 148 commits in evidence/captured/git-shortlog.txt), production publication remains exclusively human-gated, and all four forum requests in evidence/captured/forum-requests.json are still open with zero comments. This matches the rubric's midpoint: multiple agents and roles, but one planner/integrator decides trajectory and merges." ;
    delphi:evidenceAgainst "Let agents discover, claim, hand off and revise tasks through shared state without issue #53 prescribing owners and trajectory.", "Document completed cross-agent handoffs and decisions initiated by agents, not only centrally assigned parallel slices.", "Demonstrate forum requests being accepted and completed by independent agents." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/db966bc45986743c3cde6d87ef6b567099bb3b7b> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--decentralized-agency> .
  <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--collective-capability> a delphi:LLMClaimAssessment ;
    rdfs:label "Collective capability of delphisci@db966bc4 by GPT-5.6 Sol: 3/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-collective-capability> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/collective-capability" ;
    delphi:hasScore "0.3"^^xsd:double ;
    dct:description "The collective plausibly enabled breadth and speed: evidence/captured/git-stats.txt shows 515 commits and 13,622 tracked files in roughly 23 hours, while the parallel slices produced 133 tested claims and a large organism inventory. Yet no measured same-task comparison of collective versus single-agent, isolated-agent or centralized execution is included. Issue #41 says a four-arm harness and two 20-claim experiments exist, but the evidence pack contains no protocol output, scores, costs or comparative result; issue #38 is empty, and issue #61 explicitly lists the missing quantitative comparison as a known weak spot. Therefore the pack supports an anecdotal scale argument, not measurable added capability." ;
    delphi:evidenceAgainst "Publish the actual four-arm harness results claimed in issue #41: same tasks, fixed budget, quality, defect rate, time and cost for single, isolated, centralized and decentralized arms.", "Pre-register and run at least one comparison on a scientifically meaningful claim-testing task, not only extraction throughput." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/db966bc45986743c3cde6d87ef6b567099bb3b7b> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--collective-capability> .
  <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--execution-validation> a delphi:LLMClaimAssessment ;
    rdfs:label "Execution and validation of delphisci@db966bc4 by GPT-5.6 Sol: 7/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-execution-validation> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/execution-validation" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:description "This is a functioning, externally reachable system rather than a concept: evidence/repo/mcp/README.md documents the hosted MCP endpoint and query tools, evidence/captured/github-issues.json issue #56 records an independent 100-case MCP test with 93 passes, hosted/local agreement on all 100 cases, 32 ms median hosted latency and six specific defects, and evidence/captured/mcp-morpholib-live.json confirms 109 production audits. Scientific execution is also partially reproducible, but evidence/repo/scripts/exec/runs/latest.json reproduced only 3 of 6 selected data claims while 3 drifted, including 141 mismatches for darwin1859-ch10-12; evidence/captured/nanopub-manifests.txt shows cell-geometry remains test-only, and evidence/repo/mcp/README.md states that no assessments are published to the network. Strong implementation and real checks are shown, but not yet uniformly reproducible or externally validated." ;
    delphi:evidenceAgainst "Run the executable-claim suite broadly and resolve the drift shown in evidence/repo/scripts/exec/runs/latest.json.", "Fix and retest the seven MCP failures in issue #56, including Windows local mode and SPARQL ASK/CONSTRUCT.", "Publish assessment records and reviewed cell-geometry outputs beyond the test registry." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/db966bc45986743c3cde6d87ef6b567099bb3b7b> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--execution-validation> .
  <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--collaboration-bonus> a delphi:LLMClaimAssessment ;
    rdfs:label "Collaboration bonus of delphisci@db966bc4 by GPT-5.6 Sol: 0/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-collaboration-bonus> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/collaboration-bonus" ;
    delphi:hasScore "0"^^xsd:double ;
    dct:description "No documented reuse by another team is shown. Evidence/repo/COLLABORATIONS.md records invitations, active conversations and 1,522 MCP calls but explicitly says users cannot be identified or confirmed; evidence/captured/forum-feed.json shows zero comments on every listed post, and issue #41 states that observed reuse is zero. Issue #56 is useful external testing by Amit within the named project team in issue #53, not evidence that another team reused the capability in its own result. The Fittest work in evidence/repo/plugins/fittest/README.md is delphisci reusing another team's design, which does not satisfy this bonus in the required direction." ;
    delphi:evidenceAgainst "Get one outside team to use the MCP, dataset, harness or nanopub workflow in its own result and obtain a public citation or confirmation.", "Convert current invitations and unidentified traffic into a named, reproducible cross-team artifact." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/db966bc45986743c3cde6d87ef6b567099bb3b7b> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--gpt--collaboration-bonus> .
  <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent ;
    rdfs:label "delphisci Science Claw rubric assessor (GPT-5.6 Sol)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> ;
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
  <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a delphi:LanguageModel ;
    rdfs:label "GPT-5.6 Sol" ;
    dct:identifier "gpt-5.6-sol-medium" .
}

