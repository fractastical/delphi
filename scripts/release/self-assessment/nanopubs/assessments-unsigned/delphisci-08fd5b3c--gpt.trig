sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> a prov:Entity, schema:SoftwareSourceCode ;
    rdfs:label "delphisci (fractastical/delphi) at commit 08fd5b3cbf047cccb320effade623db662aff92f" ;
    schema:codeRepository <https://github.com/fractastical/delphi> ;
    dct:description "Project snapshot assessed through the frozen evidence pack (sha256 a86ff77761764ed5e8bbeadb2b868d35c46a6c3c8cd811393d3c09663c5b60d1), captured 2026-11-01T05:10:57.508Z." ;
    delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on delphisci@08fd5b3c (Science Claw rubric): 82.5/100, bonus 7/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0" ;
    delphi:hasScore "0.825"^^xsd:double ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    dct:description "DELPHI addresses a genuinely hard problem and produced an unusually large, usable body of formalizations, data tests and machine-readable infrastructure. Its strongest judging evidence is a real pre-registered collective-versus-single comparison with a clear coverage gain, but scientific impact is limited by uneven reproducibility, sparse organism validation of formal laws and little independent expert review." ;
    rdfs:comment "Weighted total 82.5/100 (weights problem-significance 0.2, scientific-impact 0.25, decentralized-agency 0.2, collective-capability 0.25, execution-validation 0.1); collaboration bonus 7/10 scored separately. Comparison multi- vs single-agent found: yes. It measured verified public-dataset coverage for 20 pre-registered claim-test plans under matched model, prompt, tools and budget in two experiments: every multi-agent arm beat single by at least 4 of 20. It did not measure scientific correctness, whether a dataset could decide the claim, or a general decentralized advantage; centralized and decentralized arms were not distinguishable. Top fixes: 1. Independently assess the four-arm plans for scientific decisiveness and repeat the comparison across models and seeds. 2. Pin mutable datasets and rerun the full executable-claim manifest to eliminate unexplained drift. 3. Obtain a domain-expert audit of a stratified sample of organism-data verdicts and publish the review records." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--problem-significance> a delphi:LLMClaimAssessment ;
    rdfs:label "Problem significance & complexity of delphisci@08fd5b3c by GPT-5.6 Sol: 9/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-problem-significance> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/problem-significance" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:description "The target—precise, testable, cross-organism laws of biology—is genuinely difficult and consequential, and the pack makes the open scientific surface concrete rather than merely asserting it: evidence/repo/problems/README.md defines 20 unresolved Tier A-C problems with acceptance criteria and falsifiers, while evidence/captured/mcp-overview.json records 1,761 claims, 187 mathematical claims, only 87 theorems, and 1,524 claims neither proved nor tested. The breadth is unusually strong, spanning evolution, morphology, reaction-diffusion, computation and bioelectricity, though much of the corpus is historical claim extraction rather than a tightly selected frontier question, and only 6 mathematical claims are supported by organism data." ;
    delphi:evidenceAgainst "Select one Tier A-C problem and show a domain-expert-backed argument that solving it would change a current scientific decision.", "Increase the number of formal laws tested on organism data beyond 6 of 187 mathematical claims." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--problem-significance> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--scientific-impact> a delphi:LLMClaimAssessment ;
    rdfs:label "Scientific/technical impact of delphisci@08fd5b3c by GPT-5.6 Sol: 8/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-scientific-impact> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/scientific-impact" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:description "Substantial checked outputs exist: evidence/captured/mcp-overview.json reports 87 theorems (71 Lean-checked and 16 literature-proved), and evidence/captured/mcp-tests-summary.json reports 161 claims tested in 167 runs, including 82 on organisms, with 87 supports, 35 mixed, 28 refutes and 11 inconclusive. The negative and scope-sensitive Thompson results are scientifically useful rather than promotional: forum records for https://w3id.org/delphi/resource/claim/thompson1917-ch07-08 and https://w3id.org/delphi/resource/claim/thompson1917-ch07-09 explicitly preserve refutations, mixed scope and caveats. The hosted MCP, production nanopubs and organism index make results usable, but rigor is uneven: 1,524 claims remain neither proved nor tested, many tests are computational, and the pack contains no independent domain-expert validation of the biological verdicts." ;
    delphi:evidenceAgainst "Obtain independent domain-expert review of a representative stratified sample of biological verdicts.", "Convert more of the 1,524 neither-proved-nor-tested claims into pre-registered, reproduced results instead of expanding the corpus." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--scientific-impact> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--decentralized-agency> a delphi:LLMClaimAssessment ;
    rdfs:label "Decentralized agency of delphisci@08fd5b3c by GPT-5.6 Sol: 7/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-decentralized-agency> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/decentralized-agency" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:description "Decision-making is genuinely distributed in a bounded experiment: evidence/repo/test-data/agent-comparison/four-arm/PREREG.md specifies a decentralized arm in which three queens with distinct briefs pull tickets from a shared board, post gap notes and tips, and receive no planner-directed assignments. The wider build also used many distinct workers—evidence/captured/subagent-sessions.txt and evidence/repo/COLLABORATIONS.md document hundreds of subagent launches and 19 cloud agents—and the git record includes Cursor Agent, Amit Shenoy, Joel Dietz and Ashley Caselli. However, the repository trajectory shown in evidence/repo/chats/README.md is still predominantly prescribed through many centrally initiated tasks, and evidence/captured/git-shortlog.txt attributes most commits to Cursor Agent and the lead operator; autonomous pickup and revision through shared state is demonstrated mainly in the comparison, not as the governing mode of the whole project." ;
    delphi:evidenceAgainst "Run the main research pipeline through a persistent shared board where agents autonomously choose, hand off and revise tasks.", "Record agent-authored decisions and cross-agent revisions, not only launch counts and centrally assigned task transcripts." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--decentralized-agency> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--collective-capability> a delphi:LLMClaimAssessment ;
    rdfs:label "Collective capability of delphisci@08fd5b3c by GPT-5.6 Sol: 9/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-collective-capability> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/collective-capability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:description "A measured collective-vs-single-agent comparison was found in evidence/repo/test-data/agent-comparison/SUMMARY.md, with protocol in four-arm/PREREG.md and deviations in four-arm/DEVIATIONS.md (issues #41, #61 and #62; imported from PR #36). It compared the same model, prompt, schema, tools and claim set on producing 20 pre-registered test plans with one verifiable public dataset: in experiment 1 single/isolated/centralized/decentralized scored 13/17/19/18 verified datasets, and in experiment 2 12/16/18/17; every multi-agent arm exceeded single by at least 4 of 20 in both experiments, while final plans had no fabricated identifiers. This is clear measured coverage gain, but it did not measure whether datasets could actually decide claims, scientific accuracy, or a statistically powered general advantage; n=20, one model/provider, and centralized versus decentralized was indistinguishable. The single agent was also 5.19-10.74 times cheaper than the best collective arm." ;
    delphi:evidenceAgainst "Have a different-provider assessor judge whether each named dataset can actually decide its claim.", "Repeat the four-arm comparison across multiple tasks, models and seeds with uncertainty estimates and matched cost reporting." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--collective-capability> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--execution-validation> a delphi:LLMClaimAssessment ;
    rdfs:label "Execution and validation of delphisci@08fd5b3c by GPT-5.6 Sol: 8/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-execution-validation> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/execution-validation" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:description "This is a functioning system, not an architecture sketch: evidence/repo/mcp/README.md describes an externally usable hosted MCP; evidence/captured/nanopub-manifests.txt records 2,085 production manifest entries across Darwin, Thompson and Wolfram; evidence/captured/mcp-morpholib-live.json confirms 109 externally published MorphoEval nanopubs; and evidence/captured/mcp-organisms.json exposes 1,036 matched taxa with explicit coverage axes. Validation includes machine-checked Lean reports, pre-registration, checksums, negative controls and immutable nanopub practices. The score is capped because the latest executable-claim sample in evidence/repo/scripts/exec/runs/latest.json reproduced only 3 of 6 selected data claims while 3 drifted, the capture reports 14 dirty files, and independent expert or real-world validation of the project's biological conclusions is absent." ;
    delphi:evidenceAgainst "Pin mutable remote inputs and make the full executable-claim manifest reproduce without unexplained drift.", "Capture independent expert or external-user validation for biological outputs, not only model and script checks." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--execution-validation> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--collaboration-bonus> a delphi:LLMClaimAssessment ;
    rdfs:label "Collaboration bonus of delphisci@08fd5b3c by GPT-5.6 Sol: 7/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-collaboration-bonus> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/collaboration-bonus" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:description "The pack shows more than offers: evidence/repo/README.md documents separate delphi-evolve and delphi-frontier repositories built on Delphi claims and the MCP server; Evolve used typed claim adapters as executable checks, and Frontier imported live Delphi claims into a versioned shared workspace. evidence/repo/COLLABORATIONS.md records 30 frontier-adapters sessions, and evidence/captured/github-prs.json shows Ashley Caselli's merged PR #63 adding claim grounding. This supports material ecosystem reuse, but the strongest reuse claims are summarized by this repository rather than independently captured from the sibling teams, forum requests have zero comments and remain open, and the pack does not show an outside team's published scientific result whose validity depends on Delphi." ;
    delphi:evidenceAgainst "Capture an external team's own record that Delphi reuse materially changed its result.", "Close at least one forum request with an accepted collaborator and a linked delivered artifact." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--gpt--collaboration-bonus> .
  <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent ;
    rdfs:label "delphisci Science Claw rubric assessor (GPT-5.6 Sol)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> ;
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
  <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a delphi:LanguageModel ;
    rdfs:label "GPT-5.6 Sol" ;
    dct:identifier "gpt-5.6-sol-medium" .
}

