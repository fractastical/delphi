sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> a prov:Entity, schema:SoftwareSourceCode ;
    rdfs:label "delphisci (fractastical/delphi) at commit 08fd5b3cbf047cccb320effade623db662aff92f" ;
    schema:codeRepository <https://github.com/fractastical/delphi> ;
    dct:description "Project snapshot assessed through the frozen evidence pack (sha256 a86ff77761764ed5e8bbeadb2b868d35c46a6c3c8cd811393d3c09663c5b60d1), captured 2026-11-01T05:10:57.508Z." ;
    delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on delphisci@08fd5b3c (Science Claw rubric): 62.5/100, bonus 5/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0" ;
    delphi:hasScore "0.625"^^xsd:double ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "This is a real, queryable claim graph: 1,761 claims, 71 machine-checked Lean formalizations, 161 data tests including 28 refutations, and a public MCP, built in about 30 hours. The scientific yield is still mostly checked restatements of known claims, the only exec re-run reproduced 3 of 6, and a published nanopub still asserts a verdict the team has retracted. A collective-versus-single comparison was found and it shows a gain on URL-checked test plans, not on scientific verdicts; decentralized agents did not beat a central planner, and the forum shows no outside uptake." ;
    rdfs:comment "Weighted total 62.5/100 (weights problem-significance 0.2, scientific-impact 0.25, decentralized-agency 0.2, collective-capability 0.25, execution-validation 0.1); collaboration bonus 5/10 scored separately. Comparison multi- vs single-agent found: yes. Found a measured collective-vs-single comparison, plus a second comparison that does not show a gain. The primary one (SUMMARY.md, protocol repo/test-data/agent-comparison/four-arm/PREREG.md, caveats repo/test-data/agent-comparison/four-arm/DEVIATIONS.md, imported from open PR #36) ran four arms — single agent, 20 isolated workers, centralized king, decentralized board — on the same task, model (claude-sonnet-5-5), tools and budget: write a pre-registered test plan naming one public dataset for each of 20 frozen Darwin and Thompson claims, twice (40 claims total). It measured verified datasets out of 20 (HTTP 2xx and the page names the dataset) and fabricated identifiers. It did not measure whether the dataset can decide the claim, whether a later data test supports or refutes the claim, or cost-adjusted scientific output. Multi-agent arms beat the single agent by at least 4 of 20 on that URL metric in both primary runs; decentralized did not beat centralized; the isolated replicate tied the single agent at 15. A separate one-slice comparison, repo/scripts/release/agent-comparison/aristotle-ha06/RESULTS.md, extracted and scored Aristotle History of Animals Book VI and explicitly found no swarm advantage once model identity is separated from the arm. The per-plan verifier logs are not in the pack. Top fixes: 1. Re-execute every organism-level claim test in scripts/exec, supersede the stale production nanopub for thompson1917-ch07-04 (issue #69), and run the faithfulness gate (issue #40) on the 28 refutations. Surest gain: scientific-impact +1 and execution-validation +2, about 4.5 weighted points, roughly 6 hours, because the tests and the harness already exist. 2. Score the existing experiment-2 plans with a different-provider assessor on whether the named dataset can decide the claim, and republish the arm table under the same ≥2 rule. About 4 hours. Moves collective-capability by about +1 (2.5 weighted points) only if the margin survives; SUMMARY.md already says URL checks do not answer this. 3. Run the decentralized board, with no pre-assigned claim ids, against a single agent on 20 scouted organism-level claims, and require a result.json verdict rather than a plan. About 10 hours. Can move collective-capability and decentralized-agency by about one point each if queens actually pull tickets and the verdict margin holds; the current experiment does not establish that." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--problem-significance> a delphi:LLMClaimAssessment ;
    rdfs:label "Problem significance & complexity of delphisci@08fd5b3c by Grok 4.7: 7/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-problem-significance> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/problem-significance" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:description "The problem named in repo/README.md, laws that hold across organisms and are stated precisely enough to test, is open and consequential, and the snapshot shows a real gap: captured/mcp-overview.json reports 1,761 claims and 187 math claims of which only 6 are supported by data measured on organisms, with 1,524 neither proved nor tested. repo/problems/README.md lists tiered open problems (Lewontin's paradox, metabolic scaling, species-area, the bioelectric code) and says nothing there is solved. It stays at 7 because the work actually in the graph is mostly historical extraction. Aristotle is 566 claims, all untested (domain https://w3id.org/delphi/resource/domain/aristotle-biology). Wolfram is 321 claims and 64 tests, every one computational and none on organisms (captured/mcp-tests-summary.json). Issues #42–#50 are a flying-fish build, not a law a working biologist is blocked on. The stakes are partly measured and partly asserted by the README goal." ;
    delphi:evidenceAgainst "Pick one tier-B problem from repo/problems/README.md (species-area, metabolic scaling, or Lewontin's paradox), state the acceptance test and the falsifier in a result table, and stop counting untested Aristotle (566) and computational Wolfram checks as progress on that problem.", "Show, with a citation a working biologist would recognize, which open question in the pack is actually blocked on the missing measurement, rather than on another pass of extraction." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--problem-significance> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--scientific-impact> a delphi:LLMClaimAssessment ;
    rdfs:label "Scientific/technical impact of delphisci@08fd5b3c by Grok 4.7: 6/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-scientific-impact> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/scientific-impact" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:description "Checked outputs exist and some are usable. README.md and captured/mcp-overview.json agree on 87 theorems (71 Lean-checked, 16 literature) and 161 data tests (87 supports, 35 mixed, 28 refutes, 11 inconclusive), 82 of them on organisms, with 880 claims described as live production nanopubs. captured/lean-reports.txt sums to those 71 formalized declarations (Darwin Islands 4, Struggle 7, Succession 5, Tree 4; Thompson Cells 15, HornsLeavesEggs 12, Hygromorphs 4, Magnitude 13, Mechanics 7). repo/test-data/claim-tests/SUMMARY.md records high-confidence refutations a biologist can name: darwin1859-ch09-03 (Weald denudation, 0.98), darwin1859-ch09-14 (continents fixed since the Silurian, 0.95), darwin1859-ch12-08 (frogs absent from oceanic islands, 0.93), thompson1917-ch15-08 (0.97), thompson1917-ch17-13 (perissodactyls nearer lagomorphs, 0.97), levin-2022-tame-19 (morphogenesis/memory gene overlap, 0.7). The newest empirical thread is the cell-packing reruns, including the Cellpose-SAM segmenter-bias null on the forum. This is not anchor 10. The Lean instructions (repo/claim-sources/thompson-growth-form/lean/INSTRUCTIONS.md) encode stated laws with no sorry; they do not produce new mathematics. Most Darwin supports restate textbook biogeography. Wolfram's 48 supports are re-checks of cellular automata. Issue #69 is open: the published nanopub for thompson1917-ch07-04 still asserts confidence 0.6 after the unsigned revision moved it to 0.35. The only re-run in the pack, repo/scripts/exec/runs/latest.json at 2026-10-31T21:41:51Z, reproduced 3 of 6 data claims; darwin1859-ch10-12, ch10-16 and ch12-11 drifted, and the first two now have a null verdict. Queryable today via https://delphisci-mcp.fly.dev/mcp; not yet a set of new laws with reproduced biological effects." ;
    delphi:evidenceAgainst "Supersede the published thompson1917-ch07-04 nanopub so production matches the unsigned revision at confidence 0.35 (issue #69), and point the claim-test summary at the superseding IRI.", "Add n, dataset, effect size and nanopub IRI for the 28 refutations and the 6 math claims supported on organisms; SUMMARY.md currently has a one-line verdict only.", "Run issue #40's faithfulness gate on those organism tests and drop any verdict the gate marks not-representative." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--scientific-impact> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--decentralized-agency> a delphi:LLMClaimAssessment ;
    rdfs:label "Decentralized agency of delphisci@08fd5b3c by Grok 4.7: 5/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-decentralized-agency> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/decentralized-agency" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:description "Several agents and models do distinct jobs, and a planner still sets the trajectory. Blind assessors are told not to read one another (repo/claim-sources/darwin-origin/assessment/INSTRUCTIONS.md). captured/subagent-sessions.txt shows batched extractors, Grok and Gemini assessors, and five Lean modules launched together. repo/COLLABORATIONS.md counts 101 local chats, 262 subagents and 19 cloud agents; captured/git-shortlog.txt is Cursor Agent 367, Amit Shenoy 182, Joel Dietz 178, Ashley Caselli 7. repo/chats/README.md shows the human assigning each slice, and repo/test-data/organisms/README.md pre-cuts chapters so parallel agents cannot collide; PRs #18–#33 are those slices, all opened by fractastical. Issue #53 names owners and a Sunday noon freeze. The decentralized arm in repo/test-data/agent-comparison/four-arm/PREREG.md lets three queens pull tickets with no king, but that is one pre-registered experiment whose queens are coroutines in a single process. captured/forum-feed.json has 20 posts, every one by delphisci, and 0 comments; all 4 requests in captured/forum-requests.json are open. Issue #69 names moltbook-vina, moltbook-hivefound and moltbook-nanoswarm on an unsigned revision that the published nanopub does not carry. That matches the 5 anchor: different roles and models, one planner deciding what each does and when." ;
    delphi:evidenceAgainst "Let queens pull the next organism-level claims from the 76 scouted candidates in captured/mcp-tests-candidates.json with no human-assigned claim ids, and commit the board log of who took which ticket.", "Close one of the four open forum requests via an offer from an agent who is not delphisci; captured/forum-requests.json has zero comments on every request." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--decentralized-agency> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--collective-capability> a delphi:LLMClaimAssessment ;
    rdfs:label "Collective capability of delphisci@08fd5b3c by Grok 4.7: 7/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-collective-capability> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/collective-capability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:description "A measured same-task comparison is in the pack; see comparison_found. repo/test-data/agent-comparison/SUMMARY.md, built from the import of PR #36 (commit 1a9d4d28, issues #41, #61, #62), reports two pre-registered experiments on claude-sonnet-5-5 with the same prompt, schema, tools and budget. Primary metric: verified datasets out of 20, meaning the landing page returns 2xx and names the dataset, with zero fabricated identifiers. Experiment 1 ($3, web tools allowed and used by no arm): single 13, isolated 17, centralized 19, decentralized 18, with 1 fabricated identifier on all attempts and 0 in final plans. Experiment 2 ($8, fetch required): single 12, isolated 16, centralized 18, decentralized 17, zero fabricated. Under the pre-registered rule (beat by at least 2 and zero fabricated), centralized beats single by 6 in both, isolated beats single by 4, centralized beats isolated by exactly 2, and decentralized versus centralized is no difference. Experiment 1's replicate did not keep the isolated win (single 15, isolated 15, centralized 19, decentralized 18). The single agent costs about a fifth to a tenth as much and wins on cost per verified dataset; experiment 2's 8 single-agent shortfalls were blank plans. repo/scripts/release/agent-comparison/aristotle-ha06/RESULTS.md is a second comparison and finds no swarm gain (Jaccard 0.37–0.61, score agreement no better than model-to-model, models confounded with arms, n=1 slice). DEVIATIONS.md records that the pre-registration time rests on a session transcript, not a commit hash that predates the runs, and quotes an unverified sister result with no collective advantage. A clear gain on a proxy is a 7. It is not a 10: the metric is not whether the dataset can decide the claim, decentralization adds nothing over a king, and a second comparison in the same pack is null." ;
    delphi:evidenceAgainst "Have an assessor from a provider other than the arm's model score whether each experiment-2 dataset can decide the claim, and apply the existing ≥2 / zero-fabricated rule to that score. SUMMARY.md says this was not measured.", "Commit a pre-registration hash that predates the run. DEVIATIONS.md says the current timestamp is a transcript, not a prior commit.", "Report cost per verified scientific verdict beside coverage. On the present metric the single agent wins on cost." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--collective-capability> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--execution-validation> a delphi:LLMClaimAssessment ;
    rdfs:label "Execution and validation of delphisci@08fd5b3c by Grok 4.7: 6/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-execution-validation> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/execution-validation" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:description "There is a running, externally reachable system, and its headline outputs are only partly re-checked. The pack is itself a live query: captured/mcp-overview.json (1,761 claims, 4,266 TriG files, built 2026-11-01 04:57) against the server README.md places at https://delphisci-mcp.fly.dev/mcp. repo/COLLABORATIONS.md records 1,522 tool calls and 60 sessions on 2026-10-31. The forum at https://science-claw-forum.fly.dev returned 20 posts. captured/nanopub-manifests.txt shows production lines Darwin 248, Thompson 874, Wolfram 963 and cell-geometry 0 (these are manifest lines, not the 880-claim figure). captured/mcp-morpholib-live.json finds 109 production MorphoEval audits with no nanopub hash change, and notes that most Thompson audits are not on that endpoint; one cited production IRI is https://w3id.org/np/RAtXAz-snj7Cj_FaWUUMcagskmw5GaJa2biZxCtyVyp5c. Against a 10: repo/scripts/exec/runs/latest.json reproduced 3 of 6 data claims and blanked the verdict on two drifts, including a real statistic move on darwin1859-ch12-11 (Spearman −0.2258 to −0.2189). Issue #40 says the faithfulness assessor has covered 0 of 16 data tests (it did score 4 Lean statements: 3 faithful-with-narrower-scope, 1 faithful). Issue #69 says a production nanopub still asserts a retracted verdict. Issue #37 says np check exits 0 on parse errors and that live records falsely declare their template. Issue #56 says 93 of 100 MCP cases pass. MANIFEST.json lists 14 dirty files. That is a running system whose validation was tried and did not fully hold." ;
    delphi:evidenceAgainst "Re-run every biological and physical claim test through scripts/exec, ignore volatile byte_size (the 141 and 65 mismatches on darwin1859-ch10-12 and ch10-16), and fail the run when the verdict or the pre-registered statistic moves (darwin1859-ch12-11).", "Make np check fail on the parse errors and false template declarations in issue #37, and re-check the production IRIs.", "Clear the 14 dirty files in MANIFEST.json so the pinned tree is what the tests ran on." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--execution-validation> .
  <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--collaboration-bonus> a delphi:LLMClaimAssessment ;
    rdfs:label "Collaboration bonus of delphisci@08fd5b3c by Grok 4.7: 5/10" ;
    dct:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-collaboration-bonus> ;
    delphi:assessmentType "scienceclaw-rubric/0.1.0/collaboration-bonus" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:description "Tools are published and offered, with contact and without documented reuse by another team that fed into that team's result. The MCP needs no auth (repo/README.md, repo/mcp/README.md) and the forum is public, but captured/forum-feed.json is 20 posts by delphisci and 0 comments. repo/COLLABORATIONS.md logs Discord replies that people would look, a SentiLab thread with InquilineKea marked awaiting their repo, an unanswered floorplanning offer, and Fittest marked not contacted (issue #57). The same file shows a frontier-adapters client with 30 sessions from 18:10–18:51 UTC and calls it unidentified; README.md later attributes sibling use to kganjam/delphi-evolve and kganjam/delphi-frontier and says those checks were not re-run, evolve has no submission receipt, and frontier artifacts were not byte-checked. Issue #53 lists Kris (@kganjam) as a member of this team, and open issue #41 says the reuse category has zero observed reuse and would score zero. Issue #69's moltbook-vina, moltbook-hivefound and moltbook-nanoswarm credits sit on an unsigned revision, not on another team's published result. That is the 5 anchor." ;
    delphi:evidenceAgainst "Get one team that issue #53 does not list as a member to record a result that used the MCP or a dataset, with their repo link and the claim ids, and attach that record. Issue #41 still says reuse is unobserved.", "Send the Fittest calibration note that COLLABORATIONS.md says was not sent, and keep their reply." ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> .
  <https://github.com/fractastical/delphi/tree/08fd5b3cbf047cccb320effade623db662aff92f> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/delphisci-08fd5b3c--scienceclaw-rubric-0.1.0--grok--collaboration-bonus> .
  <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> a prov:SoftwareAgent ;
    rdfs:label "delphisci Science Claw rubric assessor (Grok 4.7)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/grok-4.7-high-fast> ;
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
  <https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a delphi:LanguageModel ;
    rdfs:label "Grok 4.7" ;
    dct:identifier "grok-4.7-high-fast" .
}

