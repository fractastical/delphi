sub:Head {
this: np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo;
    a np:Nanopublication
}
sub:assertion {
<https://github.com/fractastical/delphi/tree/db966bc45986743c3cde6d87ef6b567099bb3b7b> a prov:Entity, <https://schema.org/SoftwareSourceCode>;
    dc:description "Project snapshot assessed through the frozen evidence pack (sha256 009970e344904cd1546e2f2890cb438667be100be1acd5c62083a4d2cf5dc701), captured 2026-10-31T22:07:43.964Z.";
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci (fractastical/delphi) at commit db966bc45986743c3cde6d87ef6b567099bb3b7b";
    <https://schema.org/codeRepository> <https://github.com/fractastical/delphi>;
    <https://w3id.org/delphi/ontology/hasAssessment> <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok>, <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--collaboration-bonus>, <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--collective-capability>, <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--decentralized-agency>, <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--execution-validation>, <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--problem-significance>, <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--scientific-impact>.
<https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    dc:description "This is a real claim-audit system, built in about 27 hours: 1702 claims, 63 theorems of which 47 are Lean-checked, 133 data verdicts including sharp refutations of Darwin and Thompson, a public MCP another teammate scored 93/100, and an honest Cellpose bias correction. The scientific bar it sets for itself is not met: faithfulness has run on 0 of 16 data tests, a 6-claim re-run drifted on 3, assessments are not on the network, and 18 later verdicts never entered the audited table. Decisions sit with one planner and several models; a four-arm collective comparison is claimed in issue #41 and not shown, and no other team is documented using the tools in their own result.";
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on delphisci@db966bc4 (Science Claw rubric): 57/100, bonus 5/10";
    dc:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Weighted total 57/100 (weights problem-significance 0.2, scientific-impact 0.25, decentralized-agency 0.2, collective-capability 0.25, execution-validation 0.1); collaboration bonus 5/10 scored separately. Comparison multi- vs single-agent found: no. Issue #41 asserts a four-arm comparison (single agent, isolated workers, centralized swarm, decentralized swarm) and says two experiments of 20 claims each were run. The issue body has no arm scores, and the pack has no result file, so no gain is shown. plugins/fittest/README.md compares two-assessor routing with always reporting the mean on 99 data tests (trusted accuracy 0.935 vs 0.83; 12 of 17 assessor errors caught). That measures a calibration rule, not collective versus single agent on the same scientific task. Top fixes: 1. Publish arm scores for the two 20-claim four-arm runs named in issue #41, or, if they were not saved, add single-assessor versus pair accuracy on the 99 labeled tests already counted in plugins/fittest/README.md. Collective capability is weight 0.25 and is the weakest high-weight score; a real gain table is the cheapest way to move it. 2. Run issue #40's faithfulness assessor on five headline biological tests and commit the verdicts. Scientific impact is weight 0.25, and the team already records that 0 of 16 data tests have passed this gate while 3 of 4 Lean modules were narrower than the claim. 3. Regenerate the claim-test summary from commit db966bc4 so the 18 later Test commits are audited, re-exec the 3 drifted Darwin tests plus the 47 Lean reports, and promote the cell-geometry bias result off the test registry (production count 0). That is the cheapest joint lift on scientific impact and on execution (weight 0.10).";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "scienceclaw-rubric/0.1.0";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.57"^^xsd:double.
<https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--collaboration-bonus> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    dc:description "Tools and data are published and other people have been talked to; nobody outside this team is shown using them in their own result. The MCP URL, the forum at https://science-claw-forum.fly.dev (14 posts in captured/forum-feed.json), production nanopubs, and the organism coverage ranking are public. repo/COLLABORATIONS.md records Delfie offering Thompson and Turing claims in the SentiLab room, an active exchange with InquilineKea (ticket 57c7c42f) that is still awaiting their repo, Discord replies from Symplectic Geometry of Awe and Joshua G that they would look at the MCP, and Fittest marked not contacted. The same file says usage cannot be tied to a person: 1522 tool calls and 60 sessions from 14:40 to 19:28 UTC, peak unique visitors 3, and the heavy clients (corpus-census, frontier-adapters, delphi-validation) are unidentified and may be this project's own cloud agents. Forum requests have 0 comments. Open PRs #36 (Amit Shenoy) and #52 (Ashley Caselli) are the teammates named in issue #53, and neither is merged. Issue #41 states the reuse category as zero observed reuse and asks another team to run the harness and say so. Contact without a documented downstream use is the middle of this bonus, not the top.";
    <http://www.w3.org/2000/01/rdf-schema#label> "Collaboration bonus of delphisci@db966bc4 by Grok 4.7: 5/10";
    dc:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-collaboration-bonus>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "scienceclaw-rubric/0.1.0/collaboration-bonus";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok>;
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Contact Fittest with the pilot finding already written in plugins/fittest/README.md (2× C–O bond trusted at 0.67 on 3 labels); the log says they have not been contacted.", "Get one non-team project to query the hosted MCP and cite a claim IRI in their own committed result; issue #41 already says that is the missing evidence.", "Turn the InquilineKea exchange (COLLABORATIONS.md, ticket 57c7c42f) into a claim or test in their repo that names a delphisci id, or drop it from the log.".
<https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--collective-capability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    dc:description "I did not find a measured collective-versus-single comparison. Issue #41 asserts a four-arm harness (single agent, isolated workers, centralized swarm, decentralized swarm) and says two experiments of 20 claims each were run; the issue body is 1844 characters and contains no arm scores, cost, or verdict counts, and no result file is in the pack. The nearest measurement is a different question: repo/plugins/fittest/README.md leave-one-out on 99 tests, where a router that uses disagreement between GPT-5.6 Sol and Grok 4.7 beats always reporting their mean (0.935 versus 0.83 when trusted; 12 of 17 errors caught; 5 silent failures the router cannot see). That shows two assessors' disagreement is informative. It does not show that a collective of agents outperforms one agent on the same extraction, proof or data task. Parallel throughput is real and uncompared: 515 commits from 2026-10-30 18:40 to 2026-10-31 17:55 (git-stats.txt), 13622 tracked files, and the merged cloud-agent slices above. Issue #51 proposes an open-weight versus frontier builder comparison on 3 claims and leaves every checkbox open. Throughput under one planner is a plausible argument that many agents finished more than one session would have. The rubric's 10 requires the gain to be measured, and this snapshot does not measure it.";
    <http://www.w3.org/2000/01/rdf-schema#label> "Collective capability of delphisci@db966bc4 by Grok 4.7: 4/10";
    dc:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-collective-capability>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "scienceclaw-rubric/0.1.0/collective-capability";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok>;
    <https://w3id.org/delphi/ontology/evidenceAgainst> "If those runs were not saved, compute single-assessor versus two-assessor accuracy on the same 99 decisive tests already used in plugins/fittest/README.md and write the arm scores next to the existing 0.935 versus 0.83 routing table.", "Publish the outcome table for the two 20-claim four-arm runs asserted in issue #41: same claims, single versus isolated versus centralized versus decentralized, with verdict agreement, cost and defects per arm. The issue has no numbers.", "Run the unchecked comparison in issue #51 (open-weight builder versus frontier builder, same 3 claims, blind dual audit) and report defect counts.".
<https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--decentralized-agency> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    dc:description "Judgment is split across models, and the trajectory is still one person's. captured/mcp-overview.json records dataset-resolvability/0.1.0 on all 247 Darwin claims by 2 assessors (494 assessments) and 0.2.0 on 922 claims by 2 assessors (1844 assessments); claim-test/0.1.0 has 134 assessments by 4 assessors. repo/claim-sources/darwin-origin/assessment/INSTRUCTIONS.md tells each assessor to ignore other raw outputs and the extractor's claims.json. captured/subagent-sessions.txt names separate grok, gemini and claude assessor batches, five Lean module agents, and per-chapter extractors. git-shortlog.txt is 367 commits by Cursor Agent and 148 by Joel Dietz; git-log.txt shows Joel merging cursor/organisms-* and cursor/claim-tests-* branches (for example 6295cab1: 129 results from 13 agent branches; a622ca3f: 930 GBIF records scored). repo/chats/README.md is the planner's log: the user messages assign Darwin, then Thompson, then Wolfram, then the overnight test run and the overnight organism run. Commit b17db571 renames the project from Decentralized to Distributed. Issue #17 evaluates a five-agent harness proposal and concludes publishing must stay with the human ORCID key. Issue #53 assigns Ashley, Kavita, Kris, Amit and Joel as owners with a Sunday freeze; the issue JSON has no check-in comments. captured/forum-feed.json is 14 posts, all by delphisci, all with 0 comments, and 4 requests still open. Agents have different models and blind rubrics. They do not pick up, hand off and revise the scientific trajectory through the forum; a human names the next batch.";
    <http://www.w3.org/2000/01/rdf-schema#label> "Decentralized agency of delphisci@db966bc4 by Grok 4.7: 5/10";
    dc:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-decentralized-agency>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "scienceclaw-rubric/0.1.0/decentralized-agency";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok>;
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Have an agent other than the planner accept one open forum request (4af45541, 4d611dec, d1c0ad10, or 2414e185), do the work, and land it without a Joel commit that assigns the task. The feed currently has 0 comments and 0 offers.", "Record assessor disagreement as a trigger that starts a re-test, using the spread already defined in mcp/README.md, so a second model can revise a verdict through shared state.", "Stop treating issue #53's human RACI as the coordination layer for scientific choices; publish which agent picked up which claim id and why.".
<https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--execution-validation> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    dc:description "A system is up and an outside-the-builder teammate has exercised it, and the scientific re-run is not clean. The hosted MCP is public (repo/README.md, repo/mcp/README.md). captured/github-issues.json #56, filed against Amit's open PR #36, reports 100 cases on all eight tools then listed, 93 passing, hosted https://delphisci-mcp.fly.dev/mcp agreeing with local origin/main on all 100, median latency 32 ms; the seven failures include Windows local mode broken on backslashes in IRIs, unescaped claim ids, ASK/CONSTRUCT errors, and graph/organisms silently ignoring source network. repo/scripts/exec/runs/latest.json (2026-10-31T21:41:51Z) re-ran 6 data claims: 3 reproduced (levin-2023-competency-04, levin-2023-competency-05, wolfram2002-ch12-42) and 3 drifted. darwin1859-ch10-12 drifted on 141 of 685 comparisons, mostly derived file byte sizes; darwin1859-ch10-16 on 65 of 166; darwin1859-ch12-11 changed the measured Spearman from -0.2258 to -0.2189 and left the new verdict null. The run's kind is data only, so the 47 Lean reports were not re-checked here. Issue #37 says production records declare nt:wasCreatedFromTemplate against legacy probknow templates, and that nanopub-java 1.95.0 check exits 0 on parse failures; one live IRI is given (https://w3id.org/np/RAtLFqIIyu4r-GlMcBEfmDtbV-CHwWxQ49gVMtHIX6r48) and the count of affected records was not measured. Issue #40: faithfulness 0/16 data tests. Dataset-reliability scoring is in git-log merge messages (930 GBIF: 919 reliable, 11 caveats; 357 NCBI all reliable; 346 PBDB/OBIS: 299/45/2; 46 shared databases: 28/16/2) and those score files are not in the pack. MANIFEST.json records 88 dirty files at capture. The forum and MCP are real. The claim verdicts are not yet reproduced as a set.";
    <http://www.w3.org/2000/01/rdf-schema#label> "Execution and validation of delphisci@db966bc4 by Grok 4.7: 6/10";
    dc:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-execution-validation>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "scienceclaw-rubric/0.1.0/execution-validation";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok>;
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fix the Windows IRI bug and the silent source:network ignore from issue #56, and stop treating nanopub check's exit code as a gate until issue #37 is fixed.", "Re-run scripts/exec on the 3 drifted Darwin tests in repo/scripts/exec/runs/latest.json and on the 47 Lean reports; darwin1859-ch12-11 changed a reported coefficient and produced a null verdict.", "Reconcile README's 880 live production nanopubs with the 2085 production manifest lines, and rebuild the overview so domain claims (1756, Aristotle domain 566) match the graph (1702, Aristotle 512).".
<https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--problem-significance> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    dc:description "The problem the snapshot actually works is hard and still open: which candidate biological laws, stated so a machine can cite them, survive a proof check and a data check, with those two axes kept apart. repo/README.md and repo/AGENTS.md define a theorem as a math claim that is Lean-checked or proved in the literature, and say a data verdict never promotes a claim. captured/mcp-overview.json (claim graph built 2026-10-31 20:44) counts 1702 claims, 162 with math, 63 theorems (47 Lean, 16 literature), 2 math claims supported by organism measurements, 133 data-tested (78 supports, 25 mixed, 21 refutes, 9 inconclusive; 66 on organisms), and 1508 neither proved nor tested. The stakes are shown by specific high-confidence refutations in repo/test-data/claim-tests/SUMMARY.md, not by the tagline: darwin1859-ch09-03 (Weald denudation ~300 Myr, refutes 0.98; git-log.txt 82347127 says 66 Ma versus 300 Myr), darwin1859-ch09-14 (continents fixed since the Silurian, refutes 0.95), darwin1859-ch12-08 and ch12-09 (frogs and terrestrial mammals on oceanic islands, refutes 0.93 and 0.9), thompson1917-ch17-13 (perissodactyls nearer lagomorphs, refutes 0.97), thompson1917-ch04-13 (chromosome counts, refutes 0.9). captured/mcp-organisms.json shows why the bioelectric half is still open: of 1036 matched taxa, bioelectric coverage is 2. What keeps this off a 9 or 10 is the corpus itself. Wolfram's 321 claims and all 59 of his tests are computational (SUMMARY.md); Aristotle's 512 graph claims have zero tests and zero assessments (mcp-overview.json); Levin is 310 claims and 2 tests in that table. Issues #42–#50 (flying-fish wing, print, ethics) are a plan with no measurement in the pack.";
    <http://www.w3.org/2000/01/rdf-schema#label> "Problem significance & complexity of delphisci@db966bc4 by Grok 4.7: 8/10";
    dc:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-problem-significance>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "scienceclaw-rubric/0.1.0/problem-significance";
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok>;
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Close or demote issues #42–#50 until a measured glide, fin outline or envelope test exists; as open plans they dilute the problem the repo has actually framed.", "Move Levin and the two organism-supported math claims from the edge of the table into the center: the audited snapshot tests 2 of 310 Levin claims and supports 2 of 162 math claims on organisms.", "Put one working biologist's review on a headline biological verdict (the open forum request 2414e185 for thompson1917-ch07-04/08/10) so the stakes are external rather than internal.".
<https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok--scientific-impact> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    dc:description "There are real, citable outputs, and their rigour is uneven enough that a 7 would over-claim. The audited result table is repo/test-data/claim-tests/SUMMARY.md: 133 claims, 135 runs, 78/25/21/9, of which 66 biological, 4 physical, 60 computational, 3 with data kind none. Forty-four of the 78 supports are Wolfram re-computations. Biological refutations and the Thompson cell-packing correction are the results a stranger could use: forum-feed.json posts that Cellpose-SAM found the 120° junction claim holding in 4 of 5 tissues with grass epidermis as a counter-example, then that the segmenter rounds brick walls into honeycombs and the margin is partly bias, and that thompson1917-ch07-04 confidence moved from 0.6 to 0.35 (SUMMARY.md already lists that claim as mixed at 0.35). Lean report counts in captured/lean-reports.txt are 47 formalized and 7 not (Cells 15, HornsLeavesEggs 12, Magnitude 13, Mechanics 7), matching the 47 Lean theorems. Issue #40 says an independent OpenAI check of those 4 modules returned 3 faithful-with-narrower-scope and 1 faithful, and that the faithfulness gate has run on 0 of 16 data tests. repo/plugins/fittest/README.md is a finished methodological result: on 99 decisive tests, routing on assessor disagreement trusts 77, flags 22, catches 12 of 17 assessor errors, and is 0.935 accurate when trusted against 0.83 for always reporting the mean, with 5 named silent failures. Against that: mcp/README.md states no assessments are on the network; nanopub-manifests.txt has 2085 production lines (darwin 248, thompson 874, wolfram 963, cell-geometry 0) while README.md says 880 live production nanopubs, and the pack never reconciles the two; cell-geometry's bias result is test-registry only (8 lines); git-log.txt after 16:44 EDT records 18 further Test commits (8 supports, 4 refutes, 4 mixed, 2 inconclusive) whose result.json files are not in the pack, so the 133 is a stale audit of HEAD db966bc4. Only 2 of 162 math claims are supported on organisms.";
    <http://www.w3.org/2000/01/rdf-schema#label> "Scientific/technical impact of delphisci@db966bc4 by Grok 4.7: 6/10";
    dc:subject <https://w3id.org/delphi/resource/concept/scienceclaw-rubric-0.1.0-scientific-impact>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "scienceclaw-rubric/0.1.0/scientific-impact";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/delphisci-db966bc4--scienceclaw-rubric-0.1.0--grok>;
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Publish the cell-geometry evidence (nanopub-manifests.txt: production 0, test 8) and the dataset-reliability scores, and publish assessments to the network so mcp/README.md's 'ranking only works on local' gap is closed.", "Regenerate SUMMARY.md from HEAD so the 18 Test commits after 16:44 EDT (git-log.txt, db966bc4 back through wolfram2002-ch02-02) are in the audited table with hypotheses, datasets and verdicts, not only subject lines.", "Run the faithfulness assessor in issue #40 on at least the five headline biological tests and commit faithfulness.json with the model named; 0 of 16 data tests have it, and 3 of 4 Lean modules were already judged narrower than the claim.".
<https://w3id.org/delphi/resource/agent/delphisci-scienceclaw-rubric-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci Science Claw rubric assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast"
}
sub:provenance {
