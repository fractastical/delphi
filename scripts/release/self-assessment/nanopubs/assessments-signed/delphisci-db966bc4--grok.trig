    prov:wasGeneratedBy sub:assessment.
sub:assessment a prov:Activity;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Blind assessment: the assessor saw only the rubric and the frozen evidence pack, not the builders' view or other assessors' output. The builder's model provider (Anthropic) did not assess.";
    prov:qualifiedAssociation sub:assessmentPlan;
