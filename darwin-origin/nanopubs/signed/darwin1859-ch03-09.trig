sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch03-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Although competition between organisms constantly recurs with shifting outcomes, the opposing forces are so finely balanced that community composition stays roughly the same for long periods, even though a trifling change could tip the balance toward one organism.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Balanced struggles keep communities uniform over long periods";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter III, “Struggle for Existence”; section “Complex relations of all animals and plants throughout nature”. Scope: natural communities of plants and animals"
}
