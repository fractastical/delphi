sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch07-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The cell-making instinct of the hive-bee was acquired through natural selection by slight successive modifications of simpler instincts, of the kind seen in a graded series from humble-bees through Melipona to the hive-bee.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Hive-bee comb building evolved by gradual modification of simpler bee instincts";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter VII, “Instinct”; section “Hive-bee, its cell-making instinct”. Scope: social bees (bumble-bees, stingless bees, honey-bees)"
}
