sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-intro-04> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Species are not independently created and immutable; species of the same genus are lineal descendants of some other, generally extinct, species, just as varieties of one species descend from that species.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Species are not immutable but descend from other, mostly extinct, species";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), the Introduction; section “Introduction”. Scope: all species of plants and animals"
}
