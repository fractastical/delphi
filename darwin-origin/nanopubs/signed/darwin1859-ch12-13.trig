sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch12-13> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The distinct species inhabiting the separate islands of an archipelago are far more closely related to one another than to the inhabitants of any other part of the world, because the islands received immigrants from the same source or from each other.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Species on islands of one archipelago are closest relatives of each other";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter XII, “Geographical Distribution, continued”; section “On the relation of the inhabitants of islands to those of the nearest mainland”. Scope: endemic species of oceanic archipelagos"
}
