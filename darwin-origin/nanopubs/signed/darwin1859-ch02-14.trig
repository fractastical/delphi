sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch02-14> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The analogies between species of large genera and varieties (more varieties, small and unequal differences, restricted ranges) are understandable if species once existed as varieties, and inexplicable if each species was independently created.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Analogies between species of large genera and varieties support descent";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter II, “Variation under Nature”; section “Summary”. Scope: species and varieties of plants and animals"
}
