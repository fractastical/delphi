sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch06-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "All vertebrates with true lungs have descended from an ancient ancestor that had a swimbladder used for flotation, which natural selection converted into a lung.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Lung-bearing vertebrates descend from an ancestor with a swimbladder";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter VI, “Difficulties on Theory”; section “Means of transition.”. Scope: vertebrates"
}
