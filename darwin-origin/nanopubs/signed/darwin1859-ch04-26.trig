sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch04-26> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Like a tree in which only a few early twigs grew into surviving branches, very few of the species that lived in long-past geological periods now have living modified descendants, and many whole orders, families and genera have died out entirely.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Very few species of past periods have living descendants";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter IV, “Natural Selection”; section “Summary”. Scope: all lineages over geological time"
}
