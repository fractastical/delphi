sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch06-11> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Despite the small proportion of living and known forms relative to extinct and unknown ones, it is rare to find an organ toward which no transitional grade is known to lead.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Few organs lack any known transitional grade";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter VI, “Difficulties on Theory”; section “Natura non facit saltum.”. Scope: organs of plants and animals"
}
