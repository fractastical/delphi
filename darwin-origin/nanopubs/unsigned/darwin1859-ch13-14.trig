sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch13-14> a delphi:Claim ;
    rdfs:label "Unity of type reflects a common progenitor's pattern modified by slight steps" ;
    dct:description "The shared pattern of homologous organs within a class is explained by descent from an ancient progenitor (an archetype) that already had that pattern, which natural selection then modified by slight successive steps for different uses without transposing parts." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter XIII, “Mutual Affinities of Organic Beings: Morphology: Embryology: Rudimentary Organs”; section “MORPHOLOGY, between members of the same class, between parts of the same individual”. Scope: members of the same class (e.g. mammal limbs, insect mouthparts)" ;
    dct:type "historical-inference" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <http://www.wikidata.org/entity/Q20968204> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-darwin-origin-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "If we suppose that the ancient progenitor, the archetype as it may be called, of all mammals, had its limbs constructed on the existing general pattern, for whatever purpose they served, we can at once perceive the plain signification of the homologous construction of the limbs throughout the whole class." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q20968204> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/1228/pg1228.txt#line=13026,13032> .

