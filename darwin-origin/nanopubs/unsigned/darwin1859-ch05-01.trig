}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch05-01> a delphi:Claim ;
    rdfs:label "Variability is induced by changed conditions acting on the reproductive system" ;
    dct:description "Deviations of structure arise in some way from the conditions of life to which parents and their ancestors have been exposed over several generations, acting chiefly by disturbing the reproductive system; hence variability is greater under domestication or cultivation than in nature." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter V, “Laws of Variation”; section “Effects of external conditions.”. Scope: plants and animals, domesticated and wild" ;
    dct:type "mechanism" .
}

