sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-12> a delphi:Claim ;
    rdfs:label "Selection on the family explains traits of sterile social-insect workers" ;
    dct:description "Traits of sterile workers in social insects can evolve because selection acts on the family: fertile parents whose colonies produce sterile members with a useful modification flourish and transmit the tendency to produce such members." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter VII, “Instinct”; section “Neuter or sterile insects”. Scope: social insects with sterile castes (ants, bees, wasps, termites)" ;
    dct:type "mechanism" .
}

