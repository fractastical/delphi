    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "If under a nearly similar climate, the eocene inhabitants of one quarter of the world were put into competition with the existing inhabitants of the same or some other quarter, the eocene fauna or flora would certainly be beaten and exterminated" ;
