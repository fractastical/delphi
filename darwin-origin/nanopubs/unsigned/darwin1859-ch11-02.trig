}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-02> a delphi:Claim ;
    rdfs:label "Barriers to migration correspond closely to differences between regional biotas" ;
    dct:description "Barriers of any kind that obstruct free migration (oceans, isthmuses, mountain ranges, deserts, large rivers) are closely related to the differences between the inhabitants of different regions, and the more impassable and long-standing the barrier, the greater the difference." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter XI, “Geographical Distribution”; section “Importance of barriers”. Scope: terrestrial and marine organisms across continents, oceans and within continents" ;
    dct:type "empirical-generalization" .
}

