sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch01-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-09--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch01-09: resolvable-now, resolvability 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.824"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "Dog and wild canid genomes are public in the sequence archives, and ancestry graphs are a standard analysis a small team can rerun. The data cover major breed groups and the living wild species Darwin would have considered, with real gaps for extinct wolves. Those gaps and the species-versus-population ambiguity lower discriminating power without changing the fact that a single-species versus multi-species origin is directly testable now." ;
    rdfs:comment "Proposed test with existing data: Estimate ancestry graphs for worldwide dog breeds against wild canids using public genomes. Descent from several wild species would be supported by substantial founding ancestry from two or more canid species; a single founding species, with only later minor admixture, would refute that reading." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Extinct Pleistocene wolf populations are unevenly sampled, so an unsampled source can look like a missing species.", "Darwin's geographical 'species' may correspond to wolf populations that current taxonomy treats as one species.", "Modern breed admixture with coyotes or jackals can be mistaken for a separate domestication origin." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-09--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch01-09 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
