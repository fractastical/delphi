sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch06-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-03--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch06-03: partially-resolvable, resolvability 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.524"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Numerical rarity of intermediate forms can be proxied by abundance and area in hybrid zones, especially in birds. The varieties in the wording are not a stable modern category, and non-bird data are mostly presence-only. Under-description of intermediates biases the test toward finding them rare, which limits how strongly a positive result would count." ;
    rdfs:comment "Proposed test with existing data: Identify phenotypically intermediate populations between two forms and compare their abundance or occupied area with the forms they connect. Much smaller counts for the intermediates would confirm the claim; intermediates as numerous as the endpoint forms would refute it. Subspecies and hybrid-zone censuses are the operational stand-in for varieties." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Intermediate varieties are under-described, so the rarest ones are missing.", "Occurrence density is a poor abundance measure outside well-watched birds.", "Hybrid zones can be dense locally even when the intermediate phenotype is geographically narrow." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-03--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-03--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch06-03 by Grok 4.7: 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.64"^^xsd:double ;
