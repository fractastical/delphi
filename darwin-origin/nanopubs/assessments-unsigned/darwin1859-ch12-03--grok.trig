sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-03--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch12-03: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.473"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Bird movements and aquatic ranges are public, and some genetic studies line up with flyways, so a partial association test is possible. The causal ranking of birds over water, wind, and people is not in those databases. The mechanism can be examined for a handful of plants and microcrustaceans and not shown to be the main process worldwide." ;
    rdfs:comment "Proposed test with existing data: Relate the genetic connectivity of widespread freshwater plants and small invertebrates to waterbird flyways, and compare documented bird transport of their seeds and eggs with transport by wind or water. Connectivity that follows bird movements more closely than other vectors would support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Transport experiments and vector comparisons are scattered in papers and are not one database.", "People move aquatic organisms widely, which can create the same ranges.", "Mainly requires a quantitative ranking of vectors that existing data rarely provide." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-03--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-03--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch12-03 by Grok 4.7: 0.6" ;
