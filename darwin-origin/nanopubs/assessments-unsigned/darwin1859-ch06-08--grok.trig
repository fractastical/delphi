sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch06-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-08--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch06-08: not-empirically-resolvable, resolvability 0.12" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.118"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "The empirical clause that no such organ is known reports a state of argument rather than a measurable frequency. Any organ still lacking a known intermediate is compatible with the rule, because the rule demands a demonstration of impossibility, which comparative and fossil data cannot supply. Scores stay near the floor because there is no decision criterion a dataset could meet." ;
    rdfs:comment "Proposed test with existing data: The sentence is a falsification rule: the theory fails if some complex organ could not possibly have been reached by successive slight modifications. No measurement records impossibility of every pathway, and a gap in known intermediates does not decide it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Impossibility of every gradual pathway is modal, not a dataset variable.", "Missing intermediates are predicted both by true saltation and by an incomplete record, so the outcomes do not discriminate." .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch06-08 by Grok 4.7: 0.15" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.15"^^xsd:double ;
