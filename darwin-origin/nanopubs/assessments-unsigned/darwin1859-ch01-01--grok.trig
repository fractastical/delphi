sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch01-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-01--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch01-01: partially-resolvable, resolvability 0.57" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.569"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "The comparison itself maps cleanly onto within-group dispersion, and public variant archives plus breed lists cover the main livestock and crop species. A full phenotypic test of older cultivated varieties against wild relatives still has to be compiled from studies and gene banks. The contrast can discriminate the stated pattern from its opposite for that subset, with the caveat that today's uniform breeds are a biased sample of what Darwin observed." ;
    rdfs:comment "Proposed test with existing data: Compare within-variety coefficients of variation, or genomic heterozygosity, for homologous characters in long-cultivated populations and in wild populations of the parent species. Greater within-group dispersion in the domestic samples would support the contrast; equal or smaller domestic dispersion across a pre-registered trait set would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Modern breed standards have deliberately reduced within-breed differences since the nineteenth century.", "Genetic heterozygosity and visible individual differences can move in opposite directions after a domestication bottleneck.", "Individual-level phenotypic measurements are scattered, while public sequence archives over-represent a few commercial species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch01-01 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
