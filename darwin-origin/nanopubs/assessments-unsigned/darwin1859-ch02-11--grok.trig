sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-11--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch02-11: partially-resolvable, resolvability 0.63" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.625"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Pairwise distances and genus sizes are both in open trees, barcode libraries, and, more patchily, trait tables. A negative relationship is directly computable for insects and many plant genera. Because small gaps are partly how large genera get delimited, morphology is the less circular measure and it is the less complete dataset, so the test remains only partly discriminating." ;
    rdfs:comment "Proposed test with existing data: Regress mean pairwise morphological or genetic distance among congeners on genus richness. Smaller distances in larger genera would support the pattern; equal or larger distances would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Taxonomists split large genera more finely, which shrinks genetic distances by practice.", "Trait databases often store one mean per species and miss the characters Darwin compared.", "Phylogenetic distance and morphological difference can disagree about which genera are 'close'." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-11--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-11--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch02-11 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-11--grok--operationalizability> .
