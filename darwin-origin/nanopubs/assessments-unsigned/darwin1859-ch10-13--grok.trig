sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-13--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch10-13: resolvable-now, resolvability 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.723"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Age versus membership in extant genera and families is directly tabulated and is the comparison Darwin's taxonomic language supports. A regression of distance on age can be run on occurrence data in weeks, with morphospace as a check in covered clades. Living fossils and rank conventions reduce sharpness without making the age trend untestable." ;
    rdfs:comment "Proposed test with existing data: For fossil genera binned by age, measure taxonomic or morphological distance to the nearest living relatives and test whether that distance increases with age. No age trend, or ancient forms as similar to living ones as younger fossils are, would refute the general rule." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Taxonomic rank is a coarse stand-in for amount of difference.", "Living-fossil exceptions are expected under a general rule and have to be scored as exceptions, which softens the test.", "Character matrices cover a subset of clades." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch10-13 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
