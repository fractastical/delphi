  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on darwin1859-ch08-02: resolvable-now, resolvability 0.75" ;
