sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch09-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-09--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch09-09: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.649"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "The immigration test is a spatial query on a single open occurrence database and is practical to run. It can confirm immigration whenever an older external record exists, which is the informative direction. The converse, local origin, is hardly distinguishable from incomplete geographic sampling, so the claim that immigration is the usual explanation stays only partly decidable." ;
    rdfs:comment "Proposed test with existing data: For marine species whose first local occurrence is above the base of a formation, test whether older occurrences exist in other regions. A majority with earlier records elsewhere would support immigration as the usual explanation; a majority with no earlier record anywhere, in well-sampled groups, would favor local origin." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Failure to find an older record elsewhere is weak evidence of in-situ origin because most regions are undersampled.", "Many species are known from a single basin, so the test has no second locality.", "Reworking and uncertain correlation can create false earlier occurrences." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-09--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch09-09 by Grok 4.7: 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
