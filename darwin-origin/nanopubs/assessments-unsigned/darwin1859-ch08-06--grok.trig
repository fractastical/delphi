sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch08-06: partially-resolvable, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.715"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Genetic distance is a better independent measure of affinity than a taxonomy that may already have used fertility, and the fly dataset plus public distances make the regression a standard analysis. Discriminating power is high inside the clades that have both variables. Adequacy is only partial because plants, vertebrates, and most invertebrates lack a similarly complete open crossing table." ;
    rdfs:comment "Proposed test with existing data: Regress first-cross success and hybrid fertility on genetic or phylogenetic distance. A strong positive relationship of isolation with distance, with residual scatter and with no hybrids between families, supports affinity as a large but not strict governor; no relationship, or frequent fertile crosses between distant families, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Crossing outcomes outside a few model clades are not in the same table as the distances.", "Family rank is a human cutoff, so 'never between families' partly reflects how families were drawn.", "Genetic distance is a proxy for the systematic affinity of 1859 classifications." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch08-06 by Grok 4.7: 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.86"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok--operationalizability> .
