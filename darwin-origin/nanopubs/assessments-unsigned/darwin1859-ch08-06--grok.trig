  <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Drosophila speciation dataset" ;
    dct:description "isolation indices paired with genetic distance for fly species" ;
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.g5g43> .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: TimeTree" ;
