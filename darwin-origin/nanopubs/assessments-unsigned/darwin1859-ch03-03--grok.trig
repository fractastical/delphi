sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch03-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-03--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch03-03: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.667"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Fecundity, survival, and at least relative abundance are public for a large comparative sample, and the regression is a standard life-history test. The sample is still a subset of animals and plants, and size confounding is serious though tractable. The statement is close to resolvable for that subset and not yet a full-scope census." ;
    rdfs:comment "Proposed test with existing data: In a phylogenetic regression, predict average abundance from fecundity after controlling for juvenile survival and body size. A weak partial effect of fecundity, together with a positive association between fecundity and early mortality, would support indirect dependence and compensation; a strong direct fecundity-abundance relationship with no early-mortality tradeoff would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Body size drives both fecundity and abundance and must be partialled out.", "Absolute average abundance is missing for many species that have excellent fecundity data.", "The joint sample is biased toward well-studied vertebrates, fish, and plants." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-03--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-03--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch03-03 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
