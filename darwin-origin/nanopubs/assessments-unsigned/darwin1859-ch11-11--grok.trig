sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-11--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch11-11: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.645"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Glacial-age lowland fossils and modern ranges are in open databases and can test the geographic half of the relict hypothesis for many plants. Species-level identity of fossils and the genetic unity of summit populations are available only case by case. The full claim is decidable for well-studied European and North American taxa and not for the whole arctic-alpine biota." ;
    rdfs:comment "Proposed test with existing data: For arctic-alpine species shared among separated mountains and the Arctic, test whether last-glacial fossils occur in the intervening lowlands and whether genetic data show one recent northern population. Deep divergence among summit populations, together with no glacial-age lowland fossils, would count against a glacial-relict origin." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Pollen and many macrofossils are not identified to species.", "Range-wide genetic studies cover a subset of the European and North American biota.", "Survival on unglaciated peaks and later long-distance dispersal can mimic parts of the relict pattern." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-11--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-11--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch11-11 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-11--grok--operationalizability> .
