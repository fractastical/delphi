  <https://w3id.org/delphi/resource/claim/darwin1859-ch04-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-12--gpt> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-12--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on darwin1859-ch04-12: partially-resolvable, resolvability 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.64"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "The universal assertion is falsifiable by persistent obligate-selfing lineages and genomic methods can detect rare crosses. Existing data cover many plants and some animals, but cannot establish an eternal necessity across all organisms." ;
    rdfs:comment "Proposed test with existing data: Identify lineages with genomic evidence of prolonged obligate selfing and test persistence, fertility and genetic load through time. Any indefinitely selfing, persistent lineage would refute the universal claim, while recurrent outcrossing across well-sampled nominal selfers would support it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "An unlimited number of generations cannot be observed.", "Rare outcrossing is difficult to exclude from finite genomic samples." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-12--gpt--dataset-2> .
