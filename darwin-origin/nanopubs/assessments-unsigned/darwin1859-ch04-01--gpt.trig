sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch04-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--gpt> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on darwin1859-ch04-01: partially-resolvable, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.71"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Modern quantitative genetics makes the mechanism explicit and many open studies measure selection directly. The all-organism scope and context dependence prevent full resolution from existing datasets." ;
    rdfs:comment "Proposed test with existing data: Estimate associations between heritable trait or allele values and survival and reproductive success across populations. Consistently positive selection differentials for advantageous variants and negative differentials for harmful variants support the mechanism; absent or reversed fitness effects refute it in tested systems." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Advantage is environment-dependent and risks being defined circularly by survival.", "Available longitudinal fitness data cover a small fraction of organisms." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--gpt--dataset-2> .
