sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-04--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch08-04: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.591"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "The frequency claim has an obvious proportion, and one open dataset can estimate it inside Drosophila, including pairs fertile enough to challenge universality. Sampling bias and narrow taxonomy keep that from being a test of plants and animals generally. A broader compilation exists only as papers and would take months to harmonize." ;
    rdfs:comment "Proposed test with existing data: Estimate the proportion of interspecific crosses with reduced fertility of the first cross or the hybrids, and ask whether any well-documented crosses are fully fertile. A high proportion plus at least some fully fertile exceptions would support 'extremely general but not universal'; either rarity of sterility or no fertile exceptions would count against that wording." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Published crosses favor tractable taxa and both unusually fertile and unusually sterile outcomes.", "Drosophila does not stand in for plants and animals at large.", "Taxonomic rank affects the denominator of 'between species'." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch08-04 by Grok 4.7: 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.82"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-04--grok--operationalizability> .
