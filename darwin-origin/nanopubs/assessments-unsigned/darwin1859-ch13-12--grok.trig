sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch13-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-12--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch13-12: resolvable-now, resolvability 0.73" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.728"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.71"^^xsd:double ;
    dct:description "Intermediate stem fossils are a direct confirming observation, and public occurrence data plus morphological matrices already contain the vertebrate series the claim highlights, including birds. A well-sampled class boundary with no intermediates would count against the claim, so the outcome can go either way. Non-vertebrate classes are less adequate, but they do not block a decision for the vertebrate scope Darwin treats as the strong case." ;
    rdfs:comment "Proposed test with existing data: For vertebrate classes and other well-fossilized higher groups, test whether stem fossils occupy morphological positions between the living classes and whether denser sampling shrinks the gaps. The claim is confirmed if connecting series are present and stratigraphically early, as with the dinosaur-bird transition, and refuted if a densely sampled class boundary shows a persistent morphological break with no intermediate stem forms." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Soft-bodied and microscopic groups rarely preserve the intermediate anatomies the claim requires, so the test is strongest for skeletonized vertebrates.", "A fossil can narrow a gap without showing that the missing forms were utterly destroyed rather than still unfound.", "Last appearances are smeared backward by incomplete sampling, which can exaggerate how suddenly a connecting series seems to end." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-12--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch13-12 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
