sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch01-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-02--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch01-02: partially-resolvable, resolvability 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.364"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The causal contrast is definable, but the datasets that are easy to download record where cultivated plants differ, not whether uneven conditions produced that variability. A honest test needs common-garden or mutation-accumulation designs that are not assembled in one open archive. Existing compilations can describe domestic versus wild dispersion and leave the mechanism entangled with selection and crossing." ;
    rdfs:comment "Proposed test with existing data: Hold ancestry constant and compare phenotypic or mutational variance of lines reared in uniform ancestral environments versus novel, less uniform ones, alongside a selection-relaxed control. A causal role for conditions would be supported if environmental novelty raised heritable variance when selection and hybridization were matched; no increase, or an increase explained by relaxed selection alone, would count against the stated cause." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Relaxed selection, hybridization, and larger census sizes are confounded with the change in conditions under domestication.", "Public trait databases mostly store species means, not variances from common-garden designs.", "The relevant experiments exist as scattered supplements and cover few domesticated species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-02--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch01-02 by Grok 4.7: 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.48"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch01-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-02--grok--operationalizability> .
