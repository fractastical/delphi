sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch03-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-04--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch03-04: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.498"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "The contrast between predator and food effects is operationally clear and has been meta-analysed in the literature, but the public experimental tables are incomplete. Nutrient-addition data are the strongest open piece and address only the food side, mostly for plants. A frequency judgment of 'very often' across animal populations would require compiling a biased, study-level sample." ;
    rdfs:comment "Proposed test with existing data: Compare effect sizes of predator removal and of food supplementation on equilibrium density across field experiments. Predation determining average numbers 'very frequently' would be supported if predator treatments changed density more often, or by more, than food treatments, while food still set an upper bound in enrichment studies; the reverse pattern would count against the frequency claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Predator-exclusion results are scattered across papers rather than one open experiment archive.", "Food and predation interact, and short experiments miss the upper food limit.", "Nutrient-network data cover plants, whereas the clearest predation claim is about animals." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-04--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-04--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch03-04 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch03-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-04--grok--operationalizability> .
