    rdfs:label "Candidate dataset: Paleobiology Database" ;
    dct:description "Phanerozoic origination and extinction rates, the best-resolved part of the history." ;
    prov:wasDerivedFrom <https://paleobiodb.org/> .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-2> a delphi:EvidenceItem ;
