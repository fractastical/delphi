sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch14-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch14-08: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.475"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.54"^^xsd:double ;
    dct:description "Rate-through-time methods exist and can be applied to Phanerozoic fossils and to molecular trees, which covers the later part of the history the claim is about. The earliest interval, which carries the strongest wording, is exactly where public data are weakest. Sampling can imitate a slow start, so a low early rate in current compilations would not cleanly confirm the biological claim." ;
    rdfs:comment "Proposed test with existing data: Estimate origination, extinction and morphological rates in successive intervals from the origin of life to the present, and test whether rates are lower in the earlier, taxonomically poorer intervals. The claim is confirmed if early intervals are slower after sampling correction, and refuted if early rates are as high as or higher than later ones once rock availability is controlled." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The first dawn of life, where the claim says change may have been extremely slow, has almost no fossil resolution of biological rates.", "Molecular clocks pushed to the origin of life are dominated by the choice of model and calibration.", "A poor early rock record produces the appearance of slow change even if the biological rate was high." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch14-08 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch14-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok--operationalizability> .
