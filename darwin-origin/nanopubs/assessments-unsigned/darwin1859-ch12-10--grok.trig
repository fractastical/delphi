sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-10--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch12-10: resolvable-now, resolvability 0.79" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.793"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Bat checklists for islands and archipelagos are public and can be joined to isolation distance. Presence on remote islands and the endemism of those bats are both countable, with a pre-set size cutoff to make almost every operational. Undersurvey of the smallest islets limits absence claims and does not block the test for islands large enough to have been searched." ;
    rdfs:comment "Proposed test with existing data: Score bat presence, and the fraction of bat species endemic to the island, across oceanic islands ordered by isolation. Absence of bats from most remote islands, or no rise in endemism with isolation, would count against the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Small islands are poorly surveyed for bats, so absence is weaker evidence than presence.", "Almost every island needs a minimum size, because tiny islets are poor bat habitat.", "Endemism depends on whether island populations are ranked as species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-10--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch12-10 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
