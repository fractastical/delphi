sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-04--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch07-04: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.775"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "The claim's own examples, migratory extent and direction and nest form, are variables in open tracking, occurrence, and nest datasets. A small team can quantify within-species variance with standard summaries in days to weeks. Plasticity means not every measured difference is an instinct in the strict sense, but the variation Darwin pointed to is directly observable and adequate for the bird-centered scope." ;
    rdfs:comment "Proposed test with existing data: Estimate within-species variance in migratory distance, direction, and propensity, and geographic variance in nest structure. Substantial variation, including populations that do not migrate, confirms the claim for the stated examples; invariant migration and invariant nest form across well-sampled species would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Tracked variation mixes innate differences with plasticity and condition.", "Coverage is strong for birds, the named examples, and weaker for other wild animals." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-04--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-04--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch07-04 by Grok 4.7: 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
