sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-04--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch02-04: partially-resolvable, resolvability 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.676"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Public barcodes, sequences, and rank catalogues already support a distance-continuum test that many groups have effectively received. Adequacy is high for animal species boundaries and weaker for plants and for the fine end of individual differences, which is part of the stated series. The analysis is standard, and the main limit is that a gap at one rank in one kingdom would refute the fully universal reading without settling every taxon." ;
    rdfs:comment "Proposed test with existing data: Build distributions of genetic and phenotypic distance for pairs ranked as individual variants, varieties, subspecies, and species. A single overlapping continuum would support the absence of a clear line; a repeatable gap between adjacent ranks, stable across groups, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Barcode libraries sample species much more densely than the variety-to-individual end of the series.", "A gap in animals can coexist with overlap in plants, so the universal wording can fail in one kingdom and hold in another.", "Rank labels are partly conventional, so the test recycles taxonomic practice unless distances are computed first and ranks applied after." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-04--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-04--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch02-04 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
