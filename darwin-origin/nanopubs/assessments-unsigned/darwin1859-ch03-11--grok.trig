  <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-11--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Nutrient Network" ;
    dct:description "plant community responses that can separate conspecific density from neighborhood diversity" ;
    prov:wasDerivedFrom <https://nutnet.org/> .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-11--grok--dataset-2> a delphi:EvidenceItem ;
