sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch03-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-11--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch03-11: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.557"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Intraspecific versus interspecific effect size is a standard and discriminating contrast, and plant-community datasets plus demographic models cover a real subset. The cleanest coefficients are still scattered, so a global 'almost always' ranking would mean harmonizing studies for weeks to months. Animals and domesticated varieties are the thin part of the scope." ;
    rdfs:comment "Proposed test with existing data: Compare the strength of intraspecific competition with interspecific competition, using per-capita effects from removal experiments, frequency dependence, or fitted competition coefficients. A general ranking of intraspecific effects as stronger, including among varieties, would support the statement; interspecific effects as strong or stronger in most pairs would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Direct competition coefficients are compiled in papers more than in one open database.", "Co-occurrence is a poor proxy for the severity of a struggle.", "Varieties of domesticated organisms, included in the scope, are rarely in the same competition datasets as wild species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-11--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-11--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch03-11 by Grok 4.7: 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.76"^^xsd:double ;
