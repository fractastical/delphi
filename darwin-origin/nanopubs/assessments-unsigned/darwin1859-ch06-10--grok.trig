sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch06-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-10--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch06-10: resolvable-now, resolvability 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.75"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "The claim is existential: similar organs have sometimes been built independently. Electric fishes are the stated example, and public genomes, expression studies, and trees already contain the variables needed to separate convergence from homology. A small team can rerun that test in weeks. Other named cases are thinner, but they are not required to confirm or refute the 'sometimes' statement." ;
    rdfs:comment "Proposed test with existing data: Map electric organs, and the tissues and genes that build them, onto a molecular fish tree. Independent origins from non-homologous muscle or nerve pathways confirm that similar organs need not be inherited from a common ancestor; a single origin with shared developmental identity would refute that reading for this case." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Repeated origins show convergence more cleanly than they show that selection, rather than constraint, produced the similarity.", "Luminous insects and the orchid–Asclepias cases are less completely sequenced than electric fishes." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch06-10 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
