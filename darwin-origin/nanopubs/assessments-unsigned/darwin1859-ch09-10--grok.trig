sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch09-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-10--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch09-10: partially-resolvable, resolvability 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.453"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Occurrence records and species names are public, but morphological intermediacy is not a field in those databases and has to be assembled from clade-by-clade studies. The scarcity half is elastic, and the naming half is entangled with how palaeontologists already define species. Existing data can examine a few well-studied formations, which is a restricted slice of the stated scope." ;
    rdfs:comment "Proposed test with existing data: Within well-sampled formations, count morphologically intermediate specimens between successive allied species and record whether close forms from different levels are given separate species names. A large roster of named intermediates inside single formations would undermine the scarcity expectation." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A few has no numeric cutoff, so only an extreme abundance of intermediates would count against the expectation.", "Ranking close morphs as species is a taxonomic decision, so the second clause partly describes practice rather than an independent biological fact.", "Single formations rarely preserve continuous populations finely enough to see transitional series." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-10--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch09-10 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch09-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-10--grok--operationalizability> .
