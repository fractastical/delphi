sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch05-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-09--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch05-09: partially-resolvable, resolvability 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.361"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Developmental correlation and a near-zero selection gradient would favour a byproduct reading for a particular character, and fragments of those data exist. The wording only asserts that such characters may arise, so counterexamples do not refute it, and proving uselessness is biased toward the claim. Existing datasets support case studies, not a general decision." ;
    rdfs:comment "Proposed test with existing data: For characters given high taxonomic weight, estimate their developmental correlation with other traits and the selection gradient on the character itself. A strong correlation together with a gradient indistinguishable from zero would support the possibility that the character is a useless byproduct; a consistently positive gradient would show that those particular characters are retained by selection, without closing a claim phrased as a possibility." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A possibility claim is confirmed by one solid case and is barely refutable.", "Failure to find a function is weak evidence that a character is useless.", "Selection gradients on fine taxonomic characters are rarely measured." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch05-09 by Grok 4.7: 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.36"^^xsd:double ;
