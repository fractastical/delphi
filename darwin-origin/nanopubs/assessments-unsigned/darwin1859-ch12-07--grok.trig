sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch12-07: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.585"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Island woodiness relative to mainland relatives is recoverable from trait databases and floras for many clades. Separating colonization by woody lineages from change after arrival needs a tree and is only partly assembled. The adaptive story about stature under selection is an interpretation of that pattern, so the data resolve the comparative prediction more than the mechanism." ;
    rdfs:comment "Proposed test with existing data: Compare growth form of island endemics with their closest mainland relatives and ask whether shifts from herb to shrub or tree are concentrated on oceanic islands that lacked tree colonists in that clade. Woodiness that arrived already evolved on the mainland would fail the in-situ selection scenario." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Ancestral growth form and sister-species pairs are not stored as one global analysis table.", "Woody colonists establishing more easily than herbs imitates evolution of woodiness after arrival.", "The selection mechanism is stronger than the woodiness pattern alone." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch12-07 by Grok 4.7: 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.65"^^xsd:double ;
