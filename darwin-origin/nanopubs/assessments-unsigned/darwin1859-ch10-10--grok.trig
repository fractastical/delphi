sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-10--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch10-10: partially-resolvable, resolvability 0.69" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.685"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Origination, extinction, and standing diversity are the right variables and are already compiled. The scientific disagreement that remains is largely about sampling and rock volume, which means the same public data do not yet yield one decisive balance test. A restricted marine, genus-level version of the question is analyzable now." ;
    rdfs:comment "Proposed test with existing data: Compare sampling-standardized origination and extinction counts, and the trend in standing diversity, through the Cenozoic and other later Phanerozoic intervals. Matched gains and losses with flat diversity would support a balance; a sustained rise in diversity would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Different standardizations still disagree about whether later diversity is flat or rising.", "Later geological periods is an elastic interval, and global species richness is not observed directly." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-10--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch10-10 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
