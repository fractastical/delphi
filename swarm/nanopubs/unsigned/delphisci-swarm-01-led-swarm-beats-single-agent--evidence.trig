sub:assertion {
  <https://w3id.org/delphi/resource/evidence/delphisci-swarm-01-led-swarm-beats-single-agent> a delphi:EvidenceItem ;
    rdfs:label "Verified-dataset counts, fabricated-identifier counts and costs of the four arms in two pre-registered experiments (centralized 19 and 18 vs single 13 and 12 of 20)." ;
    dct:description "Computed by swarm/compare/metrics.mjs from the run records swarm/compare/runs/single-2026-10-31T06-05-08, swarm/compare/runs/isolated-2026-10-31T05-57-46, swarm/compare/runs/centralized-2026-10-31T05-59-47, swarm/compare/runs/decentralized-2026-10-31T06-02-31 (experiment 1) and swarm/compare/runs/exp2-single-2026-10-31T06-36-43, swarm/compare/runs/exp2-isolated-2026-10-31T06-28-12, swarm/compare/runs/exp2-centralized-2026-10-31T06-30-22, swarm/compare/runs/exp2-decentralized-2026-10-31T06-33-59 (experiment 2), each holding log.jsonl, plans/, verify/ and summary.json; aggregated in swarm/compare/results.json and results2.json (built 2026-10-31T06:28:47.664Z and 2026-10-31T06:38:50.908Z). Every URL and DOI in every plan was fetched by swarm/compare/verify.mjs with the responses cached in verify-cache.json. Verified datasets of 20, primary runs: experiment 1 single 13, isolated 17, centralized 19, decentralized 18 (1 fabricated identifier); experiment 2 single 12, isolated 16, centralized 18, decentralized 17. Fabricated identifiers in the centralized and single arms: 0 in both experiments. Experiment 1 replicates (one per arm): single 15, isolated 15, centralized 19, decentralized 18, all with 0 fabricated identifiers. The centralized arm met the pre-registered rule against the single agent in both experiments (margin 6 and 6, rule needs 2) and against the isolated workers in both. Cost at list price, centralized vs single: $2.98 vs $0.57 (experiment 1), $5.61 vs $0.52 (experiment 2). Wall time per arm 1.8 to 3.7 minutes. Prediction for experiment 2 (written before the run): centralized 18, decentralized 17, isolated 15, single 14; outcome 18, 17, 16, 12. Pre-registration timing, stated here because the header of swarm/PREREG.md is wrong: the header says \"Written 2026-10-31 06:25 UTC\", which would be after the experiment-1 runs. The session transcript shows the file written at 2026-10-31T05:52:04Z, before the first primary run started at 2026-10-31T05:57:46.622Z; the experiment-2 section was appended at 2026-10-31T06:27:23Z, before the first experiment-2 run at 2026-10-31T06:28:12.756Z. The file was not edited because it states it is never changed after runs start; the correction is in DEVIATIONS.md and here. No git commit of the file exists yet (the hub holds all commits for this branch); the commit hash is to be added to this record before signing." ;
    delphi:statisticalTest "Pre-registered decision rule, not an inferential test: arm A beats arm B if A has zero fabricated identifiers and at least two more verified datasets out of 20; the earliest full run per arm is primary. Counts are exact over the 20 claims; no p-value is defined." ;
    dct:hasPart sub:q01 , sub:q02 , sub:q03 , sub:q04 , sub:q05 , sub:q06 , sub:q07 , sub:q08 , sub:q09 , sub:q10 , sub:q11 , sub:q12 , sub:q13 , sub:q14 , sub:q15 , sub:q16 , sub:q17 , sub:q18 , sub:q19 , sub:q20 , sub:q21 , sub:q22 , sub:q23 , sub:q24 , sub:q25 , sub:q26 , sub:q27 , sub:q28 ;
    prov:wasDerivedFrom <https://delphibio.org/t/swarm/results.json> , <https://delphibio.org/t/swarm/results2.json> , <https://delphibio.org/t/swarm/runs/single/summary.json> , <https://delphibio.org/t/swarm/runs/isolated/summary.json> , <https://delphibio.org/t/swarm/runs/centralized/summary.json> , <https://delphibio.org/t/swarm/runs/decentralized/summary.json> , <https://delphibio.org/t/swarm/runs2/single/summary.json> , <https://delphibio.org/t/swarm/runs2/isolated/summary.json> , <https://delphibio.org/t/swarm/runs2/centralized/summary.json> , <https://delphibio.org/t/swarm/runs2/decentralized/summary.json> , <https://delphibio.org/t/swarm/PREREG.md> , <https://delphibio.org/t/swarm/DEVIATIONS.md> .
  sub:q01 a schema:QuantitativeValue ;
    schema:name "verified datasets of 20, single agent, experiment 1 primary run (swarm/compare/runs/single-2026-10-31T06-05-08)" ;
    schema:value "13"^^xsd:integer ;
