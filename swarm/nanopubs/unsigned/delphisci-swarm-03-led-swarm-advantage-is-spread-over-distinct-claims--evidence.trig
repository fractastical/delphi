}

sub:assertion {
  <https://w3id.org/delphi/resource/evidence/delphisci-swarm-03-led-swarm-advantage-is-spread-over-distinct-claims> a delphi:EvidenceItem ;
    rdfs:label "Per-claim wins of the centralized swarm over the single agent: 6 vs 0 distinct claims in experiment 1, 7 vs 1 in experiment 2." ;
    dct:description "Computed from the per_claim tables (field verified, keyed by claim_id) of swarm/compare/results.json and results2.json for the centralized and single primary runs. Per-claim comparison of the centralized and single arms' primary runs. Experiment 1: verified by centralized and not by single, 6 claims [darwin1859-ch12-08, darwin1859-ch12-09, darwin1859-ch12-04, darwin1859-ch12-10, thompson1917-ch15-01, thompson1917-ch14-02]; verified by single and not by centralized, 0. Experiment 2: 7 claims [darwin1859-ch05-06, darwin1859-ch04-22, darwin1859-ch11-01, darwin1859-ch14-03, thompson1917-ch07-04, thompson1917-ch17-06, thompson1917-ch13-02] against 1 [thompson1917-ch14-06]. The two experiments use disjoint claim sets, so the items differ by construction; the point is that in each experiment the margin comes from many claims. Pre-registration timing, stated here because the header of swarm/PREREG.md is wrong: the header says \"Written 2026-10-31 06:25 UTC\", which would be after the experiment-1 runs. The session transcript shows the file written at 2026-10-31T05:52:04Z, before the first primary run started at 2026-10-31T05:57:46.622Z; the experiment-2 section was appended at 2026-10-31T06:27:23Z, before the first experiment-2 run at 2026-10-31T06:28:12.756Z. The file was not edited because it states it is never changed after runs start; the correction is in DEVIATIONS.md and here. No git commit of the file exists yet (the hub holds all commits for this branch); the commit hash is to be added to this record before signing." ;
    delphi:statisticalTest "Exact per-claim set differences over 20 claims; no inferential test. Post-hoc breakdown of pre-registered runs." ;
    dct:hasPart sub:q41 , sub:q42 , sub:q43 , sub:q44 ;
    prov:wasDerivedFrom <https://delphibio.org/t/swarm/results.json> , <https://delphibio.org/t/swarm/results2.json> , <https://delphibio.org/t/swarm/runs/single/summary.json> , <https://delphibio.org/t/swarm/runs/centralized/summary.json> , <https://delphibio.org/t/swarm/runs2/single/summary.json> , <https://delphibio.org/t/swarm/runs2/centralized/summary.json> , <https://delphibio.org/t/swarm/PREREG.md> , <https://delphibio.org/t/swarm/DEVIATIONS.md> .
  sub:q41 a schema:QuantitativeValue ;
    schema:name "experiment 1: claims verified by the centralized swarm and not by the single agent (primary runs swarm/compare/runs/centralized-2026-10-31T05-59-47 vs swarm/compare/runs/single-2026-10-31T06-05-08)" ;
    schema:value "6"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/results.json> .
  sub:q42 a schema:QuantitativeValue ;
    schema:name "experiment 1: claims verified by the single agent and not by the centralized swarm" ;
    schema:value "0"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/results.json> .
  sub:q43 a schema:QuantitativeValue ;
    schema:name "experiment 2: claims verified by the centralized swarm and not by the single agent (primary runs swarm/compare/runs/exp2-centralized-2026-10-31T06-30-22 vs swarm/compare/runs/exp2-single-2026-10-31T06-36-43)" ;
    schema:value "7"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/results2.json> .
  sub:q44 a schema:QuantitativeValue ;
    schema:name "experiment 2: claims verified by the single agent and not by the centralized swarm" ;
    schema:value "1"^^xsd:integer ;
    schema:unitText "claims" ;
    dct:source <https://delphibio.org/t/swarm/results2.json> .
}

