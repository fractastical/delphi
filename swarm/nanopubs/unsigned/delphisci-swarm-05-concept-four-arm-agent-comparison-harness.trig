}

sub:assertion {
  <https://w3id.org/delphi/resource/concept/four-arm-agent-comparison-harness> a delphi:Concept , skos:Concept ;
    skos:prefLabel "Four-arm comparison harness for agent swarms: pre-registered task, mechanical verifier, hard cost cap" ;
    rdfs:label "Four-arm comparison harness for agent swarms: pre-registered task, mechanical verifier, hard cost cap" ;
    skos:definition "A method for measuring whether a swarm of language-model agents beats one agent on a unit of scientific work, built so that the result cannot be argued with afterwards. (1) Fix the task, the item set (here 20 claims), the output schema and the prompt, and write the scoring rule and a prediction into a pre-registration file before any run. (2) Run four arms with the same model, tools and budget: single agent (one call, all items); isolated workers (one item each, no feedback); centralized swarm (a planner assigns items by domain, reviews failures, retries with verifier feedback, escalates); decentralized board (workers pull tickets from a shared board and post results, gaps and tips; no planner). (3) Score every output with a mechanical verifier that fetches each URL and DOI and classes it resolves / fabricated (404, 410, DNS failure, DOI not found) / blocked (403, 429, 5xx, timeout) / malformed, and marks a dataset verified only if its landing page resolves and names it; in a second experiment also require evidence in the agent's own event log that it fetched the page, and that the page title it reports agrees with the verifier's. (4) Enforce a hard cost cap by launching a call only if spent + (in-flight + 1) * per-call cap <= budget, so no arm can overshoot. (5) Decide by a pre-registered rule (here: zero fabricated identifiers and at least two more verified items), take the earliest full run per arm as primary, report replicates beside it, and publish every plan, verifier record and event log with a per-item table. (6) Log every change after the pre-registration, and every wrong prediction, in a deviations file with a time." ;
    dct:description "Implemented for the ScienceClaw hack (2026-10-31) as Node scripts: swarm/compare/run.mjs (orchestrator and the four arms, spawning the headless Claude Code CLI with --json-schema, --max-budget-usd and stream-json output from an empty directory so agents cannot read the repository), swarm/compare/verify.mjs (verifier, cached), swarm/compare/metrics.mjs (aggregation into results.json and per-queen metrics), swarm/emperor.mjs (structure controller that consumes the measured metrics). Used twice on 2026-10-31; outcomes in records delphisci-swarm-01 to 03. A sister project (delphi-evolve) applied the same four-arm design to an enzyme benchmark with deterministic specialists." ;
    skos:note "Kind: method (a reusable procedure), not an empirical finding. Its results are separate claim records (delphisci-swarm-01 to 03)." ;
    skos:scopeNote "Limits. The runner is specific to the Claude Code CLI; the arms and verifier are general. The verifier checks that an identifier resolves and names the dataset, not that the dataset answers the question. Twenty items per experiment give a pre-registered minimum difference, not a significance test. Cost accounting is at list price from the CLI's usage report. The code is uncommitted at the time of this draft; the repository URL below is where it will live and the live copies are what this record points to." ;
    dct:subject sub:code1 , sub:code2 , sub:code3 , sub:code4 ;
    skos:related <https://w3id.org/delphi/resource/claim/delphisci-swarm-01-led-swarm-beats-single-agent> , <https://w3id.org/delphi/resource/claim/delphisci-swarm-02-single-agent-shortfall-is-mostly-blank-plans> , <https://w3id.org/delphi/resource/claim/delphisci-swarm-03-led-swarm-advantage-is-spread-over-distinct-claims> .
  sub:code1 a schema:SoftwareSourceCode ;
    rdfs:label "swarm/compare/run.mjs" ;
    dct:description "orchestrator and the four arms" ;
    schema:codeRepository <https://github.com/fractastical/delphisci> ;
    schema:programmingLanguage "JavaScript (Node 20+)" ;
    schema:version "uncommitted draft, 2026-10-31; commit hash pending" ;
    dct:source <https://delphi-mission-control.ashenoy000.workers.dev/t/swarm/code/run.mjs> .
  sub:code2 a schema:SoftwareSourceCode ;
    rdfs:label "swarm/compare/verify.mjs" ;
    dct:description "mechanical verifier for URLs and DOIs" ;
    schema:codeRepository <https://github.com/fractastical/delphisci> ;
    schema:programmingLanguage "JavaScript (Node 20+)" ;
    schema:version "uncommitted draft, 2026-10-31; commit hash pending" ;
    dct:source <https://delphi-mission-control.ashenoy000.workers.dev/t/swarm/code/verify.mjs> .
  sub:code3 a schema:SoftwareSourceCode ;
    rdfs:label "swarm/compare/metrics.mjs" ;
    dct:description "aggregation and per-queen metrics" ;
    schema:codeRepository <https://github.com/fractastical/delphisci> ;
    schema:programmingLanguage "JavaScript (Node 20+)" ;
    schema:version "uncommitted draft, 2026-10-31; commit hash pending" ;
    dct:source <https://delphi-mission-control.ashenoy000.workers.dev/t/swarm/code/metrics.mjs> .
  sub:code4 a schema:SoftwareSourceCode ;
    rdfs:label "swarm/emperor.mjs" ;
    dct:description "swarm structure controller" ;
    schema:codeRepository <https://github.com/fractastical/delphisci> ;
    schema:programmingLanguage "JavaScript (Node 20+)" ;
    schema:version "uncommitted draft, 2026-10-31; commit hash pending" ;
    dct:source <https://delphi-mission-control.ashenoy000.workers.dev/t/swarm/code/emperor.mjs> .
}

