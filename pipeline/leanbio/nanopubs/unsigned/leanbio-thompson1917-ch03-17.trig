@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/leanbio/statement/thompson1917-ch03-17> a schema:Claim ;
    rdfs:label "In plaice the weight-length coefficient k = W/L^3 is not constant but rises to a maximum and then slowly declines with increasing size, the maximum falling near 30 cm, about the size at which sexual maturity begins." ;
    schema:isBasedOn <https://w3id.org/delphi/resource/claim/thompson1917-ch03-17> ;
    schema:about <http://purl.obolibrary.org/obo/NCBITaxon_8262> ;
    schema:additionalProperty sub:relation, sub:belief, sub:subject ;
    rdfs:comment "Grounded with Gilda (grounding.indra.bio) and, for identifiers Gilda does not index, MyGene.info, OLS4 and the repo taxon inventory; acceptance rule in pipeline/leanbio/README.md. No ambiguous grounding." .
  <http://purl.obolibrary.org/obo/NCBITaxon_8262> rdfs:label "Pleuronectes platessa" ; dct:identifier "NCBITaxon:8262" .
  sub:relation a schema:PropertyValue ; schema:propertyID "relation_type" ; schema:value "Bound" ; schema:description "INDRA-style statement type from the fixed vocabulary leanbio-relations/0.1.0 (pipeline/leanbio/relations.json); rule that fired: Bound: /\\b(cannot exceed|at most|at least|upper limit|lower limit|upper bound|lower bound|bounded|maximum|minimum|limit(s|ed)? (to|on)|never (exceed|fall)|no more than|no less than|threshold|budget)\\b/. A heuristic typing, not a curated statement." .
  sub:subject a schema:PropertyValue ; schema:propertyID "relation_subject" ; schema:value <http://purl.obolibrary.org/obo/NCBITaxon_8262> ; schema:description "Subject of the typed statement (mention \"plaice\")." .
  sub:belief a schema:PropertyValue ; schema:propertyID "leanbio_belief" ; schema:value "0.548"^^xsd:decimal ; schema:description "Computed score, not a probability: belief = E * (1 - R) with E = 0.548, R = 0 under leanbio-belief/0.1.0 (pipeline/leanbio/belief-params.json), from independent evidence counts {\"support\":{\"model-elicitation\":2},\"contradict\":{}}. The parameters are hand-set and not calibrated; the score orders the formalization queue." .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-leanbio-pipeline> ;
    prov:wasDerivedFrom <https://w3id.org/delphi/resource/claim/thompson1917-ch03-17>, <https://github.com/fractastical/delphisci/blob/25db00346f3da02b908595a4bb875ce17b599cb5/pipeline/leanbio/run.mjs> .
  <https://github.com/fractastical/delphisci/blob/25db00346f3da02b908595a4bb875ce17b599cb5/pipeline/leanbio/run.mjs> rdfs:comment "The LeanBio pipeline runner. This commit is local to the hackathon tree and the pipeline files may not be in it yet; the URL resolves after the pipeline is committed and pushed." .
  <https://w3id.org/delphi/resource/agent/delphisci-leanbio-pipeline> a prov:SoftwareAgent ; rdfs:label "delphisci LeanBio pipeline (pipeline/leanbio)" .
}

sub:pubinfo {
  this: dct:created "2026-11-01T04:07:22Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/delphisci-leanbio-pipeline> ;
    rdfs:label "LeanBio grounding, statement type and belief for thompson1917-ch03-17" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType schema:Claim ;
    npx:introduces <https://w3id.org/delphi/resource/leanbio/statement/thompson1917-ch03-17> ;
    rdfs:comment "UNSIGNED DRAFT generated by pipeline/leanbio/draft.mjs: not signed, not published to any registry. Intended for the nanopub TEST registry first; production publication needs the ORCID key owner's explicit approval. No human owner is named in this draft: dct:creator is the software agent. No assertion or provenance template is declared (none exists for LeanBio statements yet)." .
}
