@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/leanbio/statement/thompson1917-ch17-06> a schema:Claim ;
    rdfs:label "The cannon-bones of the ox, sheep and giraffe differ essentially only in relative length and breadth: at equal length, the sheep's bone is about two-thirds and the giraffe's about one-third as broad as the ox's." ;
    schema:isBasedOn <https://w3id.org/delphi/resource/claim/thompson1917-ch17-06> ;
    schema:about <http://purl.obolibrary.org/obo/NCBITaxon_9913>, <https://bioregistry.io/mesh:D012756>, <http://purl.obolibrary.org/obo/NCBITaxon_9894> ;
    schema:additionalProperty sub:relation, sub:belief, sub:subject, sub:object ;
    rdfs:comment "Grounded with Gilda (grounding.indra.bio) and, for identifiers Gilda does not index, MyGene.info, OLS4 and the repo taxon inventory; acceptance rule in pipeline/leanbio/README.md. No ambiguous grounding." .
  <http://purl.obolibrary.org/obo/NCBITaxon_9913> rdfs:label "Bos taurus" ; dct:identifier "NCBITaxon:9913" .
  <https://bioregistry.io/mesh:D012756> rdfs:label "Sheep" ; dct:identifier "MESH:D012756" .
  <http://purl.obolibrary.org/obo/NCBITaxon_9894> rdfs:label "Giraffa camelopardalis" ; dct:identifier "NCBITaxon:9894" .
  sub:relation a schema:PropertyValue ; schema:propertyID "relation_type" ; schema:value "Equality" ; schema:description "INDRA-style statement type from the fixed vocabulary leanbio-relations/0.1.0 (pipeline/leanbio/relations.json); rule that fired: Equality: /\\b(equals?|is equal to|equal to|conserved|conservation|remains? constant|is constant|invariant|1:1|one-to-one)\\b/. A heuristic typing, not a curated statement." .
  sub:subject a schema:PropertyValue ; schema:propertyID "relation_subject" ; schema:value <http://purl.obolibrary.org/obo/NCBITaxon_9894> ; schema:description "Subject of the typed statement (mention \"giraffe\")." .
  sub:object a schema:PropertyValue ; schema:propertyID "relation_object" ; schema:value <https://bioregistry.io/mesh:D012756> ; schema:description "Object of the typed statement (mention \"sheep\")." .
  sub:belief a schema:PropertyValue ; schema:propertyID "leanbio_belief" ; schema:value "0.548"^^xsd:decimal ; schema:description "Computed score, not a probability: belief = E * (1 - R) with E = 0.548, R = 0 under leanbio-belief/0.1.0 (pipeline/leanbio/belief-params.json), from independent evidence counts {\"support\":{\"model-elicitation\":2},\"contradict\":{}}. The parameters are hand-set and not calibrated; the score orders the formalization queue." .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-leanbio-pipeline> ;
    prov:wasDerivedFrom <https://w3id.org/delphi/resource/claim/thompson1917-ch17-06>, <https://github.com/fractastical/delphisci/blob/25db00346f3da02b908595a4bb875ce17b599cb5/pipeline/leanbio/run.mjs> .
  <https://github.com/fractastical/delphisci/blob/25db00346f3da02b908595a4bb875ce17b599cb5/pipeline/leanbio/run.mjs> rdfs:comment "The LeanBio pipeline runner. This commit is local to the hackathon tree and the pipeline files may not be in it yet; the URL resolves after the pipeline is committed and pushed." .
  <https://w3id.org/delphi/resource/agent/delphisci-leanbio-pipeline> a prov:SoftwareAgent ; rdfs:label "delphisci LeanBio pipeline (pipeline/leanbio)" .
}

sub:pubinfo {
  this: dct:created "2026-11-01T04:07:22Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/delphisci-leanbio-pipeline> ;
    rdfs:label "LeanBio grounding, statement type and belief for thompson1917-ch17-06" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType schema:Claim ;
    npx:introduces <https://w3id.org/delphi/resource/leanbio/statement/thompson1917-ch17-06> ;
    rdfs:comment "UNSIGNED DRAFT generated by pipeline/leanbio/draft.mjs: not signed, not published to any registry. Intended for the nanopub TEST registry first; production publication needs the ORCID key owner's explicit approval. No human owner is named in this draft: dct:creator is the software agent. No assertion or provenance template is declared (none exists for LeanBio statements yet)." .
}
