sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/dataset/wikimedia-commons-aloe-leaf-epidermis> a dcat:Dataset ;
    rdfs:label "Wikimedia Commons image: Aloe vera Cells, 150X.jpg (Aloe vera, lower leaf epidermis)" ;
    dct:identifier "File:Aloe vera Cells, 150X.jpg" ;
    dct:bibliographicCitation "ConformationXII (Wikimedia Commons user). Aloe vera Cells, 150X.jpg. Wikimedia Commons, CC BY-SA 4.0. https://commons.wikimedia.org/wiki/File:Aloe_vera_Cells,_150X.jpg" ;
    dct:description "The image is a photomicrograph (PMG) of the lower epidermis of Aloe vera, viewed under brightfield illumination at 150X magnification. In an attempt to find alternative stains which are less toxic than conventional ones, Lamy fountain pen ink was used. Nuclei are stained blue, and the guard cells of a stomata are clearly visible (dark green/brown). The image was taken using an Olympus OIC student " ;
    dct:creator "ConformationXII (Wikimedia Commons user)" ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcat:landingPage <https://commons.wikimedia.org/wiki/File:Aloe_vera_Cells,_150X.jpg> ;
    dcat:version "Commons rendition retrieved 2026-10-31T03:43:33Z" ;
    schema:measurementTechnique "brightfield light microscopy of the lower leaf epidermis, 150x, fountain-pen-ink stain" ;
    schema:about "Aloe vera (Plantae), lower leaf epidermis" ;
    dcat:distribution sub:file ;
    schema:additionalProperty sub:count0 ;
    schema:additionalProperty sub:count1 ;
    schema:additionalProperty sub:count2 .
  sub:file a dcat:Distribution ;
    dcat:downloadURL <https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Aloe_vera_Cells%2C_150X.jpg/1920px-Aloe_vera_Cells%2C_150X.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail> ;
    dcat:byteSize "421093"^^xsd:integer ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/image/jpeg> ;
    spdx:checksum sub:fileChecksum .
  sub:fileChecksum spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "431fcd7480aa2c80e5014e2705fd8036ef24a4b0ff9d8decb39e9b0e432789ba" .
  sub:count0 a schema:PropertyValue ;
    schema:propertyID "n_images" ;
    schema:value "1"^^xsd:integer ;
    schema:description "image files in this dataset" .
  sub:count1 a schema:PropertyValue ;
    schema:propertyID "width_px" ;
    schema:value "1920"^^xsd:integer ;
    schema:unitText "px" ;
    schema:description "width in pixels of the downloaded file" .
  sub:count2 a schema:PropertyValue ;
    schema:propertyID "height_px" ;
    schema:value "1440"^^xsd:integer ;
    schema:unitText "px" ;
    schema:description "height in pixels of the downloaded file" .
}

