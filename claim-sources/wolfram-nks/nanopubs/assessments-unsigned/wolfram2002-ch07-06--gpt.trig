sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch07-06: resolvable-now, resolvability 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.82"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.88"^^xsd:double ;
    dct:description "Modern ephemerides and numerical integrators directly test million-year sensitivity and provide adequate initial-state constraints. The explanatory link to particular current features is less decisive, but the central prediction is resolvable." ;
    rdfs:comment "Proposed test with existing data: Integrate ensembles of high-precision Solar System initial conditions drawn from observational covariance, estimate Lyapunov times and divergence over millions of years, and compare resulting orbital distributions with present dynamical features. Lack of exponential divergence would refute the sensitive-dependence component." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Long integrations require specialist numerical controls.", "Chaos does not by itself identify the origin of present-day features.", "Rare close encounters amplify model uncertainty." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-06--gpt--dataset-2> .
