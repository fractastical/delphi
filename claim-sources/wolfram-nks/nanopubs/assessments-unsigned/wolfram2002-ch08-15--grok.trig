sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-15--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-15: partially-resolvable, resolvability 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.383"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "Modularity and the smoothness of quantitative traits can be measured in model organisms, which gives a partial test. The main effect of selection is a global causal claim, and public datasets do not separate selection's effect from developmental constraints that produce simple parts for other reasons. Discriminating power stays low." ;
    rdfs:comment "Proposed test with existing data: Measure modularity, independence of parts, and smoothness of trait variation for characters ranked by evidence of selection. A positive association between selection and those engineering-like properties would support the claim; complex, tightly coupled traits under strong selection would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Like systems in engineering is a metaphor until modularity and smooth adjustability are defined.", "Selection is often inferred from the same simplicity the claim treats as its effect." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-15--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-15 by Grok 4.7: 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.38"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-15--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-15--grok--operationalizability> .
