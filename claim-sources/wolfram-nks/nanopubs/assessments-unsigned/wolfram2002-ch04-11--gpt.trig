  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch04-11: partially-resolvable, resolvability 0.87" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.87"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.94"^^xsd:double ;
    dct:description "Enormous digit samples and standard statistical tools are publicly available, making practical finite-scale regularity highly testable. The universal absence of significant regularity and all-base wording remain beyond finite evidence." ;
    rdfs:comment "Proposed test with existing data: Apply preregistered frequency, run, correlation, spectral, and compression tests to very large published or reproducibly computed digit blocks of pi in several bases. Any significant stable regularity refutes the practical claim under those tests; failure to detect one supports but cannot prove complete randomness." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Normality of pi is unproved.", "No finite test establishes complete randomness or absence of every significant regularity." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--gpt--dataset-2> .
