sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-44> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-44--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-44--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-44: resolvable-now, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.738"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Propositional entailment is decidable, so the filter that keeps theorems not implied by simpler ones is an ordinary computation, and the named laws are a small explicit list. Open textbooks supply those names. Corpus choice is a limited confound and can be fixed in advance, so the comparison can be run now and can confirm or refute the reported match." ;
    rdfs:comment "Proposed test with existing data: Generate propositional tautologies in order of increasing expression size and mark those not entailed by the conjunction of earlier ones. Compare that set with the named Boolean laws in a fixed collection of logic textbooks. A close match confirms the claim; a large symmetric difference refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A different corpus of textbooks could name a different subset.", "The second distributive law is derivable from earlier theorems and is still traditionally named, so almost exactly needs a stated tolerance." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-44--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-44--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-44 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
