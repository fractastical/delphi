sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-16: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.673"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The search Wolfram describes is a finite enumeration that public compilers can repeat, and a handful of complex-looking outputs would support the claim as an existence result. 'Complex and seemingly random' and 'typically' across practical languages still need a chosen battery of tests and a chosen notion of program length, so the replication tests a proxy for the full wording. A small team can run that proxy in weeks, but the result would not cleanly cover every low-level language." ;
    rdfs:comment "Proposed test with existing data: Enumerate millions of short programs in one or two low-level languages, run each for a fixed number of steps, and apply compression and statistical randomness tests to the output. Finding a few outputs that pass those tests confirms the existential part; finding none in a large bounded search would challenge 'typically.'" ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "What counts as a short program depends on the language's syntax, so the same behavior can look rare or common under a different encoding.", "Statistical tests can fail to detect hidden regularity, and they do not prove that an output is random." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-16--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-16--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-16--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-16 by Grok 4.7: 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.65"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch03-16 by Grok 4.7: 0.8" ;
