    delphi:assessmentType "dataset-resolvability/0.2.0/data-existence" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of wolfram2002-ch03-16 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/data-adequacy" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
