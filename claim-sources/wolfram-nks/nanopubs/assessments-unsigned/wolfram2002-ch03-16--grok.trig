  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-16--grok--analysis-feasibility> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-16--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: GCC" ;
    dct:description "compile and run enumerated short C programs whose outputs are then tested" ;
    prov:wasDerivedFrom <https://gcc.gnu.org/> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-16--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Python" ;
    dct:description "generate short programs and apply randomness and compression tests to their traces" ;
    prov:wasDerivedFrom <https://www.python.org/> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-16--grok--dataset-3> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: NIST Computer Security Resource Center" ;
    dct:description "public statistical test suite for deciding whether a bit string looks random" ;
    prov:wasDerivedFrom <https://csrc.nist.gov/> .
