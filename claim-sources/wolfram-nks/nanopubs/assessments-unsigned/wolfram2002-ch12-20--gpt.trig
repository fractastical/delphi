  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-20--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch12-20: resolvable-now, resolvability 0.88" ;
