    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.879"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.92"^^xsd:double ;
    dct:description "The finite numerical observations are directly reproducible with modest public computation. The stronger interpretation that these trajectories demonstrate undecidability is not established by finite runs, but the stated concrete behavior can be checked now." ;
    rdfs:comment "Proposed test with existing data: Reimplement totalistic rule 1004600, enumerate the specified simple initial conditions, and record extinction time and population through ten million steps. Reproducing both a greater-than-1000-step extinction and continuing growth at ten million confirms the concrete observation; failure under the documented convention refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Finite non-extinction does not itself establish undecidability.", "The exact initial-condition convention must be reconstructed." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-20--gpt--dataset-1> .
