sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-06: resolvable-now, resolvability 0.81" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.814"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "The strict claim is a universal negative over a set of 65,536 explicitly defined machines, which is an easy exhaustive simulation. A single machine with incompressible behavior would refute it. The rarity claim for neighbor-updating rules is a sampling statement and is feasible on the same time scale, with the usual uncertainty of a sample." ;
    rdfs:comment "Proposed test with existing data: Enumerate all 65,536 two-color mobile automata that update only the active cell, and test each for behavior beyond repetition or nesting. One counterexample refutes the universal clause. The extension, that complexity appears and is rare once neighbors are also updated, is a rate estimated by sampling the much larger neighbor-updating family." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Nested versus merely long-period motion needs a compressor, and a weak compressor can mislabel a nested rule as complex.", "The neighbor-updating family has about four billion rules, so its rate is a sample estimate." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-06--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-06 by Grok 4.7: 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.82"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-06--grok--operationalizability> .
