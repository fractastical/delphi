sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-04--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch01-04: partially-resolvable, resolvability 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.361"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Horizons can check the planetary-motion half directly. The claim that equations almost inevitably fail once behavior is complex, and that program descriptions then succeed in a way equations cannot, needs a survey of models whose inclusion criteria are themselves interpretive. Published successes and failures are scattered across papers, so existing resources test a slogan's easy clause and leave the universal clause open." ;
    rdfs:comment "Proposed test with existing data: Treat published predictive success as the variable: closed-form or numerically solved equations should predict simple systems such as planetary motion within observational error, and should lack stable predictive models for a pre-registered list of complex phenomena. The claim is refuted if equations routinely predict complex behavior to a stated accuracy." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Failure of equations is easily confused with the current state of technique.", "What counts as an equation, as opposed to a program or a numerical scheme, is contested.", "There is no census of complex phenomena with a uniform success metric." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-04--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch01-04 by Grok 4.7: 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.42"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-04--grok--operationalizability> .
