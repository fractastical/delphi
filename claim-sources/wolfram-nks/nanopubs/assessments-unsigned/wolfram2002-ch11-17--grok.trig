sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-17--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-17: partially-resolvable, resolvability 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.445"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Universality is settled for rule 110 and for some two-dimensional class-4 rules such as the Game of Life, so particular cases are checkable. The claim is about every class-4 rule, and each new proof is a research project rather than a standard analysis. A single rigorously non-universal class-4 rule would refute it, but no such classification exists for the class as a whole." ;
    rdfs:comment "Proposed test with existing data: Define class 4 by persistent, interacting, localized structures on a quiescent or periodic background. Confirm the claim only if every such rule has a universality proof, and refute it by one class-4 rule proved incapable of emulating a Turing machine." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Class 4 is diagnosed from pictures, so borderline rules can be labeled either way.", "Not finding a glider computer does not prove that a class-4 rule is not universal." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-17--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-17 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
