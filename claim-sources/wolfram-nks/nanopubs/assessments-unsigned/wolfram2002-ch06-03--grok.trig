sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-03--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-03: partially-resolvable, resolvability 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.639"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Named exemplars such as rule 110 have public simulators and, for Life, a public object census, so the phenomenology of simple objects with long collisions can be checked directly. The class label in the sentence is itself assigned by that phenomenology, which limits how far the check can discriminate a rival description. The result is a solid audit of exemplars and a weak test of the class as a class." ;
    rdfs:comment "Proposed test with existing data: For rule 110 and other rules already tagged class 4 by an independent activity criterion, catalogue persistent finite objects and measure collision transients. Simple periodic objects whose collisions have long, input-sensitive transients support the description for those rules." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Localized interacting structures are the visual mark already used to name class 4.", "Fairly simple and very complicated are not numeric.", "Object censuses cover famous rules and miss an open-ended class." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-03 by Grok 4.7: 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.48"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-03--grok--operationalizability> .
