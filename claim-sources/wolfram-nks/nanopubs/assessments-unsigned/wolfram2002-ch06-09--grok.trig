sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-09--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-09: partially-resolvable, resolvability 0.77" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.773"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "A one-cell perturbation has a standard difference pattern, and for all 256 elementary rules the four response types can be measured in days. The sentence says changes always die out in class 1, always stay local in class 2, and so on, for cellular automata of each class, which is wider than the elementary family. The test is clean on that family and partial as a universal claim." ;
    rdfs:comment "Proposed test with existing data: Flip one initial cell, plot the Hamming difference against time, and classify the difference as dying, bounded, linearly spreading, or sporadic. A systematic mismatch between that class and an independently assigned behavioral class would challenge the correspondence on the family tested." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Always is exhaustive for elementary rules and only sampled for larger rules.", "Sporadic versus uniform spread needs a declared front-speed test.", "Damage response is sometimes used as the definition of the class it is supposed to track." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-09--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-09 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-09--grok--operationalizability> .
