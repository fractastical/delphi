sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-12--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-12: resolvable-now, resolvability 0.83" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.83"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "The claim is pinned to three reproducible model classes, not to an open-ended survey of nature. Random-walk distributions are covered by the central limit theorem, and the aggregation and cellular-automaton comparisons are short simulations in public software. Removing randomness, or swapping its source, is a direct control, so the stated comparison can be confirmed or refuted now." ;
    rdfs:comment "Proposed test with existing data: Compare a roughness or circularity statistic for random walks, Eden-like aggregation, and deterministic cellular automata against the same models with the randomness removed. The central-limit case is already a theorem; the aggregation and cellular-automaton cases are finite simulations. Continuity collapsing when randomness is removed, and matching when intrinsic randomness replaces external noise, would support the claim; a systematic counterexample in these classes would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Smoothness needs an explicit statistic; visual roundness alone is not a decision criterion.", "The Eden model still lacks a full proof, so that case is settled by simulation rather than by theorem." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-12 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-12--grok--operationalizability> .
