sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-22--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-22--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-22: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.469"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "Task-specific benchmarks and the public record of artificial systems give a partial, confounded comparison of narrow and broader aims. They do not measure 'general human-like thinking' on a scale that would cleanly show it is easier, and the further requirement of a human-like experience base is only loosely represented. The prediction is testable in part and not decided by current benchmarks." ;
    rdfs:comment "Proposed test with existing data: Compare the engineering cost and success of systems aimed at general human-like performance with systems aimed at declared specific tasks, and test whether human-like performance appears only after a human-like experience base. Systematically easier general systems would support the claim; systematically earlier and cheaper success on specific tasks would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'Easier' depends on how tasks are chosen and on research effort, which is not an experimental control.", "General human-like thinking has no single public score comparable to task benchmarks." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-22--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-22--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-22 by Grok 4.7: 0.46" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.46"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-22--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-22--grok--operationalizability> .
