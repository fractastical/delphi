sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-40> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-40--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-40--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-40: partially-resolvable, resolvability 0.44" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.442"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.54"^^xsd:double ;
    dct:description "Model theory and formal libraries give real information: arithmetic decides ordinary number-theoretic statements and its other models are not explicit, while some textbook systems, such as the bare group axioms, decide much less. Fair fraction and usually are not tied to a measure or a closed list of systems. These results test examples rather than the general claim." ;
    rdfs:comment "Proposed test with existing data: For a standard system, estimate the density of sentences the axioms decide under a stated length measure, and inspect how explicitly other models can be described. A large, easily described set of independent sentences would challenge close to complete; a density near one half on each side of negation would support it for that system." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Fair fraction and close to complete need a measure on statements.", "Nonstandard models of arithmetic are known to exist and are also non-constructive, so obscure stays a judgment.", "The raw group axioms are highly incomplete until further axioms pick out a specific group." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-40--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-40--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-40--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-40 by Grok 4.7: 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.42"^^xsd:double ;
