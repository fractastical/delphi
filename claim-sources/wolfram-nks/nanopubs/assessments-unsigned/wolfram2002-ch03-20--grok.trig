sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-20--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-20--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch03-20: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.535"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "Samples of cellular automata, Turing machines, and related systems can be labeled with Wolfram's four themes using public simulators, and that labeling is informative for those classes. 'Dominant,' 'almost independent of the details,' and the extension to a vast range of systems are loose enough that many outcomes remain compatible with the claim. The test therefore reaches the simple-program core and not the full stated scope." ;
    rdfs:comment "Proposed test with existing data: Classify long evolutions of many simple programs into repetition, nesting, apparent randomness, and localized structures, and measure how often a behavior falls outside those four. Dominance of the four classes supports the claim; a large share of a well-defined class falling into a fifth stable type would challenge dominance." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The four themes are broad enough that many rival taxonomies can be fitted to the same pictures.", "The extension from simple programs to a vast range of systems is not covered by program enumeration alone." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-20--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-20--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-20--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch03-20 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-20--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-20--grok--operationalizability> .
