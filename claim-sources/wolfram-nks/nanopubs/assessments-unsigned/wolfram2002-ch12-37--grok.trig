sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-37> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-37--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-37--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-37: partially-resolvable, resolvability 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.42"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Surveys and problem libraries document undecidability in group theory, tilings, Diophantine equations, topology, and other fields, and they also document large decidable theories. That literature can test the pattern inside studied areas. It does not measure almost as soon as questions stop being easy across practically any area, because both the threshold and the inventory of areas are unspecified." ;
    rdfs:comment "Proposed test with existing data: Assemble a list of mathematical areas and, in each, separate questions with decision procedures from questions reduced to the halting problem. The pattern supports the claim where undecidability begins immediately past the decidable fragment, and challenges it where a large intermediate band stays decidable." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Always easy and practically any area are not formal thresholds.", "Known undecidability results concentrate in fields logicians chose to encode computation into.", "A decidable theory with difficult questions counts as a counterexample only after easy is defined." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-37--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-37--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-37--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-37 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-37--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-37> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-37--grok--operationalizability> .
