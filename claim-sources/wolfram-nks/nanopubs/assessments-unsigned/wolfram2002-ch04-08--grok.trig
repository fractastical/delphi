sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-08--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch04-08: resolvable-now, resolvability 0.77" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.77"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "The sequences are integer recurrences with published terms and trivial recomputation, and Wolfram's own examples already separate nested cases from irregular ones. Showing that at least some addition-subtraction recurrences of this kind have fluctuations that fail periodicity and nesting tests settles the existence claim. Calling those fluctuations random 'in many respects' is a weaker, test-dependent gloss on that same computation." ;
    rdfs:comment "Proposed test with existing data: Evaluate nested recurrences that use only addition and subtraction, such as rules depending on f[n - f[n-1]], and test the fluctuations of f[n] for nesting versus statistical irregularity. An irregular fluctuation series confirms that such rules can be complex; every well-defined rule in the class reducing to a regular nested or periodic fluctuation would refute the 'can.'" ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Some of these recurrences are known to be nested and are related to binary digits, so the randomness claim has to be restricted to the irregular cases.", "Statistical irregularity of fluctuations does not identify the mechanism that produces them." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-08--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-08 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-08--grok--operationalizability> .
