    delphi:hasScore "0.55"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.81"^^xsd:double ;
    dct:description "Large behavioral samples can be computed and compared now. The broad invariance conclusion requires a common non-arbitrary metric and coverage beyond available catalogs, so only selected system families are resolvable." ;
    rdfs:comment "Proposed test with existing data: Sample specified arithmetic systems and cellular automata, encode their trajectories using declared invariant features, and compare distributions of behavior classes. Similar distributions across the sampled families support a restricted claim; strong family separation refutes it there." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Very similar and kinds of behavior are underspecified.", "Sampling and representation choices can determine apparent similarity.", "The conclusion about rule details exceeds any finite comparison." ;
