  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-06--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch04-06: partially-resolvable, resolvability 0.55" ;
