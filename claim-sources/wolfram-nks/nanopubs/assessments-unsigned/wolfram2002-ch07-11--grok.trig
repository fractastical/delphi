sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-11--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-11: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.47"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Image archives are sufficient to test the negative half, that fine-scale agreement is too strong for independent environmental noise, for some well-photographed organisms. They do not cover the stated range of physical and biological systems, and a positive match is also what any shared deterministic program would produce. The claim is therefore testable only in part and only against the environmental-noise rival." ;
    rdfs:comment "Proposed test with existing data: Quantify within-species and left-right similarity for features that pass standard randomness tests, and compare that similarity with independent environmental noise. Excess bilateral or within-species agreement would reject ongoing environmental noise; agreement alone would not identify one intrinsic mechanism among other shared deterministic growth rules." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Shared genes or shared developmental history produce matching patterns without the specific intrinsic-randomness mechanism.", "Which features count as complex and random has to be fixed before the similarity test is meaningful." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-11 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-11--grok--operationalizability> .
