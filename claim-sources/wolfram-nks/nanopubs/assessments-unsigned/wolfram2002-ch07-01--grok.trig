sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-01--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-01: partially-resolvable, resolvability 0.41" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.41"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The program-to-program half can be sampled by comparing classes across rule families, which is ordinary simulation and supports only a proxy for universality. The crucial clause extends the same features to real molecules, and the sentence never says which features or which systems would decide it. Matching pictures do not discriminate a shared mechanism from coincidence, so the nature half stays unresolved." ;
    rdfs:comment "Proposed test with existing data: Test recurrence of the same behavioral classes across declared families of simple programs. The nature half would require a pre-registered list of features on which a molecular system and a cellular-automaton model must agree, which the sentence does not provide." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The same universal features has no fixed list of measurements.", "Visual resemblance between a program and a natural system does not identify a shared mechanism.", "No public dataset aligns molecular systems with these behavioral classes." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-01--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-01 by Grok 4.7: 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.42"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-01--grok--operationalizability> .
