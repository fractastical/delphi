    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.808"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.87"^^xsd:double ;
    dct:description "The existential claim can be settled by reproducible computations on precisely defined maps, with many public sequences available for cross-checking. Standard analyses can confirm complex finite behavior even though they may not prove all asymptotic properties." ;
    rdfs:comment "Proposed test with existing data: Specify simple arithmetic maps and seeds, compute long trajectories, and quantify periodicity, growth, compressibility, and statistical irregularity. A single robust low-description-length example with high behavioral complexity confirms the existential core." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Highly complex remains dependent on chosen metrics.", "Finite runs can hide eventual periodicity." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-02--gpt--dataset-1> .
