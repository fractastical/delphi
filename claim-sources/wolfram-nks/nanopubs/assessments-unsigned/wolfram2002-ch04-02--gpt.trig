  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-02--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch04-02: resolvable-now, resolvability 0.81" ;
