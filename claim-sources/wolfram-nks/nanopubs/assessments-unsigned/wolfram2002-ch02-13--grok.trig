sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-13--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch02-13: not-empirically-resolvable, resolvability 0.11" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.11"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    dct:type "resolution-route/none" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "That a computer can iterate a rule other than a traditional equation is built into the notion of a program. Calling the resulting findings fundamental discoveries adds an evaluation that no dataset separates from the rival evaluation that they are recreational mathematics. The sentence is methodological rhetoric." ;
    rdfs:comment "Proposed test with existing data: The claim says that studying simple programs yields fundamental scientific discoveries and that computers are not confined to evaluating equations. 'Fundamental' is an evaluative label, and once it is removed the remainder is close to a description of what computation is." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Fundamental is an honorific without a confirming measurement.", "Whether a mathematical finding about programs counts as a scientific discovery is a classificatory dispute." .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch02-13 by Grok 4.7: 0.25" ;
