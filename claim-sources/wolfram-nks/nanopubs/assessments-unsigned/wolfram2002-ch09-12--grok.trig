sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-12--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-12: needs-new-data, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.477"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Collider compilations can reconfirm that space behaves as a continuum down to roughly the scale Wolfram names. That reconfirmation does not discriminate discreteness at still smaller distances from a continuum at all scales. The positive claim needs shorter-distance data that have not been collected." ;
    rdfs:comment "Proposed test with existing data: Compare scattering and other short-distance probes with a continuum cross-section down to a stated length, and look for a breakdown that a discrete substrate would produce below about 10^-20 m. Continuum behavior at all accessible scales leaves the discreteness claim untouched; a scale-dependent deviation fitted by a discrete cutoff would support it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Present null results are what the claim predicts, since it places discreteness below the probed scale.", "No public dataset reaches the distances at which discrete elements are asserted to exist." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-12 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-12--grok--operationalizability> .
