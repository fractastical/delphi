sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch11-06: resolvable-now, resolvability 0.83" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.828"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "The claim is an existence claim with an explicit construction: a fixed rule, a block encoding, and a uniform way to add colors and neighbors. Both pieces are published and can be executed. Checking elementary targets and the color-reduction step is a finite programming task, and a single failed emulation of a covered target would refute the claim." ;
    rdfs:comment "Proposed test with existing data: Implement the published 19-color, range-2 rule and the block encoding that stores a target rule and cell state. Compare the decoded evolution with the target cellular automaton. Agreement for arbitrary colors and neighborhoods, via the stated reduction to a binary larger-neighborhood rule, confirms the claim; a mismatch refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The full rule table is large, and some neighborhood combinations are excluded by the initial-condition invariant, so a checker must follow that invariant." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch11-06 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-06--grok--operationalizability> .
