sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-11--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-11: partially-resolvable, resolvability 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.683"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.69"^^xsd:double ;
    dct:description "Once a region is shown to be dynamically finite, eventual repetition is the pigeonhole principle and is settled by proof. Whether rules called class 2 actually break into independent patches a few cells wide is a simulation survey, complete for elementary rules and open beyond them. The causal story is therefore only as strong as the non-circular localization measurement." ;
    rdfs:comment "Proposed test with existing data: Measure the spatial range of a one-cell perturbation and the eventual temporal period on class 2 candidates. Given a finite range of a few cells, the pigeonhole bound predicts a short period; a class 2 rule with long-range damage or a nonrepeating evolution would challenge the account." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Localization, short periods, and the class 2 label are easy to make circular.", "Typically a few cells needs a survey beyond the usual examples.", "The period bound is a theorem only after the finite-range premise is established." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-11--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-11 by Grok 4.7: 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.68"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-11--grok--operationalizability> .
