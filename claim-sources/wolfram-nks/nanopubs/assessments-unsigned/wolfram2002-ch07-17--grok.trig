sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-17: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.647"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Jagged landscapes and trapping of downhill search are directly measurable on public constraint benchmarks, and those experiments are routine. A claim that no acceleration works across broad classes cannot be closed by any finite comparison, and the step from that fact to natural systems is an analogy rather than a dataset. The computational core is testable; the full conclusion is not settled by it." ;
    rdfs:comment "Proposed test with existing data: On a broad sample of discrete constraint problems, run strict downhill search, neutral-or-downhill search, and standard accelerated heuristics, and record residual violation and time to a solution. Near-universal trapping of downhill search, with only slow gains from added randomness and no heuristic that succeeds across the sample, would support the computational half; a general method that reliably reaches solutions would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No speed-up works across broad classes is a negative existential and cannot be exhausted by the heuristics tried.", "The inference from solver behavior to natural systems adds a step the benchmarks do not contain." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-17--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-17 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok--operationalizability> .
