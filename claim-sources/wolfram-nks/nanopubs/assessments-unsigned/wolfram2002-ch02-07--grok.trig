    rdfs:label "Candidate dataset: Golly" ;
    dct:description "simulator used to evolve rule 110 from one black cell through several thousand steps" ;
    prov:wasDerivedFrom <https://golly.sourceforge.io/> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-07--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Cook 2004, Universality in Elementary Cellular Automata" ;
    dct:description "universality proof implying that some questions about arbitrary rule 110 configurations are undecidable" ;
    prov:wasDerivedFrom <https://doi.org/10.25088/complexsystems.15.1.1> .
