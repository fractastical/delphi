sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-07--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch02-07: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.653"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "The pictured evolution is short by modern standards, so the fate of that one seed is computable, and universality supplies a proof that no algorithm settles every initial condition. The sentence asserts both that one cannot tell in advance and that running as long as needed is the only sure method. Those two clauses pull apart under the universality proof, so existing resources test pieces of the sentence and do not confirm it as a whole." ;
    rdfs:comment "Proposed test with existing data: For the single-black-cell evolution, run rule 110 until the localized structures either die into a periodic regime or keep proliferating, and separately search for a closed-form shortcut that predicts that fate. Running answers the pictured case. It does not prove that no shorter method exists, nor that every initial condition is decidable by a finite run." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A successful finite run shows that simulation suffices for one initial condition and does not show it is the only method.", "Undecidability for arbitrary initial conditions means a finite run is not always enough either." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-07--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch02-07 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-07--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-07--grok--data-existence> a delphi:LLMClaimAssessment ;
