sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-15--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch04-15: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.775"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Roots of integers are algebraic, and a published theorem says an irrational number with an automatic base-b expansion is transcendental, so it is not such a root. Constant-length substitution systems, which are the nested digit sequences Wolfram constructs, produce automatic sequences, so the mapping is the standard one. The remaining care is whether every pattern he would call nested falls under that theorem; that is a scope check inside the proof, not a missing dataset." ;
    rdfs:comment "Proposed test with existing data: Identify nested digit sequences from substitution systems with automatic or morphic sequences, and use the theorem that irrational automatic numbers are transcendental. An algebraic integer root whose digits are generated by such a substitution would refute the claim; the transcendence theorem confirms it for that class." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Wolfram's 'nested' has to be mapped onto automatic or morphic sequences, and non-constant-length substitutions are the less immediate case.", "The theorem is specialist reading rather than a few days of routine checking." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-15--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-15 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-15--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-15--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-15--grok--data-existence> a delphi:LLMClaimAssessment ;
