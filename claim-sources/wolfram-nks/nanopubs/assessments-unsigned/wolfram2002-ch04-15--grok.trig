  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-15--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Annals of Mathematics" ;
    dct:description "published proof that irrational automatic numbers are transcendental, hence not roots" ;
    prov:wasDerivedFrom <https://annals.math.princeton.edu/> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-15--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: OEIS" ;
