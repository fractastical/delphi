sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-10--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch04-10: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.588"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "The sequences named in the section are public and their proved regularities are catalogued, so the descriptive claim that considerable complexity remains is checkable. The further claim that this complexity arises as a fundamental consequence of the generating rules, in the same sense as in other simple programs, is an interpretation of that remainder. The same tables are compatible with ordinary number-theoretic explanations, so the causal wording is only partly tested." ;
    rdfs:comment "Proposed test with existing data: For primes, divisor sums, sums of squares, and Goldbach-type counts, measure residual complexity after subtracting the regularities number theory has proved. Persistent irregular residuals are compatible with complexity coming from the generating rule; a full short description of each sequence would challenge that reading." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Showing that a sequence looks complex does not show that the complexity is a fundamental consequence of the rule rather than of a specific analytic mechanism.", "Several of the sequences are tied to open problems, so 'despite centuries of work' is not itself a complexity measure." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-10--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-10 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-10--grok--operationalizability> .
