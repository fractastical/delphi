  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-22--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-22--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch10-22: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.563"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Contemporary general and specialized systems provide relevant comparative evidence. However, the prediction concerns ease of reproduction at an unspecified level and bundles a separate claim about experience, so existing benchmarks resolve only proxies." ;
    rdfs:comment "Proposed test with existing data: Define comparable engineering budgets and benchmarks for broad human-like agents versus agents restricted to selected tasks, then compare development cost, sample efficiency, and performance, with and without human-like experience corpora. Lower cost for broad agents would support the prediction." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Human-like thinking has no agreed metric.", "Historical engineering effort is not standardized.", "Current systems and benchmarks are selected by research incentives." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-22--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-22--gpt--dataset-2> .
