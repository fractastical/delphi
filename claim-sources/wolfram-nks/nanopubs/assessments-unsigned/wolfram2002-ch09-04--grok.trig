sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-04--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-04: partially-resolvable, resolvability 0.46" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.46"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Entropy increase from simple initial conditions can be recomputed for reversible cellular automata and is extensively documented for gases. The explanation that this happens because finding atypical initial conditions is as hard as the evolution itself is not distinguished, by those data, from other typicality arguments. The empirical regularity is partly testable; the stated cause is not settled by existing resources." ;
    rdfs:comment "Proposed test with existing data: For reversible cellular automata and for laboratory thermodynamic systems, compare entropy change from simple prepared initial conditions with the computational cost of finding initial conditions that decrease randomness. Entropy increase from every simple preparation, and no shorter search for decreasing preparations than running the dynamics, would support the account for those systems; an easy construction of randomness-decreasing states, or simple preparations whose entropy falls, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A cosmological low-entropy initial condition predicts the same laboratory facts without the computational story.", "The claim that no shorter procedure exists is a general complexity statement, not a quantity tabulated for physical experiments." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-04 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-04--grok--operationalizability> .
