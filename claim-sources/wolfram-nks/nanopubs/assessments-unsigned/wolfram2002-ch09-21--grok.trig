sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-21--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-21: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.559"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Time dilation and the independence of physics from uniform velocity are established experimentally, and the geometric clock argument can be checked on the regular causal networks Wolfram draws. Those checks do not show that causal invariance is why relativity holds, because the same phenomena follow from continuum special relativity. A general derivation for irregular networks remains incomplete." ;
    rdfs:comment "Proposed test with existing data: For a causally invariant network, compare the rules induced on spacelike slices at different angles and derive the time-dilation factor as a function of velocity. Quantitative agreement with the relativistic factor on those models supports the derivation; angle-dependent rules, or a dilation factor other than 1/sqrt(1-v^2/c^2), refute it for that class." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Experiments confirm special relativity without distinguishing a causal-network mechanism from Minkowski spacetime.", "The slice argument is explicit for regular networks; it is not a finished theorem for arbitrary causally invariant rules." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-21 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-21--grok--operationalizability> .
