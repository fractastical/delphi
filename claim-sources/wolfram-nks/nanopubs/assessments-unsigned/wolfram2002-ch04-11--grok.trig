sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch04-11: resolvable-now, resolvability 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.825"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Wolfram's claim is explicitly about computed digits and practical randomness, and public archives now hold many orders of magnitude more digits than the two hundred billion he cites. Running standard tests on those digits, or inspecting the published tests, can confirm the practical claim or refute it by exhibiting a regularity. Normality of pi remains unproved, and that is a stronger statement than the one being scored." ;
    rdfs:comment "Proposed test with existing data: Apply a fixed suite of normality and randomness tests to public prefixes of the digits of pi in several bases. A significant regular pattern on those prefixes would refute the practical claim; continued absence of such a pattern on prefixes far larger than those Wolfram cites would confirm it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Passing statistical tests on a finite prefix does not prove that pi is normal.", "A regularity with an extremely long period can be missed by any fixed test suite." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch04-11 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch04-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--grok--data-existence> a delphi:LLMClaimAssessment ;
