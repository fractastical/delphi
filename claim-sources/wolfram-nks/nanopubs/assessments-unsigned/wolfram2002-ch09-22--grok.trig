sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-22: needs-new-data, resolvability 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.35"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Particle properties are catalogued in detail, and localized structures in class 4 rules are easy to simulate. Neither resource connects a persistent network tangle to an electron or a quark. The claim stays a hypothesis until a model produces the spectrum, and no such public dataset exists." ;
    rdfs:comment "Proposed test with existing data: Identify persistent localized structures in a network model of space and match their conserved attributes and interaction rules to the elementary-particle spectrum. A one-to-one match with no particle-specific rules would support the claim; a spectrum that cannot be realized by persistent network structures would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Solitons, strings, and other localized-structure models fit the same particle data.", "Resemblance to class 4 gliders does not test whether physical particles are network tangles." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-22--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-22 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--grok--operationalizability> .
