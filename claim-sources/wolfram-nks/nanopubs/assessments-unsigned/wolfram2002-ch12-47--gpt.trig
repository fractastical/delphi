  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch12-47: partially-resolvable, resolvability 0.45" ;
