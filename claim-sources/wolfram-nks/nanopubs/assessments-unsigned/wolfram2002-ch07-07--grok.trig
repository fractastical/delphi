    rdfs:label "Candidate dataset: TestU01" ;
    dct:description "spectral and statistical tests of linear congruential generators, including known bad multipliers" ;
    prov:wasDerivedFrom <https://simul.iro.umontreal.ca/testu01/tu01.html> .
