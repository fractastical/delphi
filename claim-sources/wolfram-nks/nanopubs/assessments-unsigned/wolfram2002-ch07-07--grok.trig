sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-07: resolvable-now, resolvability 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.876"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "Full-period linear congruential sequences lie on lattices, which is a published theorem and is exactly the stripe failure drawn in the text. The generators are defined by their multipliers, so both the proof and a direct spectral test cover the class rather than one accidental example. A small team can reproduce the pictures and the test in days." ;
    rdfs:comment "Proposed test with existing data: Apply the spectral test to a maximal-period linear congruential generator: successive outputs lie on a lattice, visible as stripes in two- or three-dimensional plots. A maximal-period generator whose tuples were equidistributed in those dimensions would refute the regularity claim; the lattice theorem says none is." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Lattice structure is one specific deviation, not every possible defect.", "Perfect randomness is read here as equidistribution of low-dimensional tuples, matching the stripe pictures." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-07--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-07 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of wolfram2002-ch07-07 by Grok 4.7: 0.88" ;
