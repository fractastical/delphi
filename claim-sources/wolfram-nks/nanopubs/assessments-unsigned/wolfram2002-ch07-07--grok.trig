  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of wolfram2002-ch07-07 by Grok 4.7: 0.82" ;
