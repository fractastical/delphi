sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-25> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-25--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-25--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-25: partially-resolvable, resolvability 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.515"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The explicit emulations, including a Turing machine using on the order of t squared steps to match t steps of a cellular automaton, are finite constructions a simulator can check. The sentence then says almost all of the varied systems, and presumably those in nature, have comparable rates. A handful of constructions does not settle that extension, and no dataset measures computational rate across natural processes." ;
    rdfs:comment "Proposed test with existing data: For each published emulation, such as a Turing machine rebuilding t steps of a one-dimensional cellular automaton in order t squared steps, simulate both systems and compare step counts. A verified polynomial emulation supports that pair; a forced exponential emulation of a simple universal system would challenge the general claim for that pair." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Almost all systems, and systems in nature, lie beyond the explicit constructions.", "A polynomial overhead in one encoding leaves other encodings and other features of the output open.", "Asking about existence over many paths is the separate P versus NP question." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-25--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-25--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-25--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-25 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-25--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-25> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-25--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-25--grok--data-existence> a delphi:LLMClaimAssessment ;
