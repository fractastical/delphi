  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch10-20: partially-resolvable, resolvability 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.446"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Existing task data can assess memory involvement in selected forms of reasoning. They cannot establish that retrieval underlies almost every major aspect of thought or that logic is never a distinct computational mechanism." ;
    rdfs:comment "Proposed test with existing data: Across reasoning, analogy, generalization, and intuition tasks, test whether trial-level behavior and neural activity are predicted by retrieval of learned episodes after controlling for explicit rule use and working memory. Selective disruption or absence of retrieval signatures would challenge restricted versions." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Retrieval and rule application are not mutually exclusive.", "The claim quantifies over almost all thinking.", "Neural correlates do not establish causal primacy." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--gpt--dataset-2> .
