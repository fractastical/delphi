sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-03--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-03: resolvable-now, resolvability 0.77" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.774"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "The claim is an existence claim about a class of programs that can be built by a standard reversible construction. Generating apparent randomness and localized structures in that class is a short computation, and failure to find either under a broad sample of constructions would count against it. No new empirical data are required." ;
    rdfs:comment "Proposed test with existing data: Construct second-order reversible cellular automata and compare them with irreversible rules on compressibility of the spacetime pattern and on the presence of persistent localized structures. Reversible examples that are incompressible and that support localized structures would support the claim; reversible rules that remain simple under every standard construction would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "As complex as anywhere else depends on the complexity measure, although incompressible output and localized structures are directly checkable." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-03 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-03--grok--operationalizability> .
