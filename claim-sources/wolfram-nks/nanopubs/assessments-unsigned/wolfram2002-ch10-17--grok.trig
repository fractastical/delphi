sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-17--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-17: partially-resolvable, resolvability 0.39" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.389"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "Particular nested patterns, such as those tied to binomial coefficients modulo 2, have known formulas, and the hypergeometric class is a published, checkable target. The claim says any nested pattern, in functions that may be generalized as needed. Specific successes therefore test only a restricted scope, and the elastic generalization blocks a clean refutation." ;
    rdfs:comment "Proposed test with existing data: For substitution systems that generate nested patterns, search for a formula for each cell in a stated class of generalized hypergeometric functions. A uniform translation of every nested pattern into a fixed class would confirm the claim; escape into an ever-wider class of 'similar generalizations' leaves it unrefuted." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'Suitably generalized' can be expanded until almost any nested formula counts.", "Known closed forms for particular nested patterns do not yield a theorem for every substitution system." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-17--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-17 by Grok 4.7: 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.36"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-17--grok--operationalizability> .
