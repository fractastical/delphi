  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-56--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Cook 2004, Universality in Elementary Cellular Automata" ;
    dct:description "proof that a simple cellular automaton reaches the universality ceiling used as the measure of sophistication" ;
    prov:wasDerivedFrom <https://doi.org/10.25088/complexsystems.15.1.1> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-56--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Johns Hopkins Turbulence Databases" ;
    dct:description "resolved turbulent flows whose complexity can be inspected and whose universality is not thereby established" ;
    prov:wasDerivedFrom <https://turbulence.pha.jhu.edu/> .
