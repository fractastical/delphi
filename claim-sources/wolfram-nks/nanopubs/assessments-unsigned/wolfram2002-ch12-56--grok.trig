sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-56> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-56--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-56--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-56: partially-resolvable, resolvability 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.353"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "For simple programs the comparison is a theorem: rule 110 is universal, so it meets the computational ceiling usually assigned to any effective procedure. Brains, turbulence, and the universe are part of the sentence and are not known to be universal on public data. Simulations of turbulence show complex flow, which leaves emulation power undecided." ;
    rdfs:comment "Proposed test with existing data: Take universality as the level of sophistication: a system matches the ceiling of effective procedure if it emulates a universal computer under a stated encoding. Rule 110 meets this by proof. The same standard applied to a brain model, a turbulent flow, and a candidate law of physics is not settled by existing data." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Universality is proved for some cellular automata and is open for brains, turbulence, and the universe.", "Similar-looking complexity is compatible with failure to emulate a universal computer.", "A brain or a fluid could fail to be universal while its behavior looks complex." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-56--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-56--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-56--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-56 by Grok 4.7: 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.38"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-56--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-56> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-56--grok--operationalizability> .
