sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch02-02: resolvable-now, resolvability 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.88"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "The rule, the initial condition, and the rejected alternatives (uniform, repetitive, nested) are explicit, and the pattern is trivial to recompute. Known local regularities, which the source text also notes, keep the phrase 'almost no overall regularity' from being a sharp predicate. A classifier aimed at the three simple forms can still confirm or refute the claim as stated." ;
    rdfs:comment "Proposed test with existing data: Generate rule 30 from a single black cell for a large number of steps and test it for global periodicity, nesting, and compressibility. The claim is confirmed if the pattern is not uniform, periodic, or nested, and refuted if a short exact description of that kind fits the whole space-time diagram." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The left side has persistent diagonal bands and the right edge is periodic, so 'almost no overall regularity' is a threshold judgment.", "Failure of a finite list of regularity tests does not prove that no global regularity exists." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-02--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch02-02 by Grok 4.7: 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.82"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok--operationalizability> .
