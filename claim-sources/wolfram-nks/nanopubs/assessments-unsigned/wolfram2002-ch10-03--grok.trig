sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-03--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch10-03: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.558"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The premises are theorems: description-length randomness is uncomputable, and every sequence from a deterministic rule has a short description, so that definition never counts those sequences as random. Those premises can be checked from the published theory now. The further claim that any useful definition must refer to the method of finding descriptions is not a mathematical or empirical proposition." ;
    rdfs:comment "Proposed test with existing data: Treat Kolmogorov complexity as the definition that calls a string random only when it has no short description, and use the known proof that this complexity is uncomputable and infinite for no computable sequence. That confirms the restrictiveness and uncomputability clauses; it does not decide whether every useful definition must mention the search for descriptions." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The conclusion about what is useful is a normative judgment about definitions.", "Uncomputability of complexity is compatible with pragmatic randomness tests that never claim to find every short description." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-03--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch10-03 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-03--grok--operationalizability> .
