sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-12--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-12: partially-resolvable, resolvability 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.353"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "There is a real proxy: standard methods predict periodic and nested cellular automata and do not compress rule 30, and both the methods and the automata are available. That proxy does not separate computational equivalence from ordinary limits of sample size, features, or effort. The general explanation, covering every usable observer and every system past a low threshold, is not fixed by those experiments." ;
    rdfs:comment "Proposed test with existing data: Compare a computationally reducible system with an irreducible one, such as a nested cellular automaton and rule 30, using each practical analysis method as an observer. The explanation is supported if every usable method shortcuts the reducible system and fails to shortcut the irreducible one because the method is itself only Turing-powerful; it is refuted if some usable method systematically shortcuts the irreducible system." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Failure to predict can come from limited time or the wrong statistic without the observer matching the system's computational level.", "Any method of perception and analysis that can actually be used already assumes the principle's bound on observers." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-12 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-12--grok--operationalizability> .
