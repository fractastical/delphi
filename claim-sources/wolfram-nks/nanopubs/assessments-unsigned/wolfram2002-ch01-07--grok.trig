sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-07--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch01-07: resolvable-now, resolvability 0.92" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.915"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.88"^^xsd:double ;
    dct:description "This is an existence claim with a standard formal definition, and a published simulation proof for rule 110 meets it. One correct example covers the full scope. Reviewing that proof is specialist work on the scale of weeks, and the result has a stable published form that a small team can check." ;
    rdfs:comment "Proposed test with existing data: Use the standard definition of universality: a system is universal if it simulates a universal Turing machine, or an equivalent cyclic tag system, under an efficient encoding. The existence claim is confirmed by one checked simulation proof for a rule that can be stated in a single sentence, and refuted if every such proof fails." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Universality is relative to an efficient encoding of the input; a wasteful encoding would make the notion trivial." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-07--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch01-07 by Grok 4.7: 0.95" ;
