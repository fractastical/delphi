sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-24--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-24--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch06-24: partially-resolvable, resolvability 0.57" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.57"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Specific growing seeds are described well enough to resimulate, and a repeating production cycle can turn some of them into proofs of unbounded growth. The sentence says class 4 automata can mimic all sorts of other systems, which those seeds illustrate and do not exhaust. Existing simulators resolve the examples and leave the general feature as a sample." ;
    rdfs:comment "Proposed test with existing data: Re-run the published seeds for unbounded growth in rule 110 and in the code 1329 rule, and prove growth from a repeating production cycle where one exists. A seed whose pattern provably grows supports that example; all sorts of other systems has no fixed target list." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "All sorts of other systems is not a fixed list of target behaviors.", "A long growing run is not yet a proof of unbounded growth.", "The general class 4 claim is much wider than rule 110 and code 1329." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-24--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-24--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-24--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch06-24 by Grok 4.7: 0.46" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.46"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-24--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-24> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-24--grok--operationalizability> .
