sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-27> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-27--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-27--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-27: partially-resolvable, resolvability 0.43" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.432"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "The stripe problem is easy to place in NP, and public simulators can map it at small t. NP-completeness also requires hardness, and that direction remains an open proof obligation for rule 30. Proofs that some other cellular automata have NP-complete preimage problems bear on the remark that simple instances occur, and they leave the rule 30 expectation unresolved." ;
    rdfs:comment "Proposed test with existing data: Given t, decide whether some initial condition makes rule 30 produce a center-column black stripe of a stated height after t steps. A polynomial reduction from a known NP-complete problem would confirm the expectation, and a polynomial algorithm would refute it. Guess-and-simulate already places the problem in NP." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Membership in NP is immediate; NP-hardness of this rule 30 problem is open.", "Empirical hardness at small t is compatible with a polynomial algorithm.", "NP-complete preimage problems for other cellular automata do not transfer to rule 30." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-27--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-27--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-27--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-27 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-27--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-27> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-27--grok--operationalizability> .
