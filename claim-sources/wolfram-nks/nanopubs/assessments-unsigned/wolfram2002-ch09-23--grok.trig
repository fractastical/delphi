sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-23> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-23--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-23--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch09-23: partially-resolvable, resolvability 0.57" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.569"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Observed masses are public and precise, and it is immediate that they do not lie in simple ratios. The claim retreats to unknown fundamental masses after subtracting a scheme-dependent interaction energy, so the tables test only the surface reading. The hedged remainder is not fixed tightly enough for those tables to confirm or refute it." ;
    rdfs:comment "Proposed test with existing data: Test published lepton and quark masses for simple rational or other pre-registered relations, then repeat the test on a stated definition of mass with interaction energy removed. Simple relations among observed masses would confirm the strong reading; their absence only touches the claim if the interaction-energy subtraction is fixed in advance." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'May' plus an allowance for interaction energy makes the claim hard to refute.", "How much of a measured mass is interaction energy depends on the renormalization scheme." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-23--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-23--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch09-23 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
