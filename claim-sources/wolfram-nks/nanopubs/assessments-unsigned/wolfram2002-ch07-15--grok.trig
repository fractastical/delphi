sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-15--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-15: partially-resolvable, resolvability 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.545"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Bistability and first-order transitions in continuous equations are standard and are documented in public kinetic and thermodynamic compilations. The further claim that discrete models are therefore often the most appropriate has no agreed confirming measurement: continuous models remain adequate for many of the same transitions. Existing data test the dynamical half and not the modeling recommendation." ;
    rdfs:comment "Proposed test with existing data: Count stable steady states and hysteresis in published chemical-kinetic and phase-transition systems as a continuous parameter is varied. Multiple stable states with an abrupt switch would support the dynamical half; a single stable branch throughout would count against it. Whether a discrete model is the most appropriate description is a separate modeling judgment and is not fixed by that count." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Most appropriate is a normative choice among models, not a measured variable.", "Kinetic compilations cover laboratory reactions, not every natural system with discrete behavior." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-15--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-15 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-15--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-15--grok--operationalizability> .
