sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-29> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch08-29: partially-resolvable, resolvability 0.61" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.608"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "Second- and minute-scale trades are public for at least one major class of market, and an event-style split between news and no-news windows is a standard analysis. That split can show that a large fraction of short-term variance is not tied to public headlines. It cannot fully separate internal matching dynamics from private information, so the mechanism remains only partly identified." ;
    rdfs:comment "Proposed test with existing data: Decompose short-horizon price variance into intervals with identified external news and intervals without it, at timescales of seconds to minutes. Variance that remains large in no-news windows, and that is shared across unrelated instruments traded on the same venue, would support an internal source; variance that collapses to the news timestamps would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Unobserved information can move prices in windows that contain no headline.", "Freely archived tick data are dominated by crypto, while equity tick histories are often licensed." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-29--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch08-29 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-29> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--grok--operationalizability> .
