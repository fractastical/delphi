sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-08--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch01-08: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.56"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Bounded prediction experiments on elementary cellular automata and other small systems are routine and can show that many non-simple rules lack obvious shortcuts. That is a proxy for a bounded horizon, not a proof that most systems are irreducible in the strong sense. Undecidability blocks a general algorithm that would certify the majority claim across its stated scope." ;
    rdfs:comment "Proposed test with existing data: On a declared ensemble of non-simple systems, search for predictors whose cost grows slower than direct simulation, including closed forms, periodicity, and statistical shortcuts. A system is treated as irreducible on a finite horizon if every such predictor fails. The majority claim is confirmed only if that failure holds for most of the ensemble, which a finite search cannot fully prove." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Failure to find a shortcut does not prove that none exists.", "Irreducibility of arbitrary systems is entangled with undecidability.", "The ensemble of 'most systems' is open-ended, so small rule spaces are a subset." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-08--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch01-08 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-08--grok--operationalizability> .
