sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch07-06: partially-resolvable, resolvability 0.69" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.686"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Public JPL ephemerides and standard n-body integrations are enough to test whether nearby solar-system trajectories diverge over a few million years, which is the dynamical core of the sentence. That computation is specialist work, and published integrations already exist to audit. The hedge that this may explain some present-day features names nothing that a divergence plot could confirm or refute." ;
    rdfs:comment "Proposed test with existing data: Integrate the planetary equations from public ephemerides with a tiny change in initial conditions and measure divergence over a few million years. Exponential separation supports sensitive dependence on that timescale; bounded separation would challenge it. The clause about present-day features needs a named feature the divergence is supposed to explain." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Significant randomness has no numeric divergence threshold.", "May explain some present-day features names no feature.", "Million-year integrations mix sensitive dependence with truncation and model error." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch07-06 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch07-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--grok--operationalizability> .
