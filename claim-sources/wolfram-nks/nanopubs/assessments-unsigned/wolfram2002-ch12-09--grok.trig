sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-09--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-09: resolvable-now, resolvability 0.77" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.768"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    dct:type "resolution-route/proof" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Both halves are existence and non-existence theorems about equations, not observations. Decidability results for real polynomial constraints, and Richardson's theorem for elementary functions with sine, are published and checkable. Turning the undecidability proof into an explicit cellular-automaton encoding is a finite logic exercise, which puts the claim within present methods even though the book does not spell every substitution out." ;
    rdfs:comment "Proposed test with existing data: For polynomial equations, use decidability of the existential theory of the reals to show that solvability does not encode arbitrary cellular-automaton evolution. For trigonometric equations, give an explicit family whose solutions encode the state of a cellular automaton after arbitrarily many steps. Existence of that family confirms the trigonometric clause; a decision procedure for it would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Richardson's original class uses absolute value and exponentials together with sine, so the write-up must land in the trigonometric fragment named in the claim.", "Encoding an arbitrary finite number of steps is weaker than a single equation that packages infinitely many steps, and the construction has to match the stronger reading." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-09--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-09 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-09--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-09--grok--data-existence> a delphi:LLMClaimAssessment ;
