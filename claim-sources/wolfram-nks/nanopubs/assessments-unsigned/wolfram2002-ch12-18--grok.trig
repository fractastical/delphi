sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch12-18: partially-resolvable, resolvability 0.41" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.415"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/computation" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Public simulators can enumerate small rule spaces and compare apparent complexity with known shortcuts, which is a proxy for the simple-program half. Very rare, and the vast majority of complex-looking natural behavior, presume a measure the text does not give. Irreducibility of a natural process is not settled by the look of a picture." ;
    rdfs:comment "Proposed test with existing data: Enumerate simple programs up to a size bound, flag outputs that standard compressors leave incompressible, and test whether a short map from position to color still exists. A high rate of such shortcuts would challenge rarity among programs; natural systems still require their actual rules." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Looks complex depends on a perceptual or compression criterion the claim leaves open.", "A missing shortcut is compatible with a shortcut not yet found.", "Natural systems sit outside the enumerable set of simple programs." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-18--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch12-18 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok--operationalizability> .
