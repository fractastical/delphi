sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-18--grok> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on wolfram2002-ch02-18: partially-resolvable, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.483"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/empirical-data" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Priority claims are refuted by a single earlier publication that states the phenomenon, and a large digitized literature makes that search possible. The source text itself lists hints, so the boundary between a hint and a discovery has to be fixed before the search decides anything. Coverage of the historical record is incomplete, which blocks a confident confirmation of 'never.'" ;
    rdfs:comment "Proposed test with existing data: Search the published record before the 1980s for a statement that simple programs systematically produce complex behavior of the kinds later classified. A clear prior statement refutes the priority claim. Failure to find one supports it only inside the searched corpus and under the chosen reading of 'identified.'" ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "What counts as identifying the phenomenon, as opposed to exhibiting a hint such as the Game of Life or the digits of pi, is disputed.", "Undigitized and non-English sources are missing from any practical search." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of wolfram2002-ch02-18 by Grok 4.7: 0.5" ;
