sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-18--gpt> .
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-18--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on wolfram2002-ch10-18: partially-resolvable, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.699"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    dct:type "resolution-route/mixed" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "Existing computation can reproduce formula-size growth for many steps and representations. The unrestricted conclusion that no simple formula exists requires formal complexity lower bounds and cannot be inferred completely from finite cases." ;
    rdfs:comment "Proposed test with existing data: Compute exact minimal formula sizes for bounded rule-30 light cones in specified bases and compare growth with rules 90 and 254; separately seek asymptotic lower bounds. Rapid finite growth supports the evidence claim, while a compact general formula refutes the conclusion." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Exact formula minimization grows combinatorially.", "Simplicity depends on the allowed representation language.", "Finite growth does not prove an asymptotic impossibility theorem." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-18--gpt--dataset-2> .
