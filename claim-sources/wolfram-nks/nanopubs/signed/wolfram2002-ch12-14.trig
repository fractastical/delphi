sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch12-14> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Behavior that is obviously simple, such as repetitive or nested behavior, is always computationally reducible, while in practically all other cases behavior is computationally irreducible.";
    dc:type "general-principle";
    <http://www.w3.org/2000/01/rdf-schema#label> "Only obviously simple behavior is reducible; nearly all else is irreducible";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Computational Irreducibility” (from p. 737), p. 741. Scope: all systems, especially simple programs"
}
