sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch04-07> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The base-2 reverse-and-add process (add a number to its digit-reversal) started from 512 produces localized structures like those in cellular automata, and its overall pattern never appears to become simply repetitive.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Reverse-and-add in base 2 shows localized structures and never repeats";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Elementary Arithmetic” (from p. 117), p. 126. Scope: base-2 reverse-and-add iteration from particular starting numbers"
}
