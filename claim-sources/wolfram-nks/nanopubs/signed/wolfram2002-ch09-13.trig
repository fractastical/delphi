sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch09-13> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In the simplest ultimate model of the universe there is no distinction between space and its contents: matter and everything else are made of the same underlying structure as space, unlike in a cellular automaton.";
    dc:type "physical-hypothesis";
    <http://www.w3.org/2000/01/rdf-schema#label> "Space and matter should be made of the same stuff";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “The Nature of Space” (from p. 472), p. 474. Scope: fundamental structure of space and matter"
}
