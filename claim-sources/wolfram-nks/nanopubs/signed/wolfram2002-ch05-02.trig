sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch05-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The complexity inside patterns generated by two-dimensional totalistic cellular automata is very similar to that of one-dimensional cellular automata: a one-dimensional slice through the 2D pattern evolves much like an ordinary 1D cellular automaton.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Slices of 2D cellular automata resemble 1D cellular automata";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Cellular Automata” (from p. 170), p. 176. Scope: two-dimensional outer totalistic cellular automata from a single seed"
}
