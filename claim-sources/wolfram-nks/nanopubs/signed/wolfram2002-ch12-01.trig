sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch12-01> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Any process that follows definite rules, including processes in nature governed by physical law as well as processes constructed by humans, can be viewed as a computation, giving a uniform framework for comparing very different processes.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Every process, natural or artificial, can be viewed as a computation";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Basic Framework” (from p. 715), p. 715. Scope: all natural and artificial processes"
}
