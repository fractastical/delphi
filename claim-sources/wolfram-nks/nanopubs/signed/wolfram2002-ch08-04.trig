sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch08-04> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Apparent randomness in the shapes of crystalline materials often arises intrinsically from simple deterministic growth rules, rather than from randomness in the seed or the growth environment.";
    dc:type "model-of-nature";
    <http://www.w3.org/2000/01/rdf-schema#label> "Randomness in crystal shapes is often intrinsically generated by simple growth rules";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “The Growth of Crystals” (from p. 369), p. 373. Scope: growth shapes of crystals"
}
