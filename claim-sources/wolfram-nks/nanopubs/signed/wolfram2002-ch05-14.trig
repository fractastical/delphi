sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch05-14> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Because each sequence in a multiway system always leads to the same successors, the evolution can be represented as a network of which state leads to which, so multiway systems build up their own, often complicated, pattern of connections in time.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Multiway systems build their own network of connections in time";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Multiway Systems” (from p. 204), p. 209. Scope: multiway systems"
}
