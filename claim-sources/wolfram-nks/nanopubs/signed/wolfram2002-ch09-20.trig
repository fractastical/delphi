sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch09-20> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Each connection in the causal network of the universe corresponds to an identical elementary distance (perhaps about 10^-35 meters) and elementary time (perhaps about 10^-43 seconds), whose ratio is a fixed speed identified with the speed of light.";
    dc:type "physical-hypothesis";
    <http://www.w3.org/2000/01/rdf-schema#label> "Elementary length and time are tiny and their ratio is light speed";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “Space, Time and Relativity” (from p. 516), p. 520. Scope: discrete structure of spacetime"
}
