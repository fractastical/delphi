sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch05-15> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In one dimension, any set of local constraints on cell colors that can be satisfied at all can be satisfied by a simple, purely repetitive arrangement, so simple 1D constraints cannot force complex patterns.";
    dc:type "mathematical";
    <http://www.w3.org/2000/01/rdf-schema#label> "One-dimensional local constraints can always be met by a repetitive pattern";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Systems Based on Constraints” (from p. 210), p. 211. Scope: one-dimensional local constraint systems (one-dimensional subshifts of finite type)"
}
