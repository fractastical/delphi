sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch10-25> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Some extraterrestrial radio and other signals that are detected and assumed to be random noise could be meaningful messages encoded in a way recognizable only by higher forms of perception and analysis than those applied so far.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Extraterrestrial signals taken for noise could be meaningful messages";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Higher Forms of Perception and Analysis” (from p. 632), p. 635. Scope: astronomical radio and other signals searched for extraterrestrial intelligence"
}
