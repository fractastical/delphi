sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch01-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Contrary to engineering experience, performing sophisticated tasks does not require correspondingly complicated basic rules; extremely simple underlying rules, potentially implementable directly at the atomic scale, are often sufficient.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Sophisticated tasks need only extremely simple underlying rules";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 1, “The Foundations for a New Kind of Science”; section “Relations to Other Areas” (from p. 7), p. 11. Scope: technology and engineered systems, including nanotechnology"
}
