sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch08-29> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Much of the apparent randomness in financial prices, especially on timescales of minutes or seconds, is generated by the internal dynamics of trading entities interacting with one another, not by external news or changes in the value of the asset.";
    dc:type "model-of-nature";
    <http://www.w3.org/2000/01/rdf-schema#label> "Short-timescale market randomness comes from internal market dynamics";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “Financial Systems” (from p. 429), p. 431. Scope: price fluctuations in financial markets"
}
