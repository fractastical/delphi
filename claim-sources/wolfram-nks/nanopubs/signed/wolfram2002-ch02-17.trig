sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch02-17> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The prime numbers, though generated by simple rules, have a distribution that seems in many respects random, an early instance of complexity from simple rules that mathematics largely neglected in favor of proving regularities.";
    dc:type "mathematical";
    <http://www.w3.org/2000/01/rdf-schema#label> "Primes follow simple generating rules yet are distributed seemingly randomly";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 2, “The Crucial Experiment”; section “Why These Discoveries Were Not Made Before” (from p. 42), p. 48. Scope: distribution of prime numbers"
}
