sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch09-27> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The quantum correlations between distant particles usually taken to rule out definite underlying processes can arise in a deterministic network model, because particles created together stay linked by threads of connections that bypass ordinary three-dimensional space.";
    dc:type "physical-hypothesis";
    <http://www.w3.org/2000/01/rdf-schema#label> "Network threads let deterministic models produce quantum correlations";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “Quantum Phenomena” (from p. 537), p. 544. Scope: correlations in measurements on entangled particle pairs (Bell-type experiments)"
}
