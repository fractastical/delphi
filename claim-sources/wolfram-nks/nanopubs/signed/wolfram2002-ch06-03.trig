sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch06-03> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Class 4 cellular automata mix order and randomness: they produce localized structures that are individually fairly simple, but which move around and interact with each other in very complicated ways.";
    dc:type "computational-observation";
    <http://www.w3.org/2000/01/rdf-schema#label> "Class 4 consists of simple localized structures interacting in complex ways";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Four Classes of Behavior” (from p. 231), p. 235. Scope: class 4 cellular automata"
}
