sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch04-26> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Complexity is probably not fundamentally rarer in continuous systems than in discrete ones; it was much easier to discover in discrete systems because they can be studied directly by computer experiment without approximation artifacts.";
    dc:type "general-principle";
    <http://www.w3.org/2000/01/rdf-schema#label> "Complexity is not rarer in continuous systems, only harder to detect";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 4, “Systems Based on Numbers”; section “Continuous Versus Discrete Systems” (from p. 167), p. 167. Scope: continuous versus discrete dynamical systems"
}
