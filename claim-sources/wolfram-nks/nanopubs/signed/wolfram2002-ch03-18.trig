sub:assertion {
<https://w3id.org/delphi/resource/claim/wolfram2002-ch03-18> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Removing the special features of cellular automata, such as a rigid array of cells and parallel updating, does not prevent complex behavior from simple rules, so the phenomenon of complexity is universal and independent of the details of particular systems.";
    dc:type "general-principle";
    <http://www.w3.org/2000/01/rdf-schema#label> "Complexity does not depend on the special features of cellular automata";
    <https://w3id.org/delphi/ontology/context> "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 3, “The World of Simple Programs”; section “Some Conclusions” (from p. 105), p. 105. Scope: all kinds of simple programs"
}
