    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch02-12: partially-resolvable, resolvability 0.54";
    dc:description "Large open image collections can find counterexamples and estimate usage in covered collections. Their preservation and selection biases cannot confirm that such patterns never appeared across all historical ornament.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Search a temporally and culturally stratified corpus of ornament images using preregistered similarity features for repetitive, nested, and rule-30-like patterns, followed by expert validation. Any authenticated historical rule-30-like ornament refutes the absolute absence claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Absence cannot be established from incomplete preservation.", "Digitized museum collections are not exhaustive across cultures.", "Similarity to complex cellular-automaton output requires a threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-12--gpt--dataset-1>;
