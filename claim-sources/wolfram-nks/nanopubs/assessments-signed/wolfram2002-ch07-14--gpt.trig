    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-14--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch07-14: partially-resolvable, resolvability 0.81";
    dc:description "The transition and takeover behavior have direct computational criteria. Elementary and other bounded rule spaces can be exhaustively or systematically sampled using public software. The unrestricted comparison across all dimensions and rule parameterizations prevents a fully general resolution.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate specified one-, two-, and higher-dimensional binary cellular-automaton rule classes, initialize each over densities bracketing one half, and classify whether the majority color reaches consensus as size and time increase. Compare the fraction of qualifying rules by dimension and test boundary pinning as a mediator.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Finite simulations can confuse very long transients with stuck boundaries.", "Increasingly common depends strongly on the sampled rule family and neighborhood.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-14--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.811"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-14--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Atlas of Simple Programs";
    dc:description "rule definitions and behavior for one-dimensional cellular automata";
    prov:wasDerivedFrom <https://atlas.wolfram.com/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-14--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
