sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch12-18: partially-resolvable, resolvability 0.41";
    dc:description "Public simulators can enumerate small rule spaces and compare apparent complexity with known shortcuts, which is a proxy for the simple-program half. Very rare, and the vast majority of complex-looking natural behavior, presume a measure the text does not give. Irreducibility of a natural process is not settled by the look of a picture.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate simple programs up to a size bound, flag outputs that standard compressors leave incompressible, and test whether a short map from position to color still exists. A high rate of such shortcuts would challenge rarity among programs; natural systems still require their actual rules.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A missing shortcut is compatible with a shortcut not yet found.", "Looks complex depends on a perceptual or compression criterion the claim leaves open.", "Natural systems sit outside the enumerable set of simple programs.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-18--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.415"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "simulator for enumerating small rules and comparing apparent complexity with the existence of shortcuts";
    prov:wasDerivedFrom <https://golly.sourceforge.net/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-18--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS";
    dc:description "catalog of sequences with short descriptions, including digit sequences of powers that Wolfram uses as rare reducible examples";
    prov:wasDerivedFrom <https://oeis.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch12-18 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-18--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
