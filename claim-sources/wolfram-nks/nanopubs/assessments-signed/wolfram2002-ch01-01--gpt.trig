    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-01--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.325"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
