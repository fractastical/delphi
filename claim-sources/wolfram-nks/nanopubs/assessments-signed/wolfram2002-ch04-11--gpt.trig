sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-11: partially-resolvable, resolvability 0.87";
    dc:description "Enormous digit samples and standard statistical tools are publicly available, making practical finite-scale regularity highly testable. The universal absence of significant regularity and all-base wording remain beyond finite evidence.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Apply preregistered frequency, run, correlation, spectral, and compression tests to very large published or reproducibly computed digit blocks of pi in several bases. Any significant stable regularity refutes the practical claim under those tests; failure to detect one supports but cannot prove complete randomness.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No finite test establishes complete randomness or absence of every significant regularity.", "Normality of pi is unproved.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.94"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.87"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Pi-Search";
    dc:description "public searchable computed digits of pi";
    prov:wasDerivedFrom <https://www.angio.net/pi/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-11--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Statistical Test Suite";
    dc:description "public standard randomness-testing software";
    prov:wasDerivedFrom <https://csrc.nist.gov/projects/random-bit-generation/documentation-and-software>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch04-11 by GPT-5.6 Sol: 0.96";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.96"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--gpt>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-11--gpt--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch04-11 by GPT-5.6 Sol: 0.9";
