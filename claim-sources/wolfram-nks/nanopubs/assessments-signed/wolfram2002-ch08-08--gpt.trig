sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-08--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-08: partially-resolvable, resolvability 0.60";
    dc:description "Existing turbulence simulations permit counterfactual perturbations and scale-resolved energy analyses. They cover canonical flows and can test whether large-scale dynamics sustain randomness. Causal attribution among forcing noise, initial uncertainty, and intrinsic instability remains confounded in observational records.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare turbulence statistics in repeated flows with controlled macroscopic forcing while varying external disturbances and molecular noise in matched simulations. The claim is supported if large-scale dynamics generate nearly invariant turbulent statistics after those inputs are suppressed or varied, but refuted if output randomness tracks them.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Chaotic amplification makes internally generated and unmeasured input randomness observationally similar.", "Most existing datasets do not independently vary molecular noise.", "Mostly needs a variance attribution convention.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-08--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.598"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-08--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Johns Hopkins Turbulence Databases";
    dc:description "public direct numerical simulation fields for multiscale turbulence analysis";
    prov:wasDerivedFrom <https://turbulence.pha.jhu.edu/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-08--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-08 by GPT-5.6 Sol: 0.6";
