sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch08-06: resolvable-now, resolvability 0.74";
    dc:description "Mass and momentum conservation plus molecular chaos is the standard route to the Navier-Stokes equations, and lattice-gas rules can be rerun and compared with public turbulence fields. Breaking a conservation law changes the large-scale equation, which is a clean control. For ordinary fluids the claim can be confirmed or refuted with existing theory and data.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Derive or simulate the large-scale momentum equation for particle or lattice-gas rules that conserve mass and momentum, and compare the resulting flow, at matched Reynolds number, with laboratory or direct numerical solutions of ordinary fluids. Universal Navier-Stokes behavior when the conservation laws and a randomness condition hold, and a different large-scale law when they are broken, would support the claim; a conserved, sufficiently random particle system whose large-scale flow is not hydrodynamic would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Complex fluids are outside the ordinary fluids the claim is aimed at.", "The hydrodynamic limit assumes enough randomness and isotropy; some conserving rules stay correlated and do not yield simple viscosity.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-06--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.743"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-06--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Johns Hopkins Turbulence Databases";
    dc:description "public direct numerical simulations of incompressible flow for comparison with lattice-gas output";
    prov:wasDerivedFrom <https://turbulence.idies.jhu.edu/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-06--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Chemistry WebBook fluid properties";
    dc:description "reference properties of ordinary fluids whose large-scale flow collapses under the same dimensionless laws";
    prov:wasDerivedFrom <https://webbook.nist.gov/chemistry/fluid/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-06 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch08-06 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-06--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch08-06 by Grok 4.7: 0.75";
