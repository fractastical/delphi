sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-28--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-28: partially-resolvable, resolvability 0.61";
    dc:description "Large image resources permit robust description of recurring pattern classes and model fitting. Public molecular and perturbation evidence is narrow compared with animal diversity. Mechanistic discrimination requires developmental predictions, so only a subset of the claim is presently resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify wavelength, topology, and developmental dynamics of coat patterns, fit a local-activation/long-range-inhibition model, and compare perturbation predictions with alternative mechanisms. The claim is supported if one parameterized rule reproduces recurring pattern classes and correctly predicts genetic or chemical perturbations.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Developmental perturbation data cover few species.", "Different reaction-diffusion, cellular, and mechanical models share morphology.", "Final images alone cannot identify activation-inhibition dynamics.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.608"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iNaturalist";
    dc:description "large public image collection for cross-species coat-pattern morphology";
    prov:wasDerivedFrom <https://www.inaturalist.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-28--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Gene Expression Omnibus";
    dc:description "public expression datasets relevant to pigmentation development";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-28--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-28 by GPT-5.6 Sol: 0.62";
