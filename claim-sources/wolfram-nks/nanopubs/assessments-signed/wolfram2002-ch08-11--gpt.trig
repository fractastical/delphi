sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-11: needs-new-data, resolvability 0.19";
    dc:description "Existing morphology and phylogeny resources provide outcomes but not the required causal partition. The central reference distribution over programs is undefined, substantially lowering operationalizability. Major new developmental and fitness data would still leave difficult causal-identification assumptions.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define organismal complexity features, map each to a developmental program, and estimate causal variance attributable to neutral program-output prevalence versus adaptive selection using phylogenetic and fitness data. A dominant neutral-program contribution across a representative feature sample would support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Adaptation and developmental generation are not mutually exclusive causes.", "No dataset assigns causal origins to a representative share of biological complexity.", "Randomly chosen programs has no natural sampling distribution.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.83"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-11--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.188"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-11--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "public phylogenetic framework for restricted comparative tests";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-11--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "public morphological matrices for sampling organismal features";
    prov:wasDerivedFrom <https://morphobank.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-11--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-11 by GPT-5.6 Sol: 0.22";
