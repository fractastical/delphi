<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch07-07: resolvable-now, resolvability 0.95";
    dc:description "LCG outputs are exactly reproducible from public algorithms, and their lattice structure is mathematically established. Standard public test suites can demonstrate substantial deviations within days.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Generate complete or large output samples from maximal-period linear congruential parameter sets, apply spectral tests in multiple dimensions, and prove the lattice structure of successive tuples. Regular hyperplanes or other strong deviations confirm the claim despite maximal period.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Some modern high-dimensional parameterizations may evade simple low-dimensional stripe examples.", "“Perfect randomness” is an ideal rather than a finite-test null.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.96"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-07--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-07--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.951"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-07--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Statistical Test Suite";
    dc:description "public randomness-testing software and documentation";
    prov:wasDerivedFrom <https://csrc.nist.gov/projects/random-bit-generation/documentation-and-software>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-07--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TestU01";
    dc:description "public empirical test suite for random number generators";
    prov:wasDerivedFrom <https://simul.iro.umontreal.ca/testu01/tu01.html>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-07--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
