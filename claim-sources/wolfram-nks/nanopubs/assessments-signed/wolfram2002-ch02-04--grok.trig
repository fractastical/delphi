    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
