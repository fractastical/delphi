sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch02-04: partially-resolvable, resolvability 0.32";
    dc:description "The phenomenon of complexity from simple rules is computable, but responsibility for most natural complexity is a causal claim about the world. Public morphology covers a biased slice of biological form and does not record the rules that generated it. Existing material can support scattered lookalike comparisons and cannot confirm or refute the universal causal wording.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Inventory complex natural phenomena, determine the actual rules and initial conditions of each, and test whether most of them are simple rules started from simple states. Confirmation requires that causal inventory. Matching a program's output to a photograph tests only a proxy on a few systems.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Similar-looking complexity is produced by selection and by continuum physics.", "The generative rules of most natural systems are not known.", "There is no agreed catalogue of 'most of the complexity seen in nature.'";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-04--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.316"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-04--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "morphological archive used as a restricted-scope proxy for biological complexity, without the underlying rules";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-04--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "source of simple-program patterns for comparison with natural forms";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-04--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch02-04 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
