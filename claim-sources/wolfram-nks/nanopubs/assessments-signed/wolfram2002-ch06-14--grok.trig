sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch06-14: resolvable-now, resolvability 0.81";
    dc:description "The claim is existential and names rule 30 and rule 22, both of which are trivial to run from simple seeds, with the rule 30 center column already deposited in the OEIS. Standard batteries can confirm the practical randomness the text asserts, or expose a regularity that would undermine the example. They do not prove the absence of every possible pattern, which is why discriminating power is below the operational clarity of the simulation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Generate rule 30 and rule 22 from simple seeds, including one black cell, and apply a standard randomness battery to interior columns and rows. Passage together with no obvious nested or periodic closed form supports the existential claim; a short regular description of those sequences would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A statistical battery can miss a hidden regularity.", "Random here means random under practical tests, which is the standard the book itself uses.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-14--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-14--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.809"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS A051023";
    dc:description "published middle column of rule 30 from a single black cell";
    prov:wasDerivedFrom <https://oeis.org/A051023>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-14--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "generate rule 30 and rule 22 spacetime from simple seeds";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-14--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TestU01";
    dc:description "standard statistical battery for the generated columns";
    prov:wasDerivedFrom <https://simul.iro.umontreal.ca/testu01/tu01.html>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch06-14 by Grok 4.7: 0.9";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
