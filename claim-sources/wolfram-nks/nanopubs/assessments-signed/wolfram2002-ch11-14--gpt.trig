<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-14--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch11-14: resolvable-now, resolvability 0.98";
    dc:description "A published constructive proof directly settles this precise theorem. The proof and rule are public, and representative transitions can be independently simulated with modest resources.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Check the encoding of cyclic tag-system data and productions into rule 110 glider packages and verify that collisions implement each cyclic tag update. Since cyclic tag systems simulate universal Turing machines, a correct construction proves universality.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The construction is intricate but finite and checkable.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.99"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-14--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.985"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
