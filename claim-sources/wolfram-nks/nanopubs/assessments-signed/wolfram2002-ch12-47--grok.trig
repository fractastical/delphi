sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch12-47: partially-resolvable, resolvability 0.54";
    dc:description "Additive rules such as elementary rule 90 and the two-dimensional totalistic rule in the text visibly copy patterns, and simulators make that check routine. Similar exhibitions exist for pattern formation. The step from these examples to almost any proposed feature of life, and to the conclusion that only Earth-like chemical detail counts, is not a result those simulations close.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Take a stated feature, such as self-reproduction, self-organization, or high morphological complexity, and search small cellular automata for a rule that meets a formal criterion for it. Success supports the occurrence claim for that feature; the conclusion about how observers recognize life is a further question.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A feature can be redefined so that the simple system fails it.", "Recognized as life is a human judgment.", "Self-reproduction in an additive rule is a thin case of the biological notion.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-47--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.543"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-47--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "simulator for additive rules such as rule 90 and outer-totalistic code 204, which reproduce patterns, and for other simple self-organizing rules";
    prov:wasDerivedFrom <https://golly.sourceforge.net/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch12-47 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.65"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-47--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
