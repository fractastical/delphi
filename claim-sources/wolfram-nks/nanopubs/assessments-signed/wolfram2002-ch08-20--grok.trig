sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch08-20: partially-resolvable, resolvability 0.50";
    dc:description "It is a short computation to show that small parameter changes in a branching rule swing the outline from smooth to prickly. Matching those outlines to real leaves can be attempted with public images and trait data, but resemblance is a weak test against other developmental models. Existing data do not establish that leaves and whole plants are produced by the same process.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Generate leaf outlines from the same branching-parameter family used for whole-plant form, and compare them with measured leaf contours across smooth, toothed, and lobed species. Recovery of the outline range by small parameter changes would support the geometric half; outlines that stay outside that family, or developmental maps that build the margin by a different process, would count against the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Leaf shape is usually fixed inside the bud by marginal patterning, which is not the same measurement as a stem-substitution rule.", "Outline similarity is produced by several margin-growth models and does not identify the branching process.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-20--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-20--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.503"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-20--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TRY Plant Trait Database";
    dc:description "leaf-trait measurements across many species";
    prov:wasDerivedFrom <https://www.try-db.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-20--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iNaturalist";
    dc:description "photographs of leaf outlines for comparison with branching models";
    prov:wasDerivedFrom <https://www.inaturalist.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-20 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-20--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch08-20 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
