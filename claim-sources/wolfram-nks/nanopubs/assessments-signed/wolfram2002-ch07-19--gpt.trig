sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-19--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch07-19: needs-new-data, resolvability 0.28";
    dc:description "Morphology and phylogeny data exist, but the central causal attribution is generally absent. Retrospective associations cannot cleanly distinguish selection from developmental mechanisms because both jointly shape traits. Resolving the broad claim would require targeted developmental and fitness measurements across many lineages.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Classify biological forms by quantified structural complexity and reconstruct whether each trait arose chiefly through selection on a functional constraint or through developmental growth dynamics. The claim predicts that selection-dominated constraint solutions occupy only the low-complexity range, whereas complex forms trace to explicit developmental rules.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Constraint satisfaction, growth-rule causation, and form complexity are difficult to separate.", "Existing comparative data rarely identify the causal contribution of selection versus development.", "The dichotomy is not exhaustive.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-19--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-19--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.276"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-19--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "public morphological matrices and images for restricted comparative trait analyses";
    prov:wasDerivedFrom <https://morphobank.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-19--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "public phylogenetic synthesis for comparative analyses";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-19--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-19 by GPT-5.6 Sol: 0.3";
