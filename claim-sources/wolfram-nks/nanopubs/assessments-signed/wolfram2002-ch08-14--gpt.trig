sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-14--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-14: needs-new-data, resolvability 0.28";
    dc:description "Selection can be measured in restricted experimental landscapes, but the claimed universal boundary between simple and complex behavior is not specified. Current datasets lack representative organismal coverage and comparable complexity measures. Resolving the principle would require extensive new linked genotype, phenotype, and fitness data.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across traits with mapped genotype-phenotype-fitness relations, quantify behavioral complexity and the response to selection, then test whether selection response approaches zero above a preregistered complexity threshold. Robust optimization of complex-output traits would refute the asserted limit.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Existing fitness landscapes cover a highly biased subset of biological systems.", "Meaningful operation and behavioral complexity lack standard measures.", "Selection response is confounded by mutation supply, population size, and environment.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-14--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.279"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-14--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: ProteinGym";
    dc:description "public empirical fitness landscapes for restricted tests of selection and sequence-function complexity";
    prov:wasDerivedFrom <https://proteingym.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-14--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-14 by GPT-5.6 Sol: 0.28";
