<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-52--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-52: needs-new-data, resolvability 0.15";
    dc:description "Unlike a purely definitional claim, this proposes how humans would recognize real extraterrestrial agents, so it is testable in principle. No existing dataset contains the required cases, and simulations or fictional agents cannot resolve the intended extraterrestrial scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Given authenticated extraterrestrial agents, measure human recognition judgments and behavioral similarity independently of computational capability. Recognition tracking similarity rather than capability would support the claim; reliable recognition of radically dissimilar agents would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Intelligence and human similarity lack independent ground truth.", "No authenticated extraterrestrial intelligence data exist.", "The prediction about generalized intelligence is vague.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.155"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-52--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
