    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-28--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-28: needs-new-data, resolvability 0.46";
    dc:description "Current quantum-hardware data test implementations and noise models, not whether all exponential speedups fail fundamentally. Resolving the physical hypothesis requires qualitatively larger, controlled devices or a new physical theory with discriminating predictions.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define physical scale and error thresholds at which fault-tolerant quantum computation should retain asymptotic speedup, then compare increasingly large devices with classical algorithms and physical-noise models. Sustained error-corrected scaling would count against the claim; a reproducible fundamental breakdown unexplained by engineering limits would support it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Engineering failure cannot establish a fundamental physical limit.", "Present devices are far below asymptotic regimes.", "Ultimate physical reality is not finitely operationalized.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-28--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.464"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-28--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: IBM Quantum";
    dc:description "public quantum hardware access and calibration/results resources for present-scale tests";
    prov:wasDerivedFrom <https://quantum.ibm.com/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-28--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
