sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-21--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch05-21: partially-resolvable, resolvability 0.51";
    dc:description "Both sides of the comparison can be sampled: small template constraints by search, and elementary rules by direct evolution. The sentence is a rate claim about almost all simple constraints, and any finite sample leaves the tail, the complexity cutoff, and the matching of the two ensembles open. It can support or challenge a stated proxy, not the unrestricted quantifier.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fix finite ensembles of small constraints and of small cellular-automaton rules, score each output as repetitive, nested, or complex by pre-registered tests, and compare the two rates. A constraint rate of complex outcomes comparable to the rule rate would challenge the contrast inside those ensembles.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Almost all, simple, and fairly simple each depend on the ensemble and the complexity score.", "Constraint spaces and rule spaces are different sets, so raw rates are not automatically comparable.", "The text already allows rare complex constraints, so only the rate is at issue.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.67"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-21--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.512"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-21--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "enumerate and evolve the simple cellular-automaton rules used as the comparison class";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-21--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: A New Kind of Science online";
    dc:description "the constraint families whose simple cases are claimed to produce mostly simple patterns";
    prov:wasDerivedFrom <https://www.wolframscience.com/nks/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-21--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch05-21 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-21--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-21--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch05-21 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-21--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-21--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch05-21 by Grok 4.7: 0.68";
