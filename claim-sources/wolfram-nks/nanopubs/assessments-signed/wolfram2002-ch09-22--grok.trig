    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-22--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of wolfram2002-ch09-22 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
