sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch07-06: resolvable-now, resolvability 0.82";
    dc:description "Modern ephemerides and numerical integrators directly test million-year sensitivity and provide adequate initial-state constraints. The explanatory link to particular current features is less decisive, but the central prediction is resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Integrate ensembles of high-precision Solar System initial conditions drawn from observational covariance, estimate Lyapunov times and divergence over millions of years, and compare resulting orbital distributions with present dynamical features. Lack of exponential divergence would refute the sensitive-dependence component.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Chaos does not by itself identify the origin of present-day features.", "Long integrations require specialist numerical controls.", "Rare close encounters amplify model uncertainty.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-06--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-06--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: JPL HORIZONS";
    dc:description "public high-precision Solar System ephemerides and initial conditions";
    prov:wasDerivedFrom <https://ssd.jpl.nasa.gov/horizons/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-06--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NASA Planetary Data System";
    dc:description "public planetary observations and dynamical data";
    prov:wasDerivedFrom <https://pds.nasa.gov/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-06--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-06 by GPT-5.6 Sol: 0.54";
