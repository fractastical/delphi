sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-17--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch11-17: partially-resolvable, resolvability 0.45";
    dc:description "Universality is settled for rule 110 and for some two-dimensional class-4 rules such as the Game of Life, so particular cases are checkable. The claim is about every class-4 rule, and each new proof is a research project rather than a standard analysis. A single rigorously non-universal class-4 rule would refute it, but no such classification exists for the class as a whole.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define class 4 by persistent, interacting, localized structures on a quiescent or periodic background. Confirm the claim only if every such rule has a universality proof, and refute it by one class-4 rule proved incapable of emulating a Turing machine.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Class 4 is diagnosed from pictures, so borderline rules can be labeled either way.", "Not finding a glider computer does not prove that a class-4 rule is not universal.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-17--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.445"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-17--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cook 2004, Universality in Elementary Cellular Automata";
    dc:description "completed universality proof for the class-4 rule 110";
    prov:wasDerivedFrom <https://doi.org/10.25088/complexsystems.15.1.1>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-17--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "pattern collection and simulator for other class-4 rules, including the Game of Life";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-17--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch11-17 by Grok 4.7: 0.25";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.25"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-17--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-17--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
