    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-29: partially-resolvable, resolvability 0.63";
    dc:description "Prices, order flow, and some external events are directly measurable, and substantial market data exist. Fully public high-resolution coverage is limited, while unobserved information prevents a clean classification of all shocks. Current resources can estimate endogenous shares for selected markets and periods, not settle the broad claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Align high-frequency trade and quote changes with timestamped public news and scheduled information releases, then decompose short-horizon price variance using market-interaction models and exogenous-event controls. A dominant residual attributable to endogenous order-flow feedback would support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Comprehensive high-frequency order books are often paid rather than openly downloadable.", "Unobserved private information and news confound endogenous attribution.", "Variance decomposition depends on the causal market model.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-29--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.627"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-29--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SEC EDGAR";
    dc:description "public timestamped company filings for observed external information events";
    prov:wasDerivedFrom <https://www.sec.gov/edgar>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-29--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
