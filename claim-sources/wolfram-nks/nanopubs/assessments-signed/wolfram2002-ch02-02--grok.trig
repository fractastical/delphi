sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch02-02: resolvable-now, resolvability 0.88";
    dc:description "The rule, the initial condition, and the rejected alternatives (uniform, repetitive, nested) are explicit, and the pattern is trivial to recompute. Known local regularities, which the source text also notes, keep the phrase 'almost no overall regularity' from being a sharp predicate. A classifier aimed at the three simple forms can still confirm or refute the claim as stated.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Generate rule 30 from a single black cell for a large number of steps and test it for global periodicity, nesting, and compressibility. The claim is confirmed if the pattern is not uniform, periodic, or nested, and refuted if a short exact description of that kind fits the whole space-time diagram.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Failure of a finite list of regularity tests does not prove that no global regularity exists.", "The left side has persistent diagonal bands and the right edge is periodic, so 'almost no overall regularity' is a threshold judgment.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-02--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "simulator for regenerating the rule 30 space-time pattern from one black cell";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS A051023";
    dc:description "published center column of rule 30, an independently tabulated slice of the same evolution";
    prov:wasDerivedFrom <https://oeis.org/A051023>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch02-02 by Grok 4.7: 0.95";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.95"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
