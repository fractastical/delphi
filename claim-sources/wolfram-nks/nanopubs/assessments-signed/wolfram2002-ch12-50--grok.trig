sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-50--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch12-50: needs-new-data, resolvability 0.28";
    dc:description "Radio surveys publicly archive astronomical emission and the results of narrowband searches. They do not contain messages identified as extraterrestrial communications, which is the variable the prediction concerns. Until such a corpus exists, a noise-like recording fits both the claim and the hypothesis that the recording is natural.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On signals independently known to be communications of a non-human technological civilization, measure repetition, spectral lines, and compressibility. Essentially no detectable regularities would support the claim for ongoing traffic; stable recognizable carriers in that traffic would refute it. Beacons meant to be noticed are excluded and scored separately.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A noise-like spectrum is the prediction both for compressed messages and for ordinary astrophysical emission.", "No confirmed extraterrestrial communication corpus exists.", "The beacon exception makes non-detection of carriers compatible with the claim.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.56"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-50--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-50--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.277"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-50--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Breakthrough Listen";
    dc:description "public radio search for narrowband technosignatures, which archives emission and non-detections rather than confirmed extraterrestrial messages";
    prov:wasDerivedFrom <https://breakthroughinitiatives.org/initiative/1>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-50--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Berkeley SETI Research Center";
    dc:description "public description and data access for radio SETI surveys, including Breakthrough Listen";
    prov:wasDerivedFrom <https://seti.berkeley.edu/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-50--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch12-50 by Grok 4.7: 0.2";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.2"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-50--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-50--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
