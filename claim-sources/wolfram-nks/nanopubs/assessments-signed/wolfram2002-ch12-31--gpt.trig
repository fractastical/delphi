<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-31--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-31: resolvable-now, resolvability 0.85";
    dc:description "Under explicit effectiveness assumptions, this is a standard proof-level implication and can be formally checked now. Its validity hinges on distinguishing irreducibility from undecidability, but that ambiguity can be exposed rather than requiring new observations.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Formalize reachability, negation, consistency, completeness, and effective enumeration for the multiway axiom system. Prove that complete consistency supplies a terminating parallel search for each statement or its negation, contradicting undecidability, or provide a countermodel violating an assumption.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Computational irreducibility alone does not imply undecidability.", "The result requires effective negation and enumeration assumptions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-31--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.852"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
