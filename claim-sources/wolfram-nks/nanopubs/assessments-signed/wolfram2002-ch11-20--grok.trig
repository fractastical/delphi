    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-20--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-20--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
