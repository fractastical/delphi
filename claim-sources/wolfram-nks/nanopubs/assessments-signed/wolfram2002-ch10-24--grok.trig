sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-24--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch10-24: partially-resolvable, resolvability 0.47";
    dc:description "The comparison is meaningful once recognition is tied to recovery of a known generator, and public libraries document the methods one would test. No existing catalog already classifies those methods by the Wolfram hierarchy of repetition, nesting, and beyond, so the test covers a curated subset rather than every method in use. Human perception and the phrase almost nothing more complex remain judgment calls, which keeps the outcome from deciding the claim at its stated scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fix a catalog of methods in routine scientific use and a test suite of sequences with known generators (periodic, nested substitution, and non-nested such as a cellular automaton). A method counts as recognizing a class if it recovers that generator under a pre-registered criterion. The claim is challenged if many practical methods recover non-nested generators, and supported only if almost all stop at repetition or nesting.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A failed test shows only that a particular procedure missed a regularity, not that no practical method could detect it.", "What counts as practical use, as recognizing a pattern, and as more complex than nesting can be drawn in several incompatible ways.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-24--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-24--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.473"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-24--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST/SEMATECH e-Handbook of Statistical Methods";
    dc:description "public inventory of statistical procedures in practical use, to classify which regularities they are built to detect";
    prov:wasDerivedFrom <https://www.itl.nist.gov/div898/handbook/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-24--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: scikit-learn";
    dc:description "open library of widely used analysis methods, to test on planted periodic, nested, and non-nested patterns";
    prov:wasDerivedFrom <https://scikit-learn.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-24--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch10-24 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-24--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-24--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch10-24 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
