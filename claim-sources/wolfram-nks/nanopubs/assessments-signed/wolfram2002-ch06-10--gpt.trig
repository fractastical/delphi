    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch06-10: partially-resolvable, resolvability 0.44";
    dc:description "Selected systems can be analyzed using existing time series, making restricted predictive tests possible. The unrestricted explanatory claim lacks fixed outcomes and would remain confounded by competing coarse-grain descriptions.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For a prespecified natural-system domain, estimate memory decay, perturbation localization, and information-transfer range from open time-series data, then test whether four information-handling profiles predict held-out system features better than alternative summaries.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cellular-automaton analogy may not distinguish causal models.", "Observed information flow depends on scale and measurement.", "“Natural systems” and “important features” are unspecified.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-10--gpt--dataset-2>;
