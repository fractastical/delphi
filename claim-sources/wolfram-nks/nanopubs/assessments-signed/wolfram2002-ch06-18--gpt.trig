    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate block encodings up to a fixed width for cellular-automaton pairs and verify the commuting relation between encoded evolution and the emulated rule. Report the proportion of source rules with at least one nontrivial emulation and reproduce the rule 126-to-90 example.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Trivial encodings must be excluded explicitly.", "Unbounded block widths cannot be exhaustively searched.", "“Common” requires a measure over rules and encodings.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-18--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.767"^^xsd:double;
