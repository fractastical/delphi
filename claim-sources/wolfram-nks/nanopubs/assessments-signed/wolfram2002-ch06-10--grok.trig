<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch06-10: not-empirically-resolvable, resolvability 0.25";
    dc:description "The sentence is a general claim about natural systems and does not specify which systems or which measurements carry the class correspondence. Observational archives contain many series that could be narrated in those terms, and also in rival terms, without a deciding contrast. As stated, the sentence has no discriminating consequence.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/none";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: The sentence says important features of natural systems can be read off a correspondence with cellular-automaton information flow. It names neither the systems, the features, nor the measurement that would confirm or refute the correspondence.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A program that looks similar is not a test of a natural system.", "Most important features and the class correspondence are not fixed observables.", "Other classifications fit the same natural phenomena.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.253"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "not-empirically-resolvable".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
