<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-19--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch11-19: resolvable-now, resolvability 0.76";
    dc:description "Under the bounded-information interpretation stated in the claim, a clean impossibility proof is available. Ambiguity in assigning all cellular automata to phenomenological classes slightly weakens full-scope certainty.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Give rigorous dynamical definitions of class 1 and class 2 with bounded information propagation, then prove that their bounded communication or eventual periodicity cannot implement arbitrarily large universal computations.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Some formal definitions of class 2 may not imply a uniform propagation bound.", "Wolfram classes are phenomenological rather than uniquely formal.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-19--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.762"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
