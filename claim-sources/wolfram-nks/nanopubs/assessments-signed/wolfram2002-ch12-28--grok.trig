    <https://w3id.org/delphi/ontology/hasScore> "0.3"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-28--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-28--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
