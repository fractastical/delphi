sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-32--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch12-32: partially-resolvable, resolvability 0.69";
    dc:description "The named positive and negative cases are classical theorems, and proof libraries contain formalizations of several of them. The sentence also says that every axiom system in actual research use, outside a list of heavily constrained exceptions, is universal. There is no canonical public census of that class, so the theorems settle the examples and leave the quantifier partly checked.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For each named system, use a published proof or decision procedure: propositional logic and pure monadic predicate logic are decidable, arithmetic and set theory interpret computation, the word problem for groups is undecidable, and Tarski's real algebra and elementary geometry are decidable. The clause about every system used in research is scored only relative to an explicit list of fields.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The exceptions for commutative groups, real algebra, and geometry have to be applied uniformly.", "Universality is proved theory by theory, so the universal quantifier needs a census.", "Used in current research is a sociological boundary rather than a formal list.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-32--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-32--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.687"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-32--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Metamath Proof Explorer";
    dc:description "formalized developments of logic, arithmetic, and set theory used to check which standard systems interpret computation";
    prov:wasDerivedFrom <https://us.metamath.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-32--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TPTP";
    dc:description "public collection of axiom systems across mathematical domains, a partial census of systems in actual formal use";
    prov:wasDerivedFrom <https://www.tptp.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-32--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch12-32 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-32--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-32--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
