<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-08--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch05-08: partially-resolvable, resolvability 0.64";
    dc:description "The mathematical contrast between context-free and context-sensitive replacement can be tested and partly proved. The causal historical assertion about an entire field and all its patterns is too broad for existing literature coverage to resolve completely.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Survey formal fractal constructions for context dependence, prove nesting for context-free replacements, and computationally compare them with matched neighbor-dependent systems using hierarchy and complexity measures. Counterexamples from traditional fractal geometry with interacting elements would refute the historical taxonomy.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Misses complexity is evaluative.", "Neighbor dependence is sufficient for some non-nested outputs but not necessary for all notions of complexity.", "Traditional fractal geometry is historically broad and not a formal class.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-08--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.636"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
