<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch07-02: not-empirically-resolvable, resolvability 0.28";
    dc:description "External noise, transcribed initial conditions, and no random input are a logical trichotomy about where randomness enters a model. Any system can be placed in one bin once that modeling choice is made, so the census cannot come out against the sentence. The pictures illustrate the bins; they do not test whether the bins are exhaustive.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/none";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Sort systems by whether randomness is inserted at every step, only in the initial condition, or not at all. Every system falls in one of those three bins by construction, so the partition does not state an additional outcome that could fail.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No observation distinguishes this partition from itself restated in other words.", "The three mechanisms partition systems by where randomness is inserted.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.282"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "not-empirically-resolvable".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-02 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
