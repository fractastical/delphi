sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-08--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch10-08: partially-resolvable, resolvability 0.86";
    dc:description "The named algorithm families and pattern classes are straightforward to test with public software and generated data. Full resolution is blocked by the universal claim over structurally different and future compression methods.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Generate uniform, periodic, nested, and complex patterns from known short rules, compress them with representative lossless algorithm families, and compare normalized compressed sizes. Substantial compression of complex behavior by any included general method would refute the asserted common limitation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Essentially every method' is open-ended.", "Compression ratios depend on encoding and finite sample size.", "Specialized compressors can exploit known generators.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.87"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-08--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.857"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-08--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Atlas of Simple Programs";
    dc:description "public generated patterns covering multiple behavior classes";
    prov:wasDerivedFrom <https://atlas.wolfram.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-08--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Large Text Compression Benchmark";
    dc:description "public compression benchmark, corpora, and comparative results";
    prov:wasDerivedFrom <https://www.mattmahoney.net/dc/text.html>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-08--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch10-08 by GPT-5.6 Sol: 0.9";
