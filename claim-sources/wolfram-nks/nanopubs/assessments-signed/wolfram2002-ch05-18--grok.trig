sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch05-18: partially-resolvable, resolvability 0.65";
    dc:description "Constraint 18762389 is explicitly described, and its nested coloring can be checked against the twelve templates in weeks. The claim also says it is the first such constraint after more than 18 million trials and that the coloring is the only one, which is a large search plus an infinite-grid uniqueness argument. Public material settles the single picture much more readily than the priority and uniqueness clauses.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct the book's numbering, force constraint 18762389 from its required template, and test whether the resulting coloring is the published base-2 nested pattern and whether any earlier constraint already has no repetitive solution. An earlier aperiodic example, or a second infinite coloring, would refute the corresponding clause.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Showing this constraint is first requires the same standard on more than 18 million predecessors.", "The numbering scheme has to be reconstructed before the index can be audited.", "Uniqueness on the infinite grid needs a forcing argument, not only a finite picture.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-18--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.648"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: A New Kind of Science online";
    dc:description "templates, numbering, and the published nested coloring for constraint 18762389";
    prov:wasDerivedFrom <https://www.wolframscience.com/nks/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-18--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SageMath";
    dc:description "exact arithmetic and search over small template sets while checking periodic candidates";
    prov:wasDerivedFrom <https://www.sagemath.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch05-18 by Grok 4.7: 0.42";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.42"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-18--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-18--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
