    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-19--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-19: resolvable-now, resolvability 0.99";
    dc:description "An elementary identity directly establishes that the symbolic itinerary contains no digits absent from the initial condition. The formal content is completely resolvable by proof and clearly distinguishes transcription from creation under the stated meaning.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Write x in binary and prove that x maps to 2x modulo 1 by deleting its leading binary digit at every iteration. Any irregular output itinerary is therefore exactly a suffix of the initial digit sequence, apart from the conventional ambiguity of dyadic rationals.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dyadic rationals have two binary expansions.", "The phrase generates randomness is interpretive, though the digit-shift identity is exact.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.98"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-19--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.986"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-19--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Digital Library of Mathematical Functions";
    dc:description "public reference for positional representations and elementary functions";
    prov:wasDerivedFrom <https://dlmf.nist.gov/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-19--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
