sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch10-20: partially-resolvable, resolvability 0.45";
    dc:description "Existing task data can assess memory involvement in selected forms of reasoning. They cannot establish that retrieval underlies almost every major aspect of thought or that logic is never a distinct computational mechanism.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across reasoning, analogy, generalization, and intuition tasks, test whether trial-level behavior and neural activity are predicted by retrieval of learned episodes after controlling for explicit rule use and working memory. Selective disruption or absence of retrieval signatures would challenge restricted versions.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Neural correlates do not establish causal primacy.", "Retrieval and rule application are not mutually exclusive.", "The claim quantifies over almost all thinking.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.446"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OpenNeuro";
    dc:description "public neuroimaging and behavioral datasets spanning memory and reasoning tasks";
    prov:wasDerivedFrom <https://openneuro.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-20--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Human Connectome Project Young Adult";
    dc:description "public imaging and behavioral measures for selected cognitive domains";
    prov:wasDerivedFrom <https://www.humanconnectome.org/study/hcp-young-adult>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-20--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch10-20 by GPT-5.6 Sol: 0.4";
