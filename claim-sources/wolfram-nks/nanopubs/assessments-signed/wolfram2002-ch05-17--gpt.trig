    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-17--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.517"^^xsd:double;
