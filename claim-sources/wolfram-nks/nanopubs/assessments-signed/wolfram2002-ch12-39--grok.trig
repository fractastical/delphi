sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-39--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch12-39: resolvable-now, resolvability 0.84";
    dc:description "Under a fixed-point-free length-preserving negation, strings come in pairs, so generating more than half forces a string and its negation, and generating less than half leaves some pair untouched. That is a short combinatorial argument and can be formalized with standard tools. The criterion for this class of multiway systems is therefore settleable by proof now; computing the fraction for one irreducible rule is a different and often undecidable question.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fix a length-preserving involution as negation and prove or refute that a multiway system is complete and consistent exactly when it eventually generates half the strings of each length from the string for true. A counterexample involution, or a gap in the pairing argument, refutes the biconditional; a checked proof confirms it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "An involution with fixed points breaks the identification of exactly half with completeness plus consistency.", "For a concrete rule, the eventual fraction of strings may itself be undecidable; the general implication is what the proof settles.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-39--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.836"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-39--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Metamath Proof Explorer";
    dc:description "formal logic library in which the pairing argument about negation, consistency, and completeness can be machine-checked";
    prov:wasDerivedFrom <https://us.metamath.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-39--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch12-39 by Grok 4.7: 0.9";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.9"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-39--grok>.
