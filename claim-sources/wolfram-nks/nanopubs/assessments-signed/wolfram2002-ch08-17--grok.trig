    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-17--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-17--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
