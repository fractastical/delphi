    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch09-16: partially-resolvable, resolvability 0.56";
    dc:description "The information-theoretic claim can be tested or proved in specified discrete systems. The extrapolation to observers in the universe and subjective perception is not resolved by those computations alone.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In explicit asynchronous automata, compare all admissible update orders and determine whether embedded agents with only local records can infer the order beyond the event partial order. Order-invariant observations support the model claim; an accessible observable that distinguishes schedules refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "An embedded observer's information access must be stipulated.", "Perceived time is partly phenomenological.", "Results in toy systems do not establish how physical observers perceive time.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-16--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.562"^^xsd:double;
