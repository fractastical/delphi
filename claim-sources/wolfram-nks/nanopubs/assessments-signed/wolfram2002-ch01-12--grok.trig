sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch01-12: partially-resolvable, resolvability 0.52";
    dc:description "Published universality shows that some sophisticated computations have very small rule tables, so the existential reading is checkable now. The claim that extremely simple rules are often all that engineering needs, and that they are implementable directly at atomic scale, ranges over technology that has not been catalogued in that form. Existing proofs therefore settle a weakened reading and leave the practical frequency open.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Take a list of sophisticated computational tasks and ask whether each has an implementation whose rule text is short, with task complexity counted separately from the initial condition. The weak reading is confirmed by one universal one-sentence rule. The engineering reading, including atomic-scale implementation, needs a demonstrated device whose physical rule, not only its abstract encoding, is extremely simple.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A universal rule shifts the task's complexity into the initial condition.", "Atomic-scale implementation is an engineering prediction without a systematic public inventory of such devices.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-12--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.517"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-12--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cook 2004, Universality in Elementary Cellular Automata";
    dc:description "proof that a one-sentence cellular-automaton rule can emulate arbitrary computation";
    prov:wasDerivedFrom <https://doi.org/10.25088/complexsystems.15.1.1>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch01-12--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "simulator used to inspect simple rules that carry out definite computational tasks";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch01-12 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch01-12 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch01-12--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch01-12 by Grok 4.7: 0.65";
