sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch02-15: partially-resolvable, resolvability 0.43";
    dc:description "Museum catalogs and digitized technical literature can establish when graphics-capable machines made large rule surveys cheap. That tests the technological timeline. The claim that this absence was a main reason the phenomenon stayed unseen is confounded with the conceptual factors the same passage mentions, and those factors are not separated by the hardware record.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Date the availability of interactive computers able to display large cellular-automaton surveys, and compare that date with the late-1970s and 1980s explorations. The chronology can support or weaken the technology clause. It cannot by itself show that missing computers were a main reason, as opposed to missing motivation to look.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A main reason is a causal claim confounded with the lack of a reason to run the experiments.", "Some relevant machines and manual explorations predate the 1980s, so the cutoff is graded.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-15--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.428"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Computer History Museum";
    dc:description "public record of historical computing hardware used to date when large exploratory simulations became practical";
    prov:wasDerivedFrom <https://computerhistory.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-15--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Internet Archive";
    dc:description "digitized contemporary computing literature bearing on what experiments were feasible before the 1980s";
    prov:wasDerivedFrom <https://archive.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch02-15 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-15--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-15--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
