    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-12: partially-resolvable, resolvability 0.70";
    dc:description "Digits can be generated accurately for many examples and examined with standard methods. Existing computation cannot cover every integer or establish asymptotic randomness, so the universal statement is only partially resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Sample non-square integers under declared schemes, compute long expansions of their square roots in specified bases, and apply a fixed battery of randomness tests. Counterexamples refute the universal appearance claim, while passing samples support only bounded ranges and tests.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Every non-square integer is an infinite scope.", "Normality is unknown for individual algebraic irrationals.", "Random appearance depends on base, sample length, and test.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-12--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.705"^^xsd:double;
