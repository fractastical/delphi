    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-15--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch07-15: partially-resolvable, resolvability 0.47";
    dc:description "Multistability and discrete transitions can be measured in continuous models, but commonness and model appropriateness require sampling and task definitions not supplied by the claim. BioModels supports a restricted survey. Predictive equivalence also does not establish that a discrete model is uniquely most appropriate.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compile continuous dynamical models and measured natural systems, identify attractors and transition states, and estimate how often a small discrete state model predicts held-out trajectories as well as continuous alternatives. Frequent finite-state dynamics and superior predictive performance would support the claim; prevalent irreducibly continuous observables would oppose it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Appropriate is a purpose-dependent modelling judgment.", "Published model repositories are not representative samples of natural systems.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-15--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.475"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-15--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "public curated dynamical models, including biochemical reaction systems with continuous kinetics";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biomodels/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-15--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-15 by GPT-5.6 Sol: 0.55";
