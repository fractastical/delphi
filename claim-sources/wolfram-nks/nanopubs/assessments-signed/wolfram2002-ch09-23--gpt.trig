<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-23--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch09-23: partially-resolvable, resolvability 0.68";
    dc:description "High-quality mass measurements exist and proposed relations are easy to check. They cannot by themselves separate intrinsic mass from interaction energy or prevent flexible post hoc numerology, so only model-specific versions are resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit specified simple integer or algebraic mass relations to renormalized particle-mass estimates under a defined theory of interaction energy, with penalties for relation complexity and multiple testing. Stable predictive relations would support the claim; failure across justified decompositions would weaken it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Truly fundamental mass' is model-dependent.", "Quark masses depend on renormalization scheme and scale.", "Simple ratios can be found post hoc among many possibilities.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-23--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
