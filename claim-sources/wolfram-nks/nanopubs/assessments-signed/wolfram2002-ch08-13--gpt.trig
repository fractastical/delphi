<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-13--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch08-13: partially-resolvable, resolvability 0.50";
    dc:description "Public mollusc genomes and transcriptomes can identify candidate pigmentation components in some species. Demonstrating a complete minimal program normally requires perturbation and developmental data that are uneven or absent. Existing data can estimate program size only for selected systems.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Identify cis-regulatory and coding loci causally required for shell pigmentation through expression, perturbation, and segregation evidence, then measure the minimal sequence and regulatory-network description sufficient to recreate pattern classes. Long indispensable programs or highly distributed control would refute the brevity claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Functional genomic coverage of shell-pattern diversity is sparse.", "Sequence association does not identify the complete causal program.", "Short lacks an explicit unit and threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-13--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-13--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.501"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-13--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Gene";
    dc:description "public gene records and linked sequence and functional evidence for pigmentation genes";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/gene/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-13--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "public genomic and transcriptomic sequencing data from molluscs";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-13--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
