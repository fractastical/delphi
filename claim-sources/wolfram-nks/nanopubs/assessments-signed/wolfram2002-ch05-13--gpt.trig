    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-13--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch05-13: partially-resolvable, resolvability 0.60";
    dc:description "Periodicity and growth can be defined precisely after interpretive choices, and simulations can cover many small systems. Existing computation cannot establish the open-ended typicality and eventuality as stated.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate bounded simple multiway systems with subexponential state-count growth and test their count sequences for eventual periodicity up to increasing horizons. Counterexamples within the enumerated class refute the bounded version, while confirmation remains horizon-dependent.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Long transients can mimic nonperiodicity.", "No finite simulation proves eventual repetition.", "“Typically” lacks a rule-sampling distribution.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-13--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.601"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
