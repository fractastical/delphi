sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-23--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch06-23: partially-resolvable, resolvability 0.49";
    dc:description "Spaceship searches are standard and, for Life and rule 110, already public, so particular rules can be shown to have moving objects. The sentence is an implication with an adjustable antecedent, sufficiently complicated, and an unbounded search, eventually. A finite census can add examples; it cannot close the implication or refute it by failing to find a spaceship.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In each class 4 rule with a known stationary object above a declared size, search larger seeds for a spaceship. A moving object supports the implication for that rule; a completeness proof that only stationary objects exist would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Eventually sets no search bound, so a negative census is inconclusive.", "Sufficiently complicated can be raised after a stationary-only example.", "The supporting evidence is experience with many rules, not a defined sample.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-23--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-23--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.492"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-23--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Golly";
    dc:description "search for moving localized structures in rule 110 and other class 4 rules";
    prov:wasDerivedFrom <https://golly.sourceforge.io/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch06-23--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Catagolue";
    dc:description "censuses that separate still lifes, oscillators, and spaceships in Life-like rules";
    prov:wasDerivedFrom <https://catagolue.hatsya.com/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-23--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch06-23 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-23--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch06-23--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch06-23 by Grok 4.7: 0.4";
