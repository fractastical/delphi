<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-50--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-50: needs-new-data, resolvability 0.45";
    dc:description "Public SETI observations allow method comparisons and tests on noise or simulated injections, but contain no labeled advanced communication. The central prediction therefore needs a genuine signal or other new empirical evidence.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Apply preregistered compression and statistical-randomness tests to candidate extraterrestrial signals and compare detection sensitivity of narrowband versus structure-agnostic searches. Confirming the claim requires authenticated advanced communications; a verified communication with strong exploitable regularity would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Compression depends on sender-receiver side information and channel constraints.", "Failure to detect regularity cannot prove its absence.", "No extraterrestrial communication has been authenticated.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-50--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.448"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
