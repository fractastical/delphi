    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-53--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-53: partially-resolvable, resolvability 0.34";
    dc:description "Existing patent and technology records can test whether selected design families dominate traditional engineering. They cannot quantify a fraction of an undefined possibility space or resolve the prediction of vast future technology.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define a generative space of engineering processes, classify patented or deployed technologies within it, and measure coverage and predictability; prospectively track technologies derived from searched simple rules. Restricted coverage estimates and successful novel devices test parts, but not the space of all possible systems.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Future technological possibility cannot be resolved from current records.", "Patents are a biased proxy for engineering practice.", "There is no canonical measure over possible systems.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-53--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.344"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch12-53--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Google Patents Public Datasets";
    dc:description "public patent records for a proxy census of explored engineering designs";
    prov:wasDerivedFrom <https://console.cloud.google.com/marketplace/product/google_patents_public_datasets/google-patents-public-data>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-53--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
