sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch10-05: partially-resolvable, resolvability 0.55";
    dc:description "Standard test suites and large sequence archives exist, and enumerating very short programs is feasible. That can estimate how often a further short program finds structure after a few standard tests fail, for a bounded class. It cannot cover every simple program, so the claim's unrestricted rarity statement stays only partly tested.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Take sequences and images that pass a fixed set of standard tests, then enumerate simple programs up to a length cutoff and measure how often another program detects a regularity. A high rate of extra detections would refute 'extremely rare'; a near-zero rate inside the cutoff supports the claim only inside that cutoff.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A regularity can be invisible to every test in a chosen finite set without being absent.", "The space of simple programs is unbounded, so 'any other simple program' can be searched only up to a size limit.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-05--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.548"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NIST Random Bit Generation";
    dc:description "public statistical test suites corresponding to standard regularity checks";
    prov:wasDerivedFrom <https://csrc.nist.gov/projects/random-bit-generation>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch10-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OEIS";
    dc:description "public sequences that can be screened by standard tests and by further short programs";
    prov:wasDerivedFrom <https://oeis.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch10-05 by Grok 4.7: 0.46";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.46"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch10-05 by Grok 4.7: 0.44";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.44"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch10-05--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch10-05 by Grok 4.7: 0.7";
