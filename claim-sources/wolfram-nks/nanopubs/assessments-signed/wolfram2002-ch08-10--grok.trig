sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch08-10: partially-resolvable, resolvability 0.40";
    dc:description "Search cost on hard discrete constraints can be measured, and a trillion evaluations is a concrete budget for a simulation study of modest landscapes. Organismal fitness landscapes for complex traits are not a public dataset, so the conclusion that most features are merely good enough is not resolved by the computational analogy. The claim splits into a testable search statement and an unmeasured biological inference.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Run iterative random search for a fixed budget of about 10^12 evaluations on constraint landscapes graded by complexity, and compare the residual to the optimum. Rapid success only on simple landscapes would support the computational half. Calling organismal traits good enough rather than optimal further requires a measured fitness landscape, which this budget alone does not supply.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Biological search is not a uniform random walk: recombination, population structure, and developmental bias change the effective budget.", "Significant complexity and good enough are not defined for real organisms.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-10--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.398"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch08-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SAT Competition benchmarks";
    dc:description "public hard constraint instances used to measure how far iterative search remains from a solution";
    prov:wasDerivedFrom <https://satcompetition.github.io/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch08-10 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-10--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch08-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch08-10 by Grok 4.7: 0.3";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
