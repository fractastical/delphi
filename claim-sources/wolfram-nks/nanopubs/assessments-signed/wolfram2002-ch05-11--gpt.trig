    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch05-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch05-11: needs-new-data, resolvability 0.31";
    dc:description "Substantial public physical data exist, but the claim names an unrestricted family rather than a predictive theory. A concrete member could be tested now in part; establishing a close relation to fundamental spacetime likely requires both model specification and presently unavailable discriminating observations.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Specify a particular network dynamics that derives quantitative predictions differing from general relativity and quantum-field alternatives, then compare them with cosmological, gravitational-wave, and particle observations. Confirmation requires distinctive successful predictions; disagreement would refute that model.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Many network models can be adjusted to reproduce known effective spacetime.", "No specific network model or unique observational prediction is stated.", "Relevant discriminating signatures may lie beyond current energies and resolutions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-11--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.306"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-11--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: LIGO Open Science Center";
    dc:description "public gravitational-wave observations for testing concrete spacetime models";
    prov:wasDerivedFrom <https://gwosc.org/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch05-11--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
