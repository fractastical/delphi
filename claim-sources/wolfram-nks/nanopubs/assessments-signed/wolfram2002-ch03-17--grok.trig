sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-17--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch03-17: resolvable-now, resolvability 0.77";
    dc:description "The claim is an existence claim about a fully specified class of rewrite systems, and both the rules in the book and a wider sample of short rules can be rerun exactly. Non-stabilizing growth together with a failed periodicity check is a direct confirming outcome, and universal stabilization in the searched class would refute it. The only soft spot is how strongly a finite sample supports 'often,' which is not required to settle the stated 'can.'";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate small combinator-style rules of the form e[x_][y_] to an expression in x and y, iterate them from a fixed seed, and record whether expression size stabilizes, becomes periodic or nested, or keeps growing while passing randomness tests. A single non-stabilizing, statistically irregular example confirms the claim; every small rule stabilizing or becoming nested would refute it inside that rule bound.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The frequency word 'often' depends on how the space of expressions is enumerated.", "Visual or statistical irregularity does not prove that a particular rule never eventually stabilizes.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-17--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-17--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Engine";
    dc:description "run the symbolic replacement rules in the form Wolfram states and record expression size";
    prov:wasDerivedFrom <https://www.wolfram.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch03-17--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Python";
    dc:description "enumerate small rewrite rules and test growth and statistical irregularity of the expression sizes";
    prov:wasDerivedFrom <https://www.python.org/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-17--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch03-17 by Grok 4.7: 0.85";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-17--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-17--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch03-17 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-17--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch03-17--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of wolfram2002-ch03-17 by Grok 4.7: 0.85";
