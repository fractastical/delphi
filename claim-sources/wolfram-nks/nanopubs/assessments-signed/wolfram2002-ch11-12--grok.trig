sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch11-12: resolvable-now, resolvability 0.78";
    dc:description "For the families actually constructed in the chapter, mutual emulation is a chain of explicit reductions, and the Church-Turing equivalence says they determine the same class of computations. The constructions are public and finite. The word essentially leaves the boundary of the class slightly soft, but not soft enough to block a check of the systems named.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/proof";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For the named families, check mutual emulation of a universal member. Confirm if each family can realize exactly the Turing-computable input-output maps; refute if some named family computes a non-Turing function or cannot emulate a Turing machine.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Equivalence of computable functions does not settle equivalence of runtime, or of behavior from typical initial conditions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-12--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-12--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Stanford Encyclopedia of Philosophy, Church-Turing thesis";
    dc:description "statement of the equivalence of the standard universal models";
    prov:wasDerivedFrom <https://plato.stanford.edu/entries/church-turing/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch11-12--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: UniversalityDB";
    dc:description "formalized simulation edges among Turing machines, tag systems, and cellular automata";
    prov:wasDerivedFrom <https://github.com/WolframInstitute/UniversalityDB>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch11-12 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
