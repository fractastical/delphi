    <https://w3id.org/delphi/ontology/hasScore> "0.65"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch11-12--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
