<https://w3id.org/delphi/resource/assessment/wolfram2002-ch12-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch12-03: partially-resolvable, resolvability 0.39";
    dc:description "Existing theory and experiments can reject specific hypercomputer designs based on infinite precision, energy, or time. They cannot decisively prove the unrestricted physical Church-Turing thesis.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Specify hypercomputation models and identify their required physical resources, then compare those requirements with tested physical laws and bounds. A reproducible physical device computing a formally non-Turing-computable function would refute the claim; existing physics can exclude particular proposals.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Hypercomputation cannot be certified from finitely many input-output trials alone.", "No finite set of observations covers every constructible system in the universe.", "The inference depends on extrapolating physical laws to untested regimes.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.393"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
