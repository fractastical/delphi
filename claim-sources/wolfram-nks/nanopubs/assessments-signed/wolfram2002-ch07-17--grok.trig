sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch07-17: partially-resolvable, resolvability 0.65";
    dc:description "Jagged landscapes and trapping of downhill search are directly measurable on public constraint benchmarks, and those experiments are routine. A claim that no acceleration works across broad classes cannot be closed by any finite comparison, and the step from that fact to natural systems is an analogy rather than a dataset. The computational core is testable; the full conclusion is not settled by it.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On a broad sample of discrete constraint problems, run strict downhill search, neutral-or-downhill search, and standard accelerated heuristics, and record residual violation and time to a solution. Near-universal trapping of downhill search, with only slow gains from added randomness and no heuristic that succeeds across the sample, would support the computational half; a general method that reliably reaches solutions would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No speed-up works across broad classes is a negative existential and cannot be exhausted by the heuristics tried.", "The inference from solver behavior to natural systems adds a step the benchmarks do not contain.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-17--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.647"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-17--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SAT Competition benchmarks";
    dc:description "public satisfiability instances and published solver outcomes for local and global search";
    prov:wasDerivedFrom <https://satcompetition.github.io/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-17 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.65"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-17--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of wolfram2002-ch07-17 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
