<https://w3id.org/delphi/resource/assessment/wolfram2002-ch09-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch09-12: needs-new-data, resolvability 0.49";
    dc:description "The hypothesis has measurable consequences in specified models, and current data impose indirect constraints. Existing resolution does not reach the claimed scale, so direct resolution requires new observations or experiments.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/empirical-data";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Test high-energy and precision observations for violations of continuous spacetime predictions, such as modified dispersion, anisotropy, or a minimum resolvable length. A reproducible discreteness-specific signature would support the claim, while increasingly stringent null results would constrain but not prove continuity.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Available experiments are far above the proposed microscopic scale.", "Different discrete models predict different observable signatures.", "Null results cannot exclude discreteness at all smaller scales.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-12--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.486"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch09-12--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: HEPData";
    dc:description "public high-energy physics measurements that constrain some signatures of spacetime discreteness";
    prov:wasDerivedFrom <https://www.hepdata.net/>.
