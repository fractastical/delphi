sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on wolfram2002-ch07-20: resolvable-now, resolvability 0.89";
    dc:description "The claim is a statement about simple programs, and the elementary cellular automata are a finite public object. Recomputing the Gray-code sequence of neighboring rules and scoring their output takes days with standard tools. A direct correspondence would show up as a strong correlation; its absence is a decisive result for the stated scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/computation";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Enumerate small cellular-automaton rule spaces, measure rule-table complexity against a behavioral-complexity statistic such as spacetime compressibility or Wolfram class, and compare rules that differ by one table entry. A weak or absent correlation, with adjacent rules in different classes, would support the claim; a tight monotone relation between rule complexity and behavioral complexity would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Behavioral complexity has several inequivalent measures, though the qualitative mismatch is stable across the usual ones.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-20--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-20--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.89"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-20--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Wolfram Atlas of Simple Programs";
    dc:description "complete published survey of elementary cellular automata for the rule-versus-behavior comparison";
    prov:wasDerivedFrom <https://atlas.wolfram.com/>.
<https://w3id.org/delphi/resource/evidence/wolfram2002-ch07-20--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NetLogo";
    dc:description "open simulator for recomputing behavior of neighboring rules";
    prov:wasDerivedFrom <https://ccl.northwestern.edu/netlogo/>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of wolfram2002-ch07-20 by Grok 4.7: 0.95";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.95"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok>.
<https://w3id.org/delphi/resource/assessment/wolfram2002-ch07-20--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
