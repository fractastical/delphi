<https://w3id.org/delphi/resource/assessment/wolfram2002-ch04-01--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on wolfram2002-ch04-01: partially-resolvable, resolvability 0.35";
    dc:description "Literature and textbook corpora can test restricted associations and search for counterexamples. They cannot provide unbiased coverage of all number-based systems or cleanly separate analyzability from historical selection.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    dc:type "resolution-route/mixed";
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define complete analytic solvability and behavioral complexity for a fixed corpus of textbook dynamical systems, then test their association while controlling for pedagogical selection. Counterexamples of completely solved systems with complex behavior would refute the absolute form.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Complete analysis and fairly simple are ambiguous.", "Textbook selection creates strong ascertainment bias.", "The scope mixes a mathematical universal with a sociological explanation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/wolfram2002-ch04-01--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.354"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
