sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-08> a delphi:Claim ;
    rdfs:label "Cellular automata cannot emulate substitution systems step for step" ;
    dct:description "Unlike mobile automata or Turing machines, substitution systems cannot in general be emulated one step per cellular automaton step, because the number of elements in a substitution system can be multiplied by a factor each step while a cellular automaton pattern can grow only by a fixed amount per step; progressively more cellular automaton steps are needed per substitution step." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “Emulating Other Systems with Cellular Automata” (from p. 656), p. 658. Scope: cellular automaton emulation of substitution systems" ;
    dct:type "mathematical" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <http://www.wikidata.org/entity/Q60413467> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-wolfram-nks-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "That this must ultimately be the case one can see from the fact that the total number of elements in a substitution system can be multiplied by a factor from one step to the next, while in a cellular automaton the size of a pattern can only ever increase by a fixed amount at each step." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q60413467> ;
    prov:hadPrimarySource <https://www.wolframscience.com/nks/p658--emulating-other-systems-with-cellular-automata/> ;
