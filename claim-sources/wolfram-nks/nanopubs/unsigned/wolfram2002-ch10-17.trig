sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-17> a delphi:Claim ;
    rdfs:label "Every nested pattern likely has a formula in generalized hypergeometric functions" ;
    dct:description "Although most nested patterns have no obvious relation to ordinary mathematical functions, a formula for the color of each cell of any nested pattern can probably be found in terms of suitably generalized hypergeometric functions or similar generalizations of traditional functions." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Traditional Mathematics and Mathematical Formulas” (from p. 606), p. 612. Scope: nested patterns generated by substitution systems" ;
    dct:type "mathematical" .
}

