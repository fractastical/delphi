sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-11> a delphi:Claim ;
    rdfs:label "Most known physical laws are emergent, not fundamental" ;
    dct:description "Most physical laws discovered so far are not fundamental but are emergent large-scale features of an underlying rule, so their simplicity says little about the simplicity of that rule." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “Ultimate Models for the Universe” (from p. 465), p. 470. Scope: known laws of physics" ;
    dct:type "general-principle" .
}

