sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-04> a delphi:Claim ;
    rdfs:label "A universal system can produce arbitrarily complex behavior" ;
    dct:description "Because a universal system can emulate any other system, it can produce behavior as complex as that of any other system, so knowing a system is universal implies it can produce behavior that is in a sense arbitrarily complex." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “The Phenomenon of Universality” (from p. 642), p. 643. Scope: universal computational systems of any kind" ;
    dct:type "general-principle" .
}

