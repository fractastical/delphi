sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-07> a delphi:Claim ;
    rdfs:label "Most engaging images mix simply describable and indescribable features" ;
    dct:description "People tend to lose interest in images with no simple features (such as perfectly random ones), and the images that hold attention and seem most aesthetically pleasing are those in which some features are simple to describe while others have no short description findable by human visual perception." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Defining Complexity” (from p. 557), p. 559. Scope: human visual attention and aesthetic preference for images" ;
    dct:type "prediction" .
}

