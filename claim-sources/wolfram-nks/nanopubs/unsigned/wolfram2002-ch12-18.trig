sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-18> a delphi:Claim ;
    rdfs:label "Complex-looking yet computationally reducible systems are very rare" ;
    dct:description "Systems whose behavior looks complex but is nevertheless computationally reducible, such as the cellular automaton that generates digits of powers of 2, are very rare; in the vast majority of cases complex-looking behavior in nature and elsewhere is computationally irreducible." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Computational Irreducibility” (from p. 737), p. 748. Scope: systems with complex-looking behavior in nature and among simple programs" ;
    dct:type "general-principle" .
}

