sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-20> a delphi:Claim ;
    rdfs:label "Memory retrieval, not logic, underlies almost all of human thinking" ;
    dct:description "Retrieval from memory on the basis of similarity underlies almost every major aspect of human thinking, including generalization, analogy and intuition, and logical reasoning is not fundamental but is itself carried out by retrieving learned patterns of argument from memory." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Human Thinking” (from p. 620), p. 627. Scope: human cognition" ;
    dct:type "model-of-nature" .
}

