sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-11> a delphi:Claim ;
    rdfs:label "Simple arithmetic systems based on remainders can be universal" ;
    dct:description "A system that repeatedly takes a whole number, computes its remainder modulo a constant and applies an arithmetic operation chosen by that remainder can emulate a register machine, and is therefore universal; given how widespread universality is, arithmetic supporting it is unsurprising." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 11, “The Notion of Computation”; section “Emulating Cellular Automata with Other Systems” (from p. 664), p. 673. Scope: generalized arithmetic (Collatz-like) iteration systems" ;
    dct:type "mathematical" .
}

