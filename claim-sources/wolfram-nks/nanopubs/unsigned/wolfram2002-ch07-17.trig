    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "So what this suggests is that even if in some idealized sense a system in nature might be expected to satisfy certain constraints, it is likely that in practice the system will actually not have a way to come even close to doing this." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q60413467> ;
