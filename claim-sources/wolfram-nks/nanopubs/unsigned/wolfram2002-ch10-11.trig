sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-11> a delphi:Claim ;
    rdfs:label "Human vision easily detects repetition but generally fails to detect nesting" ;
    dct:description "Humans can readily see by eye that a two-dimensional pattern is purely repetitive, but generally cannot tell that a pattern is nested (unless it is dominated by large uniform areas), even though a simple two-dimensional pointer-based encoding recognizes the nesting." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Visual Perception” (from p. 577), p. 582. Scope: human visual recognition of repetitive and nested two-dimensional patterns" ;
    dct:type "prediction" .
}

