sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-06> a delphi:Claim ;
    rdfs:label "Complex behavior in 2D Turing machines is as rare as in 1D" ;
    dct:description "Two-dimensional Turing machines behave much like one-dimensional ones: with two or three head states only repetitive and nested behavior normally occurs, and with four states complex behavior is possible but rare (a few rules per million)." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Turing Machines” (from p. 184), p. 184. Scope: two-dimensional Turing machines with two to four head states and two colors" ;
    dct:type "computational-observation" .
}

