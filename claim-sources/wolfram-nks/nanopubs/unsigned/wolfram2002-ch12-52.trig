sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-52> a delphi:Claim ;
    rdfs:label "Recognizing extraterrestrial intelligence depends on similarity to humans" ;
    dct:description "The difficulty in finding extraterrestrial intelligence is not finding systems that compute in sophisticated ways, which are common, but finding ones whose details are similar enough to humans that we would recognize them as intelligent; somewhat generalized intelligence is likely to exist but to behave in bizarrely unhuman ways." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Intelligence in the Universe” (from p. 822), p. 839. Scope: extraterrestrial intelligence" ;
    dct:type "conceptual" .
}

