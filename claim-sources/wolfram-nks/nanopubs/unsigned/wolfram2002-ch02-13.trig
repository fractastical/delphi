sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-13> a delphi:Claim ;
    rdfs:label "Computers enable discoveries beyond working out mathematical equations" ;
    dct:description "Computers are not limited to computing the consequences of mathematical equations; directly studying the behavior of even the simplest computer programs yields fundamental scientific discoveries." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 2, “The Crucial Experiment”; section “Why These Discoveries Were Not Made Before” (from p. 42), p. 45. Scope: the role of computers in basic science" ;
    dct:type "conceptual" .
}

