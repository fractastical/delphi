sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-42> a delphi:Claim ;
    rdfs:label "Very short single-axiom systems for logic exist among the simplest axiom systems" ;
    dct:description "Propositional logic can be axiomatized in terms of Nand by a single axiom with only six Nands (found by searching small axiom systems), far shorter than textbook systems, so an axiom system for logic is likely to be found among the simplest few thousand axiom systems." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Implications for Mathematics and Its Foundations” (from p. 772), p. 809. Scope: equational axiom systems for Boolean algebra in terms of Nand" ;
    dct:type "mathematical" .
}

