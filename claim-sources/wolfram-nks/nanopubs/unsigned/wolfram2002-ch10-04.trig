sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-04> a delphi:Claim ;
    rdfs:label "Something is random if essentially no simple program detects regularities in it" ;
    dct:description "Since essentially all standard methods of perception and analysis are based on simple programs, something should be considered random whenever essentially no simple program succeeds in detecting regularities in it." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Defining the Notion of Randomness” (from p. 552), p. 556. Scope: the definition of randomness for data of any kind" ;
    dct:type "conceptual" .
}

