sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-15> a delphi:Claim ;
    rdfs:label "Lack of adequate computers delayed discovery of complexity from simple rules" ;
    dct:description "A main reason that complexity from simple programs was not discovered before the 1980s is that computer technology powerful enough for the required large-scale exploratory experiments did not yet exist, together with a lack of intuition drawn from practical computing." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 2, “The Crucial Experiment”; section “Why These Discoveries Were Not Made Before” (from p. 42), p. 46. Scope: history of science and computing" ;
    dct:type "conceptual" .
}

