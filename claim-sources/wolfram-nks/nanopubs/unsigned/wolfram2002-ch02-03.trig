sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-03> a delphi:Claim ;
    rdfs:label "Simple rules with simple initial conditions can yield highly complex behavior" ;
    dct:description "As a general phenomenon, a system with simple underlying rules started from simple initial conditions can nevertheless show highly complex behavior." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 2, “The Crucial Experiment”; section “How Do Simple Programs Behave?” (from p. 23), p. 28. Scope: simple programs and other systems with simple rules and simple initial conditions" ;
    dct:type "general-principle" .
}

