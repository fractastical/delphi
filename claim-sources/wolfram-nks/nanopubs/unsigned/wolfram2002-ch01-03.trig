sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-03> a delphi:Claim ;
    rdfs:label "Natural complexity arises because natural systems behave like typical programs" ;
    dct:description "The great complexity seen across physical, biological and other natural systems is explained by those systems operating like typical simple programs, which commonly produce complex behavior, rather than by any special or supernatural source of complexity." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 1, “The Foundations for a New Kind of Science”; section “An Outline of Basic Ideas” (from p. 1), p. 3. Scope: complex-looking physical, biological and other natural systems" ;
    dct:type "model-of-nature" .
}

