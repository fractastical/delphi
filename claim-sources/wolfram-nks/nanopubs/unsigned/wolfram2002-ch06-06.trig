sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-06> a delphi:Claim ;
    rdfs:label "Class 4 lies between class 2 and class 3 in activity" ;
    dct:description "Although class 4 is the most complex in appearance, in terms of overall activity it is intermediate between class 2 and class 3, and in sequences of rules it commonly appears at the transition between class 2 and class 3 rules." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Four Classes of Behavior” (from p. 231), p. 242. Scope: sequences of cellular automaton rules, both discrete and continuous" ;
    dct:type "computational-observation" .
}

