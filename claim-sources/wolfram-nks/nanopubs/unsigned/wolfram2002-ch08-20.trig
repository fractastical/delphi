sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch08-20> a delphi:Claim ;
    rdfs:label "Leaf shapes arise from the same simple branching process as whole plants" ;
    dct:description "The shapes of leaves, from smooth to prickly to irregular, are produced by the same simple branching growth process that governs overall plant forms, and small changes in its parameters can change leaf shape greatly." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 8, “Implications for Everyday Systems”; section “Growth of Plants and Animals” (from p. 400), p. 404. Scope: leaf shape development in plants" ;
    dct:type "model-of-nature" .
}

