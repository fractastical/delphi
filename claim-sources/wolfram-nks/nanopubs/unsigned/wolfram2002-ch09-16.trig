sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-16> a delphi:Claim ;
    rdfs:label "Observers perceive time only through the causal network of events" ;
    dct:description "An observer embedded in a system such as a mobile automaton cannot see its individual update steps; all the observer can perceive is the network of causal relationships between updating events, so perceived time and spacetime derive purely from that causal network, and sequential updating can appear as synchronized parallel evolution." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “Time and Causal Networks” (from p. 486), p. 490. Scope: observers embedded in discrete evolving systems, including the universe" ;
    dct:type "physical-hypothesis" .
}

