sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch09-26> a delphi:Claim ;
    rdfs:label "Network-based programs will reproduce the key features of quantum theory" ;
    dct:description "Discrete network models of the universe with causal invariance will ultimately turn out to exhibit many if not all of the key features of quantum theory, even though they are not set up in terms of its standard formalism." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 9, “Fundamental Physics”; section “Quantum Phenomena” (from p. 537), p. 538. Scope: network models of the universe and quantum phenomena" ;
    dct:type "physical-hypothesis" .
}

