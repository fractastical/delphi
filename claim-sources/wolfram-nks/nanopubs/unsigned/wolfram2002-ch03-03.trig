sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-03> a delphi:Claim ;
    rdfs:label "Ten of the 256 elementary cellular automata produce apparent randomness" ;
    dct:description "Of the 256 elementary cellular automata started from a single black cell, 10 produce patterns that seem in many respects random, falling into three basic forms, while 24 produce nested patterns falling into only three fundamentally different forms." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 3, “The World of Simple Programs”; section “More Cellular Automata” (from p. 53), p. 58. Scope: the 256 elementary cellular automata, single-black-cell initial condition" ;
    dct:type "computational-observation" .
}

