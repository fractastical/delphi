sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-17> a delphi:Claim ;
    rdfs:label "Nested cellular automaton patterns can be computed in logarithmic time" ;
    dct:description "For cellular automata with nested behavior such as elementary rules 60 and 188, the color of a cell after t steps can be found in about log2(t) steps from the base-2 digits of its position, rather than by tracing all t steps." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Computational Irreducibility” (from p. 737), p. 744. Scope: elementary cellular automata rules 60 and 188, and nested patterns generally" ;
    dct:type "computational-observation" .
}

