sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch05-18> a delphi:Claim ;
    rdfs:label "The simplest constraint forcing a non-repetitive pattern forces a nested one" ;
    dct:description "Among 2D template constraints that also require one template to appear somewhere, systematic search over more than 18 million constraints finds that the first constraint forcing a non-repetitive pattern (number 18762389) forces a unique nested pattern." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 5, “Two Dimensions and Beyond”; section “Systems Based on Constraints” (from p. 210), p. 218. Scope: two-dimensional template constraints with a required-template condition" ;
    dct:type "mathematical" .
}

