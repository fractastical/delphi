sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-48> a delphi:Claim ;
    rdfs:label "Human artifacts look simple because engineering requires predictability" ;
    dct:description "Human-made artifacts tend to look simpler than natural objects because engineers need to foresee what their systems will do, which requires computational reducibility, whereas nature has no such constraint and many natural systems are computationally irreducible." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 12, “The Principle of Computational Equivalence”; section “Intelligence in the Universe” (from p. 822), p. 828. Scope: human engineering artifacts compared with natural objects" ;
    dct:type "general-principle" .
}

