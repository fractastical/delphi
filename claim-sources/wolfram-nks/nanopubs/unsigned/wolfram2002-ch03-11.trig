sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch03-11> a delphi:Claim ;
    rdfs:label "Substitution systems with deletion need three or more colors for complexity" ;
    dct:description "Among two-color substitution systems that allow elements to be destroyed, those with slow growth produce only simple repetitive patterns, but allowing three or four colors immediately makes patterns as random-looking as those of cellular automata possible." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 3, “The World of Simple Programs”; section “Substitution Systems” (from p. 82), p. 86. Scope: neighbor-dependent substitution systems with creation and destruction of elements" ;
    dct:type "computational-observation" .
}

