sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch10-23> a delphi:Claim ;
    rdfs:label "No method of perception or analysis can recognize all possible regularities" ;
    dct:description "No method of perception and analysis, however advanced, can in complete generality recognize all possible regularities and thus tell immediately whether a piece of data can be generated from some simple description, although higher methods could recognize some regularities current methods miss." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 10, “Processes of Perception and Analysis”; section “Higher Forms of Perception and Analysis” (from p. 632), p. 633. Scope: all possible methods of perception and analysis" ;
    dct:type "mathematical" .
}

