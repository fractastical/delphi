sub:assertion {
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-12> a delphi:Claim ;
    rdfs:label "Finite discrete deterministic systems must eventually repeat" ;
    dct:description "Any system of limited size made of discrete elements and following definite rules must eventually exhibit repetitive behavior, with repetition period at most equal to its total number of possible states." ;
    delphi:context "Stephen Wolfram, A New Kind of Science (Champaign, IL: Wolfram Media, 2002), Chapter 6, “Starting from Randomness”; section “Systems of Limited Size and Class 2 Behavior” (from p. 255), p. 255. Scope: finite-state deterministic discrete systems" ;
    dct:type "mathematical" .
}

