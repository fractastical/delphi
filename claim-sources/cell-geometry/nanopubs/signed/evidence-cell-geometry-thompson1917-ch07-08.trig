sub:value9 a <https://schema.org/PropertyValue>;
    <https://schema.org/description> "cells fully surrounded by other segmented cells, Drosophila melanogaster compound eye ommatidia (SEM)";
    <https://schema.org/propertyID> "n_interior_cells";
