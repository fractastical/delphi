sub:value9 a <https://schema.org/PropertyValue>;
    <https://schema.org/description> "fraction of measured junctions whose largest angle is at least 160 degrees, Drosophila melanogaster compound eye ommatidia (SEM)";
    <https://schema.org/propertyID> "frac_T_like_junctions";
