  sub:value0 a schema:PropertyValue ;
    schema:propertyID "verdict" ;
    schema:value "supports" ;
    schema:description "verdict under the criterion stated in the description, exploratory (not pre-registered); tester's confidence 0.5" .
  sub:value1 a schema:PropertyValue ;
    schema:propertyID "n_images" ;
    schema:value "5"^^xsd:integer ;
    schema:description "tissue images analysed, one per tissue" .
  sub:value2 a schema:PropertyValue ;
