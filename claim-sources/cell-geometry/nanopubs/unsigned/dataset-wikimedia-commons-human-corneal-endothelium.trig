    dcat:version "Commons rendition retrieved 2026-10-31T03:42:12Z" ;
    schema:measurementTechnique "light microscopy of human corneal endothelium in situ, cell outlines stained with alizarin red" ;
    schema:about "Homo sapiens (Animalia), corneal endothelium (alizarin red, in situ)" ;
