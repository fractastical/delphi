    dct:bibliographicCitation "Plantsurfer (Wikimedia Commons user). Epidermis of Festuca arundinacea.jpg. Wikimedia Commons, CC BY-SA 4.0. https://commons.wikimedia.org/wiki/File:Epidermis_of_Festuca_arundinacea.jpg" ;
    dct:description "The epidermis of the leaf of the grass Festuca arundinacea, Tall Fescue, as seen by scanning electron microscopy" ;
    dct:creator "Plantsurfer (Wikimedia Commons user)" ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcat:landingPage <https://commons.wikimedia.org/wiki/File:Epidermis_of_Festuca_arundinacea.jpg> ;
    dcat:version "Commons rendition retrieved 2026-10-31T03:42:14Z" ;
    schema:measurementTechnique "scanning electron microscopy of the leaf surface" ;
    schema:about "Festuca arundinacea (Plantae), grass leaf epidermis (SEM)" ;
    dcat:distribution sub:file ;
    schema:additionalProperty sub:count0 ;
    schema:additionalProperty sub:count1 ;
    schema:additionalProperty sub:count2 .
