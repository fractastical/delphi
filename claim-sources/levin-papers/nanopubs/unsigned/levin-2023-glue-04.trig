sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-04> a delphi:Claim ;
    rdfs:label "Bioelectric network information cannot be read from transcript or protein levels" ;
    dct:description "Because ion channels open and close post-translationally, the same channels can yield different voltage states depending on cell history and different channels can yield the same voltage map, the information content of a bioelectric network cannot be read out at the transcriptional or proteomic level and must be studied in living tissue." ;
    delphi:context "Levin M, “Bioelectric networks: the cognitive glue enabling evolutionary scaling from physiology to mind”, Animal cognition (2023), doi:10.1007/s10071-023-01780-3; section “Bioelectricity: the ancient cognitive glue”. Scope: Bioelectric networks of neural and non-neural cells" ;
    dct:type "mechanism" .
}

