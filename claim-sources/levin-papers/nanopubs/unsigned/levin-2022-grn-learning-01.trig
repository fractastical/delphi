sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-01> a delphi:Claim ;
    rdfs:label "Published ODE models of gene and protein pathways show several kinds of memory" ;
    dct:description "In simulations of 35 published ODE models of gene regulatory networks and protein/metabolic pathways from BioModels, the networks show several distinct kinds of memory (UCS-based, pairing, transfer, associative and consolidation memory) in response to patterns of node stimulation." ;
    delphi:context "Biswas S, Clawson W, Levin M, “Learning in Transcriptional Network Models: Computational Discovery of Pathway-Level Memory and Effective Interventions”, International journal of molecular sciences (2022), doi:10.3390/ijms24010285; section “Abstract”. Scope: 35 ODE pathway models from BioModels (bacteria, slime mould, yeast, plants, vertebrates, mammals)" ;
    dct:type "simulation-result" .
}

