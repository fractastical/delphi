sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-18> a delphi:Claim ;
    rdfs:label "Sensitization is harder to break than habituation in pathway models" ;
    dct:description "In ODE pathway models, sensitization could be broken by stimulating a third node in only 8 of 27 sensitizing models, mostly for fewer than 5% of node pairs, so breaking sensitization is less likely than breaking habituation and therapies may need other avenues of intervention." ;
    delphi:context "Biswas S, Clawson W, Levin M, “Learning in Transcriptional Network Models: Computational Discovery of Pathway-Level Memory and Effective Interventions”, International journal of molecular sciences (2022), doi:10.3390/ijms24010285; section “2. Results › 2.8. Making and Breaking Sensitization”. Scope: 27 sensitizing ODE pathway models from BioModels" ;
    dct:type "simulation-result" .
}

