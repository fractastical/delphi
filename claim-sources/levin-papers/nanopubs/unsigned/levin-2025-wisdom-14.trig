sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-14> a delphi:Claim ;
    rdfs:label "Gap-junction closure in transformation is a positive feedback loop of isolation" ;
    dct:description "Cells may physiologically disconnect from the tissue network (e.g. closing gap junctions under prolonged stress), and each reduction in connectivity makes local computation easier and further gap-junction closure more likely, a positive feedback loop of dissociation that makes tissue-level goals ever harder to achieve; Levin presents this as consistent with gap-junction closure in early transformation and with tumours induced by non-carcinogenic geometric barriers." ;
    delphi:context "Levin M, “The Multiscale Wisdom of the Body: Collective Intelligence as a Tractable Interface for Next-Generation Biomedicine”, BioEssays : news and reviews in molecular, cellular and developmental biology (2025), doi:10.1002/bies.202400196; section “Cancer and the Scaling of the Self”. Scope: Early carcinogenic transformation in animal tissues" ;
    dct:type "mechanism" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1002/bies.202400196> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Each reduction in physiological connectivity makes it easier for cells to perform computations at the local level. This makes it easier for cells to close off gap junctions even more, driving a positive feedback loop—a cycle of dissociation and isolation that makes it ever harder to achieve large‐scale cell collective goals (maintaining complex anatomical structure)." ;
    prov:wasQuotedFrom <https://doi.org/10.1002/bies.202400196> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2025-wisdom.txt#line=96,97> .

