sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-19> a delphi:Claim ;
    rdfs:label "Embryos in large groups form a 'hyperembryo' that resists teratogens better" ;
    dct:description "Individual embryos raised in large groups form a kind of 'hyperembryo' with its own distinct transcriptome and an ability to resist teratogenic challenges far better than individual embryos or small groups." ;
    delphi:context "Levin M, “The Multiscale Wisdom of the Body: Collective Intelligence as a Tractable Interface for Next-Generation Biomedicine”, BioEssays : news and reviews in molecular, cellular and developmental biology (2025), doi:10.1002/bies.202400196; section “Applications and a Roadmap Toward a Radical Regenerative Medicine › Top‐Down Control Exploits Agential Materials by Pushing Complexity from the Engineer onto the System Itself”. Scope: Groups of Xenopus laevis embryos (author's lab's prior work, ref [197])" ;
    dct:type "experimental-result" .
}

