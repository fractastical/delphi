sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2014-tumor-02> a delphi:Claim ;
    rdfs:label "Oncogene-induced tumor-like structures in Xenopus share hallmarks of human tumors" ;
    dct:description "Tumor-like structures induced in Xenopus laevis tadpoles by human oncogenes such as mutant KRAS display overproliferation, increased nuclear size, hypoxia, intracellular acidity and leukocyte attraction, hallmarks shared with classic human tumors." ;
    delphi:context "Chernet BT, Levin M, “Transmembrane voltage potential of somatic cells controls oncogene-mediated tumorigenesis at long-range”, Oncotarget (2014), doi:10.18632/oncotarget.1935; section “Abstract”. Scope: Induced tumor-like structures (ITLS) in Xenopus laevis embryos injected with Xrel3, Gli1 or KRASG12D mRNA" ;
    dct:type "experimental-result" .
}

