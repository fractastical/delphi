    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-11> a delphi:Claim ;
    rdfs:label "Hexanol, which does not block gap junctions, does not alter head shape" ;
    dct:description "In G. dorotocephala, the same 3-day exposure to hexanol, a closely related alcohol that does not efficiently block gap junction channels, does not produce altered head morphologies, consistent with the head-shape change depending on octanol's gap-junction-blocking activity rather than a generalized effect of long-chain alcohols." ;
    delphi:context "Emmons-Bell M, Durant F, Hammelman J, Bessonov N, Volpert V, Morokuma J, Pinet K, Adams DS, Pietak A, Lobo D, Levin M, “Gap Junctional Blockade Stochastically Induces Different Species-Specific Head Anatomies in Genetically Wild-Type Girardia dorotocephala Flatworms”, International journal of molecular sciences (2015), doi:10.3390/ijms161126065; section “3. Discussion › 3.1. Perturbation of Bioelectric Networks Produces Inter-Species Morphological Change”. Scope: Regenerating G. dorotocephala fragments treated with hexanol versus octanol" ;
    dct:type "experimental-result" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.3390/ijms161126065> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "The same 3-day treatment with the closely related alcohol, hexanol (6-OH), which does not efficiently block gap junction channels, and subsequent regeneration in water for 7 days, did not produce altered morphologies, consistent with the importance of the GJ-blocking activity of octanol, and not some other generalized effect of long-chain alcohols." ;
    prov:wasQuotedFrom <https://doi.org/10.3390/ijms161126065> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2015-girardia.txt#line=66,67> .

