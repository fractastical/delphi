sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-20> a delphi:Claim ;
    rdfs:label "Evolution pivoted cellular collective intelligence into behavioural intelligence" ;
    dct:description "The authors propose that evolution turned the collective intelligence of cells during body morphogenesis into traditional behavioural intelligence by scaling up the goals (homeostatic setpoints) at the centre of homeostatic processes, so that body patterning and cognition lie on one continuum." ;
    delphi:context "Pio-Lopez L, Bischof J, LaPalme JV, Levin M, “The scaling of goals from cellular to anatomical homeostasis: an evolutionary simulation, experiment and analysis”, Interface focus (2023), doi:10.1098/rsfs.2022.0072; section “Discussion”. Scope: Multicellular organisms generally; evolution of morphogenesis and behaviour" ;
    dct:type "historical-inference" .
}

