sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-14> a delphi:Claim ;
    rdfs:label "22% of headless ERK-inhibited planaria spontaneously repattern weeks later" ;
    dct:description "In Dugesia japonica made headless by transient U0126 (ERK/MAP kinase inhibitor) treatment after amputation, 22% of 181 animals followed until death showed sudden repatterning after four or more weeks without any intervention, mostly between 4 and 10 weeks, and 61% of those regained a normal single-headed morphology." ;
    delphi:context "Pio-Lopez L, Bischof J, LaPalme JV, Levin M, “The scaling of goals from cellular to anatomical homeostasis: an evolutionary simulation, experiment and analysis”, Interface focus (2023), doi:10.1098/rsfs.2022.0072; section “Experimental results on repatterning of planaria”. Scope: Dugesia japonica pre-tail fragments treated with 18 μM U0126 for 3 days" ;
    dct:type "experimental-result" .
}

