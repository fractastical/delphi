sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-05> a delphi:Claim ;
    rdfs:label "Pairs of organisms collide, bond and orbit, more so with cilia active" ;
    dct:description "Collective behaviours predicted in simulation were observed in vivo: two organisms often collide, form a temporary mechanical bond and orbit each other for several revolutions before detaching, and this is more pronounced when cilia are not inhibited." ;
    delphi:context "Kriegman S, Blackiston D, Levin M, Bongard J, “A scalable pipeline for designing reconfigurable organisms”, Proceedings of the National Academy of Sciences of the United States of America (2020), doi:10.1073/pnas.1910837117; section “Results › Collective Behavior.”. Scope: Multiple Xenopus reconfigurable organisms sharing a dish, with and without cilia" ;
    dct:type "experimental-result" .
}

