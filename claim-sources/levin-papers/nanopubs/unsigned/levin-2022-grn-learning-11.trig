sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-11> a delphi:Claim ;
    rdfs:label "Most pathway-model memories persist over long periods and survive recall" ;
    dct:description "In the surveyed ODE pathway models with UCS-based memory, most networks retain the bulk of their memories over waiting periods up to 100 times the initial one, and testing (recalling) a memory generally does not destroy it and in rare cases strengthens it." ;
    delphi:context "Biswas S, Clawson W, Levin M, “Learning in Transcriptional Network Models: Computational Discovery of Pathway-Level Memory and Effective Interventions”, International journal of molecular sciences (2022), doi:10.3390/ijms24010285; section “2. Results › 2.4. Memory Effects Are Stable over Long Periods”. Scope: 30 ODE pathway models from BioModels showing UCS-based memory" ;
    dct:type "simulation-result" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.3390/ijms24010285> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Overall, we conclude that while some networks have a limit on how long they retain training, the majority of networks can retain the bulk of their possible memories over very long time periods and that in general, memory ‘access’ does not destroy the memory but can, in some rare cases, increase memory." ;
    prov:wasQuotedFrom <https://doi.org/10.3390/ijms24010285> ;
