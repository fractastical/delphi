sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-04> a delphi:Claim ;
    rdfs:label "Apical-in spheroids become motile within a week in low-adhesive liquid culture" ;
    dct:description "Human bronchial epithelial spheroids that are apical-in and non-motile on release from Matrigel become motile by day 7 in low-adhesive liquid culture, with beating cilia on their outer surface; immunostaining shows a large increase in external multiciliated cells between day 0 and day 7." ;
    delphi:context "Gumuskaya G, Srivastava P, Cooper BG, Lesser H, Semegran B, Garnier S, Levin M, “Motile Living Biobots Self-Construct from Adult Human Somatic Progenitor Seed Cells”, Advanced science (Weinheim, Baden-Wurttemberg, Germany) (2024), doi:10.1002/advs.202303575; section “Results › Human Bronchial Epithelial Cells Self‐Construct into Multicellular Motile Living Architectures”. Scope: NHBE-derived spheroids in vitro, Anthrobot protocol with retinoic acid" ;
    dct:type "experimental-result" .
}

