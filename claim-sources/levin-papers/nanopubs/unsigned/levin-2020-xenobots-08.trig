sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-08> a delphi:Claim ;
    rdfs:label "Cardiomyocytes in built organisms spontaneously made phase-matched contractions" ;
    dct:description "Although signalling between cardiomyocytes was not designed or enforced, cardiac muscle cells in the built organisms spontaneously coordinated to produce coherent, phase-matched contractions that aided locomotion." ;
    delphi:context "Kriegman S, Blackiston D, Levin M, Bongard J, “A scalable pipeline for designing reconfigurable organisms”, Proceedings of the National Academy of Sciences of the United States of America (2020), doi:10.1073/pnas.1910837117; section “Discussion”. Scope: Xenopus cardiac progenitor tissue embedded in reconfigurable organisms" ;
    dct:type "experimental-result" .
}

