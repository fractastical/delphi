sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-03> a delphi:Claim ;
    rdfs:label "Lower viscosity may drive apical-out polarity reversal of airway spheroids" ;
    dct:description "The authors hypothesize that airway spheroids keep cilia in the lumen because basal cells interact with the surrounding high-viscosity matrix, and that moving spheroids to a lower-viscosity, water-based medium may trigger basal cells to migrate inward so the ciliated apical layer takes their place on the spheroid surface." ;
    delphi:context "Gumuskaya G, Srivastava P, Cooper BG, Lesser H, Semegran B, Garnier S, Levin M, “Motile Living Biobots Self-Construct from Adult Human Somatic Progenitor Seed Cells”, Advanced science (Weinheim, Baden-Wurttemberg, Germany) (2024), doi:10.1002/advs.202303575; section “Results › Human Bronchial Epithelial Cells Self‐Construct into Multicellular Motile Living Architectures”. Scope: Human bronchial epithelial spheroids grown in Matrigel and transferred to low-adhesive liquid culture" ;
    dct:type "mechanism" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1002/advs.202303575> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Given that cilia naturally localize into the lumen due to the basal cells’ interaction with the surrounding high‐viscosity matrix, we hypothesized that changing the culture environment to a lower viscosity level (e.g., water‐based media instead of gel‐based matrix) may trigger the basal layer cells to migrate inward and allow the apical layer to take their place on the spheroid cortex." ;
    prov:wasQuotedFrom <https://doi.org/10.1002/advs.202303575> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-anthrobots.txt#line=27,28> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-anthrobots.txt#line=27,28> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-anthrobots.txt> .

