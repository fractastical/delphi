sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-16> a delphi:Claim ;
    rdfs:label "Newt kidney tubules keep normal diameter with fewer, larger cells, down to one cell" ;
    dct:description "In newts whose embryonic cells are made larger (e.g. by polyploidy), kidney tubules use fewer cells to keep the normal tubule diameter and body size, and with enormous cells a single cell bends around itself to form the tubule, showing that different molecular mechanisms are called on to reach the same large-scale anatomical goal." ;
    delphi:context "Levin M, “Bioelectric networks: the cognitive glue enabling evolutionary scaling from physiology to mind”, Animal cognition (2023), doi:10.1007/s10071-023-01780-3; section “Basal cognition without neurons: what dynamic bodies think about › Creative problem-solving by adaptive morphogenesis: plasticity, not just emergent complexity”. Scope: Polyploid newt embryos (Fankhauser 1945)" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1007/s10071-023-01780-3> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "However, if the cells of the early embryo are artificially made to be larger, fewer cells will be used, resulting in the same (normal) tubule diameter and overall body size. Remarkably, this can be pushed to a fascinating extreme: if the cells are made to be enormous, a single cell will bend around itself, producing the normal size tubule diameter." ;
    prov:wasQuotedFrom <https://doi.org/10.1007/s10071-023-01780-3> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=59,60> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=59,60> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt> .

