    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-14> a delphi:Claim ;
    rdfs:label "Ion channel drugs can make planarian head number flip stochastically at each regeneration" ;
    dct:description "Exposure to ion channel drugs can put the planarian bioelectric circuit into a bistable state in which, at each regeneration, fragments of these 'cryptic' worms randomly regenerate as one-headed or two-headed, analogous to bistability in perceptual systems." ;
    delphi:context "Levin M, “Bioelectric networks: the cognitive glue enabling evolutionary scaling from physiology to mind”, Animal cognition (2023), doi:10.1007/s10071-023-01780-3; section “Basal cognition without neurons: what dynamic bodies think about › Reprogrammability, external manipulation, and representation”. Scope: Planarian flatworms treated with ion channel or gap-junction drugs (Durant et al. 2017)" ;
    dct:type "experimental-result" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1007/s10071-023-01780-3> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Exposure to ion channel drugs (a physiological experience akin to electrical signals from a retina or other sense organ, not a genetic change) can place the bioelectric circuit into a state in which it cannot decide between two outcomes and flips back and forth stochastically at each regenerative event (recall of target morphology)." ;
    prov:wasQuotedFrom <https://doi.org/10.1007/s10071-023-01780-3> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=53,54> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=53,54> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt> .

