    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-memory-07> a delphi:Claim ;
    rdfs:label "The same bioelectric trigger is reinterpreted by context (monensin: tails vs legs)" ;
    dct:description "Low-information bioelectric triggers are interpreted by competent tissues according to context: the voltage-modifying reagent monensin induces tail regrowth in tadpoles but leg regrowth in froglets, never the reverse, preserving high-level information such as 'build whatever normally goes at this location'." ;
    delphi:context "Levin M, “Self-Improvising Memory: A Perspective on Memories as Agential, Dynamically Reinterpreting Cognitive Glue”, Entropy (Basel, Switzerland) (2024), doi:10.3390/e26060481; section “4. Beyond the Brain: Bowties Everywhere”. Scope: Xenopus tadpole tail and froglet hindlimb regeneration" ;
    dct:type "mechanism" .
}

