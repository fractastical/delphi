sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-18> a delphi:Claim ;
    rdfs:label "Scrambled Xenopus tadpole faces reach a normal frog face by new paths" ;
    dct:description "During metamorphosis, Xenopus laevis tadpoles reach the correct frog face configuration not only from a normal tadpole configuration but also from a wide range of experimentally scrambled craniofacial configurations, using new paths through morphospace that end in the same goal region." ;
    delphi:context "Levin M, “Bioelectric networks: the cognitive glue enabling evolutionary scaling from physiology to mind”, Animal cognition (2023), doi:10.1007/s10071-023-01780-3; section “Basal cognition without neurons: what dynamic bodies think about › Navigation: an invariant between morphological, behavioral, and other spaces”. Scope: Xenopus laevis tadpoles with induced craniofacial malformations (author's lab, Vandenberg et al. 2012)" ;
    dct:type "experimental-result" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1007/s10071-023-01780-3> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "For example, during metamorphosis, the tadpole of Xenopus laevis can reach the correct frog face region of morphospace not only from its default starting position (a normal tadpole configuration), but also from a wide range of scrambled configurations (Vandenberg et al. 2012)—using new paths through that morphospace that nevertheless end up in the same goal region (Friston et al. 2015; Pezzulo and Levin 2016)." ;
    prov:wasQuotedFrom <https://doi.org/10.1007/s10071-023-01780-3> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=65,66> .

