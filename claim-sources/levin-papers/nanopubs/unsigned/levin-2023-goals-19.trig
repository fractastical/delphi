sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-19> a delphi:Claim ;
    rdfs:label "Somatic cells kept their cognitive repertoire and scaled it to anatomical goals" ;
    dct:description "The authors argue that somatic cells did not lose their ancestral cognitive and computational capabilities when they became part of multicellular bodies, but scaled them up to pursue larger anatomical goals." ;
    delphi:context "Pio-Lopez L, Bischof J, LaPalme JV, Levin M, “The scaling of goals from cellular to anatomical homeostasis: an evolutionary simulation, experiment and analysis”, Interface focus (2023), doi:10.1098/rsfs.2022.0072; section “Discussion”. Scope: Metazoan somatic cells and their unicellular ancestors" ;
    dct:type "historical-inference" .
}

