    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-04> a delphi:Claim ;
    rdfs:label "Cell domains make coordinated group decisions, even random ones" ;
    dct:description "Cells join into domains that make decisions as a single unit: when left-right asymmetry is randomized in early embryos, a whole domain picks L or R identity rather than individual cells choosing independently, and in frog melanoma-like conversion all melanocytes in a body convert or not together." ;
    delphi:context "Levin M, “The Computational Boundary of a \"Self\": Developmental Bioelectricity Drives Multicellularity and Scale-Free Cognition”, Frontiers in psychology (2019), doi:10.3389/fpsyg.2019.02688; section “Body Patterning and Cognition: A Common Origin”. Scope: Left-right patterning in early vertebrate embryos; melanocyte conversion in Xenopus tadpoles" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.3389/fpsyg.2019.02688> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Remarkably, however, this randomization is made on a group level – in each case, the entire domain randomly picks L or R identity, not exhibiting a speckled appearance where each cell adopts a stochastic outcome. The decision is random, but all of the cells in the domain are coordinated to make the same random decision (Levin et al., 2002)." ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fpsyg.2019.02688> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2019-boundary.txt#line=31,32> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2019-boundary.txt#line=31,32> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2019-boundary.txt> .

