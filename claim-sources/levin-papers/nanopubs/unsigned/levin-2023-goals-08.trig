    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-08> a delphi:Claim ;
    rdfs:label "Stress propagation is not required for patterning but improves adaptation to change" ;
    dct:description "Across 10 evolved neural cellular automaton tissues, stress signalling was not required to solve the French flag problem (only 1 of 10 died without it), but the tissue that used stress instructively scored significantly better when the target morphology was changed mid-development (p = 0.0312), suggesting that spatial propagation of stress information increases adaptive fitness under perturbation." ;
    delphi:context "Pio-Lopez L, Bischof J, LaPalme JV, Levin M, “The scaling of goals from cellular to anatomical homeostasis: an evolutionary simulation, experiment and analysis”, Interface focus (2023), doi:10.1098/rsfs.2022.0072; section “Computational results › Evolution exploits the stress system but anxiolytics do not always have an impact on anatomical homeostasis”. Scope: Ten evolved tissues in the 2D neural cellular automaton model" ;
    dct:type "simulation-result" .
}

