sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-15> a delphi:Claim ;
    rdfs:label "Head shape may be encoded in time-dependent rather than steady voltage patterns" ;
    dct:description "Because single-image voltage distributions showed no simple correspondence with the head shapes of octanol-treated G. dorotocephala, the authors consider it most likely that shape outcomes are encoded in time-dependent bioelectric activity rather than in steady voltage distributions, as in information encoding in the central nervous system." ;
    delphi:context "Emmons-Bell M, Durant F, Hammelman J, Bessonov N, Volpert V, Morokuma J, Pinet K, Adams DS, Pietak A, Lobo D, Levin M, “Gap Junctional Blockade Stochastically Induces Different Species-Specific Head Anatomies in Genetically Wild-Type Girardia dorotocephala Flatworms”, International journal of molecular sciences (2015), doi:10.3390/ijms161126065; section “3. Discussion › 3.4. Bioelectric State of Tissues and Its Stable Alteration in Species-Specific Shape Change”. Scope: Planarian bioelectric patterns and head-shape outcomes" ;
    dct:type "prediction" .
}

