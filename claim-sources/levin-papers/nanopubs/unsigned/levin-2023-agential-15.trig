    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-15> a delphi:Claim ;
    rdfs:label "Planaria adapt to barium by changing expression of only a handful of genes" ;
    dct:description "Planaria exposed to barium, a non-specific potassium channel blocker that is evolutionarily novel to them, first lose their heads but then regrow barium-insensitive heads, with only a handful of genes up- or down-regulated, showing that cells can navigate transcriptional space to solve a problem for which there was no selection." ;
    delphi:context "Levin M, “Darwin's agential materials: evolutionary implications of multiscale competency in developmental biology”, Cellular and molecular life sciences : CMLS (2023), doi:10.1007/s00018-023-04790-z; section “Multiple modalities for computation and control across scales”. Scope: Planarians cultured in barium chloride" ;
    dct:type "empirical-generalization" .
}

