    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Transcriptional analysis reveals that these tissues up- and down-regulate just a handful of genes to get back to physiological and anatomical setpoints despite the inability to regulate potassium." ;
