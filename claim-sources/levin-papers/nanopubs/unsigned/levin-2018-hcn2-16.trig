sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-16> a delphi:Claim ;
    rdfs:label "Native HCN2 activity is not required for normal brain patterning" ;
    dct:description "Because a dominant-negative HCN2 construct does not disrupt brain patterning, native HCN2 channel activity is not required for normal Xenopus brain patterning, ruling out the possibility that nicotine causes defects by directly blocking endogenous HCN2." ;
    delphi:context "Pai VP, Pietak A, Willocq V, Ye B, Shi NQ, Levin M, “HCN2 Rescues brain defects by enforcing endogenous voltage pre-patterns”, Nature communications (2018), doi:10.1038/s41467-018-03334-5; section “Discussion”. Scope: Xenopus laevis embryos injected with Hcn2-DN mRNA" ;
    dct:type "experimental-result" .
}

