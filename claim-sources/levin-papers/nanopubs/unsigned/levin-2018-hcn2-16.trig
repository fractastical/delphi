    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "However, our experiments with dominant-negative HCN2 channel shows that native HCN2 channel activity is not required for proper brain patterning (Supplementary Figure 4), thus negating this possibility." ;
