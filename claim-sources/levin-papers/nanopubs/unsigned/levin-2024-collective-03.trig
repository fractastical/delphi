    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-collective-03> a delphi:Claim ;
    rdfs:label "The number of embryos a blastoderm forms is not fixed by genetics" ;
    dct:description "The number of individuals formed by an embryonic blastoderm is not fixed at one by the genome: temporarily introducing breaks that informationally isolate islands of cells yields twins, triplets and so on, showing the blastoderm is an excitable medium in which several coherent embryos can self-organize." ;
    delphi:context "McMillen P, Levin M, “Collective intelligence: A unifying concept for integrating biology across scales and substrates”, Communications biology (2024), doi:10.1038/s42003-024-06037-4; section “Introduction › Development: transition to multicellularity”. Scope: Early vertebrate (e.g. avian) blastoderms" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1038/s42003-024-06037-4> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Indeed, the question of how many individuals are present in an embryonic blastoderm is not fixed at 1 by the genetics, because temporary introduction of breaks in the blastoderm (leading to informational isolation of islands of cell masses) results in twins, triplets, etc103." ;
