sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-16> a delphi:Claim ;
    rdfs:label "Multicellularity and morphological complexity are driven by greedy infotaxis" ;
    dct:description "Morphological complexity and multicellularity are proposed to be driven by greedy infotaxis: cells collecting as much information as possible from as far away in space and time as possible to minimize surprise, with greater network connectivity enlarging what the compound individual can sense, remember and store." ;
    delphi:context "Levin M, “The Computational Boundary of a \"Self\": Developmental Bioelectricity Drives Multicellularity and Scale-Free Cognition”, Frontiers in psychology (2019), doi:10.3389/fpsyg.2019.02688; section “The Agent’s Evolutionary Back-Story: Scaling of Information by Bioelectricity”. Scope: Origin of multicellularity and morphological complexity" ;
    dct:type "historical-inference" .
}

