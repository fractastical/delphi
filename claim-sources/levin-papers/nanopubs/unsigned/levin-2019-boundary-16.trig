    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "It is proposed that morphological complexity and multicellularity are driven by greedy infotaxis (Vergassola et al., 2007) – collecting as much information as possible, from as far away (in both space and time) as possible, to minimize surprise and optimize prediction." ;
