    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-27> a delphi:Claim ;
    rdfs:label "A single ion channel can induce complete ectopic eyes where Pax6 cannot" ;
    dct:description "In Xenopus, the action of a single ion channel can induce an eye-specific bioelectric state that creates complete eyes in gut endoderm, spinal cord and posterior tissues, locations where genetic master regulators such as Pax6 are insufficient in vertebrates; bioelectric states thus act as master regulators that evolution can exploit for modular anatomical change." ;
    delphi:context "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Evolutionary Aspects › Somatic Bioelectrics Reveals the Origin of Complex Cognitive Systems”. Scope: Xenopus laevis embryos misexpressing ion channels" ;
    dct:type "experimental-result" .
}

