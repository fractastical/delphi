sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-collective-07> a delphi:Claim ;
    rdfs:label "Head-versus-tail choice at a planarian cut cannot be made locally" ;
    dct:description "When a planarian is cut once, cells that were adjacent neighbours at the same positional-information value make a head on one side and a tail on the other, so this anatomical decision cannot be made locally: wound cells must coordinate with the rest of the fragment to learn where they are, which way they face and what structures remain." ;
    delphi:context "McMillen P, Levin M, “Collective intelligence: A unifying concept for integrating biology across scales and substrates”, Communications biology (2024), doi:10.1038/s42003-024-06037-4; section “Introduction › Left/right, head/tail: random, but collective anatomical decisions”. Scope: Regenerating planarian fragments" ;
    dct:type "mechanism" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1038/s42003-024-06037-4> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "In other words, it is actually impossible for an anatomical decision like this to be made locally – the cells of the wound must coordinate with the remaining fragment to get information about where they are located, which way they are facing, and what other structures exist121,122, in order to make adaptive decisions about large-scale growth and form that enable regeneration of normal worms." ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s42003-024-06037-4> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-collective.txt#line=45,46> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-collective.txt#line=45,46> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-collective.txt> .

