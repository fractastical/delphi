    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-10> a delphi:Claim ;
    rdfs:label "Planaria are an example of runaway cellular competency" ;
    dct:description "The authors propose that planaria exemplify runaway competency: their cells became so good at compensating for structural-gene deficiencies that selection could no longer pick the best genomes, so evolution instead increased generic competency to reach the target morphology, explaining a chaotic genome with robust anatomy." ;
    delphi:context "Shreesha L, Levin M, “Cellular Competency during Development Alters Evolutionary Dynamics in an Artificial Embryogeny Model”, Entropy (Basel, Switzerland) (2023), doi:10.3390/e25010131; section “4. Discussion › 4.4. The Paradox of Robustness: Why the Animal with the Worst Genome Has the Best Anatomy”. Scope: Planarian flatworms" ;
    dct:type "historical-inference" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.3390/e25010131> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "We propose that planaria are an example of runaway competency: when cells get really good at making up for deficiencies in the structural genes, evolution has such a hard time selecting for the best genomes that further improvements instead increase generic competency to reach their target morphology despite perturbations." ;
    prov:wasQuotedFrom <https://doi.org/10.3390/e25010131> ;
