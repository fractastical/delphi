    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-07> a delphi:Claim ;
    rdfs:label "Cell competence lets neural-less novel aggregates self-organize functionally" ;
    dct:description "The behavioural competence of individual cells and their propensity to cooperate in groups facilitate functional morphogenesis in novel circumstances, so that the designed organisms, despite lacking nervous systems, following novel developmental trajectories and mixing tissues, still possess self-organizing properties that support their designed behaviour." ;
    delphi:context "Kriegman S, Blackiston D, Levin M, Bongard J, “A scalable pipeline for designing reconfigurable organisms”, Proceedings of the National Academy of Sciences of the United States of America (2020), doi:10.1073/pnas.1910837117; section “Discussion”. Scope: Xenopus cells in novel, designed multicellular configurations" ;
    dct:type "mechanism" .
}

