  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1038/s41467-018-03334-5> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "HCN2 channels are predicted to open at hyperpolarized Vmem, generating more hyperpolarization with opening, thereby serving as a Vmem-controlled switch of Vmem state, capable of amplifying small Vmem gradients, similar to IT effect (Fig. 3c, e, f)." ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s41467-018-03334-5> ;
