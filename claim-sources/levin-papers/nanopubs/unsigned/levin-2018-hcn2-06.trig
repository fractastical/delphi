sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-06> a delphi:Claim ;
    rdfs:label "HCN2 modelled as a voltage-controlled switch that amplifies small Vmem gradients" ;
    dct:description "In the BETSE model of the Xenopus neurula, HCN2 channels open at hyperpolarized membrane voltage and hyperpolarize further when open, so they act as a voltage-controlled switch that amplifies small existing Vmem gradients: sufficiently negative neural tube cells go very hyperpolarized while depolarized lateral regions are left unchanged." ;
    delphi:context "Pai VP, Pietak A, Willocq V, Ye B, Shi NQ, Levin M, “HCN2 Rescues brain defects by enforcing endogenous voltage pre-patterns”, Nature communications (2018), doi:10.1038/s41467-018-03334-5; section “Results › BETSE model identifies HCN2 channel as a repair reagent”. Scope: BETSE bioelectric model of an anterior stage-15 Xenopus neurula" ;
    dct:type "simulation-result" .
}

