sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-07> a delphi:Claim ;
    rdfs:label "Morphogenetic pattern memory habituates: repeatedly amputated axolotl limbs stop regrowing" ;
    dct:description "The anatomical setpoint that guides regeneration is a pattern memory that is stable but modifiable by experience; for example, repeated amputation of axolotl limbs leads the tissue to habituate to the loss and eventually stop trying to regrow." ;
    delphi:context "Levin M, “Bioelectric networks: the cognitive glue enabling evolutionary scaling from physiology to mind”, Animal cognition (2023), doi:10.1007/s10071-023-01780-3; section “Basal cognition without neurons: what dynamic bodies think about › Memory and target morphology”. Scope: Axolotl (Ambystoma mexicanum) limb regeneration and regenerating animals generally" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1007/s10071-023-01780-3> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "This pattern memory can, like any good memory, be modified by experience (it is stable, but also labile to the right kinds of stimuli). For example, repeated amputation of axolotl limbs leads to the tissue habituating to the loss of limb and eventually giving up trying to re-grow (Bryant et al. 2017)." ;
    prov:wasQuotedFrom <https://doi.org/10.1007/s10071-023-01780-3> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=42,43> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=42,43> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt> .

