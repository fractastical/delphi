sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-collective-09> a delphi:Claim ;
    rdfs:label "Left-right randomization is concordant within an embryo except after VANGL knockdown" ;
    dct:description "Bioelectric and biochemical perturbations of vertebrate left-right patterning randomize laterality only at the level of whole embryos (each embryo's cells agree on L and R identity); the only known perturbation that breaks this concordance is down-regulation of planar-polarity VANGL signalling, which produces speckled L/R marker expression on both sides of the midline." ;
    delphi:context "McMillen P, Levin M, “Collective intelligence: A unifying concept for integrating biology across scales and substrates”, Communications biology (2024), doi:10.1038/s42003-024-06037-4; section “Introduction › Left/right, head/tail: random, but collective anatomical decisions”. Scope: Vertebrate embryos (chick, Xenopus and others) with perturbed left-right pathways" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1038/s42003-024-06037-4> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "In all of the many studies on perturbation of the LR pathway, we are aware of only one that actually breaks the concordance: disruption of the planar polarity pathway by down-regulating VANGL signaling149 leads to a speckling on both sides of the midline, consistent with individual cells within a single lateral domain disagreeing on whether they should have L or R identity (Fig. 6a–d)." ;
    prov:wasQuotedFrom <https://doi.org/10.1038/s42003-024-06037-4> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-collective.txt#line=48,49> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-collective.txt#line=48,49> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2024-collective.txt> .

