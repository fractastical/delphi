sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-06> a delphi:Claim ;
    rdfs:label "Gene regulatory network models exhibit associative learning" ;
    dct:description "Analyses of biological gene regulatory network models show that they exhibit associative and several other kinds of learning, as well as pattern completion and generalization, suggesting GRNs could be trained with patterned stimuli rather than rewired." ;
    delphi:context "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Technological Approach to Mind Everywhere: A Proposal for a Framework › Philosophical Foundations of an Approach to Diverse Intelligences”. Scope: Published ODE models of biological gene regulatory networks" ;
    dct:type "empirical-generalization" .
}

