sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-17> a delphi:Claim ;
    rdfs:label "Newt kidney tubules keep correct lumen size when cell size changes" ;
    dct:description "Newt kidney tubules normally made of 8 to 10 cells in cross-section are built from fewer cells when cell size is experimentally enlarged, and from a single cell wrapping around itself when cells are made very large, showing that different molecular mechanisms (cell-cell interactions vs cytoskeletal deformation) can be deployed to reach the same anatomical outcome." ;
    delphi:context "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Somatic Cognition: An Example of Unconventional Agency in Detail › Multi-Scale Competency of Growth and Form”. Scope: Polyploid newt larvae (Fankhauser's experiments)" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.3389/fnsys.2022.768201> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Even more remarkable than the scaling of the cell number to unexpected size changes (on an ontogenetic, not evolutionary, timescale) is the fact that if the cells are made really huge, just one cell wraps around itself and still makes a proper lumen (Figure 6D)." ;
    prov:wasQuotedFrom <https://doi.org/10.3389/fnsys.2022.768201> ;
