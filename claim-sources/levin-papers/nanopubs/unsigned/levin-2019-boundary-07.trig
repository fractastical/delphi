    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-07> a delphi:Claim ;
    rdfs:label "Disrupting or restoring cell communication should trigger or suppress cancer" ;
    dct:description "The shrinking-Self view of cancer predicts that interfering with physiological communication among cells should be able to trigger cancer and restoring it should suppress cancer, and that the relevant parameter (communication) is spread over considerable distance rather than confined to single cells as genomic damage is." ;
    delphi:context "Levin M, “The Computational Boundary of a \"Self\": Developmental Bioelectricity Drives Multicellularity and Scale-Free Cognition”, Frontiers in psychology (2019), doi:10.3389/fpsyg.2019.02688; section “Multicellularity vs. Cancer: The Shifting Boundary of the Self”. Scope: Metazoan tissues; tested so far in amphibian models" ;
    dct:type "prediction" .
}

