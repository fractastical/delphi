    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "This view predicts that interference with (or restoration of) physiological communication among cells should be able to trigger (or suppress) cancer and that the relevant parameter (communication) is spread out over considerable distance and not confined to single cells (e.g., genomic damage)." ;
