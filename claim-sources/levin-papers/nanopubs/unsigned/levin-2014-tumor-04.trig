sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2014-tumor-04> a delphi:Claim ;
    rdfs:label "High-chloride hyperpolarization suppresses KRAS tumors, so the effect is ion-independent" ;
    dct:description "Raising extracellular chloride, which hyperpolarizes cells through native chloride channels, decreases the incidence of KRASG12D-induced tumor-like structures in Xenopus laevis embryos by about 38%, showing that tumor suppression depends on the change in membrane voltage rather than on the Kv1.5 channel or on potassium specifically." ;
    delphi:context "Chernet BT, Levin M, “Transmembrane voltage potential of somatic cells controls oncogene-mediated tumorigenesis at long-range”, Oncotarget (2014), doi:10.18632/oncotarget.1935; section “RESULTS › Long-range hyperpolarization suppresses the formation of ITLS”. Scope: Xenopus laevis embryos injected with KRASG12D mRNA and raised in elevated (70 mM) chloride medium" ;
    dct:type "experimental-result" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.18632/oncotarget.1935> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-levin-papers-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Treatment with high chloride (whose uptake by native Cl− channels hyperpolarizes cells) resulted in a 37.5% decrease (N=349; t-test P<0.05) in KRASG12D ITLS, demonstrating that the suppressive effect is not specific for Kv1.5 nor for potassium, as mediators of the crucial Vmem change (Fig. 2C)." ;
    prov:wasQuotedFrom <https://doi.org/10.18632/oncotarget.1935> ;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2014-tumor.txt#line=34,35> .

  <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2014-tumor.txt#line=34,35> schema:isPartOf <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2014-tumor.txt> .

