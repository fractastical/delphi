sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-05> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Culturing Anthrobots in environments more viscous than the protocol baseline decreases both their motility and their size, suggesting that low-viscosity environments favour the growth of functional, larger bots.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Higher culture viscosity reduces Anthrobot motility and size";
    <https://w3id.org/delphi/ontology/context> "Gumuskaya G, Srivastava P, Cooper BG, Lesser H, Semegran B, Garnier S, Levin M, “Motile Living Biobots Self-Construct from Adult Human Somatic Progenitor Seed Cells”, Advanced science (Weinheim, Baden-Wurttemberg, Germany) (2024), doi:10.1002/advs.202303575; section “Results › Human Bronchial Epithelial Cells Self‐Construct into Multicellular Motile Living Architectures”. Scope: NHBE-derived Anthrobots in vitro"
}
