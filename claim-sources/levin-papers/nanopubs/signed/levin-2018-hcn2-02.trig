sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2018-hcn2-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In a BETSE bioelectric model of the stage 15 Xenopus neurula, regional differences in K+ and Cl− leak permeability open Kir channels in the neural tube, producing a Vmem of about −50 mV there while the neural folds and ectoderm stay near −5 mV, matching observed embryonic Vmem patterns.";
    dc:type "simulation-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "BETSE model: leak and Kir channels produce a hyperpolarized neural tube prepattern";
    <https://w3id.org/delphi/ontology/context> "Pai VP, Pietak A, Willocq V, Ye B, Shi NQ, Levin M, “HCN2 Rescues brain defects by enforcing endogenous voltage pre-patterns”, Nature communications (2018), doi:10.1038/s41467-018-03334-5; section “Results › Model of Vmem”. Scope: BETSE model of an anterior view of the stage 15 Xenopus neurula surface in 0.1× MMR"
}
