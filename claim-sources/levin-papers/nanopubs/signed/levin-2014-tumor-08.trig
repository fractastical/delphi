sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2014-tumor-08> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Control of oncogene-mediated tumorigenesis by resting membrane potential in Xenopus laevis is mediated by histone deacetylase 1, whose inhibition depends on butyrate produced by native gram-positive bacteria.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Vmem controls tumorigenesis via bacterially derived butyrate acting on HDAC1";
    <https://w3id.org/delphi/ontology/context> "Chernet BT, Levin M, “Transmembrane voltage potential of somatic cells controls oncogene-mediated tumorigenesis at long-range”, Oncotarget (2014), doi:10.18632/oncotarget.1935; section “RESULTS › Changes in Vmem”. Scope: Oncogene-injected Xenopus laevis embryos with hyperpolarizing treatments, antibiotic treatments and dominant-negative HDAC1"
}
