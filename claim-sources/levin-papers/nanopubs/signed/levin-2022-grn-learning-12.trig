sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "When two associative memories are trained one after another in ODE pathway models, all biological and random models show catastrophic forgetting in which both memories are lost, whereas two UCS-based memories can be stored serially or in parallel.";
    dc:type "simulation-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Serially trained associative memories cause catastrophic forgetting in pathway models";
    <https://w3id.org/delphi/ontology/context> "Biswas S, Clawson W, Levin M, “Learning in Transcriptional Network Models: Computational Discovery of Pathway-Level Memory and Effective Interventions”, International journal of molecular sciences (2022), doi:10.3390/ijms24010285; section “2. Results › 2.5. Can Networks Be Trained to Keep More Than One Memory?”. Scope: 35 BioModels pathway models and 35 size-matched random gene-circuit models"
}
