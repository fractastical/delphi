sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2024-collective-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In the frog embryo brain, downstream gene expression is driven by the spatial difference in membrane voltage between regions rather than the absolute voltage of any cells, so cells must read patterns over whole cell fields: collectivity appears in the input as well as the output of cell-group behaviour.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Frog embryo brain gene expression is driven by voltage differences, not absolute values";
    <https://w3id.org/delphi/ontology/context> "McMillen P, Levin M, “Collective intelligence: A unifying concept for integrating biology across scales and substrates”, Communications biology (2024), doi:10.1038/s42003-024-06037-4; section “Conclusion”. Scope: Xenopus laevis embryonic brain patterning"
}
