sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2018-hcn2-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In nicotine-exposed Xenopus embryos, expression of HCN2 channels enhances the neural-tube-specific hyperpolarization and restores the endogenous Vmem prepattern that nicotine otherwise suppresses, as the BETSE model predicted.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "HCN2 expression restores the neural Vmem prepattern despite nicotine";
    <https://w3id.org/delphi/ontology/context> "Pai VP, Pietak A, Willocq V, Ye B, Shi NQ, Levin M, “HCN2 Rescues brain defects by enforcing endogenous voltage pre-patterns”, Nature communications (2018), doi:10.1038/s41467-018-03334-5; section “Results › HCN2 corrects Vmem”. Scope: Xenopus laevis neurula-stage embryos exposed to nicotine, with or without Hcn2-WT mRNA"
}
