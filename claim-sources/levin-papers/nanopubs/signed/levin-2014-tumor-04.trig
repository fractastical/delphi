sub:quote a prov:Entity;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2014-tumor.txt#line=34,35>;
    prov:wasQuotedFrom <https://doi.org/10.18632/oncotarget.1935>;
    <https://schema.org/text> "Treatment with high chloride (whose uptake by native Cl− channels hyperpolarizes cells) resulted in a 37.5% decrease (N=349; t-test P<0.05) in KRASG12D ITLS, demonstrating that the suppressive effect is not specific for Kv1.5 nor for potassium, as mediators of the crucial Vmem change (Fig. 2C).".
