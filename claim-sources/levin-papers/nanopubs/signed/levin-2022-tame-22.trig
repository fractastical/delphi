sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-tame-22> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Because signals passing through gap junctions carry no marker of their cell of origin, gap-junctional coupling partially erases informational (memory) boundaries between cells, which promotes the formation of a larger Self whose parts work toward common goals.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Gap junctions merge cells into a larger Self by erasing signal ownership";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Somatic Cognition: An Example of Unconventional Agency in Detail › A Bioelectric Model of the Scaling of the Self”. Scope: Gap-junction-coupled cell collectives in metazoan tissues"
}
