sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-tame-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Stress, defined as a system-level response to the difference between current state and a setpoint, scales Selves by binding modules that sense and act at different scales and locations into one global homeostatic loop; propagated stress signals recruit distant sub-agents to act so as to reduce their own stress.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Stress binds distributed modules into one larger homeostatic loop";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Technological Approach to Mind Everywhere: A Proposal for a Framework › Specific Conceptual Components of the Technological Approach to Mind Everywhere Framework”. Scope: Multicellular organisms and other multi-scale agents"
}
