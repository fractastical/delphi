sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2014-tumor-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Tumor-like structures induced in Xenopus laevis tadpoles by human oncogenes such as mutant KRAS display overproliferation, increased nuclear size, hypoxia, intracellular acidity and leukocyte attraction, hallmarks shared with classic human tumors.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Oncogene-induced tumor-like structures in Xenopus share hallmarks of human tumors";
    <https://w3id.org/delphi/ontology/context> "Chernet BT, Levin M, “Transmembrane voltage potential of somatic cells controls oncogene-mediated tumorigenesis at long-range”, Oncotarget (2014), doi:10.18632/oncotarget.1935; section “Abstract”. Scope: Induced tumor-like structures (ITLS) in Xenopus laevis embryos injected with Xrel3, Gli1 or KRASG12D mRNA"
}
