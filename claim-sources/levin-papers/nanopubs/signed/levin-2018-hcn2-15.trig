sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2018-hcn2-15> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Nicotine reduces or mispatterns expression of the forebrain/midbrain transcription factors otx2 and xbf1 in Xenopus embryos, and Hcn2-WT mRNA injection restores their normal expression, linking HCN2-mediated repair to the known genetic cascade of brain patterning.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "HCN2 rescue corrects otx2 and xbf1 expression after nicotine";
    <https://w3id.org/delphi/ontology/context> "Pai VP, Pietak A, Willocq V, Ye B, Shi NQ, Levin M, “HCN2 Rescues brain defects by enforcing endogenous voltage pre-patterns”, Nature communications (2018), doi:10.1038/s41467-018-03334-5; section “Results › HCN2 restores marker expression in nicotine-treated embryos”. Scope: Xenopus laevis embryos at stage 25, nicotine-exposed from stage 10, with or without Hcn2-WT mRNA"
}
