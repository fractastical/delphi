sub:quote a prov:Entity;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=46,47>;
    prov:wasQuotedFrom <https://doi.org/10.1007/s10071-023-01780-3>;
    <https://schema.org/text> "Remarkably, when cut again in multiple subsequent rounds of regeneration (with no further manipulation), the fragments continue to result in two-headed animals. This shift in the target morphology for regeneration is permanent (unless the animal’s bioelectric pattern memory is reset back to a one-headed state by an experimental manipulation).".
