sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-11> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In the surveyed ODE pathway models with UCS-based memory, most networks retain the bulk of their memories over waiting periods up to 100 times the initial one, and testing (recalling) a memory generally does not destroy it and in rare cases strengthens it.";
    dc:type "simulation-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Most pathway-model memories persist over long periods and survive recall";
    <https://w3id.org/delphi/ontology/context> "Biswas S, Clawson W, Levin M, “Learning in Transcriptional Network Models: Computational Discovery of Pathway-Level Memory and Effective Interventions”, International journal of molecular sciences (2022), doi:10.3390/ijms24010285; section “2. Results › 2.4. Memory Effects Are Stable over Long Periods”. Scope: 30 ODE pathway models from BioModels showing UCS-based memory"
}
