sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-13> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Memory in the surveyed pathway models shows no privileged association with any class of organism (bacteria, slime mould, yeast, plants, lower vertebrates, mammals), being distributed roughly uniformly, which may suggest that proto-cognitive capacity is found across many strata of life.";
    dc:type "simulation-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Pathway memory is distributed uniformly across organism classes";
    <https://w3id.org/delphi/ontology/context> "Biswas S, Clawson W, Levin M, “Learning in Transcriptional Network Models: Computational Discovery of Pathway-Level Memory and Effective Interventions”, International journal of molecular sciences (2022), doi:10.3390/ijms24010285; section “2. Results › 2.5. Can Networks Be Trained to Keep More Than One Memory?”. Scope: 35 BioModels pathway models grouped by source organism"
}
