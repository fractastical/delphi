sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2018-hcn2-07> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The BETSE model predicts that uniformly expressed HCN2 channels, which open at hyperpolarized Vmem and so amplify small Vmem gradients, open preferentially in the Xenopus neural tube and maintain its hyperpolarized Vmem pattern even in nicotine-exposed model embryos.";
    dc:type "simulation-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "BETSE model predicts HCN2 maintains the neural tube Vmem pattern despite nicotine";
    <https://w3id.org/delphi/ontology/context> "Pai VP, Pietak A, Willocq V, Ye B, Shi NQ, Levin M, “HCN2 Rescues brain defects by enforcing endogenous voltage pre-patterns”, Nature communications (2018), doi:10.1038/s41467-018-03334-5; section “Results › BETSE model identifies HCN2 channel as a repair reagent”. Scope: BETSE model of the Xenopus neurula with HCN2 channels (mouse kinetics, Na+:K+ permeability ratio 0.2) and nicotine"
}
