sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2023-agential-04> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Basal cellular competencies were not lost in the transition to multicellularity but scaled up into collective intelligence; gap-junctional merging of intracellular milieus and other tissue-level signalling (e.g. stress propagation) share chemical engrams, erase the individuality of cells, and enlarge the memory, predictive capacity and sensory/effector radius of cell networks so they can pursue larger goal states such as anatomical targets.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Gap-junction coupling scales cell competencies into larger collective goal states";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Darwin's agential materials: evolutionary implications of multiscale competency in developmental biology”, Cellular and molecular life sciences : CMLS (2023), doi:10.1007/s00018-023-04790-z; section “Scaling up from cellular competency to collective intelligence”. Scope: Multicellular tissues coupled by gap junctions"
}
