sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2015-place-05> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In the active-inference simulation, identical undifferentiated cells starting at one location migrate rapidly to their target locations and then differentiate (around the eighth time step) into head, body and tail types as ensemble free energy falls, showing cells can resolve ambiguity about their fate even when it depends on context set by other equally ambiguous cells.";
    dc:type "simulation-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Simulated cells resolve fate ambiguity using context set by other ambiguous cells";
    <https://w3id.org/delphi/ontology/context> "Friston K, Levin M, Sengupta B, Pezzulo G, “Knowing one's place: a free-energy approach to pattern regulation”, Journal of the Royal Society, Interface (2015), doi:10.1098/rsif.2014.1383; section “Simulating self-assembly”. Scope: Active-inference simulation of eight cells forming a head–body–tail morphology"
}
