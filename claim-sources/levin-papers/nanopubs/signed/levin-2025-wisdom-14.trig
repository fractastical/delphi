sub:quote a prov:Entity;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2025-wisdom.txt#line=96,97>;
    prov:wasQuotedFrom <https://doi.org/10.1002/bies.202400196>;
    <https://schema.org/text> "Each reduction in physiological connectivity makes it easier for cells to perform computations at the local level. This makes it easier for cells to close off gap junctions even more, driving a positive feedback loop—a cycle of dissociation and isolation that makes it ever harder to achieve large‐scale cell collective goals (maintaining complex anatomical structure).".
