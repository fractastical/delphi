sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-tame-21> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Because ion channels and gap junctions are themselves voltage-sensitive, a transient voltage state can trigger progressive depolarization or gap-junction closure, so non-neural bioelectric circuits readily form dynamical-system memories that store information and change computation without changing the channel or junction hardware.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Voltage-sensitive channels and gap junctions form rewritable dynamical memories";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Somatic Cognition: An Example of Unconventional Agency in Detail › Non-neural Bioelectricity: What Bodies Think About”. Scope: Non-neural cell networks coupled by voltage-gated channels and gap junctions"
}
