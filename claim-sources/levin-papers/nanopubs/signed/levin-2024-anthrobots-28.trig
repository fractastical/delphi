sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-28> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Anthrobots may be generable from other ciliated human cells, such as oviductal epithelium or brain ependymal cells, and non-ciliated cell types could be used for bots that need no autonomous motility.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Anthrobots may be made from other ciliated human cells such as oviduct or ependyma";
    <https://w3id.org/delphi/ontology/context> "Gumuskaya G, Srivastava P, Cooper BG, Lesser H, Semegran B, Garnier S, Levin M, “Motile Living Biobots Self-Construct from Adult Human Somatic Progenitor Seed Cells”, Advanced science (Weinheim, Baden-Wurttemberg, Germany) (2024), doi:10.1002/advs.202303575; section “Conclusion”. Scope: Ciliated and non-ciliated adult human cell types"
}
