sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2024-memory-11> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In silico simulations show how lineages such as planarian flatworms can become extremely resistant to transgenesis, ageing, cancer and injury despite very noisy genomes because they commit to a strategy that overrides genetic details with large-scale pattern completion.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Planaria resist cancer and ageing despite noisy genomes via pattern completion";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Self-Improvising Memory: A Perspective on Memories as Agential, Dynamically Reinterpreting Cognitive Glue”, Entropy (Basel, Switzerland) (2024), doi:10.3390/e26060481; section “4. Beyond the Brain: Bowties Everywhere”. Scope: Planarian flatworms (e.g. Schmidtea mediterranea) and in silico evolutionary models"
}
