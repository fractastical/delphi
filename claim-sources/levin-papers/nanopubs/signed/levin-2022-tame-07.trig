sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-tame-07> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "TAME defines the hallmarks of a Self as the ability to pursue goals, to own compound (e.g. associative) memories, and to serve as the locus of credit assignment (reward or punishment), each at a scale larger than any of its components can achieve alone.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "A Self is marked by goals, compound memories and credit assignment above its parts";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Technological Approach to Mind Everywhere: A Proposal for a Framework › Specific Conceptual Components of the Technological Approach to Mind Everywhere Framework”. Scope: Any agent, biological or engineered"
}
