sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2015-place-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "When the partially differentiated simulated embryo is cut in two and each half's cells are replicated, the cells undergo slight dedifferentiation and then each half regenerates the complete head–body–tail target morphology, illustrating pluripotency and recovery from drastic interventions in the active-inference model.";
    dc:type "simulation-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Bisected simulated embryos regenerate the full target form";
    <https://w3id.org/delphi/ontology/context> "Friston K, Levin M, Sengupta B, Pezzulo G, “Knowing one's place: a free-energy approach to pattern regulation”, Journal of the Royal Society, Interface (2015), doi:10.1098/rsif.2014.1383; section “Simulating regeneration and dysmorphogenesis”. Scope: Active-inference morphogenesis simulation (analogous to planarian or regulative embryo bisection)"
}
