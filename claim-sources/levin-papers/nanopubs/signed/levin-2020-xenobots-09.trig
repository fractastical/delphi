sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2020-xenobots-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Reconfigurable organisms built from Xenopus cells maintain their externally imposed shape and also self-repair after damage, for example automatically closing lacerations.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Reconfigurable organisms self-repair, closing lacerations";
    <https://w3id.org/delphi/ontology/context> "Kriegman S, Blackiston D, Levin M, Bongard J, “A scalable pipeline for designing reconfigurable organisms”, Proceedings of the National Academy of Sciences of the United States of America (2020), doi:10.1073/pnas.1910837117; section “Discussion”. Scope: Xenopus laevis reconfigurable organisms"
}
