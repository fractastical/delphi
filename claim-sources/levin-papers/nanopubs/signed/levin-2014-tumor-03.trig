sub:quote a prov:Entity;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2014-tumor.txt#line=34,35>;
    prov:wasQuotedFrom <https://doi.org/10.18632/oncotarget.1935>;
    <https://schema.org/text> "Kv1.5-induced long-distance hyperpolarization was also able to significantly suppress Xrel3 and Gli1 ITLS formation by 34.9% (N=225; t-test, P<0.05) and 29.4% (N=292; t-test, P<0.05), respectively (Fig. 2C), suggesting the effect is not specific for just one type of oncogene.".
