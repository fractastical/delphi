sub:quote a prov:Entity;
    prov:hadPrimarySource <https://raw.githubusercontent.com/fractastical/delphisci/2404c437f822e1c98420130cd01e7972acf3ac57/books/levin-papers/inputs/2023-glue.txt#line=42,43>;
    prov:wasQuotedFrom <https://doi.org/10.1007/s10071-023-01780-3>;
    <https://schema.org/text> "This pattern memory can, like any good memory, be modified by experience (it is stable, but also labile to the right kinds of stimuli). For example, repeated amputation of axolotl limbs leads to the tissue habituating to the loss of limb and eventually giving up trying to re-grow (Bryant et al. 2017).".
