sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2023-glue-07> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The anatomical setpoint that guides regeneration is a pattern memory that is stable but modifiable by experience; for example, repeated amputation of axolotl limbs leads the tissue to habituate to the loss and eventually stop trying to regrow.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Morphogenetic pattern memory habituates: repeatedly amputated axolotl limbs stop regrowing";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Bioelectric networks: the cognitive glue enabling evolutionary scaling from physiology to mind”, Animal cognition (2023), doi:10.1007/s10071-023-01780-3; section “Basal cognition without neurons: what dynamic bodies think about › Memory and target morphology”. Scope: Axolotl (Ambystoma mexicanum) limb regeneration and regenerating animals generally"
}
