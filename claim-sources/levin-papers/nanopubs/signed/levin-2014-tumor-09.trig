sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2014-tumor-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The authors speculate that long-range bioelectric connections in tumorigenesis are bidirectional, so that in addition to remote tissue voltage influencing tumor growth, tumors may emit bioelectric information that could be detected at a distance.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Tumors may themselves emit bioelectric information detectable at a distance";
    <https://w3id.org/delphi/ontology/context> "Chernet BT, Levin M, “Transmembrane voltage potential of somatic cells controls oncogene-mediated tumorigenesis at long-range”, Oncotarget (2014), doi:10.18632/oncotarget.1935; section “DISCUSSION › Long-range control of tumorigenic process by Vmem”. Scope: Tumor–host bioelectric signaling, to be tested with molecular reagents in Xenopus and other models"
}
