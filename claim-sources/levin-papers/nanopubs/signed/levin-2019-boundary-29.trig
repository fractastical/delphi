sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2019-boundary-29> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Bioelectrics should be widely conserved in regeneration across kingdoms: transcriptomes of regeneration from damaged bacterial biofilms to plants to animal limb and organ regeneration should show consistent use of electrogenic proteins, and neurotransmitter signalling should be conserved enough that cognitive-modulator drugs affect biofilms and Physarum.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Regeneration across kingdoms should consistently use electrogenic proteins";
    <https://w3id.org/delphi/ontology/context> "Levin M, “The Computational Boundary of a \"Self\": Developmental Bioelectricity Drives Multicellularity and Scale-Free Cognition”, Frontiers in psychology (2019), doi:10.3389/fpsyg.2019.02688; section “Predictions and Research Program”. Scope: Regeneration in bacterial biofilms, plants and animals"
}
