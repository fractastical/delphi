sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2023-agential-05> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Frog (Xenopus) embryonic epithelial cells, which in vivo form a passive protective outer layer, instead form Xenobots (functional, self-motile constructs with novel behaviours) when liberated from the instructive influences of other cells, showing that such behaviours are normally suppressed by signalling from neighbouring cells during development.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Freed from embryonic signals, frog skin cells form self-motile Xenobots";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Darwin's agential materials: evolutionary implications of multiscale competency in developmental biology”, Cellular and molecular life sciences : CMLS (2023), doi:10.1007/s00018-023-04790-z; section “Scaling up from cellular competency to collective intelligence”. Scope: Xenopus laevis embryonic ectoderm explants"
}
