sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2023-competency-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Because planaria reproduce by fission and regeneration and so retain somatic mutations, they have a very messy, mixoploid genome, yet they have highly reliable anatomy, with every fragment regenerating a normal worm.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Planaria combine a messy mixoploid genome with highly reliable anatomy";
    <https://w3id.org/delphi/ontology/context> "Shreesha L, Levin M, “Cellular Competency during Development Alters Evolutionary Dynamics in an Artificial Embryogeny Model”, Entropy (Basel, Switzerland) (2023), doi:10.3390/e25010131; section “1. Introduction”. Scope: Asexual, fissiparous planarians (e.g. Schmidtea mediterranea asexual strain)"
}
