sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2019-boundary-03> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Regulative development and regeneration (e.g. scrambled tadpole faces that still become normal frog faces, tail grafts remodelling into limbs, kidney tubules of constant diameter despite enlarged cells) show that somatic cells pursue specific target morphologies despite perturbation, with set points that are large organ-level macrostates not defined at the single-cell level.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Cell collectives pursue organ-level target morphologies despite perturbation";
    <https://w3id.org/delphi/ontology/context> "Levin M, “The Computational Boundary of a \"Self\": Developmental Bioelectricity Drives Multicellularity and Scale-Free Cognition”, Frontiers in psychology (2019), doi:10.3389/fpsyg.2019.02688; section “Body Patterning and Cognition: A Common Origin”. Scope: Regulative development and regeneration in vertebrates (Xenopus, salamanders, axolotls, newts)"
}
