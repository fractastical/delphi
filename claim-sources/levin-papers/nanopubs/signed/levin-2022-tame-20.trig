sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-tame-20> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "TAME predicts (not yet tested) that the collective intelligence of tissues may be trainable by reinforcement learning, using rewards and punishments such as nutrients, endorphins or shock, to produce specific morphological or gene-expression outcomes.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Morphogenesis should be trainable by reinforcement for specific anatomical outcomes";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Somatic Cognition: An Example of Unconventional Agency in Detail › Not Just Philosophy: Why These Parallels Matter”. Scope: Regenerating or developing animal tissues; clinical settings"
}
