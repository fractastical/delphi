sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2023-agential-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Evolution discovered very early, around the time of bacterial biofilms, that electrical networks of ion channels and pumps are a convenient way to integrate and process information across space and time and to scale the functions of individual cells toward large-scale tasks, the same reason brains use this modality.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Bioelectric networks were exploited for information integration since bacterial biofilms";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Darwin's agential materials: evolutionary implications of multiscale competency in developmental biology”, Cellular and molecular life sciences : CMLS (2023), doi:10.1007/s00018-023-04790-z; section “Bioelectric control: a mechanism for scaling cell behaviors to large-scale morphogenetic goals”. Scope: Bacteria through metazoans"
}
