sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2018-hcn2-14> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In an automated red-light avoidance assay, only about 12% of nicotine-exposed Xenopus tadpoles learned, versus 100% of controls, and about 85% of nicotine-exposed tadpoles injected with Hcn2-WT mRNA learned.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "HCN2 restores learning in nicotine-exposed tadpoles";
    <https://w3id.org/delphi/ontology/context> "Pai VP, Pietak A, Willocq V, Ye B, Shi NQ, Levin M, “HCN2 Rescues brain defects by enforcing endogenous voltage pre-patterns”, Nature communications (2018), doi:10.1038/s41467-018-03334-5; section “Results › HCN2 restores learning in nicotine-exposed larvae”. Scope: Morphologically normal Xenopus laevis tadpoles exposed to nicotine as embryos, with or without Hcn2-WT mRNA"
}
