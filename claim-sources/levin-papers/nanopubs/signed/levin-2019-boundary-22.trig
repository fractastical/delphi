sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2019-boundary-22> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Agents evolved by scaling up from basic homeostatic loops (whose set points are the first goals), driven by surprise minimization, through the successive addition of delays (memory), anticipation (inference), and spatially distributed networks that allow learning and abstraction.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Agents scaled up from homeostatic loops by adding memory, anticipation and networks";
    <https://w3id.org/delphi/ontology/context> "Levin M, “The Computational Boundary of a \"Self\": Developmental Bioelectricity Drives Multicellularity and Scale-Free Cognition”, Frontiers in psychology (2019), doi:10.3389/fpsyg.2019.02688; section “Conclusion and Future Outlook”. Scope: Evolution of agency from early living systems to complex organisms"
}
