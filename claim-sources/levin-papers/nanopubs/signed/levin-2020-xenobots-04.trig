sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2020-xenobots-04> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "When the environment contains particulate matter, motile designs spontaneously gather the particles into aggregates, both in simulation and as living Xenopus-cell organisms.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Motile designs spontaneously aggregate particles in simulation and in vivo";
    <https://w3id.org/delphi/ontology/context> "Kriegman S, Blackiston D, Levin M, Bongard J, “A scalable pipeline for designing reconfigurable organisms”, Proceedings of the National Academy of Sciences of the United States of America (2020), doi:10.1073/pnas.1910837117; section “Results › Object Manipulation.”. Scope: Xenopus reconfigurable organisms and their simulated counterparts in a particle-strewn dish"
}
