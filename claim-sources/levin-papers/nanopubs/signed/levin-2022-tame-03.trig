sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2022-tame-03> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Xenopus tadpoles engineered to have eyes on their tails instead of their heads are still readily able to perform visual learning tasks, illustrating that minds readily adapt to radically altered body architectures.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Tadpoles with eyes on their tails can still perform visual learning";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds”, Frontiers in systems neuroscience (2022), doi:10.3389/fnsys.2022.768201; section “Cognition: Changing the Subject”. Scope: Xenopus laevis tadpoles with ectopic eyes transplanted to the tail and native eyes removed"
}
