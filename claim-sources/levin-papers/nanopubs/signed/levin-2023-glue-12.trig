sub:assertion {
<https://w3id.org/delphi/resource/claim/levin-2023-glue-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Like parasites that manipulate host neurobehavioural systems, commensal bacteria can override the default planarian morphogenetic control system and cause two-headed regeneration.";
    dc:type "experimental-result";
    <http://www.w3.org/2000/01/rdf-schema#label> "Commensal bacteria can hijack planarian morphogenesis to cause two-headed regeneration";
    <https://w3id.org/delphi/ontology/context> "Levin M, “Bioelectric networks: the cognitive glue enabling evolutionary scaling from physiology to mind”, Animal cognition (2023), doi:10.1007/s10071-023-01780-3; section “Basal cognition without neurons: what dynamic bodies think about › Reprogrammability, external manipulation, and representation”. Scope: Planarian flatworms and their commensal microbiota (Williams et al. 2020)"
}
