sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2014-tumor-01--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2014-tumor-01: partially-resolvable, resolvability 0.51";
    dc:description "Remote hyperpolarization versus tumor incidence is a concrete contrast, and the paper publishes the summary rates for more than one oncogene. Those summaries can be checked for direction and reported significance. They cannot be recomputed from raw embryos, and they cover one amphibian assay rather than tumorigenesis in general, so the broad claim is only partly resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Score tumor-like-structure incidence when oncogene mRNA and a hyperpolarizing reagent are placed in separate blastomeres, with voltage confirmed at the remote site. A lower incidence only when the remote site is hyperpolarized would support a long-range voltage requirement; no change, or a requirement for local voltage only, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Blastomere separation is a fate-map proxy for distance, and mRNA injections carry nonspecific effects.", "Embryo-level voltage and tumor scores are not in a public file.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2014-tumor-01--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.511"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2014-tumor-01--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Long-range Vmem control of tumorigenesis";
    dc:description "published incidence contrasts, sample sizes, and p-values for remote hyperpolarization in Xenopus; embryo-level tables are not deposited";
    prov:wasDerivedFrom <https://doi.org/10.18632/oncotarget.1935>.
<https://w3id.org/delphi/resource/assessment/levin-2014-tumor-01--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2014-tumor-01 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-01--grok>.
