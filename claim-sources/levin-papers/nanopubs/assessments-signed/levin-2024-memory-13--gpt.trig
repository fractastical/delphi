<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-13--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2024-memory-13: partially-resolvable, resolvability 0.43";
    dc:description "The ratchet makes measurable predictions in models, and some existing simulations may permit analysis. Its organism-wide evolutionary interpretation is underspecified and difficult to distinguish from robustness, drift and network-complexity alternatives.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In evolutionary simulations, vary compensatory competency while holding mutation and selection regimes fixed, and measure selection gradients on structural versus competency loci over time. The proposed ratchet predicts weaker selection on structural quality and increasing investment in compensatory mechanisms.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Comparative genomic evidence does not directly expose historical selection visibility.", "Competency and structural loci must be imposed by the modeler.", "Simulation confirmation may reflect model assumptions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-memory-13--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2024-memory-13--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.435"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
