sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-grn-learning-18: resolvable-now, resolvability 0.79";
    dc:description "Both breaking assays use an explicit ratio rule and a third-node search, and the code covers sensitization as well as pharmacoresistance. Re-running them yields the 8-of-27 count and the pair-fraction comparison directly. The remark about therapies needing other avenues is an interpretation of that same rate difference.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On each sensitizing model, apply the third-node breaking protocol and record whether the 1.5-fold rise is abolished, and for what fraction of pairs. Breaks confined to 8 of 27 models and mostly under 5 percent of pairs, at a lower rate than habituation breaking, would confirm the claim; breaks in most models or in large pair fractions would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The comparison with habituation uses the same style of search, but the pair denominators differ across models.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-18--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.788"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GRN_ODE";
    dc:description "sensitization-breaking trials comparable to the habituation-breaking trials";
    prov:wasDerivedFrom <https://github.com/wesleypclawson/GRN_ODE>.
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-18--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "ODE models in which third-node interventions are simulated";
    prov:wasDerivedFrom <https://www.biomodels.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-grn-learning-18 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
