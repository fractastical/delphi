sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2024-collective-09: partially-resolvable, resolvability 0.52";
    dc:description "Within-embryo concordance of left-right markers is visible in a large published in situ literature, and Xenbase indexes the Xenopus share of it, including VANGL. Extracting speckling versus isomerism across that literature is weeks to months of figure scoring, not a download of one table. Publication bias and an open-ended study list keep the 'only one perturbation' clause only partly decidable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across published left-right perturbations, score whether each embryo's lateral markers are concordant (situs solitus, inversus or isomerism) or speckled within a side, and treat VANGL knockdown as the proposed exception. Finding speckled discs under other published treatments would refute uniqueness; concordant outcomes everywhere except the VANGL reports would support the survey claim as far as the sampled literature goes.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Concordant situs classes are what papers usually score, so speckling can be under-reported.", "Marker speckles can be staining noise rather than cells disagreeing about identity.", "The survey is bounded by studies the authors know, not by a pre-registered sample.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.521"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-collective-09 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-collective-09--grok>.
