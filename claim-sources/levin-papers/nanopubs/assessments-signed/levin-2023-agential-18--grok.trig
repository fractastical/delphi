sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-agential-18: partially-resolvable, resolvability 0.63";
    dc:description "The contrast with flies and mice is directly queryable in phenotype databases, and planarian strain reports are public literature. That is enough to test a claim about what is known, including the bioelectric origin of the familiar two-headed lines. It is not a complete census of stocks, and the competency-ratchet explanation of the absence is not tested by the search.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Search FlyBase, Mouse Genome Informatics, and the planarian literature for stable inherited strains whose anatomy differs from wild type in the absence of ongoing RNAi or drug treatment. Morphological mutant strains in flies and mice, and at least one published planarian strain of that kind, would refute the negative planarian clause; a documented absence of such planarian strains, with the only permanent abnormal lines being the bioelectric one-head and two-head forms, would support it as a statement about the public record.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A literature search can refute the negative claim by finding a strain, but cannot prove that no unpublished strain exists.", "RNAi phenotypes and transient drug phenotypes are easy to mistake for mutant strains.", "Transgenesis attempts after the paper's publication can change the public record without a single dedicated database.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.628"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FlyBase";
    dc:description "catalog of Drosophila strains with abnormal morphology, the contrast class";
    prov:wasDerivedFrom <https://flybase.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Mouse Genome Informatics";
    dc:description "catalog of mouse mutant alleles and phenotypes, the other contrast class";
    prov:wasDerivedFrom <https://www.informatics.jax.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PubMed";
    dc:description "index of planarian genetics papers through which a stable morphological mutant strain would be found";
    prov:wasDerivedFrom <https://pubmed.ncbi.nlm.nih.gov/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-agential-18 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-18--grok>.
