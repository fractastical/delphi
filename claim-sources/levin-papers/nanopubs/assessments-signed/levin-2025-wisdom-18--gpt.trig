    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-18--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2025-wisdom-18: partially-resolvable, resolvability 0.47";
    dc:description "Public cancer resources can compare genetic and physiological correlates and test restricted intervention responses. They cannot support the sweeping dominance conclusion or clinical implication without matched causal trials across heterogeneous cancers.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across cancer models, compare outcome variance explained and causal rescue achieved by physiological-state interventions versus genotype, stratifying by tumour type and mutation. Consistent normalization despite persistent driver mutations would support a restricted dominance claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dominates outcomes is undefined across cancer types.", "Observational clinical data confound genotype and physiology.", "Xenopus normalization does not establish a human therapeutic roadmap.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-18--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-18--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.47"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-18--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Genomic Data Commons";
    dc:description "public tumour genomic and clinical outcome data";
    prov:wasDerivedFrom <https://portal.gdc.cancer.gov/>.
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-18--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
