sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-competency-12--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-competency-12: partially-resolvable, resolvability 0.74";
    dc:description "The public experiment can plot how often the competency gene changes relative to structural genes, so the reported inequality is re-computable. That inequality does not cleanly mean evolution works on competency more, because one wide-ranged competency locus is not comparable to fifty structural loci without a normalization the claim does not apply. The raw count is testable; the effort interpretation is confounded.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In the evolvable-competency runs, attribute each positional change to either the competency allele or one of the fifty structural genes and compare change frequencies. A significantly higher competency-gene rate would reproduce the count; similar rates would refute it. The comparison still has to rule out an artifact of the allele's numeric range.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A competency allele ranging toward 500 can register more changes than a positional gene for mechanical reasons.", "Mutation rate and representation are not matched per locus in a way that isolates evolutionary effort.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-competency-12--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-competency-12--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: CellularCompetency";
    dc:description "frequency comparison of competency-gene versus structural-gene changes";
    prov:wasDerivedFrom <https://github.com/lksshw/CellularCompetency>.
<https://w3id.org/delphi/resource/assessment/levin-2023-competency-12--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-competency-12 by Grok 4.7: 0.68";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.68"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-competency-12--grok>.
