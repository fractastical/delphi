    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2025-wisdom-01: partially-resolvable, resolvability 0.66";
    dc:description "Public sequence data and extensive regeneration evidence resolve major descriptive components. Cancer resistance, absence of ageing and the claimed contradiction of a genome-driven paradigm have weaker or nonstandardized coverage, limiting a full test.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify planarian somatic ploidy and genomic heterogeneity, regeneration success, neoplasm incidence and age-related functional decline, and compare them with preregistered taxa and genome-instability predictions. The descriptive conjunction is supported if high instability coexists with exceptional repair and low senescence and cancer.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Apparently do not age is stronger than available lifespan evidence.", "Cancer incidence in wild and laboratory planaria is poorly sampled.", "The paradigm prediction is not quantitatively specified.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "public planarian genomic and transcriptomic sequencing reads";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Genome";
    dc:description "public planarian genome assemblies and annotations";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genome/>.
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AnAge";
    dc:description "comparative longevity and ageing records";
    prov:wasDerivedFrom <https://genomics.senescence.info/species/>.
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
