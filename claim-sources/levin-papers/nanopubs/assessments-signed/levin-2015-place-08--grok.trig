sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-place-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-place-08: needs-new-data, resolvability 0.32";
    dc:description "Neural recordings and DCM software are public, so one side of the proposed comparison can be prepared. The claim is about dynamics shared with bioelectric patterning networks, and those tissue voltage time series are not in an open dataset. Until they are, the comparison cannot be run.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit the same dynamic-causal-model class to neural time series and to time-resolved bioelectric recordings from non-neural tissue during patterning, then compare model evidence. Shared structure that beats unstructured alternatives would support the proposed commonality; a systematic failure on morphogenesis recordings would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Public morphogenesis voltage time series with the sampling DCM needs are not deposited.", "Significant commonality is not given a numerical model-comparison threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-place-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-08--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.321"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2015-place-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OpenNeuro";
    dc:description "public neural time series on which dynamic causal models are already fit";
    prov:wasDerivedFrom <https://openneuro.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2015-place-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Statistical Parametric Mapping";
    dc:description "public implementation of dynamic causal modelling for the neural side of the comparison";
    prov:wasDerivedFrom <https://www.fil.ion.ucl.ac.uk/spm/>.
<https://w3id.org/delphi/resource/assessment/levin-2015-place-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2015-place-08 by Grok 4.7: 0.38";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
