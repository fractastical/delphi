sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-25--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2024-anthrobots-25: needs-new-data, resolvability 0.33";
    dc:description "Superbot size versus the number of input bots, and fusion versus basal-surface exposure, are both countable. The paper describes the control and the time window without releasing the counts or a basal-marker time series. Timing after dissolution is not itself a measurement of exposed basal layers, so the mechanism clause needs data that are not public.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Vary the number of bots per well in the days after matrix release and measure superbot size, and compare fusion rates while a basal marker is still on the surface versus after the surface is apical. Size scaling with bot number, and fusion restricted to the basal-exposed window, would support both clauses; size independent of number, or fusion after basal markers are covered, would refute them.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Basal exposure is inferred from time since dissolution rather than from a paired basal-marker series.", "Fusion counts versus bot number are not deposited.", "Well crowding can change fusion without any special role for the basal surface.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.327"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-25--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-anthrobots-25 by Grok 4.7: 0.18";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.18"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-25--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-25--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
