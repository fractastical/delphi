sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-tame-06: partially-resolvable, resolvability 0.67";
    dc:description "The models themselves are public, in Cell Collective and BioModels, and a later ODE analysis has open code, so a defined pairing protocol can be re-run. The flagship Boolean analysis did not release its code, and the cited papers do not share one decision rule. A new screen can test learning capacity in the published models and will not automatically reproduce each cited result.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On published GRN models, pair a cue with an outcome-producing stimulus and test whether the cue later changes the response relative to unpaired controls; associative learning, pattern completion, or generalization holds if the paired network meets that criterion and a shuffled network does not.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Associative learning, pattern completion, and generalization are defined differently across the cited papers.", "Code for the 2021 Boolean memory screen was withheld, so the exact published runs cannot be replayed.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.67"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cell Collective";
    dc:description "public Boolean gene-regulatory models, including the networks used in the cited memory surveys";
    prov:wasDerivedFrom <https://cellcollective.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "public ODE models of biological pathways that can be re-simulated for stimulus-pairing tests";
    prov:wasDerivedFrom <https://www.biomodels.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GRN_ODE";
    dc:description "code for a follow-up memory screen of continuous BioModels networks";
    prov:wasDerivedFrom <https://github.com/wesleypclawson/GRN_ODE>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-tame-06 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
