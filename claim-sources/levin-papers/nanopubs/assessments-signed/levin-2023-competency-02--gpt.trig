    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-competency-02: partially-resolvable, resolvability 0.65";
    dc:description "Public planarian resources and literature can test genomic heterogeneity and regeneration robustness in subsets. They are unlikely to justify the absolute formulation across all fragments and conditions.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify cell-to-cell karyotype and sequence variation in fissiparous planaria and compile regeneration outcomes by fragment position and condition. The conjunction requires high genomic heterogeneity and consistently normal regenerated anatomy despite it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Every fragment' is an overbroad universal.", "Mixoploidy requires cell-resolved karyotype data not standard bulk sequencing.", "Published regeneration reports under-sample failures and adverse conditions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-competency-02--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.649"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
