<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-agential-06: partially-resolvable, resolvability 0.48";
    dc:description "Sequence and functional databases permit restricted ancestral reconstructions and modern biofilm tests. They cannot resolve evolutionary purpose or cleanly date the proposed discovery, so only mechanistic continuity is presently testable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct the phylogenetic distribution and ancestral functions of ion channels, pumps, and electrical coordination, and compare biofilm-level spatial information integration with later metazoan uses. Support requires early origin plus evidence that networked information processing, not merely ion homeostasis, was ancestral.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ancient function must be inferred from modern lineages.", "Electrical coordination and information processing can be defined circularly.", "The timing 'around bacterial biofilms' is imprecise.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-06--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.482"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-06--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: UniProt";
    dc:description "public protein sequences and functional annotations for ion-channel and pump phylogenies";
    prov:wasDerivedFrom <https://www.uniprot.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-06--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
