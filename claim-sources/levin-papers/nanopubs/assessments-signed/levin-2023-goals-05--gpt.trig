sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-05--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-goals-05: resolvable-now, resolvability 0.92";
    dc:description "The absence of direct long-horizon selection and subsequent stability are inspectable in public code and reruns. The result is resolvable for this model, although 'need not be selected for' means no explicit rather than no indirect selection.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Verify that fitness was evaluated only through 100 steps, then run independently evolved tissues to 1000 steps and track pattern accuracy and survival. Compare with controllers explicitly selected for longevity to assess whether long-term maintenance emerges without direct selection.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "One long-lived controller does not establish a general property.", "Selection for 100-step performance may indirectly favor stable dynamics.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.92"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-goals-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-goals-05--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.917"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2023-goals-05--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: scalefreecognition code repository";
    dc:description "public evolution code and long-horizon simulation";
    prov:wasDerivedFrom <https://github.com/LPioL/scalefreecognition>.
<https://w3id.org/delphi/resource/evidence/levin-2023-goals-05--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: The scaling of goals article and supplements";
    dc:description "training horizon, parameters, and reported 1000-step behavior";
    prov:wasDerivedFrom <https://doi.org/10.1098/rsfs.2022.0072>.
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-05--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-goals-05 by GPT-5.6 Sol: 0.88";
