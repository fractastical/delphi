    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2014-tumor-10: partially-resolvable, resolvability 0.61";
    dc:description "The use of potassium- and chloride-based interventions partially separates voltage from a specific channel. Coverage is too narrow and voltage matching too incomplete to establish resting potential as the general causal variable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare tumor suppression across several channels and ion species after matching achieved Vmem, and test whether Vmem predicts incidence better than channel identity. Divergent effects at matched voltage would refute the systems-level formulation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ion-specific off-target effects remain.", "Matched quantitative Vmem values across treatments are limited.", "Only a small set of channels and ionic manipulations is represented.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2014-tumor-10--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.608"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
