sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2025-wisdom-08: partially-resolvable, resolvability 0.69";
    dc:description "The channelopathy half can be tested now with standard enrichment methods on public gene, variant, and phenotype resources. Ascertainment bias and the breadth of malformation terms keep that test from being clean, and it says nothing about optogenetics or training protocols applied to morphogenesis. The symmetry claim is therefore only partly resolvable from data that exist today.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Take the IUPHAR ion-channel gene set and test whether Human Phenotype Ontology and ClinVar annotations for structural malformations are enriched relative to frequency-matched non-channel genes. Enrichment would support the channelopathy-patterning clause; no enrichment would refute it. Applicability of drugs, optogenetics, and training to morphogenesis is a separate experimental question those databases do not contain.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Channel genes are heavily sequenced, so phenotype enrichment can be an ascertainment artifact.", "Human clinical terms only partly cover the vertebrate developmental scope.", "The databases do not record whether neuroscience tools alter morphogenetic decisions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.689"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Human Phenotype Ontology";
    dc:description "structured human phenotype annotations linking genes, including ion channels, to developmental and craniofacial abnormalities";
    prov:wasDerivedFrom <https://hpo.jax.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: ClinVar";
    dc:description "public variant-condition records used to count channel mutations that co-occur with patterning phenotypes";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/clinvar/>.
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: IUPHAR/BPS Guide to Pharmacology";
    dc:description "curated catalogue of ion-channel genes used as the denominator for an enrichment test";
    prov:wasDerivedFrom <https://www.guidetopharmacology.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2025-wisdom-08 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-08--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-08--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2025-wisdom-08 by Grok 4.7: 0.55";
