sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-competency-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-competency-13: partially-resolvable, resolvability 0.47";
    dc:description "The suggested ratchet is readable as a dynamical pattern in a public, fully specified toy evolution, so that pattern can be rerun. The claim then generalizes to an intelligence ratchet in developmental evolution and other spaces. Nothing public measures problem-solving competency and structural-gene selection jointly across real lineages, so only the model proxy is testable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In the 1D model, test whether hiding genotypic defects from selection produces a positive feedback in which competency keeps rising while structural-gene improvement stalls. That loop can be confirmed or refuted in the simulation. No existing dataset measures the same ratchet across real developmental systems or other problem spaces.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A positive feedback in this GA does not show a ratchet in evolving organisms.", "The model equates competency with bubble-sort steps on a monotonic axis, which is a narrow proxy for intelligence.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-competency-13--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.468"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-competency-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: CellularCompetency";
    dc:description "1D embryogeny model in which the proposed feedback can be re-simulated";
    prov:wasDerivedFrom <https://github.com/lksshw/CellularCompetency>.
<https://w3id.org/delphi/resource/assessment/levin-2023-competency-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-competency-13 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-competency-13--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-competency-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
