    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.78"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-06--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-06--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
