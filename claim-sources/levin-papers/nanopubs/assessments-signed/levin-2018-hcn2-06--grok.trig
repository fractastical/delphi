sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2018-hcn2-06: resolvable-now, resolvability 0.73";
    dc:description "This is a statement about a specified model, and both the engine and the HCN2 kinetics are public. Table 1, the regional leak ratios, and the permeability ratio are enough for a small team to rerun the qualitative switch in weeks. Channelpedia independently fixes the activation range, so a failure to amplify is evidence about the model rather than a missing parameter file. Residual uncertainty is the unpublished YAML, which can change millivolts and is unlikely to flip the sign of the switch inside the published ranges.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In a BETSE neurula with the published leak ratios, 0.1× MMR ions, and HCN2 at Na+:K+ permeability 0.2, compare open probability and steady Vmem in the neural tube versus the lateral regions. Amplification is confirmed if already-negative tube cells hyperpolarize further while depolarized lateral cells stay near their baseline; a uniform shift, or depolarization on HCN2 opening, refutes the switch.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The cAMP shift of V1/2 is an assumption (+20 mV) rather than a fitted embryonic measurement.", "The exact simulation YAML is not in the repository and must be rebuilt from the supplement.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-06--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.733"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-06--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BETSE";
    dc:description "public simulator with built-in HCN2 for testing gradient amplification under the paper's ionic conditions";
    prov:wasDerivedFrom <https://github.com/betsee/betse>.
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-06--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Channelpedia";
    dc:description "independent HCN2 activation curve used to check the hyperpolarized-open premise of the switch";
    prov:wasDerivedFrom <https://channelpedia.epfl.ch/ionchannels/62>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2018-hcn2-06 by Grok 4.7: 0.68";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.68"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-06--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-06--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2018-hcn2-06 by Grok 4.7: 0.64";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.64"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-06--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-06--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2018-hcn2-06 by Grok 4.7: 0.78";
