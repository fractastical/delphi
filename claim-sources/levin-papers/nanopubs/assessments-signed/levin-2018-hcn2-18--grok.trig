sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2018-hcn2-18: partially-resolvable, resolvability 0.48";
    dc:description "Inside BETSE, swapping channel kinetics is an analysis that can support or weaken the idea that border-sharpening reagents, as a class, stabilize the pattern. The in vivo half of the claim is the HCN2 rescue, which does not sample the class. Channelpedia supplies the alternative kinetics, and the anatomical scores that would connect slope to patterning are not an open dataset. The model class is partly testable now; the tissue generalization is not.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define border sharpness as the spatial slope of Vmem between neural tube and lateral ectoderm, then relate that slope to a brain-patterning score for HCN2 and for other reagents that steepen the same border. The general prediction holds if steeper borders improve patterning across reagents; an HCN2-only benefit, or a steep border with worse patterning, would limit or refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A channel can improve patterning by a path other than a steeper voltage border.", "Border sharpness itself was not deposited as a measured profile.", "In vivo confirmation is a single reagent, HCN2.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-18--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.479"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BETSE";
    dc:description "test whether other voltage-gated channels in the public simulator sharpen compartment borders the way HCN2 does";
    prov:wasDerivedFrom <https://github.com/betsee/betse>.
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-18--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Channelpedia";
    dc:description "kinetics for alternative channels that could be swapped into the same neurula model";
    prov:wasDerivedFrom <https://channelpedia.epfl.ch/>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2018-hcn2-18 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-18--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-18--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2018-hcn2-18 by Grok 4.7: 0.32";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.32"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-18--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-18--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2018-hcn2-18 by Grok 4.7: 0.48";
