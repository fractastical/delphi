sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-04--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-glue-04: partially-resolvable, resolvability 0.63";
    dc:description "Paired gene expression and electrophysiology are public for a large set of neurons and can show how much electrical phenotype is readable from transcripts. That tests the neural subset and can refute an absolute version of unreadability. It does not cover non-neural bioelectric maps, proteomics, or the history dependence the mechanism invokes, so the claim's full scope stays only partly tested.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In paired transcriptome and electrophysiology profiles, predict resting or firing features from transcript levels and ask whether distinct channel sets map to the same electrical phenotype. Prediction no better than a permutation null, or identical transcriptomes with different voltage states, would support unreadability; accurate prediction of the electrical phenotype from transcripts or proteins would refute a strict reading.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A snapshot cannot test history dependence, and proteins are not paired with voltage in this resource.", "The atlas covers spiking neurons, not the slow developmental voltage patterns the surrounding argument is about.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-glue-04--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.633"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-04--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Allen Brain Cell Types";
    dc:description "public patch-seq and electrophysiology for mammalian cortical neurons, pairing transcripts with electrical features";
    prov:wasDerivedFrom <https://celltypes.brain-map.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-04--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-glue-04 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
