sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-23--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2024-anthrobots-23: partially-resolvable, resolvability 0.50";
    dc:description "A public Xenobot tracking archive and its analysis code can re-estimate movement-type persistence for the frog constructs, which is half of the numerical comparison. The Anthrobot percentages come from coordinates that were not released. Matching summary rates would still leave index definitions and biological interpretation only partly tested.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Recompute, from public Xenobot tracks and from Anthrobot tracks if released, the self-transition rates of circular and linear segments and the cross-transition rates between them. Overlapping very low linear-circular exchange and circular consistency near the reported 92–95% would support the shared profile; Xenobot rates far from 0.5–1.6% and 95%, once the same indices are used, would refute the Xenobot half.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Anthrobot segment labels are not in that repository.", "Similar transition percentages do not show that the two platforms share a mechanism.", "Straightness and gyration as defined for Anthrobots may not match the Xenobot behavior features.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-anthrobots-23--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2024-anthrobots-23--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Xenobots behavioral data and analysis code";
    dc:description "raw tracks and R scripts for Xenobot movement types, from which transition rates can be recomputed if the same indices are applied";
    prov:wasDerivedFrom <https://github.com/swarm-lab/xenobots>.
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-23--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-anthrobots-23 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-23--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-23--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2024-anthrobots-23 by Grok 4.7: 0.32";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
