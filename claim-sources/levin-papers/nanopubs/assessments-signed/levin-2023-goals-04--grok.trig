    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-goals-04--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-04--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2023-goals-04 by Grok 4.7: 0.6";
