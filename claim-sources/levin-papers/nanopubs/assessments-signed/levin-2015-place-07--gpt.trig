<https://w3id.org/delphi/resource/assessment/levin-2015-place-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2015-place-07: partially-resolvable, resolvability 0.72";
    dc:description "The in-silico portion is directly reproducible, but the claim explicitly presents the outputs as predictions for real embryos. Existing materials resolve the model behavior, not the biological generalization.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Re-run each sensitivity perturbation and measure segment sizes, migration, differentiation, and atrophy relative to baseline. The simulation predictions are confirmed by the specified phenotypes, but validating them in embryos would require matching public perturbation-and-anatomy data.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Model signal sensitivities do not map uniquely to biological targets.", "The in vivo pharmacological prediction lacks a matched public dataset.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-place-07--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-07--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.725"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
