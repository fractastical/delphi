<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-01--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-girardia-01: needs-new-data, resolvability 0.43";
    dc:description "Head shape after a stated octanol regimen is a clear experimental variable, and the paper reports the outcome with group sizes. The images are figures rather than a deposited landmark set, and no independent public replication supplies the same perturbation and readout. Confirming or refuting the species match requires those records or a new assay.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On decapitated Girardia dorotocephala pre-tail fragments, compare blinded head-shape classes after 123 µM octanol for three days with water controls, using landmarks against reference Schmidtea, Dugesia, and Polycelis heads. Stochastic assignment to those reference shapes, absent in controls, would support the result; only wild-type or disorganized heads would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Individual images and landmark coordinates are not in a public repository.", "Species labels were assigned by resemblance before quantitative comparison.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-01--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.428"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2015-girardia-01--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gap junctional blockade in Girardia dorotocephala";
    dc:description "published images, doses, and group sizes for the octanol head-shape result; raw landmarks are not deposited";
    prov:wasDerivedFrom <https://doi.org/10.3390/ijms161126065>.
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-01--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
