    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2018-hcn2-08: partially-resolvable, resolvability 0.68";
    dc:description "The claimed discrepancy is numerically precise and the simulation can be rerun. The in-vivo estimate cannot be fully audited without embryo-level calibrated imaging or recordings, so present resources resolve only part of the comparison.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate the injected-versus-control neural Vmem difference from embryo-level calibrated measurements and reproduce the matching model condition, then test whether observed and predicted effects are near 15 and 30 mV respectively.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Raw voltage measurements are not linked to an open repository.", "The model side is more reproducible than the in-vivo side.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-08--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.684"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
