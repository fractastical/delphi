<https://w3id.org/delphi/resource/assessment/levin-2024-memory-15--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2024-memory-15: needs-new-data, resolvability 0.46";
    dc:description "The prediction can be made explicit and tested computationally, but the needed matched training outputs and integration measurements are not known to be public. Existing network models alone do not resolve it.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Train matched gene-regulatory-network models with and without an associative memory, then compare preregistered integrated-information or self-coherence measures while controlling network activity and complexity. A reproducible increase specific to learned association supports the prediction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Integrated-information measures are contested and computationally difficult.", "No known public dataset contains the required before-and-after training comparison.", "The paper describes the test as ongoing.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-memory-15--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.46"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
