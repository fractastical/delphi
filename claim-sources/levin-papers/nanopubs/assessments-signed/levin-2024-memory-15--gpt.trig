    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "public gene-regulatory-network models that could provide starting architectures, though not the required trained comparisons";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biomodels/>.
