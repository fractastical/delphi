    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-15--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2022-grn-learning-15: partially-resolvable, resolvability 0.54";
    dc:description "Existing models can resolve the reported distributional difference. They cannot cleanly identify evolutionary adaptation as its cause because the null ensemble is not an exchangeable unevolved control.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Confirm the biological-versus-random habituation distribution, then compare evolved and null ensembles under multiple kinetic and topology-matching schemes. An evolutionary explanation would require enrichment robust to null choices plus independent evidence of selection.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Biological and synthetic random models differ in more than evolutionary history.", "Repository selection and model complexity confound the comparison.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-15--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-15--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.541"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-15--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
