<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-05--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-agential-05: partially-resolvable, resolvability 0.69";
    dc:description "Formation and motility are directly quantifiable and reported in a defined preparation. Publicly available published records can test the phenomenon, but cleanly assigning suppression to instructive neighbour signals requires controls or data that may not be deposited.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare isolated Xenopus ectoderm explants with intact or signal-restored controls for spheroid formation, ciliary motility, trajectories, and behaviours. The suppression inference requires showing that reintroducing specific neighbouring-cell signals blocks behaviours without nonspecific toxicity.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Isolation changes mechanics and medium as well as signalling.", "Novel behaviour does not alone show active in-vivo suppression.", "Published demonstrations may not expose raw videos and trajectories.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-05--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.688"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-05--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioStudies";
    dc:description "public repository for microscopy videos and supplementary experimental data";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biostudies/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-05--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "public repository for behavioural trajectories and assay measurements";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-05--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
