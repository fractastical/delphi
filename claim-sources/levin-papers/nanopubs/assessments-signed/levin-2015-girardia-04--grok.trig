sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-04--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-girardia-04: needs-new-data, resolvability 0.42";
    dc:description "Brain aspect ratio is a standard morphometric variable, and the paper reports a significant group difference. The ratios and images needed to recompute it are not deposited, and no independent staining dataset repeats the octanol comparison. The result stays testable only with those measurements or a new assay.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure brain length-to-width ratio from synapsin-stained heads, blinded to external shape class, and test whether induced Girardia brains cluster with the reference species they resemble. A null or reversed clustering would refute the co-transformation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "External head class and brain class were scored in the same animals, so the resemblance judgment can couple the two readouts.", "Per-animal brain measurements are not in a public file.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-04--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.416"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2015-girardia-04--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gap junctional blockade in Girardia dorotocephala";
    dc:description "published staining images and an ANOVA p-value; individual length-to-width ratios are not deposited";
    prov:wasDerivedFrom <https://doi.org/10.3390/ijms161126065>.
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-04--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2015-girardia-04 by Grok 4.7: 0.32";
