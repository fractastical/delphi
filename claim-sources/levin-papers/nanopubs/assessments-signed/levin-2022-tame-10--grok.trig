sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-tame-10: partially-resolvable, resolvability 0.44";
    dc:description "Public orthology and divergence-time resources can test whether components of physiological and morphogenetic control are older than nervous systems. That is a proxy for the proposed timeline. The claim that 3D behavioral problem-solving is the same strategy pivoted into a new space is not distinguished by gene age alone.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Date gene families used in physiological and morphogenetic control against the origin of nervous systems and 3D behavioral circuits; the sequential claim is supported only as a proxy if those families are older and later co-opted into neural control.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Problem-solving in metabolic or morphogenetic space is not a variable in these databases.", "Shared genes are compatible with later co-option and do not show that behavioral strategies are variants of older ones.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-tame-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-10--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-10--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.443"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OrthoDB";
    dc:description "phyletic profiles of gene families to see which physiological and morphogenetic regulators predate nervous systems";
    prov:wasDerivedFrom <https://www.orthodb.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-10--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Ensembl";
    dc:description "annotated metazoan genomes for presence of the same families in aneural and neural lineages";
    prov:wasDerivedFrom <https://www.ensembl.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-10--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TimeTree";
    dc:description "clade divergence times for ordering those gene origins against the origin of nervous systems";
    prov:wasDerivedFrom <https://timetree.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-tame-10 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-10--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2022-tame-10 by Grok 4.7: 0.4";
