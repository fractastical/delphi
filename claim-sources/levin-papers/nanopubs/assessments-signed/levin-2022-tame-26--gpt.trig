    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Body-plan complexity and context sensitivity require subjective coding.", "Correlation does not establish the proposed continuum to cognition.", "Gene loss and poor early-branching genomes bias ancestral reconstruction.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-tame-26--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-26--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-26--gpt--dataset-3>;
