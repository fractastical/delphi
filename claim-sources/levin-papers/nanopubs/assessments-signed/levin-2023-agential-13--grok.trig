    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-13--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-13--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2023-agential-13 by Grok 4.7: 0.5";
