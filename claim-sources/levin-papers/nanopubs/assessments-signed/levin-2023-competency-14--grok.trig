sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-competency-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-competency-14: not-empirically-resolvable, resolvability 0.14";
    dc:description "The authors equate intelligence with problem-solving competency and assert it was an evolutionary driver before brains. A non-cognitive description of the same early bodies and developmental mechanisms fits every available fossil and phylogenetic pattern. The claim does not add a measurement that would decide between those descriptions.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: No public observation separates 'problem-solving competency drove evolution before brains' from the statement that developmental mechanisms affected fitness before nervous systems existed. Fossils and phylogenies show early morphological complexity either way.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No dataset records problem-solving competency as a causal variable in deep time.", "Pre-neural morphological complexity is compatible with competency as a driver and with competency as a label for ordinary development.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.14"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "not-empirically-resolvable".
<https://w3id.org/delphi/resource/assessment/levin-2023-competency-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-competency-14 by Grok 4.7: 0.15";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.15"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-competency-14--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-competency-14--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
