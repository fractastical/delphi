    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-goals-03: resolvable-now, resolvability 0.95";
    dc:description "The training horizon, perturbations, and recovery metric are explicit, and code is public. The claim can be reproduced or falsified without new data.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Evolve tissues only through step 100, perturb specified columns at step 110, and measure recovery to target accuracy; repeat over perturbation sizes. Confirm that repair occurs after small untrained perturbations but fails after whole-stripe conversion.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Generalization should be replicated across independently evolved controllers.", "Repair is measured against a model-specific survival and accuracy threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.96"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-goals-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-goals-03--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.951"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
