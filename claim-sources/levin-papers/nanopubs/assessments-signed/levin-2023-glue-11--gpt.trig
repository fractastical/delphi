    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-glue-11: partially-resolvable, resolvability 0.47";
    dc:description "Particular candidate transitions can be investigated with comparative molecular and morphology data. Existing data cannot directly observe the ancestral plastic phase or establish that this was an important general driver of body plans.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across phylogenetically sampled lineages, test whether inherited ion-channel changes stabilize morphologies first inducible by physiological perturbation and whether such transitions exceed matched alternatives. Evidence must establish temporal order from plastic phenotype to heritable channel change.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Correlated channel and morphology evolution does not establish genetic assimilation.", "Historical induction states are not preserved.", "The asserted importance across body-plan evolution lacks a quantitative threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.67"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-glue-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-11--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.466"^^xsd:double;
