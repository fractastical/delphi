<https://w3id.org/delphi/resource/assessment/levin-2014-tumor-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2014-tumor-12: needs-new-data, resolvability 0.41";
    dc:description "The translational prediction is measurable, but the source identifies mammalian testing as future work. Current public clinical and preclinical resources do not contain the required controlled remote-Vmem intervention and readouts.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In mammalian cancer models, manipulate remote tissue Vmem with clinically relevant ion-channel drugs and measure tumor initiation, progression, and detectable remote voltage signatures. Conservation would require effects at tolerated exposures across multiple models.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Approved-drug status does not imply suitability for Vmem modulation in tumors.", "Existing Xenopus results do not establish efficacy or detection performance in mammals.", "The claim is explicitly conditional on conservation in mammals.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2014-tumor-12--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.41"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2014-tumor-12--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: ClinicalTrials.gov";
    dc:description "public trial registry that can be searched for existing ion-channel-drug cancer interventions, though it does not supply the required remote-Vmem experiment";
    prov:wasDerivedFrom <https://clinicaltrials.gov/>.
