sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-tame-15: partially-resolvable, resolvability 0.57";
    dc:description "Head counts across amputation rounds with no further treatment are published for the octanol and related protocols. Planform may contain the curated head-number outcomes; it does not replace the raw counts. Persistence can be checked at the level of those published penetrances, and the genetic-wild-type clause stays weakly tested without sequence of the same lines.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Cut transiently treated two-headed or zero-headed worms with no further drug and score head number in successive regenerates, alongside a wild-type sequence or drug-residue assay; persistence holds if abnormal head number continues after the drug is gone and the genome matches wild type.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Penetrance tables are in the papers, not as animal-level files.", "Residual drug or a selected genetic variant can mimic a permanent physiological state.", "Wild-type genome is argued from induction and reset experiments more often than from deposited sequence of the altered lines.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-tame-15--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.573"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Planform";
    dc:description "encoded published regeneration outcomes, including head number after pharmacological treatments, for experiments that were curated";
    prov:wasDerivedFrom <https://lobolab.umbc.edu/planform/>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-tame-15 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
