    dc:description "Early detection is a direct classification problem with a clear temporal endpoint. Published measurements can support the reported model, but independent analysis depends on access to raw pre-phenotype voltage images and animal-level outcomes.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Blindly classify oncogene-expressing Xenopus embryos from membrane-voltage images acquired before visible tumours and compare predictions with later tumour status and uninjected controls. Above-chance early discrimination with calibrated specificity supports the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Detection in Xenopus does not establish clinical sensitivity.", "Image analysis must be blinded to oncogene-expression markers.", "The decisive raw image series may not be deposited.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-15--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.685"^^xsd:double;
