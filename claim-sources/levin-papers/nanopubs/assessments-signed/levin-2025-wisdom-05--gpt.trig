    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2025-wisdom-05: partially-resolvable, resolvability 0.74";
    dc:description "The experimental regeneration and transcriptomic components are directly measurable and may have public sequence data. Existing data can check the result more readily than the stronger interpretation that cells solved a novel high-dimensional problem.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare head integrity and regeneration under continued barium exposure, then reanalyse transcriptomes for reproducible differentially expressed genes relative to exposed non-adapted and untreated worms. Recovery plus a small validated expression set supports the reported result; failure to recover or broad expression change refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Completely adapted needs physiological as well as anatomical endpoints.", "The problem-solving interpretation is not uniquely implied by differential expression.", "The relevant accession is not identified in the batch.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-05--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-05--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
