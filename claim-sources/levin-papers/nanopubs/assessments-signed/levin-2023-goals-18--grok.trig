sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-goals-18: partially-resolvable, resolvability 0.40";
    dc:description "Pieces of the comparison are public: segmentation-clock models and expression series, and the tissue simulation. They can test a restricted dynamical resemblance. They do not contain a cross-kingdom homology or a matched stress-to-pattern experiment, so the conservation reading stays underdetermined.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare published bacterial biofilm stress oscillations, vertebrate segmentation-clock time series, and stress-linked stripe formation in the French-flag model for a shared motif in which a metabolic or stress oscillation sets spatial boundaries. A common motif under a pre-specified distance on those series would support a shared dynamical pattern; qualitatively different mechanisms would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No single public dataset pairs biofilm nitrogen stress, vertebrate segmentation, and the neural cellular automaton under one schema.", "Shared oscillation-plus-pattern is compatible with analogy and does not show a conserved mechanism from bacteria to metazoans.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.56"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-goals-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-goals-18--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2023-goals-18--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.402"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-goals-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "public kinetic models of segmentation clocks and other spatial oscillators, for a dynamical comparison rather than a homology test";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biomodels/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-goals-18--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gene Expression Omnibus";
    dc:description "time-resolved expression series during somitogenesis that can be compared with oscillator models";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-goals-18--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Scale-free cognition neural cellular automaton";
    dc:description "the in silico stress-and-stripe system named in the comparison";
    prov:wasDerivedFrom <https://github.com/LPioL/scalefreecognition>.
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-goals-18 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-goals-18--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-18--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2023-goals-18 by Grok 4.7: 0.32";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.32"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-goals-18--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-18--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2023-goals-18 by Grok 4.7: 0.48";
