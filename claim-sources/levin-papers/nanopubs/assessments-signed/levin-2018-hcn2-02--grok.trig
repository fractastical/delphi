sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2018-hcn2-02: partially-resolvable, resolvability 0.66";
    dc:description "BETSE and neurula geometries are public, and the paper tabulates starting concentrations and the leak-and-Kir mechanism, so the voltage pattern can be recomputed. The exact 2018 configuration is not a file in the repository, and the match to real embryos rests on the paper's images. The simulation half is therefore testable with reconstruction, short of a turnkey reproduction of the published run.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Rebuild the stage-15 anterior neurula in BETSE with the published ion concentrations, regional potassium and chloride leak, and Kir conductance, and test whether neural-tube Vmem is near −50 mV while folds and ectoderm stay near −5 mV. Closing Kir, or equalizing the leaks, should remove that contrast if the stated mechanism is required.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Agreement with embryonic voltages uses the paper's own images, which are not an independent recording archive.", "The spatial leak map is described with a figure and supplement rather than a deposited configuration file.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.657"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BETSE";
    dc:description "public bioelectric tissue simulator, including neurula geometry masks; the 2018 Nature Communications YAML is not in the repository";
    prov:wasDerivedFrom <https://github.com/betsee/betse>.
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: HCN2 voltage pre-patterns";
    dc:description "Table 1 initial concentrations, permeability description, and supplementary modeling note";
    prov:wasDerivedFrom <https://doi.org/10.1038/s41467-018-03334-5>.
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Channelpedia";
    dc:description "public Kir and leak channel parameters of the sort BETSE uses for conductance models";
    prov:wasDerivedFrom <https://channelpedia.epfl.ch/>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2018-hcn2-02 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2018-hcn2-02 by Grok 4.7: 0.55";
