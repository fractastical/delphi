<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-13--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-glue-13: partially-resolvable, resolvability 0.51";
    dc:description "Prospective prediction of later morphology from a latent voltage pattern is empirically testable and informative. The semantic upgrade from predictive state to counterfactual memory is not uniquely distinguished from a causal physiological precursor.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In anatomically one-headed worms, test whether a pre-injury voltage pattern predicts two-headed regeneration better than current anatomy and gene expression, using blinded prospective outcomes. Prediction supports latent state information, while 'representation' and 'counterfactual memory' require an additional theory-dependent criterion.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A predictive biomarker need not be a representation.", "Matched pre-injury voltage and later outcome data may be limited.", "Normal gene expression depends on assay resolution and timing.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-glue-13--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-13--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.505"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-13--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioStudies";
    dc:description "public live voltage imaging, anatomy, and supplementary regeneration data";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biostudies/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-13--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Gene Expression Omnibus";
    dc:description "public expression data for evaluating the normal-expression comparison";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-13--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
