    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "biological ODE models for dual-memory testing";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biomodels/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-12--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
