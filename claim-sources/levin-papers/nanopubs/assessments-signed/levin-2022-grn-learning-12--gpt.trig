    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2022-grn-learning-12: resolvable-now, resolvability 0.89";
    dc:description "The universal statement over a finite model set is especially discriminating and readily falsified by one counterexample. Published protocols and public biological models support replication.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Apply serial and parallel two-memory protocols to all eligible biological and matched random models, then score retention of zero, one, or both memories. Any serial AM-AM case retaining a memory refutes the universal forgetting statement.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Eligibility constraints reduce the tested memory-pair set.", "Random models must be regenerated consistently.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-12--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.893"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
