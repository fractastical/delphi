    <https://w3id.org/delphi/ontology/hasScore> "0.15"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-11--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-11--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
