<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-09--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2024-memory-09: partially-resolvable, resolvability 0.48";
    dc:description "Network topology is measurable and substantial public pathway data exist. Coverage is biased toward biochemical pathways, and enrichment can depend strongly on representation choices, so only part of the broad claim is currently resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define bowtie topology as many inputs converging on a smaller core and diverging to many outputs, then estimate this structure in curated biochemical, bioelectric and mechanical networks and compare its prevalence with degree-preserving null networks. Significant enrichment across all pathway classes supports the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Bioelectric and biomechanical networks are less comprehensively curated.", "Bowtie definitions and network boundaries are analyst-dependent.", "The egg and learning extensions require different data types.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-memory-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2024-memory-09--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.483"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2024-memory-09--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Reactome";
    dc:description "public curated biochemical pathway graphs for bowtie-topology analysis";
    prov:wasDerivedFrom <https://reactome.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2024-memory-09--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "public computational models of biochemical and signalling networks";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biomodels/>.
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-09--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-memory-09 by GPT-5.6 Sol: 0.4";
