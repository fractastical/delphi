sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-02--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-goals-02: partially-resolvable, resolvability 0.78";
    dc:description "The simulation comparison is directly reproducible. The inference that robust development generally is optimized by homogeneous embryonic baselines is broader and only partially testable with current heterogeneous developmental data.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across many evolved tissues, compare final pattern accuracy under homogeneous and matched random initial states. Public developmental datasets can separately test whether real embryonic starting states are homogeneous enough for the biological analogy.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Real embryos are not literally homogeneous at molecular scales.", "The evolved networks were trained from homogeneous states, confounding optimization with general robustness.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-goals-02--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-goals-02--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.779"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-goals-02--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: scalefreecognition code repository";
    dc:description "code for controlled initial-state comparisons";
    prov:wasDerivedFrom <https://github.com/LPioL/scalefreecognition>.
<https://w3id.org/delphi/resource/evidence/levin-2023-goals-02--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: The scaling of goals article and supplements";
    dc:description "reported initialization experiment and supplementary results";
    prov:wasDerivedFrom <https://doi.org/10.1098/rsfs.2022.0072>.
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-02--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-goals-02 by GPT-5.6 Sol: 0.84";
