sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-agential-11: partially-resolvable, resolvability 0.68";
    dc:description "The homology half can be settled directly from public sequences and structures. The functional phenocopy is a specific Xenopus regeneration result published as experimental measurements, without a deposited animal-level regeneration file in these databases. Voltage as the coarse-grained instructive variable is supported only if the rescue is tied to the bioelectric state rather than to a side effect of proton pumping.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Align yeast plasma-membrane proton-pump sequences and structures with Xenopus V-ATPase subunits, and compare tadpole tail regeneration when the yeast pump is expressed in place of V-ATPase function. Absence of significant sequence and structural homology, together with rescue of regeneration and of the regenerative voltage, would support interchangeability of the voltage state; homology, or rescue without restoration of voltage, would count against voltage as the instructive variable.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A yeast pump could restore regeneration by changing pH independently of the voltage pattern the claim treats as the signal.", "The tail-regeneration rescue counts are in the original experimental paper, not in UniProt or the PDB.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-11--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.675"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-11--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: UniProt";
    dc:description "sequences of the yeast proton pump and vertebrate V-ATPase subunits for a homology test";
    prov:wasDerivedFrom <https://www.uniprot.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-11--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: RCSB Protein Data Bank";
    dc:description "structures for the same proteins, to test the no-structural-homology clause";
    prov:wasDerivedFrom <https://www.rcsb.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-agential-11 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-11--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2023-agential-11 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
