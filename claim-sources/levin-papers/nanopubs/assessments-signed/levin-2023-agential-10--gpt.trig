    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit predictive and inverse models to matched ion-channel genotype, voltage-map, and anatomy data, then compare direct genotype-to-anatomy inverse error and sample complexity with a two-stage genotype-to-voltage-to-anatomy model on held-out perturbations.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Evolutionary and engineering ease are different outcomes.", "Matched genotype, voltage, and anatomy observations are rare.", "Model complexity and representation can predetermine apparent invertibility.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-10--gpt--dataset-2>;
