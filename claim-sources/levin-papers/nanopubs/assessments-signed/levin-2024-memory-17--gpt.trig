<https://w3id.org/delphi/resource/assessment/levin-2024-memory-17--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2024-memory-17: partially-resolvable, resolvability 0.36";
    dc:description "Comparative databases can test restricted predictions about chronology and conserved machinery. They cannot decisively recover the historical transition or distinguish direct evolutionary derivation from reuse of ancient general-purpose pathways.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Map conserved molecular and control mechanisms used in morphogenetic repair and neural behaviour across animal phylogeny, then test whether morphogenetic competencies predate and predict later behavioural-control innovations. Temporal and mechanistic continuity supports the proposal; independent origins or opposite ordering count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Deep evolutionary histories are reconstructed indirectly.", "Problem-solving competency is difficult to code in ancestral taxa.", "Shared molecules do not establish derivation of one cognitive capacity from another.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-memory-17--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2024-memory-17--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.363"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
