sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-21--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-girardia-21: partially-resolvable, resolvability 0.44";
    dc:description "Public sequences can rebuild the distance half of the suggestion. The ease-of-shifting half is represented only by shape frequencies from one treated species, not by reciprocal perturbations across the clade. The phylogenetic ranking is therefore checkable now, and the network-evolution claim is not.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate phylogenetic distance from public planarian rRNA and compare it with the rate at which a standardized gap-junction block moves each species into the other species' head states. A monotone relation between distance and that transition rate would support the suggestion; no relation, or a relation that reverses after controlling for morphology, would weaken it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A frequency ranking can track raw morphological similarity rather than network distance.", "Only Girardia was pharmacologically shifted, so ease of transition is not measured in the other species.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.57"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-21--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.442"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2015-girardia-21--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Nucleotide";
    dc:description "public rRNA sequences for Girardia, Dugesia, Schmidtea, and Polycelis";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/nuccore>.
<https://w3id.org/delphi/resource/evidence/levin-2015-girardia-21--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gap junctional blockade in Girardia dorotocephala";
    dc:description "one-species shape frequencies proposed as a proxy for ease of shifting a shared network";
    prov:wasDerivedFrom <https://doi.org/10.3390/ijms161126065>.
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-21--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2015-girardia-21 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-21--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-21--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
