    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2014-tumor-06: partially-resolvable, resolvability 0.65";
    dc:description "Existing intervention results directly test whether HDAC1 activity modifies suppression. They do not fully distinguish pathway transduction from independent HDAC effects or establish that HDAC1 is the main mediator.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare KRAS tumor incidence during remote hyperpolarization with and without dominant-negative HDAC1 and against disruptions of alternative transduction pathways. Rescue of incidence specifically by HDAC1 disruption would support its role.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dominant-negative HDAC1 may alter tumorigenesis independently.", "Raw contingency data are not clearly deposited.", "The intervention establishes involvement more readily than 'main transduction step'.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2014-tumor-06--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.645"^^xsd:double;
