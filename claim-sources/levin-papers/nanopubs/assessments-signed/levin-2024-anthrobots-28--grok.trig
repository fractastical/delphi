sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-28--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2024-anthrobots-28: needs-new-data, resolvability 0.32";
    dc:description "Formation and motility under the stated protocol are measurable for each named cell type. Public atlases show that oviduct and ependymal cells exist and express cilia genes; they do not contain the culture experiment. The prediction remains a new-experiment claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Run the Anthrobot matrix-to-liquid protocol on adult human oviductal epithelium and on ependymal cells, and score external cilia and motility, and run it on a non-ciliated epithelial type scoring multicellular assembly without motility. Motile ciliated spheroids from the first two sources, and immotile spheroids from the third, would support the prediction; failure to form under the same protocol would refute it for those types.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cilia-gene expression does not show that those cells will reverse polarity and swim.", "No public oviduct or ependymal run of the Anthrobot protocol exists.", "Non-ciliated bots are an open-ended class rather than one tested type.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-anthrobots-28--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.324"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2024-anthrobots-28--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: CZ CELLxGENE";
    dc:description "public single-cell expression showing ciliogenesis programs in oviductal epithelium and ependyma, not self-assembly or motility";
    prov:wasDerivedFrom <https://cellxgene.cziscience.com/>.
<https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-28--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-anthrobots-28 by Grok 4.7: 0.18";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
