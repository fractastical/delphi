    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-09--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-agential-09: partially-resolvable, resolvability 0.64";
    dc:description "Cell number and tubule construction are direct image-derived variables. The empirical anatomy is resolvable if source images exist, but current public coverage is uncertain and the goal-directed interpretation is not discriminated by morphology alone.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reanalyze histological serial sections or microscopy of diploid and polyploid newt pronephric tubules to count contributing cells, trace cell boundaries, and quantify whether a single giant cell wraps to form the lumen. The anatomical result is refuted if multiple cell membranes consistently form the tubule.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cell-boundary reconstruction requires adequate serial resolution.", "Downward causation is an interpretation beyond the anatomical observation.", "The underlying historical microscopy may not be digitized or public.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-09--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.639"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-09--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioStudies";
    dc:description "public repository that can host serial microscopy and supplementary image datasets";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biostudies/>.
