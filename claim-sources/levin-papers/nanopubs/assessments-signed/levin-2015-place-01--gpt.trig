    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2015-place-01--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2015-place-01: resolvable-now, resolvability 0.90";
    dc:description "The claim is a concrete simulation result and the paper specifies the equations, parameters, and public integration software well enough for reimplementation. The stated conclusion concerns sufficiency in this model, so rerunning it directly discriminates success from failure.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reimplement the eight-cell generative model and test whether identical cells converge from the stated initial condition to the encoded head-body-tail arrangement while ensemble variational free energy decreases. Failure across the stated parameterization would refute the proof-of-principle result.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The model is a deliberately small proof of principle rather than a calibrated biological model.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-place-01--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-01--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.898"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2015-place-01--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SPM academic software";
