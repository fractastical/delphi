    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-16--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2015-girardia-16: partially-resolvable, resolvability 0.55";
    dc:description "Existing remodeling observations operationalize return to a set point in one perturbation. They do not uniquely identify error sensing or a homeostatic controller, so the stronger conceptual interpretation remains only partially testable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify whether intact post-regeneration worms detect deviations and move morphology toward a stable species-specific set point without injury, including trajectories and stopping behavior. Compare feedback/set-point models against passive growth and turnover models.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Complete longitudinal data are not clearly deposited.", "Passive differential growth and tissue turnover are plausible rivals.", "Return toward normal shape does not uniquely demonstrate assessment of a target.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-16--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
