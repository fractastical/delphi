sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-19--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-girardia-19: needs-new-data, resolvability 0.31";
    dc:description "Multistability, return, and perturbation-induced switching are measurable signatures of attractors, so the hypothesis is testable in principle. The paper reports discrete shapes and later remodeling, and it does not provide the state trajectories that would separate attractors from other routes to a few head classes. Those recordings are still required.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate the voltage-and-shape state of regenerating animals and test for a small set of stable head shapes, return after small perturbations, and switching among those shapes after gap-junction block. A continuous cloud of shapes, or no return to discrete states, would refute an attractor account of the observed heads.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Discrete outcome classes can be produced by thresholds that are not attractors of a bioelectric network.", "No public time series links network state to the evolutionary morphospace regions named in the hypothesis.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-19--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.313"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2015-girardia-19--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gap junctional blockade in Girardia dorotocephala";
    dc:description "published discrete head classes and later remodeling, without state-space trajectories";
    prov:wasDerivedFrom <https://doi.org/10.3390/ijms161126065>.
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-19--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2015-girardia-19 by Grok 4.7: 0.28";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
