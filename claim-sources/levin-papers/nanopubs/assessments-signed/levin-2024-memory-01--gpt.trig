    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-01--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2024-memory-01: partially-resolvable, resolvability 0.41";
    dc:description "Restricted behavioural versions can be tested with public data, but the all-scale formulation requires substantial interpretation. Existing data cannot adequately represent the full scope or cleanly distinguish salience preservation from ordinary compression and generalization.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For defined memory paradigms, quantify retention of task-relevant predictive value versus retention of stimulus detail after context or embodiment changes. Preferential preservation of future-useful associations across several scales supports the proposal; equal or greater preservation of incidental detail counts against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No common measure spans cells, organisms and societies.", "Salience is agent- and task-dependent.", "Selection of examples could make the proposal circular.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-memory-01--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.41"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2024-memory-01--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OpenNeuro";
    dc:description "public human neuroimaging and behavioural datasets for restricted tests of gist, detail and later utility";
    prov:wasDerivedFrom <https://openneuro.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-01--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
