sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2019-boundary-17--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2019-boundary-17: partially-resolvable, resolvability 0.46";
    dc:description "Shared measurement under coupling is a measurable change in the scale of a response, and the cognitive label 'larger Self' rides on that change. Public planarian atlases show where gap-junction genes are expressed, which constrains who could be coupled and does not show stimulus sharing. Functional uncoupling experiments are published as scattered physiology, not as one imaging archive. Expression data can test a proxy and leave the binding claim only partly resolved.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare the spatial scale of a response to a local stimulus in gap-junction-coupled tissue versus tissue uncoupled pharmacologically or genetically. Expansion of the responding domain while coupled, and its collapse when uncoupled, would support shared sensing; an unchanged domain would refute the physiological half of the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A larger responding domain can be called a larger Self or simply a larger coupled network.", "Common gap-junction blockers are nonspecific.", "Expression of innexins is not functional dye coupling or shared sensation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.57"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-17--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.455"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2019-boundary-17--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GEO GSE111764";
    dc:description "whole-animal planarian cell-type transcriptomes in which gap-junction gene expression can be tallied";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE111764>.
<https://w3id.org/delphi/resource/assessment/levin-2019-boundary-17--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2019-boundary-17 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-17--grok>.
