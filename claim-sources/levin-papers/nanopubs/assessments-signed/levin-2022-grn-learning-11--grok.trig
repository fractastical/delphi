sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-grn-learning-11: resolvable-now, resolvability 0.80";
    dc:description "Persistence and recall are defined as delayed readouts of the same response variable, and a dedicated time-lag script is in the public repository along with the source models. Re-running that assay on the UCS-memory subset confirms or refutes both the long-delay retention claim and the claim about recall. The computation is heavy but specified.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For the models that show UCS-based memory, rescore the response after delays of 10 and 100 times the initial wait, with and without an intervening recall test. Most models keeping at least half their memories at the longest delay, and recall rarely erasing them, would confirm the claim; majority loss, or recall systematically destroying the trace, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The initial waiting period is model-relative, so the 100-fold delay must be taken from the same definition as the code.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-11--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-11--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GRN_ODE";
    dc:description "time-lag UCS memory evaluator";
    prov:wasDerivedFrom <https://github.com/wesleypclawson/GRN_ODE>.
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-11--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "pathway ODEs whose post-training trajectories are extended";
    prov:wasDerivedFrom <https://www.biomodels.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-11--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-grn-learning-11 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-11--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-11--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
