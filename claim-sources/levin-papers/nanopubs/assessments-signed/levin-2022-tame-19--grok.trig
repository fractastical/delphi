sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-tame-19: resolvable-now, resolvability 0.78";
    dc:description "Both clauses are gene-set comparisons, and the annotations and association catalogs needed for them are public and standard to analyze in days. Removing the already-shared channel, connexin, and transmitter genes is a pre-registered way to test specificity, and a null result would refute excess overlap. Coverage is weaker for regeneration screens and for non-mammalian animals than for human learning and development genes, which limits scope rather than blocking the test.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Test enrichment between morphogenesis genes and learning or memory genes after removing ion channels, connexins, and neurotransmitter machinery, using a degree-matched null; also test whether learning and memory genes are enriched in cancer, regeneration, and embryogenesis gene sets.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "GO annotations are biased toward human, mouse, and heavily studied genes.", "Regeneration genetics is largely RNAi and mutant screens, which are less completely captured by GO and the GWAS Catalog than cancer is.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-tame-19--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-19--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.783"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-19--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gene Ontology";
    dc:description "public gene annotations for morphogenesis, learning, memory, regeneration, and embryonic development, with evidence codes for an overlap test";
    prov:wasDerivedFrom <https://geneontology.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-19--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GWAS Catalog";
    dc:description "public genetic-association results for asking whether learning and memory genes recur in studies of other traits, including disease";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/gwas/>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-tame-19 by Grok 4.7: 0.85";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2022-tame-19 by Grok 4.7: 0.6";
