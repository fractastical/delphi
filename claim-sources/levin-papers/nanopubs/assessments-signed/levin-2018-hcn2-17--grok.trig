sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-17--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2018-hcn2-17: needs-new-data, resolvability 0.30";
    dc:description "Generality across teratogens and lesions is a panel experiment with a shared anatomical readout, so it is testable. No public dataset crosses HCN2 with anything except nicotine, and the untreated-embryo improvement does not stand in for that panel. Dose and tissue differences would have to be designed into a new series. Existing nicotine results leave the wider claim open.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Apply a chemically diverse panel of teratogens and at least one genetic brain lesion, each with and without HCN2, and score the same major brain-morphology criteria. A general restorative mechanism is supported if HCN2 lowers defects across the panel; restriction of the benefit to nicotine would refute generality.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A benefit in untreated embryos does not identify which lesions HCN2 can repair.", "Only the nicotine combination has published HCN2 rescue counts.", "Teratogens differ in timing, dose, and which tissues they hit.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.304"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-17--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2018-hcn2-17 by Grok 4.7: 0.15";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.15"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-17--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-17--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
