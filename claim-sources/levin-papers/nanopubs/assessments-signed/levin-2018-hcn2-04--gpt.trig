    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2018-hcn2-04: partially-resolvable, resolvability 0.51";
    dc:description "The mechanism has measurable intermediates and interventions, but model fit alone does not establish that Vmem disruption causes the defects. Existing public software and scattered experimental evidence can test parts of the chain, while the full matched dataset is not identified.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit competing causal models linking nicotine exposure, neural-tube Vmem contrast, and later brain defects, and test whether disruption of Vmem mediates the exposure effect and whether restoring the contrast rescues morphology.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A causal mediation test needs matched embryo-level voltage and morphology data.", "Nicotine has multiple endogenous targets.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-04--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.511"^^xsd:double;
