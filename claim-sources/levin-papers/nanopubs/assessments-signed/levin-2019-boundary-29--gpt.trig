    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2019-boundary-29--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2019-boundary-29: partially-resolvable, resolvability 0.70";
    dc:description "Many relevant public transcriptomes and annotation resources exist, making a cross-kingdom meta-analysis feasible. Coverage of damaged biofilms and matched regenerative stages is uneven, and transcript abundance alone only partially tests the proposed conserved functional role.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compile regeneration time-course transcriptomes from damaged bacterial biofilms, plants, and animals, harmonize orthologous electrogenic genes, and test for consistent differential use beyond generic injury and stress responses.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ion-channel expression may reflect generic stress rather than cooperative morphogenesis.", "Regeneration protocols and sampled stages differ across kingdoms.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-29--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-29--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-29--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.702"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2019-boundary-29--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gene Expression Omnibus";
    dc:description "public cross-kingdom transcriptomic studies of injury and regeneration";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/>.
<https://w3id.org/delphi/resource/evidence/levin-2019-boundary-29--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
