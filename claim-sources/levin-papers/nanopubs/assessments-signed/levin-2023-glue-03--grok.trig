    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-03--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-glue-03: partially-resolvable, resolvability 0.58";
    dc:description "This is the same preparation as the behavioural tail-eye result, with a narrower endpoint: vision and a spinal connection. The experimental paper publishes those outcomes for this scope. They can be checked against the described controls and cannot be recomputed from an open trial file.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In Xenopus tadpoles with no primary eyes and one tail eye, score visually guided learning and trace axons from that eye. Learning that requires the tail eye, with axons entering the spinal cord, would support seeing through the ectopic eye; chance performance, or learning that remains after the tail eye is removed, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Extraocular photoreception is the main rival and has to be read off the paper's controls.", "Published performance is a summary, not trial-level choices.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.67"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.583"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-03--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-glue-03 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
