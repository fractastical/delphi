sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2019-boundary-20: partially-resolvable, resolvability 0.42";
    dc:description "The non-cognitive core is a Goldilocks effect of information sharing on modularity, which a gap-junction sweep in BETSE can exhibit or fail to exhibit. That is an analysis on public code, limited to the model. Calling the successful window a Self does not add a separate measurement, and tissue dose-response data are not assembled. The model can partially test the balance and cannot establish it for organisms.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Sweep a coupling or synaptic-gating parameter from isolation to full sharing and measure modularity of the resulting patterns or activity. An intermediate window with differentiated modules, flanked by fragmentation and by a homogeneous soup, would support the balance; monotone improvement with more sharing would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Empirical dose-response of coupling versus anatomical modules is not one dataset.", "The location of the intermediate window depends on how sharing is parameterized.", "What counts as a new Self is still a labeling choice.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.52"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-20--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.416"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2019-boundary-20--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BETSE";
    dc:description "public tissue model in which gap-junction conductance can be swept and pattern modularity recorded";
    prov:wasDerivedFrom <https://github.com/betsee/betse>.
<https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2019-boundary-20 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
