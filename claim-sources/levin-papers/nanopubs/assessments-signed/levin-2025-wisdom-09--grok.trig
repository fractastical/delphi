sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2025-wisdom-09: needs-new-data, resolvability 0.44";
    dc:description "The electric-face claim has a clear experimental signature: spatial voltage, the expression pattern it is said to set, and the anatomical result of changing it. Those paired measurements were published as figures and are not available as analyzable raw data, and clinical phenotype databases do not contain the voltage variable. Confirming or refuting the result requires the deposited or independently replicated maps, which are not public.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Map resting potential across the embryonic face, predict regional gene expression and craniofacial anatomy from that map, and then shift the map by pharmacology, optogenetics, or channel misexpression. Anatomy and markers should follow the imposed pattern if the claim is right, and should ignore it if voltage is only a correlate.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Face-wide voltage images, marker domains, and craniofacial outcomes are not in a public deposit.", "Human channelopathy phenotypes do not include the embryonic voltage map the mechanism requires.", "The manipulation series is largely from one research program and lacks an open independent replicate.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.441"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2025-wisdom-09 by Grok 4.7: 0.25";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.25"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-09--grok>.
