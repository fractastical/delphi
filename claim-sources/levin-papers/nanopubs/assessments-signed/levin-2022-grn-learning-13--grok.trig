sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-grn-learning-13: partially-resolvable, resolvability 0.58";
    dc:description "Organism metadata and memory counts are both recoverable, so the distribution inside this list can be rechecked. The list is not a sample of life, and 'roughly uniformly' plus the suggestion about all strata of life outruns what 35 published models can show. The test covers a thin proxy for the stated scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Label each of the 35 models by the source taxon class recorded in BioModels and test whether memory prevalence is homogeneous across bacteria, slime mould, yeast, plants, vertebrates and mammals. A clearly uneven distribution would refute uniformity inside this set; a flat distribution would support only that limited census.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Class sizes in a 35-model curated list are too small for a uniformity test to be stable.", "Uniformity among published models does not measure proto-cognitive capacity across living taxa.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-13--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.576"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "organism annotations for the surveyed pathway models";
    prov:wasDerivedFrom <https://www.biomodels.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GRN_ODE";
    dc:description "per-model memory counts to stratify by taxon";
    prov:wasDerivedFrom <https://github.com/wesleypclawson/GRN_ODE>.
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-grn-learning-13 by Grok 4.7: 0.68";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
