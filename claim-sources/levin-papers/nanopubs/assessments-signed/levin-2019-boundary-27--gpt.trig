    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2019-boundary-27: needs-new-data, resolvability 0.38";
    dc:description "The hypothesis can be made testable through defined adhesion and preference phenotypes, but the crucial early-multicellularity experiments are not represented by known public datasets. Existing pharmacology and sequence data provide context rather than a decisive test.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In early multicellular models and stem/somatic co-cultures, manipulate opioid signaling and measure stable aggregation, separation costs, and repeated preference, then compare evolutionary conservation with neural reward pathways.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Addictiveness has no direct equivalent in cell collectives.", "Existing molecular homology cannot establish the proposed ancient function.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-27--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-27--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.375"^^xsd:double;
