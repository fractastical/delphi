sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-agential-08: partially-resolvable, resolvability 0.57";
    dc:description "The learning assay and the anatomical connection are concrete, and the 2013 experimental report gives published performance for this exact preparation. Those measurements can be reassessed against the stated controls, but they cannot be recomputed from raw choices, and Xenbase does not hold the trial file. The result is checkable as a published experiment, not as an open behavioural dataset.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Score visual learning in Xenopus tadpoles with native eyes prevented and one ectopic eye on the tail, and record whether that eye's axons enter the spinal cord or peripheral tissue rather than the brain. Learning above the no-eye and extraocular-photoreception controls would support seeing through the ectopic eye; chance performance, or learning that survives removal of the ectopic eye, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Extraocular light sensitivity can imitate vision unless the ectopic eye is covered or removed as a control.", "The behavioural trials are published as summary performance, not as a public trial table.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.573"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-agential-08 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-08--grok>.
