sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2024-collective-10: partially-resolvable, resolvability 0.51";
    dc:description "Donor versus host Hox expression after single-cell versus group grafts is a defined contrast, and the mouse transposition paper publishes it with lineage labels. Related chick and zebrafish grafts are separate papers, not a combined open count matrix. The expression difference can be re-examined from those figures for a few vertebrates, while the memory and perceptual-field gloss is not an additional variable in the data.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare Hox or reporter expression of single neural-crest or rhombomere cells grafted to a new axial level with expression of coherent groups grafted to the same level. Groups keeping donor expression while isolated cells matching the host would support the contrast; both classes changing, or both keeping donor identity, would refute it. A longer 'perceptual field' is not a further measurement beyond that retention.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Counts are in figures from mouse, chick and zebrafish papers, not one deposited cell table.", "Graft size, dispersion and cell survival are entangled in the classic experiments.", "Maintained gene expression does not measure memory duration or a perceptual field extending into the past.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.63"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-collective-10--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.506"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2024-collective-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Trainor and Krumlauf 2000, Nature Cell Biology";
    dc:description "published mouse grafts of small rhombomere groups versus dispersed cells, with Hox reporter and lineage label";
    prov:wasDerivedFrom <https://doi.org/10.1038/35000051>.
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-collective-10 by Grok 4.7: 0.34";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.34"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2024-collective-10 by Grok 4.7: 0.42";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
