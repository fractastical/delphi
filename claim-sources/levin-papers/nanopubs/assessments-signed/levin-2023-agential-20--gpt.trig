<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-20--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-agential-20: partially-resolvable, resolvability 0.59";
    dc:description "Cryptic genetic variation and buffering are measurable and supported by public variation and perturbation resources. Existing datasets test subsets and proxies but rarely identify the proposed developmental architecture and evolutionary fate together.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Identify mutations buffered to normal phenotype under intact development, reveal their effects after disrupting regulation, and test whether such variants segregate at higher frequencies than equivalent unbuffered deleterious variants. Later environmental or regulatory shifts should expose usable phenotypic variation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dormant effects require matched genetic and developmental perturbations.", "Future exploitability is difficult to infer from current frequency.", "Neutrality can result from redundancy unrelated to multiscale competency.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-20--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-20--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.589"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-20--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Gene Expression Omnibus";
    dc:description "public perturbation-expression datasets for identifying conditionally revealed variation";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-20--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: European Variation Archive";
    dc:description "public genetic-variation data for estimating frequencies of candidate buffered variants";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/eva/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-20--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-agential-20 by GPT-5.6 Sol: 0.55";
