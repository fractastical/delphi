sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-17--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-agential-17: partially-resolvable, resolvability 0.63";
    dc:description "The computational ratchet is re-runnable from a public repository that already stores simulation outputs, so that part can be confirmed or refuted by a standard reanalysis. The claim also ranks real lineages, and nothing in the repository or in a comparable open table measures their competency. The model result is a proxy for the evolutionary statement, not the whole of it.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In the public competency model, track the fraction of fitness-improving changes that alter competency parameters versus structural genes as competency is allowed to evolve. An increasing share of competency edits, and weaker selection on the structural genome, would support the ratchet inside that model; continued improvement mainly in structural genes would refute it there.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ordering planaria, salamanders, and mammals by degree of competency is not a variable in the saved runs.", "The model uses a one-dimensional positional target, so its ratchet need not be the biological one.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-17--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.627"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-17--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cellular competency evolution model";
    dc:description "public code and pre-saved runs for hardwired, competent, and evolvable-competency populations";
    prov:wasDerivedFrom <https://github.com/lksshw/CellularCompetency>.
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-17--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-agential-17 by Grok 4.7: 0.78";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.78"^^xsd:double;
