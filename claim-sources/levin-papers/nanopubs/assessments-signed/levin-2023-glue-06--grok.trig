sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-glue-06: partially-resolvable, resolvability 0.49";
    dc:description "Public sequences and divergence times can test whether the named components are older than brains, which is the conservation premise behind the pivot. They cannot show original use in morphospace, nor that neuroscience tools work in the body because of that history. The historical purpose remains an inference beyond the phylogenetic data.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Place ion-channel, gap-junction, and neurotransmitter-synthesis genes on a dated tree of animals and ask whether they predate nervous systems, and compare the timescale of non-neural voltage events with synaptic spikes. Earlier origins and a shift from slow spatial patterns to millisecond spikes would support reuse and speed-up; origins only inside nervous systems would count against the historical premise.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "An ancient gene family can predate nervous systems without having been used for morphogenesis.", "The speed comparison is between living physiological regimes, not a recorded evolutionary transition.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.488"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: UniProt";
    dc:description "protein families for channels, connexins and innexins, and transmitter-related enzymes";
    prov:wasDerivedFrom <https://www.uniprot.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TimeTree";
    dc:description "divergence times against which those families can be compared with the origin of nervous systems";
    prov:wasDerivedFrom <https://timetree.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-06--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Datasets genomes";
    dc:description "public genomes of early-branching animals and outgroups for presence and absence";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/datasets/genome/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-glue-06 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
