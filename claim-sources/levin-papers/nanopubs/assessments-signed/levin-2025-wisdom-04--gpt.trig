    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2025-wisdom-04: resolvable-now, resolvability 0.80";
    dc:description "The simulation result has direct inputs, outputs and controls, and running or reimplementing a published model is analysis rather than new data collection. Standard dynamical-systems methods can resolve the claim within weeks if model equations are fully reported.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Re-run or reimplement the cited fixed-topology GRN models under standard habituation, sensitization and conditioning schedules, testing held-out stimulus responses against untrained controls. Protocol-specific learned responses without topology or edge-weight changes support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Behavioural labels require explicit quantitative criteria.", "The cited implementations may not be archived in a standard repository.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-04--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-04--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
