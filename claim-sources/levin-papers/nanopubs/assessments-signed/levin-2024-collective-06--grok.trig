sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2024-collective-06: partially-resolvable, resolvability 0.47";
    dc:description "All-or-none scoring per animal, cohort incidence and a predicted partial-conversion intervention are all decidable if the per-animal table and the model are public. The review states the pattern and the successful prediction; the underlying scores and code are not an open deposit. A reanalysis can use the published incidences only as summaries, so both the concordance claim and the model confirmation stay partly out of reach. This was one of the harder items because model completeness cannot be judged from the review text alone.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Score each tadpole as fully converted, fully normal or partial, under each reagent, and compare the within-animal pattern with a binomial model of independent melanocytes. All-or-none animals at varying cohort rates would support collective concordance. Re-implementing the published signaling model should then predict the drug and dominant-negative conditions under which partial animals appear; failure of those conditions, or partial animals in the original reagents, would refute the joint claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fully versus partially converted depends on a threshold applied to images.", "It is unclear from the review alone whether the model equations are complete enough to re-run without the original code.", "Per-animal conversion scores and the model parameter file are not in a public repository.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.5"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.47"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-collective-06 by Grok 4.7: 0.42";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.42"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-collective-06--grok>.
