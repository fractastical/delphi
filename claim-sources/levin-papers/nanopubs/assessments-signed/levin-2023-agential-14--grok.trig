sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-agential-14: partially-resolvable, resolvability 0.58";
    dc:description "Cortical rotation, inheritance across fissions, and failure of the nucleus to restore normal feeding are concrete and were reported repeatedly in the ciliate literature. Reference genomes exist, but not for the operated lines, so the wild-type-DNA clause cannot be rechecked from sequence. The anatomical inheritance can be assessed from the published experiments, with the limits of pre-genomic records.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Track ciliary beat direction and feeding after a 180-degree cortical rotation in Paramecium or a related ciliate, across asexual generations, and sequence the same lines. Inheritance of reversed beating with a genome that matches the unoperated stock would support cortical inheritance that the genome does not correct; loss of the reversal within a few fissions, or a fixed nuclear mutation, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "The classical lines were not sequenced, so wild-type DNA is inferred from genetics rather than from a public genome of those cells.", "The primary observations are journal descriptions from the 1960s onward, not a single downloadable pedigree.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.63"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-14--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.577"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Ciliate Genome Database";
    dc:description "reference genomes for Paramecium and Tetrahymena; it does not include the surgically rotated lines";
    prov:wasDerivedFrom <https://www.ciliate.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-agential-14 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
