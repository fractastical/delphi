    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-agential-13--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-agential-13: partially-resolvable, resolvability 0.64";
    dc:description "The morphological resemblance and lack of genetic change are testable with images and sequence data. The stronger assertion about traversing morphospace and bioelectric pattern memory is only indirectly supported.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use blinded geometric morphometrics to compare treated regenerated heads with untreated conspecifics and reference species, alongside genotyping and voltage measurements. Clustering of treated heads with other species more strongly than with controls supports phenocopy, while the evolutionary-distance interpretation requires a phylogeny.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Drug effects may be nonspecific.", "The phrase 'crossed evolutionary distance' is metaphorical rather than a trajectory.", "Two-dimensional head shape may not capture species identity.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-13--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-13--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-13--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "public comparative morphology repository for reference shape data";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-13--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
