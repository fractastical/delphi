sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2024-memory-11: partially-resolvable, resolvability 0.45";
    dc:description "Public assemblies can test the noisy-genome half, and the regeneration literature is large, so that portion of the statement is partly checkable. Tumor resistance and lack of aging are not settled by a public longitudinal dataset, and the causal appeal to an in silico pattern-completion strategy cannot be rerun from a deposited model. Genomic data alone do not discriminate that mechanism from other explanations of planarian robustness.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify planarian genome heterozygosity, repeat content, and ploidy variation from public assemblies, and set those beside published rates of regeneration, tumor formation, and actuarial aging. The pattern-completion cause would further require re-running the cited evolutionary simulation and showing that disabling pattern completion removes the resistance.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A noisy genome co-occurring with regeneration does not show that pattern completion is the cause.", "Cancer resistance and negligible senescence are not quantified in one cohort dataset.", "The pattern-completion simulation is not a clearly reusable public code base.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-memory-11--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.448"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2024-memory-11--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Genome";
    dc:description "public planarian genome assemblies used to check how disordered the genome is relative to other metazoans";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genome/>.
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-11--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-memory-11 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
