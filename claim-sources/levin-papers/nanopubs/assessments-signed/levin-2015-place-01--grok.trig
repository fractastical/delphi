sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-place-01--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-place-01: resolvable-now, resolvability 0.81";
    dc:description "The claim is about a stated simulation, and the paper points to a public SPM routine that still implements shared-model self-assembly. Re-running it can confirm or refute that outcome. The default target in the current file has drifted from the 2015 head–body–tail illustration, so the eight-cell case needs the published target mask rather than the file's present bitmap.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Run the public active-inference morphogenesis routine from a shared generative model and undifferentiated initial state, and score whether cells migrate and differentiate into the target pattern while ensemble free energy falls. Failure to assemble under that shared model would refute the reported proof of principle.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "MATLAB is required to run the solver as distributed.", "The current public script defaults to 16 cells and a target mask that is not the paper's eight-cell head–body–tail figure.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.813"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SPM DEM_morphogenesis";
    dc:description "public MATLAB implementation of the active-inference self-assembly simulation, invoked through the DEM toolbox";
    prov:wasDerivedFrom <https://github.com/spm/spm/blob/main/toolbox/DEM/DEM_morphogenesis.m>.
<https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Statistical Parametric Mapping";
    dc:description "official SPM distribution that the paper says reproduces the simulations via the morphogenesis button";
    prov:wasDerivedFrom <https://www.fil.ion.ucl.ac.uk/spm/>.
<https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Knowing one's place";
    dc:description "published precisions, time-step count, and target-morphology specification for the 2015 runs";
    prov:wasDerivedFrom <https://doi.org/10.1098/rsif.2014.1383>.
<https://w3id.org/delphi/resource/assessment/levin-2015-place-01--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2015-place-01 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-place-01--grok>.
