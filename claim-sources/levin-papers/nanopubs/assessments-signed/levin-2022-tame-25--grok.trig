sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-tame-25: partially-resolvable, resolvability 0.54";
    dc:description "Public genomes can show that many bioelectric gene families occur in animals without neurons and in close unicellular relatives, which bears on which hardware came first. The claim also says evolution used analog bioelectric dynamics to position body configuration before neural spiking. That use is not a column in the genome matrices, so gene age is only a partial test.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Map ion-channel, connexin, and innexin families onto aneural animals and their unicellular relatives versus the origin of neurons; precedence of the genes holds if the families are present before nervous systems, which still leaves their developmental use untested.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Channels have many functions besides positional control, so their age is compatible with other histories.", "Gene presence in a sponge or placozoan does not show that the genes were used to place the body in morphospace.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-tame-25--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-25--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.543"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-25--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OrthoDB";
    dc:description "ortholog presence of bioelectric gene families in sponges, placozoans, ctenophores, and choanoflagellates";
    prov:wasDerivedFrom <https://www.orthodb.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-25--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Ensembl";
    dc:description "annotated genomes for the same early-branching animals and for animals with nervous systems";
    prov:wasDerivedFrom <https://www.ensembl.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-tame-25 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.65"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
