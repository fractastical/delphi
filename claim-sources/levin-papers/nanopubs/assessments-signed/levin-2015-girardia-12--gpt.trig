    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Girardia head-shape article and supplementary materials";
    dc:description "provides the published same-genome perturbation and morphology measurements";
    prov:wasDerivedFrom <https://doi.org/10.3390/ijms161126065>.
