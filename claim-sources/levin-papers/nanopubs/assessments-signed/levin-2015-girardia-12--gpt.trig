    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2015-girardia-12: partially-resolvable, resolvability 0.58";
    dc:description "The paper's experiment directly addresses same-genome morphological plasticity in a restricted case. It does not establish a general input mechanism across morphogenesis or separate electrical from biochemical gap-junction signaling.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Hold genotype constant, perturb bioelectric connectivity, and quantify reproducible shifts among anatomical outcomes while measuring voltage state. Existing Girardia observations test this in one regeneration context; broader confirmation requires additional systems.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "One pharmacological perturbation does not isolate bioelectric networks from other gap-junction cargo.", "The general claim extends beyond the sampled species and organ.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-12--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
