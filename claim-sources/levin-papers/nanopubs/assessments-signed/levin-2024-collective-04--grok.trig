sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-04--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2024-collective-04: partially-resolvable, resolvability 0.65";
    dc:description "Direction relative to a defined field, with reversal controls, is a clean contrast, and the primary paper publishes trajectories, summary directedness and movies for both cells and fragments. That is scattered published measurement rather than an open tracking archive a third party can download and rerun. The opposite-taxis result can be re-measured from those materials with real limits on precision, which is a partial rather than a complete resolution.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In the same electric-field polarity, compute directedness of intact fish keratocytes and of their anucleate fragments, including field-reversal trials. Cathodal cells and anodal fragments, both reversing when the field reverses, would support opposite taxis; the same direction for fragments and cells would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Raw tracks are in the paper and supplement, not a separate downloadable coordinate archive.", "Retyping trajectories from figures is less precise than the original tracking files.", "The result is for fish keratocytes, which is the claim's scope, but fragment preparation can select a biased subset of cytoplasm.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.71"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-collective-04--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.652"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2024-collective-04--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Sun et al. 2013, Current Biology";
    dc:description "published trajectories, directedness means, field-reversal trials and movies for keratocytes versus fragments";
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2013.02.026>.
<https://w3id.org/delphi/resource/assessment/levin-2024-collective-04--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-collective-04 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
