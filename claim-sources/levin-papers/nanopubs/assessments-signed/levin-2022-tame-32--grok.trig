sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-tame-32: partially-resolvable, resolvability 0.53";
    dc:description "Pharmacology databases can test whether general anesthetics inhibit connexins, and at what concentration relative to their main targets. That addresses the gap-junction-blocker clause and can fail it for agents whose clinical action is elsewhere. Loss of a higher-level Self, and anesthesia by gap-junction block from plants to humans, is only partly represented by those ligand tables.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare anesthetic potency at connexins with potency at primary targets such as GABA-A receptors, and test whether selective gap-junction blockers stop organism-level behavior in plants, Hydra, and animals while cell viability remains.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Behavioral arrest in plants and Hydra is in a few papers, not in these pharmacology databases.", "Disappearance of a higher-level Self is not a variable separate from loss of coordinated behavior.", "Many anesthetics act on synaptic receptors at concentrations below those reported for connexin block.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-tame-32--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-32--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.533"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-32--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: IUPHAR/BPS Guide to Pharmacology";
    dc:description "curated target and ligand records for anesthetics, connexins, and the primary neural receptors";
    prov:wasDerivedFrom <https://www.guidetopharmacology.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-tame-32--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: ChEMBL";
    dc:description "public bioactivity values for asking whether general anesthetics block gap junctions at concentrations that anesthetize";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/chembl/>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-tame-32 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2022-tame-32 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2022-tame-32 by Grok 4.7: 0.65";
