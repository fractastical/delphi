sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-20--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-glue-20: not-empirically-resolvable, resolvability 0.20";
    dc:description "Cytosolic continuity through gap junctions is a routine physiological observation, and many imaging papers already show it. Nothing in those records distinguishes loss of molecular ownership, partial erasure of cell identity, or scaling of goals from ordinary diffusion of a second messenger. The distinctive content of the statement therefore has no empirical contrast with the non-cognitive description of the same facts.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Dye coupling and calcium imaging can show that small cytosolic signals cross gap junctions. The same images are predicted if calcium simply diffuses and if a cell 'cannot tell' which molecule is its own, so ownership, erasure of cellular individuality, and scaling of stored goals have no separate confirming or refuting observation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Any shared calcium transient fits both passive coupling and an ownership-wiping description.", "Individuality and stored goals are not given a measurement distinct from the coupling itself.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.202"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "not-empirically-resolvable".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-20--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-glue-20 by Grok 4.7: 0.3";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.3"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-glue-20--grok>.
