    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2025-wisdom-16: partially-resolvable, resolvability 0.71";
    dc:description "The perturbations, negative conditions and phenotype components are explicit and discriminating. The reported experiments can resolve the restricted Xenopus claim, but public raw-data completeness and the strength of the no-DNA-damage condition are uncertain.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare melanocyte proliferation, migration, vascular or brain invasion and morphology after transient bioelectric or serotonergic perturbation with vehicle, oncogene and DNA-damage controls. A melanoma-like suite in genetically normal, damage-negative animals supports the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Excluding all DNA damage requires direct assays.", "Melanoma-like is a phenotype analogy rather than a tumour diagnosis.", "Raw animal-level data may remain in paper supplements.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-16--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.708"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
