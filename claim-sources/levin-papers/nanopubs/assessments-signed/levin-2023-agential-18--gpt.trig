<https://w3id.org/delphi/resource/assessment/levin-2023-agential-18--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-agential-18: partially-resolvable, resolvability 0.60";
    dc:description "The absolute 'no known strain' statement is searchable and readily falsified, and transgenesis attempts can be catalogued. Publication bias and unequal technical effort prevent those observations from decisively confirming the competency-ratchet mechanism.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Systematically search planarian strain, mutant, and transgenesis records for heritable abnormal morphology, classify genetic versus physiological origins, and compare discovery effort with established model organisms. A verified genetic strain with stable abnormal morphology refutes the absolute prediction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Absence of reports is not proof of absence.", "Planarian research effort and genetic tools differ from fly and mouse.", "The claimed explanation is not uniquely predicted by the observation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.599"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PubMed";
    dc:description "public bibliographic database for a systematic census of mutant and transgenic planarian reports";
