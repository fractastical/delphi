sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-17--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-glue-17: partially-resolvable, resolvability 0.57";
    dc:description "The replication paper puts its counts and movies in the open supplement and releases the simulation code, so the reported Xenopus time course can be re-measured and the model re-run. That does not deposit raw offspring coordinates, and it does not contain a comparative survey of other species. The biological phenotype is therefore only partly checkable, and the simulation does not adjudicate the wet-lab result.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: From the published movies and counts, score whether motile Xenopus ectoderm spheroids gather loose cells into piles that compact into further motile spheroids, and record the time from assembly to the first offspring. Offspring that swim and themselves pile cells would support kinematic replication on the reported timescale; piles that never become autonomous movers, or a requirement for a long selection history, would weaken it. A survey of other species is a separate test and is not in this archive.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No public survey tests the claim that no other species uses this mode.", "Pile formation can be passive flow-driven aggregation rather than construction of a copy.", "The public code re-runs the design simulation; it does not replace the Petri-dish counts.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-glue-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-17--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.571"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-17--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Kriegman et al. 2021, PNAS";
    dc:description "published counts and supplementary movies of pile formation and offspring motility; the paper states that the non-code data are in the manuscript and supplement";
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.2112672118>.
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-17--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Kinematically replicating organisms source code";
    dc:description "public simulation and design code for the kinematic-replication model, not the wet-lab cell tracks";
    prov:wasDerivedFrom <https://github.com/skriegman/kinematically_replicating_organisms>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-17--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-glue-17 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-glue-17--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-17--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2023-glue-17 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-glue-17--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-17--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2023-glue-17 by Grok 4.7: 0.55";
