sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2019-boundary-28--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2019-boundary-28: needs-new-data, resolvability 0.38";
    dc:description "Induction of a body-like form by a named class of genes is a direct gain-of-function test, and failure in controls would be decisive. Genomes tell which genes a unicell already has and do not contain the forcing experiment. The dissolution half is likewise untested in open data. The prediction is clear and awaits the experiment.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Force a defined set of electrogenic proteins and gap junctions in a unicellular species and score emergence of a stable, patterned, multi-cell body against transgenic controls; the converse is a bioelectric manipulation that disperses an existing metazoan body. Body formation only in the forced-expression arm would support the induction prediction; no change, or bodies in the controls, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dissolving a metazoan body is a separate intervention with no deposited trial.", "Metazoan-like needs a pre-specified morphology, or any clump will count.", "No public experiment forces this gene set and scores body-like morphogenesis.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-28--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.383"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2019-boundary-28--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Genome";
    dc:description "sequenced unicellular genomes showing which electrogenic genes are already present, not the effect of forcing them";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genome/>.
<https://w3id.org/delphi/resource/assessment/levin-2019-boundary-28--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2019-boundary-28 by Grok 4.7: 0.2";
