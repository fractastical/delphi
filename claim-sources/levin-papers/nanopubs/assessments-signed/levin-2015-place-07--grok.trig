sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-place-07: partially-resolvable, resolvability 0.51";
    dc:description "The in-model half can be probed by editing precisions in the public solver, although the exact 2015 sensitivity settings have to be reconstructed from the paper. The further claim that the same manipulations are predictions for pharmacological treatment of real embryos has no matching public perturbation series, so only the simulation half is testable now.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In the public model, lower the precision or gain on the head-associated chemotactic signal and, separately, raise intracellular-signal precision, then measure segment size, migration, and differentiation. The in-model phenotypes can be confirmed or refuted that way; the pharmacological reading for real embryos needs embryo cohorts that pair those signal changes with anatomy.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No public embryo dataset maps this model's signal channels onto a drug and an anatomical readout.", "The head-shrinking and failed-migration cases are described in prose, not as named switches in the current script.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-place-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-07--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.513"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2015-place-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SPM DEM_morphogenesis";
    dc:description "public model whose signal precisions and chemotactic channels can be edited and re-integrated";
    prov:wasDerivedFrom <https://github.com/spm/spm/blob/main/toolbox/DEM/DEM_morphogenesis.m>.
<https://w3id.org/delphi/resource/evidence/levin-2015-place-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Knowing one's place";
    dc:description "qualitative specification of the sensitivity interventions and the reported dysmorphologies";
    prov:wasDerivedFrom <https://doi.org/10.1098/rsif.2014.1383>.
<https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2015-place-07 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2015-place-07 by Grok 4.7: 0.38";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.38"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok>.
