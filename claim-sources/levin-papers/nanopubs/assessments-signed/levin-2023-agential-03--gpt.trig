<https://w3id.org/delphi/resource/assessment/levin-2023-agential-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-agential-03: partially-resolvable, resolvability 0.53";
    dc:description "A strong restricted version can be tested with evolutionary computation using standard methods. Existing public biological datasets do not directly encode architecture, training history, and novel-condition performance across the broad scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Evolve matched direct and compressed generative genotype-to-phenotype architectures on training environments, then measure performance and plasticity on held-out novel perturbations. Better out-of-distribution performance for compressed architectures across controls would support the mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Novelty and general-purpose success require chosen benchmarks.", "Simulation results may not generalize to organisms.", "The genome-to-VAE analogy is not a literal specified architecture.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-agential-03--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.53"^^xsd:double;
