sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2023-glue-11: needs-new-data, resolvability 0.31";
    dc:description "Sequences and divergence times are public, but the decisive variables are a plastic bioelectric phenotype and its later genetic assimilation, which are not in those databases. A comparative test is definable and cannot be run on existing open data. The claim stays a historical likelihood rather than a result those resources can confirm or refute.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On a phylogeny, find morphology shifts that match a phenotype first produced by a bioelectric manipulation, and ask whether ion-channel substitutions were fixed afterward and then produce the phenotype without the manipulation. That order would support genetic assimilation; channel changes with no such plastic precursor, or plastic phenotypes that were never genetically fixed, would count against it as an important route to body plans.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Likely importance and the Baldwin-effect analogy are not decided by channel sequence divergence.", "No dataset records a bioelectrically induced phenotype and a later genetic fixation of that phenotype.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.57"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-glue-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-11--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.313"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-11--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: UniProt";
    dc:description "ion-channel sequences that could be compared across lineages; they do not record bioelectric phenotypes or assimilation events";
    prov:wasDerivedFrom <https://www.uniprot.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-11--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TimeTree";
    dc:description "divergence times for body-plan splits, without the physiological history of those splits";
    prov:wasDerivedFrom <https://timetree.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-11--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-glue-11 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-glue-11--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-11--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2023-glue-11 by Grok 4.7: 0.22";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.22"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-glue-11--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2023-glue-11--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2023-glue-11 by Grok 4.7: 0.32";
