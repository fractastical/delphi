sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-16--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-girardia-16: needs-new-data, resolvability 0.37";
    dc:description "A setpoint is operationalized here as return toward species shape after a deviant regenerate, once large-scale regeneration has ended. The paper describes that return. The longitudinal measurements that would separate it from ongoing growth are not public, so the homeostatic reading cannot be resolved from existing records.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: After regeneration is complete, measure distance of each head to the species target over days 10 to 17 and test for a return that is absent in animals that already match the target. Return only from the mismatched heads would support a setpoint; indistinguishable drift in both groups would refute a distinct homeostatic correction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Continued morphallaxis can move heads toward the species form without a repeated comparison to a target.", "The internal assessment step is not observed separately from the shape change.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-16--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.372"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/levin-2015-girardia-16--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gap junctional blockade in Girardia dorotocephala";
    dc:description "published remodeling window and example images; longitudinal shape distances are not deposited";
    prov:wasDerivedFrom <https://doi.org/10.3390/ijms161126065>.
<https://w3id.org/delphi/resource/assessment/levin-2015-girardia-16--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2015-girardia-16 by Grok 4.7: 0.3";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
