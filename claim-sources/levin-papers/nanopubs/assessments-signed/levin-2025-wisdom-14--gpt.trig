    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-14--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2025-wisdom-14: partially-resolvable, resolvability 0.57";
    dc:description "Connectivity and transformation are measurable, and public cancer profiles can test associations. The proposed temporal self-reinforcement and tissue-goal interpretation need functional longitudinal data not broadly available.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In longitudinal transformation data, quantify gap-junction coupling, local-state autonomy and malignancy, testing whether an initial coupling decrease predicts further closure and whether restoring coupling interrupts progression. A self-amplifying temporal relation supports the feedback mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Connexin expression is an imperfect proxy for functional coupling.", "Cross-sectional tumours cannot establish positive feedback.", "Geometric-barrier evidence may not share the same mechanism.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-14--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-14--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.57"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-14--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gene Expression Omnibus";
    dc:description "public cancer time-series and connexin-expression datasets";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/>.
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-14--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
