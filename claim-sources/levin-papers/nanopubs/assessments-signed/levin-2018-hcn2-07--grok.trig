sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2018-hcn2-07: partially-resolvable, resolvability 0.65";
    dc:description "The prediction is a defined simulation contrast, and BETSE can run it once nicotine's Hill parameters are copied from the supplement. Those pharmacological constants are less completely fixed in the main text than the HCN2 switch itself, so a mismatch is ambiguous between a false prediction and a rebuilt model. The test can still reject a total loss of pattern or a reversal, which is a partial resolution of the stated prediction.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Add uniform HCN2 to the nicotine-exposed neurula model and compare the neural-tube-minus-lateral Vmem contrast with nicotine alone. Maintenance is confirmed if the contrast remains near the control pattern; collapse of the contrast to the nicotine-only pattern would refute the prediction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A reconstructed configuration can miss the published run even when the qualitative HCN2 switch is real.", "Nicotine is implemented as a Hill function on nAChR and a partial HCN block whose constants sit in the supplement.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.67"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-07--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.648"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BETSE";
    dc:description "simulator in which the uniform-HCN2 plus nicotine condition can be rerun";
    prov:wasDerivedFrom <https://github.com/betsee/betse>.
<https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Channelpedia";
    dc:description "HCN2 voltage dependence used to check preferential opening in the hyperpolarized tube";
    prov:wasDerivedFrom <https://channelpedia.epfl.ch/ionchannels/62>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2018-hcn2-07 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2018-hcn2-07 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of levin-2018-hcn2-07 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of levin-2018-hcn2-07 by Grok 4.7: 0.54";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-discriminating-power>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.54"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of levin-2018-hcn2-07 by Grok 4.7: 0.84";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/operationalizability";
    <https://w3id.org/delphi/ontology/hasScore> "0.84"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok>.
<https://w3id.org/delphi/resource/claim/levin-2018-hcn2-07> <https://w3id.org/delphi/ontology/hasAssessment> <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok>, <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--analysis-feasibility>, <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--data-adequacy>, <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--data-existence>, <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--discriminating-power>, <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--operationalizability>
}
