<https://w3id.org/delphi/resource/assessment/levin-2023-glue-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-glue-12: partially-resolvable, resolvability 0.67";
    dc:description "The bacterial intervention and head-number outcome are concrete and can have strong causal controls. Public availability of animal-level records is uncertain, and the manipulative 'hijack' framing is not required by the phenotype.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare head-number outcomes in germ-reduced planaria colonized with the candidate commensal, vehicle controls, and heat-killed or mutant bacteria, then test clearance and re-colonization rescue. Increased two-headed regeneration attributable to live bacteria confirms the experimental result.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Antibiotic or colonization procedures can independently alter regeneration.", "Matched microbiome and morphology data may not be public.", "Override and hijack imply function beyond causation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-glue-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-glue-12--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.669"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-12--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "public microbiome and bacterial sequence data from host-associated studies";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/evidence/levin-2023-glue-12--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
