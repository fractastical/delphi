sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2015-place-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2015-place-05: resolvable-now, resolvability 0.81";
    dc:description "Timing, free-energy decline, and fate resolution are direct outputs of a public solver the paper tells the reader to run. A short rerun can match or miss the reported eighth-step differentiation. The test resolves the simulation trajectory, and the current target bitmap is a version caveat rather than a missing method.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Re-run the published ensemble from a shared undifferentiated start and record migration time, the time step at which cell-type expectations separate, and ensemble free energy. Differentiation far from the reported eighth step, or free energy that does not fall as identities resolve, would refute the reported trajectory.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Identity resolution is read from the model's expectation variables, which are defined by the same generative model.", "The current default target mask differs from the 2015 head–body–tail pattern, which can shift timing.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2015-place-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-05--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.814"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2015-place-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: SPM DEM_morphogenesis";
    dc:description "public 32-step simulation with free-energy plots and time-dependent differentiation gain";
    prov:wasDerivedFrom <https://github.com/spm/spm/blob/main/toolbox/DEM/DEM_morphogenesis.m>.
<https://w3id.org/delphi/resource/evidence/levin-2015-place-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Knowing one's place";
    dc:description "reported timing, free-energy trajectory, and initial conditions for the 2015 ensemble";
    prov:wasDerivedFrom <https://doi.org/10.1098/rsif.2014.1383>.
<https://w3id.org/delphi/resource/assessment/levin-2015-place-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2015-place-05 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-place-05--grok>.
<https://w3id.org/delphi/resource/assessment/levin-2015-place-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of levin-2015-place-05 by Grok 4.7: 0.72";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
