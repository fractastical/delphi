sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2022-grn-learning-02: partially-resolvable, resolvability 0.67";
    dc:description "The prevalence contrast can be recomputed from public models and code. It does not cleanly show that generic network dynamics are uninvolved, because the null model is a different dynamical family matched only on a few structural summaries. The comparison tests a restricted version of the claim and leaves the evolutionary reading confounded.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Recompute memory-type prevalence, no-memory rates and cross-type correlations for the 35 biological models and for random ODE networks matched on the stated size and centrality measures. A higher biological prevalence on most types, with fewer no-memory cases and stronger correlations, would support the contrast; a matched or reversed pattern would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "BioModels is a publication-biased sample, so enrichment need not mean selection for trainability.", "Random networks use a synthetic gene-circuit equation, while the biological set mixes protein and genetic models.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-02--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.673"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioModels";
    dc:description "curated biological pathway ODEs used as the biological arm of the comparison";
    prov:wasDerivedFrom <https://www.biomodels.org/>.
<https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GRN_ODE";
    dc:description "code that builds the matched random gene-circuit ODEs and scores memory";
    prov:wasDerivedFrom <https://github.com/wesleypclawson/GRN_ODE>.
<https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2022-grn-learning-02 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-02--grok>.
