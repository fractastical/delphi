<https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on levin-2020-xenobots-11: needs-new-data, resolvability 0.47";
    dc:description "Concavity width and persistence are direct morphometric variables with a clear threshold. The published support is a preliminary supplementary figure, not an open table of widths and outcomes. Confirming or refuting the 100 micrometer cutoff requires those measurements or a new build series.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Shape animal-cap aggregates with concavities of graded width and record whether each gap remains after a fixed culture interval; the size threshold holds if gaps at or above 100 micrometers persist and smaller gaps close.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Testing it again requires new microsurgical aggregates.", "The result is described as preliminary work in a supplement figure, without a deposited morphometry table.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.473"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
