sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-16--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2023-goals-16: resolvable-now, resolvability 0.82";
    dc:description "The trajectory, maintenance, and selection objective are inspectable in public code and testable by reruns and controls. The broader assertion about multiscale systems generally exceeds this model, but the stated in-model result is resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Audit the fitness function and evolutionary protocol, then rerun evolved controllers under perturbations and measure temporary increases in target error followed by recovery and long-term maintenance. Compare against unevolved and explicitly selected controls to test whether these abilities arose without direct selection.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Delayed gratification' is an interpretive label for a trajectory.", "Indirect selection or correlation with the fitness objective may explain the capability.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2023-goals-16--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.821"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/levin-2023-goals-16--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: scalefreecognition source-code repository";
    dc:description "public evolutionary-model implementation for auditing objectives and testing evolved controllers";
    prov:wasDerivedFrom <https://github.com/LPioL/scalefreecognition>.
<https://w3id.org/delphi/resource/assessment/levin-2023-goals-16--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2023-goals-16 by GPT-5.6 Sol: 0.88";
