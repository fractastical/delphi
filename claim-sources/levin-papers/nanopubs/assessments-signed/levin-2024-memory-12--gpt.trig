<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2024-memory-12: partially-resolvable, resolvability 0.41";
    dc:description "Public comparative data can test limited correlations, but the causal claim that vulnerability produced intelligence is a historical inference with strong confounding and very broad scope. Existing data cannot decisively separate it from common-cause or reverse explanations.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across species, estimate substrate instability, regenerative and behavioural flexibility, then test whether instability predicts those competencies after phylogenetic and life-history controls. A robust positive relation supports the proposed association, but causal origin would require stronger evolutionary evidence.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Comparative association cannot identify why intelligence evolved.", "Planarian genome noisiness may not generalize.", "Substrate unreliability and intelligence lack agreed cross-species measures.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-memory-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2024-memory-12--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.415"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2024-memory-12--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Genome";
    dc:description "public comparative genome assemblies and annotations";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genome/>.
<https://w3id.org/delphi/resource/evidence/levin-2024-memory-12--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
