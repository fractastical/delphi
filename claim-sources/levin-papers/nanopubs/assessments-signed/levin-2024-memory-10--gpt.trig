    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-10--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2024-memory-10: partially-resolvable, resolvability 0.42";
    dc:description "Comparative plasticity can be measured, but equating it with confabulation and pattern completion is interpretive. Public evidence covers many examples yet is heterogeneous and cannot cleanly establish the proposed strategic parameter.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Construct a preregistered cross-species plasticity index from recovery after standardized anatomical perturbations and test whether it covaries with pattern-completion performance after controlling for phylogeny and experimental effort. A monotonic nematode-to-planarian gradient supports the proposal.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Phylogeny and publication effort strongly confound rankings.", "Species differ in assay availability and injury type.", "Willingness to confabulate is a metaphor requiring a new index.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2024-memory-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2024-memory-10--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.423"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2024-memory-10--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PubMed Central";
    dc:description "open literature corpus from which standardized morphogenetic perturbation outcomes could be compiled";
    prov:wasDerivedFrom <https://pmc.ncbi.nlm.nih.gov/>.
<https://w3id.org/delphi/resource/evidence/levin-2024-memory-10--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "public primary data for subsets of developmental and regeneration experiments";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/assessment/levin-2024-memory-10--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of levin-2024-memory-10 by GPT-5.6 Sol: 0.35";
