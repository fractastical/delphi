    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on levin-2025-wisdom-19: partially-resolvable, resolvability 0.66";
    dc:description "Protection and transcriptomic difference are clear measurable outcomes and may be represented in public sequencing repositories. Existing studies can test the reported Xenopus phenomenon, but environmental confounds and the collective-entity interpretation limit discrimination.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare malformation and survival under identical teratogen doses across isolated embryos, small groups and large groups, and test for a group-specific transcriptomic state. A size-dependent protection effect plus reproducible differential expression supports the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Group density changes chemistry and dose exposure as well as communication.", "Hyperembryo is an interpretation, not a separate measured entity.", "Raw group-level phenotype data may not be deposited.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-19--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-19--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.658"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-19--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Gene Expression Omnibus";
    dc:description "public transcriptomic data from grouped and individual embryo conditions";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/>.
<https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-19--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "raw sequencing reads for independent analysis of the proposed group transcriptome";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
