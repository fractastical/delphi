sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-03--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-03--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2019-boundary-03: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.541"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "Return toward organ-level morphology is measurable and existing studies cover several examples. The stronger language of pursuing a target macrostate is not uniquely distinguished from distributed local rules, and available data cover only a subset of the stated generalization." ;
    rdfs:comment "Proposed test with existing data: For public regeneration and regulative-development series, quantify convergence toward a reference organ morphology after perturbation and compare collective correction with local cell-autonomous or passive-mechanical models." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Target pursuit is an interpretation of morphological convergence.", "Named examples span species and incompatible measurements." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-03--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-03--gpt--operationalizability> a delphi:LLMClaimAssessment ;
