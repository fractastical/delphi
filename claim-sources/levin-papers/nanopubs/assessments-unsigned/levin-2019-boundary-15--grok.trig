sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-15--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-15: not-empirically-resolvable, resolvability 0.13" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.125"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The claim imports the free-energy principle from nervous systems to cells in development and treats it as true of both. Expression and behavioral time series exist, and they underdetermine the objective a system is optimizing. A successful active-inference fit does not rule out simpler homeostasis. No measurement distinguishes the claim from a non-cognitive account of the same developmental path." ;
    rdfs:comment "Proposed test with existing data: Developmental trajectories and neural activity can be fit by a variational free-energy objective. Other control laws fit the same series once latent states are free, so no public time series isolates surprise minimization." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Free-energy minimization is flexible enough to accommodate many trajectories.", "Embryonic cells do not come with an observed generative model." .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-15 by Grok 4.7: 0.3" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
