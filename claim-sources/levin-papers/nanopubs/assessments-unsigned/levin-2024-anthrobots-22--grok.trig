sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-22> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-22--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-22--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-anthrobots-22: needs-new-data, resolvability 0.34" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.343"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "Gap closure under agarose versus under a living bridge is a direct negative-control contrast. The paper reports no repair and does not release the images or densities. One unmatched passive load is also a limited rival to contact mechanics, and neither the null result nor a better-matched control can be checked from open files." ;
    rdfs:comment "Proposed test with existing data: Incubate matched neuronal scratches for four days under agarose pieces sized like superbots and measure gap closure against superbot bridges and against empty scratches. No repair under agarose, with repair under bridges, would support the claim that passive mechanical loading is insufficient; closure under agarose would refute that negative result." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The agarose control is a supporting figure, not a deposited coverage table.", "Agarose stiffness, chemistry and contact area need not match a living bridge.", "A single passive material does not exhaust mechanical explanations." .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-22--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-anthrobots-22 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
