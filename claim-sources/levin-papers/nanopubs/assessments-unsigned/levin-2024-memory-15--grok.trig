sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-memory-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-memory-15--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-memory-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-memory-15: partially-resolvable, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.713"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "The gene-network half of the proposal is now a re-runnable analysis: public code applies associative training to deposited biological models and scores causal emergence against random controls. That does not cover the behavioral example or the claim about reifying a collective Self, and a different integration measure could disagree. The testable network prediction is in good shape; the full statement is only partly resolved by it." ;
    rdfs:comment "Proposed test with existing data: Train published gene-regulatory network models on an associative conditioning protocol without rewiring them, and compare an integration measure before and after training against untrained and random-network controls. A reliable increase supports the network prediction; no increase, or an equal increase in untrained controls, refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Causal emergence is one operationalization of integrated information and need not match other phi-style measures.", "The code covers network models, not a rat's lever-reward memory or a collective Self.", "Results depend on the training schedule and on how network state is coarse-grained." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2024-memory-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2024-memory-15--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-memory-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-memory-15 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-memory-15--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2024-memory-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-memory-15--grok--operationalizability> .
