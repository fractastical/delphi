sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-20--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-20--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-agential-20: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.5"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Cryptic genetic variation can be surveyed in Drosophila resources, and the competency model can show mutations hidden from selection by a developmental layer. Those are partial proxies. They do not identify multiscale competency, as opposed to other buffering, as the cause of a dormant pool that evolution later exploits." ;
    rdfs:comment "Proposed test with existing data: Estimate the fraction of mutations that are phenotypically silent under normal development and revealed under a perturbation, in a system with regulative development, and compare with a direct genotype-to-phenotype encoding if one is available. A larger silent pool that later becomes visible would support cryptic variation produced by buffering; absence of that pool, or a pool explained by protein chaperones rather than developmental correction, would count against the competency-specific version." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Cryptic variation is well documented for chaperones and redundancy, which are rivals to multiscale competency.", "FlyBase does not record a pool of mutations buffered specifically by anatomical error correction." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-20--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-20--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-20--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-agential-20 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-20--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-20--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-20--grok--data-existence> a delphi:LLMClaimAssessment ;
