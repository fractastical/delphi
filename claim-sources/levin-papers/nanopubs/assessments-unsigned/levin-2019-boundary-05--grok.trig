sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-05--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-05: not-empirically-resolvable, resolvability 0.15" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.151"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Ion-channel gene content can be compared across animals, and that comparison does not decide whether neural motor control is a sped-up reuse of developmental bioelectrics. The same molecules fit several evolutionary narratives. The claim is hedged as a scheme that may be an exaptation, and no public observation isolates that scheme." ;
    rdfs:comment "Proposed test with existing data: Shared ion-channel genes are measurable, but exaptation of morphospace navigation into motor control is a historical path. Homology, convergence, and co-option all predict overlapping channels and leave the speed-up story untouched." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Exaptation is an interpretation of conserved physiology.", "No dataset records ancestral anatomical-navigation computations." .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-05 by Grok 4.7: 0.25" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.25"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-05--grok--operationalizability> .
