sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-06--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-06: not-empirically-resolvable, resolvability 0.14" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.139"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The molecular premise is a comparative-genomics statement, but the claim's point is that cognition itself lies on a continuum with pre-neural computation. No agreed measurement of that continuum exists, so sequence conservation does not confirm or refute it. The same gene families support a continuum story and a story of reused parts in different computations. The distinguishing claim is not empirically fixed." ;
    rdfs:comment "Proposed test with existing data: Molecular conservation of channels and transmitters can be scored from sequences. A continuum of cognitive capacity needs a scale on which brains and pre-neural cells are ordered, and competing scales reorder the same organisms." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Several operationalizations of cognition give different orderings.", "Shared molecules are compatible with discontinuous cognitive mechanisms." .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-06 by Grok 4.7: 0.28" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.28"^^xsd:double ;
