sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-26> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-26--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-26--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-26: partially-resolvable, resolvability 0.57" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.567"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "The computational content, multiple attractors switched by a transient input under fixed channel parameters, is what BETSE was built to explore and can be tested by a standard parameter sweep. That resolves the circuit claim inside the model. The biological reading, that tissues actually store anatomy this way, depends on experiments whose raw physiological traces are not deposited, and transcriptional storage remains a rival. Code makes the software analogy partly resolvable and leaves the tissue claim open." ;
    rdfs:comment "Proposed test with existing data: In an ion-channel and gap-junction network, show at least two stable Vmem patterns and a transient stimulus that switches them with channel genes held fixed. Multistability under fixed parameters would support the software analogy in the model; a unique steady state, or a switch that requires changing channel expression, would refute it there. The tissue reading additionally needs a transient in vivo stimulus that permanently changes anatomy without a DNA change." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A multistable model does not show that tissues occupy those attractors.", "Transcriptional memory can store a new anatomical state with the DNA sequence unchanged.", "No public time series records an in vivo bioelectric switch and the subsequent attractor." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-26--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-26--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-26 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-26--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-26> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-26--grok--operationalizability> .
