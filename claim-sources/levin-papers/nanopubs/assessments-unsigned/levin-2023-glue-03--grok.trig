sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-glue-03--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-glue-03: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.583"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.67"^^xsd:double ;
    dct:description "This is the same preparation as the behavioural tail-eye result, with a narrower endpoint: vision and a spinal connection. The experimental paper publishes those outcomes for this scope. They can be checked against the described controls and cannot be recomputed from an open trial file." ;
    rdfs:comment "Proposed test with existing data: In Xenopus tadpoles with no primary eyes and one tail eye, score visually guided learning and trace axons from that eye. Learning that requires the tail eye, with axons entering the spinal cord, would support seeing through the ectopic eye; chance performance, or learning that remains after the tail eye is removed, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Published performance is a summary, not trial-level choices.", "Extraocular photoreception is the main rival and has to be read off the paper's controls." .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-glue-03 by Grok 4.7: 0.85" ;
