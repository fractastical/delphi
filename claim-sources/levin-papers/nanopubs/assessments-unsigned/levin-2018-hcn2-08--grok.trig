sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-08--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-08: partially-resolvable, resolvability 0.53" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.526"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Both sides of the comparison are quantitative. Only the simulated 30 mV can be regenerated from public code and the printed parameters. The embryo 15 mV is a published summary of images that were not deposited, so the discrepancy cannot be remeasured, only checked for consistency with the model. The claim is therefore half open." ;
    rdfs:comment "Proposed test with existing data: Compare two deltas at the neural tube: simulated HCN2 (or IT) hyperpolarization versus control, and dye-calibrated in vivo hyperpolarization after Hcn2 mRNA. The discrepancy claim holds if the model delta is near 30 mV and the embryo delta near 15 mV; either number moving onto the other would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The in vivo ~15 mV comes from non-public voltage-dye images.", "Dye calibration depends on a small set of whole-cell recordings.", "Model millivolts move with the reconstructed cAMP and leak settings." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-08--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-08 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-08--grok--operationalizability> .
