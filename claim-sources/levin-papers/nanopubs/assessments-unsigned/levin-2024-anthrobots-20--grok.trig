sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-20--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-20--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-anthrobots-20: needs-new-data, resolvability 0.40" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.4"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "Local neuronal coverage at 72 hours under a superbot versus elsewhere on the scratch is a clear endpoint. The paper shows examples and states a qualitative regrowth result, with the images and measurements available on request. Example panels are not the replicate set, so the induction claim still needs the withheld images or a new scratch series." ;
    rdfs:comment "Proposed test with existing data: Place fused Anthrobot bridges across scratches in human neuronal monolayers and measure neuronal coverage under the bridge at 72 hours versus the same scratch without a bridge. Closure confined to the bridge, forming a stitch between the two sides, would support induction; no local regrowth, or regrowth everywhere along the scratch, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Replicate images and coverage values are not deposited; the paper reports that five of ten bridges stayed in place.", "The neuronal cultures are one hiNSC differentiation protocol.", "A stitch under the bot can be passive edge apposition rather than induced regrowth." .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-20--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-anthrobots-20 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
