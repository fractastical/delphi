sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-12--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-girardia-12: needs-new-data, resolvability 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.384"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Same-genome, different-anatomy is testable by pairing sequence with shape. Public nucleotide records identify the species and do not include the treated cohort. The paper's wild-type premise and the morphological outcome are published summaries, not a dataset that can confirm the physiological input." ;
    rdfs:comment "Proposed test with existing data: Hold genotype fixed by sequencing treated and control fragments, perturb gap-junction connectivity, and test whether head shape moves among the reference species forms. Shape change with an unchanged genome would support a physiological input; sequence differences tracking the new shapes, or no shape change, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Treated animals were not deposited as sequenced genotypes paired with head shape.", "Octanol can alter shape through non-bioelectric toxicity, so shape change alone does not identify the network as the input." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-girardia-12 by Grok 4.7: 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.62"^^xsd:double ;
