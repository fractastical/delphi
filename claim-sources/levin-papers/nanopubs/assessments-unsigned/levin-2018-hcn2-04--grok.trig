sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-04--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-04: partially-resolvable, resolvability 0.43" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.435"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "The voltage half of the explanation can be rerun in BETSE. The causal half, that this voltage change is why the brain fails, needs the rescue and loss-of-pattern experiments, whose raw scores were not deposited. Published papers from the same group report related Vmem manipulations, which is enough to examine the mechanism on a narrow Xenopus scope and not enough to separate nicotine's other targets. The claim is therefore only partly open to analysis." ;
    rdfs:comment "Proposed test with existing data: Treat the explanation as two results: the model must reduce neural-tube hyperpolarization under nicotine, and brain-defect incidence must track that voltage pattern when voltage is restored or disrupted with nicotine held constant. Failure of the voltage prediction, or defects that persist after the prepattern is restored, would refute the explanation." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Brain-morphology counts for the rescue series are summary bars, not an open embryo table.", "Nicotine has several channel and transcriptional targets, so a voltage correlation is confounded.", "Prior Vmem-to-brain papers are separate figures that would have to be compiled by hand." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-04--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-04 by Grok 4.7: 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.62"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-04--grok--operationalizability> .
