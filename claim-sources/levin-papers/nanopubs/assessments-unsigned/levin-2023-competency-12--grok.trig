sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-12--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-competency-12: partially-resolvable, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.74"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The public experiment can plot how often the competency gene changes relative to structural genes, so the reported inequality is re-computable. That inequality does not cleanly mean evolution works on competency more, because one wide-ranged competency locus is not comparable to fifty structural loci without a normalization the claim does not apply. The raw count is testable; the effort interpretation is confounded." ;
    rdfs:comment "Proposed test with existing data: In the evolvable-competency runs, attribute each positional change to either the competency allele or one of the fifty structural genes and compare change frequencies. A significantly higher competency-gene rate would reproduce the count; similar rates would refute it. The comparison still has to rule out an artifact of the allele's numeric range." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A competency allele ranging toward 500 can register more changes than a positional gene for mechanical reasons.", "Mutation rate and representation are not matched per locus in a way that isolates evolutionary effort." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-competency-12--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-competency-12 by Grok 4.7: 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.86"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-competency-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-12--grok--operationalizability> .
