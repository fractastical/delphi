sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-12--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-12: needs-new-data, resolvability 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.363"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Wild-type versus pore-mutant under nicotine is a clear conductance test. The published contrast is a summary percentage in one figure, with supporting electrophysiology only in the supplement's traces. No open dataset records expression-matched defect calls. Until those calls or a replication exist, the dependence on conductance cannot be reanalyzed." ;
    rdfs:comment "Proposed test with existing data: Under the same nicotine regimen, compare major brain-defect incidence after Hcn2-DN (GYG to AAA) mRNA with the wild-type HCN2 rescue arm. Conductance dependence is confirmed if the DN arm stays near 70% defective while wild-type HCN2 returns to control; rescue by the DN construct would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "DN and wild-type morphology counts are not in a public table.", "The pore mutant must be shown to lack current in the embryo, not only in a heterologous cell.", "Unequal protein level could mimic a conductance requirement." .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-12 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
