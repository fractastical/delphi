  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-16--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2025-wisdom-16: partially-resolvable, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.708"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "The perturbations, negative conditions and phenotype components are explicit and discriminating. The reported experiments can resolve the restricted Xenopus claim, but public raw-data completeness and the strength of the no-DNA-damage condition are uncertain." ;
    rdfs:comment "Proposed test with existing data: Compare melanocyte proliferation, migration, vascular or brain invasion and morphology after transient bioelectric or serotonergic perturbation with vehicle, oncogene and DNA-damage controls. A melanoma-like suite in genetically normal, damage-negative animals supports the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Melanoma-like is a phenotype analogy rather than a tumour diagnosis.", "Excluding all DNA damage requires direct assays.", "Raw animal-level data may remain in paper supplements." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-16--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-16--gpt--operationalizability> a delphi:LLMClaimAssessment ;
