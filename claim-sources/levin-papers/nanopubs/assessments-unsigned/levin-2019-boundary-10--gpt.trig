sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-10--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-10--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2019-boundary-10: not-empirically-resolvable, resolvability 0.15" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.154"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.85"^^xsd:double ;
    dct:description "Multiscale biological organization is measurable, but the move from modules to multiple Selves is conceptual. Without a criterion that differs from the definition itself, observations cannot distinguish the claim from rival ontologies." ;
    rdfs:comment "Proposed test with existing data: One could infer nested clusters from multiscale information flow and control, but whether each cluster counts as a Self depends on the framework's chosen individuation criterion." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "No unique measurable threshold defines a Self.", "Nested causal modules do not uniquely imply nested selves." .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-10--gpt--operationalizability> a delphi:LLMClaimAssessment ;
