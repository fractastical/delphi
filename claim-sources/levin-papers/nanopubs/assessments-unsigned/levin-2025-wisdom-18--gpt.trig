  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-18--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2025-wisdom-18: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.47"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "Public cancer resources can compare genetic and physiological correlates and test restricted intervention responses. They cannot support the sweeping dominance conclusion or clinical implication without matched causal trials across heterogeneous cancers." ;
    rdfs:comment "Proposed test with existing data: Across cancer models, compare outcome variance explained and causal rescue achieved by physiological-state interventions versus genotype, stratifying by tumour type and mutation. Consistent normalization despite persistent driver mutations would support a restricted dominance claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Dominates outcomes is undefined across cancer types.", "Observational clinical data confound genotype and physiology.", "Xenopus normalization does not establish a human therapeutic roadmap." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-18--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-18--gpt--dataset-3> .
