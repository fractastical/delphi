sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-32> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-tame-32: partially-resolvable, resolvability 0.53" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.533"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Pharmacology databases can test whether general anesthetics inhibit connexins, and at what concentration relative to their main targets. That addresses the gap-junction-blocker clause and can fail it for agents whose clinical action is elsewhere. Loss of a higher-level Self, and anesthesia by gap-junction block from plants to humans, is only partly represented by those ligand tables." ;
    rdfs:comment "Proposed test with existing data: Compare anesthetic potency at connexins with potency at primary targets such as GABA-A receptors, and test whether selective gap-junction blockers stop organism-level behavior in plants, Hydra, and animals while cell viability remains." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Many anesthetics act on synaptic receptors at concentrations below those reported for connexin block.", "Behavioral arrest in plants and Hydra is in a few papers, not in these pharmacology databases.", "Disappearance of a higher-level Self is not a variable separate from loss of coordinated behavior." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-tame-32--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-32--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-tame-32 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-32> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-32--grok--data-existence> a delphi:LLMClaimAssessment ;
