    rdfs:label "Candidate dataset: IUPHAR/BPS Guide to Pharmacology" ;
    dct:description "curated target and ligand records for anesthetics, connexins, and the primary neural receptors" ;
    prov:wasDerivedFrom <https://www.guidetopharmacology.org/> .
