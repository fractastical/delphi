sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-glue-18--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-glue-18: partially-resolvable, resolvability 0.53" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.526"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The primary study is a public geometric morphometric series with a defined landmark scheme and canonical variate tests across months of tadpole life. Without the coordinate file, a new worker can re-read the published separations but cannot recompute individual trajectories. The data can test return toward normal for some structures in this one species, and they are weaker for a single shared goal region reached by new paths." ;
    rdfs:comment "Proposed test with existing data: Using the published 32-landmark scheme, compute Procrustes distance of scrambled versus unperturbed tadpoles to the normal frog-face configuration at successive ages, separately for jaws, branchial arches, eyes, nostrils and otoliths. Convergence of scrambled animals onto the control region along trajectories that normal animals do not follow would support the claim; persistent separation, or correction of only some structures, would restrict it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Landmark coordinates are published as analyses, not as a downloadable coordinate table.", "Age-binned group averages do not reconstruct individual paths through morphospace.", "Jaws and branchial arches are scored separately from eyes, nostrils and otoliths, so one face-wide goal region is an extra summary." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-glue-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-glue-18 by Grok 4.7: 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.82"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-glue-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-glue-18--grok--operationalizability> .
