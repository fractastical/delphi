sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-21--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-girardia-21: partially-resolvable, resolvability 0.44" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.442"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.57"^^xsd:double ;
    dct:description "Public sequences can rebuild the distance half of the suggestion. The ease-of-shifting half is represented only by shape frequencies from one treated species, not by reciprocal perturbations across the clade. The phylogenetic ranking is therefore checkable now, and the network-evolution claim is not." ;
    rdfs:comment "Proposed test with existing data: Estimate phylogenetic distance from public planarian rRNA and compare it with the rate at which a standardized gap-junction block moves each species into the other species' head states. A monotone relation between distance and that transition rate would support the suggestion; no relation, or a relation that reverses after controlling for morphology, would weaken it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Only Girardia was pharmacologically shifted, so ease of transition is not measured in the other species.", "A frequency ranking can track raw morphological similarity rather than network distance." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-girardia-21 by Grok 4.7: 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.52"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
