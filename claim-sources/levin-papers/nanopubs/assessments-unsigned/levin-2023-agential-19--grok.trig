sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-19--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-19--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-agential-19: partially-resolvable, resolvability 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.617"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.67"^^xsd:double ;
    dct:description "The model was built to compare hardwired and regulative development and its outputs are public, so the efficiency and masking effects can be recomputed. That tests the mechanism inside the stated simulation, which covers only a thin analogue of regulative evolution. Organismal fitness landscapes and the hypothetical mouth correction are not in those files." ;
    rdfs:comment "Proposed test with existing data: From the saved competent and hardwired populations, compare phenotypic variance among genotypes, escapes from local fitness plateaus, and whether a deleterious local displacement is corrected before fitness is scored. Lower phenotypic differences and more escapes under competency would support smoothing and more efficient search in the model; identical landscapes would refute it there." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The fitness landscape is a toy monotonic gradient, so local maxima of real development are not in the data.", "Smoothing by competency is not separated, in organisms, from canalization by other mechanisms." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-19--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-19--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-agential-19 by Grok 4.7: 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.65"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-19--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-19--grok--operationalizability> .
