  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-04--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-04--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2019-boundary-04: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.653"^^xsd:double ;
