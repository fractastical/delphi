sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-tame-19: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.783"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "Both clauses are gene-set comparisons, and the annotations and association catalogs needed for them are public and standard to analyze in days. Removing the already-shared channel, connexin, and transmitter genes is a pre-registered way to test specificity, and a null result would refute excess overlap. Coverage is weaker for regeneration screens and for non-mammalian animals than for human learning and development genes, which limits scope rather than blocking the test." ;
    rdfs:comment "Proposed test with existing data: Test enrichment between morphogenesis genes and learning or memory genes after removing ion channels, connexins, and neurotransmitter machinery, using a degree-matched null; also test whether learning and memory genes are enriched in cancer, regeneration, and embryogenesis gene sets." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "GO annotations are biased toward human, mouse, and heavily studied genes.", "Regeneration genetics is largely RNAi and mutant screens, which are less completely captured by GO and the GWAS Catalog than cancer is." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-tame-19--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-19--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-tame-19 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-19--grok--operationalizability> .
