  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-10--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2025-wisdom-10: partially-resolvable, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.708"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "Eye identity and location are directly scoreable, and the original published experiment can resolve sampled Xenopus regions. Lack of known complete raw data and the broad wording prevent treating the claim as fully resolvable now." ;
    rdfs:comment "Proposed test with existing data: Map ectopic eye incidence, location and tissue composition after potassium-channel misexpression and compare posterior competence with matched Pax6 perturbations. Histologically complete eyes across many posterior tissues support the claim; confinement to anterior fields or non-eye pigmented spots refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Raw embryo-level images and injection maps may not be public.", "Almost anywhere is broader than sampled body regions.", "Channel expression can have indirect developmental effects." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-10--gpt--dataset-1> .
