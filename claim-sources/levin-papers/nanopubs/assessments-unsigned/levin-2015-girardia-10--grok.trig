sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-10--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-girardia-10: needs-new-data, resolvability 0.40" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.404"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Coherent species-like heads versus failed or disorganized regeneration is an observable classification. The paper reports that only the coherent classes occurred. The animal-level classifications are not public, so the negative observation cannot be re-tallied, and a new scored cohort would be required to test it." ;
    rdfs:comment "Proposed test with existing data: Score regenerated heads as reference-species shapes, wild-type Girardia, regeneration failure, or disorganized growth, and test whether octanol yields only the coherent classes with no intermediate shapes. A substantial fraction of failures, tumors, or intermediate outlines would refute the instructive-outcome claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Absence of intermediates is an author-reported negative, without a deposited classification of every animal.", "Octanol has pharmacological actions besides gap-junction block, so coherent shapes still need the hexanol and dose evidence to speak to mechanism." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-10--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-girardia-10 by Grok 4.7: 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.68"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-10--grok--operationalizability> .
