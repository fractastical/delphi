sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-08--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-08--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2025-wisdom-08: partially-resolvable, resolvability 0.73" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.73"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Large public genotype-phenotype resources make the channelopathy component highly analysable. The broader symmetry and applicability of all neuroscience tool classes are only partly covered and not uniquely established by shared ion-channel mechanisms." ;
    rdfs:comment "Proposed test with existing data: Systematically estimate enrichment of developmental-patterning phenotypes among pathogenic ion-channel variants and catalogue controlled morphogenetic effects of drugs, optogenetic perturbations and training protocols. Enrichment and reproducible control across modalities support the empirical generalization." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Deep symmetry is interpretive rather than a single endpoint.", "Phenotype annotation and ascertainment vary by gene.", "Training-protocol evidence is much thinner than channelopathy evidence." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-08--gpt--dataset-3> .
