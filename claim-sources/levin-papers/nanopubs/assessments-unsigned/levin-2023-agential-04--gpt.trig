sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-04--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-04--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-agential-04: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.502"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Individual consequences of coupling are measurable in public molecular and imaging studies. The full claim links these effects to collective intelligence and larger goal states, for which existing datasets provide only proxies and substantial confounding." ;
    rdfs:comment "Proposed test with existing data: Across matched tissues with altered gap-junction coupling, quantify signal propagation distance, persistence, predictive accuracy, and recovery to an anatomical setpoint. Coupling-dependent increases, rescued by restored junctional conductance, would support scaling of network capacity." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Memory and goal pursuit have multiple operationalizations.", "Gap junctions also alter metabolism and development directly.", "Matched electrophysiology and anatomical outcomes are uncommon." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-04--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-04--gpt--dataset-2> .
