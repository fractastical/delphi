sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-07--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2020-xenobots-07: partially-resolvable, resolvability 0.37" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.37"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Maintenance of designed behavior in a novel configuration is observable and is described in the published builds. Attributing that outcome to behavioral competence and cooperation, rather than to the mechanics of adhesion and contraction, has no measurement that would come apart from those mechanics. Public materials can speak to the outcome and leave the causal wording underdetermined." ;
    rdfs:comment "Proposed test with existing data: Score whether novel, nerve-free, mixed-tissue builds maintain the designed behavior and external shape; competence-as-cause would require that outcome to survive only when a separate, pre-registered measure of cell-level cooperation is intact." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Biophysical self-assembly predicts the same maintenance of shape and movement.", "No deposited dataset records a cell-level competence variable separate from the organism-level behavior." .
  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2020-xenobots-07 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-07--grok--operationalizability> .
