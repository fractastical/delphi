  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-18--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-agential-18: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.599"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "The absolute 'no known strain' statement is searchable and readily falsified, and transgenesis attempts can be catalogued. Publication bias and unequal technical effort prevent those observations from decisively confirming the competency-ratchet mechanism." ;
    rdfs:comment "Proposed test with existing data: Systematically search planarian strain, mutant, and transgenesis records for heritable abnormal morphology, classify genetic versus physiological origins, and compare discovery effort with established model organisms. A verified genetic strain with stable abnormal morphology refutes the absolute prediction." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Absence of reports is not proof of absence.", "Planarian research effort and genetic tools differ from fly and mouse.", "The claimed explanation is not uniquely predicted by the observation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-18--gpt--dataset-2> .
