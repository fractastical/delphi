    delphi:hasScore "0.454"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Signal diffusion and response equivalence are measurable proxies, but the ownership and identity language permits competing operationalizations. Existing imaging studies can test a restricted biophysical consequence rather than the full cognitive interpretation." ;
    rdfs:comment "Proposed test with existing data: Locally induce a traceable calcium or stress signal in coupled cells and compare source attribution, propagation, and collective response before and after gap-junction blockade." ;
