  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-20--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-glue-20: partially-resolvable, resolvability 0.45" ;
