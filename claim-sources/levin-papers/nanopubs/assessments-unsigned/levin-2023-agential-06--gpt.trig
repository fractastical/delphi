sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-06--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-06--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-agential-06: partially-resolvable, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.482"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Sequence and functional databases permit restricted ancestral reconstructions and modern biofilm tests. They cannot resolve evolutionary purpose or cleanly date the proposed discovery, so only mechanistic continuity is presently testable." ;
    rdfs:comment "Proposed test with existing data: Reconstruct the phylogenetic distribution and ancestral functions of ion channels, pumps, and electrical coordination, and compare biofilm-level spatial information integration with later metazoan uses. Support requires early origin plus evidence that networked information processing, not merely ion homeostasis, was ancestral." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Ancient function must be inferred from modern lineages.", "Electrical coordination and information processing can be defined circularly.", "The timing 'around bacterial biofilms' is imprecise." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-06--gpt--dataset-2> .
