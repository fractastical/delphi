    rdfs:label "Candidate dataset: Cell Collective" ;
    dct:description "public Boolean gene-regulatory models, including the networks used in the cited memory surveys" ;
    prov:wasDerivedFrom <https://cellcollective.org/> .
  <https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-2> a delphi:EvidenceItem ;
