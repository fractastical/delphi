sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-06--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-tame-06: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.67"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The models themselves are public, in Cell Collective and BioModels, and a later ODE analysis has open code, so a defined pairing protocol can be re-run. The flagship Boolean analysis did not release its code, and the cited papers do not share one decision rule. A new screen can test learning capacity in the published models and will not automatically reproduce each cited result." ;
    rdfs:comment "Proposed test with existing data: On published GRN models, pair a cue with an outcome-producing stimulus and test whether the cue later changes the response relative to unpaired controls; associative learning, pattern completion, or generalization holds if the paired network meets that criterion and a shuffled network does not." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Code for the 2021 Boolean memory screen was withheld, so the exact published runs cannot be replayed.", "Associative learning, pattern completion, and generalization are defined differently across the cited papers." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-06--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-tame-06 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
