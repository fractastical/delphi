sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-12--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-tame-12: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.543"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Endpoint position versus path shape is a direct test, and the Xenopus craniofacial papers report morphometrics for this preparation, including abnormal paths and overshoot. Those measurements are scattered in journal figures rather than an open coordinate file. They can support the setpoint reading for this species and leave mechanical funneling as a live alternative." ;
    rdfs:comment "Proposed test with existing data: Track craniofacial organ positions from scrambled tadpole arrangements through metamorphosis and test whether endpoints cluster on the normal frog-face coordinates even when the paths are abnormal or overshoot." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Landmark time series are published as paper figures and summaries, not as a deposited coordinate table.", "Mechanical packing in the head could funnel organs toward the same endpoints." .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-tame-12 by Grok 4.7: 0.75" ;
