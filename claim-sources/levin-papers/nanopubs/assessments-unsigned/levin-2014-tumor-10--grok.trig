sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2014-tumor-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-10--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2014-tumor-10: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.512"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Suppression by two different ionic routes is published and is the right kind of evidence for a voltage-level rather than a channel-identity cause. The summaries are not a voltage-matched series, and raw voltages are not public. The Xenopus contrasts therefore speak to part of the general causal claim and leave the matched test incomplete." ;
    rdfs:comment "Proposed test with existing data: Match the degree of hyperpolarization achieved by a potassium channel and by chloride loading, and test whether tumor suppression follows voltage rather than channel identity. Equal suppression at equal voltage, and loss of suppression when voltage is clamped back, would support the systems-level claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The two treatments were not published as voltage-matched dose responses.", "Chloride loading and potassium-channel expression can share non-voltage effects." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2014-tumor-10--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2014-tumor-10 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2014-tumor-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-10--grok--operationalizability> .
