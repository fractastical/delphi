sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-21--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-21--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2025-wisdom-21: needs-new-data, resolvability 0.43" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.435"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "The hypothesis can be tested with spatial bioelectric imaging and causal restoration, but existing public ageing datasets provide only indirect molecular proxies. They lack the pattern-level longitudinal and intervention data needed to distinguish this mechanism from cell-autonomous ageing." ;
    rdfs:comment "Proposed test with existing data: Longitudinally quantify tissue-scale voltage-pattern stability with age, then experimentally restore youthful patterns without cell reprogramming and test whether tissue organization and function improve beyond matched controls. Pattern decay preceding dysfunction and selective rescue would support the mechanism." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Available ageing atlases do not directly measure spatial voltage memories.", "Correlation with ion-channel expression cannot establish pattern-memory degradation.", "The decisive restoration intervention requires new longitudinal data." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-21--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-21--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-21--gpt--dataset-3> .
