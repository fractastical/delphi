sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-10--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-goals-10: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.592"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The information-theoretic contrast is specified tightly enough, and the model code is public, that recomputing stripe-to-stripe transfer entropy is analysis rather than a new experiment. What is missing is the evolved network and the traces behind the published peaks, so a re-evolution tests whether the reversal is a typical output, not whether the reported run had it. The organizer reading remains a gloss on that asymmetry." ;
    rdfs:comment "Proposed test with existing data: On logged cell-state time series from the evolved French-flag network, compute pairwise local transfer entropy between red and white stripe cells with history k = 4, as defined in the paper. A red-to-white peak before about step 60 followed by a larger white-to-red peak confirms the reported reversal; no reversal, or a reversal that disappears under alternate binning, refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The published winner network and cell-state time series are not in the repository, and the committed run.py uses a two-generation demonstration setting.", "Transfer entropy is computed on one representative individual; stripe-to-stripe sums are confounded by which cells are actually changing state.", "Directed information flow is not a graft assay, so it does not show that a stripe instructively induces pattern in the other." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-goals-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-goals-10--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-goals-10 by Grok 4.7: 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.86"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-goals-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-10--grok--operationalizability> .
