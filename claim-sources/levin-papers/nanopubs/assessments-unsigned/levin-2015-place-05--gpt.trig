  <https://w3id.org/delphi/resource/assessment/levin-2015-place-05--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2015-place-05: resolvable-now, resolvability 0.90" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.898"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    dct:description "All central variables and the decision criterion are explicit model outputs. Independent reruns over seeds can determine whether the described sequence and ambiguity resolution are robust." ;
    rdfs:comment "Proposed test with existing data: Run the specified eight-cell simulation from undifferentiated co-located states and record trajectories, fate probabilities, and ensemble free energy. The claim is supported if migration precedes differentiation near step eight and contextual fate ambiguity resolves; otherwise it is refuted." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Exact random seeds are not reported." ;
