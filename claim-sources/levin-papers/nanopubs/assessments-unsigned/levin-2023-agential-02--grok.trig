sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-02--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-agential-02: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.502"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The cited competency model is public, includes saved runs, and can show whether selection shifts onto competency parameters. That is a proxy for one sentence of a much broader claim about what evolution searches in metazoans. Sequence collections do not discriminate behaviour-shaping signals from the rest of the genome as the object of search." ;
    rdfs:comment "Proposed test with existing data: In the public artificial-embryogeny model, compare the rate of fitness gain and the fraction of accepted changes in competency rules versus structural genes. Faster search and a shift toward competency edits would support a proxy in which evolution spends its effort on behaviour-shaping rules; equal or greater progress through structural edits would count against that proxy." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The simulation searches a toy axial map, not the space of metazoan cell-behaviour rules.", "Elevated evolution of signalling genes is compatible with ordinary selection on phenotypes and does not identify the search space." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-02--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-agential-02 by Grok 4.7: 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.42"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-02--grok--operationalizability> .
