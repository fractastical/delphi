  <https://w3id.org/delphi/resource/evidence/levin-2023-agential-02--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Cellular competency evolution model" ;
    dct:description "public simulations and saved runs contrasting hardwired and competent development, the nearest explicit search process" ;
    prov:wasDerivedFrom <https://github.com/lksshw/CellularCompetency> .
  <https://w3id.org/delphi/resource/evidence/levin-2023-agential-02--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: NCBI Datasets genomes" ;
    dct:description "comparative gene repertoires for a weak proxy based on signalling versus structural genes" ;
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/datasets/genome/> .
