  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-22--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2022-grn-learning-22: needs-new-data, resolvability 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.347"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "The mechanism has measurable consequences, but the necessary joint in vivo time series and interventions are not identified in current public resources. New perturbation experiments are likely required." ;
    rdfs:comment "Proposed test with existing data: Measure natural intercellular pulse sequences, pathway-state changes, and resulting developmental phenotypes, then test whether disrupting pulse timing specifically removes history-dependent pathway shaping. Existing pulsatility alone does not demonstrate evolved behaviour-shaping." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Public datasets rarely pair pulse-resolved signalling with pathway memory and morphology.", "The evolutionary function is difficult to distinguish from ordinary signalling." .
