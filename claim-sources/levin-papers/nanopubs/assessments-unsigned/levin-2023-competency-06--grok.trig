sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-06--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-competency-06: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.8"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Takeover is a head-count in a fully specified genetic algorithm, and the mixed-population script is public. A few fraction-by-competency cells may need to be set from the paper rather than the default JSON, which is still reimplementation of a stated model. The numerical thresholds can be confirmed or refuted by those runs." ;
    rdfs:comment "Proposed test with existing data: Rerun mixed populations of 200 embryos at the stated initial competent fractions, including 2.5, 10, 20 and 30 percent, across competency levels, and record whether competent genomes exceed half the population within two or three generations. Dominance thresholds near 75, 40 and 10, and failure at 2.5 percent even at competency 95, would confirm the claim; dominance at 2.5 percent or failure at the higher shares would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The default hyperparameter file does not list every fraction in the claim, so some grid points must be set from the paper." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-competency-06--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-competency-06 by Grok 4.7: 0.93" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.93"^^xsd:double ;
