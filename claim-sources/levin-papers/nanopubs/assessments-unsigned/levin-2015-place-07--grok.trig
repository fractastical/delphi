sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-place-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-place-07: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.513"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The in-model half can be probed by editing precisions in the public solver, although the exact 2015 sensitivity settings have to be reconstructed from the paper. The further claim that the same manipulations are predictions for pharmacological treatment of real embryos has no matching public perturbation series, so only the simulation half is testable now." ;
    rdfs:comment "Proposed test with existing data: In the public model, lower the precision or gain on the head-associated chemotactic signal and, separately, raise intracellular-signal precision, then measure segment size, migration, and differentiation. The in-model phenotypes can be confirmed or refuted that way; the pharmacological reading for real embryos needs embryo cohorts that pair those signal changes with anatomy." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The head-shrinking and failed-migration cases are described in prose, not as named switches in the current script.", "No public embryo dataset maps this model's signal channels onto a drug and an anatomical readout." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-place-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-07--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-place-07 by Grok 4.7: 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.64"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2015-place-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-place-07--grok--operationalizability> .
