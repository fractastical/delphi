sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-13--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-13--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-goals-13: needs-new-data, resolvability 0.44" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.444"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "The prediction is measurable once a duration and event definition are chosen, but suitable long-running image series are not known to cover its broad biological scope. A decisive test therefore needs prospective long-term observation rather than re-reading endpoint figures." ;
    rdfs:comment "Proposed test with existing data: Identify biological patterns declared morphologically stable, follow them with repeated imaging well beyond their usual endpoint, and estimate the incidence and timing of spontaneous fate remodelling. Persistent stability in adequately powered long-duration cohorts would refute the prediction for the tested systems." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Most experiments stop observation when the expected endpoint is reached.", "The claim does not specify taxa, frequency, or a minimum quiescent interval.", "Sparse late events are vulnerable to survivorship and husbandry confounds." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-goals-13--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-13--gpt--operationalizability> a delphi:LLMClaimAssessment ;
