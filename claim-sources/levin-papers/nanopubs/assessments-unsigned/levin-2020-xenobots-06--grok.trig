sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-06--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2020-xenobots-06: resolvable-now, resolvability 0.77" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.773"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "The claim is about an outcome inside a specified soft-body evolutionary simulation, and the code for that simulation is public. A small team can re-evolve populations and measure whether shape and tissue arrangement reduce the randomness of global motion relative to unselected controls. That comparison confirms or refutes the derandomization result without new biological data." ;
    rdfs:comment "Proposed test with existing data: Re-evolve locomotion under randomly phased contractile voxels and track, across generations, shape plus the fraction of passive versus contractile cells against the variance of heading or centroid velocity; derandomization holds if coherence rises under selection and stays low in unselected controls." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The 2019 VoxCad build is finicky to compile, and exact seeds are needed to match historical runs.", "Coherence must be defined from the supplement; several variance metrics could be computed." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2020-xenobots-06--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2020-xenobots-06 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-06--grok--operationalizability> .
