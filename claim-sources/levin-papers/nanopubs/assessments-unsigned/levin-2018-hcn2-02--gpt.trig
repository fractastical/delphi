sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2018-hcn2-02: resolvable-now, resolvability 0.90" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.899"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.91"^^xsd:double ;
    dct:description "This is a quantitative simulation result using public software and a detailed supplementary model specification. Regional voltages can be reproduced and compared directly with the article's empirical calibration measurements." ;
    rdfs:comment "Proposed test with existing data: Run the published BETSE neurula model with the stated regional leak permeabilities, Kir channels, ionic medium, and gap junctions, then extract Vmem by region. The claim is confirmed if the neural tube approaches -50 mV while folds and ectoderm remain near -5 mV and the pattern matches measured voltage maps." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Exact software-version differences may affect numerical details.", "Regional permeability assumptions are calibrated rather than independently derived." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--gpt--dataset-2> .
