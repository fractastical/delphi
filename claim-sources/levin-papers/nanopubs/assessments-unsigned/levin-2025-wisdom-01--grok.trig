sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2025-wisdom-01: partially-resolvable, resolvability 0.61" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.615"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Genome disorder and regenerative capacity are the parts of the claim that public sequence resources and the regeneration literature can actually address. Cancer resistance and absence of aging are not in a systematic open cohort, and published carcinogenesis and sexual-strain aging studies already show that the absolute wording needs a narrower reading. The generalization is checkable in pieces, not as a single analysis." ;
    rdfs:comment "Proposed test with existing data: From public assemblies, measure heterozygosity, repeats, and ploidy variation in asexual Schmidtea, and compile regeneration success, tumor incidence under defined challenges, and survival curves. High genomic disorder together with high regeneration, low tumor incidence, and no actuarial aging would support the generalization; a stable diploid genome, poor regeneration, or a clear aging curve in the asexual strain would refute the corresponding clause." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Lifespan and tumor-incidence numbers are not in the genome databases and are sparse for asexual strains.", "Sexual Schmidtea aging data do not directly cover the asexual animals named in the claim.", "Champions of regeneration is a comparative ranking without a single coded trait matrix." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2025-wisdom-01 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--grok--operationalizability> .
