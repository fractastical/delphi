  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of levin-2018-hcn2-07 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/data-adequacy" ;
