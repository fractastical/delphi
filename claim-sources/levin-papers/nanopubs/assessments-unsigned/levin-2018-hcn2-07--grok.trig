sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-07: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.648"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.67"^^xsd:double ;
    dct:description "The prediction is a defined simulation contrast, and BETSE can run it once nicotine's Hill parameters are copied from the supplement. Those pharmacological constants are less completely fixed in the main text than the HCN2 switch itself, so a mismatch is ambiguous between a false prediction and a rebuilt model. The test can still reject a total loss of pattern or a reversal, which is a partial resolution of the stated prediction." ;
    rdfs:comment "Proposed test with existing data: Add uniform HCN2 to the nicotine-exposed neurula model and compare the neural-tube-minus-lateral Vmem contrast with nicotine alone. Maintenance is confirmed if the contrast remains near the control pattern; collapse of the contrast to the nicotine-only pattern would refute the prediction." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Nicotine is implemented as a Hill function on nAChR and a partial HCN block whose constants sit in the supplement.", "A reconstructed configuration can miss the published run even when the qualitative HCN2 switch is real." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-07--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-07 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.84"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-07--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of levin-2018-hcn2-07 by Grok 4.7: 0.7" ;
