  <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-07--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: BETSE" ;
    dct:description "simulator in which the uniform-HCN2 plus nicotine condition can be rerun" ;
    prov:wasDerivedFrom <https://github.com/betsee/betse> .
