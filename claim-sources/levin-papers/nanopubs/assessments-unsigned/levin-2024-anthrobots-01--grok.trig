sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-01--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-anthrobots-01: needs-new-data, resolvability 0.40" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.404"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Single-cell origin, multicellularity and motility are ordinary counts and tracks. The 2024 paper's own data-availability statement keeps the underlying measurements with the authors, and the public videos are illustrations rather than the cohort. Checking the result means a new run of the protocol or release of the withheld logs, not analysis of an existing open file." ;
    rdfs:comment "Proposed test with existing data: Start from single dissociated adult normal human bronchial epithelial cells, culture them in matrix for two weeks, move the products to low-viscosity medium, and score multicellularity and motility without added genes, scaffolds or sculpting. Clonal spheroids that translocate would support the protocol result; aggregates that require many seed cells, or that remain immotile, would refute the single-cell self-construction claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The paper states that the supporting data are available from the authors on request, not in a public archive.", "Supplementary videos illustrate motility; they do not show that each spheroid began as one cell.", "Donor and batch replication counts are not in an open table." .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-anthrobots-01 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-01--grok--operationalizability> .
