sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2020-xenobots-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-03--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-03--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2020-xenobots-03: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.584"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "A causal contribution of morphology is measurable, but the paper's chance-versus-design interpretation is broader than its orientation control. Existing results test the interpretation only partially because morphology covaries with several biological factors." ;
    rdfs:comment "Proposed test with existing data: Compare behavior of the intended morphology against inverted, shape-matched, randomized, and actuation-matched controls; a design-specific advantage after controlling tissue composition would support a morphology-mediated transfer." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Orientation is not a complete control for tissue placement or actuation.", "Existing experiments cannot exclude all non-shape explanations." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2020-xenobots-03--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2020-xenobots-03--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2020-xenobots-03 by GPT-5.6 Sol: 0.72" ;
