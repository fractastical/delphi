    prov:wasDerivedFrom <https://doi.org/10.1038/s41467-018-03334-5> .
  <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-3> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Channelpedia" ;
    dct:description "public Kir and leak channel parameters of the sort BETSE uses for conductance models" ;
    prov:wasDerivedFrom <https://channelpedia.epfl.ch/> .
