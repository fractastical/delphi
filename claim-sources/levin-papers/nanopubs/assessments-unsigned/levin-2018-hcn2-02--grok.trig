  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of levin-2018-hcn2-02 by Grok 4.7: 0.55" ;
