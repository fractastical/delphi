sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-02: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.657"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "BETSE and neurula geometries are public, and the paper tabulates starting concentrations and the leak-and-Kir mechanism, so the voltage pattern can be recomputed. The exact 2018 configuration is not a file in the repository, and the match to real embryos rests on the paper's images. The simulation half is therefore testable with reconstruction, short of a turnkey reproduction of the published run." ;
    rdfs:comment "Proposed test with existing data: Rebuild the stage-15 anterior neurula in BETSE with the published ion concentrations, regional potassium and chloride leak, and Kir conductance, and test whether neural-tube Vmem is near −50 mV while folds and ectoderm stay near −5 mV. Closing Kir, or equalizing the leaks, should remove that contrast if the stated mechanism is required." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The spatial leak map is described with a figure and supplement rather than a deposited configuration file.", "Agreement with embryonic voltages uses the paper's own images, which are not an independent recording archive." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-02 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.84"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-02--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of levin-2018-hcn2-02 by Grok 4.7: 0.68" ;
