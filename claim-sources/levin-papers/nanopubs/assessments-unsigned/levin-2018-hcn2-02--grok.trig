  <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: BETSE" ;
    dct:description "public bioelectric tissue simulator, including neurula geometry masks; the 2018 Nature Communications YAML is not in the repository" ;
    prov:wasDerivedFrom <https://github.com/betsee/betse> .
  <https://w3id.org/delphi/resource/evidence/levin-2018-hcn2-02--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: HCN2 voltage pre-patterns" ;
