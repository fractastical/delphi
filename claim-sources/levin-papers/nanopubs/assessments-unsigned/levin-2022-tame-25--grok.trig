sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-25> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-tame-25: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.543"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Public genomes can show that many bioelectric gene families occur in animals without neurons and in close unicellular relatives, which bears on which hardware came first. The claim also says evolution used analog bioelectric dynamics to position body configuration before neural spiking. That use is not a column in the genome matrices, so gene age is only a partial test." ;
    rdfs:comment "Proposed test with existing data: Map ion-channel, connexin, and innexin families onto aneural animals and their unicellular relatives versus the origin of neurons; precedence of the genes holds if the families are present before nervous systems, which still leaves their developmental use untested." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Gene presence in a sponge or placozoan does not show that the genes were used to place the body in morphospace.", "Channels have many functions besides positional control, so their age is compatible with other histories." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-tame-25--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-25--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-tame-25 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-25> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-25--grok--operationalizability> .
