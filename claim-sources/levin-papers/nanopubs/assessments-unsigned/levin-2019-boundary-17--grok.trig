sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-17--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-17: partially-resolvable, resolvability 0.46" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.455"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.57"^^xsd:double ;
    dct:description "Shared measurement under coupling is a measurable change in the scale of a response, and the cognitive label 'larger Self' rides on that change. Public planarian atlases show where gap-junction genes are expressed, which constrains who could be coupled and does not show stimulus sharing. Functional uncoupling experiments are published as scattered physiology, not as one imaging archive. Expression data can test a proxy and leave the binding claim only partly resolved." ;
    rdfs:comment "Proposed test with existing data: Compare the spatial scale of a response to a local stimulus in gap-junction-coupled tissue versus tissue uncoupled pharmacologically or genetically. Expansion of the responding domain while coupled, and its collapse when uncoupled, would support shared sensing; an unchanged domain would refute the physiological half of the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Expression of innexins is not functional dye coupling or shared sensation.", "Common gap-junction blockers are nonspecific.", "A larger responding domain can be called a larger Self or simply a larger coupled network." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-17--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-17 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-17--grok--operationalizability> .
