sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-21--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-anthrobots-21: needs-new-data, resolvability 0.38" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.376"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Local coverage versus adjacent scratch and versus intact tissue is a defined density contrast. The paper reports full recovery under the bridge and lower coverage elsewhere, without depositing the region measurements. Manual thresholding makes the equality claim sensitive to choices that cannot be repeated from the summary alone." ;
    rdfs:comment "Proposed test with existing data: Binarize neuronal coverage under the bridge, in adjacent scratch, in distant scratch and in intact monolayer, and test equality with intact tissue and inequality with the rest of the scratch. Coverage under the bridge statistically matching intact tissue, and only there, would support full local recovery; a deficit under the bridge, or equal filling along the scratch, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Pixel densities after manual thresholding are not in a public table.", "Statistical indistinguishability from 100% recovery depends on sample size and on the threshold.", "The comparison uses the bridges that remained in place for three days." .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-anthrobots-21 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
