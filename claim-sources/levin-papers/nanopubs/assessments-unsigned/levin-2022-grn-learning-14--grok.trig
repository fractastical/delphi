sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-14--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-grn-learning-14: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.799"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.77"^^xsd:double ;
    dct:description "The 50 percent criterion, the six increasing epochs and the 27-model denominator are explicit, and the repository contains the resistance screen plus result matrices. Re-running or reanalysing that screen can confirm or refute both the universal occurrence and the 1–50 percent band. The pharmacoresistance label is the authors' mapping, but the numerical claim is about the ODE assay." ;
    rdfs:comment "Proposed test with existing data: Apply six lengthening UCS stimulations and score a node pair as habituating when the response falls by at least half at each step. At least one such pair in each of the 27 testable models, with pair fractions between 1 and 50 percent, would confirm the claim; any testable model with zero pairs, or fractions outside that range, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Eight of the 35 models were dropped as untestable, so the 'every model' result is conditional on that filter.", "Habituation here is a 50 percent ODE ratio, not a measured drug response." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-14--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-grn-learning-14 by Grok 4.7: 0.92" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.92"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-14--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-14--grok--operationalizability> .
