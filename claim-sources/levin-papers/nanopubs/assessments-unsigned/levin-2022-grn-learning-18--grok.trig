sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-grn-learning-18: resolvable-now, resolvability 0.79" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.788"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "Both breaking assays use an explicit ratio rule and a third-node search, and the code covers sensitization as well as pharmacoresistance. Re-running them yields the 8-of-27 count and the pair-fraction comparison directly. The remark about therapies needing other avenues is an interpretation of that same rate difference." ;
    rdfs:comment "Proposed test with existing data: On each sensitizing model, apply the third-node breaking protocol and record whether the 1.5-fold rise is abolished, and for what fraction of pairs. Breaks confined to 8 of 27 models and mostly under 5 percent of pairs, at a lower rate than habituation breaking, would confirm the claim; breaks in most models or in large pair fractions would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The comparison with habituation uses the same style of search, but the pair denominators differ across models." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-18--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-grn-learning-18 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--grok--operationalizability> .
