sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-16--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-16--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-16: needs-new-data, resolvability 0.31" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.311"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The logical step from a negative DN result to 'not required' is only as strong as the functional block, which is part of the measurement. Neither the morphology counts nor an embryonic current block are in a public dataset. Other HCN family members make a single-construct negative especially hard to interpret after the fact. Resolving the claim means repeating the DN arm with a demonstrated block, which is new data." ;
    rdfs:comment "Proposed test with existing data: Score brain morphology after Hcn2-DN mRNA in otherwise untreated embryos, and require evidence that the construct blocks native embryonic HCN current. Native HCN2 is dispensable if defect rates match controls despite a blocked current; a high defect rate, or a construct that never blocks current, would undermine the conclusion that nicotine cannot be acting by inhibiting endogenous HCN2." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Supplementary Figure 4 is a summary, not a deposited count table.", "A negative phenotype is weak unless the dominant-negative is shown to act in the embryo.", "Xenopus has other HCN genes that a mouse HCN2-DN might miss." .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-16--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-16 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
