  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-18--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2022-grn-learning-18: resolvable-now, resolvability 0.89" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
