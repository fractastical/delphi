    delphi:hasScore "0.894"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.91"^^xsd:double ;
    dct:description "Both sides of the comparison are defined in the same finite model suite with explicit thresholds. Existing models are sufficient to check the stated simulation result." ;
    rdfs:comment "Proposed test with existing data: Search all third-node interventions in sensitizing models and compare the fraction of models and pairs broken with the corresponding habituation results. The reported 8-of-27 and less-than-5% pattern are direct criteria." ;
