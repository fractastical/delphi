sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-place-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-place-01--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-place-01: resolvable-now, resolvability 0.81" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.813"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The claim is about a stated simulation, and the paper points to a public SPM routine that still implements shared-model self-assembly. Re-running it can confirm or refute that outcome. The default target in the current file has drifted from the 2015 head–body–tail illustration, so the eight-cell case needs the published target mask rather than the file's present bitmap." ;
    rdfs:comment "Proposed test with existing data: Run the public active-inference morphogenesis routine from a shared generative model and undifferentiated initial state, and score whether cells migrate and differentiate into the target pattern while ensemble free energy falls. Failure to assemble under that shared model would refute the reported proof of principle." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The current public script defaults to 16 cells and a target mask that is not the paper's eight-cell head–body–tail figure.", "MATLAB is required to run the solver as distributed." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-01--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-place-01 by Grok 4.7: 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.86"^^xsd:double ;
