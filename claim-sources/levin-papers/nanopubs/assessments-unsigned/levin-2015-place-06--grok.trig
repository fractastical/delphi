sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-place-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-place-06--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-place-06: resolvable-now, resolvability 0.81" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.808"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Bisection, duplication, and re-integration are implemented in the same public file that the paper identifies as the reproduction route. Turning on the existing flag and scoring return to the target is a rerun. The flag's default and the updated target mask are the main limits on an exact figure match." ;
    rdfs:comment "Proposed test with existing data: Enable the script's half-split path, which copies the upper or lower half of a partially differentiated ensemble at time step 8 and continues integration. Recovery of the full target by both halves confirms the reported regeneration result; a half that stays truncated or fails to redifferentiate refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The split path is present but switched off in the current file, so the run needs that flag set.", "The default target is no longer the paper's head–body–tail embryo." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-place-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-place-06 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
