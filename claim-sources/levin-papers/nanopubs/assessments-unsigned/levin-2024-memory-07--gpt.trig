  <https://w3id.org/delphi/resource/assessment/levin-2024-memory-07--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2024-memory-07: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.655"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "The anatomical readout and contrasting outcomes are direct. Published measurements can probably check the reported cases, but data adequacy is limited by separate protocols and uncertain access to raw images and counts." ;
    rdfs:comment "Proposed test with existing data: Compare appendage identity and regeneration frequency after matched systemic monensin treatment at tadpole tail wounds and froglet leg wounds. Tails only at tail sites and legs only at limb sites support context dependence; swapped or context-independent structures refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Raw individual-level regeneration data may not be deposited.", "Developmental stage, dose and wound type differ between experiments." .
