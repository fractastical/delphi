  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-29> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-29--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-29--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2019-boundary-29: partially-resolvable, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.702"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Many relevant public transcriptomes and annotation resources exist, making a cross-kingdom meta-analysis feasible. Coverage of damaged biofilms and matched regenerative stages is uneven, and transcript abundance alone only partially tests the proposed conserved functional role." ;
    rdfs:comment "Proposed test with existing data: Compile regeneration time-course transcriptomes from damaged bacterial biofilms, plants, and animals, harmonize orthologous electrogenic genes, and test for consistent differential use beyond generic injury and stress responses." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Regeneration protocols and sampled stages differ across kingdoms.", "Ion-channel expression may reflect generic stress rather than cooperative morphogenesis." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-29--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-29--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-29--gpt--dataset-3> .
