sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-place-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-place-03--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-place-03: not-empirically-resolvable, resolvability 0.17" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.167"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The necessity claim uses an implicit model of place as the requirement for morphogenetic self-organization. Because the paper treats any adequate regulator as a model of what it regulates, a gene-regulatory or chemotactic account of the same successful patterning is counted as the model rather than as a rival. No public observation separates the two descriptions." ;
    rdfs:comment "Proposed test with existing data: A decisive test would need a fixed definition of an implicit place-model, then a morphogenetic system that reaches its target anatomy with no internal state that meets that definition. Under the paper's good-regulator reading, successful patterning itself counts as possessing the model." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Several formalizations of an implicit model count ordinary intracellular states as the model.", "The necessity claim then holds for every system that already achieves a target form." .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-place-03 by Grok 4.7: 0.3" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.3"^^xsd:double ;
