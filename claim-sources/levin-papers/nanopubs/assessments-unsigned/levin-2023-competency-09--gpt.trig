sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-competency-09: resolvable-now, resolvability 0.87" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.867"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    dct:description "The claimed Baldwin effect is an explicit pattern among model variables and is reproducible from published methods. This resolves the in-silico statement, not whether real developmental competency has such costs." ;
    rdfs:comment "Proposed test with existing data: Run the model across the stated competency penalties and track structural-gene fitness, competency, and phenotypic fitness over time. Genetic assimilation is supported when structural fitness rises as competency declines while phenotype remains high." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "The conclusion depends strongly on the chosen cost function.", "Actual biological competency costs are not represented by existing data." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-competency-09--gpt--dataset-1> .
