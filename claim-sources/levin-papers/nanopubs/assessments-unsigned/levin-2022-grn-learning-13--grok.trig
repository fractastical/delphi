sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-13--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-grn-learning-13: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.576"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Organism metadata and memory counts are both recoverable, so the distribution inside this list can be rechecked. The list is not a sample of life, and 'roughly uniformly' plus the suggestion about all strata of life outruns what 35 published models can show. The test covers a thin proxy for the stated scope." ;
    rdfs:comment "Proposed test with existing data: Label each of the 35 models by the source taxon class recorded in BioModels and test whether memory prevalence is homogeneous across bacteria, slime mould, yeast, plants, vertebrates and mammals. A clearly uneven distribution would refute uniformity inside this set; a flat distribution would support only that limited census." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Class sizes in a 35-model curated list are too small for a uniformity test to be stable.", "Uniformity among published models does not measure proto-cognitive capacity across living taxa." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-grn-learning-13 by Grok 4.7: 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.65"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-13--grok--operationalizability> .
