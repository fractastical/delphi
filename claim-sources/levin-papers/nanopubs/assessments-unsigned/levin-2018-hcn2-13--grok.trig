sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-13--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-13: needs-new-data, resolvability 0.37" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.374"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Shape distance after size correction is a standard morphometric test and would cleanly separate a real shape shift from a size shift. The coordinates required for that test were not released. Example images cannot be re-landmarked into the reported statistic. The claim waits on the original landmark file or a new tadpole series." ;
    rdfs:comment "Proposed test with existing data: Run geometric morphometrics on stage-45 brain landmarks normalized to the head for control, nicotine, and nicotine plus Hcn2-WT. Nicotine should separate from controls in shape space, and the HCN2 arm should not; a residual shape difference after HCN2 would refute restoration." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Landmark coordinates and Procrustes scores are not deposited.", "Head-size allometry can mimic a brain-shape effect.", "Photographs in the paper are examples, not the full sample." .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-13 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
