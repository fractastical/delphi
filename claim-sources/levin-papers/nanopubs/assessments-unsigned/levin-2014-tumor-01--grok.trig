sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2014-tumor-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-01--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2014-tumor-01: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.511"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Remote hyperpolarization versus tumor incidence is a concrete contrast, and the paper publishes the summary rates for more than one oncogene. Those summaries can be checked for direction and reported significance. They cannot be recomputed from raw embryos, and they cover one amphibian assay rather than tumorigenesis in general, so the broad claim is only partly resolvable." ;
    rdfs:comment "Proposed test with existing data: Score tumor-like-structure incidence when oncogene mRNA and a hyperpolarizing reagent are placed in separate blastomeres, with voltage confirmed at the remote site. A lower incidence only when the remote site is hyperpolarized would support a long-range voltage requirement; no change, or a requirement for local voltage only, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Embryo-level voltage and tumor scores are not in a public file.", "Blastomere separation is a fate-map proxy for distance, and mRNA injections carry nonspecific effects." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2014-tumor-01--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2014-tumor-01 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2014-tumor-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2014-tumor-01--grok--operationalizability> .
