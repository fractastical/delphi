sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-17--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-goals-17: needs-new-data, resolvability 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.356"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Whether a new injury preceded each late regenerative event is decidable from longitudinal notes, and those notes are not public. The aggregate result mixes fission with other morphology changes, so the existing summary does not separate regeneration-without-injury from regeneration-after-a-late-wound. A general claim about the missing-tissue response needs cohorts beyond this experiment." ;
    rdfs:comment "Proposed test with existing data: Classify each late planarian morphology change by whether a new wound, fission, or bite occurred in the preceding interval. Events with no wound would support initiation without a missing-tissue response; restriction of late heads to post-fission wounds would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The paper's own repatterning classes include fission, which opens a wound, and those classes are not deposited animal by animal.", "A possibility claim that a missing-tissue response may be unnecessary is weakly refutable." .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-goals-17 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
