sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-09--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-goals-09: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.603"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Paracrine versus autocrine use is operationalized as a comparison of two transfer entropies, which is a standard calculation on simulation logs. Those logs and a complete analysis configuration are not in the public snapshot, so the comparison requires regenerating tissues first. The test is well posed and only partly feasible with what was released." ;
    rdfs:comment "Proposed test with existing data: On the original unperturbed runs, compute transfer entropy from each cell's stress to its own next state and to its neighbours' states. A substantially larger neighbour term would support paracrine dominance; a larger self term would support autocrine dominance and refute the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Transfer entropy depends on binning, history length and which evolved tissue is logged.", "The analysis script expects a general parameter file that is not in the repository, and the trajectories are not archived." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-goals-09--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-goals-09 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
