sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-14--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-goals-14: needs-new-data, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.488"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The dose, fragment type, follow-up, and phenotype classes are explicit, so a recount would decide the percentages. Those worm-by-worm scores are not in a public table, and the figshare supplement is a supplementary document rather than the scoring sheet. Without that sheet or an independent cohort, the published summary cannot be checked." ;
    rdfs:comment "Proposed test with existing data: Score each Dugesia japonica pre-tail fragment treated with 18 μM U0126 for three days, kept individually until death, for any morphology change after four weeks, and among those for return to one head. A recount near 22% of about 181 animals, mostly between four and ten weeks, with about 61% of the changers restoring one head, would confirm the report; a recount far from those fractions, or an independent cohort at the same dose with almost no late change, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Animal-level weekly scores are not deposited; the public record is the summary and figure 10.", "The scoring rubric counts fission and dorsal or lateral outgrowths as repatterning, and fission creates a new wound.", "Headless animals cannot feed, so late change is confounded with prolonged starvation." .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-goals-14 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
