sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-06--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-grn-learning-06: partially-resolvable, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.743"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Topology is in the SBML files and memory scores can be recomputed, so the correlation test is straightforward. A failure to find a significant correlation in this small curated set does not show that no network property indicates memory. The test is informative only inside the original sample and statistic." ;
    rdfs:comment "Proposed test with existing data: For each of the 35 models, pair a memory-count with mean node number, edge number, degree and hubness, and test rank correlations. Significant associations would refute the null result; consistently non-significant correlations would reproduce it, without showing that no structural feature matters." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Thirty-five models give low power, so a non-significant correlation is a weak null.", "Hubness and degree definitions, and multiple testing across memory types, are easy to vary." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-grn-learning-06 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
