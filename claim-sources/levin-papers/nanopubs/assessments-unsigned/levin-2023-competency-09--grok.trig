  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of levin-2023-competency-09 by Grok 4.7: 0.58" ;
