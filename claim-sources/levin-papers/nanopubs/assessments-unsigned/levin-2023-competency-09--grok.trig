sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-competency-09: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.662"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The penalty rule and the factor range are stated, and the underlying simulator is public, so the Baldwin runs can be reimplemented as an extension rather than a new kind of model. They are not a packaged experiment in the repository, and some controls sit in the supplement. The in silico claim is testable with that extra assembly; it does not measure real competency costs." ;
    rdfs:comment "Proposed test with existing data: Subtract a penalty proportional to competency, over factors from 1e-7 to 0.5, from fitness in the public evolvable-competency loop, and track structural-gene fitness and the competency allele. Continued structural improvement, declining competency and later genetic assimilation would confirm the simulated Baldwin effect; competency staying high, or structural fitness stalling, would refute it at that cost." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The public scripts and hyperparameter file do not expose the fitness-penalty experiment as a turnkey run.", "Real organismal costs are unmeasured, so the simulation does not say which penalty factor is biological." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-competency-09--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-competency-09 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.84"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-09--grok--data-existence> a delphi:LLMClaimAssessment ;
