sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-17--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-grn-learning-17: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.673"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.69"^^xsd:double ;
    dct:description "The 1.5-fold rule and both arms of the comparison can be rerun from public code and BioModels. The biological count is a direct check. The inference that sensitization is unique to biology, or requires more complex random models, is not identified by this null, so the claim is only partly resolved by the rerun." ;
    rdfs:comment "Proposed test with existing data: Score a pair as sensitizing when the response rises at least 1.5-fold across six lengthening stimulations, and compare the fraction of biological models that have any such pair with the per-model pair rate in the random circuits. Twenty-seven of 35 biological models, against under 10 percent of random pairings, would reproduce the counts; a high random rate would refute uniqueness." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The random null uses a different ODE family, so rarity there does not show the behaviour is unique to biology.", "The paper itself allows that more complex random models might show sensitization." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-17--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-grn-learning-17 by Grok 4.7: 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.82"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
