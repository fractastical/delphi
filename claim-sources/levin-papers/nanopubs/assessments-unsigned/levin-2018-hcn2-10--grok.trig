sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-10--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2018-hcn2-10: needs-new-data, resolvability 0.36" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.363"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "Incidence, sample size, and a two-group contrast are fully specified. The only public record is the summary in the paper, and using that summary to confirm itself is circular. No phenotype repository contains these unperturbed-versus-HCN2 counts. A new scored cohort, or release of the original calls, is what would resolve the percentages." ;
    rdfs:comment "Proposed test with existing data: At stage 45, count minor departures from ideal brain morphology in uninjected controls versus uniform Hcn2-WT mRNA injection, with the paper's strict criteria. A drop from about 9% to about 1.5% would confirm the improvement; equal or higher incidence in the injected group would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Embryo-level morphology calls are not deposited.", "The strict ideal-brain criterion is laboratory-specific and easy to shift.", "Clutch and injection effects can change a small baseline rate." .
  <https://w3id.org/delphi/resource/assessment/levin-2018-hcn2-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2018-hcn2-10 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
