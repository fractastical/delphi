sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-02--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-anthrobots-02: needs-new-data, resolvability 0.33" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.33"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Open Xenobot tracks document novel behavior in frog embryonic cells, which is the baseline this statement says the phenomenon exceeds. The adult human half, and any broader sample of wild-type cell types, is not in a public dataset. A decisive test of the generalization still requires new cell-type runs or release of the Anthrobot cohort." ;
    rdfs:comment "Proposed test with existing data: Apply the same no-edit self-assembly assay to adult somatic human cells and to additional wild-type cell types beyond frog embryonic ectoderm, and score whether a novel motile anatomy appears. One repeated adult-human success would support the narrower contrast with amphibian embryos; failure across further wild-type types would refute the claim that the plasticity is a general feature of wild-type cells." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Adult human assembly measurements are author-on-request, so the new half of the contrast is not open.", "Two epithelial systems cannot separate a general wild-type capacity from a property of ciliated epithelia.", "What counts as a novel functional anatomy has to be fixed before the universal wording is testable." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2024-anthrobots-02--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-anthrobots-02 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-02--grok--operationalizability> .
