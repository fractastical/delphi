sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-04--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-04: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.474"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.57"^^xsd:double ;
    dct:description "Uniform versus speckled is a direct contrast with independent cell choice, and the claim names the two systems in which it was reported. Those counts exist as published summaries, not as a reanalyzable file, so a binomial test cannot be rerun from raw calls. Xenbase organizes the Xenopus literature and does not replace the missing tables. The pattern can be examined for the published cases and remains confounded with a common upstream bias." ;
    rdfs:comment "Proposed test with existing data: When left-right identity or melanocyte conversion is randomized, score each embryo as domain-uniform or speckled. Group decision is confirmed if coherent domains predominate over the binomial expectation for independent cells; a speckled mixture at the independent-cell rate would refute coordination." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Embryo-by-embryo L/R and pigment scores are not in an open table.", "A shared upstream signal can produce uniform domains without a group decision.", "The melanocyte result and the laterality result are different assays." .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-04 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
