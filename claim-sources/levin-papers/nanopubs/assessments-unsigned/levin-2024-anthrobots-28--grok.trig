sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-28> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-28--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-28--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-anthrobots-28: needs-new-data, resolvability 0.32" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.324"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Formation and motility under the stated protocol are measurable for each named cell type. Public atlases show that oviduct and ependymal cells exist and express cilia genes; they do not contain the culture experiment. The prediction remains a new-experiment claim." ;
    rdfs:comment "Proposed test with existing data: Run the Anthrobot matrix-to-liquid protocol on adult human oviductal epithelium and on ependymal cells, and score external cilia and motility, and run it on a non-ciliated epithelial type scoring multicellular assembly without motility. Motile ciliated spheroids from the first two sources, and immotile spheroids from the third, would support the prediction; failure to form under the same protocol would refute it for those types." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public oviduct or ependymal run of the Anthrobot protocol exists.", "Cilia-gene expression does not show that those cells will reverse polarity and swim.", "Non-ciliated bots are an open-ended class rather than one tested type." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2024-anthrobots-28--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-28--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-anthrobots-28 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-28--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
