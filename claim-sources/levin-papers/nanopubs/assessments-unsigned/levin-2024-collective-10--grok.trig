sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-collective-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-collective-10: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.506"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "Donor versus host Hox expression after single-cell versus group grafts is a defined contrast, and the mouse transposition paper publishes it with lineage labels. Related chick and zebrafish grafts are separate papers, not a combined open count matrix. The expression difference can be re-examined from those figures for a few vertebrates, while the memory and perceptual-field gloss is not an additional variable in the data." ;
    rdfs:comment "Proposed test with existing data: Compare Hox or reporter expression of single neural-crest or rhombomere cells grafted to a new axial level with expression of coherent groups grafted to the same level. Groups keeping donor expression while isolated cells matching the host would support the contrast; both classes changing, or both keeping donor identity, would refute it. A longer 'perceptual field' is not a further measurement beyond that retention." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Graft size, dispersion and cell survival are entangled in the classic experiments.", "Counts are in figures from mouse, chick and zebrafish papers, not one deposited cell table.", "Maintained gene expression does not measure memory duration or a perceptual field extending into the past." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2024-collective-10--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-collective-10 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2024-collective-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-collective-10--grok--operationalizability> .
