sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-12--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-12--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2022-tame-12: partially-resolvable, resolvability 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.619"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "Organ motion and final anatomy are measurable from image sequences. Existing reports can test normalization, but stronger trajectory controls are needed to discriminate goal-directed regulation from mechanical developmental alternatives." ;
    rdfs:comment "Proposed test with existing data: Register longitudinal images of scrambled and control tadpoles, quantify organ trajectories and final facial geometry, and test convergence to species-normal positions against passive growth and fixed-trajectory models." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Complete longitudinal image series may be unavailable.", "Convergence does not uniquely establish goal-directedness.", "Surgery and metamorphic growth create correlated mechanical effects." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-tame-12--gpt--dataset-1> .
