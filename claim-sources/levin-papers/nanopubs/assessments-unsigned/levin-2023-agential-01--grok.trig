sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-01--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-agential-01: partially-resolvable, resolvability 0.37" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.37"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Inversion difficulty can be measured on public developmental models, which is analysis of a proxy. Those models do not establish that real morphogenesis is unsolvable or that this, rather than transmission to the germline, is what limits Lamarckian inheritance across metazoans. The claim's full scope is not in any dataset." ;
    rdfs:comment "Proposed test with existing data: For published developmental models with an explicit genotype-to-anatomy map, attempt to recover parameter or genotype changes that produce a specified large-scale anatomical change, and compare success with and without a known route for somatic information to reach the germline. Systematic failure of inversion in well-specified models would support computational irreversibility as a barrier; reliable inversion, or empirical cases where a known edit produces a chosen organ-scale trait, would count against unsolvability as the limit on Lamarckian inheritance." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Unsolvability in general depends on the model class and is not read out of metazoan datasets.", "Existing models cover a negligible fraction of real genotype-to-anatomy maps." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-agential-01--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-agential-01 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.45"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-agential-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-01--grok--operationalizability> .
