  <https://w3id.org/delphi/resource/evidence/levin-2023-agential-01--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: BioModels" ;
    dct:description "public dynamical models of development whose invertibility can be probed as a restricted proxy" ;
    prov:wasDerivedFrom <https://www.ebi.ac.uk/biomodels/> .
  <https://w3id.org/delphi/resource/evidence/levin-2023-agential-01--grok--dataset-2> a delphi:EvidenceItem ;
