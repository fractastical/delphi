sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2025-wisdom-19: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.673"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "GSE245782 is an open test of the transcriptome clause: large versus small groups, treated and untreated, at two stages, can be reanalyzed with ordinary differential-expression methods. The claim also says large groups resist teratogens far better than individuals or small groups, and that morphological outcome is not in the sequence archive. Expression can be resolved now; the resistance half cannot." ;
    rdfs:comment "Proposed test with existing data: Reanalyze RNA-seq from large versus small Xenopus cohorts, with and without teratogen, and test for a cohort-size-specific expression signature. Separately, morphological protection would be scored as the rate of teratogen-induced defects in large versus small groups. A distinct large-group transcriptome and a lower defect rate would support the claim; no expression difference and no survival advantage would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The deposit is one species and one teratogen, thioridazine.", "Defect and survival rates are not in the expression matrix.", "A modest gene list may be a group-size effect without establishing a hyperembryo that resists teratogens far better." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-19--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2025-wisdom-19 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--grok--operationalizability> .
