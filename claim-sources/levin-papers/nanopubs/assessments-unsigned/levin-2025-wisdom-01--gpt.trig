sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-01--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2025-wisdom-01: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.66"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Public sequence data and extensive regeneration evidence resolve major descriptive components. Cancer resistance, absence of ageing and the claimed contradiction of a genome-driven paradigm have weaker or nonstandardized coverage, limiting a full test." ;
    rdfs:comment "Proposed test with existing data: Quantify planarian somatic ploidy and genomic heterogeneity, regeneration success, neoplasm incidence and age-related functional decline, and compare them with preregistered taxa and genome-instability predictions. The descriptive conjunction is supported if high instability coexists with exceptional repair and low senescence and cancer." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Apparently do not age is stronger than available lifespan evidence.", "Cancer incidence in wild and laboratory planaria is poorly sampled.", "The paradigm prediction is not quantitatively specified." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-01--gpt--dataset-3> .
