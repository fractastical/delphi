sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-19> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-19--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2025-wisdom-19: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.658"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Protection and transcriptomic difference are clear measurable outcomes and may be represented in public sequencing repositories. Existing studies can test the reported Xenopus phenomenon, but environmental confounds and the collective-entity interpretation limit discrimination." ;
    rdfs:comment "Proposed test with existing data: Compare malformation and survival under identical teratogen doses across isolated embryos, small groups and large groups, and test for a group-specific transcriptomic state. A size-dependent protection effect plus reproducible differential expression supports the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Group density changes chemistry and dose exposure as well as communication.", "Hyperembryo is an interpretation, not a separate measured entity.", "Raw group-level phenotype data may not be deposited." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-19--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-19--gpt--dataset-2> .
