sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-16--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-16--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2015-girardia-16: partially-resolvable, resolvability 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.55"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Existing remodeling observations operationalize return to a set point in one perturbation. They do not uniquely identify error sensing or a homeostatic controller, so the stronger conceptual interpretation remains only partially testable." ;
    rdfs:comment "Proposed test with existing data: Quantify whether intact post-regeneration worms detect deviations and move morphology toward a stable species-specific set point without injury, including trajectories and stopping behavior. Compare feedback/set-point models against passive growth and turnover models." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Return toward normal shape does not uniquely demonstrate assessment of a target.", "Passive differential growth and tissue turnover are plausible rivals.", "Complete longitudinal data are not clearly deposited." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-16--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-16--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-girardia-16 by GPT-5.6 Sol: 0.65" ;
