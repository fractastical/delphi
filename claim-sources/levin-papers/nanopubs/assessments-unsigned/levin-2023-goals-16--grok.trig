sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-16--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-16--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-goals-16: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.493"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "The excursion away from the target and the contents of the fitness function can be checked by running and reading the public model, which is analysis. The repository does not contain the published long runs, and the step from this fitness function to unselected capabilities of multi-scale homeostatic systems generally is outside what one simulation decides. Endpoint versus cumulative fitness is a real ambiguity in the test." ;
    rdfs:comment "Proposed test with existing data: In runs of the evolved tissue, measure distance to the French-flag target over time and read the fitness function in the code. A transient increase in distance while misplaced cells are removed, followed by return, in a model whose fitness does not reward that excursion or long-term maintenance, would support the simulation result; monotonic approach, or a fitness term that penalizes intermediate error, would refute the unselected-excursion reading." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Whether intermediate error is invisible to selection depends on whether fitness is an endpoint score or a time integral, which has to be read out of the model class rather than a deposited results table.", "The committed script is a short demonstration configuration, so it is not a replay of the published 1000-step runs." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-goals-16--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-16--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-goals-16 by Grok 4.7: 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.68"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-goals-16--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-16--grok--operationalizability> .
