sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-07--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-07--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-competency-07: resolvable-now, resolvability 0.87" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.869"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.89"^^xsd:double ;
    dct:description "The rise and plateau are direct simulation outputs, and the drift explanation can be tested with replicated trajectories and altered tie-breaking. Public methods are adequate for reimplementation." ;
    rdfs:comment "Proposed test with existing data: Evolve the competency gene from 1-15 for 1000 generations over many seeds and measure trajectories, stable values, and the minimum competency needed for maximal fitness. Test whether neutral drift among equally fit high values explains the plateau." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "A single trajectory cannot establish a typical plateau.", "Tie-breaking and mutation rules can shift neutral-drift outcomes." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-competency-07--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-07--gpt--operationalizability> a delphi:LLMClaimAssessment ;
