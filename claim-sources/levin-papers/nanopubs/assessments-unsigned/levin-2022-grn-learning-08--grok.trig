sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-08--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-grn-learning-08: resolvable-now, resolvability 0.79" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.786"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "The methods fix the ODE system and apply stimuli by clamping a variable, then score persistence after release. Public code and the original models make that contrast re-runnable. If the stored response survives with the same equations, the claim about these pathway models is confirmed or refuted directly." ;
    rdfs:comment "Proposed test with existing data: Rerun associative and other memory assays while logging whether rate parameters and the reaction graph stay fixed, and test whether the response remains altered after the clamp is released. Persistent change with an unchanged model file would confirm dynamical memory; memory that appears only after an edit to parameters or edges would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A temporary clamp is an external drive, which a rival description can treat as a transient parameter change." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-grn-learning-08--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-grn-learning-08 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-grn-learning-08--grok--operationalizability> .
