sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-20: partially-resolvable, resolvability 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.416"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.52"^^xsd:double ;
    dct:description "The non-cognitive core is a Goldilocks effect of information sharing on modularity, which a gap-junction sweep in BETSE can exhibit or fail to exhibit. That is an analysis on public code, limited to the model. Calling the successful window a Self does not add a separate measurement, and tissue dose-response data are not assembled. The model can partially test the balance and cannot establish it for organisms." ;
    rdfs:comment "Proposed test with existing data: Sweep a coupling or synaptic-gating parameter from isolation to full sharing and measure modularity of the resulting patterns or activity. An intermediate window with differentiated modules, flanked by fragmentation and by a homogeneous soup, would support the balance; monotone improvement with more sharing would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "What counts as a new Self is still a labeling choice.", "The location of the intermediate window depends on how sharing is parameterized.", "Empirical dose-response of coupling versus anatomical modules is not one dataset." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2019-boundary-20--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-20 by Grok 4.7: 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.52"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-20> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-20--grok--operationalizability> .
