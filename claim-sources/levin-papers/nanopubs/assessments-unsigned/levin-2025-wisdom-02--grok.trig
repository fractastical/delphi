sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-02--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2025-wisdom-02: needs-new-data, resolvability 0.33" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.33"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The therapeutic prediction can be stated as a comparison of outcomes, so it is testable in principle. Existing papers report individual bioelectric or training interventions, but they are not a dataset that contrasts those approaches with biochemical micromanagement across indications. Settling the general claim requires that comparative evidence, which is not publicly available." ;
    rdfs:comment "Proposed test with existing data: Match interventions that set a tissue-level target, using stimuli, training, or physiological setpoints, against interventions that manipulate the same outcome by editing individual molecular parts, and compare effect size, durability, and off-target cost. A consistent advantage for the first class would support the therapeutic claim; no advantage would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public trial or experimental archive is structured as behavior-level versus molecular micromanagement.", "Collective intelligence in anatomical space is not a covariate in clinical outcome datasets.", "Published case studies use incommensurable endpoints and are mostly preclinical." .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2025-wisdom-02 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
