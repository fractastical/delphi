sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-21--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2022-tame-21: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.59"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Voltage-gated channel and connexin kinetics are public, and published ODE models can be re-run to see whether a transient voltage leaves a stable state. That tests the biophysical implication in models. It does not cover non-neural tissues generally, and tissue experiments that would separate dynamical memory from a changed proteome are not in one open dataset." ;
    rdfs:comment "Proposed test with existing data: Simulate a transient voltage pulse with published channel and connexin gating and test for two stable voltages or coupling states; dynamical memory holds if the post-pulse state remains after the pulse and changes later input-output behavior with the same hardware." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Most kinetic parameters come from neurons or heterologous cells, not the non-neural tissues in the claim.", "A persistent voltage in real tissue can be transcriptional or ultrastructural rather than a dynamical-system memory of the same channels." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2022-tame-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2022-tame-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2022-tame-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2022-tame-21 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2022-tame-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2022-tame-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2022-tame-21--grok--operationalizability> .
