sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-agential-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-agential-14--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-14--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-agential-14: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.597"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "The intervention, inherited phenotype, and predicted feeding effect are direct and discriminating. The limiting factor is public availability and resolution of historical experimental records rather than conceptual testability." ;
    rdfs:comment "Proposed test with existing data: Trace surgically rotated cortical landmarks, ciliary orientation, feeding flow, and genotype through clonal generations without further intervention. Persistent rotated organization and reversed local flow despite wild-type sequence support non-DNA cortical inheritance." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Classic experiments may lack accessible raw films or lineage-level data.", "Sequence confirmation may be absent.", "Cytoplasmic inheritance mechanisms other than cortical geometry remain possible." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-agential-14--gpt--dataset-1> .
