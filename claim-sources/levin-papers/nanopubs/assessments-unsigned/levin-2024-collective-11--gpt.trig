  <https://w3id.org/delphi/resource/assessment/levin-2024-collective-11--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2024-collective-11: partially-resolvable, resolvability 0.75" ;
