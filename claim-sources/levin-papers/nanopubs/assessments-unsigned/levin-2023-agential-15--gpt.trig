  <https://w3id.org/delphi/resource/assessment/levin-2023-agential-15--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-agential-15: partially-resolvable, resolvability 0.72" ;
