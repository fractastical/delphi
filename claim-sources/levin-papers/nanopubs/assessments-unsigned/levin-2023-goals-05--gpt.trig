sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-goals-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-goals-05--gpt> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-goals-05--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2023-goals-05: resolvable-now, resolvability 0.92" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.917"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.92"^^xsd:double ;
    dct:description "The absence of direct long-horizon selection and subsequent stability are inspectable in public code and reruns. The result is resolvable for this model, although 'need not be selected for' means no explicit rather than no indirect selection." ;
    rdfs:comment "Proposed test with existing data: Verify that fitness was evaluated only through 100 steps, then run independently evolved tissues to 1000 steps and track pattern accuracy and survival. Compare with controllers explicitly selected for longevity to assess whether long-term maintenance emerges without direct selection." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Selection for 100-step performance may indirectly favor stable dynamics.", "One long-lived controller does not establish a general property." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-goals-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2023-goals-05--gpt--dataset-2> .
