sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-07--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-competency-07: resolvable-now, resolvability 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.754"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The evolvable-competency script is public and the decision variable is the competency allele itself. Re-running it tests the rapid rise and high plateau. Exact meander values will differ across seeds, but the claimed plateau near 470 versus the fitness threshold is a stable summary a small team can estimate." ;
    rdfs:comment "Proposed test with existing data: Evolve the competency allele from a low initial range over 1000 generations and record the best individual's competency. A rapid rise that plateaus near 470, above the competency needed for maximum fitness, would confirm the trajectory; a low plateau or continued directional climb would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Attributing the excess over the fitness-maximizing value to drift requires showing a fitness plateau, not just a high mean.", "Stochastic runs will not reproduce the exact path up to 485." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2023-competency-07--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-competency-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-competency-07 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2023-competency-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2023-competency-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-competency-07--grok--operationalizability> .
