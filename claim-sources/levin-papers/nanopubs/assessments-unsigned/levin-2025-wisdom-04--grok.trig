sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-04--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2025-wisdom-04: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.783"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The claim is a simulation result about a defined class of models, and the training rules are specified well enough to reimplement. A public repository already runs habituation, sensitization, and associative conditioning on continuous biological networks without rewiring, and deposited pathway models supply further substrates. A small team can rerun those protocols in weeks, which is enough to confirm or refute the claim as a result about these models." ;
    rdfs:comment "Proposed test with existing data: Apply habituation, sensitization, and Pavlovian pairing protocols to published gene-regulatory and pathway models while freezing topology and edge weights, and test the trained response against unpaired and random-network controls. The three learning signatures without parameter change would confirm the claim; failure to obtain them under the published protocols would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The original Boolean implementation was not released, so the rerun uses the published protocol and the later public ODE code.", "Learning labels depend on stimulus timing and on which nodes are treated as cue and response." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2025-wisdom-04 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2025-wisdom-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-04--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/levin-2025-wisdom-04--grok--data-existence> a delphi:LLMClaimAssessment ;
