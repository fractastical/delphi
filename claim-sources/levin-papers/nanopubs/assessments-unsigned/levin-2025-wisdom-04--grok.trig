  <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-04--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: GRN_ODE" ;
    dct:description "public MATLAB implementation of continuous gene-regulatory and pathway models trained for habituation, sensitization, and associative conditioning" ;
    prov:wasDerivedFrom <https://github.com/wesleypclawson/GRN_ODE> .
  <https://w3id.org/delphi/resource/evidence/levin-2025-wisdom-04--grok--dataset-2> a delphi:EvidenceItem ;
