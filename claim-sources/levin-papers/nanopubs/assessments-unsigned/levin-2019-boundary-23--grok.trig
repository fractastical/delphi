sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-23> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-23--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-23--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-23: needs-new-data, resolvability 0.30" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.304"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Robustness of anatomy to mutation is a definable contrast between regulative and non-regulative development. The measurements that would populate that contrast, matched mutational neighborhoods of anatomy, have not been released as a dataset. Other sources of canalization predict the same smoothing, so even a future landscape would need the with-versus-without set-point arm. Existing anecdotes do not resolve the ratchet." ;
    rdfs:comment "Proposed test with existing data: Compare anatomical viability under the same mutational perturbations in lineages or models with regulative, set-point development and in matched systems without it. Smoothing is confirmed if goal-directed development yields more viable neighbor phenotypes; equal fragility would refute a ratchet that hides mutational disruption." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public anatomical fitness landscape is paired with a measured morphogenetic set point.", "Canalization from gene-network structure produces the same smoothing.", "The extra-digit anecdote is not a dataset." .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-23--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-23 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
