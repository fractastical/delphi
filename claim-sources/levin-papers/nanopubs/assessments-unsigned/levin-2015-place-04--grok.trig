sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-place-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-place-04--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-place-04: partially-resolvable, resolvability 0.69" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.695"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "The statement is a mathematical claim about a fully specified active-inference model, and the public code exposes free energy and inferred place. Reruns and inspection of the energy can refute unconditional convergence or a non-unique minimum. They do not by themselves prove the guarantee for every target, and the energy is defined so that the encoded target is the low-energy state." ;
    rdfs:comment "Proposed test with existing data: From the published generative model and the public solver, record variational free energy against cell locations and identity beliefs over random initial states. A converged run whose free energy is minimal at a duplicated or mis-assigned place, or a run that fails to reach the target under the stated assumptions, would refute the uniqueness-and-guarantee claim for that model." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The minimum sits at the target largely because the target is encoded as the model's parameters.", "Finite reruns can produce a counterexample, while a universal guarantee needs an analytic argument the demo does not print out." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-place-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-place-04 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/levin-2015-place-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/levin-2015-place-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-place-04--grok--operationalizability> .
