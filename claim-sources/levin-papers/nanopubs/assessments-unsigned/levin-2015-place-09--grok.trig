sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-place-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-place-09--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-place-09: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.605"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Ensemble size and an exogenous input are parameters of a public, specified model, so the comparison can be recomputed. The published file does not contain the sweep, and the claim does not fix the robustness measure, so the result is only partly pinned down by what is already runnable." ;
    rdfs:comment "Proposed test with existing data: Sweep ensemble size above and below four clones in the public model with the exogenous gradient present and removed, and score orientation error and failure rate against a pre-specified robustness statistic. A flat or reversed size effect would refute the reported threshold." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Robustness is not given a numeric definition in the claim.", "The current script fixes the exogenous cause at zero and does not ship the size sweep." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-place-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/levin-2015-place-09--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-place-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-place-09 by Grok 4.7: 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
