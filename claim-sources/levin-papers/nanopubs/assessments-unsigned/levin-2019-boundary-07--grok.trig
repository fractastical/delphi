sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2019-boundary-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-07--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2019-boundary-07: partially-resolvable, resolvability 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.425"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The prediction names a manipulation, a readout, and a spatial signature, so it is testable. The manipulations that exist are published tadpole experiments, scattered in papers and indexed by Xenbase, not a multi-species perturbation matrix. Those papers can speak to the amphibian scope and do not cover metazoan tissues at large. Distance and genomic confounds remain inside the published designs, which makes the available test partial." ;
    rdfs:comment "Proposed test with existing data: Interrupt physiological coupling and score tumor-like incidence; restore coupling and score suppression; vary the distance between the perturbation and the affected cells. Triggering at a distance and suppression on restoration would support the prediction; purely cell-autonomous genomic effects with no distance dependence would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Open cancer genomics resources lack a communication-block perturbation.", "Published tests are amphibian and largely from one research program.", "Voltage changes alter transcription, which confounds a pure coupling mechanism." .
  <https://w3id.org/delphi/resource/assessment/levin-2019-boundary-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2019-boundary-07 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
