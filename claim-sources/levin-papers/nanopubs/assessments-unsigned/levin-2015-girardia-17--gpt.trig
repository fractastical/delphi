  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-17--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on levin-2015-girardia-17: needs-new-data, resolvability 0.43" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.43"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "The proposed directional mechanism is testable but not established by morphology or model fit. Existing public observations lack the cell-type-resolved perturbation and transfer measurements needed to distinguish it from alternatives." ;
    rdfs:comment "Proposed test with existing data: Selectively block gap-junction signaling in somatic cells, trace candidate signals into neoblasts or progeny, and measure migration and head shape while preserving other compartments. Rescue by restoring the signal would strongly support the mechanism." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "The published agent model assumes rather than measures this signaling direction.", "Cell-type-specific perturbation and signal tracing are not available in the cited dataset." .
