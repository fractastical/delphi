sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2015-girardia-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-04--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2015-girardia-04: needs-new-data, resolvability 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.416"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Brain aspect ratio is a standard morphometric variable, and the paper reports a significant group difference. The ratios and images needed to recompute it are not deposited, and no independent staining dataset repeats the octanol comparison. The result stays testable only with those measurements or a new assay." ;
    rdfs:comment "Proposed test with existing data: Measure brain length-to-width ratio from synapsin-stained heads, blinded to external shape class, and test whether induced Girardia brains cluster with the reference species they resemble. A null or reversed clustering would refute the co-transformation." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Per-animal brain measurements are not in a public file.", "External head class and brain class were scored in the same animals, so the resemblance judgment can couple the two readouts." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2015-girardia-04--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2015-girardia-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2015-girardia-04 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
