sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2024-anthrobots-27> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-27--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-27--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2024-anthrobots-27: needs-new-data, resolvability 0.28" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.281"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Immune activation and graft survival after autologous versus allogeneic placement are standard endpoints. Nothing now public is an Anthrobot implant, and graft transcriptomes in general do not substitute for that exposure. The prediction is testable and currently lacks the data." ;
    rdfs:comment "Proposed test with existing data: Implant Anthrobots made from a patient's own bronchial cells back into that patient, or into an autologous human explant with immune cells, and compare graft survival and T-cell or antibody responses with an allogeneic Anthrobot control. Absence of a response above the autologous-tissue baseline would support the safety claim; a raised response would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public in vivo or immune-cell challenge of Anthrobots exists.", "Culture-expanded autologous epithelium can still be immunogenic.", "The statement is a future possibility, so a single negative explant would not establish clinical deployment." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/levin-2024-anthrobots-27--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/levin-2024-anthrobots-27--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2024-anthrobots-27 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
