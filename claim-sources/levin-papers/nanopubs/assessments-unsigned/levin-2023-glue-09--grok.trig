sub:assertion {
  <https://w3id.org/delphi/resource/claim/levin-2023-glue-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/levin-2023-glue-09--grok> .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on levin-2023-glue-09: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.56"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Persistence across amputations and experimental reset are a direct test of a modifiable regenerative target, and the published planarian studies report both. The animal-level lineages are not an open dataset, so the test is a reassessment of those reports. Other stable physiological stores remain live alternatives on the existing evidence." ;
    rdfs:comment "Proposed test with existing data: After a transient bioelectric or gap-junction treatment, cut fragments in later rounds with no further drug and record head number, plus a reset cohort returned to one head by a second manipulation. Two-headed regenerates across rounds, reversed by the reset and not by washout alone, would support a stored target; return to one head as soon as the drug is gone, or a heritable mutation, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Round-by-round head counts are in the experimental papers, not a deposited lineage table.", "A persistent non-genetic store other than the bioelectric circuit, including bacteria, can keep the two-headed outcome." .
  <https://w3id.org/delphi/resource/assessment/levin-2023-glue-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of levin-2023-glue-09 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
