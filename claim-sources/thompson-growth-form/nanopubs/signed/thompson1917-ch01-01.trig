sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch01-01> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "As long as fortuitous variation and the survival of the fittest are accepted as sufficient explanations in biology, they will tend to hold back careful investigation of the real physical causes of organic form.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Reliance on chance variation and natural selection stalls inquiry into physical causes";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter I, “Introductory”; topic “Mechanism versus final causes”. Scope: explanations of organic form in biology generally"
}
