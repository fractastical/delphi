sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch14-11> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Against the 'ideal angle' theory, phyllotactic arrangements that closely approximate the golden mean (8/13, 13/21, 34/55 and higher) are comparatively rare, while poorer approximations such as 3/5, 2/3 and 1/2 are extremely common.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Close approximations to the golden mean are rare; poor ones like 2/3 are common";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XIV, “On Leaf-Arrangement, or Phyllotaxis”; topic “Divergence angle and the golden mean”. Scope: phyllotaxis across plants"
}
