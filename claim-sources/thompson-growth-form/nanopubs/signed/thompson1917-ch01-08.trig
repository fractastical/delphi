sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch01-08> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "There is no clear rule for deciding what is 'vital', and the properties of organisms cannot be clearly split into those of physical origin and those peculiar to living things, so physical analysis must proceed piece by piece.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Vital phenomena cannot be cleanly divided into physical and non-physical ones";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter I, “Introductory”; topic “Vital versus physical phenomena”. Scope: properties and processes of living organisms"
}
