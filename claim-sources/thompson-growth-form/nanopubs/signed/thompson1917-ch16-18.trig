sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch16-18> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "When altered environment and habits introduce new forces, the resulting modifications of form appear not as isolated changes in single parts but as slow, general, graded modifications spread over many correlated parts or the whole body.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "New mechanical forces modify many correlated parts together, not isolated bones";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVI, “On Form and Mechanical Efficiency”; topic “Mechanics and phylogeny”. Scope: evolutionary change of form in animals, especially skeletons"
}
