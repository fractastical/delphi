sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch03-20> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The optimum temperature for growth is much the same, about 26 °C, for the common plants of temperate climates, and considerably higher for plants of warmer regions such as melon and maize.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Common temperate plants share a growth optimum near 26 °C";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Effect of temperature”. Scope: temperate and warm-climate plants (root and shoot elongation)"
}
