sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch07-01> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The forms of cells in contact with one another, and ultimately of tissues, are determined especially by surface tension, which shows itself in the production of surfaces of (relatively) minimal area.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Forms of cell-aggregates are shaped chiefly by surface tension toward minimal areas";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter VII, “The Forms of Tissues, or Cell-Aggregates”; topic “Surface tension in cell-aggregates”. Scope: cell-aggregates and tissues of plants and animals"
}
