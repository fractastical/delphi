sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch12-13> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Foraminiferal shells are absent from coarse sands and gravels not because they avoid concussion but because light shells are sorted by currents like any other graded sediment, settling where water is still.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Foraminifera are absent from coarse gravels because of hydraulic sorting by currents";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XII, “The Spiral Shells of the Foraminifera”; topic “Strength as a supposed selective factor”. Scope: foraminiferal shells in marine sediments"
}
