sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch15-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The left ventricle requires six to seven times the dilating pressure of the right, and its wall thickness is greater in the same proportion.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Left ventricle wall is 6–7 times right's, matching the pressure ratio";
    <http://www.w3.org/2004/02/skos/core#notation> "P_L/P_R \\approx 6\\text{--}7 \\approx t_L/t_R";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XV, “On the Shapes of Eggs, and of Certain Other Hollow Structures”; topic “Wall thickness of the heart”. Scope: mammalian hearts"
}
