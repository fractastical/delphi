sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch16-11> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In large quadrupeds the fore-legs carry considerably more of the body weight than the hind-legs (about 55–58% in horses and elephants and about two-thirds in camels and llamas).";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Quadrupeds carry more of their weight on the fore-legs than on the hind-legs";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVI, “On Form and Mechanical Efficiency”; topic “Distribution of load in quadrupeds”. Scope: large terrestrial quadrupedal mammals"
}
