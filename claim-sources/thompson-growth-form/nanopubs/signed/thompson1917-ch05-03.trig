sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch05-03> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Symmetry is highly characteristic of organic forms because they are figures of equilibrium governed by a principle of minimal energy, as in liquid films; symmetry is lacking only where equilibrium is lacking, as in the amoeba.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Organic symmetry reflects equilibrium and is absent without it, as in amoeba";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter V, “The Forms of Cells”; topic “Minimal energy, equilibrium and symmetry”. Scope: organic forms generally, especially cells"
}
