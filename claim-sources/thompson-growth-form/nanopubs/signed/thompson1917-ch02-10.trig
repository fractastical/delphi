sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch02-10> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Leaving aside differences in mechanical construction, swimming (Froude's law), flight (minimum stable speed) and walking (the leg swinging as a pendulum) all give the same result: an animal's velocity tends to vary as the square root of its linear dimensions.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Speed varies as the square root of linear size in swimming, flight and walking";
    <http://www.w3.org/2004/02/skos/core#notation> "V \\propto L^{1/2} for swimming (Froude), flight (minimum speed) and walking (pendulum leg)";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter II, “On Magnitude”; topic “Speed in locomotion”. Scope: swimming, flying and walking animals of similar construction"
}
