sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch06-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In unicellular organisms not only the general configuration but also the departures from symmetry can be correlated with molecular forces, especially local variations of surface tension, acting in their fluid or semifluid surfaces.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Unicellular forms and their asymmetries follow surface molecular forces";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter VI, “A Note on Adsorption”; topic “Cell form and molecular forces”. Scope: unicellular organisms"
}
