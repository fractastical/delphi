sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch15-01> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Hard-shelled eggs, while often pointed, are never flattened or discoidal: they are prolate, never oblate, solids of revolution.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Eggs are prolate spheroids, never oblate";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XV, “On the Shapes of Eggs, and of Certain Other Hollow Structures”; topic “Shapes of birds' eggs”. Scope: eggs of birds, tortoises and crocodiles"
}
