sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch05-10> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Of the six surfaces of revolution with constant mean curvature (plane, sphere, cylinder, catenoid, unduloid, nodoid), spheres, cylinders and unduloids are the commonest forms of small unicellular organisms and of cells in simple aggregates, and transitions between them are frequent during growth, reproduction and development.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Spheres, cylinders and unduloids are the commonest unicellular forms";
    <http://www.w3.org/2004/02/skos/core#notation> "1/r_1 + 1/r_2 = \\text{const}; surfaces of revolution: plane, sphere, cylinder, catenoid, unduloid, nodoid";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter V, “The Forms of Cells”; topic “Plateau's surfaces of revolution in cells”. Scope: unicellular organisms and cells of simple aggregates"
}
