sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch04-01> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The study of visible cell structure has little value except as part of a dynamical investigation, because the activities of a cell are due to energy and forces, not to particular material particles or structures as such.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Cell structure matters only as the visible expression of forces and energy";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter IV, “On the Internal Form and Structure of the Cell”; topic “Dynamical study of cell structure”. Scope: cells generally, including germ-cells and ova"
}
