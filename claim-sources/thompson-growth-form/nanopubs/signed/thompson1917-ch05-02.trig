sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch05-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Of the physical forces that determine the forms of cells, solitary or in contact, surface tension is of great and probably paramount importance, usually acting together with gravity, mechanical pressure and osmosis.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Surface tension is probably the paramount force determining cell form";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter V, “The Forms of Cells”; topic “Surface tension and the forms of cells”. Scope: all cells, solitary or in aggregates"
}
