sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch14-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Against Church, the spirals in a sunflower disc intersect isogonally (at a constant angle), and orthogonal intersection is only a particular and probably infrequent case.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Sunflower spirals intersect isogonally, rarely orthogonally";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XIV, “On Leaf-Arrangement, or Phyllotaxis”; topic “Church's theory of phyllotaxis”. Scope: parastichies in sunflower capitula and similar inflorescences"
}
