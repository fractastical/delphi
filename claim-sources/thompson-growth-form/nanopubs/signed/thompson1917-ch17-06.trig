sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch17-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The cannon-bones of the ox, sheep and giraffe differ essentially only in relative length and breadth: at equal length, the sheep's bone is about two-thirds and the giraffe's about one-third as broad as the ox's.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Cannon-bones of ox, sheep and giraffe differ by a simple one-axis stretch";
    <http://www.w3.org/2004/02/skos/core#notation> "(x, y) \\mapsto (x, cy): at equal length c \\approx 2/3 (sheep), c \\approx 1/3 (giraffe) relative to ox";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVII, “On the Theory of Transformations, or the Comparison of Related Forms”; topic “Ungulate cannon-bones and feet”. Scope: metapodial (cannon) bones of ruminant ungulates"
}
