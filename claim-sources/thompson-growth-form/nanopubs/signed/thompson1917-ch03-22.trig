sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch03-22> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Growth rate has an optimum temperature because temperature both accelerates growth according to van’t Hoff’s law and progressively damages or fatigues the organism, so the optimum curve is a complex resultant rather than a primary phenomenon.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Optimum temperature curves arise from acceleration combined with cumulative damage";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Effect of temperature”. Scope: physiological processes, especially growth, in plants and animals"
}
