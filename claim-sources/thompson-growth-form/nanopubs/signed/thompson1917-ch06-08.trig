sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch06-08> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Ciliate and flagellate cells show a characteristic accumulation of potassium at and near the base of their cilia, which accounts (through weakened surface tension) for the small protuberance where a flagellum arises and the ridge at the base of a row of cilia.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Potassium accumulates at the bases of cilia and flagella";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter VI, “A Note on Adsorption”; topic “Potassium concentration and weakened tension”. Scope: ciliated and flagellated cells, e.g. Vorticella and monads"
}
