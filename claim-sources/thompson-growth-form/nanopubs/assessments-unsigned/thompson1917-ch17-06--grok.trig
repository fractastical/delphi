sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-06--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch17-06: resolvable-now, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.736"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "The claimed ratios are numerical and the bones are ordinary museum objects with scans and photographs available. A one-axis scaling leaves a residual that can be tested directly against a more complex shape difference. Within-species variation is the main caveat, and it is measurable in the same specimens." ;
    rdfs:comment "Proposed test with existing data: Scale ox, sheep and giraffe cannon bones to equal length and compare breadth, then inspect residual shape after a single transverse stretch. The claim is confirmed if sheep breadth is about two-thirds and giraffe breadth about one-third of the ox, with little residual shape difference; substantially different ratios, or large residuals at the ends and shaft, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Breed, sex and age change metapodial proportions within domestic ox and sheep.", "Giraffe samples in open archives are smaller than livestock samples." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch17-06 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
