  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-11--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-11--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch14-11: partially-resolvable, resolvability 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.757"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Frequency categories and outcomes are explicit, and a substantial test can be built from existing images. Resolving the assertion across plants would require a large harmonized survey not currently available as a direct table." ;
    rdfs:comment "Proposed test with existing data: Compile divergence fractions or parastichy ratios from a taxonomically stratified plant sample and compare prevalence of the listed close and poor approximations. Higher frequencies of 1/2, 2/3 and 3/5 than 8/13 and above support the claim; opposite frequencies refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Image-based samples overrepresent large, conspicuous reproductive structures.", "Ratios are not routinely encoded and require extensive annotation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-11--gpt--dataset-2> .
