sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-12--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch12-12: partially-resolvable, resolvability 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.447"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.57"^^xsd:double ;
    dct:description "Death assemblages show that fragile tests are routinely preserved, which speaks to Thompson's observation that breakage is not universal. They do not record the selective gradient of strength, and fragment counts are not a standard open variable across the global census. A comparative test can bound how common destruction is, while the evolutionary claim about strength as a guiding advantage stays weakly identified." ;
    rdfs:comment "Proposed test with existing data: Compare fragment proportions and shell thickness across assemblages, and test whether more robust forms have higher relative abundance or longer stratigraphic durations. The claim is favored if delicate tests dominate death assemblages with little fragmentation and robustness does not predict persistence; a consistent association of breakage with loss of fragile forms would favor the selective account Thompson rejects." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Fragments in sediment mix predation, dissolution, compaction, and processing damage.", "Abundance of delicate species does not measure whether strength differences affect survival." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch12-12 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-12--grok--operationalizability> .
