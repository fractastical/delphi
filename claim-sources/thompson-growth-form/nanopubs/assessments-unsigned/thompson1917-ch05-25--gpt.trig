  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-25--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch05-25: partially-resolvable, resolvability 0.59" ;
