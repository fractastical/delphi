    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The claim specifies an intervention, quantitative dose equivalence, and geometric mechanism. Public morphology can test whether normal forms resemble shrinkage states, but the decisive concentration-series data are scattered or absent." ;
