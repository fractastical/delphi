sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-06--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch09-06: needs-new-data, resolvability 0.37" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.37"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The chemical alternative is clear enough to test in vitro and at a mineralization front, but the needed paired measurements are not in an open resource. Older solubility remarks are scattered in the chemical literature and do not cover skeletal tissues at the stated scope. Discriminating the protein-breakdown route from carbonic-acid precipitation, among other controls now known to matter, would require new compiled measurements." ;
    rdfs:comment "Proposed test with existing data: Compare calcium carbonate and phosphate solubility in intact albumin versus its breakdown products, and test whether mineralization fronts in calcified tissues coincide with proteolysis rather than with carbonic-acid reaction on a more soluble salt. Precipitation tied to protein breakdown, and not to the acid route, would support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public dataset pairs local proteolysis, protein concentration and mineral appearance in calcifying tissues.", "Modern mineralization also depends on phosphate supply and inhibitors, which the two historical mechanisms do not capture." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch09-06 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
