sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-09--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-09--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-09: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.595"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.79"^^xsd:double ;
    dct:description "The phase sequence is measurable, and open databases permit broad tests for selected vertebrates. Existing standardized trajectories do not cover animals generally, so the universal generalization cannot be fully resolved without major compilation." ;
    rdfs:comment "Proposed test with existing data: Fit size-at-age and growth-velocity curves from birth or hatching to adulthood across animal taxa, then test for the shared sequence of slow onset, early velocity maximum and terminal slowdown. Taxa with maximal growth late or persistent nonzero adult growth would refute universality." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Comparable raw longitudinal growth curves are scattered.", "Birth, hatching and growth cessation differ fundamentally across taxa.", "The universal wording is vulnerable to poorly sampled exceptions." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-09--gpt--dataset-2> .
