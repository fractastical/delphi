sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-27> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-27--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-27--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-27: partially-resolvable, resolvability 0.61" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.613"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "Growth curves are abundant and model comparison is straightforward, but qualitative resemblance has weak discriminating power. Existing data can resolve the pattern in selected taxa, not the claim's organism-wide scope." ;
    rdfs:comment "Proposed test with existing data: Fit organismal growth time series with an explicit autocatalytic-reaction velocity model and compare predictive fit against logistic, Gompertz, von Bertalanffy, and flexible spline alternatives. The resemblance is supported only if the autocatalytic shape consistently captures the stated acceleration and retardation phases without being outperformed." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "'Closely resembles' has no specified goodness-of-fit threshold.", "Many unrelated growth models yield similar sigmoid curves.", "Available databases often store fitted parameters rather than raw time series." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-27--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-27--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-27--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-27 by GPT-5.6 Sol: 0.55" ;
