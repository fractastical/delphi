sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-02--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch16-02: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.592"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The numerical bands are a sharp decision rule. One open archive contains tensile curves for human femoral tissue and omits the matched crushing series Thompson quotes. A compilation of published material tests could finish the comparison for humans and a few other species, which is a real but partial test of fresh vertebrate bone." ;
    rdfs:comment "Proposed test with existing data: Compare ultimate tensile strength and compressive strength of fresh cortical bone, in kg per square mm, on matched specimens. The claim is confirmed if tension falls near 9-12, compression near 13-16, and the two are close; a large gap, or values far from those bands, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Open files emphasize tensile tests of elderly human femoral bone; paired crushing tests of fresh bone across vertebrates are scattered in papers.", "Dry, embalmed and demineralized specimens shift both strengths relative to fresh bone." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-02--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch16-02 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
