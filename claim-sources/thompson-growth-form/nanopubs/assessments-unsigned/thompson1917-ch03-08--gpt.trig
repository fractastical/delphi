    delphi:hasScore "0.906"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.95"^^xsd:double ;
    dct:description "The phase and amplitude comparison is explicit and uses standard growth-curve methods. Large public sex-stratified anthropometric datasets span childhood and adolescence and are adequate for a decisive present-day test." ;
    rdfs:comment "Proposed test with existing data: Estimate sex-specific height-velocity curves and compare their shapes after allowing amplitude and time shifts. Similar aligned curves with an earlier female adolescent acceleration support the claim; irreconcilable shape differences or no phase lead refute it." ;
