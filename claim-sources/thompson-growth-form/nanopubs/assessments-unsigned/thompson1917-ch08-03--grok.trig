sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-03--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-03: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.593"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The volume thresholds are numerically explicit, so the pattern would be decisive if cubical cells with known daughter volumes were archived. Public embryo volumes offer some unequal divisions and not the corner-cutting geometry of the named hairs and precursors. The rule can be probed on a proxy tissue and cannot yet be resolved for the cells it was stated about." ;
    rdfs:comment "Proposed test with existing data: For unequal divisions of roughly cubical cells, plot partition shape against the volume fraction cut off. Curved corner walls below about three-tenths, and spherical octants below about 0.15, with plane walls above the threshold, would support the claim; plane walls remaining common below three-tenths would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Fucus hairs, moss paraphyses and stomatal precursors, the cases named for this corner geometry, are not in the embryo collection.", "Two-dimensional sections underestimate the difference between a quarter-cylinder and a plane." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-03--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-03 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-03--grok--operationalizability> .
