sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-15--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-15--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch16-15: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.492"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "A Pareto analysis captures the intended trade-off, but “shallower than an engineer would build” lacks a fixed design specification. Existing morphology permits illustrative tests, not a decisive test of the causal necessity." ;
    rdfs:comment "Proposed test with existing data: Compare vertebral depth-to-length ratios with optimized cantilever designs under estimated loads, then model the strength-flexibility Pareto frontier and locate observed skeletons on it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "No unique engineer's comparator is specified.", "Required flexibility and safety factors are unknown, especially for fossils." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-15--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-15--gpt--operationalizability> a delphi:LLMClaimAssessment ;
