sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-17--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-17: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.502"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Direction of causation can be turned into a comparison of strain and division, but only after choosing what counts as a decisive perturbation. Suitable movies exist for Arabidopsis, Drosophila and a few other systems, scattered across imaging archives rather than as one growth-versus-division table. That sample can test the relation in those organs and cannot cover the stated scope of plants and animals, and analysis means harmonizing datasets before any causal contrast is credible." ;
    rdfs:comment "Proposed test with existing data: From time-lapse of growing organs, compare the growth-rate anisotropy field with the orientation and timing of division planes, and with organ shape after divisions are reoriented or suppressed. The claim is supported if shape and division geometry are predicted by the growth field, and weakened if division orientation changes form while growth anisotropy stays fixed." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Growth and division are mechanically coupled, so a correlation does not by itself settle which is cause.", "Open imaging covers a few model organs, not growing multicellular structures in general." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-17--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-17 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-17--grok--operationalizability> .
