sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-18--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch09-18: partially-resolvable, resolvability 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.635"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.57"^^xsd:double ;
    dct:description "The two arrangements make different, quantitative predictions, so spine coordinates would discriminate them cleanly. What is public is a scatter of figures rather than a downloadable angle table, and the best-preserved illustrations are not a random sample of living Acantharia. The test is standard once images are compiled, but current open archives only partly cover the named genera." ;
    rdfs:comment "Proposed test with existing data: Measure the latitudes and counts of the twenty spines. Hexagonal symmetry predicts two polar spines, six equatorial spines and two alternating whorls of six; Müller's arrangement predicts five four-spine circles and no polar spine. A systematic match to one angular template and not the other decides the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Acantharia, the main living twenty-spined group, are poorly represented in polycystine image databases and their skeletons are rarely preserved.", "Older sources are drawings that may already embody one or the other symmetry scheme." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch09-18 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-18--grok--operationalizability> .
