sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-16--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-16--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch17-16: resolvable-now, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.705"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "The three skulls are heavily archived as CT and surface scans, and the logarithmic, one-process prediction is a concrete model comparison against modular alternatives. A small team can run that comparison with standard geometric morphometrics. Allometry and landmark scheme are real confounds and do not block a decisive test." ;
    rdfs:comment "Proposed test with existing data: Compare human, chimpanzee and baboon skulls with one continuous transformation and test whether corresponding grid areas increase approximately logarithmically downward and forward. Support would be a single smooth gradient that predicts held-out landmarks; a better fit from separate jaw, face and braincase modules would refute the one-process account." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Size-related allometry can look logarithmic without being a single developmental deformation.", "Landmark choice on the face versus the vault changes how continuous the gradient appears." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-16--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-16--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-16--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch17-16 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-16--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-16--grok--operationalizability> .
