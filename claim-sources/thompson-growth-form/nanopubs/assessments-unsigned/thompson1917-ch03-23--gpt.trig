sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-23> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-23: partially-resolvable, resolvability 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.643"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Seasonality and damping have direct statistical meanings and can be compared with nonperiodic growth models. Existing fish data can test population-level patterns, but the full claim needs longitudinal, seasonally resolved measurements in both fishes and humans." ;
    rdfs:comment "Proposed test with existing data: Fit longitudinal length or mass trajectories with and without an annually periodic term whose amplitude declines with age, separately in plaice, haddock, and humans. Support requires improved out-of-sample fit and declining seasonal amplitude in each stated group." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Cross-sectional fish surveys do not track the same individuals.", "Open human longitudinal records with fine seasonal resolution are limited." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-23--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-23--gpt--dataset-2> .
