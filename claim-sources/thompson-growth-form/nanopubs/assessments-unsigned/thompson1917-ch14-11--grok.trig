sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-11--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch14-11: partially-resolvable, resolvability 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.62"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Rarity of close golden-mean approximations versus abundance of 1/2, 2/3, and 3/5 is a frequency comparison with a clear alternative, the ideal-angle expectation that better approximations should prevail. The best open count file is sunflowers, where high pairs are common, so it tests the wrong end of the distribution for a flora-wide claim. Broader evidence is real but scattered, and a definitive cross-plant ranking would require a compilation that does not yet exist as a dataset." ;
    rdfs:comment "Proposed test with existing data: Tabulate phyllotactic fractions across leaves, cones, and capitula and compare the frequency of 1/2, 2/3, and 3/5 with that of 8/13, 13/21, and higher Fibonacci approximations. The claim is supported if the coarser fractions dominate the flora; it is refuted if close approximations are the common case outside large capitula." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Sunflowers are enriched for the high pairs the claim says are rare, so that file alone cannot represent phyllotaxis across plants.", "Leaf-arrangement surveys remain in botanical compilations rather than one open trait table." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-11--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch14-11 by Grok 4.7: 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.86"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-11--grok--operationalizability> .
