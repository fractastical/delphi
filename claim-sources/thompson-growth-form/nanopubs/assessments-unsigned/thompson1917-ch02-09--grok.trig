sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-09--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch02-09: partially-resolvable, resolvability 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.52"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Absolute versus relative jump height is a sharp, measurable contrast, so operationalizability and discriminating power are high. The obstacle is the data: published jump performances would have to be compiled, they do not span the flea-to-horse range under a common protocol, and similar construction is a judgment rather than a column in a table. Existing numbers can test a mammal subset after months of harmonization, which is only a partial resolution." ;
    rdfs:comment "Proposed test with existing data: Regress absolute jump height, or take-off velocity, on body length for animals judged similarly proportioned. A slope near zero for absolute height, together with a negative slope for height relative to body length, would support the claim; height proportional to size would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Jump height against size, from small jumpers to large mammals, is scattered through papers rather than held in one public dataset.", "Elastic tendons and crouched postures violate the similar-construction premise and change the expected scaling." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch02-09 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-09--grok--operationalizability> .
