sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-15--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-15--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch02-15: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.595"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.79"^^xsd:double ;
    dct:description "The surface-to-volume consequence is straightforward to test with existing 3D images and standard segmentation. The mechanistic claim that division restores an energy balance is much less discriminating and usually lacks the necessary energetic data." ;
    rdfs:comment "Proposed test with existing data: Segment cells through growth and division, calculate surface-area-to-volume ratios before and after cytokinesis, and test whether division restores a characteristic ratio without changing total volume. The geometric component is supported by an increased total surface and restored ratio, but the proposed energy-balance cause requires independent energetic measurements." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Segmentation resolution limits true membrane surface estimates.", "Geometry alone cannot identify surface-energy balance as the cause of division." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-15--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-15--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-15--gpt--operationalizability> a delphi:LLMClaimAssessment ;
