  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-08--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch13-08: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.795"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "The comparative association is directly measurable with standard morphometrics. Public 3D collections can provide a substantial sample, though the proposed causal explanation is less directly tested." ;
    rdfs:comment "Proposed test with existing data: Measure horn cross-sectional thickness and centerline curvature in a taxonomically broad 3D sample, then model their association with controls for body size, sex, age and phylogeny. A robust positive effect supports the claim; a null or negative effect with adequate power refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Thickness and curvature both covary with body size and age.", "External scans may not reveal sheath thickness separately from the core." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-08--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-08--gpt--dataset-3> .
