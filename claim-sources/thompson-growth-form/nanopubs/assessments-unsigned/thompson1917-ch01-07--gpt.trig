sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch01-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-07--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-07--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch01-07: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.583"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "The phenomenology maps well to standard rheological measurements, giving good operationalizability and discrimination. Existing public data are mostly imaging rather than complete force-response experiments, so only a restricted test is currently practical." ;
    rdfs:comment "Proposed test with existing data: Estimate effective viscosity and viscoelastic relaxation from time-resolved amoeba deformation under known pressure or force, and compare flow and relaxation with water and high-viscosity reference fluids. Slow force-dependent flow with a much larger effective viscosity would support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Public images seldom include calibrated applied pressure.", "Protoplasm is active and viscoelastic, not a passive Newtonian fluid." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch01-07--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-07--gpt--operationalizability> a delphi:LLMClaimAssessment ;
