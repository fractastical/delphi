sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch13-10: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.507"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.56"^^xsd:double ;
    dct:description "Unequal flank growth is a measurable alternative to uniform elongation, and classic and later experiments report it for particular twiners. Those measurements are not assembled as a public dataset a team could download and reanalyze, and they rarely span the diversity of climbing stems. The comparison with horn growth is an analogy; the plant data that exist can test local differential growth in a few species only." ;
    rdfs:comment "Proposed test with existing data: During circumnutation, compare epidermal or cortical extension rates on opposite flanks along the elongating stem. The claim is supported if the revolving bend is accompanied by a rotating excess of growth on the convex side over a long zone of the stem; it is weakened if the stem revolves while flank growth rates remain equal." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Kinematic and local-strain measurements of twining stems are scattered in papers rather than held in one open repository.", "Most series cover one or two model climbers, not twining plants as a class." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch13-10 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
