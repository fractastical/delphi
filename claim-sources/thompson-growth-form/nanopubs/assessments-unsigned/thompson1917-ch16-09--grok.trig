sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-09--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch16-09: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.513"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Skeletal geometry is openly scanned and horse ground reactions are deposited, so the rival structural models can be compared in a restricted set of quadrupeds. Ligament lines of action and material properties still have to be compiled. The exercise can reject a naive masonry arch for the horse and does not yet decide the analogy across standing quadrupeds." ;
    rdfs:comment "Proposed test with existing data: Build arch, tied-arch and double-cantilever models on the same quadruped skeletal geometry and compare their horizontal thrust and moment diagrams with measured ground reaction forces and with the presence or absence of a ventral tie. The cantilever would be favoured if the limbs do not supply the arch's thrust and the spine's moments match a double-supported beam; a large horizontal thrust carried by the legs would favour the arch." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Muscles and ligaments act as time-varying ties, so a standing elastic analogy misses the dynamic case.", "Open force data are concentrated on horses and a few other gait-lab species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-09--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch16-09 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-09--grok--operationalizability> .
