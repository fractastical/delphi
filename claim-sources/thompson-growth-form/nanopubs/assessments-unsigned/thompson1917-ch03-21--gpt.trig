sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-21--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-21--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-21: resolvable-now, resolvability 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.76"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.87"^^xsd:double ;
    dct:description "The mathematical response and coefficient are explicit and widely measured, and open experimental data can support tests across representative plants and animals. Broad synthesis requires harmonization, but standard regressions can resolve the qualified claim with current data." ;
    rdfs:comment "Proposed test with existing data: Fit growth or development rates across temperatures within normal ranges and calculate Q10 values, testing whether rates rise approximately exponentially and Q10 commonly lies between two and three. Systematic non-exponential responses or Q10 values outside that range would refute the stated law." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Relevant experiments require compilation from many deposits.", "Q10 varies with temperature interval and proximity to thermal limits.", "Field time series confound temperature with season." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-21--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-21--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-21--gpt--operationalizability> a delphi:LLMClaimAssessment ;
