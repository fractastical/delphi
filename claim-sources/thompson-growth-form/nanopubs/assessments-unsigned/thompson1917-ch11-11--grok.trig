  <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-11--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: MorphoSource" ;
    dct:description "Shell volumes in which growth lines and umbilical overlap can be measured separately." ;
    prov:wasDerivedFrom <https://www.morphosource.org/> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-11--grok--dataset-2> a delphi:EvidenceItem ;
