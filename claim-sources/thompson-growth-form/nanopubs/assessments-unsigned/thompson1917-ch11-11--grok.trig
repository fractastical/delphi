    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of thompson1917-ch11-11 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy> ;
