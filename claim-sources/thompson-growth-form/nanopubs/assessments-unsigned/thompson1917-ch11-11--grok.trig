sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch11-11: partially-resolvable, resolvability 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.62"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Open, touching and overlapping whorls are easy to score, and both nautiloid conditions are represented in public collections. A non-circular test needs the inner and outer rates from growth lines, which scans provide for a subset and ordinary photos often do not. Where only the outline is used, the result mostly restates the spiral geometry instead of discriminating a biological mechanism." ;
    rdfs:comment "Proposed test with existing data: Measure the outer-to-inner growth-rate ratio from growth increments independently of the adult outline, and predict whether whorls stand apart, touch or overlap, including the Nautilus pompilius versus N. umbilicatus contrast. A match supports the claim; overlap that disagrees with the increment ratio refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Inside the logarithmic model, overlap is largely fixed by the expansion ratio, so an outline-only test is nearly geometric rather than empirical.", "Many photographs do not resolve the increments needed for an independent rate." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch11-11 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-11--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of thompson1917-ch11-11 by Grok 4.7: 0.65" ;
