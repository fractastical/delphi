sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch07-09: resolvable-now, resolvability 0.73" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.73"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The packing prediction can be scored with neighbour counts and angles on data that already exist for epithelia, comb and corals. The informative contrast is complete facial contact versus cylinders that only touch locally. That comparison is standard image analysis and is sufficient to confirm or refute the stated tendency, with the topological average kept in view as a bias." ;
    rdfs:comment "Proposed test with existing data: Wherever similar cylinders or spheres are in complete surface contact, measure neighbour number and junction angle in section or surface view, and compare them with loose bundles that do not touch along faces. Complete contact yielding hexagons with angles near 120 degrees, and incomplete contact leaving round profiles, would support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Any trivalent tiling averages six sides, so neighbour number alone is a weak discriminator and angle plus completeness of contact have to carry the test.", "Scans and segmentations over-represent model plants, honeybees and a few coral colonies." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch07-09 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok--operationalizability> .
