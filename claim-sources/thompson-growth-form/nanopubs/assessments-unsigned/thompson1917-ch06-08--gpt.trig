sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch06-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-08--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-08--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch06-08: needs-new-data, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.492"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "The spatial enrichment claim is directly measurable and potentially discriminating. Existing public images describe basal morphology but generally lack validated potassium maps, leaving the central empirical variable unavailable." ;
    rdfs:comment "Proposed test with existing data: Quantify potassium at basal bodies and compare it with nearby cortex, then test whether enrichment predicts flagellar protuberances or ciliary ridges independently of basal-body proteins." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Ion-specific localization at ciliary bases is rarely archived.", "Static colocalization would not establish that potassium causes weakened tension." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-08--gpt--dataset-1> .
