sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-13--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch12-13: partially-resolvable, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.7"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "The variables Thompson names, test abundance and sediment grade, are published together in multiple open PANGAEA sets, including stained living counts that help separate behavior from transport. Those sets do not constitute a global survey of coarse gravels, and sieving practice biases the record toward mud. A small team can test the association now on the available seafloors, which is a real but geographically restricted resolution of a general sedimentological claim." ;
    rdfs:comment "Proposed test with existing data: Regress living and dead foraminiferal abundance on sediment grain size across surface samples, treating grain size as the current-speed proxy Thompson uses. Hydraulic sorting is supported if dead tests track the fine fraction the way other light particles do, including where living animals are present in coarser patches; habitat avoidance is favored if stained living specimens are absent from gravels even when transport is accounted for." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Foraminiferal protocols often discard the coarse fraction, so true gravels are under-sampled.", "Most open pairs of counts and grain size are regional shelves, estuaries, or single cores." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-13--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-13--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch12-13 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.84"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
