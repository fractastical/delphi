sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-18--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch17-18: partially-resolvable, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.697"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "FishBase already holds the length-weight half of the claim for thousands of species, including the named pair, and a k comparison is immediate. The inverse relation between depth and thickness needs body width, which the same database covers only patchily. The volume-conservation statement is testable now for many species, and the full geometric tradeoff is testable only where both transverse dimensions were published." ;
    rdfs:comment "Proposed test with existing data: Across related fishes, test whether body depth and body width vary inversely and whether the length-weight coefficient k = W/L^3 changes less than either linear ratio, including the specific claim that plaice is about twice as deep and half as thick as haddock at similar k. An inverse depth-width relation with stable k would support the claim; independent depth and width, or a large k difference for that pair, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Body width is recorded far less often than length-weight parameters, so the inverse-compensation half is data-limited.", "Length type and seasonal condition shift k independently of the depth-width tradeoff." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch17-18 by Grok 4.7: 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.82"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-18--grok--operationalizability> .
