sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-32> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-32--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-32--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-32: partially-resolvable, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.48"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.57"^^xsd:double ;
    dct:description "The decision variable is a ratio of two growth rates, which experiments have sometimes recorded. There is no compiled public series, and the taxonomic scope is several heterochelous groups studied separately. Even a compiled table would leave neural and molt-stage programs as serious alternative causes of the same reversal." ;
    rdfs:comment "Proposed test with existing data: After claw amputation, measure the regenerative growth rate of the stump and the growth rate of the intact claw, and predict reversal from whether the intact claw reaches the large-claw size class first. Reversal when and only when that ratio favours the intact claw would support the claim; reversal uncorrelated with the two rates would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Paired rate measurements are spread across lobster, snapping-shrimp and crab papers.", "Nerve supply, molt stage and a handedness program can reverse claws at the same sizes.", "Form-follows-size has to be granted before the rate ratio is interpreted." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-32--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-32 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
