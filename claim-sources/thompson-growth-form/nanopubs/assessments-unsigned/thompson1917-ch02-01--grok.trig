sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-01--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch02-01: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.783"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "The decision variable is the ordinary condition factor, and both a global compilation of length-weight fits and individual survey records are openly downloadable. A small team can test whether k stays constant during growth for many fishes in days. Density and reproductive state confound the step from a changing k to a change of form, and non-fish animals are thinly covered, but the relation as Thompson defined it for fishes is directly testable." ;
    rdfs:comment "Proposed test with existing data: Compute k = W/L^3 for individual fish across lengths. A statistically flat k through the growing range would show stable general form at constant density; a systematic trend of k with length would show that form or density is changing while growth continues." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "k mixes shape change with density, gut fullness, and gonad state.", "Coverage is far stronger for commercial fishes than for growing animals in general." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-01--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch02-01 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-01--grok--operationalizability> .
