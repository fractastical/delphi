sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-03--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-03--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch02-03: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.645"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "Existing morphology and trait data can test scaling and estimate mechanical margins across many terrestrial mammals. They cannot cleanly establish a definite universal maximum, because lineages alter posture and structure and because extinct giants require incomplete fossil reconstructions." ;
    rdfs:comment "Proposed test with existing data: Estimate limb-bone cross-sectional area, body mass, muscle area and locomotor performance across terrestrial species, test the predicted square-cube scaling, and calculate safety factors and failure thresholds. Departure from the proposed scaling or viable taxa beyond the predicted bound would count against the mechanism." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "No observed fauna samples the counterfactual sizes near a universal failure limit.", "Posture, gait, bone geometry and material properties confound simple square-cube scaling." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-03--gpt--dataset-2> .
