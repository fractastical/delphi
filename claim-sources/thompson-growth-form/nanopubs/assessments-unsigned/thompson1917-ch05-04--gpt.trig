sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-04--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-04--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch05-04: partially-resolvable, resolvability 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.68"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "The passive-versus-active alternatives imply distinct energy dependence and perturbation responses. Existing movies can test selected systems, though direct force measurements and mechanistic separation are incomplete." ;
    rdfs:comment "Proposed test with existing data: Track pseudopod-tip relaxation after local perturbation and compare curvature dynamics with capillary relaxation predictions; independently inhibit actomyosin contractility and alter membrane or cortical tension. Persistence of predicted rounding without active contraction supports the claim, while ATP-dependent contractile rounding refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Modern cortical tension often arises from active contractility.", "Direct tension measurements are uncommon.", "Passive and active mechanisms may act together." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-04--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-04--gpt--dataset-2> .
