sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-05--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch07-05: resolvable-now, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.7"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.65"^^xsd:double ;
    dct:description "Presence or absence of a polar furrow is a yes-or-no observation, and public cleavage images of frog, sea urchin and other embryos are sufficient to make it. Three-dimensional sets remove the viewing-angle error the claim says produced reports of a simple cross. Coverage is uneven across phyla, but it is enough to confirm or refute the pattern in eggs whose blastomeres meet in full contact." ;
    rdfs:comment "Proposed test with existing data: In four-cell embryos whose blastomeres are in full contact, score whether a polar furrow is present or the four cells meet at one point. A short intermediate partition in essentially every such embryo would support the claim; stable four-way crosses in fully apposed fluid blastomeres would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A cross seen in a single optical plane can hide a short polar furrow, so only 3D or time-resolved volumes are decisive.", "Molluscs and annelids, classical material for this stage, are less completely archived than frog and sea urchin." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-05--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch07-05 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-05--grok--operationalizability> .
