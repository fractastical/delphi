sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-08--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch17-08: resolvable-now, resolvability 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.72"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "The constant-proportion prediction is a simple measurement on leaf images, and Begonia is widely digitized. A varying angle ratio is a direct refutation, and a stable ratio across many leaves is positive evidence. Mounting distortion is a real bias and can be checked by comparing pressed sheets with photographs of fresh leaves in the same portal." ;
    rdfs:comment "Proposed test with existing data: On begonia leaves, measure angles from the base to corresponding radii on each side of the midrib and test whether those angles stay in a constant ratio. A stable ratio, mapping an ovate half onto a cordate half, would support unequal similar growth; a ratio that changes along the midrib would show true asymmetry and refute the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Pressing and mounting distort angles, especially in thin cordate lobes.", "Species and leaf position on the plant add biological scatter around a single ratio." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-08--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch17-08 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.84"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-08--grok--operationalizability> .
