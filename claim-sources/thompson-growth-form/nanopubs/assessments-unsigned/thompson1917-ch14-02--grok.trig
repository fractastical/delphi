sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-02--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch14-02: resolvable-now, resolvability 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.844"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.84"^^xsd:double ;
    dct:description "Intersection angle is directly measurable on the annotated sunflower images already released with the citizen-science counts. Hundreds of heads are enough to estimate how often the crossing is orthogonal and whether the angle stays constant across a disc. Other inflorescences are outside this file, but the claim is aimed at the sunflower case Church discussed, and that case can be decided with the existing images." ;
    rdfs:comment "Proposed test with existing data: On annotated sunflower discs, measure the angle at which clockwise and anticlockwise parastichies meet at many radii. Isogonal intersection is confirmed if that angle is constant within heads and orthogonal crossing is uncommon across heads; a concentration of intersection angles at 90° would support Church's special case instead." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The open images are domesticated sunflower heads, not a sample of other capitula.", "Disordered regions of some heads do not define a single intersection angle." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-02--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch14-02 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
