  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-11--grok--data-existence> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-11--grok--data-adequacy> a delphi:LLMClaimAssessment ;
    rdfs:label "Data adequacy of thompson1917-ch16-11 by Grok 4.7: 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/data-adequacy" ;
    delphi:hasScore "0.48"^^xsd:double ;
