sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-11--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch16-11: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.663"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The percentages are precise enough that force-plate data can settle them species by species. An open horse dataset exists and records a dynamic gait, so it speaks to load sharing without matching the standing condition. The other named species have published measurements that would have to be compiled before the full numerical claim can be confirmed or refuted." ;
    rdfs:comment "Proposed test with existing data: Sum vertical ground reactions on the forefeet and hindfeet of standing or slowly walking horses, elephants, camels and llamas and express the fore share of body weight. The claim is confirmed if horses and elephants fall near 55-58 percent and camels and llamas near two-thirds; shares near one-half, or a reversed ranking of those species, would refute the stated figures." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The deposited horse series is a ridden gallop, whereas Thompson's percentages are for the standing load distribution.", "Elephant, camel and llama force-plate tables are scattered in papers rather than one open archive." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-11--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch16-11 by Grok 4.7: 0.92" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.92"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-11--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-11--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of thompson1917-ch16-11 by Grok 4.7: 0.58" ;
