  <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-10--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: FishBase" ;
    dct:description "Growth studies and length-at-age sources for many fishes; published asymptotic parameters are a circular summary and raw ages are the usable part" ;
    prov:wasDerivedFrom <https://www.fishbase.se/> .
