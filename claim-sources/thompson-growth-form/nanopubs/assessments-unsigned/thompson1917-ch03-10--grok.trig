sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-10--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-10: resolvable-now, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.713"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "The asymptotic pattern is a specific alternative to determinate cessation, and raw length-at-age for many fishes is publicly downloadable from survey and life-history databases. A small team can estimate increments at old ages without assuming the curve the claim asserts. Gear bias and genuine exceptions among ectotherms limit how far the result generalizes, but they do not prevent a direct test of the fish case on which the claim centers." ;
    rdfs:comment "Proposed test with existing data: Using raw length-at-age for fishes, test whether growth increments decline toward zero without a sharp stop, rather than ceasing at a characteristic adult length. Continued slow growth at old ages would support an asymptote; a long terminal period of literally zero growth would count against it. Fitted asymptotic parameters should not be the evidence, because many were estimated by assuming that form." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Published von Bertalanffy parameters assume an asymptote and cannot be used as the test.", "Survey gear under-samples the oldest fish, and some species do stop growing." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-10--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-10 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-10--grok--operationalizability> .
