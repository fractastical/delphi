sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-02--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch13-02: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.776"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Bilateral mirror symmetry of a pair of horns is a routine landmark or surface comparison, and open cranial scans already include both sides of many bovid skulls. The sample is not a complete survey of every genus, but it is large enough to confirm the general rule or to expose a repeated exception. Wear, injury, and core-versus-sheath differences are measurable nuisances, not barriers to the test." ;
    rdfs:comment "Proposed test with existing data: Reflect one horn of a bovid skull onto the other and measure the residual after alignment. Mirror symmetry is confirmed if residuals are within scanning and wear error across sheep, goats, oxen, and antelopes; a systematic directional asymmetry shared by many species would refute the conjugate-spiral claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Scans more often preserve bony cores than the keratin sheath, and the sheath carries much of the visible spiral.", "Museum holdings over-represent domestic cattle, sheep, and a few hunted antelopes." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-02--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch13-02 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
