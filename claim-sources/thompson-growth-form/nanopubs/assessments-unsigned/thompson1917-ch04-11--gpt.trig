sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-11--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-11--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch04-11: resolvable-now, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.775"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "This prediction specifies observable trajectory geometry and a direct refuting result. Standard segmentation and tracking can test it in public time-lapse datasets, although exact species coverage may be limited." ;
    rdfs:comment "Proposed test with existing data: Segment male and female pronuclei and the egg center in 3D time-lapse fertilization movies, then measure path curvature, convexity, meeting position, and post-meeting trajectory. The stated geometry is confirmed if non-diametric starts produce the predicted curves and precentral meeting consistently; contrary trajectories refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Public datasets may emphasize model organisms other than frogs.", "Projection of 3D paths into 2D can bias curvature." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-11--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-11--gpt--operationalizability> a delphi:LLMClaimAssessment ;
