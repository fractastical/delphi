sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-14--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-14--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch08-14: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.674"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "The predicted shape contrast is readily measurable and pollen databases provide broad comparative material. Existing data only partly connect final geometry to the crucial temporal ordering of wall solidification and liberation." ;
    rdfs:comment "Proposed test with existing data: Relate mature pollen or spore sphericity and retained tetrad facets to evidence for wall maturation timing relative to separation across taxa and developmental image series." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Mature shape alone cannot establish wall-hardening time.", "Developmental series and mature morphology are rarely linked for the same taxa." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-14--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-14--gpt--dataset-2> .
