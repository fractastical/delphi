sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-18--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch16-18: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.498"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "Integration of shape across skeletal parts is a standard analysis on open scans and trees. The claim adds that new mechanical forces are what produce the graded pattern, and integration studies also match developmental correlation. Current data can document coordinated change and cannot isolate the mechanical cause." ;
    rdfs:comment "Proposed test with existing data: After habitat or locomotor shifts, measure whether shape change is spread in a graded way across many skeletal regions or concentrated in single bones. Support would be higher morphological integration and more spatially graded change in those transitions than in single-element outliers; a record of isolated, bone-by-bone changes would refute the prediction." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Developmental pleiotropy produces correlated change whether or not new mechanical forces are the cause.", "Fossil sequences rarely preserve enough associated elements to separate graded change from sampling gaps." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-18--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch16-18 by Grok 4.7: 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.48"^^xsd:double ;
