sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-11--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch05-11: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.66"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.67"^^xsd:double ;
    dct:description "The cap proportions are a sharp geometric prediction and a poor fit would refute them. The raw material is public micrographs rather than a measurement table, so a test requires digitising ends, mainly of Spirogyra. That is feasible for a restricted scope and does not by itself show that uniform wall tension is the cause of whatever ratio is found." ;
    rdfs:comment "Proposed test with existing data: On free end cells of Spirogyra and similar filaments, measure cylinder radius R and end-cap height, and test the predictions that cap height is about 0.27R and that the cap is a portion of a sphere of radius 2R subtending 60 degrees. A tight cluster around those values would support the claim; a mean far from 0.27R, or a cap radius other than 2R, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "AlgaeBase images are illustrations, not a random sample of free end cells.", "Turgor and wall thickness are not recorded with the photographs.", "The numerical target assumes uniform wall tension, which may vary along the filament." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-11--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch05-11 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-11--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-11--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of thompson1917-ch05-11 by Grok 4.7: 0.45" ;
