  <https://w3id.org/delphi/resource/claim/thompson1917-ch15-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-03--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-03--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch15-03: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.669"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "The within-individual prediction is direct and highly discriminating. Existing public records likely test subsets, but a dataset jointly containing laying sequence, size and shape across breeds is not assured." ;
    rdfs:comment "Proposed test with existing data: Analyze hen-level longitudinal laying records with egg mass and shape index, testing whether first eggs are smaller and rounder than later eggs and whether breeds with smaller relative eggs have rounder shapes. Consistent within-hen trajectories and breed effects support the claim; absent or reversed effects refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Public poultry datasets often omit egg shape or exact laying order.", "Feed, age, housing and selection line confound breed comparisons." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-03--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-03--gpt--operationalizability> a delphi:LLMClaimAssessment ;
