sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-02--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-02: resolvable-now, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.745"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "Errera's least-area rule is a direct comparison between an observed wall and a computable surface, and open embryo and meristem segmentations contain both the volumes and the walls. That comparison has already been framed on data of this kind and can be repeated or extended with current tools. Overlap with other geometric rules is a known bias and is reducible by choosing cells where the candidate surfaces differ." ;
    rdfs:comment "Proposed test with existing data: For symmetric divisions, compare the area of the observed partition with the least area that can divide the mother-cell volume, and with plausible larger alternatives such as a fixed genetic plane. Observed walls clustering on the area minimum would support Errera's rule; a systematic preference for a larger surface would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Several geometric rules nearly coincide in symmetric cells, so the test needs asymmetric and irregular mothers where the minimum is unique.", "Computing a minimal surface is specialist but is an established method in this literature." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-02--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-02 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-02--grok--operationalizability> .
