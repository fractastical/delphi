sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch15-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-14--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch15-14: resolvable-now, resolvability 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.757"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Roux's angle rules map onto radii and bifurcation angles that public vascular reconstructions already store. A small team can fit the angle-size curve and the equal-branch case with ordinary morphometry. Failure in these large human samples would refute the rule as a general arterial fact; agreement would establish it for the beds that dominate existing open data." ;
    rdfs:comment "Proposed test with existing data: At each bifurcation, measure the branch angle and the daughter-to-parent radius ratio. The claim is supported if angle declines as relative branch size increases, with the smallest side branches near 70-90 degrees and equal daughters leaving at equal angles; a flat or reversed angle-size relation would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Angles measured from projected angiograms differ from true three-dimensional angles.", "Open trees sample humans heavily and leave most vertebrate groups unmeasured." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-14--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch15-14 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-14--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
