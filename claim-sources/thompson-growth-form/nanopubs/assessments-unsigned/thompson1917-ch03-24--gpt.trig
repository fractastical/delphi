  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-24--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-24: resolvable-now, resolvability 0.93" ;
