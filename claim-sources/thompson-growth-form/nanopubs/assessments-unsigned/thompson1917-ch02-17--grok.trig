sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch02-17: partially-resolvable, resolvability 0.63" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.633"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "Soma size and cell number are the variables the claim names, and a large open archive of neuronal morphologies spans many species, including some very large and very small animals. That archive is a biased sample of neuron classes, not a survey of ganglia, so the law as stated for animals in general can be tested only on a restricted and non-random subset. The analysis itself is standard once the subset is defined." ;
    rdfs:comment "Proposed test with existing data: Compare neuronal soma size and the number of cells per ganglion across species that differ widely in body size. A narrow soma-size range, with fewer cells in smaller species, would support the claim; soma size scaling with body size, or no trend in cell number, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Reconstructions over-represent mammalian cortex rather than whole ganglia of small invertebrates.", "Soma size in a reconstruction archive is not a random sample of ganglion cells, and complete cell counts are a thinner subset." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-17--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch02-17 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--grok--data-existence> a delphi:LLMClaimAssessment ;
