  <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-01--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Endless Forams" ;
    dct:description "Expert-identified light images of modern planktonic foraminifera, including spherical Orbulina, for outline comparison with a free drop" ;
    prov:wasDerivedFrom <http://www.endlessforams.org/> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-01--grok--dataset-2> a delphi:EvidenceItem ;
