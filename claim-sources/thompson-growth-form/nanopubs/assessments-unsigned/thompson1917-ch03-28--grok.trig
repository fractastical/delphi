sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-28> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-28--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-28--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-28: resolvable-now, resolvability 0.73" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.732"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The claim is existential: some internal and external substances accelerate growth and change proportions. Mouse endocrine-pathway knockouts, with open body-size and body-composition measures, are enough to confirm or fail that existence claim for internal secretions. External dosing and non-mammal examples remain scattered in papers, which limits scope but does not block a decision on the core assertion." ;
    rdfs:comment "Proposed test with existing data: Compare body size and body-proportion phenotypes of animals in which thyroid, pituitary or growth-hormone pathways are disrupted with matched controls. A change in both scale and proportions would confirm that such substances can alter form; size changes that are pure scaling, or no growth effect at all, would count against the claim as stated." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The open screen is a mouse knockout panel, so tadpoles, birds and external doses such as iodine are outside it.", "Some proportion shifts are secondary to illness rather than a specific growth stimulus." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-28--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-28--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-28 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-28--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-28> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-28--grok--operationalizability> .
