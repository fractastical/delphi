sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch01-07> a delphi:Claim ;
    rdfs:label "Protoplasm behaves as a highly viscous fluid that changes shape under force" ;
    dct:description "The protoplasm of an Amoeba deforms and flows under the slightest pressure, so it is a fluid, but it is far more viscous than water, like treacle, and this viscosity slows its changes of shape." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter I, “Introductory”; topic “Physical properties of the Amoeba”. Scope: protoplasm of Amoeba and similar naked cells" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "While the protoplasm of the Amoeba reacts to the slightest pressure, and tends to “flow,” and while we therefore speak of it as a fluid, it is evidently far less mobile than such a fluid, for instance, as water, but is rather like treacle in its slow creeping movements as it changes its shape in response to force." ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=1370,1375> .

