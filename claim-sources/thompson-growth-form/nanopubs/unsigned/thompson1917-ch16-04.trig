sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-04> a delphi:Claim ;
    rdfs:label "Femoral wall thickness follows the bending-moment distribution along the shaft" ;
    dct:description "Because bending strain is greatest at mid-length of a bent column, the walls of a long bone such as the femur are thickest in the middle of the shaft and thin gradually towards the ends, so that wall thickness forms a graph of the bending moments along the bone." ;
    skos:notation "wall thickness t(x) \\propto bending moment M(x), maximal at mid-shaft" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVI, “On Form and Mechanical Efficiency”; topic “Tubular construction of bones and stems”. Scope: weight-bearing long bones, especially the human femur" ;
    dct:type "mathematical-law" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Hence, if our cylindrical column be exposed to strong bending stresses, it will be prudent and economical to make its walls thickest in the middle and thinning off gradually towards the ends; and if we look at a longitudinal section of a thigh-bone, we shall see that this is just what nature has done." ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=22461,22466> .

