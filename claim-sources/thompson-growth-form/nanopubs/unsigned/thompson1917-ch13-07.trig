sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-07> a delphi:Claim ;
    rdfs:label "Uneven adhesion of the horn sheath to its bony core can itself produce the spiral" ;
    dct:description "Unequal retardation of the growing horn sheath by its adhesion to the bony core can produce the same spiral as unequal growth, and is probably a very important and sometimes the chief factor in horn curvature." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XIII, “The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion”; topic “Summary of horn growth”. Scope: horns of hollow-horned ruminants" ;
    dct:type "mechanism" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "had its elongation more retarded on one side than the other (prior to its complete solidification) by varying degrees of adhesion or membranous attachment to the bone core within, then the net result would be a spiral curve precisely such as would have arisen from initial inequalities in the rate of growth itself. It seems highly probable that this is a very important factor" ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=20552,20558> .

