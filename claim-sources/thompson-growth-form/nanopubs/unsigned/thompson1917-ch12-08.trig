sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-08> a delphi:Claim ;
    rdfs:label "Attached Foraminifera form plane spirals with whorls flattened on the attached side" ;
    dct:description "Most spiral Foraminifera are plane (discoid) spirals because some force keeps the chambers in a plane, especially in forms that live attached to rock or seaweed, whose whorls are flattened on the attached surface; freely floating forms such as Globigerina tend towards helicoid spirals." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XII, “The Spiral Shells of the Foraminifera”; topic “Types of foraminiferal shell”. Scope: benthic attached versus planktonic Foraminifera" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "The majority of spiral forms, on the other hand, are plane or discoid spirals, and we may take it that in these cases some force has exercised a controlling influence, so as to keep all the chambers in a plane. This is especially the case in forms like Rotalia or Discorbina (Fig. 316), where the organism lives attached to a rock or a frond of sea-weed" ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=20018,20024> .

