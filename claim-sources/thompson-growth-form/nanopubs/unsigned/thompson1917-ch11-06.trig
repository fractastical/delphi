    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-06> a delphi:Claim ;
    rdfs:label "Each increment of a spirally grown structure is a gnomon to the whole before it" ;
    dct:description "In horns, shells and all other organic forms showing a logarithmic spiral, the existing structure is partly old and partly new, and each successive increment of growth is a gnomon to the whole pre-existing structure, that is, an addition that leaves the enlarged whole similar to what it was before." ;
    skos:notation "each increment G is a gnomon: F \\cup G \\sim F" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XI, “The Logarithmic Spiral”; topic “Gnomons and the time-element”. Scope: molluscan shells and opercula, foraminiferal chambers, horns, tusks" ;
    dct:type "mathematical-law" .
}

