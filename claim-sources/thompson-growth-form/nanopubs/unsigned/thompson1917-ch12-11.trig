sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-11> a delphi:Claim ;
    rdfs:label "Identical foraminiferal forms may have arisen independently again and again" ;
    dct:description "The possible lines of variation in Foraminifera may be so narrow and determinate that identical forms have arisen independently many times." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XII, “The Spiral Shells of the Foraminifera”; topic “Conclusion: evolution of foraminiferal form”. Scope: Foraminifera through geological time" ;
    dct:type "historical-inference" .
}

