  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "The size ultimately attained is a resultant of the rate, and of the duration, of growth. It is in the main true, as Minot has said, that the rabbit is bigger than the guinea-pig because he grows the faster; but that man is bigger than the rabbit because he goes on growing for a longer time." ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=3320,3325> .

