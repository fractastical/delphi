sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-11> a delphi:Claim ;
    rdfs:label "Adult size results from both the rate and the duration of growth" ;
    dct:description "The size an animal finally attains results from both its rate and its duration of growth: some species are larger because they grow faster (rabbit versus guinea-pig), others because they grow for longer (man versus rabbit)." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Growth curves in other animals”. Scope: animals, especially mammals" ;
    dct:type "empirical-generalization" .
}

