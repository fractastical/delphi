sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch15-02> a delphi:Claim ;
    rdfs:label "The most pointed eggs are those largest relative to the parent bird" ;
    dct:description "As a very common rule, the most asymmetrical, posteriorly tapered eggs are those that are large relative to the parent bird (guillemot, curlews, sandpipers, terns), because they are under the greatest pressure in the oviduct; relatively large but symmetrical eggs (apteryx) imply a relatively large oviduct." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XV, “On the Shapes of Eggs, and of Certain Other Hollow Structures”; topic “Egg size and asymmetry”. Scope: birds' eggs across species" ;
    dct:type "empirical-generalization" .
}

