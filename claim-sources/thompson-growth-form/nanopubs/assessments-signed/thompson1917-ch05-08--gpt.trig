    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-08--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch05-08: partially-resolvable, resolvability 0.61";
    dc:description "The geometric prediction is quantifiable from 3D surfaces, and public specimens can test the chamber-versus-whole contrast. The causal role of surface tension during the unobserved fluid stage is harder to establish from finished shells.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct successive chamber surfaces in living or growth-staged foraminifera and test each new chamber against constant-mean-curvature or minimum-area surfaces under its boundary conditions, while testing the aggregate shell separately. Support requires good fits for new chambers but not for the whole shell and evidence of subsequent rigidification.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Boundary conditions and growth-stage timing are often unknown.", "Desmid coverage is limited.", "Rigid shells record final rather than fluid chamber geometry.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-08--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.615"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-08--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Open 3D micro-CT models of foraminiferal tests can support chamber-by-chamber geometric fitting.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-08--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PANGAEA";
    dc:description "Public earth-science datasets include foraminiferal measurements and imagery across taxa and environments.";
    prov:wasDerivedFrom <https://www.pangaea.de/>.
