sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch16-03--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch16-03: partially-resolvable, resolvability 0.58";
    dc:description "Cross-sectional geometry of long bones is measurable on open CT and on at least one tabulated femur series. Linking hollowness specifically to omnidirectional bending requires an independent load classification, and many hollow organs have other functions. The comparison can be run for bird wing bones versus some limb bones and remains a proxy for the full design claim, including plants and quills.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure the hollowness index (inner versus outer radius, or second-moment contribution of the cortex) in structures that carry bending in all directions and in structures loaded mainly in compression. Support would be thin-walled tubes in bird wing bones, quills and reed stems, and solid or thick-walled sections where bending is small; hollow compression members and solid bending members would refute the design rule.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Hollowness also serves marrow, pneumatization and mass reduction, so bending stiffness is not isolated by the cross-section alone.", "Quills and reed stems are thinly represented beside vertebrate bone scans.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-03--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.583"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch16-03--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "CT series of bird wing bones and other long bones for cortical thickness and medullary diameter";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch16-03--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Odocoileus virginianus femur morphology and mechanics";
    dc:description "Periosteal and endosteal diaphyseal diameters of fresh deer femora, a direct hollowness measurement for a weight-bearing bone";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.59gg3>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch16-03--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch16-03 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-03--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch16-03--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch16-03 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-03--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch16-03--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch16-03 by Grok 4.7: 0.68";
