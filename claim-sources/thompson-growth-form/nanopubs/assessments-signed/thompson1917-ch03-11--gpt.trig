<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-11: partially-resolvable, resolvability 0.72";
    dc:description "The decomposition is measurable and can be tested for mammals using public life-history data plus published trajectories. The broad animal scope and lack of standardized curve parameters across species make the full claim only partially resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Decompose adult size across species into fitted growth rate and duration parameters, then test whether both independently explain final size and whether rabbit–guinea-pig and human–rabbit contrasts follow the stated components. Failure of either component to predict size would refute that part.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Databases contain endpoints more often than complete growth trajectories.", "Growth rate and duration estimates are statistically correlated.", "Phylogeny and ecology confound three-species comparisons.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AnAge";
    dc:description "Public mammalian development, maturity, adult mass and longevity traits.";
    prov:wasDerivedFrom <https://genomics.senescence.info/species/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PanTHERIA";
    dc:description "Public mammalian life-history and body-size traits for comparative analysis.";
    prov:wasDerivedFrom <https://esapubs.org/archive/ecol/E090/184/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-11--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-11 by GPT-5.6 Sol: 0.7";
