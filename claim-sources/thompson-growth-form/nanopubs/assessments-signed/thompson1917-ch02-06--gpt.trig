<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch02-06: partially-resolvable, resolvability 0.64";
    dc:description "The scaling exponents give clear tests and open morphology plus movement data cover many birds. The exact energetic quantities require model-derived estimates and harmonization, so the claim is currently resolvable only under subsets and assumptions.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across geometrically similar birds, fit minimum sustained flight speed and flight power against linear size and test exponents of 0.5 and 3.5, while comparing available muscle power with an exponent of 3. Deviations outside uncertainty or successful flight above the predicted power margin would refute the model.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Bird proportions and flight styles are not fixed across size.", "Flight power and muscle power are seldom directly measured in open comparative datasets.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-06--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.638"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-06--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Movebank";
    dc:description "Public tracking and accelerometry studies for flight speed in multiple bird species.";
    prov:wasDerivedFrom <https://www.movebank.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-06--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AVONET";
    dc:description "Open global bird morphology and mass traits for body-size and wing-form covariates.";
    prov:wasDerivedFrom <https://opentraits.org/datasets/avonet.html>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-06--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch02-06 by GPT-5.6 Sol: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
