<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch02-17: partially-resolvable, resolvability 0.63";
    dc:description "Neuron dimensions and cell counts are measurable and existing neuroanatomical resources support restricted comparisons. Taxonomic selection, missing ganglion totals and uncertain homology prevent resolution of the asserted general law.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across species, measure homologous ganglion-cell volumes and total cell counts per ganglion, then test whether cell size varies narrowly while ganglion cell number rises with species body size. Broad neuron-size scaling or no number-size association would refute the generalization.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Body-size metadata are often missing.", "Homologous ganglia and neuron classes are difficult to align across phyla.", "Repositories emphasize selected neurons rather than unbiased cell counts.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-17--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-17--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.63"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-17--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NeuroMorpho.Org";
    dc:description "Open neuronal reconstructions across species for cell morphology and size.";
    prov:wasDerivedFrom <https://neuromorpho.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-17--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Allen Brain Atlas";
    dc:description "Open comparative brain and cell-type data for selected species.";
    prov:wasDerivedFrom <https://portal.brain-map.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch02-17 by GPT-5.6 Sol: 0.55";
