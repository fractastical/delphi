<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-14--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch12-14: partially-resolvable, resolvability 0.70";
    dc:description "The warning has a clear empirical consequence—physically generated similarity should be homoplastic relative to independent trees. Data can test examples and estimate risk, but cannot settle the normative breadth of how classification 'must' be revised.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For traits with an independently supported physical generative model, quantify homoplasy by mapping form similarity onto molecular phylogenies. Excess similarity among distant relatives under shared physical regimes would show that form alone is unsafe evidence of kinship; close correspondence with independent trees would weaken the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Taxonomic classification uses many characters, not form alone.", "The claim is conditional on first demonstrating physical control.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-14--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-14--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-14--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.697"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-14--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI GenBank";
    dc:description "Sequence data for phylogenies independent of morphology.";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-14--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Comparable 3D morphology for quantifying form similarity.";
