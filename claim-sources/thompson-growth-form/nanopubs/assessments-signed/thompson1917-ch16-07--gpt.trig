    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch16-07: needs-new-data, resolvability 0.53";
    dc:description "The prediction is specific, temporal and highly testable in principle. Existing repositories do not provide enough serial microarchitecture plus loading data to resolve it, especially away from the injury.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use serial CT after malunited fracture to quantify changes in trabecular orientation locally and distally, comparing them with changing finite-element principal stresses and uninjured controls. Complete alignment within weeks is the stated criterion.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Clinical CT seldom resolves trabeculae adequately.", "Public serial high-resolution scans of malunion are scarce.", "The weeks-scale and “entirely remodelled” criteria are demanding.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-07--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.531"^^xsd:double;
