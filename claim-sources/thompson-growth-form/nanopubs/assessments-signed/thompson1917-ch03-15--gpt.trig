    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-15: partially-resolvable, resolvability 0.66";
    dc:description "The pre/post mass contrast is simple and highly discriminating. Public datasets can test representative species and readily challenge the universal extension, but taxonomically broad paired measurements require substantial compilation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure the same individuals' wet or dry mass immediately before and after metamorphosis across eels, insects and amphibians. Frequent mass loss supports often, while a well-sampled class showing stable or increased mass would refute always.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Hydration and gut evacuation can mimic tissue loss.", "Often has no explicit frequency threshold.", "Relevant measurements are scattered rather than standardized.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-15--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.658"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
