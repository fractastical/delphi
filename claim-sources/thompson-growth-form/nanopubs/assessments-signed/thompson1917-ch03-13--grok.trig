sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch03-13: resolvable-now, resolvability 0.78";
    dc:description "Both the spread of stature and weight and the mean rate of growth are estimable from the same open age-specific surveys, and the predicted rise and fall of variability is a definite pattern. Tempo variation at adolescence is a serious confound for the interpretation that variability is a function of the rate itself, but it is measurable in the same data and does not make every outcome compatible with the claim. The association can be confirmed or refuted with a standard analysis.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compute the coefficient of variation of stature and of weight by age, and the mean growth velocity at the same ages. The claim predicts that the coefficient falls as velocity falls through childhood and rises again with the adolescent acceleration. A flat coefficient through the adolescent spurt would refute that association.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Adolescent variance rises partly because children enter the spurt at different ages, which is related to but not identical with a higher growth rate.", "Weight variation is also affected by body composition.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-13--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NHANES";
    dc:description "Individual stature and weight by age, so both the age-specific coefficient of variation and the mean velocity can be estimated";
    prov:wasDerivedFrom <https://wwwn.cdc.gov/nchs/nhanes/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: WHO Child Growth Standards";
    dc:description "Published percentiles by age, an alternative estimate of spread against growth rate in childhood";
    prov:wasDerivedFrom <https://www.who.int/tools/child-growth-standards>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-13 by Grok 4.7: 0.85";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-13--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch03-13 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-13--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-13--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch03-13 by Grok 4.7: 0.85";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-13--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-13--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of thompson1917-ch03-13 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-discriminating-power>;
