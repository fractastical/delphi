    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch10-03: partially-resolvable, resolvability 0.49";
    dc:description "Individual cases can be tested geometrically, but the frequency claim requires defining a sampling universe and compiling diverse structures. Open images support restricted tests rather than a decisive general prevalence estimate.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On 3D curved biological surfaces, extract crossing line systems and test each family for low geodesic curvature, then estimate how often reticulation is generated by two such families rather than branching or cellular tiling. A representative prevalence estimate would address the phrase 'very common.'";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Many reticula arise through branching networks or cell packing.", "The scope and threshold for 'very common' are unspecified.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-03--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.49"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
