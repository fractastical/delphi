sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch09-09: partially-resolvable, resolvability 0.52";
    dc:description "Form overlap versus mineral class is a fair empirical reading of the argument, and both spicule faunas are extensively illustrated. The illustrations are not a joint morphometric dataset, and holothurian and sponge images sit in different literatures. Similar shapes would still be compatible with convergence for reasons other than cell confinement, so the chemistry-independence claim is only partly separated from its rivals.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Embed siliceous sponge spicules and calcareous holothurian spicules in a common morphospace and test whether corresponding forms overlap. Overlap supports form set by shared external confinement; separation that tracks mineralogy rather than shape class would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Quantitative spicule outlines are not in one downloadable table and would have to be measured from plates.", "The two groups are not a controlled contrast: cell geometry and ancestry differ along with chemistry.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.518"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: World Porifera Database";
    dc:description "Catalogue and linked images of siliceous sponge spicule types used as one side of the comparison.";
    prov:wasDerivedFrom <https://www.marinespecies.org/porifera/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: World Register of Marine Species";
    dc:description "Taxonomic entry point for holothurians as well as sponges, with links toward species whose spicules are illustrated in the literature.";
    prov:wasDerivedFrom <https://www.marinespecies.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "Morphological matrices and media for coding spicule shape independently of skeletal chemistry.";
    prov:wasDerivedFrom <https://www.morphobank.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch09-09 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-09--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
