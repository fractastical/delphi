    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch10-06: resolvable-now, resolvability 0.74";
    dc:description "The kinematic mechanism has precise and discriminating predictions, and published open videos cover multiple ciliated and flagellated swimmers. Standard tracking can resolve the core claim, though not every taxon in its broad scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Track 3D position and body orientation of swimming microorganisms, estimating axial rotation, body-fixed curvature and helix pitch. The mechanism is supported when observed trajectories follow parameters predicted from rotation and swerve and become circular when rotation approaches zero.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Many videos are two-dimensional.", "Phototaxis, boundaries and fluid flow can perturb paths.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-06--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.745"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
