sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-22--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch11-22: partially-resolvable, resolvability 0.62";
    dc:description "Occurrences through time and shell images are both public, so recurrence of coiled forms among molluscs, and their mixing in faunas, can be tested now. Extending mathematically identical to foraminifera and tube worms, in every period and irrespective of climate, needs a harmonized morphospace that only partly exists. That is months of alignment rather than a single standard analysis, and it would still leave sampling bias in the fossil record.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Place gastropod, cephalopod, foraminiferal and tube-worm shells in one coiling morphospace and test recurrence of the same forms across clades, geological periods and climate or depth settings. Repeated overlap, with forms mixed within deposits, supports the claim; forms restricted to clade, era or climate refute the corresponding part.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A common measurement protocol for molluscs, foraminifera and worm tubes is not already computed, and worm tubes are sparsely scanned.", "Preservation and sampling differ by period and climate, which can create false recurrences or hide real habitat limits.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-22--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-22--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-22--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Phanerozoic occurrences of molluscs, foraminifera and tube-dwelling worms for time, geography and co-occurrence.";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-22--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "3D shells for mathematical comparison of coiling across groups, strongest for molluscs.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-22--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Mikrotax";
    dc:description "Foraminiferal images so that coiled foraminifera can enter the same morphospace as mollusc shells.";
    prov:wasDerivedFrom <https://www.mikrotax.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-22--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch11-22 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-22--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-22--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch11-22 by Grok 4.7: 0.5";
