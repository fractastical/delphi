    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch14-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch14-07: resolvable-now, resolvability 0.81";
    dc:description "The necessity statement is a crisp combinatorial prediction once the genetic spiral is indexed. Existing images can supply many tests, and model-based enumeration avoids relying only on visual prominence.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct the indexed genetic spiral from high-resolution organ maps, enumerate every parastichy family, and test whether observation of a higher Fibonacci pair always co-occurs with all lower pairs under one prespecified visibility-independent definition. A single valid counterexample refutes necessity; universal co-occurrence in broad data supports it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Implicit mathematical parastichies must be distinguished from visually conspicuous ones.", "Occlusion can hide lower-order connections.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-07--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-07--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.809"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch14-07--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iDigBio";
    dc:description "Public high-resolution cone and inflorescence images for organ indexing.";
    prov:wasDerivedFrom <https://www.idigbio.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch14-07--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "Open quantitative phyllotaxis datasets and image supplements.";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch14-07--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
