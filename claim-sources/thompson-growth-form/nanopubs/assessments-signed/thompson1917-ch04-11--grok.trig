    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-11--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-11--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
