    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI GenBank";
    dc:description "Public sequences for phylogenies independent of shell shape.";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-11--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
