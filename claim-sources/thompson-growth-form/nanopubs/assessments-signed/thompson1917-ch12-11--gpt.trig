    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch12-11: partially-resolvable, resolvability 0.64";
    dc:description "Convergence is testable when morphology is mapped onto a phylogeny inferred from independent characters. Existing data can establish examples but likely cannot estimate how often it happened across all Foraminifera.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Map quantified shell forms onto independently inferred molecular and fossil phylogenies and count repeated origins of near-identical morphologies. Multiple distant lineages converging beyond uncertainty would support the claim; forms restricted to single clades would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Identical form requires an explicit morphometric tolerance.", "Sparse molecular sampling and uncertain fossil placement.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-11--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-11--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.639"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
