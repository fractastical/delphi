    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch09-01: partially-resolvable, resolvability 0.53";
    dc:description "Mineral location is directly observable, but the active-versus-inactive distinction often needs proxy markers. Public microscopy can address particular tissues, while the cross-kingdom 'as a rule' scope would require extensive harmonization.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Classify mineral nucleation sites in histological and ultrastructural images by whether they lie inside metabolically active cytoplasm or in extracellular or inactive matrix. The generalization is supported if nucleation overwhelmingly occurs in matrix across representative calcifying and silicifying taxa.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Metabolic activity is rarely measured in the same images.", "Public images are taxonomically and procedurally biased.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-01--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.533"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
