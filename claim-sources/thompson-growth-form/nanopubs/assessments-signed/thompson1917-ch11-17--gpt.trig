<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-17--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch11-17: partially-resolvable, resolvability 0.64";
    dc:description "Nested layers and spiral lines are measurable, and the mechanism has a useful comparative prediction. Public developmental coverage of the relevant clam-shrimp taxa is likely too sparse for full causal resolution.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use developmental imaging and preserved carapaces to test whether successive retained exuviae adhere as nested layers, project beyond prior margins and generate fitted logarithmic growth lines. Comparison with fully moulting branchiopods would test the incomplete-moult mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Estheria is a historical taxonomic name.", "Static carapaces may not distinguish retained moults from continuous secretion.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-17--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-17--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.635"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-17--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Public micro-CT data may reveal nested carapace layers and external growth lines.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-17--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
