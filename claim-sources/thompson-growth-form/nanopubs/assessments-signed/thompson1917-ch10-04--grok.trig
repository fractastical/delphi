sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch10-04: partially-resolvable, resolvability 0.59";
    dc:description "Shortest paths on a measured surface are a clear test, and public cardiac diffusion data plus ventricular shape models make the heart part feasible with specialist but existing tools. The claim names a list of hollow organs for which comparable open fiber maps are sparse. A heart-only result would resolve a restricted scope and leave the general automatic-arrangement claim open.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On reconstructed surfaces of heart, stomach, arteries and gut, compare muscle-fiber trajectories with computed geodesics. Fibers lying on shortest paths, annular and longitudinal on a simple tube, support the claim; systematic extra length or a non-geodesic helix would refute it for that organ.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Myocardial fibers also follow sheet architecture and load, so a geodesic fit can be confounded with stress alignment.", "Open fiber-orientation data are concentrated on the human left ventricle, not the stomach, arteries, intestine or worm body wall.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.63"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-04--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.593"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch10-04--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Human cardiac diffusion MRI dataset";
    dc:description "Open cardiac diffusion-tensor imaging and derived myocardial orientation maps for testing fiber paths against geodesics.";
    prov:wasDerivedFrom <https://doi.org/10.25740/yh756nh8583>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch10-04--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cardiac Atlas Project";
    dc:description "Ventricular shape models on which surface geodesics can be computed and compared with fiber directions.";
    prov:wasDerivedFrom <https://www.cardiacatlas.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch10-04 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch10-04 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch10-04 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of thompson1917-ch10-04 by Grok 4.7: 0.55";
