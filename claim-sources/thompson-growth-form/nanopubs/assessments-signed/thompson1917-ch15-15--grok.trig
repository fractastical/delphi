sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch15-15: partially-resolvable, resolvability 0.57";
    dc:description "The cosine formula is explicit, and angles plus radii are in open reconstructions. Turning those radii into Thompson's energy loss per unit length requires a flow model, and Vascular Model Repository simulations cover only a subset of vessels. The resulting comparison can check consistency with the formula and struggles to separate it from other radius-based angle rules.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For each branch, compare the observed angle with arccos of the ratio of energy loss per unit length in the parent and in the branch. Support would be a tight match between that predicted angle and the measured angle; systematic deviation toward a size-only or constant-angle rule would refute the energy-loss formula.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Energy loss is usually inferred from radius and assumed flow, so the test can recycle the same hydraulic assumptions that motivate the formula.", "Local pressure-drop measurements paired with angles are uncommon outside simulated models.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-15--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.574"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch15-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BraVa";
    dc:description "Measured branch angles and radii from which a Poiseuille estimate of relative energy loss can be formed";
    prov:wasDerivedFrom <http://cng.gmu.edu/brava/home.php>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch15-15--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Vascular Model Repository";
    dc:description "Geometries with flow boundary conditions and simulation outputs for a more direct estimate of dissipation along parent and branch";
    prov:wasDerivedFrom <https://www.vascularmodel.com/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch15-15 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch15-15 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch15-15 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of thompson1917-ch15-15 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-discriminating-power>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of thompson1917-ch15-15 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/operationalizability";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok>.
<https://w3id.org/delphi/resource/claim/thompson1917-ch15-15> <https://w3id.org/delphi/ontology/hasAssessment> <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--analysis-feasibility>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--data-adequacy>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--data-existence>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--discriminating-power>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-15--grok--operationalizability>
}
