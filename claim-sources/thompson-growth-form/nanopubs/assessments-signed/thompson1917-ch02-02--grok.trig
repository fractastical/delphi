sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch02-02: resolvable-now, resolvability 0.81";
    dc:description "Diameter and height for hundreds of thousands of trees are already in open allometric tables, and a log-log comparison with the rival exponents 1 and 2 is a standard regression. That decides the scaling law that is the core of the claim, including the relative slenderness of smaller stems. The single-pine height of about 300 ft needs a modulus the density database does not supply, and several mechanical models can share an exponent, but neither gap blocks a clear test of the stated 3/2 relation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Regress log stem diameter on log height. An exponent near 3/2 would support elastic similarity; exponents near 1 or 2 would favor geometric similarity or constant-stress scaling instead. The separate numerical cap of about 300 ft is checked by inserting the measured taper, density, and modulus of a pine of the Kew-flagstaff form into Greenhill's buckling formula.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Inventories are cross-sectional, so young-versus-old slenderness is inferred from size rather than from followed stems.", "Wind and hydraulics predict exponents similar to elastic buckling, and elastic modulus is not in the density table.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.813"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Tallo";
    dc:description "Individual tree stem diameter and height for fitting the diameter-height exponent across thousands of species";
    prov:wasDerivedFrom <https://github.com/selva-lab-repo/TALLO>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FIA DataMart";
    dc:description "National forest inventory stem diameters and heights, including small stems, for the same allometric test";
    prov:wasDerivedFrom <https://apps.fs.usda.gov/fia/datamart/datamart.html>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-02--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Wood Density Database";
    dc:description "Wood density for thousands of taxa, one material constant in the self-buckling height calculation";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.234>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch02-02 by Grok 4.7: 0.85";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-02--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch02-02 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-02--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-02--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch02-02 by Grok 4.7: 0.9";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
