    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-10--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-10: resolvable-now, resolvability 0.79";
    dc:description "Long-running fish surveys and compiled growth parameters directly support model comparison across many species. Sampling biases remain, but the stated asymptotic pattern and alternatives are distinguishable with standard methods.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit asymptotic and determinate growth models to long-term size-at-age data for ectotherms, especially fishes, and compare predictive fit and late-life growth estimates. Observed cessation at a fixed adult size or consistently superior non-asymptotic models would refute the generalization.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Apparent asymptotes may reflect selective disappearance rather than individual growth.", "Old individuals are under-sampled because of mortality and fishing.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.89"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-10--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-10--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FishBase";
    dc:description "Public von Bertalanffy growth parameters and maximum sizes for numerous fishes.";
    prov:wasDerivedFrom <https://www.fishbase.se/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-10--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NOAA Fisheries Data Catalog";
    dc:description "Public long-running fish surveys with age and size measurements.";
    prov:wasDerivedFrom <https://www.fisheries.noaa.gov/inport>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-10--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
