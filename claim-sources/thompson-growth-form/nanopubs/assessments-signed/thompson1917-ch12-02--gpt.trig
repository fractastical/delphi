<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-02--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch12-02: partially-resolvable, resolvability 0.51";
    dc:description "Accretion sequence and spiral geometry can be measured in existing specimens. Observational morphology alone has limited power to separate this mechanism from developmental alternatives.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct chamber-addition sequences from shell images and test whether exterior accretion with rigid retention predicts spiral trajectories better than alternative growth geometries. A consistent association between permanent external increments and spirality would support the claim, while abundant nonspiral shells under the same growth mode would weaken it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Taxonomic and developmental coverage of digitized shell interiors is uneven.", "The proposed condition may be permissive rather than sufficient.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-02--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-02--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.513"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
