sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-31--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-31: partially-resolvable, resolvability 0.55";
    dc:description "Curve features can be quantified, but the asserted equivalence is qualitative and spans unlike processes. Existing data permit comparisons in selected systems, not a decisive general test.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Normalize complete regeneration and whole-organism growth trajectories and compare their latent, accelerating, peak-velocity, and decelerating phases using shared versus separate curve families. Support requires a common curve structure across matched tissues or taxa; systematic phase or shape differences refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Same essential characteristics' permits multiple interpretations.", "Matched regeneration and zero-origin ontogeny data are rare.", "Normalization can conceal biologically important differences.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-31--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-31--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-31--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioImage Archive";
    dc:description "Time-lapse regeneration and development images can yield comparable growth trajectories.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/bioimage-archive/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-31--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "Open regeneration and ontogenetic-growth datasets can be assembled for model comparison.";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-31--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-31 by GPT-5.6 Sol: 0.55";
