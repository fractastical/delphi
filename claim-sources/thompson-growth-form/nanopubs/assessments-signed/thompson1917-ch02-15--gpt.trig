<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-15--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch02-15: partially-resolvable, resolvability 0.59";
    dc:description "The surface-to-volume consequence is straightforward to test with existing 3D images and standard segmentation. The mechanistic claim that division restores an energy balance is much less discriminating and usually lacks the necessary energetic data.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Segment cells through growth and division, calculate surface-area-to-volume ratios before and after cytokinesis, and test whether division restores a characteristic ratio without changing total volume. The geometric component is supported by an increased total surface and restored ratio, but the proposed energy-balance cause requires independent energetic measurements.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Geometry alone cannot identify surface-energy balance as the cause of division.", "Segmentation resolution limits true membrane surface estimates.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-15--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-15--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.595"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-15--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioImage Archive";
    dc:description "Time-lapse 3D microscopy of cell division and embryonic cleavage.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/bioimage-archive/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-15--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cell Image Library";
    dc:description "Public division imagery for cell geometry measurements.";
    prov:wasDerivedFrom <https://www.cellimagelibrary.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-15--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
