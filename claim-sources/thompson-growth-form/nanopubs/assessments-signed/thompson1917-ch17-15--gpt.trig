    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-15--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-15--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.935"^^xsd:double;
