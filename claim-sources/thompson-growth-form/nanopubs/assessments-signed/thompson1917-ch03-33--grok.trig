    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-33--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-33--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch03-33 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-33--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-33--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
