sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-33--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch03-33: partially-resolvable, resolvability 0.36";
    dc:description "The claim combines a physical instability with ordinary regeneration and uses taxonomic distribution as evidence. Body form and fission mode can be compiled for a subset of annelids and flatworms, which is enough for a partial test. The mechanical wavelength is rarely measured, and developmental control of the fission plane is an alternative that existing descriptions often favour without a clean force measurement.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Test whether fission in worm-like animals occurs at the wavelength predicted for breakup of a fluid cylinder of that diameter and viscosity, and whether fission tracks that geometry across unrelated groups rather than tracking clade. Agreement with the mechanical wavelength, including in close relatives of similar shape, would support the claim; fission at genetically fixed stations independent of tube dimensions would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fission position, body diameter and regeneration are not in one trait table.", "Regeneration after a cut is observable, but the 'tendency to segment' is not a separate measured force.", "Stereotyped fission planes in short flatworms already sit poorly with a pure fluid instability.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.52"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.363"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-33--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-33 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-33--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-33--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch03-33 by Grok 4.7: 0.3";
