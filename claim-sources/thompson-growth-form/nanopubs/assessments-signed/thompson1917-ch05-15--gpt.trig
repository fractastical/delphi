    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-15--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch05-15: partially-resolvable, resolvability 0.60";
    dc:description "Morphospace size and environmental plasticity are measurable with abundant images. The causal inference from limited forms to molecular control is confounded, and representative cross-scale sampling is not available.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify shape diversity across bacteria, protozoa, spores, and free cells and compare it with larger organisms after standardizing dimensionality and sampling; relate within-taxon changes to temperature, osmolarity, and material properties. The claim is supported if small-cell morphospace is consistently restricted and predictable from molecular-scale force models.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A 'limited range' needs a defined metric and null model.", "Molecular-force dominance is not implied by low diversity alone.", "Sampling effort differs radically between micro- and macro-organisms.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-15--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-15--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cell Image Library";
    dc:description "Public images across microorganisms and free cells can define empirical morphospace.";
    prov:wasDerivedFrom <https://www.cellimagelibrary.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-15--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
