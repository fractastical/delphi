<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch13-06: needs-new-data, resolvability 0.49";
    dc:description "The prediction is mathematically operational, but its crucial independent variable is a developing basal growth field. Final horn shapes alone cannot establish where growth maxima and minima lay.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure circumferential growth-rate fields at the horn base through time and test whether diametrically opposed extrema predict zero torsion while offset extrema predict a helical component. The predicted relationship across developing horns would support the law; discordant growth fields and trajectories would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Longitudinal developmental imaging of horn growth appears necessary.", "Public collections provide final form, not spatially resolved growth velocities.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-06--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.487"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch13-06--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Existing adult 3D geometry can characterize planar versus helical outcomes but not the required growth-rate field.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
