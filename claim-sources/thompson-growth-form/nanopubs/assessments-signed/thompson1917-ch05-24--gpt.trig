    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-24--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch05-24: resolvable-now, resolvability 0.86";
    dc:description "Surface geometry and osmotic shape changes map directly to standard measurements, and equilibrium models yield a decisive comparison. Existing public images are adequate to reject or support the surface-tension-only component, though they do not necessarily identify the exact alternative force.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct red-cell surfaces, compute mean curvature, and compare observed biconcave and osmotically swollen shapes with equilibrium surface-tension-only models and membrane-mechanics models.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Imaging preparation can distort curvature.", "The suggested cholesterin mechanism is less directly testable than rejection of surface tension alone.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-24--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-24--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-24--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EMPIAR";
    dc:description "Open electron and cryo-imaging data containing red-cell membrane morphology and ultrastructure.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/empiar/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-24--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cell Image Library";
    dc:description "Public red-blood-cell images under normal and altered osmotic conditions.";
    prov:wasDerivedFrom <https://www.cellimagelibrary.org/>.
