    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Shared development and ancestry also generate trait covariance.", "“New forces” and “isolated” require arbitrary definitions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-18--gpt--dataset-2>;
