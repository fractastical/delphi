    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch08-13: partially-resolvable, resolvability 0.72";
    dc:description "Cell shape and stomatal spatial order are standard image-derived variables, permitting a strong comparative test. Existing data can test the association in subsets, but the proposed minimal-partition mechanism and broad taxonomic contrast remain confounded.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across leaf epidermal images, quantify cell elongation and stomatal row order, testing whether oblong-cell tissues show stronger row alignment than polygonal-cell tissues and whether minimal partitions mediate the relation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Open images are not evenly sampled across monocots and dicots.", "Venation and developmental patterning can independently impose rows.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-13--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-13--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
