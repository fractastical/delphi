    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-14--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-14--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.736"^^xsd:double;
