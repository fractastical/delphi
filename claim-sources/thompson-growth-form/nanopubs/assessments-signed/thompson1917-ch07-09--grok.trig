sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch07-09: resolvable-now, resolvability 0.73";
    dc:description "The packing prediction can be scored with neighbour counts and angles on data that already exist for epithelia, comb and corals. The informative contrast is complete facial contact versus cylinders that only touch locally. That comparison is standard image analysis and is sufficient to confirm or refute the stated tendency, with the topological average kept in view as a bias.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Wherever similar cylinders or spheres are in complete surface contact, measure neighbour number and junction angle in section or surface view, and compare them with loose bundles that do not touch along faces. Complete contact yielding hexagons with angles near 120 degrees, and incomplete contact leaving round profiles, would support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Any trivalent tiling averages six sides, so neighbour number alone is a weak discriminator and angle plus completeness of contact have to carry the test.", "Scans and segmentations over-represent model plants, honeybees and a few coral colonies.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Arabidopsis shoot-meristem segmentations";
    dc:description "Close-packed meristem cells for neighbour counts and junction angles";
    prov:wasDerivedFrom <https://www.repository.cam.ac.uk/handle/1810/262530>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Honeycomb X-ray microscopy";
    dc:description "Three-dimensional bee comb, a close-packed hexagonal prism system in the claim's scope";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.z8w9ghxmw>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch07-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Public 3D scans of colonial corals and other packed biological bodies for contact versus cylindrical outlines";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch07-09 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch07-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch07-09 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
