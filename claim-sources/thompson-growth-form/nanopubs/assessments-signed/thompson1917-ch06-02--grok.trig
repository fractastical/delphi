sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch06-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch06-02: partially-resolvable, resolvability 0.56";
    dc:description "Interface siting is directly visible in histological and electron-microscopic series, and those series exist for a number of sponges and some radiolaria. They are scattered in papers rather than released as a single open table of spicule position against cell boundaries. The geometric association can be remeasured for the illustrated species, with the temporal-order confound left open.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In sponges and radiolaria, record whether mineral is laid down on cell or vacuole boundaries and whether spicule geometry follows those boundaries. Systematic siting on interfaces, with spicule branches tracking junction lines, would support the claim; intracellular initiation away from boundaries would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A static section cannot tell whether the boundary preceded the spicule or formed around it.", "Isolated-spicule collections omit the cells and vacuoles whose boundaries are the claimed template.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.563"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch06-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch06-02 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-02--grok>.
