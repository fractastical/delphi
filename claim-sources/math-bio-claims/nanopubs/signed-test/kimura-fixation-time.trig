sub:assertion {
<https://w3id.org/delphi/resource/claim/kimura-fixation-time> a <https://w3id.org/delphi/ontology/Claim>, <https://w3id.org/delphi/ontology/TestableHypothesis>;
    dc:description "A neutral mutant that does go to fixation takes on average about four times the effective population size, in generations, to do so.";
    dc:source "Motoo Kimura (1969) The average number of generations until fixation of a mutant gene in a finite population";
    <http://www.w3.org/2000/01/rdf-schema#label> "Mean time to fixation of a neutral mutant";
    <http://www.w3.org/2004/02/skos/core#notation> "\\bar{t}_1(p) = -\\frac{4N_e(1-p)\\ln(1-p)}{p}; as p = 1/(2N) \\to 0, \\bar{t}_1 \\to 4N_e generations";
    <https://w3id.org/delphi/ontology/context> "Assumptions: diffusion approximation to the Wright-Fisher model, neutrality, constant N_e. Formal status: proved within the diffusion limit (Kimura and Ohta 1969).";
    <https://w3id.org/delphi/ontology/hypothesisType> "model-theorem";
    <https://w3id.org/delphi/ontology/proposedTest> "In replicate small populations of known N_e, record the conditional time to fixation of neutral marker alleles and compare it with 4N_e generations."
}
