sub:assertion {
  <https://w3id.org/delphi/resource/claim/aristotle-ha06-15> a delphi:Claim ;
    rdfs:label "The smooth shark's embryo is nourished by a cord attached to the womb" ;
    dct:description "In the smooth shark the young develop with a navel-string attached to the womb, so that once the yolk is used up the embryo is sustained as in quadrupeds, with a chorion and membranes." ;
    delphi:context "Aristotle, The History of Animals (Historia Animalium), Book VI, Part 10; translated by D'Arcy Wentworth Thompson, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. IV (1910). Scope: smooth-hound (Mustelus mustelus)" ;
    dct:type "empirical-generalization" .
}

