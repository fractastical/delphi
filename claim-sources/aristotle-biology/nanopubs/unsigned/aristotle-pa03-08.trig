sub:assertion {
  <https://w3id.org/delphi/resource/claim/aristotle-pa03-08> a delphi:Claim ;
    rdfs:label "No horned animal has front teeth in the upper jaw" ;
    dct:description "No horned animal has front teeth in both jaws; the upper front teeth are lacking, because the material taken from the teeth is added to the horns." ;
    delphi:context "Aristotle, On the Parts of Animals (De Partibus Animalium), Book III, Part 2; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: horned mammals (bovids, deer and other ruminants)" ;
    dct:type "empirical-generalization" .
}

