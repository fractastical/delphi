sub:assertion {
  <https://w3id.org/delphi/resource/claim/aristotle-ga03-17> a delphi:Claim ;
    rdfs:label "Eggs fertilised by one cock take on the nature of a later cock" ;
    dct:description "Eggs already impregnated by one cock change to the nature of a second cock that treads the hen later, provided this happens before the white separates from the yolk." ;
    delphi:context "Aristotle, On the Generation of Animals (De Generatione Animalium), Book III; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: domestic fowl and other birds" ;
    dct:type "empirical-generalization" .
}

