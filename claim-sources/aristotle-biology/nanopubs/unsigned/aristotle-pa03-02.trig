    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "Nature allots each weapon, offensive and defensive alike, to those animals alone that can use it; or, if not to them alone, to them in a more marked degree; and she allots it in its most perfect state to those that can use it best" ;
