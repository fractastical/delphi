sub:assertion {
  <https://w3id.org/delphi/resource/claim/aristotle-pa03-02> a delphi:Claim ;
    rdfs:label "Nature gives each weapon only, or most fully, to animals that can use it" ;
    dct:description "Nature allots each offensive or defensive weapon (sting, spur, horn, tusk) only, or in a more developed form, to the animals that can use it, and in its most perfect form to those that can use it best." ;
    delphi:context "Aristotle, On the Parts of Animals (De Partibus Animalium), Book III, Part 1; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: all animals with weapons" ;
    dct:type "conceptual" .
}

