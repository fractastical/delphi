sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ha09-16> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Before its young are fledged the sea-eagle makes them stare at the sun, beats any that refuse, and kills one whose eyes water.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "The sea-eagle makes its young stare at the sun and kills those that cannot";
    <https://w3id.org/delphi/ontology/context> "Aristotle, The History of Animals (Historia Animalium), Book IX, Part 34; translated by D'Arcy Wentworth Thompson, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. IV (1910). Scope: sea-eagle (white-tailed eagle or osprey)"
}
