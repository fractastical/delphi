sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa01-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Among ants some fly and others do not, so Flying versus Walking cannot be used to divide animal kinds.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Some ants fly and others do not";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book I, Part 3; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: ants"
}
