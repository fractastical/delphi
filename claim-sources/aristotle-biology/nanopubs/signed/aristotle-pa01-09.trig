sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa01-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Animals within one class differ only by degree (more and less of the same part), while different classes agree only in having analogous organs, as the bird's feather corresponds to the fish's scale.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Within a class animals differ by degree; across classes their parts are only analogous";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book I, Part 4; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: birds and fishes as examples of classes"
}
