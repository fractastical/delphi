sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa02-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Blood is the final nutritive material of the body in animals that have it; it diminishes in quantity when no food is taken, increases when much is eaten, and is healthy or unhealthy according to the food.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Blood is the final nutriment and its quantity follows food intake";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book II, Part 3; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: animals with blood; in bloodless animals the analogous fluid"
}
