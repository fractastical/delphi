sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga02-18> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "When different kinds are crossed, the first cross resembles both parents, but over successive generations the offspring come to resemble the female in form.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Hybrids come to resemble the female line over successive generations";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book II; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: Crosses between related kinds (fox and dog, partridge and fowl), possible when gestation, breeding season and size are similar"
}
