sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa04-10> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Nature passes from lifeless things to animals in an unbroken sequence, with living things that are not animals between them, so that neighbouring groups scarcely differ.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Nature passes from lifeless things to animals by unbroken gradation";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book IV, Part 5; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: all living things: plants, sponges, ascidians, animals"
}
