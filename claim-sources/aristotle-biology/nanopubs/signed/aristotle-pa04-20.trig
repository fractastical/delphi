sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa04-20> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "All female quadrupeds urinate backwards, while among males only a few do so, such as the lynx, lion, camel and hare; no solid-hoofed quadruped urinates backwards.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "All female quadrupeds urinate backwards; only a few males do";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book IV, Part 10; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: quadrupeds; lynx, lion, camel, hare"
}
