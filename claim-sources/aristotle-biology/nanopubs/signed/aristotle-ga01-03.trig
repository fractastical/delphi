sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga01-03> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The male and female are the first principles of generation: the male supplies the efficient (moving) cause and the female supplies the material.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "The male supplies the efficient cause of generation, the female the material";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book I, Part 2; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: All animals with two sexes"
}
