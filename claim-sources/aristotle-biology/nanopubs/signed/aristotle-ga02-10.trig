sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga02-10> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The parts of an embryo do not all exist from the start; some are visible in the embryo while others are not yet formed, so they come into being in succession.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Embryonic parts form in succession, not all together";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book II; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: Animal embryos"
}
