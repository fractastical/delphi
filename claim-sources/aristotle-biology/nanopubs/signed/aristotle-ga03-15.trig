sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga03-15> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Fish are not conceived by the female swallowing the male's milt, because the passage from the mouth leads to the intestine, not the uterus.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Female fish do not conceive by swallowing milt";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book III; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: fishes"
}
