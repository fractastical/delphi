sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa04-30> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The wryneck is the only bird whose toes are arranged two in front and two behind; all other birds have three in front and one behind.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Only the wryneck has two toes in front and two behind";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book IV, Part 12; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: birds; the wryneck (Jynx torquilla)"
}
