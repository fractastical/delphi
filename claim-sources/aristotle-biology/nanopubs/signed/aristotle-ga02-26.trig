sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga02-26> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The eyes of all animals, whether walking, swimming or flying, appear very large from the beginning of development but are the last parts to be completely formed, collapsing in the interval.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Eyes appear very large early but are the last parts to be completed";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book II; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: Embryos of vertebrates"
}
