sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ha09-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Many quadrupeds treat their own ailments: dogs, when ill, eat a kind of grass that makes them vomit.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Sick animals treat themselves, e.g. dogs eat grass to vomit";
    <https://w3id.org/delphi/ontology/context> "Aristotle, The History of Animals (Historia Animalium), Book IX, Part 6; translated by D'Arcy Wentworth Thompson, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. IV (1910). Scope: quadrupeds, with dogs as the stated case"
}
