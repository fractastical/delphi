sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga02-30> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Of all the bones, the teeth alone go on growing throughout life, as shown by teeth that grow out of line until they no longer meet.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Of all bones only the teeth grow throughout life";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book II; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: Animals with bones and teeth"
}
