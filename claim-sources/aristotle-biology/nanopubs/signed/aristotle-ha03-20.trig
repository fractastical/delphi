<https://w3id.org/delphi/resource/claim/aristotle-ha03-20> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In many places the drinking water is of such a quality that rams that drink it before mating beget black lambs.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Drinking water can make rams beget black lambs";
