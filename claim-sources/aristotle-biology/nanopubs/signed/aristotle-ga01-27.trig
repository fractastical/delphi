sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga01-27> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Among the viviparous animals females are smaller than males, because the secretion that would build the body is discharged as menstrual fluid, and this is the only class that menstruates.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Among viviparous animals females are smaller because of menstruation";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book I, Part 19; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: Viviparous animals (mammals), especially humans"
}
