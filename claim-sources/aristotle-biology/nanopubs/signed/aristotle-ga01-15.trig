sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga01-15> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The arm that the male octopus inserts into the female's funnel serves only for attachment and is not an organ useful for generation, being outside the male's seminal passage.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "The octopus arm inserted in the female's funnel is not a generative organ";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book I, Part 15; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: Octopus (poulp) and other cephalopods with a hectocotylus"
}
