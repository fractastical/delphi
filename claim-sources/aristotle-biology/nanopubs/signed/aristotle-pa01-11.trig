sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa01-11> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "As each instrument serves some action, the body is made for the soul and each part of the body for some subordinate function to which it is adapted.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "The body exists for the soul and each part for its function";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book I, Part 5; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: all animals and their parts"
}
