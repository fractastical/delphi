sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ha09-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Animals that live in the same localities or feed on the same food are enemies, and when food runs short animals of the same kind fight one another.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Animals sharing a locality or food are enemies";
    <https://w3id.org/delphi/ontology/context> "Aristotle, The History of Animals (Historia Animalium), Book IX, Part 1; translated by D'Arcy Wentworth Thompson, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. IV (1910). Scope: animals in general, intra- and interspecific"
}
