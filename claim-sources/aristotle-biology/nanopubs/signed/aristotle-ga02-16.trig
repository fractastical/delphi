sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-ga02-16> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In some cartilaginous fishes, once the nutriment of the egg is used up, the embryo completes its development by connection with the uterus, so the egg is not released from the uterus.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Some cartilaginous fishes complete development by connection to the uterus";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Generation of Animals (De Generatione Animalium), Book II; translated by Arthur Platt, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: Selachians (cartilaginous fishes), e.g. placental sharks such as the smooth dogfish"
}
