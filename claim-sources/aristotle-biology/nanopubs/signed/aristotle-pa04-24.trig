sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa04-24> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Oviparous quadrupeds have no upper eyelid and close the eye with the lower lid, as birds do.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Oviparous quadrupeds have no upper eyelid and close the eye with the lower";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book IV, Part 11; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: oviparous quadrupeds (lizards, tortoises, crocodiles) and birds"
}
