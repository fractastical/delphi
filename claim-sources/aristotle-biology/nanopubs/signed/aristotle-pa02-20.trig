sub:assertion {
<https://w3id.org/delphi/resource/claim/aristotle-pa02-20> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In all crustaceans and testaceans the fleshy substance is within and the hard earthy matter is outside, and the shell both holds the soft parts together and keeps in their scanty natural heat.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Crustaceans and testaceans have their hard supporting part outside";
    <https://w3id.org/delphi/ontology/context> "Aristotle, On the Parts of Animals (De Partibus Animalium), Book II, Part 8; translated by William Ogle, The Works of Aristotle Translated into English, ed. J. A. Smith and W. D. Ross, Oxford: Clarendon Press, vol. V (1912). Scope: crustaceans (crabs, spiny lobsters) and testaceans (shelled molluscs such as oysters)"
}
