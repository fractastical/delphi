{
  "name": "aristotle-biology",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claims from Aristotle's History of Animals, Parts of Animals and Generation of Animals (Oxford translation, 1910-1912), with dataset-resolvability assessments.",
  "scripts": {
    "fetch": "python3 build/fetch.py",
    "merge": "node build/merge.mjs",
    "generate": "node build/generate.mjs",
    "batches": "node build/make-batches.mjs",
    "merge-assessments": "node build/merge-assessments.mjs",
    "generate-assessments": "node build/generate-assessments.mjs",
    "publish:test": "node build/publish.mjs --registry test"
  },
  "dependencies": {
    "@nanopub/nanopub-js": "^0.4.0",
    "n3": "^1.26.0"
  }
}
