sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch09-05> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The chief cause of the imperfection of the geological record is that successive geological formations are separated from each other by wide intervals of time during which no record was left.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Successive formations are separated by wide intervals of unrecorded time";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter IX, “On the Imperfection of the Geological Record”; section “On the intermittence of geological formations”. Scope: sedimentary geological record worldwide"
}
