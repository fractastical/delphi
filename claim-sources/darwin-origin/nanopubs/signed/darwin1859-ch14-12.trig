sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch14-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Since all living forms are lineal descendants of forms that lived long before the Silurian epoch, the ordinary succession by generation has never once been broken and no cataclysm has ever desolated the whole world.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Succession by generation has never been broken by a world-wide cataclysm";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter XIV, “Recapitulation and Conclusion”; section “Concluding remarks”. Scope: the history of life on earth"
}
