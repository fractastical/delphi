sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch01-17> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Among the causes of change in domestic races, including conditions of life, use and disuse, correlation and crossing, the accumulative action of selection, whether methodical or unconscious, is by far the predominant power.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Accumulative selection is the predominant cause of change in domestic races";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter I, “Variation under Domestication”; section “Summary”. Scope: domesticated animals and cultivated plants"
}
