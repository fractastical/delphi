sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch10-14> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "All fossils can be classed in existing groups or between them, and extinct forms fill up the wide intervals between existing genera, families and orders, forming with living forms one natural system.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Extinct forms fill gaps between existing genera, families and orders";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter X, “On the Geological Succession of Organic Beings”; section “On the affinities of extinct species to each other and to living species”. Scope: all extinct and living organisms"
}
