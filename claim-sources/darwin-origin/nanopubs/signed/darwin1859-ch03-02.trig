sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch03-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The extraordinarily rapid increase and wide spread of introduced (naturalised) animals and plants in new countries is explained by geometrical increase under favourable conditions with reduced mortality, not by any rise in their fertility.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Geometrical increase explains rapid spread of naturalised species";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter III, “Struggle for Existence”; section “Rapid increase of naturalised animals and plants”. Scope: introduced and feral animals and plants"
}
