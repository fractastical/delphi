sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch01-02> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The greater variability of domestic productions is due to their being raised under conditions of life less uniform than, and somewhat different from, those of their parent species in nature.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Greater domestic variability is caused by changed, less uniform conditions";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter I, “Variation under Domestication”; section “Causes of Variability”. Scope: domesticated animals and cultivated plants"
}
