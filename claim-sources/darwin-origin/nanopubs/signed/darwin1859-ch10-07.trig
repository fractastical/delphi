sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch10-07> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Species and groups of species generally become extinct gradually, one after another, disappearing first from one place, then another, and finally from the world, rather than being swept away together by catastrophes.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Species and groups disappear gradually, place by place, not by global catastrophes";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter X, “On the Geological Succession of Organic Beings”; section “On Extinction”. Scope: extinction of species and groups, especially in the Tertiary"
}
