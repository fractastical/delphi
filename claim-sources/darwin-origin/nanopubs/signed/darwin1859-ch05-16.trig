sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch05-16> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "The domestic horse, ass, hemionus, quagga and zebra are descended from a common ancestor that was striped like a zebra, which explains the occasional appearance of stripes in horses, asses and their hybrids.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Horse, ass, hemionus, quagga and zebra descend from a striped common ancestor";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter V, “Laws of Variation”; section “Reversions to long-lost characters.”. Scope: genus Equus"
}
