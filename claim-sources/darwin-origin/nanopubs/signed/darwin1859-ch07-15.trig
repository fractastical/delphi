sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch07-15> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Closely allied but distinct species living in distant parts of the world under different conditions often retain nearly the same instincts, which is explained by inheritance from a common ancestor.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Allied species in distant regions retain nearly the same instincts";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter VII, “Instinct”; section “Summary”. Scope: allied animal species in different geographical regions (e.g. thrushes, wrens)"
}
