sub:assertion {
<https://w3id.org/delphi/resource/claim/darwin1859-ch10-17> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Because each new species arose by having some advantage over preceding forms, a more recent fauna or flora would beat and exterminate an older one if they were placed in competition under a similar climate, and in this sense recent forms are higher.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Later faunas would outcompete earlier faunas under similar conditions";
    <https://w3id.org/delphi/ontology/context> "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter X, “On the Geological Succession of Organic Beings”; section “On the state of development of ancient forms”. Scope: faunas and floras of successive geological periods"
}
