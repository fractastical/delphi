sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-12> a delphi:Claim ;
    rdfs:label "North American and European temperate biotas share ancestry from Pliocene circumpolar land" ;
    dct:description "The relationship, with very little identity, between the temperate inhabitants of North America and Europe arises because a common biota inhabited the nearly continuous circumpolar land in warmer Pliocene times and then migrated southward, becoming separated and modified on each continent." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter XI, “Geographical Distribution”; section “Dispersal during the Glacial period co-extensive with the world”. Scope: temperate plants and animals of North America and Europe" ;
    dct:type "historical-inference" .
}

