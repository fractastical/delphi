sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch03-10> a delphi:Claim ;
    rdfs:label "Chains of interaction link distant species' abundances" ;
    dct:description "Very different organisms are linked by chains of interaction, so that the abundance of one species can determine the frequency of another through intermediate species; for example, cats may control the frequency of red clover and heartsease by way of field-mice and humble-bees." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter III, “Struggle for Existence”; section “Complex relations of all animals and plants throughout nature”. Scope: terrestrial communities of plants, pollinators, and their predators" ;
    dct:type "mechanism" .
}

