    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch04-03> a delphi:Claim ;
    rdfs:label "No native biota is so well adapted that it cannot be improved" ;
    dct:description "No country's native inhabitants are so perfectly adapted that none could be improved, as shown by introduced species having established firmly in every country." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter IV, “Natural Selection”; section “Natural Selection: its power compared with man’s selection, its power on characters of trifling importance, its power at all ages and on both sexes”. Scope: native biotas of all countries and regions" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <http://www.wikidata.org/entity/Q20968204> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-darwin-origin-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "No country can be named in which all the native inhabitants are now so perfectly adapted to each other and to the physical conditions under which they live, that none of them could anyhow be improved; for in all countries, the natives have been so far conquered by naturalised productions, that they have allowed foreigners to take firm possession of the land." ;
    prov:wasQuotedFrom <http://www.wikidata.org/entity/Q20968204> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/1228/pg1228.txt#line=2721,2727> .

