sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch06-10> a delphi:Claim ;
    rdfs:label "Selection can independently produce similar organs in distantly related beings" ;
    dct:description "Natural selection, acting on analogous variations, has sometimes modified parts in nearly the same way in two distantly related organisms, as with electric organs in unrelated fishes, so that similar organs need not be inherited from a common ancestor." ;
    delphi:context "Charles Darwin, On the Origin of Species (1st ed., London: John Murray, 1859), Chapter VI, “Difficulties on Theory”; section “Cases of difficulty.”. Scope: electric fishes, luminous insects, orchids and Asclepias, and other cases of similar organs in remote groups" ;
    dct:type "mechanism" .
}

