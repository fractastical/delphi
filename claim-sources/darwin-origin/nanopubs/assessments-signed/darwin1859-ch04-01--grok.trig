    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok>.
<https://w3id.org/delphi/resource/claim/darwin1859-ch04-01> <https://w3id.org/delphi/ontology/hasAssessment> <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--analysis-feasibility>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--data-adequacy>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--data-existence>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--discriminating-power>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--operationalizability>
