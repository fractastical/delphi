sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-01: partially-resolvable, resolvability 0.51";
    dc:description "Superfecundity and the removal of deleterious alleles are measurable, and open demographic and genomic resources support standard tests of both. The preservation of favourable variation is only weakly separable from the definition of a favourable variant, so many outcomes are compatible with the wording either as a mechanism or as a tautology. Existing data therefore test pieces of the statement in a few well-studied organisms rather than the universal process as named.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate the distribution of fitness effects from allele-frequency spectra, and estimate surplus offspring from life tables. Purifying selection would be confirmed if deleterious alleles are systematically rarer than neutral alleles and if populations produce far more offspring than survive; the differential-success clause would be refuted if fitness effects did not predict frequency change. The sentence that names this process natural selection has no separate measurement.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "An advantage defined as higher survival or reproduction makes the central clause close to a definition of fitness.", "Life tables show excess births without identifying which heritable differences selection retains.", "Population-genomic samples are concentrated in humans and model organisms.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.511"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: gnomAD";
    dc:description "human allele frequencies and constraint metrics for deleterious variants";
    prov:wasDerivedFrom <https://gnomad.broadinstitute.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: COMPADRE & COMADRE";
    dc:description "stage-structured fecundity and survival matrices for plants and animals";
    prov:wasDerivedFrom <https://compadre-db.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: LTEE";
    dc:description "frequency trajectories of mutations with small fitness effects in experimental E. coli";
    prov:wasDerivedFrom <https://the-ltee.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-01 by Grok 4.7: 0.68";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.68"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-01 by Grok 4.7: 0.38";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.38"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch04-01 by Grok 4.7: 0.74";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.74"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of darwin1859-ch04-01 by Grok 4.7: 0.34";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-discriminating-power>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.34"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of darwin1859-ch04-01 by Grok 4.7: 0.4";
