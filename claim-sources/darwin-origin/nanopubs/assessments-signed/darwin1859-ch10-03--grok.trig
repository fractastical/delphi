    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-03--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch10-03--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
