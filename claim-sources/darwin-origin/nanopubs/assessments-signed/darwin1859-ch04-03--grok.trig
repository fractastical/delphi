sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-03--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-03: partially-resolvable, resolvability 0.72";
    dc:description "Whether non-native species have established in every country is a direct count, and global plant inventories already support it at high coverage. The further inference, that natives were therefore imperfectly adapted and could be improved, is not identified by establishment: several ecological alternatives predict the same lists. A small team could settle the biogeographic pattern quickly and would still lack a clean test of perfect adaptation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For each country or flora, count established non-native species and the fraction of the biota they represent. Universal establishment would confirm the naturalisation pattern Darwin treats as evidence; absence of established non-natives from many regions would refute that pattern. Establishment itself would not confirm that native populations could have been improved by selection, because enemy release and disturbance produce the same invasions.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Animal naturalizations are less completely tabulated than plants.", "Firm possession is a qualitative threshold that checklists do not measure directly.", "Invasion success also follows propagule pressure, disturbance, and release from enemies.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-03--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-03--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.722"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-03--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GloNAF";
    dc:description "regional lists of naturalized alien plants";
    prov:wasDerivedFrom <https://glonaf.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-03--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Invasive Species Database";
    dc:description "established non-native species, including animals, by region";
    prov:wasDerivedFrom <https://www.iucngisd.org/gisd/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-03--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
    dc:description "occurrence evidence that non-native taxa persist in each country";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-03--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-03 by Grok 4.7: 0.82";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.82"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-03--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-03--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-03 by Grok 4.7: 0.74";
