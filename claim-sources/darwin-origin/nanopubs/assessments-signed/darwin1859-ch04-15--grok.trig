sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-15: partially-resolvable, resolvability 0.60";
    dc:description "Range, area, and diversification rate can be assembled from public phylogenies and occurrence or flora databases for major terrestrial groups. Small isolated areas and large continents differ in age and sampling, so a higher continental rate is not a clean reading of faster modification. The analysis can test a restricted biogeographic proxy and would take substantial harmonization of origins and clade ages.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare speciation rate, geographic range, and richness of descendant clades between lineages inferred to have originated on large landmasses and those from islands or small regions. Faster diversification and wider ranges for large-area clades would support the claim; equal or higher rates for small-area clades, after clade age and sampling effort, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Area, island age, isolation, and collecting effort are entangled.", "The place of origin of a clade is often ambiguous once it has spread.", "Vertebrates and plants are far better covered than terrestrial invertebrates.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-15--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-15--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.604"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
    dc:description "occurrence-derived range sizes for terrestrial species";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-15--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: VertLife";
    dc:description "dated phylogenies for estimating diversification of continental and island clades";
    prov:wasDerivedFrom <https://vertlife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-15--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GIFT";
    dc:description "island and mainland floras for comparing area and endemic richness";
    prov:wasDerivedFrom <https://gift.uni-goettingen.de/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-15 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-15--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-15--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-15 by Grok 4.7: 0.5";
