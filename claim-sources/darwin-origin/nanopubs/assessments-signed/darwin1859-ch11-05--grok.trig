sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch11-05: partially-resolvable, resolvability 0.39";
    dc:description "The contrast between a co-immigrating assemblage and a singleton colonist is a real comparative prediction, but the arrival mode is not a column in open databases. Trees and ranges support case studies of a few radiations. They do not separate isolation from the other variables that change on islands, so discriminating power stays low.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare morphological or genetic divergence of species that entered an isolated region together, as an already competing set, with divergence of species that arrived alone into new biotic relationships. The claim predicts little change in the first case and more change in the second.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Relevant comparisons are spread across separate phylogeographic studies.", "Time since arrival and population size vary with isolation and can produce the same divergence pattern.", "Whether colonists arrived together or alone is rarely recorded in a database.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-05--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.39"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "Branch lengths of island and continental clades as a proxy for amount of modification";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "Co-occurrence of colonists used to approximate which species arrived into the same biota";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch11-05 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch11-05 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
