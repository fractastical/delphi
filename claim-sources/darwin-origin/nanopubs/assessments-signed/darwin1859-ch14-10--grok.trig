sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch14-10: needs-new-data, resolvability 0.32";
    dc:description "Gradual acquisition would be testable if comparable cognitive scores existed across a phylogeny, and they do not exist as a public dataset. Scattered experiments and endocranial volumes cover a few faculties in a few clades and leave 'each mental power' unmeasured. Until those scores are collected on a common scale, the analysis cannot confirm or refute the claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On a phylogenetic tree, score each mental capacity on a common ordinal scale across animals and humans and test whether every capacity appears by intermediate stages rather than in a single jump. The claim is confirmed if each capacity has precursor states in related organisms or in the archaeological and fossil record, and refuted by a capacity whose first appearance has no structural or behavioral intermediate.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A missing intermediate can always be assigned to an untested or extinct species, which weakens refutation.", "Brain-size and archaeological records do not resolve particular faculties such as language or abstraction.", "Mental capacities are not measured on one scale across taxa, so published experiments cannot be stacked into a single analysis.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.5"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.32"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch14-10 by Grok 4.7: 0.3";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.3"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-10--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch14-10 by Grok 4.7: 0.25";
