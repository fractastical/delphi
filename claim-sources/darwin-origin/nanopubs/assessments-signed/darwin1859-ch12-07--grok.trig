sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch12-07: partially-resolvable, resolvability 0.58";
    dc:description "Island woodiness relative to mainland relatives is recoverable from trait databases and floras for many clades. Separating colonization by woody lineages from change after arrival needs a tree and is only partly assembled. The adaptive story about stature under selection is an interpretation of that pattern, so the data resolve the comparative prediction more than the mechanism.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare growth form of island endemics with their closest mainland relatives and ask whether shifts from herb to shrub or tree are concentrated on oceanic islands that lacked tree colonists in that clade. Woodiness that arrived already evolved on the mainland would fail the in-situ selection scenario.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ancestral growth form and sister-species pairs are not stored as one global analysis table.", "The selection mechanism is stronger than the woodiness pattern alone.", "Woody colonists establishing more easily than herbs imitates evolution of woodiness after arrival.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.585"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TRY Plant Trait Database";
    dc:description "Woodiness and growth form of island and mainland species";
    prov:wasDerivedFrom <https://www.try-db.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Inventory of Floras and Traits";
    dc:description "Island floras linked to growth-form traits";
    prov:wasDerivedFrom <https://gift.uni-goettingen.de/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-07--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "Sister-group relationships used to tell in-situ change from arrival of already woody plants";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch12-07 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch12-07 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-07--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
