sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch14-07: resolvable-now, resolvability 0.73";
    dc:description "Turnover and radiometric duration are both public variables, and a positive controlled correlation is a direct test of using organic change as a clock. Occurrence databases and the numerical time scale cover the Phanerozoic well enough for a global marine test, with coarser coverage of terrestrial formations. Sampling and facies are serious confounds and are also standard covariates in this analysis, which a small team can run.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Between consecutive formations, measure faunal dissimilarity and the radiometrically dated time span, controlling for rock volume and collection effort. The claim is confirmed if organic turnover increases with elapsed time closely enough to rank the lengths of gaps, and refuted if turnover is uncorrelated with dated duration once sampling and facies are controlled.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A change of facies or of collecting effort can produce faunal turnover within a short span of time.", "Formations are local, and 'consecutive' units on different continents are not a single global clock.", "The claim already calls the measure imperfect, so only a weak or absent correlation with radiometric duration would refute it.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-07--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.735"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Fossil occurrences by formation for measuring organic dissimilarity between consecutive units.";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Macrostrat";
    dc:description "Rock units, gaps and sampled sedimentary volume used to control the comparison.";
    prov:wasDerivedFrom <https://macrostrat.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-07--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: International Commission on Stratigraphy";
    dc:description "The numerical geologic time scale that supplies elapsed time independent of the fossils.";
    prov:wasDerivedFrom <https://stratigraphy.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch14-07 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch14-07 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
