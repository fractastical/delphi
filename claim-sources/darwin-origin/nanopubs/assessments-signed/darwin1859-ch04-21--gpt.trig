<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-21--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch04-21: resolvable-now, resolvability 0.76";
    dc:description "Taxonomic dispersion in local communities is directly measurable with broad public data and standard null models. The empirical generalization can be resolved even though its proposed competitive explanation is less secure.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare observed genus- and order-level diversity within standardized small plots to null communities preserving richness and regional species pools. Consistent phylogenetic overdispersion and higher coexistence among distant taxa support the claim; clustering or null structure refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Co-occurrence does not prove that listed organisms compete most closely.", "Plot grain and regional-pool choice affect null-model results.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-21--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-21--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-21--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-21--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "taxonomically resolved local occurrence assemblages";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-21--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
