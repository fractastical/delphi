    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch12-03: partially-resolvable, resolvability 0.65";
    dc:description "Movement, occurrence, and experimental data can demonstrate feasibility and test selected systems. They are less adequate for assigning a globally dominant causal share to waterbirds.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Link waterbird movement networks with viable seeds or invertebrate eggs recovered from plumage, feet, or digestive tracts and compare resulting connectivity with freshwater species genetic structure. Support requires bird-mediated routes to explain most long-distance colonization better than wind, water, or human transport.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Distribution congruence does not identify the vector.", "The claim that birds are the main cause requires quantitative data for rival vectors.", "Transport events are rare and seldom observed directly.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-03--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-03--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.653"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-03--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Movebank";
    dc:description "movement tracks of freshwater birds";
    prov:wasDerivedFrom <https://www.movebank.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-03--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
    dc:description "freshwater organism and bird occurrences";
