sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-19--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-19: partially-resolvable, resolvability 0.55";
    dc:description "Relatedness and co-occurrence can be combined for plants and for better-known fossil clades, which is a real but partial design. The prediction is close to Darwin's naturalization hypothesis and can be scored with existing floras and trees. Competition is inferred from overlap and decline, and those patterns have other causes, so the test is informative mainly as a comparative proxy.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: When a form expands or a non-native species establishes, compare the decline of closest relatives with the decline of distant co-occurring taxa, in fossils and in modern assemblages. Greater impact on sister lineages would confirm the claim; impact that is independent of relatedness, or stronger on distant natives, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Co-occurrence and replacement are not direct measures of competition.", "Fossil sister-species pairs are rarely resolved.", "Invasions often hit naive distant taxa harder than close relatives, which cuts against a simple test.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-19--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-19--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-19--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.553"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-19--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "stratigraphic replacement among related fossil taxa";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-19--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "relatedness of expanding forms and the species they overlap";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-19--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GloNAF";
    dc:description "naturalized plants used as a modern analogue of new forms entering a flora";
    prov:wasDerivedFrom <https://glonaf.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-19--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-19 by Grok 4.7: 0.54";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.54"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-19--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-19--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
