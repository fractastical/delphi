<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-01--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch06-01: partially-resolvable, resolvability 0.57";
    dc:description "Selected fossil series can test temporal replacement, but preservation and ancestry uncertainty are substantial. Existing data rarely distinguish extinction by competitive species formation from coincident turnover.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In densely sampled lineage series, test whether appearance and improvement of derived forms precede decline and disappearance of inferred parents and intermediates. A repeated temporal replacement pattern supports the prediction; long coexistence or ancestor persistence refutes its generality.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Direct ancestors and transitional varieties are hard to identify.", "Replacement can be driven by environment rather than new-form competition.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-01--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-01--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-01--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.57"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-01--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "stratigraphic occurrences of putative lineage sequences";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-01--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
