<https://w3id.org/delphi/resource/assessment/darwin1859-ch13-09--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch13-09: partially-resolvable, resolvability 0.53";
    dc:description "Parts of the proposed expansion-and-replacement mechanism are testable in well-sampled fossil groups. Explaining the entire hierarchy of life from that mechanism is underdetermined and data coverage is uneven.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define dominance by abundance, range and species richness, then use fossil time series to test whether dominant clades preferentially diversify while smaller clades decline, and whether this process predicts concentration into few high-level groups. Support requires temporal replacement rather than merely present-day imbalance.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dominant and feeble are ambiguous and potentially circular.", "Few high ranks may partly reflect classification conventions.", "Fossil sampling strongly affects apparent diversity and replacement.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-09--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.53"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-09--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "clade diversity, occurrence and extinction through time";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-09--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
