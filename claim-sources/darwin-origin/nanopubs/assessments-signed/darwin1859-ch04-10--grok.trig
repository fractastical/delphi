sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-10: partially-resolvable, resolvability 0.67";
    dc:description "Because the wording is exclusive, documented large-effect adaptations and polyploid origins in public genetic and chromosomal databases are directly relevant and do not require a survey of every organism. How small a modification must be before it counts as infinitesimal is contested, which blocks a single decision threshold. The data can challenge the strict exclusion of sudden large change and still leave a gradualist, polygenic reading standing.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compile the effect sizes of alleles that have contributed to retained adaptive change, and the frequency of polyploid and other macromutational origins. The strict reading would be confirmed only if preserved adaptations are overwhelmingly built from tiny-effect steps. It would be refuted if large-effect alleles or whole-genome duplications repeatedly constitute the inherited change that is kept.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A large-effect allele can still be followed by a long series of small modifiers.", "GWAS and QTL samples are biased toward large effects and toward crops, livestock, and humans.", "Infinitesimally small can be read as a population-genetic limit or as a ban on large mutations, and those readings diverge.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.666"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GWAS Catalog";
    dc:description "effect sizes of trait-associated variants";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/gwas/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Chromosome Counts Database";
    dc:description "chromosome numbers used to identify polyploid shifts";
    prov:wasDerivedFrom <https://ccdb.tau.ac.il/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Animal QTLdb";
    dc:description "mapped loci of large and small effect on domesticated animal traits";
    prov:wasDerivedFrom <https://www.animalgenome.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-10 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-10 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch04-10 by Grok 4.7: 0.74";
