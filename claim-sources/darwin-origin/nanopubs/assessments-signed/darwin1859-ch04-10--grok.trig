    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.68"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
