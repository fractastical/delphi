<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch12-09: resolvable-now, resolvability 0.82";
    dc:description "Island mammal lists and shoreline geography are public, and the 300-mile threshold is an explicit cutoff. Excluding bats and domestic animals matches the claim's own scope. Disputed native status affects a handful of cases and can be treated as a sensitivity check around an otherwise direct test.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure each island's minimum distance to a continent or large continental island and record whether it has a native non-flying terrestrial mammal. A confirmed native land mammal beyond about 300 miles would refute the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A few island mammals have disputed native status or may have arrived with people.", "The result depends on what counts as a great continental island and on using over-water distance.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.823"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Mammal Diversity Database";
    dc:description "Native non-volant mammal lists by island";
    prov:wasDerivedFrom <https://www.mammaldiversity.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "Occurrence records used to check island mammal status";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GEBCO";
    dc:description "Bathymetry and shoreline geography for distance to the nearest continent";
    prov:wasDerivedFrom <https://www.gebco.net/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch12-09 by Grok 4.7: 0.8";
