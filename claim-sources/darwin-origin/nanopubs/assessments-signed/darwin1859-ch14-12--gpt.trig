    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch14-12: resolvable-now, resolvability 0.74";
    dc:description "A worldwide sterilizing cataclysm and broken descent have strong genomic and geological consequences. Existing evidence spans all major lineages and extinction boundaries, though absolute proof of uninterrupted survival is limited by preservation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Test genomes of all major living lineages for uninterrupted genealogical continuity from deep ancestors and examine global stratigraphic and extinction records for an interval that eliminated all life. Any independently originated post-cataclysm lineage or truly sterile global break refutes the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Absence of fossils cannot prove absence of survivors.", "Microbial survival is poorly represented in occurrence databases.", "Pre-Silurian ancestry is inferred from phylogeny rather than direct continuous fossils.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.88"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.737"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "molecular continuity across living lineages";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
