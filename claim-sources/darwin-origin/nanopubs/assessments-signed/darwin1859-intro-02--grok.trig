sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-intro-02: partially-resolvable, resolvability 0.50";
    dc:description "Open life-history compilations can test overproduction for hundreds of plants and animals, which is only part of the syllogism. The step from a profitable slight variation to a better chance of survival is difficult to refute without an independent definition of profit, and heritability-plus-fitness tables are not in one downloadable archive. A small team could test the demographic premise quickly and would still be short of a non-circular test of the whole mechanism.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate low-density population growth and the surplus of births over replacement from matrix models and fecundity schedules, then ask whether small heritable advantages predict higher survival or reproductive success in the same populations. Persistent geometric potential with realized populations held far below it would support the overproduction premise; a general failure of slight heritable differences to predict fitness would challenge the selection step only if 'profitable' is defined independently of the fitness outcome.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A variation that is profitable to its bearer is already defined by improved survival or reproduction, so that half of the statement is nearly analytic.", "Density dependence, measurement of 'slight' variation, and publication bias in selection studies all change the apparent strength of the result.", "Public demographic databases rarely pair individual-level heritable differences with fitness in the same rows.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.52"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-intro-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-intro-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-intro-02--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.499"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-intro-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: COMPADRE and COMADRE";
    dc:description "stage-structured fecundity and survival for potential versus realized increase";
    prov:wasDerivedFrom <https://compadre-db.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-intro-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Living Planet Index";
    dc:description "multi-year abundance trajectories showing populations are not at unbounded geometric increase";
    prov:wasDerivedFrom <https://www.livingplanetindex.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-intro-02--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FishBase";
    dc:description "fecundity and life-history fields for a large animal clade";
    prov:wasDerivedFrom <https://www.fishbase.se/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-intro-02 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-intro-02 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-intro-02 by Grok 4.7: 0.72";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of darwin1859-intro-02 by Grok 4.7: 0.3";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-discriminating-power>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.3"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of darwin1859-intro-02 by Grok 4.7: 0.38";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/operationalizability";
    <https://w3id.org/delphi/ontology/hasScore> "0.38"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok>.
<https://w3id.org/delphi/resource/claim/darwin1859-intro-02> <https://w3id.org/delphi/ontology/hasAssessment> <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok>, <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--analysis-feasibility>, <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--data-adequacy>, <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--data-existence>, <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--discriminating-power>, <https://w3id.org/delphi/resource/assessment/darwin1859-intro-02--grok--operationalizability>
}
