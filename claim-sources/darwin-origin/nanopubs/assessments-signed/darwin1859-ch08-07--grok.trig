sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch08-07: partially-resolvable, resolvability 0.63";
    dc:description "The comparison of reciprocal directions is simple and highly discriminating when both directions were published separately. The most convenient open fly compilation often folds those directions into one index, so recovering the asymmetry means going back to papers. That is a feasible partial test, not a ready analysis of plants and animals at the stated scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For species pairs crossed in both directions, compare offspring production with the sexes reversed. Frequent large asymmetries support the claim; consistently equal reciprocal success would refute the statement that the difference is often very wide.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A difference in success does not by itself locate the cause in an imperceptible reproductive detail.", "Direction-specific tables for plants, Fucus, and vertebrates are scattered.", "Major compilations often average or sum reciprocal outcomes, erasing the contrast.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-07--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.626"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Drosophila speciation dataset";
    dc:description "isolation scores that incorporate reciprocal crosses, though many published indices collapse the two directions";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.g5g43>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch08-07 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch08-07 by Grok 4.7: 0.45";
