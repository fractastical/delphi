sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch12-15: partially-resolvable, resolvability 0.54";
    dc:description "The colonisation half can be turned into a source-region test, but accessibility and subsequent adaptation each admit several operationalizations, which lowers the score. Phylogenies and range data cover classic islands much better than caves, marshes and alpine lakes. A broad multi-habitat analysis would take months of harmonization, and adaptation remains a proxy rather than a fitness measurement.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For islands, sky-islands, lakes and caves, compare the phylogenetic source region of endemics with a dispersal-accessibility model based on distance and barriers, and score whether colonists are phenotypically shifted toward local conditions. The claim is confirmed if the best-supported source matches the most accessible region and derived populations are more environment-matched than their source relatives, and refuted if sources are random with respect to access or phenotypes are unchanged.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Most readily' requires a dispersal model, and currents, bird vectors and past climates give several competing versions.", "Being related to a source shows colonisation, while 'better fitted' needs trait-environment data that most of these biotas lack.", "Cave, marsh and lake endemics are inventoried far more unevenly than oceanic islands.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-15--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-15--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.543"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "Phylogenies used to infer source regions of isolated biotas.";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-15--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
    dc:description "Occurrences of island, mountain, lake and cave taxa and of their candidate source biotas.";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-15--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Map of Life";
    dc:description "Expert range maps that complement occurrence records for identifying accessible source regions.";
    prov:wasDerivedFrom <https://mol.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch12-15 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-15--grok>.
