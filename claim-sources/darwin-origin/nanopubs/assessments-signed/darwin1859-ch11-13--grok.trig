sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch11-13: resolvable-now, resolvability 0.81";
    dc:description "Global proxy compilations already align last-glacial temperature and ice extent on shared age models. A small team can compare the timing of maxima by latitude with standard age-depth data. Tuning and uneven tropical coverage limit precision, and they leave a clear test of whether the cold interval was broadly shared.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare independently dated temperature proxies and glacial maxima across latitudes through the last glacial cycle. Cold intervals offset by a large part of the cycle would refute worldwide simultaneity; overlap within a few thousand years would support it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "At least in part simultaneous can be met by a weak overlap.", "Orbital tuning of marine cores builds in some of the synchrony under test.", "Tropical and some southern land records are sparser than the polar ice cores.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-13--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.815"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NOAA Paleoclimatology";
    dc:description "Ice-core, marine, and terrestrial temperature and glacier records for the last glacial cycle";
    prov:wasDerivedFrom <https://www.ncei.noaa.gov/products/paleoclimatology>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PANGAEA";
    dc:description "Dated paleoclimate series used to compare regions on one timescale";
    prov:wasDerivedFrom <https://www.pangaea.de/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch11-13 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-13--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch11-13 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-13--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-13--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
