    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-05--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch01-05: resolvable-now, resolvability 0.76";
    dc:description "Multi-trait pedigrees, genomic associations and selection experiments directly measure correlated response. Public livestock and crop data provide enough breadth for a strong present-day test, though not every selection regime.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate genetic correlations and correlated responses between deliberately selected traits and unselected traits in breeding populations. Nonzero repeatable correlated responses support the claim; consistently independent traits would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Linkage can mimic pleiotropic correlation.", "The phrase 'almost certainly' requires broad sampling.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-05--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.759"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-05--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Animal QTLdb";
    dc:description "mapped pleiotropic and correlated production traits";
    prov:wasDerivedFrom <https://www.animalgenome.org/cgi-bin/QTLdb/index>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-05--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
