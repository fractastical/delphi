    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-17--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-17--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
