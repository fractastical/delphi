sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-17--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch01-17: partially-resolvable, resolvability 0.44";
    dc:description "Genomic differentiation and crop evaluation data can show that selection has left a large mark on major domestic races, which addresses only part of a ranking among causes. The other causes are poorly collocated in the same records, so the predominance claim stays under-identified. Several decompositions are possible, and any one of them would take substantial harmonization for a handful of species.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Decompose among-breed phenotypic and genomic differences into components attributable to selection response, direct environmental effects, correlated response, and hybrid ancestry. Selection would be the predominant power if its component exceeded the sum of the others across a representative set of races; a larger share for conditions, use, correlation, or crossing would count against that ranking.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Plastic responses to rearing conditions are rarely measured in the same animals as breed genomics.", "Selection scans detect some selected loci and miss polygenic and environmental change.", "There is no agreed scale on which to add 'power' across selection, climate, use, correlation, and crossing.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.52"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-17--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-17--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.437"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-17--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: European Variation Archive";
    dc:description "breed differentiation and selected sweeps in sequenced livestock";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/eva/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-17--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Online Mendelian Inheritance in Animals";
    dc:description "known selected loci versus syndromes that track use, disease, or correlated defects";
    prov:wasDerivedFrom <https://omia.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-17--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: USDA GRIN";
    dc:description "crop accession phenotypes where selection history and pedigree are partly documented";
    prov:wasDerivedFrom <https://npgsweb.ars-grin.gov/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-17--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch01-17 by Grok 4.7: 0.42";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.42"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-17--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-17--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch01-17 by Grok 4.7: 0.36";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.36"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-17--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-17--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch01-17 by Grok 4.7: 0.52";
