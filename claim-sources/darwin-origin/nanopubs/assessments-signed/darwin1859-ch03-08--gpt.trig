    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch03-08: needs-new-data, resolvability 0.51";
    dc:description "The mechanism has a clear density-dependent test, but current global datasets provide only coarse proxies. Adequate replicated population-enemy time series would need to be collected or compiled from new observations.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate persistence probability against conspecific density and enemy density across populations, looking for a positive threshold or Allee effect; then test whether range-restricted plants have high abundance within occupied sites. A widespread enemy-relative threshold supports the mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Enemy and absolute density time series are rarely paired.", "Opportunistic occurrences cannot identify persistence thresholds.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-08--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.512"^^xsd:double;
