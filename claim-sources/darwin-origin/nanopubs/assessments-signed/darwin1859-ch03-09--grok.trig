sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch03-09: partially-resolvable, resolvability 0.54";
    dc:description "Community time-series archives can measure whether composition stays similar, which is half the statement and is already a standard analysis. They rarely include the trifling perturbation that would show the balance is easy to tip. Short duration, sampling noise, and the tension between the two halves keep the full wording only partly testable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify temporal turnover in community composition over long monitoring series, and, where perturbations exist, estimate how small a change shifts dominance. Long periods of low turnover would support uniformity; high sensitivity to small pushes would support the tipping clause; a series cannot support both clauses unless stability and sensitivity are given separate thresholds.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Apparent turnover is confounded with sampling error and observer change.", "Most series span years to decades, not the long periods implied, and coarse taxonomy inflates apparent stability.", "The statement combines long-run uniformity with hair-trigger sensitivity, which need different designs.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.52"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.538"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch03-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioTIME";
    dc:description "assemblage time series for compositional uniformity";
    prov:wasDerivedFrom <https://biotime.st-andrews.ac.uk/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch03-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: LTER Network";
    dc:description "decadal community data and some experimental perturbations";
    prov:wasDerivedFrom <https://lternet.edu/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch03-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: sPlot";
    dc:description "resurveyed vegetation plots as a spatial-temporal complement";
    prov:wasDerivedFrom <https://www.idiv.de/research/projects/splot/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch03-09 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-09--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch03-09 by Grok 4.7: 0.48";
