sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch10-12--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch10-12: resolvable-now, resolvability 0.78";
    dc:description "Cross-regional marine turnover is densely recorded, and independent age frameworks exist so the test need not use the fossils as their own clock. Agreement within a stage is a concrete criterion matching the broad geological sense of the claim. Coverage is stronger for shelly and microfossil faunas than for every marine group.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Date marine faunal turnovers with radiometric, paleomagnetic, or chemostratigraphic ages and compare their timing across paleocontinents. Turnover coincident within a geological stage worldwide would support the claim; multi-stage diachrony as the usual pattern would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Correlation that uses the fossils themselves makes simultaneity circular.", "Independent dates are dense in some periods and sparse in others.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.778"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Marine occurrences with paleocoordinates for cross-regional faunal comparison";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Macrostrat";
    dc:description "Section ages independent of the fossil lists being correlated";
    prov:wasDerivedFrom <https://macrostrat.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch10-12--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: International Commission on Stratigraphy";
    dc:description "Stage framework and radiometric ages for judging what counts as simultaneous";
    prov:wasDerivedFrom <https://stratigraphy.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch10-12--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch10-12 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-12--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch10-12--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch10-12 by Grok 4.7: 0.7";
