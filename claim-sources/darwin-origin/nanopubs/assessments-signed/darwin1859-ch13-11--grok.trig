<https://w3id.org/delphi/resource/assessment/darwin1859-ch13-11--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of darwin1859-ch13-11 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-discriminating-power>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-11--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch13-11--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of darwin1859-ch13-11 by Grok 4.7: 0.55";
