<https://w3id.org/delphi/resource/assessment/darwin1859-intro-04--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-intro-04: resolvable-now, resolvability 0.80";
    dc:description "Multiple large public resources contain independent molecular and fossil consequences of descent. Although complete species coverage is absent, the universal immutability alternative has clear, strongly discriminating tests.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare independent molecular characters, shared derived genomic changes and fossil succession against separate-creation and common-descent models. Nested congruent ancestry across congeneric species supports descent; independent origins without shared history would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fossil ancestors are rarely identifiable with certainty.", "Not every described species has genomic data.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-intro-04--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-intro-04--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-intro-04--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.796"^^xsd:double;
