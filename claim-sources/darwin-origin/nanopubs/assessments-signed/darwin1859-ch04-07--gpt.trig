<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch04-07: partially-resolvable, resolvability 0.61";
    dc:description "The component predictions are measurable and existing studies can establish the mechanism in particular birds. Public data rarely contain preference, inheritance and multigenerational response together.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Combine female mate-choice measurements, male song or plumage phenotypes, reproductive success and pedigree or genomic heritability. A heritable ornament preferred by females and associated with higher mating success supports cumulative female-choice evolution; alternative ecological or male-competition effects must be controlled.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Female choice, male competition and ecological selection often covary.", "Long-term historical causation cannot be observed directly.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.608"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
