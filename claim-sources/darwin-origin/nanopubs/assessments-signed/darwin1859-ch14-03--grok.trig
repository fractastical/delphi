sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-03--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch14-03: resolvable-now, resolvability 0.79";
    dc:description "Chemical composition and cellular machinery are directly tabulated for a wide taxonomic span, and absence of that core in a sequenced lineage would refute the empirical claim. Pathway and protein databases cover the chemical and cellular clauses well and the vague 'laws of growth' only by proxy. The comparison is a standard survey of existing molecular databases and can be completed quickly.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across the major lineages of life, score shared nucleotide and amino-acid chemistry, cellular organization and a core of growth and reproductive processes, and test whether those features are present in essentially all organisms rather than in one kingdom. The claim is confirmed if the core is taxonomically universal, and refuted if substantial lineages lack cells or use an unrelated chemical basis of growth and reproduction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Laws of growth and reproduction' is broader and vaguer than the chemical and cellular variables that databases actually tabulate.", "A similar effect of the same poison on plants and animals is an incidental illustration and is not compiled for all lineages.", "Shared chemistry would also be expected if independent origins had few viable chemical options, so universality alone is a weaker test of a single origin than of commonality.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-03--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-03--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.785"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-03--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: UniProt";
    dc:description "Protein sequences documenting a shared amino-acid chemistry and conserved cellular machinery.";
    prov:wasDerivedFrom <https://www.uniprot.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-03--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: KEGG";
    dc:description "Pathway maps for core metabolism, growth-related processes and reproductive or cell-cycle functions.";
    prov:wasDerivedFrom <https://www.kegg.jp/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-03--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Taxonomy";
    dc:description "Taxonomic span of sequenced organisms used to check that the common features are not confined to animals or plants.";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-03--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch14-03 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.8"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-03--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-03--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch14-03 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
