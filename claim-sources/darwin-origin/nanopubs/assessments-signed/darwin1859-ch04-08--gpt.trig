<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-08--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch04-08: partially-resolvable, resolvability 0.62";
    dc:description "Comparative datasets support broad proxy tests of Darwin's historical inference. Ecological selection, sex-specific natural selection and correlated evolution substantially reduce discriminating power.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across animals with similar male and female ecological niches, quantify sexual dimorphism and independent indicators of mate choice or mating competition. A phylogenetically controlled association of dimorphism with sexual-selection intensity, after ecological controls, supports the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Present-day correlation does not uniquely establish the historical selective cause.", "Shared habits and sexual-selection intensity are incompletely coded.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-08--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
