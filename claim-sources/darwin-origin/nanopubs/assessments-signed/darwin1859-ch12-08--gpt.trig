    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch12-08: resolvable-now, resolvability 0.89";
    dc:description "The distributional statement has clear counterexamples and comprehensive modern databases. The seawater mechanism can also be checked experimentally from published data, making the claim strongly resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Inventory native amphibians on geologically oceanic islands, distinguish introductions, and relate presence to island origin and sea-crossing distance; combine this with saltwater survival experiments for adults and spawn. Native records on remote true oceanic islands or high salt tolerance would refute the strong claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ancient rafting events can occur despite generally low salt tolerance.", "Introduced populations must be removed.", "Some island geological classifications are disputed.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.93"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-08--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.893"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
