<https://w3id.org/delphi/resource/assessment/darwin1859-intro-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-intro-03: partially-resolvable, resolvability 0.57";
    dc:description "Divergence and extinction are measurable, but 'less improved' requires substantial reinterpretation. Fossil and phylogenetic data support restricted tests, not the claimed near-inevitability or attribution to selection.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use time-calibrated phylogenies and fossils to test whether lineage divergence is associated with inferred selection and whether less-adapted lineages have elevated extinction. Patterns must exceed neutral diversification and environmental-turnover null models.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Diversification models have identifiability problems.", "Fitness of extinct forms is usually unobserved.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-intro-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-intro-03--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.566"^^xsd:double;
