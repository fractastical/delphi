sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-01--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch12-01: resolvable-now, resolvability 0.72";
    dc:description "Range size and cross-continental genus occupancy are computable for fishes and for several invertebrate and plant groups from open sources. Habitat mislabels and cryptic diversity reduce coverage below the full set of freshwater classes. A comparison with terrestrial relatives in the same clades is still a direct and feasible test of the wide-range pattern.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare geographic range sizes of freshwater species with those of related terrestrial species, and measure how often freshwater genera occur on more than one continent. Ranges no larger than terrestrial relatives, and regionally restricted freshwater allies, would count against the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cryptic species divide ranges that look cosmopolitan under older names.", "Enormous needs a comparison group, because there is no absolute range cutoff.", "Habitat is poorly coded on many occurrence records, so freshwater sets need extra filtering.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-01--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.725"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-01--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "Occurrences of freshwater plants, insects, molluscs, and other groups";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-01--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FishBase";
    dc:description "Freshwater fish ranges as one well-coded class inside the broader claim";
    prov:wasDerivedFrom <https://www.fishbase.se/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-01--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: World Register of Marine Species";
    dc:description "Taxonomy and distribution context for freshwater molluscs and other aquatic invertebrates";
    prov:wasDerivedFrom <https://www.marinespecies.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-01--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch12-01 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-01--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
