sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch13-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch13-14: partially-resolvable, resolvability 0.56";
    dc:description "Presence of the shared pattern in stem fossils is testable, and public matrices and occurrences support it for mammal limbs and a few other systems. 'Slight successive steps' and the ancestral function are much harder, and reconstruction methods favor the gradual story they are asked to detect. The feasible result is a partial historical test for well-fossilized organ systems, not for every class.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct the ancestral arrangement of a class-level organ system from fossils and living species, and test whether subsequent changes are small steps in shape and size that leave connections intact. The claim is confirmed if stem fossils already show the shared pattern and later disparity accumulates gradually, and refuted if the common ancestor lacks the pattern or later change is concentrated in a few large jumps.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ancestral-state models assume a tree and a mode of change, so gradual modification is partly built into the method.", "Fine stratigraphic series of slight steps are available for a few skeletonized lineages and missing for most organ systems.", "The original use of the ancestral pattern is not recorded by the fossils that preserve its structure.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-14--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-14--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.557"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Stem-group fossils that can show whether the shared pattern was already present early.";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-14--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "Character matrices for ancestral-state reconstruction of limbs, mouthparts and similar systems.";
    prov:wasDerivedFrom <https://www.morphobank.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-14--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "Trees on which ancestral arrangements and subsequent amounts of change are reconstructed.";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch13-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch13-14 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-14--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch13-14--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch13-14 by Grok 4.7: 0.5";
