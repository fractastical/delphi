<https://w3id.org/delphi/resource/assessment/darwin1859-ch09-04--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch09-04: resolvable-now, resolvability 0.86";
    dc:description "Soft-bodied fossil occurrences and taphonomic associations are directly documented in public data. The absolute non-preservation statement is readily falsifiable and the broader bias can be quantified.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare preservation frequencies by tissue mineralization and depositional regime, and test for wholly soft-bodied fossils and skeletal remains in condensed or nondepositional settings. Verified soft-bodied fossils directly refute the absolute first clause, while taphonomic patterns test the bias.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Absence of preservation is difficult to distinguish from absence of organisms.", "Exceptional preservation creates strong site-selection effects.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-04--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-04--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
