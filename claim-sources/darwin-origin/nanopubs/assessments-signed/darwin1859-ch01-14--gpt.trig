    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch01-14: partially-resolvable, resolvability 0.66";
    dc:description "Crop genomics can now infer many parent stocks and quantify divergence, but cannot cleanly recover nineteenth-century recognizability or exclude lost ancestors. The proposed causal explanation is therefore only partly testable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across long-cultivated plants, relate genomic and morphological divergence from inferred wild relatives to whether parent stocks were historically recognizable, controlling extinction and sampling. Greater accumulated change associated with failed recognition supports the explanation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Extinction and unsampled wild diversity are rival explanations.", "Modern genomics can identify parents once unrecognizable morphologically.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-14--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-14--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.662"^^xsd:double;
