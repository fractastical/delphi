sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch09-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch09-14: resolvable-now, resolvability 0.85";
    dc:description "Published plate models directly record whether oceans and continents stayed in their present areas. The displacements involved, such as the opening of the Atlantic, are large relative to reconstruction uncertainty. Paleozoic detail is coarser, but it is still sufficient to confirm or refute stability since the earliest Silurian.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare Silurian-to-Recent paleogeographic reconstructions with the present positions of continents and ocean basins. Opening or closure of major ocean basins, or large lateral shifts of continental crust, would refute long-term stability of those areas.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ocean crust older than the Jurassic has been subducted, so ancient ocean positions are inferred from continental margins.", "Paleozoic plate reconstructions are less precise than Mesozoic and Cenozoic ones.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.82"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-14--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.855"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch09-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EarthByte";
    dc:description "Plate-tectonic reconstructions of continent and ocean positions since the Paleozoic";
    prov:wasDerivedFrom <https://www.earthbyte.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch09-14--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GPlates";
    dc:description "Open plate model and software for measuring displacement of continental crust through time";
    prov:wasDerivedFrom <https://www.gplates.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch09-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch09-14 by Grok 4.7: 0.8";
