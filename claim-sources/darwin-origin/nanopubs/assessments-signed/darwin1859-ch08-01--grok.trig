    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-01--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
