<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch05-03: partially-resolvable, resolvability 0.61";
    dc:description "Existing phylogenomic and anatomical data can evaluate competing explanations for many island birds. The specific inheritance of acquired disuse is difficult to operationalize historically and cannot be directly observed.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct independent island bird transitions to flightlessness and compare timing with predator absence, while examining genomic and anatomical signatures of relaxed selection versus adaptive energetic or survival selection. Evidence uniquely consistent with inherited effects of reduced wing use would support disuse; adaptive loss or drift would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Darwinian 'disuse' does not map uniquely to a modern genetic mechanism.", "Predator absence covaries with island ecology and energetic selection.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.607"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BirdLife DataZone";
    dc:description "bird distributions, ecology and threat information";
    prov:wasDerivedFrom <https://datazone.birdlife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "genomes of flightless and volant birds";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--gpt--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "open anatomical scans of avian wings and skeletons";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-03--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
