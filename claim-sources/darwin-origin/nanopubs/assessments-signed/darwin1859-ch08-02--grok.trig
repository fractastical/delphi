sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch08-02: resolvable-now, resolvability 0.75";
    dc:description "Fertility and inbreeding coefficient are measured together in more than one public pedigree, and the decision rule is a standard regression that a small team can run quickly. The same negative relationship is widely tabulated for other animals and for plants, so the stated generality is not hanging on one species. What the datasets do not settle is Darwin's use of the pattern to explain multi-generation hybrid decline in particular.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Regress fertility or offspring number on pedigree or genomic inbreeding coefficient, treating low inbreeding as the occasional cross with a less related mate. A negative slope confirms that closer interbreeding lowers fertility and that less related matings raise it; a flat or positive slope would refute the relationship.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Environmental stress changes the slope, so a single population is not the whole relationship.", "The further application to hybrids kept for several generations is not the design of these wild pedigrees.", "These open pedigrees are animals; plant inbreeding-depression tables are more scattered.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Song sparrow pedigree and fitness";
    dc:description "individual inbreeding coefficients and lifetime offspring counts in a wild bird population";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.p9s04>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Soay sheep inbreeding and fitness";
    dc:description "pedigree and genomic inbreeding with annual breeding success in a free-living mammal";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.fh6d9>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-02--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Mouse Genome Informatics";
    dc:description "reproductive phenotypes of inbred mouse strains as an extreme of close interbreeding";
    prov:wasDerivedFrom <https://www.informatics.jax.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch08-02 by Grok 4.7: 0.74";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.74"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch08-02 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-02--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch08-02 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-existence>;
