sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-02: partially-resolvable, resolvability 0.57";
    dc:description "Sequence polymorphism and fitness annotations are public and the site-frequency spectrum is a standard discriminator of neutral and selected alleles. That test covers a modest set of taxa and mostly nucleotide variants rather than the visible polymorphisms Darwin had in mind. Balancing selection is a serious alternative route to long-lived polymorphism, so the analysis is informative for sequence evolution and only a proxy for polymorphic species.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Classify variants by an independent fitness assay or functional annotation, then compare their heterozygosity and time spent polymorphic with neutral expectations. The claim would be confirmed if alleles with no detectable fitness effect persist as a fluctuating component while selected alleles do not, including in species long called polymorphic; it would be refuted if persistent polymorphisms are predominantly maintained by balancing selection.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Balancing selection keeps variation that is useful under some conditions, which the neutral wording does not separate cleanly.", "Nineteenth-century polymorphic species are not a standardized trait class in modern databases.", "Phenotypic polymorphism data are scattered relative to sequence polymorphism.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.574"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: gnomAD";
    dc:description "site-frequency spectra and constraint for separating neutral from selected variants";
    prov:wasDerivedFrom <https://gnomad.broadinstitute.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: 1000 Genomes Project";
    dc:description "population polymorphism data for allele-frequency dynamics";
    prov:wasDerivedFrom <https://www.internationalgenome.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "population-genomic sequences for non-human species";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-02 by Grok 4.7: 0.66";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.66"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-02 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
