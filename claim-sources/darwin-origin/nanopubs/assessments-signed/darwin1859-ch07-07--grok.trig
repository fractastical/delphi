sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch07-07: partially-resolvable, resolvability 0.59";
    dc:description "The historical sequence is a standard ancestral-state question, and public bird trees cover cuckoos and the other parasitic groups well enough to try it. The behavioral coding step is literature compilation rather than a download, which holds data existence and feasibility at a moderate level. Even a clean sequence would not demonstrate the fitness advantage that is supposed to have driven the habit.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct nest-building versus facultative and obligate brood parasitism on a cuckoo phylogeny, and repeat for cowbirds and honeyguides. A derived obligate state with nesting or facultative ancestors supports the sequence; parasitism ancestral to the family, or no intermediate state where sampling is good, would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Extinct intermediates and hosts leave no behavioral fossils.", "Parasitic status and nesting behavior are not columns in these tree repositories and must be coded from monographs.", "The selective claim that fostered young fared better is not in phylogenetic presence-absence data.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-07--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.594"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch07-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BirdTree";
    dc:description "phylogenetic sample of cuckoos and other brood-parasitic birds for ancestral-state reconstruction";
    prov:wasDerivedFrom <https://birdtree.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch07-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: VertLife";
    dc:description "alternative avian trees used to check that the reconstructed sequence is not an artifact of one phylogeny";
    prov:wasDerivedFrom <https://vertlife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch07-07 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch07-07 by Grok 4.7: 0.52";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.52"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-07--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch07-07 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-07--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of darwin1859-ch07-07 by Grok 4.7: 0.55";
