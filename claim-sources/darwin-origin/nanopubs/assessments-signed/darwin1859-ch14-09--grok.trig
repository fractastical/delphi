sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch14-09: resolvable-now, resolvability 0.72";
    dc:description "Both durations are now numerical, and the Phanerozoic is several times shorter than the interval since the earliest widely discussed evidence of life. That comparison uses public time scales and fossil and rock ages and can be made in days. The soft point is the rhetorical threshold for 'fragment', which keeps discriminating power moderate even though the direction of the inequality is clear.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare the radiometric length of the fossiliferous timescale known in 1859, essentially the Phanerozoic, with the time from the earliest evidence of life to the present. The claim is confirmed if that then-known history is a small fraction of post-origin time, and refuted if the two durations are similar under the range of credible dates for first life.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Mere fragment' has no numerical cutoff, so a ratio near one sixth can be described in more than one way.", "The age of the first organism is a range, from debated early isotopic signals to clearer later fossils.", "The phrase 'history of the world as at present known' has to be read as the 1859 fossiliferous timescale, because the geological record known today already includes most of Earth's history.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: International Commission on Stratigraphy";
    dc:description "Numerical ages for the base of the Cambrian and for the length of the Phanerozoic.";
    prov:wasDerivedFrom <https://stratigraphy.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "The span of the fossil record that corresponds to the history of life known when the claim was written.";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Macrostrat";
    dc:description "Ages of the oldest preserved rock units, used to place the earliest geological and fossil evidence on the same scale.";
    prov:wasDerivedFrom <https://macrostrat.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch14-09 by Grok 4.7: 0.85";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-09--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch14-09 by Grok 4.7: 0.75";
