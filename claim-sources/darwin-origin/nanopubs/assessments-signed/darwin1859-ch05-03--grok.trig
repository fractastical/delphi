sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-03--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch05-03: partially-resolvable, resolvability 0.55";
    dc:description "The association between reduced flight and predator-poor islands is operational and the bird datasets cover that scope well enough for a standard comparative test. The causal wording attributes the condition to disuse, which those datasets do not measure and which selection explains equally well. The resolvable part is the pattern; the mechanism remains confounded.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Regress hand-wing index, or a flightless classification, on oceanic-island isolation and the absence of mammalian predators, with phylogeny controlled. Concentration of flightlessness on predator-free islands would confirm the geographic pattern. It would not confirm disuse, because selection against the cost of flight predicts the same distribution; a disuse-specific test would require a heritable effect of not flying that is independent of survival differences.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "AVONET covers living birds and under-represents recently extinct island forms.", "Disuse and selection against flight are not separated by wing measurements and island lists.", "Predator-free is inferred from island faunas rather than measured predation rates.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.549"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AVONET";
    dc:description "hand-wing index and range context for essentially all living birds";
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.16586228>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BirdTree";
    dc:description "phylogeny for island flightlessness contrasts";
    prov:wasDerivedFrom <https://birdtree.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-03--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EltonTraits";
    dc:description "foraging stratum to separate aerial from terrestrial habits";
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.c.3306933>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-03--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch05-03 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-03--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-03--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch05-03 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-03--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-03--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch05-03 by Grok 4.7: 0.72";
