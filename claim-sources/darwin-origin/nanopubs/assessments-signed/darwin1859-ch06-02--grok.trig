sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch06-02: partially-resolvable, resolvability 0.71";
    dc:description "Contact-zone width and edge steepness are direct geographic measurements, and bird data are already sufficient for a large comparative test. The stated scope also includes mountains and sea depths, where occurrence density and abundance are much weaker, so the full scope is not covered. Sampling and species concepts are real biases, but they do not make the bird-scale result uninformative.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For sister or representative species, measure the width of the zone where both occur relative to each species' range, and the steepness of abundance decline at the edge. Narrow contact zones and abrupt abundance drops would confirm the claim; overlap widths that are a large fraction of range width, or gradual declines, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Abundance, needed for abrupt rarity, is dense for birds and coarse for most other groups.", "Depth zonation and deep-sea sister species are sparsely sampled.", "Taxonomic splitting can manufacture narrow contacts between newly named species.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-02--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.711"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: eBird";
    dc:description "abundance and locality data for measuring avian contact zones";
    prov:wasDerivedFrom <https://ebird.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
    dc:description "occurrences for terrestrial sister species across continents and mountains";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-02--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: OBIS";
    dc:description "marine occurrences along depth gradients";
    prov:wasDerivedFrom <https://obis.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch06-02 by Grok 4.7: 0.74";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.74"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch06-02 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
