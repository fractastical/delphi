sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-09: partially-resolvable, resolvability 0.60";
    dc:description "Trait matching and correlated phylogenetic change are standard tests, and interaction networks plus floral traits make a partial version feasible. Coverage is a subset of flowering plants and their insects, concentrated where networks have been assembled. Matching alone does not show that both parties were modified, or whether the changes were simultaneous, so the analysis discriminates mutual adaptation only modestly from one-sided filtering.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Match floral measurements to the morphology of recorded insect visitors and test whether changes on the two phylogenies are correlated. Trait matching beyond a null of random visits would support mutual modification; matching explained entirely by pollinators filtering flowers that already fit would refute reciprocal adaptation. Simultaneous versus sequential change is a further, weaker contrast using relative timing on time-calibrated trees.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Network coverage is strong for a few floras and poor for most insect-plant pairs.", "One-sided adaptation and ecological filtering produce trait matching without reciprocal change.", "Visitor morphology and corolla measurements are only partly in the same databases as interactions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.596"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GloBI";
    dc:description "records of flower-insect visitation and pollination";
    prov:wasDerivedFrom <https://www.globalbioticinteractions.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Web of Life";
    dc:description "ecological networks of plants and pollinators";
    prov:wasDerivedFrom <https://www.web-of-life.es/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TRY";
    dc:description "floral traits to pair with visitor morphology";
    prov:wasDerivedFrom <https://www.try-db.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-09 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-09--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-09 by Grok 4.7: 0.44";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
