sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch14-08: partially-resolvable, resolvability 0.47";
    dc:description "Rate-through-time methods exist and can be applied to Phanerozoic fossils and to molecular trees, which covers the later part of the history the claim is about. The earliest interval, which carries the strongest wording, is exactly where public data are weakest. Sampling can imitate a slow start, so a low early rate in current compilations would not cleanly confirm the biological claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate origination, extinction and morphological rates in successive intervals from the origin of life to the present, and test whether rates are lower in the earlier, taxonomically poorer intervals. The claim is confirmed if early intervals are slower after sampling correction, and refuted if early rates are as high as or higher than later ones once rock availability is controlled.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A poor early rock record produces the appearance of slow change even if the biological rate was high.", "Molecular clocks pushed to the origin of life are dominated by the choice of model and calibration.", "The first dawn of life, where the claim says change may have been extremely slow, has almost no fossil resolution of biological rates.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.54"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.475"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Phanerozoic origination and extinction rates, the best-resolved part of the history.";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TimeTree";
    dc:description "Molecular divergence times whose implied rates can be compared between deep and shallow branches.";
    prov:wasDerivedFrom <https://timetree.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-08--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: International Commission on Stratigraphy";
    dc:description "Interval ages, including the very long Precambrian bins in which an early slowdown would have to appear.";
    prov:wasDerivedFrom <https://stratigraphy.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch14-08 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch14-08 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-08--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch14-08 by Grok 4.7: 0.6";
