<https://w3id.org/delphi/resource/assessment/darwin1859-ch09-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch09-03: resolvable-now, resolvability 0.96";
    dc:description "Modern geochronology directly and precisely dates the interval since the Late Cretaceous. Public geological data and standard methods decisively resolve Darwin's numerical claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Date the late Chalk and the denudation history of the Weald with radiometric ages, stratigraphy, geomorphology, and erosion models, then compare elapsed time with 300 million years. An interval below that value refutes the estimate.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Reconstructing denudation rate is model-dependent, but the elapsed-time claim is not.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.97"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch09-03--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.962"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
