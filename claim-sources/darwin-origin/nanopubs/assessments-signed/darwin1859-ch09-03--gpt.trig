<https://w3id.org/delphi/resource/evidence/darwin1859-ch09-03--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: British Geological Survey Geology of Britain Viewer";
