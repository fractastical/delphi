sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch05-07: partially-resolvable, resolvability 0.58";
    dc:description "The relative frequency of climatic and biotic boundaries is a definable ratio, and the same public climate, occurrence, and tolerance sources support it. Coverage of physiological limits restricts the ratio to a subset of taxa, mostly terrestrial ectotherms. Even there, turnover and failed dispersal mimic competition, so the test is informative with a serious confound rather than decisive for the full biota.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Classify range boundaries as coinciding with physiological climate limits or as lying inside those limits where interacting species turn over, then compare the two frequencies. The claim would be confirmed if biotic boundaries are at least as common as climatic ones; it would be refuted if most boundaries match tolerance limits and competitor turnover adds no explanatory power.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dispersal limitation produces interior edges that look biotic.", "Species turnover at an edge is a proxy for competition, not a demonstration of it.", "Tolerance data exist for a minority of species, so many boundaries cannot be classified.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
    dc:description "occurrences defining range boundaries and co-occurring species";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: WorldClim";
    dc:description "climate at boundaries";
    prov:wasDerivedFrom <https://www.worldclim.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GlobTherm";
    dc:description "physiological limits used to separate climatic from biotic edges";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.1cv08>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch05-07 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch05-07 by Grok 4.7: 0.46";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
