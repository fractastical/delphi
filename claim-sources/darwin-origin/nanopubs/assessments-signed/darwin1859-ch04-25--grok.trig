sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-25--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-25: partially-resolvable, resolvability 0.45";
    dc:description "The pattern that named varieties differ less than species, and species less than genera, is close to how ranks are assigned, so a naive comparison has little power. An independent clock or isolation criterion can break that circle for birds, where morphology and trees are both public. That is a proxy on a restricted taxon, and it still does not show that natural selection, rather than any accumulating process, produced the gaps.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Using a rank criterion that does not itself use the measured traits, such as reproductive isolation or node age, compare morphological distances among populations, species, and genera. Steadily increasing distance with time would support the claim; distances that do not scale from variety to species to genus under that independent ranking would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cross-taxon measurements of the same traits are rare outside birds and a few model clades.", "Species and genera are often delimited by the size of the morphological gaps under test.", "Variety is not a current rank and must be proxied by populations or subspecies.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-25--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-25--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-25--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.453"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-25--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AVONET";
    dc:description "continuous bird morphology for disparity at population and species scales";
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.16586228>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-25--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BirdTree";
    dc:description "phylogenetic depth as an independent axis of divergence";
    prov:wasDerivedFrom <https://birdtree.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-25--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "genus and species taxonomy joined to divergence";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-25--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-25 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-25--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-25--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
