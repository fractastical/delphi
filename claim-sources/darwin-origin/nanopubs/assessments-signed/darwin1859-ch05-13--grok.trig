    <https://w3id.org/delphi/ontology/hasScore> "0.42"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-13--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-13--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
