    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-intro-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-05--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
