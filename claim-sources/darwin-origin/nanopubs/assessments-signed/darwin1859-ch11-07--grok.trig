sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch11-07: partially-resolvable, resolvability 0.58";
    dc:description "Single versus multiple origin is a standard phylogeographic hypothesis, and public sequences exist for thousands of species. That is a large subset and far from all species. Where sampling is dense, multiple unrelated origins are distinguishable from spread of one population, so the limit is coverage and compilation time.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For species with range-wide genetic sampling, ask whether gene trees fit one ancestral area followed by spread, or require two or more unrelated origins. A substantial share of species with well-supported multiple origins would challenge the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cryptic species and over-lumped names can look like multiple origins of one species.", "Published phylogeographies would have to be compiled, which is months of work at global scope.", "Range-wide sequences exist for a small fraction of species.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-07--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.585"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "Georeferenced sequences for phylogeographic origin counts";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BOLD Systems";
    dc:description "Barcode records with locality for single-origin versus multiple-origin tests";
    prov:wasDerivedFrom <https://boldsystems.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-07--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "Full geographic ranges against which sampling gaps are judged";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch11-07 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch11-07 by Grok 4.7: 0.45";
