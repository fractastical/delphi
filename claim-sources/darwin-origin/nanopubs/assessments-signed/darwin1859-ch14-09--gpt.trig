<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-09--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch14-09: needs-new-data, resolvability 0.48";
    dc:description "The comparison is conceptually measurable, but its decisive endpoint—the first organism—is not present in current datasets. Existing geochemical constraints do not establish that the missing duration is larger than all known geological history.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare the independently estimated age of life's first origin with the duration and completeness of the preserved geological record known to contain life. The claim requires the unrecorded pre-geological interval to greatly exceed the preserved interval.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No possible fossil sample can directly cover destroyed Hadean crust.", "The phrase 'known geological history' changes with discovery.", "The time of the first organism is unknown and may predate surviving rocks.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-09--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.476"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
