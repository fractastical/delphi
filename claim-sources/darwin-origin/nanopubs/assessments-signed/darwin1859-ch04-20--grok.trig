sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-20--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-20: partially-resolvable, resolvability 0.60";
    dc:description "Diversity-biomass experiments are public and already designed around this relationship, so the variables and the decision rule are clear for plants. They cover experimental and grassland subsets rather than animals and every kind of local community. Sampling effects and shared environmental drivers keep the causal reading only partly discriminating, and harmonizing traits with plot biomass is a moderate project.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Regress community biomass or primary production on functional or structural diversity within sites, holding resource supply constant, in experiments and in observational plots. A positive partial relationship would confirm that diversification of structure supports more life; no residual relationship would refute it for the measured communities.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Amount of life can be counted as biomass, abundance, or production, and the datasets emphasize plant biomass.", "Environment can raise both diversity and productivity together.", "Experimental communities are mostly temperate plants, not the full local biota.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-20--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-20--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-20--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-20--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cedar Creek Ecosystem Science Reserve";
    dc:description "long-term plant diversity experiments with biomass and productivity";
    prov:wasDerivedFrom <https://cedarcreek.umn.edu/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-20--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Nutrient Network";
    dc:description "coordinated grassland plots of diversity, biomass, and nutrients";
    prov:wasDerivedFrom <https://nutnet.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-20--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TRY";
    dc:description "plant functional traits used to score structural diversification";
    prov:wasDerivedFrom <https://www.try-db.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-20--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-20 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-20--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-20--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-20 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-20--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-20--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch04-20 by Grok 4.7: 0.7";
