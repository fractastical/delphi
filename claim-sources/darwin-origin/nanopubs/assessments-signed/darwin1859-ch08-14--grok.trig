sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch08-14: partially-resolvable, resolvability 0.50";
    dc:description "A few model systems have both kinds of cross and could be compared on variance and resemblance, which is a partial test. The open databases do not code prepotency or reversion, so those parts of the list still sit in narrative breeding records. Matched designs are uncommon, and feasibility is closer to months of harmonization than to a ready analysis.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Holding fertility aside, compare interspecific hybrids and intraspecific mongrels on variance, dominance or prepotency, reversion rate, and parent-offspring resemblance. Similar distributions support the claim; a large, repeatable difference on any of those properties would count against a general close similarity.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Prepotency and reversion are not standardized fields.", "Similarity is a judgment across several phenomena, each of which could differ.", "Species and variety crosses are rarely measured with the same traits in the same experiment.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-14--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.496"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MaizeGDB";
    dc:description "phenotypes of crosses among maize lines and with wild relatives, spanning variety and species distances";
    prov:wasDerivedFrom <https://www.maizegdb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-14--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FlyBase";
    dc:description "cross records for within-species and between-species Drosophila progeny";
    prov:wasDerivedFrom <https://flybase.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch08-14 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-14--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-14--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch08-14 by Grok 4.7: 0.4";
