sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-12--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch14-12: resolvable-now, resolvability 0.73";
    dc:description "Total biotic reboot versus continuity through survivors is detectable in principle, and public occurrence data show survivors across the major Phanerozoic extinctions, none of which is a global end of all lineages. Phylogenies of living groups likewise connect them to pre-Silurian ancestors without a second origin. Precambrian resolution is weaker, but it does not erase the Phanerozoic test the fossil record can already decide.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Search the post-Silurian and earlier fossil record for any interval in which all lineages disappear and later life is phylogenetically unconnected to what came before. The claim is confirmed if every extinction interval retains survivors that include the ancestors of later biotas, and refuted by a global barren gap followed by a biota with no genealogical connection to earlier organisms.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A complete sterilization in the poorly fossiliferous Precambrian, followed by survival of one lineage, would be difficult to see.", "Extinction percentages depend on species concepts and on how completely each interval was sampled.", "The claim is a universal negative, so its strength is set by the worst-sampled interval rather than by the well-known mass extinctions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.735"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Extinction magnitudes and the presence of survivors across geological intervals.";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "Phylogenetic continuity of living groups back through named ancestors and stem relatives.";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-12--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: International Commission on Stratigraphy";
    dc:description "The timescale of mass-extinction boundaries and of the pre-Silurian interval the claim reaches behind.";
    prov:wasDerivedFrom <https://stratigraphy.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-12--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch14-12 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch14-12--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-12--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch14-12 by Grok 4.7: 0.65";
