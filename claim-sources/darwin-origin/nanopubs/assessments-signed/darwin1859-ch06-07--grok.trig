sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch06-07: partially-resolvable, resolvability 0.48";
    dc:description "The comparative series Darwin appealed to can be approximated with phylogeny plus morphology, but eye-grade and optical-performance variables are not in one open table, so a team would spend months compiling them. Even a clean series would not reconstruct the historical path or separate selection from shared developmental constraint. Coverage is decent for insects and crustaceans and thin for the vertebrate extension of the scope.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Score optical complexity (pigment, lens, aperture, resolution) across arthropods on an independent phylogeny and ask whether neighboring grades are each optically functional. A continuous series of useful grades would support the possibility of a selective path; a complex eye isolated from any functional intermediate, or intermediates that are optically useless, would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A functional series shows that intermediates are possible, not that selection produced any particular eye.", "Living grades are collateral relatives, not the ancestral sequence.", "No public dataset scores optical performance across Articulata; those measurements are scattered in papers.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-07--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.481"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "3D meshes of arthropod and vertebrate heads from which eye-region structure can be measured for a subset of taxa";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "opsin and eye-development gene sequences for comparing photoreceptor homology across grades";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-07--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "phylogenetic backbone on which eye grades can be mapped to test whether complexity changes in small steps";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch06-07 by Grok 4.7: 0.42";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.42"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch06-07 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-07--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch06-07 by Grok 4.7: 0.48";
