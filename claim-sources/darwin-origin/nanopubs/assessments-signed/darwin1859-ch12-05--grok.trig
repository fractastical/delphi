sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch12-05: resolvable-now, resolvability 0.76";
    dc:description "Endemism fractions for island plants are already coded in open flora inventories, and occurrence data can audit whether a species is truly absent elsewhere. Vertebrate islands are similarly tractable. The test is weaker for insects and for tiny islets with incomplete lists, which is a coverage limit inside an otherwise direct comparison.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For oceanic islands, compute the proportion of species found nowhere else and compare that proportion with mainland regions of similar area. Endemism no higher than on continents, after inventory completeness is taken into account, would refute the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A raw percentage has to be judged against a species-area baseline.", "Insects, where endemism may be highest, are the least completely listed.", "Single-island endemics are sensitive to taxonomic splitting and to undersampling of neighbouring islands.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.763"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Inventory of Floras and Traits";
    dc:description "Island flora checklists with endemic status and area";
    prov:wasDerivedFrom <https://gift.uni-goettingen.de/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "Global ranges used to check whether island species occur anywhere else";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch12-05 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
