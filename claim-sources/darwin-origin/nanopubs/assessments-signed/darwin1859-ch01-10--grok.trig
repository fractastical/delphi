sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch01-10: resolvable-now, resolvability 0.82";
    dc:description "The named ancestor and the alternative of several wild stocks are both directly readable from public pigeon and Columba sequences. Major breed groups and the rock-pigeon have already been deposited, so a reanalysis is weeks of standard phylogenomics rather than a new collecting program. Incomplete sampling of obscure breeds and wild subspecies limits certainty at the margin and does not block a confirm-or-refute test of the stated origin.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Place domestic pigeon breeds and wild Columba species, including geographical forms of Columba livia, on a multilocus tree and an admixture graph. Nesting of all breed groups inside C. livia would support single origin from the rock-pigeon; breed groups scattered among other wild Columba species would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A few breeds differ by large-effect mutations, which does not by itself imply a different wild species.", "Feral pigeons and later hybridization can obscure an originally mixed origin.", "Not every fancy breed and not every geographical subspecies of C. livia is sequenced.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.83"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-10--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-10--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.825"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI GenBank";
    dc:description "pigeon and other Columba genome assemblies for phylogenetic placement of breeds";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-10--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "resequencing reads across fancy breeds and wild rock-pigeons";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-10--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Ensembl";
    dc:description "annotated rock-pigeon genome used as the reference for breed variants";
    prov:wasDerivedFrom <https://www.ensembl.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch01-10 by Grok 4.7: 0.78";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.78"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-10--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
