sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch05-14: partially-resolvable, resolvability 0.57";
    dc:description "Disparity of sexual versus non-sexual traits is a standard comparative statistic, and phylogenies for the relevant animals are public. The sexual-trait measurements themselves are still scattered, so existing global tables proxy only some display structures. Attention bias is a real confound and can be reduced by using predefined trait sets, which keeps the test informative for well-coded groups.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Within clades, compare evolutionary disparity in secondary sexual traits with disparity in other measured structures, using sex-specific data. Greater disparity in the sexual traits would confirm the claim; equal or greater disparity in non-sexual traits would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Global morphology tables are mostly unsexed and omit plumage and other ornaments.", "Sex-specific compilations are dense for a few groups, such as galliforms and lizards, and sparse elsewhere.", "Showy characters receive more taxonomic attention, which inflates their apparent disparity.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-14--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-14--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.568"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AVONET";
    dc:description "bird morphology that partially overlaps display structures such as tails";
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.16586228>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-14--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BirdTree";
    dc:description "phylogeny for within-group disparity";
    prov:wasDerivedFrom <https://birdtree.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-14--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: VertLife";
    dc:description "trees for extending the comparison beyond birds where sex-specific traits are coded";
    prov:wasDerivedFrom <https://vertlife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch05-14 by Grok 4.7: 0.52";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.52"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-14--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-14--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch05-14 by Grok 4.7: 0.44";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
