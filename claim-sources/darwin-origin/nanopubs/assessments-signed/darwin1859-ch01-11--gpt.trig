<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch01-11: partially-resolvable, resolvability 0.62";
    dc:description "Genomic time series and breeding records test several emblematic breeds, but historical coverage is uneven. The broad claim that this was the key cause across domestic forms is only partially resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For breeds with archived genomes and histories, test for sequential allele-frequency shifts and polygenic selection in directions matching documented human preferences, versus sudden-origin or neutral models. Repeated cumulative directional change supports accumulative selection.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Historical breeding records are incomplete.", "Selection, drift and introgression can generate overlapping signatures.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.616"^^xsd:double;
