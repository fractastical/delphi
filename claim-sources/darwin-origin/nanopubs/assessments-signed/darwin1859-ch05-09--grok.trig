sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch05-09: partially-resolvable, resolvability 0.36";
    dc:description "Developmental correlation and a near-zero selection gradient would favour a byproduct reading for a particular character, and fragments of those data exist. The wording only asserts that such characters may arise, so counterexamples do not refute it, and proving uselessness is biased toward the claim. Existing datasets support case studies, not a general decision.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For characters given high taxonomic weight, estimate their developmental correlation with other traits and the selection gradient on the character itself. A strong correlation together with a gradient indistinguishable from zero would support the possibility that the character is a useless byproduct; a consistently positive gradient would show that those particular characters are retained by selection, without closing a claim phrased as a possibility.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A possibility claim is confirmed by one solid case and is barely refutable.", "Failure to find a function is weak evidence that a character is useless.", "Selection gradients on fine taxonomic characters are rarely measured.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.361"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TRY";
    dc:description "plant morphological traits, including reproductive structures, with uneven coverage";
    prov:wasDerivedFrom <https://www.try-db.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FlyBase";
    dc:description "developmental correlations and mutant effects that can show byproduct traits";
    prov:wasDerivedFrom <https://flybase.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "matrices of characters that systematists treat as high value";
    prov:wasDerivedFrom <https://morphobank.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch05-09 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-09--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch05-09 by Grok 4.7: 0.3";
