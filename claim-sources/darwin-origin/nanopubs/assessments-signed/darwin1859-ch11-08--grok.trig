sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch11-08: resolvable-now, resolvability 0.81";
    dc:description "Bathymetry and plate reconstructions directly record whether dry land connected today's separate continents and oceanic islands in the late Cenozoic. The continuous-union reading is decidable for the major continents and for true oceanic islands. Ambiguity is confined to intermittent bridges and to islands of disputed crustal type.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Using late Cenozoic plate reconstructions, bathymetry, and sea-level history, test whether now-separate continents, and those continents and oceanic islands, were joined by continuous dry land during the lifetime of extant species. Sustained land connections among them would refute the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Almost continuously and the period of existing species need explicit time bounds.", "Classifying an island as oceanic, rather than a continental fragment, is a geological judgment.", "Short-lived bridges have to be scored separately from permanent unions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-08--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.805"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EarthByte";
    dc:description "Late Cenozoic plate and shoreline reconstructions";
    prov:wasDerivedFrom <https://www.earthbyte.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch11-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GEBCO";
    dc:description "Bathymetry used with sea-level change to test possible land bridges";
    prov:wasDerivedFrom <https://www.gebco.net/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch11-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch11-08 by Grok 4.7: 0.75";
