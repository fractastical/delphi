sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch02-06: partially-resolvable, resolvability 0.53";
    dc:description "The wording is partly about how a term is used, and that part does not pick out a single measurement. The biological reading, that species and varieties are not different in kind, can be proxied with public distances and ranks and has the same limits as a continuum test. Competing species concepts keep any one gap from settling the essentialist contrast, which is why discriminating power stays modest.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Treat 'no essential difference' as overlap between the divergence, reproductive isolation, and phylogenetic depth of sets named as species and sets named as varieties, and treat 'arbitrary' as inter-author discordance in rank for the same populations. A unique biological gap that taxonomists recover repeatedly would count against the statement; overlapping distributions and unstable ranks would support the empirical reading.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Essentially' and 'for convenience' are philosophical even after a biological gap is defined.", "Different species concepts predict different gaps, so several operationalizations compete.", "Discordance among checklists measures nomenclatural practice as much as biology.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.48"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-06--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-06--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.531"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-06--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Barcode of Life Data Systems";
    dc:description "genetic distances across names ranked as species and as infraspecific forms";
    prov:wasDerivedFrom <https://boldsystems.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-06--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Catalogue of Life";
    dc:description "current rank assignments whose stability and cutoffs can be compared";
    prov:wasDerivedFrom <https://www.catalogueoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-06--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: World Flora Online";
    dc:description "botanical species and variety names, where the variety rank remains in use";
    prov:wasDerivedFrom <https://www.worldfloraonline.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch02-06 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-06--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-06--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch02-06 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-06--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-06--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch02-06 by Grok 4.7: 0.74";
