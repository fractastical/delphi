sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-04--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch05-04: partially-resolvable, resolvability 0.52";
    dc:description "The wind-selection hypothesis makes a habitat prediction that can be scored if wing condition is compiled for Madeira and comparable islands. Occurrence databases supply localities, not the morphological variable, so the limiting step is collation. The exposed-versus-sheltered contrast has real discriminating power against a generic island effect and still leaves disuse as a joint cause, which the original wording already allows.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare the proportion of flightless beetles between wind-exposed and sheltered habitats on Madeira and similar islands, and between those islands and mainland relatives. Higher flightlessness in exposed habitats would support selection by wind; equal rates in sheltered habitats and on calm islands would refute that specific agent. A residual role for disuse would remain if wing reduction also tracks lack of use within sheltered sites.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Disuse and wind selection predict overlapping reductions.", "Madeira is well studied, but a global island-insect sample is patchy.", "Wing state is not a field in occurrence databases and must be taken from faunas and specimens.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-04--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.521"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-04--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
    dc:description "island and habitat occurrences of ground beetles";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-04--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Catalogue of Life";
    dc:description "taxonomic roster of island beetle faunas to join to wing-state records";
    prov:wasDerivedFrom <https://www.catalogueoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-04--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch05-04 by Grok 4.7: 0.44";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.44"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-04--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-04--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch05-04 by Grok 4.7: 0.44";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.44"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-04--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-04--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
