sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch02-07: partially-resolvable, resolvability 0.60";
    dc:description "Range, plot, and flora databases contain the dominance variables and at least partial variety counts for plants, which is the stated scope. The classic sampling bias, that common plants attract more taxonomic attention, is large enough that an uncorrected regression would not discriminate the biological claim. A careful subset analysis is feasible; a global, bias-resistant one is not sitting ready to run.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Regress the number of well-marked varieties per species on geographic range, local occupancy, and abundance, within regional floras, with sampling effort as a covariate. A positive partial association for wide, common species would support the pattern; no association after effort is controlled would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Abundance, range, and 'variety' rank are complete together only for some regional floras.", "Darwin's dominance criteria (world range, local diffusion, and numbers) are only partly observed in the same records.", "Widespread species are collected and split more often, which manufactures varieties.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.605"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Botanical Information and Ecology Network";
    dc:description "plant occurrence, range, and abundance-related plot data";
    prov:wasDerivedFrom <https://bien.nceas.ucsb.edu/bien/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Inventory of Floras and Traits";
    dc:description "regional floras that list species and, unevenly, infraspecific taxa";
    prov:wasDerivedFrom <https://gift.uni-goettingen.de/home>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Map of Life";
    dc:description "range and occupancy surfaces used to score dominance";
    prov:wasDerivedFrom <https://mol.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch02-07 by Grok 4.7: 0.58";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch02-07 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch02-07 by Grok 4.7: 0.68";
