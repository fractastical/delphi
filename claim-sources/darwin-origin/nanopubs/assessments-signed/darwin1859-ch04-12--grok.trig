sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-12--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-12: partially-resolvable, resolvability 0.66";
    dc:description "Prolonged selfing or asexuality leaves genomic signatures, and the decisive lineages plus a sexual-system database are public. A universal claim can be challenged by those lineages without sequencing every hermaphrodite, but the flagship cases remain ambiguous because cryptic sex is hard to exclude. The analysis is standard for a small team and still short of a clean confirmation or refutation across plants and animals.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For hermaphrodites and candidate ancient asexuals, test genomes for meiosis genes, allele divergence, and the age of asexuality. The claim would be confirmed if every well-sampled lineage shows occasional outcrossing or a recent loss of sex. It would be refuted by a lineage that has persisted for many millions of years with no sex and no genomic sign of decline that an occasional cross would be needed to prevent.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Indispensable is a fitness claim that extant genomes record only indirectly.", "Many hermaphrodites still lack genomes dense enough for a Meselson-effect test.", "Rare sex, gene conversion, and horizontal transfer can mimic or mask long-term asexuality.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-12--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.662"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-12--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Tree of Sex";
    dc:description "sexual systems, including selfing and asexual lineages";
    prov:wasDerivedFrom <https://www.treeofsex.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-12--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "genomes of bdelloid rotifers and other putative ancient asexuals";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-12--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "placement and age context of asexual clades";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-12--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-12 by Grok 4.7: 0.64";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.64"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-12--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-12--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
