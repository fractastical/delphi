sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-22--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-22: resolvable-now, resolvability 0.83";
    dc:description "The comparison is a pair of ratios with a pre-registered null, and the regional inventories needed to compute it are public and global. Taxonomic rank is a real artefact, but it is handled inside the same analysis by random draws from the donor pool rather than left as an uncontrolled bias. A small team could confirm or refute the floral generalization with standard checklist joins.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For each regional flora, compute the naturalized-to-native ratio at genus rank and at species rank, and compare those ratios with a null that draws the same number of introductions from the global donor pool. A greater proportional gain of genera than of species, beyond that null, would confirm the claim; disappearance of the excess under the null, or across most regions, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Genus size and splitting conventions can create an excess of new genera under random introduction.", "Some regions have uneven native inventories.", "The pattern for plants need not extend to naturalized animals, which are outside the stated scope.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-22--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-22--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-22--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.826"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-22--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GloNAF";
    dc:description "naturalized alien plant species lists for regions worldwide";
    prov:wasDerivedFrom <https://glonaf.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-22--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GIFT";
    dc:description "native flora checklists at species and genus rank";
    prov:wasDerivedFrom <https://gift.uni-goettingen.de/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-22--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Catalogue of Life";
    dc:description "genus membership used in the donor-pool null";
    prov:wasDerivedFrom <https://www.catalogueoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-22--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-22 by Grok 4.7: 0.84";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.84"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-22--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-22--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-22 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
