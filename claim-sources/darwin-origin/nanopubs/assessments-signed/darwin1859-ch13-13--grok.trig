    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-13--grok>.
<https://w3id.org/delphi/resource/claim/darwin1859-ch13-13> <https://w3id.org/delphi/ontology/hasAssessment> <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-13--grok>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-13--grok--analysis-feasibility>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-13--grok--data-adequacy>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-13--grok--data-existence>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-13--grok--discriminating-power>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-13--grok--operationalizability>
