sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-08: partially-resolvable, resolvability 0.51";
    dc:description "Shared habits and structural sex differences can be scored with existing ecological and morphological compilations, but only after a substantial join to sex-specific descriptions. The historical claim that sexual selection was the main cause is harder: the same dimorphism is predicted by niche divergence, predation, and drift. The feasible analysis is a comparative partition for birds and mammals, not a direct reconstruction of cause.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Restrict the comparison to species whose sexes share diet and foraging stratum, then partition sexual dimorphism into ornamental versus ecological traits and ask which class accounts for more of the sex difference. Ornament-dominated dimorphism would support a mainly sexual-selection reading; ecological dimorphism in those same species would count against it. Causation remains an inference from the partition.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Calling a trait an ornament already leans on the sexual-selection hypothesis.", "Most global trait tables are not sex-specific, so ornament dimorphism must be joined from scattered sources.", "Niche similarity between sexes is coarsely coded.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-08--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-08--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.511"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EltonTraits";
    dc:description "species-level diet and foraging stratum as the shared niche background, without a sex split";
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.c.3306933>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AVONET";
    dc:description "morphological measurements for birds, mostly unsexed";
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.16586228>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-08--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: VertLife";
    dc:description "phylogenies for separating shared ancestry from sex-specific divergence";
    prov:wasDerivedFrom <https://vertlife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-08 by Grok 4.7: 0.54";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.54"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-08--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-08--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-08 by Grok 4.7: 0.42";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
