    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-13--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.684"^^xsd:double;
