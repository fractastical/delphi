<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-01--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of darwin1859-ch03-01 by Grok 4.7: 0.44";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-discriminating-power>;
