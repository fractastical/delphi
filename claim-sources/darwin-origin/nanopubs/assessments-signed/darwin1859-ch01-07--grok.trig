sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch01-07: partially-resolvable, resolvability 0.46";
    dc:description "Genomic distances and scattered 3D scans can compare some breed pairs with some congeneric species, which is a proxy for 'same manner' and 'lesser degree'. No open dataset systematically measures the same characters in domestic races and wild congeners across animals and plants. The qualitative wording admits several morphometric operationalizations, so a single result would be only partly decisive.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Place domestic breeds and closely allied wild congeners in one morphospace and one genetic-distance matrix, then compare the axes that separate breeds with the axes that separate species and compare the magnitudes. Similar axes with smaller breed distances would support the statement; breed differences concentrated on different axes, or as large as species differences, would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Same manner' depends on which characters are measured and on how morphospaces are aligned.", "Breed descriptors are categorical and uneven, while 3D coverage is sparse.", "Fertility when crossed and monstrous development, which the statement sets aside, are not in the same tables as shape.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.56"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-07--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.462"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "3D morphology for a subset of domestic breeds and wild relatives";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Ensembl";
    dc:description "genomic distances among breeds and wild congeners for sequenced species";
    prov:wasDerivedFrom <https://www.ensembl.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-07--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Domestic Animal Diversity Information System";
    dc:description "breed lists and coarse descriptors defining the domestic races";
    prov:wasDerivedFrom <https://www.fao.org/dad-is/en/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch01-07 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch01-07 by Grok 4.7: 0.36";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
