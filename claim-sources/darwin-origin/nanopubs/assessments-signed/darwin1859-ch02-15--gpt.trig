    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dominance has no single cross-taxon measure.", "Survivorship bias can create apparent rich-get-richer patterns.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-15--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-15--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-15--gpt--dataset-3>;
