    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-02--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch04-02: partially-resolvable, resolvability 0.62";
    dc:description "Neutrality and frequency fluctuation have standard population-genetic tests. Fitness-linked time series remain taxonomically sparse, and drift makes the literal expectation that variation stays fluctuating non-universal.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Classify heritable variants by measured fitness effect and compare temporal frequency variance and persistence of variants indistinguishable from neutral expectations. Support requires neutral variants to lack systematic selection while remaining polymorphic; systematic fitness effects or rapid directional fixation would refute the prediction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Drift also changes neutral variants and can eliminate polymorphism.", "Strict neutrality is difficult to establish rather than merely fail to reject.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.622"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "population genomic and time-series sequence data for allele-frequency analyses";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-02--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
