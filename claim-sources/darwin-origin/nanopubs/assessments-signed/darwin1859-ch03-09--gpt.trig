<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-09--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch03-09: partially-resolvable, resolvability 0.59";
    dc:description "Community stability is well represented in public time series, but the inferred mechanism and sensitivity to trifling changes are hard to distinguish from environmental stationarity. Present data resolve modern restricted versions.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify long-term turnover and compositional stability in communities while measuring interaction-strength fluctuations, and test whether small perturbations predict persistent state shifts. Low net turnover despite fluctuating interactions plus high sensitivity would support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fine balance of opposing forces is not directly observed.", "Most records are decades, not evolutionary long periods.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.69"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-09--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.595"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
