    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-11--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-11--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
