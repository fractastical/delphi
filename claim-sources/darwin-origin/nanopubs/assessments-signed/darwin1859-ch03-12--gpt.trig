<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch03-12: partially-resolvable, resolvability 0.64";
    dc:description "The comparison is clear and many individual datasets exist, but effect estimates require substantial compilation and cover limited taxa. Existing evidence can test a restricted meta-analytic version.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across competition experiments, compare interaction coefficients for congeneric species pairs with matched noncongeneric pairs, controlling functional similarity, environment and phylogenetic distance. Stronger average congeneric suppression supports the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Congeneric status conflates relatedness with niche similarity.", "Published interaction datasets are biased toward strong effects.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-12--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-12--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.641"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
