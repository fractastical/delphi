<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-17--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch04-17: partially-resolvable, resolvability 0.54";
    dc:description "Modern time series can test restricted temporal and regional versions. No existing resource observes selection consistently across all inhabitants and geological timescales.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate temporal rates of adaptive phenotypic or allele-frequency change and the fraction of co-occurring species showing selection in repeated community time series. Predominantly slow, episodic change affecting few species supports the claim; widespread rapid concurrent adaptation refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Very slowly' and 'long intervals' need arbitrary temporal thresholds.", "Ecological abundance change is not equivalent to natural selection.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.69"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-17--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-17--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-17--gpt--dataset-3>;
