sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch06-09: partially-resolvable, resolvability 0.63";
    dc:description "Public trees and morphological matrices make the direction of the transformation a standard ancestral-state problem, and that direction is the core of the historical claim. Soft-tissue function at the critical nodes is inferred rather than observed, so the flotation premise and the appeal to selection stay out of reach of the same datasets. The analysis is feasible for living osteichthyans and only a proxy for the unknown prototype.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Code lung versus swim bladder, and flotation versus respiration, on a molecular vertebrate tree and reconstruct the ancestral state for lung-bearing vertebrates. The claim is supported if that ancestor is reconstructed as having a flotation swim bladder and lungs are derived from it; it is refuted if lungs (or a non-flotation air organ) are ancestral and swim bladders arise later inside ray-finned fishes.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Coding lung and swim bladder as alternative states can smuggle in a homology decision.", "Selection as the converting agent is not recorded by character order alone.", "The flotation function and soft anatomy of the deep ancestor are rarely fossilized.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.627"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "vertebrate phylogeny for ancestral-state reconstruction of air-filled organs";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "fossil occurrences of early osteichthyans and sarcopterygians that bracket the relevant nodes";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "published morphological matrices that code respiratory and buoyancy structures in early vertebrates";
    prov:wasDerivedFrom <https://morphobank.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch06-09 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-09--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch06-09 by Grok 4.7: 0.52";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
