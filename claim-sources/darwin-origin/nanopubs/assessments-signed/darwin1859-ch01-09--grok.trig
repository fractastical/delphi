    <https://w3id.org/delphi/ontology/hasScore> "0.74"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-09--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-09--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
