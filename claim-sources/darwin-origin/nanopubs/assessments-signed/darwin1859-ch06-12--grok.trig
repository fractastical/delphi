sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-12--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch06-12: partially-resolvable, resolvability 0.62";
    dc:description "For the limb example and for bird and mammal ecology, open trees and trait tables support a standard comparative partition, and that analysis is weeks of work for a restricted scope. The claim is about most of the organization of every organism, which existing matrices do not cover. A correlation with current habits also would not prove that a trait arose for those habits, so the test is informative only for the mismatch Darwin named.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Partition skeletal characters among mammals or birds into phylogenetic signal versus diet, habitat, and locomotion from trait databases. The claim is supported if most characters, including the shared limb skeleton, track clade membership rather than present habits; it is refuted if current ecology explains the chief part of structure.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Phylogenetic signal can reflect constraint or low power rather than inheritance of unused structure.", "Trait databases cover a small slice of 'the chief part of organisation', mostly vertebrates.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-12--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.618"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-12--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: VertLife";
    dc:description "species-level trees for mammals and birds used to measure phylogenetic signal";
    prov:wasDerivedFrom <https://vertlife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-12--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EltonTraits 1.0";
    dc:description "diet, foraging stratum, and body size as measures of present habits of life";
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.c.3306933>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-12--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "3D limb and skeletal meshes for comparing homologous structure across divergent ecologies";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-12--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch06-12 by Grok 4.7: 0.68";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.68"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-12--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-12--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch06-12 by Grok 4.7: 0.48";
