sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch01-14: partially-resolvable, resolvability 0.64";
    dc:description "Crop wild-relative databases and floras now record progenitor status for a large set of long-cultivated plants, and sequence archives can supply distances for the staples. That is enough to test recognizability as a present-day fact and to compare it with divergence for well-studied crops. Extinction, hybridization, and thin coverage of ornamental garden plants keep the causal story, accumulated change as the reason parents are unknown, only partly identified.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For plants with the longest cultivation histories, score whether a wild progenitor is identified and measure genomic or phenotypic distance to the nearest wild relative. The explanatory claim would be supported if unidentified progenitors were exactly the most diverged stocks; it would be weakened if large divergence still left progenitors identifiable, or if unidentified parents were mostly extinct or unsampled rather than unrecognizably modified.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A wild parent may be unrecognizable because it is extinct or uncollected, not because the crop changed.", "Hybrid origins create several partial parents rather than one unrecognizable stock.", "Minor garden plants are far less completely linked to wild relatives than major staples.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.67"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-14--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-14--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.635"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: USDA GRIN";
    dc:description "crop wild-relative classification and accession records linking crops to progenitors";
    prov:wasDerivedFrom <https://npgsweb.ars-grin.gov/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-14--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Genesys";
    dc:description "genebank holdings of crops and wild relatives used to judge whether parents are known and sampled";
    prov:wasDerivedFrom <https://www.genesys-pgr.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-14--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: World Flora Online";
    dc:description "accepted names and taxonomy for cultivated species and candidate wild parents";
    prov:wasDerivedFrom <https://www.worldfloraonline.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch01-14 by Grok 4.7: 0.62";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.62"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-14--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-14--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
