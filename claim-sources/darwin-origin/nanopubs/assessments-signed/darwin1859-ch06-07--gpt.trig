    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch06-07: partially-resolvable, resolvability 0.60";
    dc:description "Comparative morphology and phylogenies can test graded transitions and functional plausibility. They cannot directly observe the complete historical path or uniquely attribute it to natural selection.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Map eye complexity, optical performance, ecology, and phylogeny across arthropods, then test whether inferred transitions are mostly small and whether intermediate states improve performance. A well-supported phylogenetic sequence lacking viable intermediates would count against the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fitness effects of historical intermediate eyes are usually unmeasured.", "Living forms are not literal ancestors.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-07--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-07--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.605"^^xsd:double;
