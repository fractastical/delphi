sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch06-10: resolvable-now, resolvability 0.75";
    dc:description "The claim is existential: similar organs have sometimes been built independently. Electric fishes are the stated example, and public genomes, expression studies, and trees already contain the variables needed to separate convergence from homology. A small team can rerun that test in weeks. Other named cases are thinner, but they are not required to confirm or refute the 'sometimes' statement.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Map electric organs, and the tissues and genes that build them, onto a molecular fish tree. Independent origins from non-homologous muscle or nerve pathways confirm that similar organs need not be inherited from a common ancestor; a single origin with shared developmental identity would refute that reading for this case.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Luminous insects and the orchid–Asclepias cases are less completely sequenced than electric fishes.", "Repeated origins show convergence more cleanly than they show that selection, rather than constraint, produced the similarity.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "genomes and ion-channel sequences of electric fishes used to test independent origins";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "phylogeny of teleosts and cartilaginous fishes on which electric organs can be mapped";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-10--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Gene Expression Omnibus";
    dc:description "electric-organ versus muscle expression studies that show whether similar organs reuse the same inherited pathway";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/geo/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch06-10 by Grok 4.7: 0.78";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.78"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-10--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch06-10 by Grok 4.7: 0.64";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
