    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-07--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch05-07: partially-resolvable, resolvability 0.63";
    dc:description "Broad occurrence, climate and interaction resources support comparative variance-partitioning. Observational correlations and missing interactions prevent a decisive global causal comparison.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Partition explained variation in range limits between climate and biotic-interaction predictors across many species, supplemented by transplants or invasions beyond native boundaries. A median biotic contribution at least as large as climate supports the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Climate and competitors covary spatially.", "Interaction databases omit many weak, local or context-dependent interactions.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.625"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "species distributions and co-occurrence patterns";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: WorldClim";
    dc:description "climate predictors across ranges";
    prov:wasDerivedFrom <https://www.worldclim.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-07--gpt--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biotic Interactions";
    dc:description "documented antagonistic and mutualistic interactions";
    prov:wasDerivedFrom <https://www.globalbioticinteractions.org/>.
