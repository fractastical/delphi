    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-05--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch06-05: partially-resolvable, resolvability 0.64";
    dc:description "Public fossil and morphology resources permit explicit ancestral-state analyses. The critical transition is poorly sampled, so existing data can constrain but not decisively recover the origin of bat flight.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Reconstruct bat ancestry using fossil-calibrated mammal phylogenies and compare ancestral forelimb and membrane characters with extant and fossil gliders. Transitional gliding-adapted anatomy predating powered-flight characters supports the claim; evidence for a non-gliding ancestor or alternative functional sequence refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Soft flight membranes are rarely preserved and extant gliders are not necessarily ancestral analogues.", "The earliest known bats were already capable of powered flight.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.77"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-05--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-05--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-05--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "fossil bat and mammal occurrences and ages";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-05--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "morphological phylogenetic matrices for fossil and living mammals";
    prov:wasDerivedFrom <https://www.morphobank.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-05--gpt--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "three-dimensional anatomy of bats and gliding mammals";
