sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch01-11: partially-resolvable, resolvability 0.52";
    dc:description "Public genomes and a Mendelian catalogue can show, for major domestic species, whether breed differences look accumulated or single-step. That is a proxy for the historical mechanism, and it covers a minority of domesticated animals and plants. Mixed architectures mean the result can reject a purely sudden origin more readily than it can crown accumulative selection as the key cause.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Classify breed-defining differences by genetic architecture and by the time series of allele frequencies from ancient to modern animals: many successive small shifts versus a single large-effect origin. A predominance of multi-locus, temporally accumulated change aligned with breeding goals would support accumulative selection; a predominance of one-step sports that already match the finished breed would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ancient DNA time series exist for a few species and preserve only part of the phenotype.", "Archaeological morphology cannot show that a breeder, rather than natural selection or drift, accumulated the changes.", "Both large-effect mutations and polygenic selection are real, so 'the key cause' is a balance, not a yes-or-no.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.518"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "ancient and modern domestic genomes for allele-frequency trajectories";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: European Variation Archive";
    dc:description "present-day variant catalogues for polygenic versus large-effect breed differences";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/eva/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Online Mendelian Inheritance in Animals";
    dc:description "catalogued large-effect breed mutations that represent the sudden-origin alternative";
    prov:wasDerivedFrom <https://omia.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch01-11 by Grok 4.7: 0.48";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.48"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch01-11 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch01-11 by Grok 4.7: 0.6";
