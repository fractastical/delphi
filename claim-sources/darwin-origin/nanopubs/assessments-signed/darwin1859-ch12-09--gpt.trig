    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch12-09: resolvable-now, resolvability 0.92";
    dc:description "The numerical universal is exceptionally clear and readily falsified using global mammal and island data. Historical introductions require auditing but do not make the analysis impractical.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Cross-reference native non-volant mammal ranges with island distance and geological origin, excluding human introductions and formerly connected continental islands. A verified native population beyond 300 miles refutes the threshold claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Past sea level altered distances and connections.", "Prehistoric human translocations can masquerade as native populations.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.95"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-09--gpt--dataset-3>;
