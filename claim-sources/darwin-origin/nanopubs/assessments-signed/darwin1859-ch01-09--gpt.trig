<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-09--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch01-09: resolvable-now, resolvability 0.90";
    dc:description "Extensive modern and ancient canid genomes are public, and standard admixture and demographic models directly distinguish the alternatives. Residual ambiguity concerns semantics of descent and extinct sources, not data availability.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit demographic ancestry models to whole genomes from global dogs and candidate wild canids, testing one-source against multiple-species ancestry. Significant ancestry from several distinct wild species supports the claim; a single ancestral species with later limited introgression refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ancient introgression can be confused with multiple domestication sources.", "Extinct source populations may be unsampled.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.95"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-09--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-09--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.896"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
