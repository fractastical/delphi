sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch03-02: partially-resolvable, resolvability 0.56";
    dc:description "Naturalization inventories and range products document rapid spread, and demographic matrices contain the fecundity-versus-survival contrast for a subset. The mechanism is testable where both ranges have vital rates and is only inferred from occurrence elsewhere. Animal invasions and evolved fertility changes keep the full statement partly unresolved.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare fecundity of species in native versus introduced ranges, and compare survival or population growth over the same contrast, for naturalized plants and animals. Rapid spread with unchanged fecundity and higher survival would support geometrical increase under lower mortality; a systematic rise in fertility sufficient to explain the increase would count against the stated mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Evolved increases in fecundity and enemy-release effects on body size can raise fertility after introduction.", "GloNAF covers plants, while the statement also includes animals.", "Vital-rate comparisons in both ranges exist for far fewer species than naturalization records.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-02--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.562"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch03-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Naturalized Alien Flora";
    dc:description "which plants are naturalized where, the spread outcome for floras";
    prov:wasDerivedFrom <https://glonaf.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch03-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: COMPADRE and COMADRE";
    dc:description "vital rates for some invasive and native populations";
    prov:wasDerivedFrom <https://compadre-db.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch03-02--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Map of Life";
    dc:description "occupied range of introduced species as a measure of spread";
    prov:wasDerivedFrom <https://mol.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch03-02 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-02--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch03-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch03-02 by Grok 4.7: 0.44";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
