sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-15--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch06-15: partially-resolvable, resolvability 0.46";
    dc:description "The skull-suture example can be examined as a timing-of-function question with existing trees and matrices, but only after substantial interpretation of what 'laws of growth' and 'at first of no advantage' mean. The quantitative claim that many modifications follow this path has no dataset. Even a clear sequence would not separate later co-option from an earlier, undetected function.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: On an amniote tree, date the origin of skull sutures relative to live birth and ask whether sutures are present in egg-laying relatives that do not use them in parturition. Origin of the trait before its mammalian use supports co-option in that example; a suture system that appears with live birth would count against it. 'Many modifications' would further require a frequency across traits.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "No catalog records which modifications began as non-adaptive byproducts.", "Original lack of advantage is a historical negative that current non-use does not prove.", "Suture function during birth is not a field in trait databases.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-15--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-15--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-15--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.461"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-15--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "amniote phylogeny for ordering sutures against reproductive mode";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-15--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
    dc:description "matrices that code cranial sutures and reproductive characters in reptiles and mammals";
    prov:wasDerivedFrom <https://morphobank.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch06-15--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: VertLife";
    dc:description "dated trees for mammals and squamates used to place the origin of live birth";
    prov:wasDerivedFrom <https://vertlife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-15--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch06-15 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-15--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch06-15--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch06-15 by Grok 4.7: 0.38";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
