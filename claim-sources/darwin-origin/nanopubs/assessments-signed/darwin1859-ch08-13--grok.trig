sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch08-13: resolvable-now, resolvability 0.73";
    dc:description "Public mapping populations record both phenotypes across hybrid generations and markers that identify the cause of the extra variance. The pattern Darwin reported is therefore decidable, and the disturbed-reproduction explanation can be separated from ordinary segregation. Coverage is a subset of all hybrids but includes both plants and animals at a scale a small team can analyze with standard quantitative genetics.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare phenotypic variance of F1 hybrids with variance in F2 and later generations, and inspect marker segregation. Much greater later-generation variance confirms the pattern; equal variance refutes it. Segregation of intact parental alleles refutes a disturbed reproductive system as the cause, whereas chaotic gamete failure would support that cause.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Later-generation variance also rises because of recombination even when fertility is normal, which is the alternative cause.", "Mapping populations are richer for crops and model animals than for arbitrary hybrids.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-13--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-13--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.727"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MaizeGDB";
    dc:description "mapping populations and phenotypes for comparing first-generation and later-generation hybrid variance";
    prov:wasDerivedFrom <https://www.maizegdb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: 1001 Genomes";
    dc:description "Arabidopsis accessions and recombinant populations with genotypes that show whether later-generation variation is Mendelian";
    prov:wasDerivedFrom <https://1001genomes.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-13--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FlyBase";
    dc:description "Drosophila cross and phenotype records for F1 uniformity versus later segregation";
    prov:wasDerivedFrom <https://flybase.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch08-13 by Grok 4.7: 0.72";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-13--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch08-13 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-13--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-13--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch08-13 by Grok 4.7: 0.7";
