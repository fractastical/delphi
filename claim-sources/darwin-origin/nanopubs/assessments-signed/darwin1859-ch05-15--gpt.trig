<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-15--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch05-15: partially-resolvable, resolvability 0.49";
    dc:description "Modern genetics can test Darwin's transmission model in documented recent cases. Existing data rarely span enough generations to distinguish all proposed routes for long-lost characters.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For pedigreed reappearance events, test whether causal ancestral alleles or regulatory states were transmitted cryptically through intervening generations and became expressed under particular genetic or environmental conditions. Demonstrated continuous transmission supports the claim; a genuinely new mutation producing the resemblance refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Historical breed pedigrees and DNA over hundreds of generations are unavailable.", "Reappearance can arise from retained alleles, epigenetics, recombination or new mutation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.65"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-15--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-15--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.492"^^xsd:double;
