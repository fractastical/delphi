sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch01-13: partially-resolvable, resolvability 0.37";
    dc:description "The process can be approximated with long phenotypic series under weak selection, but public breed systems do not encode intent or century-scale pedigrees. Landrace collections and breed lists support only a static proxy. Environment and methodical selection remain tangled with any trend that can be assembled from papers and herd books.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Track phenotypic or breeding-value change in populations where the recorded practice was only 'breed from the best animals' without a written improvement target, over multi-decade to century scales, and compare the direction of change with methodical breeding programmes. Sustained change in the preferred direction under the weaker practice would support the claim; stasis once methodical goals are absent would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Historical records rarely label a breeding practice as unconscious rather than methodical.", "Nutrition, climate, and market standards change the phenotype in parallel with any breeding choice.", "Open breed databases do not store century-long individual pedigrees tied to selection criteria.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.5"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-13--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.368"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Domestic Animal Diversity Information System";
    dc:description "breed identity and coarse status over recent decades, not century-scale unconscious selection";
    prov:wasDerivedFrom <https://www.fao.org/dad-is/en/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: USDA GRIN";
    dc:description "landrace accessions that preserve older cultivated stocks for a static comparison";
    prov:wasDerivedFrom <https://npgsweb.ars-grin.gov/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch01-13 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch01-13 by Grok 4.7: 0.28";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.28"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch01-13 by Grok 4.7: 0.38";
