sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch07-05: partially-resolvable, resolvability 0.59";
    dc:description "A large public compilation of approach distances makes the island-tameness and body-size contrasts testable for birds, together with range and threat data. That is a proxy for acquired fear, not a measurement of the rate of acquisition or of heritability. Confounds are serious enough that a positive correlation would remain ambiguous, and non-bird scope is barely covered.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Regress flight-initiation distance on island isolation, history of human presence, hunting pressure, and body size. Longer distances where persecution has been longer or more intense, and shorter distances on uninhabited islands, would support the claim; no such pattern, or a pattern explained by predator fauna alone, would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Flight distance confounds evolved fear, individual learning, habitat, and the background predator community.", "Geographic bias toward Europe, North America, and Australia leaves many persecution histories unsampled.", "The compilations are snapshots, so they do not measure the word 'slowly'.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.589"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Database of bird flight initiation distances";
    dc:description "compiled alert and flight-initiation distances as a measure of fear of approaching humans";
    prov:wasDerivedFrom <https://doi.org/10.3996/082015-jfwm-078>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GBIF";
    dc:description "island versus continental distributions of the species in the flight-distance compilation";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: IUCN Red List";
    dc:description "hunting and persecution coded among threats, as a proxy for exposure to humans";
    prov:wasDerivedFrom <https://www.iucnredlist.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch07-05 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch07-05 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch07-05 by Grok 4.7: 0.62";
