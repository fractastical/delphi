    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch13-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch13-12: partially-resolvable, resolvability 0.70";
    dc:description "Numerous fossils and phylogenetic methods permit direct tests for several major gaps. The assertion about all class-level intervals cannot be completely resolved because extinct diversity is incompletely sampled.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use dated phylogenies and fossils to identify stem groups with intermediate character combinations and estimate whether lineage extinction enlarged morphological gaps between surviving crown groups. Discovery and temporal loss of intermediates, especially on the bird stem, supports the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Morphological gaps depend on character choice and surviving sampling.", "The fossil record cannot reveal forms lost without preservation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-12--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-12--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.704"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-12--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "occurrences and ages of extinct connecting forms";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-12--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoBank";
