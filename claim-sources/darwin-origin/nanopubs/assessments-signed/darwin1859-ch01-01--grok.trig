sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-01--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch01-01: partially-resolvable, resolvability 0.57";
    dc:description "The comparison itself maps cleanly onto within-group dispersion, and public variant archives plus breed lists cover the main livestock and crop species. A full phenotypic test of older cultivated varieties against wild relatives still has to be compiled from studies and gene banks. The contrast can discriminate the stated pattern from its opposite for that subset, with the caveat that today's uniform breeds are a biased sample of what Darwin observed.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare within-variety coefficients of variation, or genomic heterozygosity, for homologous characters in long-cultivated populations and in wild populations of the parent species. Greater within-group dispersion in the domestic samples would support the contrast; equal or smaller domestic dispersion across a pre-registered trait set would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Genetic heterozygosity and visible individual differences can move in opposite directions after a domestication bottleneck.", "Individual-level phenotypic measurements are scattered, while public sequence archives over-represent a few commercial species.", "Modern breed standards have deliberately reduced within-breed differences since the nineteenth century.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.569"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: European Variation Archive";
    dc:description "within-population genetic variation for domestic species and some wild relatives";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/eva/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Domestic Animal Diversity Information System";
    dc:description "breed inventories used to define the domestic varieties being compared";
    prov:wasDerivedFrom <https://www.fao.org/dad-is/en/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch01-01--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Ensembl";
    dc:description "reference variation for major crops and livestock with sequenced wild relatives";
    prov:wasDerivedFrom <https://www.ensembl.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-01--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch01-01 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch01-01--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch01-01 by Grok 4.7: 0.42";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
