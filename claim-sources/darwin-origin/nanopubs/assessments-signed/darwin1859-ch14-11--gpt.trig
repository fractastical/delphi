    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch14-11: partially-resolvable, resolvability 0.69";
    dc:description "Retrospective fossil cohorts can test close analogues of the prediction. They cannot literally resolve the future fate of present species, and genealogical descent is often uncertain.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In fossil intervals, treat species present at an earlier time as the prediction cohort and test whether initially common, widespread species in species-rich clades disproportionately persist or give rise to later diversity. Low descendant survival overall and positive effects of abundance, range and clade dominance support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Direct ancestor-descendant links are rarely known.", "Observed abundance and range are highly sampling-dependent.", "The far future of living species is not directly testable.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-11--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.688"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-11--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "fossil abundance proxies, range, persistence and descendant diversity";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-11--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Neotoma Paleoecology Database";
