<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch04-10: partially-resolvable, resolvability 0.57";
    dc:description "Modern genetics can test the exclusivity claim and existing cases include both small and large effects. It cannot reconstruct every adaptive transition or cleanly separate initial mutation size from later modification.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For documented adaptive transitions, estimate effect sizes of causal inherited variants and reconstruct whether phenotypic change accumulated through small beneficial steps or large-effect mutations. Recurrent adaptive large-effect changes would refute the exclusive 'infinitesimally small' assertion.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Surviving genomic signatures underrepresent old or polygenic adaptations.", "The phrase 'infinitesimally small' lacks a unique modern threshold.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.575"^^xsd:double;
