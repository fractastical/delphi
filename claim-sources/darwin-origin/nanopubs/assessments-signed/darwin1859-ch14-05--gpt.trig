<https://w3id.org/delphi/resource/assessment/darwin1859-ch14-05--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch14-05: partially-resolvable, resolvability 0.59";
    dc:description "Continuity and divergence can be quantified for many groups. The exclusive, conceptual claim about the only distinction and classificatory convenience is not fully empirically resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure genetic and phenotypic continuity within named varieties and species, including fossil or phylogenetic evidence for lost intermediates, and test whether discontinuity alone distinguishes the categories. Continuity gradients would support the empirical portion, but cannot establish that the distinction is only one of convenience.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Former intermediates are absent by definition and often unpreserved.", "Reproductive isolation provides distinctions beyond observed intermediates.", "Species and variety are partly conventional categories with multiple concepts.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.81"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-05--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-05--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-05--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.594"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
