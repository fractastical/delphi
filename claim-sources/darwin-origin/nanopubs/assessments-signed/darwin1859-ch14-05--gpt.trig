    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: European Variation Archive";
    dc:description "within- and between-population genetic variation";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/eva/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch14-05--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
