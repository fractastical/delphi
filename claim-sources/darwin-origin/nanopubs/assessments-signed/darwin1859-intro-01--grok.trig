sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-01--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-intro-01: partially-resolvable, resolvability 0.47";
    dc:description "Climate layers, trait compilations, and interaction records exist and can support a residual test for some well-known plant-animal systems. They do not cover the full range of coadapted structures, and several plausible mappings from Darwin's wording onto variables compete. Even a large residual for biotic partners would leave room for correlated selection and unmeasured food variables, so the result would be informative mainly for particular systems.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit trait and interaction models for coadapted structures (foraging morphology, host and pollinator links) against climate- and diet-only models. The external-conditions account would be supported if climate and food variables left little residual association between the coadapted traits and the partner organisms; it would be weakened if biotic partners explained that structure after climate and phylogeny were controlled.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Phylogenetic inertia and historical biogeography produce trait-environment correlations that mimic a direct climatic explanation.", "Quantitative functional morphology for animals such as woodpeckers is scattered, so most tests would use a biased subset of well-studied interactions.", "What counts as a complex coadaptation, and as fully accounting for it, has to be stipulated before any model comparison is decisive.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-intro-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-intro-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-intro-01--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.469"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-intro-01--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TRY Plant Trait Database";
    dc:description "plant functional traits for comparing climate-only models with traits tied to other organisms";
    prov:wasDerivedFrom <https://www.try-db.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-intro-01--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: WorldClim";
    dc:description "climate layers as the external-conditions predictors";
    prov:wasDerivedFrom <https://www.worldclim.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-intro-01--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biotic Interactions";
    dc:description "recorded host, pollinator, and consumer links for coadaptation case studies";
    prov:wasDerivedFrom <https://www.globalbioticinteractions.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-01--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-intro-01 by Grok 4.7: 0.42";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.42"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-intro-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-01--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-intro-01 by Grok 4.7: 0.36";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
