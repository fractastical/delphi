    <https://w3id.org/delphi/ontology/hasScore> "0.36"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-intro-01--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-intro-01--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-intro-01 by Grok 4.7: 0.68";
