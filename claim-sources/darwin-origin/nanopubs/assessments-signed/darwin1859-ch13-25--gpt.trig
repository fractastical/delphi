<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch13-25--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch13-25: partially-resolvable, resolvability 0.54";
    dc:description "Modern comparative genomics can discriminate mechanisms in selected repeated losses. The Lamarckian component and global predominance claim are poorly operationalized and inadequately sampled.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Across replicated losses such as cave eyes and island-bird wings, compare genomic and phenotypic signatures predicted by relaxed selection, direct selection for reduction and inherited effects of use. Estimate which process explains most reductions and whether developmental timing predicts embryonic retention.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Darwin's inherited disuse differs from modern relaxed selection and is hard to map unambiguously.", "Selection, drift and developmental pleiotropy produce overlapping signatures.", "The claim that disuse is the main agency requires representative global cases.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.79"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-25--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-25--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-25--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.542"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-25--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "sequences from lineages with reduced organs";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-25--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: European Nucleotide Archive";
    dc:description "genomic data for relaxed-selection and selection tests";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/ena/browser/home>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch13-25--gpt--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
