sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch05-05: partially-resolvable, resolvability 0.47";
    dc:description "The claim names a cause, disuse alone, and explicitly sets selection aside, so molecular signatures of selection are relevant in principle. Those signatures are public for a small set of cave species and absent for most of the scope. Where genomes exist, the analysis can challenge the exclusion of selection without measuring disuse directly.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: In cave lineages with sequenced eye-loss genes, test for relaxed constraint, positive selection, or pleiotropy with other cave phenotypes. Neutral loss independent of selection would support a disuse-or-drift reading; repeated signatures of selection or pleiotropic benefit would refute the claim that eyes were lost wholly without selection. Mapping disuse onto neutral degeneration is an interpretive step.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Disuse, as inheritance of an acquired loss, is not a variable in sequence data.", "Genetic tests exist for a few models, especially Astyanax, not for most cave animals.", "Pleiotropy can look like selection on eyes when selection acted on a linked trait.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.466"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "genomes and eye-development genes of cave fishes and other cave taxa";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AmphibiaWeb";
    dc:description "cave and surface salamander distributions and relationships";
    prov:wasDerivedFrom <https://amphibiaweb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "placement of cave species among surface relatives";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch05-05 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
