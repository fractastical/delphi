<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-01--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch05-01: partially-resolvable, resolvability 0.58";
    dc:description "Modern genomics can compare variability and test environmental effects in particular systems. Existing observational data poorly isolate changed conditions acting through the reproductive system from demographic and selective causes.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare mutation, recombination, developmental anomaly and phenotypic-variance rates in matched wild and domesticated populations across multigenerational environmental histories. Higher heritable novelty after altered conditions, mediated by germline changes, supports the mechanism.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Domestication includes bottlenecks, admixture and deliberate selection.", "Historical ancestral environments and germline disturbance are rarely measured directly.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-01--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-01--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-01--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.582"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-01--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "wild and domesticated population genomes for mutation and variation estimates";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/sra>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-01--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
