sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-07--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-07: partially-resolvable, resolvability 0.44";
    dc:description "Short-term genetic covariances and phylogenetic associations are available as proxies, and they can show that preference is capable of shifting male traits in particular species. They do not replay the historical, multi-thousand-generation process, and a negative result in one clade would leave the possibility claim standing. Existing public data therefore test a restricted, present-day proxy and do not separate female choice from other sexual selection.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate the genetic covariance between female preference and male song or plumage, and test whether ornament elaboration increases with preference along bird phylogenies. A positive evolutionary response to preference would support the capacity. The wording is a possibility over thousands of generations, so failure in studied species would not refute it, and male-male competition predicts the same ornaments.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Female preference time series over many generations do not exist.", "Male-male competition and female choice produce overlapping ornament patterns.", "Song archives and morphological averages omit the preference-trait covariance.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.439"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BirdTree";
    dc:description "bird phylogenies for comparing ornament evolution across lineages";
    prov:wasDerivedFrom <https://birdtree.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AVONET";
    dc:description "tail, wing, and body measurements as partial ornament and display proxies";
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.16586228>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-07--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: xeno-canto";
    dc:description "song recordings that document vocal phenotypes, not preferences";
    prov:wasDerivedFrom <https://xeno-canto.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-07--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-07 by Grok 4.7: 0.46";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.46"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-07--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-07--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-07 by Grok 4.7: 0.34";
