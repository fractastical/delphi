    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch04-16: partially-resolvable, resolvability 0.67";
    dc:description "The turnover and relict predictions are testable using large public fossil and phylogenetic resources. Habitat biases and the indirect inference from small area to weak competition limit causal resolution.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare freshwater, marine and terrestrial lineages for origination, extinction, lineage age and phylogenetic distinctiveness. Slower turnover and a greater excess of old isolated lineages in freshwater support the prediction, although competition would require separate evidence.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Freshwater fossil preservation and sampling differ from marine records.", "Turnover differences cannot by themselves identify competition as the cause.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-16--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-16--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-16--gpt--dataset-3>;
