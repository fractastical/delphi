sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-26--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch04-26: partially-resolvable, resolvability 0.70";
    dc:description "Extinction of orders, families, and genera is directly countable by joining the fossil record to a living checklist, and that half of the statement is within reach of a standard analysis. Whether a particular ancient species has living modified descendants is usually unknowable and is proxied by survival of its higher taxon. The qualitative scarcity of surviving deep-time lineages is robust in well-sampled groups, but it is not a species-by-species resolution of the full tree.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Join fossil occurrences in deep time bins to living checklists and phylogenies, and compute the fraction of species, genera, families, and orders with any living descendant lineage. A very small species fraction and a large number of wholly extinct higher taxa would confirm the claim; survival of a large share of ancient species-lineages, or rarity of higher-taxon extinction, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Extinct names can hide surviving lineages that were reclassified.", "Species-level ancestor-descendant links are almost never resolved, so higher taxa stand in for them.", "The fossil record samples a biased subset of past species.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-26--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-26--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-26--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.701"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-26--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "taxonomic occurrences and last appearances through geological time";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-26--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Catalogue of Life";
    dc:description "living species and higher taxa used to score survival";
    prov:wasDerivedFrom <https://www.catalogueoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch04-26--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "lineage connections between fossil groups and living clades";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-26--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch04-26 by Grok 4.7: 0.76";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.76"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-26--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch04-26--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch04-26 by Grok 4.7: 0.58";
