    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch10-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
