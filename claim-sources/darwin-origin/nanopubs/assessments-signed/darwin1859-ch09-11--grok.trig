    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-11--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch09-11--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
