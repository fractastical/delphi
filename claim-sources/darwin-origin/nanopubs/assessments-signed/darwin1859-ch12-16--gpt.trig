    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-16--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-16--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.796"^^xsd:double;
