    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "occurrence-derived geographic range sizes";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-17--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
