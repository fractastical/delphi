<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-17--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch12-17: partially-resolvable, resolvability 0.61";
    dc:description "Range size is measurable, but the explanatory variable requires a substantial and contestable modern reinterpretation. Existing data can test trait-specific proxies, not Darwin's ordering as stated.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Replace the obsolete lower-to-higher scale with prespecified traits such as body size, propagule size, structural complexity or clade age, and model geographic range size across species. The claim is supported only for operationalizations showing a robust negative association with range.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Occurrence density and taxonomy differ sharply among groups.", "The 'scale of nature' has no accepted measurable ordering.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-17--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-17--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.613"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
