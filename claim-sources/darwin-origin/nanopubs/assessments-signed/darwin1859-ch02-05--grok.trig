sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch02-05: partially-resolvable, resolvability 0.47";
    dc:description "Sequence and tree archives can line up close forms into a divergence series, which proxies the descriptive half. They seldom include the fitness or selection measures needed to show that natural selection, rather than drift, accumulates the steps. The mechanistic ranking is therefore only partly testable, and only in complexes that happen to have both ranks and population genomics.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Along phylogeographic series, test whether populations ranked as slight varieties, marked varieties, and species differ by increasing, directionally selected trait change rather than by drift-sized divergence. A graded series whose steps are enriched for selected loci would support natural selection as the main passage; series produced by isolation and drift alone would count against that attribution.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Incipient species' and 'definite directions' need a threshold that is not in the original wording.", "Drift, founder events, and selection all produce stepped divergence.", "Selection scans and variety ranks are rarely in the same public table outside a few model complexes.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.54"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-05--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-05--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.469"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Barcode of Life Data Systems";
    dc:description "population and species clusters used as a proxy for varieties and incipient species";
    prov:wasDerivedFrom <https://boldsystems.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "placement of close relatives on phylogenies";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch02-05--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI GenBank";
    dc:description "multilocus data for divergence and selection scans in well-studied complexes";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch02-05 by Grok 4.7: 0.46";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.46"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-05--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch02-05 by Grok 4.7: 0.4";
