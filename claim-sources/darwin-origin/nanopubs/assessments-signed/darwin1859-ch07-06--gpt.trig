    prov:wasDerivedFrom <https://www.animalgenome.org/cgi-bin/QTLdb/index>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch07-06--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Sequence Read Archive";
    dc:description "genomes of domestic breeds and wild relatives";
