<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch07-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch07-06: partially-resolvable, resolvability 0.56";
    dc:description "Selection on domestic behaviour is testable in several species. Partitioning historical change between selection and inherited habit is not adequately supported by current datasets.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare domestic breeds and wild relatives for behavioural phenotypes, genomic selection signals, and experimentally demonstrated transgenerational habit effects. Selection signatures tied to breed histories support human selection; inherited acquired habits would require independent evidence.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Darwin's inherited habit mechanism does not map cleanly to modern inheritance.", "Historical unconscious selection is poorly recorded.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.68"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-06--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.555"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
