    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch14-10: partially-resolvable, resolvability 0.45";
    dc:description "Some cognitive traits admit comparative tests, but 'each mental power' is too broad and requires substantial interpretation. Current open data are sparse and biased toward a few taxa.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For prespecified cognitive capacities, map standardized behavioral and neural traits onto phylogenies and test whether complex states arise through ordered intermediate states rather than abrupt transitions. Repeated graded sequences support the claim for those capacities.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Ancestral cognition does not fossilize directly.", "Mental powers are heterogeneous and difficult to compare across species.", "Phylogenetic gradualism can be mimicked by coarse trait coding.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch14-10--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.446"^^xsd:double;
