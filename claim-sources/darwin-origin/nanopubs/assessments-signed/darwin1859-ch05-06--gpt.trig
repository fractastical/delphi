<https://w3id.org/delphi/resource/assessment/darwin1859-ch05-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch05-06: resolvable-now, resolvability 0.89";
    dc:description "The prediction is a direct phylogeographic comparison and abundant public sequence and occurrence records exist. Standard phylogenetic analyses can resolve it across many independent cave clades within weeks.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Build phylogenies containing cave and nearby surface taxa from North America and Europe, and compare whether cave species cluster by continent or cave habitat. Repeated sister relationships to same-continent surface lineages support the prediction; a transcontinental cave clade would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Some cave taxa lack sequence data or reliable locality metadata.", "Taxonomic sampling differs between continents.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.91"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.886"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI GenBank";
    dc:description "sequence data for cave and surface taxa";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Global Biodiversity Information Facility";
    dc:description "continental and cave occurrence records";
    prov:wasDerivedFrom <https://www.gbif.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--gpt--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
