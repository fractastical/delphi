sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch12-11: resolvable-now, resolvability 0.73";
    dc:description "Depth, distance, species lists and phylogenetic relatedness are standard variables, and the partial-regression criterion follows the claim's 'independent of distance' wording directly. Open bathymetry, mammal range maps and a dated mammal tree cover most continental islands, with weaker native-status data for small islands. The comparison is a routine spatial analysis, though land-bridge history and introductions keep it from being fully clean.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For continental and near-continental islands, regress terrestrial-mammal species sharing and mean phylogenetic distance to the nearest mainland on minimum intervening sea depth, with geographic distance and island area held constant. The claim is confirmed if greater depth still predicts fewer shared species and more distant allies, and refuted if depth adds no partial association or the slope reverses.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Introduced mammals and incomplete native inventories can inflate or deflate apparent sharing.", "Island area, climate and human history remain confounded with depth even after distance is controlled.", "Modern depth is an imperfect stand-in for Pleistocene land connections, because channels shallower than past lowstands were periodically dry.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-11--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-11--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.735"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-11--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GEBCO";
    dc:description "Gridded global bathymetry for the minimum sea depth of channels between islands and the nearest mainland.";
    prov:wasDerivedFrom <https://www.gebco.net/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-11--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: IUCN Red List";
    dc:description "Range maps of terrestrial mammals used to score species shared between an island and the neighbouring mainland.";
    prov:wasDerivedFrom <https://www.iucnredlist.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch12-11--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: VertLife";
    dc:description "Species-level mammal phylogeny for measuring how closely allied island and mainland mammals are.";
    prov:wasDerivedFrom <https://vertlife.org/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-11--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch12-11 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.7"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-11--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch12-11--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch12-11 by Grok 4.7: 0.7";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
