<https://w3id.org/delphi/resource/assessment/darwin1859-ch02-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on darwin1859-ch02-11: resolvable-now, resolvability 0.85";
    dc:description "Sequence databases provide millions of comparable species distances and taxonomies provide genus sizes. The predicted contrast can be tested quickly and robustly across clades.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare standardized pairwise genetic and morphological distances among species in large versus small genera, with phylogenetic age and sampling controls. Smaller within-genus distances in large genera support the claim.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Large genera may be younger or taxonomically oversplit.", "Morphological coverage is uneven.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.9"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-11--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-11--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.853"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
