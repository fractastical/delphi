sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on darwin1859-ch08-06: partially-resolvable, resolvability 0.71";
    dc:description "Genetic distance is a better independent measure of affinity than a taxonomy that may already have used fertility, and the fly dataset plus public distances make the regression a standard analysis. Discriminating power is high inside the clades that have both variables. Adequacy is only partial because plants, vertebrates, and most invertebrates lack a similarly complete open crossing table.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Regress first-cross success and hybrid fertility on genetic or phylogenetic distance. A strong positive relationship of isolation with distance, with residual scatter and with no hybrids between families, supports affinity as a large but not strict governor; no relationship, or frequent fertile crosses between distant families, would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Crossing outcomes outside a few model clades are not in the same table as the distances.", "Family rank is a human cutoff, so 'never between families' partly reflects how families were drawn.", "Genetic distance is a proxy for the systematic affinity of 1859 classifications.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.715"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Drosophila speciation dataset";
    dc:description "isolation indices paired with genetic distance for fly species";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.g5g43>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TimeTree";
    dc:description "divergence times as an independent measure of systematic affinity outside the fly compilation";
    prov:wasDerivedFrom <https://timetree.org/>.
<https://w3id.org/delphi/resource/evidence/darwin1859-ch08-06--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "sequences for estimating genetic distance of additional crossed pairs without using fertility to define affinity";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of darwin1859-ch08-06 by Grok 4.7: 0.74";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.74"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of darwin1859-ch08-06 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of darwin1859-ch08-06 by Grok 4.7: 0.72";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-data-existence>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/data-existence";
    <https://w3id.org/delphi/ontology/hasScore> "0.72"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok--discriminating-power> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Discriminating power of darwin1859-ch08-06 by Grok 4.7: 0.76";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-discriminating-power>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.1.0/discriminating-power";
    <https://w3id.org/delphi/ontology/hasScore> "0.76"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok>.
<https://w3id.org/delphi/resource/assessment/darwin1859-ch08-06--grok--operationalizability> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of darwin1859-ch08-06 by Grok 4.7: 0.86";
