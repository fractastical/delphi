sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-01--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch11-01: resolvable-now, resolvability 0.83" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.835"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Community dissimilarity, climate distance, and region identity are standard variables in two open global sources. Variation partitioning can be run for plants and vertebrates at the regional scale the claim uses. Sampling bias is real and is handled by restricting the test to well-sampled cells and higher taxa." ;
    rdfs:comment "Proposed test with existing data: Partition compositional dissimilarity among the world's regions into a climate component and a regional component, including matched southern temperate belts. If climate distance accounts for which regions share their biotas, the claim fails." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Occurrence data are denser in some countries, which can exaggerate regional differences.", "Present climate omits the conditions lineages experienced in the past." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-01--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
