sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-02--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch07-02: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.467"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Phylogenies are public and a few behavioral series, such as social insects and brood parasites, are described well enough to test gradation in those clades. There is no open ethogram database spanning complex instincts, so most of the scope would have to be compiled. Living intermediates also cannot show that the historical path was gradual rather than that side branches retained intermediate behavior." ;
    rdfs:comment "Proposed test with existing data: For clades with a complex instinct, score behavioral intermediates on a phylogeny of related species. A graded series of collateral instincts supports the expectation; a complex instinct that appears in one step, with relatives lacking intermediate behavior after adequate study, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Instinct scores are not a field in these databases and must be coded from natural-history literature.", "Collateral grades are not ancestral stages.", "Extinction of intermediate species removes the very evidence the prediction asks for." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-02--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch07-02 by Grok 4.7: 0.58" ;
