  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-03--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch11-03: resolvable-now, resolvability 0.76" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.755"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Within-region relatedness versus between-region habitat matching is a standard phylogenetic beta-diversity contrast, and both occurrences and a synthetic tree are public. Vertebrates and seed plants are sufficiently covered; many invertebrates are not. Filtering introductions is routine and leaves a decisive comparison for the major regions." ;
    rdfs:comment "Proposed test with existing data: Compare phylogenetic similarity within a continent or sea, across habitats, with similarity between different continents that share a habitat. Habitat matches across continents as close as within-continent relatives would refute the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Many branches still lack a complete tree, so some comparisons stay at the level of shared genera.", "Recent human introductions blur regional affinity if they are left in the lists." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch11-03 by Grok 4.7: 0.85" ;
