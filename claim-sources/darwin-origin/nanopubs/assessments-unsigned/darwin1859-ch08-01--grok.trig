sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-01--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch08-01: partially-resolvable, resolvability 0.61" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.611"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "One public compilation already splits barriers into components that match the two phenomena for many fly pairs, and that split can be reanalyzed quickly. The physiological claim is broader than Drosophila, and plant or vertebrate crosses with a recorded stage of failure are not in a comparable open table. Where the stage is scored directly, the contrast is informative rather than confounded." ;
    rdfs:comment "Proposed test with existing data: For species pairs, separate failure to produce offspring when parental gametogenesis is normal from sterility of F1 hybrids whose own gametogenesis fails. A systematic difference in the stage of failure supports two phenomena; a single shared stage of reproductive collapse would count against the distinction." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Outside Drosophila, crossing tables that record the stage of failure are scattered in papers.", "The distinction is close to a definition by stage, so some of the result is built into the scoring.", "Plants and non-fly animals in the stated scope are poorly represented in the open compilation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-01--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch08-01 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
