sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch03-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-07--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch03-07: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.562"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Naturalization inventories, hardiness geography, and traits can test Darwin's garden argument for plants in well-documented regions. That is a restricted and reasonably direct test of indirect limitation. Extending 'mainly' to species in general, and separating competition from propagule pressure, exceeds what those tables cleanly support." ;
    rdfs:comment "Proposed test with existing data: Compare climate tolerance of cultivated exotic plants with whether they are naturalized, and relate naturalization failure to competitive and enemy-related traits rather than to hardiness. A large set of climate-hardy non-naturalized plants, with naturalization predicted by biotic traits, would support indirect climatic limitation; naturalization predicted by climate tolerance alone would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Garden hardiness and naturalization status are easy to join for some regions and messy for others.", "Failure to naturalize can reflect propagule pressure and habitat availability, not only competitors and native animals.", "The garden-plant example is narrower than 'climate limits species mainly indirectly' for all species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch03-07--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch03-07 by Grok 4.7: 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.66"^^xsd:double ;
