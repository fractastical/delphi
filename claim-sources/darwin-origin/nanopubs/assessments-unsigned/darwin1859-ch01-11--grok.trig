sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch01-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch01-11: partially-resolvable, resolvability 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.518"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Public genomes and a Mendelian catalogue can show, for major domestic species, whether breed differences look accumulated or single-step. That is a proxy for the historical mechanism, and it covers a minority of domesticated animals and plants. Mixed architectures mean the result can reject a purely sudden origin more readily than it can crown accumulative selection as the key cause." ;
    rdfs:comment "Proposed test with existing data: Classify breed-defining differences by genetic architecture and by the time series of allele frequencies from ancient to modern animals: many successive small shifts versus a single large-effect origin. A predominance of multi-locus, temporally accumulated change aligned with breeding goals would support accumulative selection; a predominance of one-step sports that already match the finished breed would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Ancient DNA time series exist for a few species and preserve only part of the phenotype.", "Both large-effect mutations and polygenic selection are real, so 'the key cause' is a balance, not a yes-or-no.", "Archaeological morphology cannot show that a breeder, rather than natural selection or drift, accumulated the changes." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-11--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch01-11 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
