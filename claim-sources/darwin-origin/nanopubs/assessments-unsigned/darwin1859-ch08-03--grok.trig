sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-03--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch08-03: partially-resolvable, resolvability 0.43" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.433"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.57"^^xsd:double ;
    dct:description "Genomes can check the historical premise that particular domestics combine more than one species, and breed databases record present fertility. The variable that would show sterility being removed, a before-and-after barrier between the same lineages, is mostly absent. The test therefore covers a few candidate domestics and does not reach the general mechanism." ;
    rdfs:comment "Proposed test with existing data: Compare intrinsic hybrid sterility between the wild progenitors of a domestic animal with fertility among the domestic descendants supposed to combine those progenitors. Loss of a barrier that is still present in the wild pair would support removal by domestication; barriers that are unchanged, or domestic forms that never had intersterile progenitors, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Fertility of the original wild crosses at the time of domestication is rarely measured.", "Several of the multi-species origin stories are themselves uncertain, which confounds the comparison.", "Selection on fertility under domestication is hard to separate from hybrid ancestry." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch08-03 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-03--grok--operationalizability> .
