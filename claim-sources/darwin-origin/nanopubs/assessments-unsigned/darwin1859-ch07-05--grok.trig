    rdfs:label "Candidate dataset: Database of bird flight initiation distances" ;
    dct:description "compiled alert and flight-initiation distances as a measure of fear of approaching humans" ;
    prov:wasDerivedFrom <https://doi.org/10.3996/082015-jfwm-078> .
