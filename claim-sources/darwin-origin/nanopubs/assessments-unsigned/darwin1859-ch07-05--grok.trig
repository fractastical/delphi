sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch07-05: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.589"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "A large public compilation of approach distances makes the island-tameness and body-size contrasts testable for birds, together with range and threat data. That is a proxy for acquired fear, not a measurement of the rate of acquisition or of heritability. Confounds are serious enough that a positive correlation would remain ambiguous, and non-bird scope is barely covered." ;
    rdfs:comment "Proposed test with existing data: Regress flight-initiation distance on island isolation, history of human presence, hunting pressure, and body size. Longer distances where persecution has been longer or more intense, and shorter distances on uninhabited islands, would support the claim; no such pattern, or a pattern explained by predator fauna alone, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Flight distance confounds evolved fear, individual learning, habitat, and the background predator community.", "The compilations are snapshots, so they do not measure the word 'slowly'.", "Geographic bias toward Europe, North America, and Australia leaves many persecution histories unsampled." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-05--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch07-05 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-05--grok--operationalizability> .
