sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-16--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-16--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch11-16: resolvable-now, resolvability 0.79" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.793"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.78"^^xsd:double ;
    dct:description "Naturalized floras with native ranges are tabulated in an open global database, so the Europe-to-south versus south-to-Europe counts are a direct query. Animals can be added from occurrence flags with more cleaning. Propagule pressure explains the asymmetry and does not prevent counting it." ;
    rdfs:comment "Proposed test with existing data: Count naturalized European species established in the Río de la Plata region and in Australia, and naturalized southern-hemisphere species established in Europe. A symmetric exchange, or a surplus of southern species in Europe, would refute the asymmetry." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Colonial trade and propagule pressure favor European sources regardless of any intrinsic dominance.", "Recording has been more intense for European weeds than for southern plants arriving in Europe.", "Animal naturalizations are less completely compiled than plants." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-16--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-16--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-16--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch11-16 by Grok 4.7: 0.9" ;
