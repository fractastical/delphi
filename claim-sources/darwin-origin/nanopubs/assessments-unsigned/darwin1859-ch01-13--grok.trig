sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch01-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch01-13: partially-resolvable, resolvability 0.37" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.368"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "The process can be approximated with long phenotypic series under weak selection, but public breed systems do not encode intent or century-scale pedigrees. Landrace collections and breed lists support only a static proxy. Environment and methodical selection remain tangled with any trend that can be assembled from papers and herd books." ;
    rdfs:comment "Proposed test with existing data: Track phenotypic or breeding-value change in populations where the recorded practice was only 'breed from the best animals' without a written improvement target, over multi-decade to century scales, and compare the direction of change with methodical breeding programmes. Sustained change in the preferred direction under the weaker practice would support the claim; stasis once methodical goals are absent would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Historical records rarely label a breeding practice as unconscious rather than methodical.", "Nutrition, climate, and market standards change the phenotype in parallel with any breeding choice.", "Open breed databases do not store century-long individual pedigrees tied to selection criteria." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch01-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch01-13 by Grok 4.7: 0.46" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.46"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
