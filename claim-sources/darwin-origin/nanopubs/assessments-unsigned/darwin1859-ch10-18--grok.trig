sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-18--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch10-18: resolvable-now, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.745"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Regional fossil lists and living distributions are both public, and phylogenetic relatedness separates local succession from climatic convergence. Mammals in the later Tertiary are well enough covered for a direct test; birds and molluscs are spottier. The comparison is a standard biogeographic analysis on existing downloads." ;
    rdfs:comment "Proposed test with existing data: For late Cenozoic mammals, birds, and molluscs, compare the relatedness of each region's fossils to that region's living fauna and to the living faunas of other regions. Fossils systematically closest to the local living biota would support the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Later dispersal and extinction can erase an older regional succession.", "Similar climates can produce convergent resemblance that has to be separated with phylogenetic affinity." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-18--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-18--grok--dataset-3> .
