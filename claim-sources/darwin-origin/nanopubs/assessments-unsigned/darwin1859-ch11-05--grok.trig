sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch11-05: partially-resolvable, resolvability 0.39" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.39"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The contrast between a co-immigrating assemblage and a singleton colonist is a real comparative prediction, but the arrival mode is not a column in open databases. Trees and ranges support case studies of a few radiations. They do not separate isolation from the other variables that change on islands, so discriminating power stays low." ;
    rdfs:comment "Proposed test with existing data: Compare morphological or genetic divergence of species that entered an isolated region together, as an already competing set, with divergence of species that arrived alone into new biotic relationships. The claim predicts little change in the first case and more change in the second." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Whether colonists arrived together or alone is rarely recorded in a database.", "Time since arrival and population size vary with isolation and can produce the same divergence pattern.", "Relevant comparisons are spread across separate phylogeographic studies." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch11-05 by Grok 4.7: 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
