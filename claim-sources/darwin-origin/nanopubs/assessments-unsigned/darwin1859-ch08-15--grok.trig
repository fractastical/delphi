sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-15--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch08-15: not-empirically-resolvable, resolvability 0.20" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.2"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Neighboring claims about fertility distributions are empirical; this sentence is the conceptual summary that those facts support no fundamental distinction. Any dataset result can be redescribed as a difference of degree or of kind depending on the species concept adopted. Because the rivals are not separated by a measurable consequence beyond that definitional choice, the claim is not empirically resolvable." ;
    rdfs:comment "Proposed test with existing data: Whether species and varieties differ fundamentally is a judgment about taxonomic rank and about what would count as a fundamental difference. Overlap in fertility or genetics can be measured, but that overlap does not decide the philosophical conclusion, and rank itself is partly defined by the same facts." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'Fundamental distinction' has no measurement that would settle it.", "Tests that use the labels species and variety inherit the criteria used to apply those labels.", "The hybridism facts are evidence in an argument, not a separate empirical outcome." .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch08-15 by Grok 4.7: 0.25" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
