sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch04-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-09--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch04-09: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.596"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.66"^^xsd:double ;
    dct:description "Trait matching and correlated phylogenetic change are standard tests, and interaction networks plus floral traits make a partial version feasible. Coverage is a subset of flowering plants and their insects, concentrated where networks have been assembled. Matching alone does not show that both parties were modified, or whether the changes were simultaneous, so the analysis discriminates mutual adaptation only modestly from one-sided filtering." ;
    rdfs:comment "Proposed test with existing data: Match floral measurements to the morphology of recorded insect visitors and test whether changes on the two phylogenies are correlated. Trait matching beyond a null of random visits would support mutual modification; matching explained entirely by pollinators filtering flowers that already fit would refute reciprocal adaptation. Simultaneous versus sequential change is a further, weaker contrast using relative timing on time-calibrated trees." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Visitor morphology and corolla measurements are only partly in the same databases as interactions.", "One-sided adaptation and ecological filtering produce trait matching without reciprocal change.", "Network coverage is strong for a few floras and poor for most insect-plant pairs." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-09--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch04-09 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
