  <https://w3id.org/delphi/resource/assessment/darwin1859-ch03-01--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on darwin1859-ch03-01: resolvable-now, resolvability 0.76" ;
