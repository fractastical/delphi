sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch04-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch04-10: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.666"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Because the wording is exclusive, documented large-effect adaptations and polyploid origins in public genetic and chromosomal databases are directly relevant and do not require a survey of every organism. How small a modification must be before it counts as infinitesimal is contested, which blocks a single decision threshold. The data can challenge the strict exclusion of sudden large change and still leave a gradualist, polygenic reading standing." ;
    rdfs:comment "Proposed test with existing data: Compile the effect sizes of alleles that have contributed to retained adaptive change, and the frequency of polyploid and other macromutational origins. The strict reading would be confirmed only if preserved adaptations are overwhelmingly built from tiny-effect steps. It would be refuted if large-effect alleles or whole-genome duplications repeatedly constitute the inherited change that is kept." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Infinitesimally small can be read as a population-genetic limit or as a ban on large mutations, and those readings diverge.", "GWAS and QTL samples are biased toward large effects and toward crops, livestock, and humans.", "A large-effect allele can still be followed by a long series of small modifiers." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-10--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch04-10 by Grok 4.7: 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.62"^^xsd:double ;
