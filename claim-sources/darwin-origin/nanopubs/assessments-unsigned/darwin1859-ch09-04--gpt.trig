  <https://w3id.org/delphi/resource/assessment/darwin1859-ch09-04--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on darwin1859-ch09-04: resolvable-now, resolvability 0.86" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
