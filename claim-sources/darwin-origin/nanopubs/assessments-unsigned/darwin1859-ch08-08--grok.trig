sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-08--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch08-08: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.594"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The anti-teleological claim can be turned into a geographic prediction, and an open fly dataset already contains isolation, distance, and overlap. That is informative but not decisive, because incidental divergence and several selection scenarios can produce the same distance relationship. The vague residue, unknown differences chiefly in the reproductive system, is not an additional dataset test." ;
    rdfs:comment "Proposed test with existing data: Compare postzygotic sterility in sympatric and allopatric pairs after accounting for genetic distance. Sterility that tracks divergence in allopatry, where it could not have been endowed to prevent crossing, supports an incidental byproduct; sterility concentrated only where species meet, beyond what distance predicts, would favor a special isolating endowment." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The rival hypothesis of reinforcement applies more clearly to premating barriers than to sterility.", "'Unknown differences in the reproductive system' is not itself a measured variable.", "Range-overlap scores in the fly table do not extend to the full scope of crossable species." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch08-08--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch08-08 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch08-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch08-08--grok--operationalizability> .
