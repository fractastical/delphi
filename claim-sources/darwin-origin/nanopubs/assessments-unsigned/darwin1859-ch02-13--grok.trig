sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-13--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch02-13: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.667"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Range surfaces and phylogenies make this regression a standard macroecological test for birds, mammals, and many plants. Adequacy is that of well-mapped groups rather than species generally, matching a claim that started from the British flora and was generalized. Description bias and age-range correlations are serious, and they are quantifiable, so the result can be informative without being fully clean." ;
    rdfs:comment "Proposed test with existing data: Regress geographic range size on distance to the nearest congener, phylogenetically or morphologically defined. Smaller ranges for the closest species would support the pattern; no relationship, or larger ranges for the closest species, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Recently described close species are often known from few localities, which shrinks apparent range.", "Occurrence-based ranges under-represent poorly sampled regions and narrow endemics differently.", "Young species may have small ranges because they are young, which is related to the claim but not identical to a variety-like restriction." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-13--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-13--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch02-13 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
