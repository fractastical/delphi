  <https://w3id.org/delphi/resource/claim/darwin1859-ch13-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-04--gpt> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch13-04--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on darwin1859-ch13-04: partially-resolvable, resolvability 0.62" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.623"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.81"^^xsd:double ;
    dct:description "Rank instability and determinants are empirically measurable. The central judgment that ranks are arbitrary remains partly conceptual, and modern taxonomic practice differs from Darwin's period." ;
    rdfs:comment "Proposed test with existing data: Measure variation among taxonomic authorities and through time in rank assignments for equivalent clades, and test whether added species richness predicts rank elevation independent of clade age or divergence. High instability supports arbitrariness, though no dataset can define how much instability counts as 'almost arbitrary.'" ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Arbitrariness is a normative concept without a unique threshold.", "Historical taxonomic versions are not uniformly digitized." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-04--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch13-04--gpt--dataset-2> .
