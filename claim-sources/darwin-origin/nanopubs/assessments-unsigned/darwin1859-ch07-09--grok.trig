sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-09--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch07-09: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.584"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Relationships among the social bees Darwin arranged in a series are recoverable from public sequences and trees, so his particular order can be checked. The architectural measurements that would show slight successive modification are not in those databases. The test can support or upset the proposed sequence for this narrow clade and still leave the selective cause unmeasured." ;
    rdfs:comment "Proposed test with existing data: Order comb architecture, from irregular brood cells through intermediate stingless-bee combs to the hive-bee cell, on a corbiculate-bee phylogeny. A stepwise increase along the tree supports acquisition by successive modification; a phylogeny in which the architectural series is not a historical sequence, or a jump to hexagonal comb without intermediates, would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Quantitative nest-architecture scores are in papers, not in the sequence or tree databases.", "A grade series of living bees can be ecological rather than the ancestral path.", "Many stingless-bee nests are described qualitatively." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-09--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch07-09 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
