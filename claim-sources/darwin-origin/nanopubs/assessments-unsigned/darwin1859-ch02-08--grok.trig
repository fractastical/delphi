sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-08--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch02-08: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.599"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "The comparison is a direct contingency table of genus size against variety counts, and floras plus name catalogues supply it for many countries' plants. Infraspecific ranks are incomplete and effort-biased, so discriminating power sits at the level of a correctable confound rather than a clean test. Animal groups in the original scope would need extra compilation beyond the plant floras." ;
    rdfs:comment "Proposed test with existing data: Within each country or regional biota, compare the proportion of species that have named varieties, and the mean number of varieties, between species in genera above and below the median genus size. Higher proportions and means on the large-genus side, after controlling for study effort, would support the pattern; a null or reversed difference would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Variety rank is used inconsistently and is often omitted from global checklists.", "Large genera are studied more intensively, so they accumulate more named varieties.", "Beetle faunas, part of the original scope, are less consistently digitized than vascular-plant floras." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-08--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-08--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch02-08 by Grok 4.7: 0.82" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.82"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-08--grok--operationalizability> .
