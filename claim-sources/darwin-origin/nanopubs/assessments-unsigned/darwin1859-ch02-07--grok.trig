sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch02-07: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.605"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Range, plot, and flora databases contain the dominance variables and at least partial variety counts for plants, which is the stated scope. The classic sampling bias, that common plants attract more taxonomic attention, is large enough that an uncorrected regression would not discriminate the biological claim. A careful subset analysis is feasible; a global, bias-resistant one is not sitting ready to run." ;
    rdfs:comment "Proposed test with existing data: Regress the number of well-marked varieties per species on geographic range, local occupancy, and abundance, within regional floras, with sampling effort as a covariate. A positive partial association for wide, common species would support the pattern; no association after effort is controlled would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Widespread species are collected and split more often, which manufactures varieties.", "Abundance, range, and 'variety' rank are complete together only for some regional floras.", "Darwin's dominance criteria (world range, local diffusion, and numbers) are only partly observed in the same records." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-07--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch02-07 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
