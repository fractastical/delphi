sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-08--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch07-08: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.537"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Ant taxonomy and trees are public, and the living grade from Formica to Polyergus is exactly the comparison Darwin used, so a partial phylogenetic test is realistic. Habit coding is incomplete outside the well-studied genera, and the original purpose of the raids is not a character in any database. The analysis would take months of literature harmonization rather than a short standard run." ;
    rdfs:comment "Proposed test with existing data: Map predation on pupae, facultative slave-making, and obligate dulosis on an ant phylogeny focused on Formica and Polyergus. The claim is supported if dependent slave-makers are derived from raiders that still use foreign brood as food; it is weakened if dulosis is ancestral or arises without a predatory-raiding precursor." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Behavioral states are unevenly recorded and often absent for related species.", "Collecting pupae as food is a historical function, not a preserved trait.", "Territorial raiding is an alternative route to dulosis that phylogeny alone may not separate." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-08--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch07-08 by Grok 4.7: 0.68" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.68"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-08--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
