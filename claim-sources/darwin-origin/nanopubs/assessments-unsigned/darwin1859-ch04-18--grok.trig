sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch04-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-18--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch04-18: partially-resolvable, resolvability 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.66"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Rarity before extinction is a direct fossil-occurrence question, and public occurrence databases make the analysis a standard weeks-scale project for well-sampled groups. Sampling bias is severe enough that an apparent decline is not decisive, and the ecological zero-sum clause is only weakly tied to those geological counts. The data resolve a biased subset of the pattern rather than the competitive mechanism across fully stocked regions." ;
    rdfs:comment "Proposed test with existing data: In fossil occurrences, test whether occupancy declines in the intervals before last appearance beyond a sampling model, and in modern assemblages test whether increases in one species are matched by decreases in others. Pre-extinction rarity and negative abundance coupling would confirm the two clauses; extinctions that are as often preceded by high abundance, once sampling bias is removed, would refute the geological clause." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The Signor-Lipps effect makes taxa look rare before their true last occurrence.", "Calling the increasing form the favoured one uses the outcome the explanation is meant to predict.", "Ecological time series are short relative to extinction." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-18--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-18--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch04-18 by Grok 4.7: 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.74"^^xsd:double ;
