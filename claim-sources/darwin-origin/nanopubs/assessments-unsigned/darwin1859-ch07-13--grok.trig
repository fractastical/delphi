sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-13--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch07-13: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.603"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "Within-nest morphometrics are a direct test of the prediction that neuters in one nest sometimes grade into each other, and ant specimen data make a start. Colony context is incomplete, so adequacy and feasibility stay moderate, and the link from gradation to selection on parents is an extra inference. The frequency word 'often' needs a broader sample than the famous polymorphic genera." ;
    rdfs:comment "Proposed test with existing data: Within single nests, test whether worker size and shape are continuously graded or fall into discrete modes, and estimate how often graded nests occur across species. Frequent within-nest gradations confirm the empirical clause; exclusively discrete castes with no graded species would refute the 'often' claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Many AntWeb specimens lack a same-nest identifier, so within-nest series must be filtered by hand.", "Continuous variation can be nutrition rather than the selective gradation the theory invokes.", "Bees, wasps, and termites are far less measured than ants." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch07-13--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch07-13 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.84"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch07-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch07-13--grok--operationalizability> .
