sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch05-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-05--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch05-05: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.466"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The claim names a cause, disuse alone, and explicitly sets selection aside, so molecular signatures of selection are relevant in principle. Those signatures are public for a small set of cave species and absent for most of the scope. Where genomes exist, the analysis can challenge the exclusion of selection without measuring disuse directly." ;
    rdfs:comment "Proposed test with existing data: In cave lineages with sequenced eye-loss genes, test for relaxed constraint, positive selection, or pleiotropy with other cave phenotypes. Neutral loss independent of selection would support a disuse-or-drift reading; repeated signatures of selection or pleiotropic benefit would refute the claim that eyes were lost wholly without selection. Mapping disuse onto neutral degeneration is an interpretive step." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Genetic tests exist for a few models, especially Astyanax, not for most cave animals.", "Disuse, as inheritance of an acquired loss, is not a variable in sequence data.", "Pleiotropy can look like selection on eyes when selection acted on a linked trait." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-05--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch05-05 by Grok 4.7: 0.44" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.44"^^xsd:double ;
