sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch06-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-09--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch06-09: partially-resolvable, resolvability 0.63" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.627"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Public trees and morphological matrices make the direction of the transformation a standard ancestral-state problem, and that direction is the core of the historical claim. Soft-tissue function at the critical nodes is inferred rather than observed, so the flotation premise and the appeal to selection stay out of reach of the same datasets. The analysis is feasible for living osteichthyans and only a proxy for the unknown prototype." ;
    rdfs:comment "Proposed test with existing data: Code lung versus swim bladder, and flotation versus respiration, on a molecular vertebrate tree and reconstruct the ancestral state for lung-bearing vertebrates. The claim is supported if that ancestor is reconstructed as having a flotation swim bladder and lungs are derived from it; it is refuted if lungs (or a non-flotation air organ) are ancestral and swim bladders arise later inside ray-finned fishes." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The flotation function and soft anatomy of the deep ancestor are rarely fossilized.", "Coding lung and swim bladder as alternative states can smuggle in a homology decision.", "Selection as the converting agent is not recorded by character order alone." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch06-09--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch06-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch06-09 by Grok 4.7: 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.72"^^xsd:double ;
