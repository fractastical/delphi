sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-09--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch10-09: partially-resolvable, resolvability 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.65"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.76"^^xsd:double ;
    dct:description "Pre-extinction occupancy is a clear variable, and both fossil occurrences and Quaternary paleoecological counts exist. The classic sampling bias creates exactly the decline the claim predicts, so an uncorrected result has little discriminating power. Neotoma and a few historical series can test true abundance for a recent subset." ;
    rdfs:comment "Proposed test with existing data: Compare occupancy or occurrence counts in the interval before last appearance with counts for species that survive the same interval. A drop confined to the species that are about to disappear would support the claim; extinction from high occupancy would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The Signor-Lipps effect produces a spurious decline in records before the last appearance.", "Most fossil collections record presence, so rarity is occupancy rather than population size.", "Historical cases of human extermination are documented piecemeal and are not one abundance series." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch10-09--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch10-09 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-09--grok--operationalizability> .
