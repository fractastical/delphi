sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch01-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-08--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch01-08: needs-new-data, resolvability 0.30" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.301"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The prediction is clear enough to score once generation depth and taxonomic spread are matched. That matched series does not exist in any open database, and a few recent domestication genome projects are not a substitute for it. Resolving the counterfactual would require new long-running breeding records rather than a reanalysis of current archives." ;
    rdfs:comment "Proposed test with existing data: Domesticate a matched set of previously wild species, equal in number, taxonomic spread, and generations to existing domesticated productions, and compare their accumulated phenotypic variance. Equal average variance would support the prediction; systematically less variance in the new domesticates, after matching generations and diversity of conditions, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public experiment has kept a taxonomically matched set of wild species under domestication for a number of generations comparable to ancient crops and livestock.", "Recent domestications such as farmed fish differ in breeding intensity and are documented case by case.", "Variance under domestication confounds generations of breeding with intentional selection intensity." .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch01-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch01-08 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
