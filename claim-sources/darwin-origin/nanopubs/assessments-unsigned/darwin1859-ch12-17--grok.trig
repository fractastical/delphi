sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-17--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch12-17: partially-resolvable, resolvability 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.448"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The sentence has a measurable biogeographic pattern only after 'lower' is replaced by a grade, body size or propagule size, and those mappings disagree. Checklist and occurrence databases can support a proxy test inside plants or vertebrates and cannot support one across all of life. Sampling bias is large enough that many outcomes would still be compatible with both the claim and its opposite." ;
    rdfs:comment "Proposed test with existing data: Using an explicit proxy for 'lower', such as non-seed plants versus seed plants or small-bodied versus large-bodied animals, compare geographic range size or number of regions occupied. The claim is confirmed if the lower proxy has systematically larger ranges after correcting for the number of records, and refuted if range size is unrelated to that proxy or runs the other way." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "'Lower in the scale of nature' has several competing modern proxies, and they do not rank the same organisms together.", "Recorded ranges of microbes and minute invertebrates are dominated by where people have sampled, not by where the organisms live.", "Better-studied large organisms can look either more or less widespread depending on whether range is measured as a map or as a list of records." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-17--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-17--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-17--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch12-17 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
