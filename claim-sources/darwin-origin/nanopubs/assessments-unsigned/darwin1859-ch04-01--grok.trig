sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch04-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch04-01: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.511"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Superfecundity and the removal of deleterious alleles are measurable, and open demographic and genomic resources support standard tests of both. The preservation of favourable variation is only weakly separable from the definition of a favourable variant, so many outcomes are compatible with the wording either as a mechanism or as a tautology. Existing data therefore test pieces of the statement in a few well-studied organisms rather than the universal process as named." ;
    rdfs:comment "Proposed test with existing data: Estimate the distribution of fitness effects from allele-frequency spectra, and estimate surplus offspring from life tables. Purifying selection would be confirmed if deleterious alleles are systematically rarer than neutral alleles and if populations produce far more offspring than survive; the differential-success clause would be refuted if fitness effects did not predict frequency change. The sentence that names this process natural selection has no separate measurement." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "An advantage defined as higher survival or reproduction makes the central clause close to a definition of fitness.", "Population-genomic samples are concentrated in humans and model organisms.", "Life tables show excess births without identifying which heritable differences selection retains." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch04-01--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch04-01 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/darwin1859-ch04-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
