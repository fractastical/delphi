sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch10-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-17--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-17--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch10-17: not-empirically-resolvable, resolvability 0.17" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.168"^^xsd:double ;
    delphi:hasVerdict "not-empirically-resolvable" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "The statement is a counterfactual about a meeting that the fossil record does not contain. Any real pattern of replacement is compatible with later forms being competitively superior and with later forms merely being different. Proxies require a substantial reinterpretation, so they do not resolve the claim as stated." ;
    rdfs:comment "Proposed test with existing data: The stated test is a competition, under a similar climate, between an extinct fauna or flora and a living one. No existing observation records the winner of that encounter, and modern invasions or trait trends change the contrast into a different question." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Extinct species cannot be placed in competition with living ones.", "Competitive superiority is not a variable stored in occurrence or trait data without replacing the claim." .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch10-17--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch10-17 by Grok 4.7: 0.25" ;
