sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-12--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch12-12: partially-resolvable, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.7"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Nearest-continent versus climate-matched distant region is a direct decision rule, and public occurrences, climate layers and a synthetic tree supply the variables for well-studied archipelagos. Coverage falls well short of every endemic plant and animal, so the 'almost universal' scope is only partly in reach. Where trees and inventories exist, multiple colonizations and missing mainland sisters are manageable biases rather than fatal ones." ;
    rdfs:comment "Proposed test with existing data: For oceanic-island endemics, compare phylogenetic distance to relatives on the nearest continent or nearby islands with distance to biotas in climatically more similar but geographically farther regions. The claim is confirmed if nearest-source relatives are closer in a large majority of well-sampled clades, and refuted if climate-matching distant regions win about as often." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Most invertebrate and many plant endemics are still missing from phylogenetic trees, so the testable set is biased toward vertebrates and well-studied floras.", "Extinct source populations on the nearest continent can make a living relative look farther away than the historical source.", "Ocean currents and wind can make the biologically accessible source differ from the nearest shoreline." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-12--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch12-12 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
