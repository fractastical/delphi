sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-14--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch11-14: resolvable-now, resolvability 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.725"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "Checklist and occurrence data can count shared species and shared genera between mountain and temperate floras worldwide. Phylogenetic distance covers the distinct-but-allied clause for a large fraction of seed plants. Tropical mountains are the weak geographic slice, and the temperate and northern-alpine comparison is already well populated." ;
    rdfs:comment "Proposed test with existing data: Compare species identity and phylogenetic relatedness among temperate lowland floras and high-mountain floras, including tropical mountains, with relatedness of those floras to tropical lowlands. Mountain and temperate floras that are generally unrelated would refute the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Tropical alpine inventories and DNA coverage are thinner than European mountain floras.", "Closely related needs a fixed rank or a phylogenetic-distance cutoff." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-14--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-14--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch11-14 by Grok 4.7: 0.8" ;
