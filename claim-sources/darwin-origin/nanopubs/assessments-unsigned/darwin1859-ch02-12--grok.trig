sub:assertion {
  <https://w3id.org/delphi/resource/claim/darwin1859-ch02-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-12--grok> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on darwin1859-ch02-12: partially-resolvable, resolvability 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0> ;
    delphi:assessmentType "dataset-resolvability/0.1.0" ;
    delphi:hasScore "0.552"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Trees and trait tables can show uneven spacing inside large genera for well-sampled groups. The specific picture of satellites around certain species is stricter than generic tree imbalance, and standard phylogenies often erase the paraphyly that picture needs. The analysis is feasible and only moderately discriminating once a branching null is included." ;
    rdfs:comment "Proposed test with existing data: Measure clustering of species around a few centers inside large genera, using morphological nearest-neighbour structure or phylogenetic satellites around paraphyletic nominal species, and compare that clustering with a constant-rate branching null. Excess clustering around a few species would support the satellite pattern; distances as even as the null would count against it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Ordinary branching processes already produce clusters, so the null has to be explicit.", "Satellite species around a still-living 'parent' require paraphyletic species concepts that many trees have already removed.", "Morphological clustering and phylogenetic clustering answer different versions of the statement." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch02-12--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch02-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of darwin1859-ch02-12 by Grok 4.7: 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.1.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.1.0/operationalizability" ;
    delphi:hasScore "0.58"^^xsd:double ;
