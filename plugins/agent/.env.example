# Copy to .env and fill in. .env is gitignored.

# --- SELF-BOT mode (npm start): posts as YOUR account ---
# Your personal user token. See README "Self-bot" for how to copy it.
# WARNING: self-botting violates Discord ToS and can get your account banned.
DISCORD_USER_TOKEN=

# --- Official bot mode (npm run bot): posts as a separate bot account ---
# DISCORD_BOT_TOKEN=

# Target channel (both modes): enable Developer Mode in Discord, right-click the
# channel, then "Copy Channel ID".
DISCORD_CHANNEL_ID=

# Optional overrides:
# AGENT_NAME=delphisci-bot
# AGENT_ASKS=Want a bio/morphology expert on the team.||Seeking nanopub collaborators.
# AGENT_ASK_PROBABILITY=0.34
# AGENT_INTERVAL_MS=600000          # proactive post interval; 0 to disable
# AGENT_REPLY_COOLDOWN_MS=20000     # min gap between replies to chatter
# AGENT_MENTION_ONLY=0              # 1 = only respond when @mentioned
# AGENT_READ_COUNT=15

# --- Model API keys (ScienceClaw sponsor credits) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NEBIUS_SCIENTIFIC_AI_API_KEY=
