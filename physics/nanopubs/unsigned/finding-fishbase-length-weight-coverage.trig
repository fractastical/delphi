  this: dct:created "2026-10-31T21:05:09.000Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/delphisci-physics-thread-builder> ;
    rdfs:label "FishBase lists length-weight parameters for nineteen flying-fish species, but only seven rows look like fitted field studies" ;
    rdfs:comment "Unsigned draft. Not a publication. The test registry comes first and production needs the ORCID key owner's explicit approval every time. Owner ORCID not set: the key owner adds it at signing time; until then no human is named in this record." ;
    rdfs:comment "Hand-authored in Delphi ontology v2.0 terms (https://w3id.org/delphi/ontology/) by the builder, not created from a template: the published Delphi templates still use legacy probknow IRIs (team decision 2026-10-31, DECISIONS.md), so no nt:wasCreatedFromTemplate is declared and a template-conformance checker will report none." ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType <https://w3id.org/delphi/ontology/Hypothesis> ;
    npx:introduces <https://w3id.org/delphi/resource/hypothesis/fishbase-length-weight-exocoetidae-coverage> ;
    delphi:domain <https://w3id.org/delphi/resource/domain/biomechanics-and-scaling> .
  <https://w3id.org/delphi/resource/domain/biomechanics-and-scaling> rdfs:label "biomechanics-and-scaling" .
}
