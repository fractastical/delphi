@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .
@prefix schema: <https://schema.org/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/hypothesis/fishbase-length-weight-exocoetidae-coverage> a delphi:Hypothesis, skos:Concept ;
    rdfs:label "FishBase lists length-weight parameters for nineteen flying-fish species, but only seven rows look like fitted field studies" ;
    dct:description "Of 27 Exocoetidae species summary pages fetched from FishBase on 2026-10-31, 19 have a length-weight page, giving 25 rows of W = a L^b. 7 rows carry a locality and a sample size (Kuroshio off Taiwan 2008 to 2017 for Cheilopogon atrisignis, C. unicolor, Cypselurus poecilopterus and Hirundichthys oxycephalus; Caicara do Norte 2011 to 2012 for H. affinis by sex); the remaining 18 rows have b exactly 3.000, a sample size of two to six and no locality, and look like FishBase-derived estimates rather than measurements; the list page shows no reference for any row. No study is listed for Cypselurus hiraii, the only species with measured wing aerodynamics. Status: supported, as a statement about FishBase as served on 2026-10-31." ;
    schema:additionalProperty [ a schema:PropertyValue ; schema:propertyID "n_rows" ; schema:value 25 ] ;
    schema:additionalProperty [ a schema:PropertyValue ; schema:propertyID "n_species" ; schema:value 19 ] ;
    delphi:context "Claim under test: thompson1917-ch02-06 (D Arcy Thompson 1917, On Growth and Form, ch. II, Project Gutenberg 55264 lines 1716-1790), with thompson1917-ch02-07 and thompson1917-ch02-10. Taxon: Exocoetidae, NCBI Taxonomy 76072, GBIF 2968. Class Aves is the frozen holdout (holdout/exam.json); no bird value enters this record." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/physics-fishbase-length-weight-table> ;
    prov:wasDerivedFrom <https://www.fishbase.se/> ;
    rdfs:comment "Status: supported. Does not establish: the references behind the rows (not shown on the list page and not fetched); that the b = 3.000 rows are wrong, only that they are unverified; anything about species with no page." ;
    rdfs:comment "Pre-registration: physics/tests/thompson1917-ch02-06/result.json, written 2026-10-31T18:21:00Z before any wing loading, lifting area or lift coefficient was read, amended 2026-10-31T18:26:00Z before any fit ran (the file lists both and the values seen before each); sha256 at build 0094c084db22278a5f98d96cc2971ccd27813b0acdc458d60cadf7c7b7bcae48. The git commit that timestamps it is pending: the physics thread does not commit; the hub does." ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/results.json> .
  <https://w3id.org/delphi/resource/evidence/physics-fishbase-length-weight-table> a delphi:EvidenceItem ;
    rdfs:label "physics/length-weight.csv built from the fetched FishBase pages" ;
    dct:description "Each row: species, a, b, sex, length range and type, r2, n, locality, FishBase row count on the page, retrieval time, and a note saying whether it looks fitted or estimated. Fetches logged in physics/SEARCHES.md (tags fb-summary-*, fb-lw-*)." ;
    dct:subject <https://w3id.org/delphi/resource/hypothesis/fishbase-length-weight-exocoetidae-coverage> ;
    rdfs:comment "Computed by physics/analysis.py from physics/glide-data.csv (sha256 bc24245b5163723b192e95fccf714ef6e4b3b28e71df4fef3befbaf008a00635) and physics/comparison-data.csv (sha256 e0d3d74639c1fe856fe5128c1783151596fde3acc923a2409be3d3f870cc394a); numbers in physics/results.json (sha256 63336841c0d4c9ae2760ae5c87a9251b97218e3ebfdd453cad4cffb9cdf6ba0b). Every input value carries its source, locator, retrieval time and value kind in those files." ;
    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/results.json>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/data/glide-data.csv>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/data/comparison-data.csv> .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-physics-thread-builder> ;
    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/data/result.json>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/results.json> .
  <https://w3id.org/delphi/resource/agent/delphisci-physics-thread-builder> a prov:SoftwareAgent ;
    rdfs:label "delphisci physics thread (Claude Fable 5.1 writing the data tables, the analysis script and this builder; a builder, not an assessor)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

