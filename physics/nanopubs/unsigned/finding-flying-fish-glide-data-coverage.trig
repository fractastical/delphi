    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType <https://w3id.org/delphi/ontology/Hypothesis> ;
    npx:introduces <https://w3id.org/delphi/resource/hypothesis/flying-fish-glide-data-no-complete-species-record-accessible> ;
    delphi:domain <https://w3id.org/delphi/resource/domain/biomechanics-and-scaling> .
  <https://w3id.org/delphi/resource/domain/biomechanics-and-scaling> rdfs:label "biomechanics-and-scaling" .
}
