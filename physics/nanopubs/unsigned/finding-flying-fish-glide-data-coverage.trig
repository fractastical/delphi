@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .
@prefix schema: <https://schema.org/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/hypothesis/flying-fish-glide-data-no-complete-species-record-accessible> a delphi:Hypothesis, skos:Concept ;
    rdfs:label "No open source gives body mass, fin area and a measured glide speed for the same flying fish" ;
    dct:description "A logged search of OpenAlex, PubMed, Europe PMC, Crossref and Semantic Scholar (97 calls, physics/SEARCHES.md) assembled 27 rows for six species or groups of Exocoetidae from four fetched sources. Only two species have first-hand measurements (Cypselurus hiraii: mass, fin areas, span, lift and drag coefficients; Cheilopogon heterurus doederleini: length, mass, take-off pitch and an estimated leap speed in captivity). Every glide speed, glide distance and flight height is a second-hand quote of works from 1941 to 1994 whose full texts are paywalled or unavailable online. No species has mass, fin area and a measured airspeed in the same accessible source. Status: supported, as a statement about the accessible literature on 2026-10-31." ;
    schema:additionalProperty [ a schema:PropertyValue ; schema:propertyID "n_rows" ; schema:value 27 ] ;
    schema:additionalProperty [ a schema:PropertyValue ; schema:propertyID "n_species" ; schema:value 6 ] ;
    schema:additionalProperty [ a schema:PropertyValue ; schema:propertyID "n_sources" ; schema:value 4 ] ;
    delphi:context "Claim under test: thompson1917-ch02-06 (D Arcy Thompson 1917, On Growth and Form, ch. II, Project Gutenberg 55264 lines 1716-1790), with thompson1917-ch02-07 and thompson1917-ch02-10. Taxon: Exocoetidae, NCBI Taxonomy 76072, GBIF 2968. Class Aves is the frozen holdout (holdout/exam.json); no bird value enters this record." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/physics-glide-data-coverage> ;
    prov:wasDerivedFrom <https://doi.org/10.1242/jeb.046052>, <https://doi.org/10.3354/ab00494>, <https://doi.org/10.1007/BF00044128>, <https://doi.org/10.1017/S0025315400048761>, <https://doi.org/10.1046/j.1095-8649.2003.00041.x>, <https://doi.org/10.1111/j.1469-7998.1990.tb04009.x>, <https://doi.org/10.1088/1748-3190/ab23e6> ;
    rdfs:comment "Status: supported. Does not establish: that the measurements do not exist; Davenport 1992 and Fish 1990 almost certainly contain wing loadings for several species behind a paywall, and Hertel 1966, Edgerton and Breder 1941 and Davenport 1990 hold the primary field speeds. Google Scholar and museum collections were not searched. This is a finding about access, written so the next team does not repeat the search." ;
    rdfs:comment "Pre-registration: physics/tests/thompson1917-ch02-06/result.json, written 2026-10-31T18:21:00Z before any wing loading, lifting area or lift coefficient was read, amended 2026-10-31T18:26:00Z before any fit ran (the file lists both and the values seen before each); sha256 at build 0094c084db22278a5f98d96cc2971ccd27813b0acdc458d60cadf7c7b7bcae48. The git commit that timestamps it is pending: the physics thread does not commit; the hub does." ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch06-05> ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/results.json> .
  <https://w3id.org/delphi/resource/evidence/physics-glide-data-coverage> a delphi:EvidenceItem ;
    rdfs:label "Coverage count of physics/glide-data.csv by column and value kind" ;
    dct:description "glide_distance_m: rows with a value 4, species or groups 3, value kinds {'secondary': 2, 'theory-secondary': 2}; glide_duration_s: rows with a value 1, species or groups 1, value kinds {'secondary': 1}; airspeed_m_s: rows with a value 3, species or groups 2, value kinds {'secondary': 2, 'theory-secondary': 1}; launch_speed_m_s: rows with a value 3, species or groups 3, value kinds {'secondary': 2, 'measured (length and mass); estimated (speed)': 1}; height_m: rows with a value 2, species or groups 2, value kinds {'secondary': 1, 'theory-secondary': 1}; body_mass_kg: rows with a value 21, species or groups 3, value kinds {'measured': 18, 'theory-secondary': 2, 'measured (length and mass); estimated (speed)': 1}; body_length_m: rows with a value 20, species or groups 3, value kinds {'measured': 18, 'measured (length and mass); estimated (speed)': 1, 'secondary': 1}; pectoral_fin_span_m: rows with a value 4, species or groups 1, value kinds {'measured': 4}; pectoral_fin_area_m2: rows with a value 6, species or groups 2, value kinds {'measured': 5, 'theory-secondary': 1}; pelvic_fin_area_m2: rows with a value 5, species or groups 1, value kinds {'measured': 5}; CL_max: rows with a value 2, species or groups 2, value kinds {'measured': 1, 'theory-secondary': 1}; LD_max: rows with a value 2, species or groups 2, value kinds {'measured': 1, 'theory-secondary': 1}. Missing: No first-hand measurement of airspeed or glide distance for any identified species: every speed and distance is a second-hand quote of Hertel 1966, Fish 1990, Davenport 1990/1994 or Edgerton and Breder 1941, none of which could be fetched in full. No species has body mass, fin area and a measured airspeed in the same source; Park and Choi 2010 gives mass and areas for 0.04-0.06 kg specimens, the speeds come from other, larger fish. Pectoral-fin span and area exist for one species (Cypselurus hiraii, five specimens). Wing loading for the north-east Atlantic species measured by Davenport 1992 is behind a paywall; only its allometric exponents are in the abstract (physics/allometry.json)." ;
    dct:subject <https://w3id.org/delphi/resource/hypothesis/flying-fish-glide-data-no-complete-species-record-accessible> ;
    rdfs:comment "Computed by physics/analysis.py from physics/glide-data.csv (sha256 bc24245b5163723b192e95fccf714ef6e4b3b28e71df4fef3befbaf008a00635) and physics/comparison-data.csv (sha256 e0d3d74639c1fe856fe5128c1783151596fde3acc923a2409be3d3f870cc394a); numbers in physics/results.json (sha256 63336841c0d4c9ae2760ae5c87a9251b97218e3ebfdd453cad4cffb9cdf6ba0b). Every input value carries its source, locator, retrieval time and value kind in those files." ;
    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/results.json>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/data/glide-data.csv>, <https://delphi-mission-control.ashenoy000.workers.dev/t/physics/data/comparison-data.csv> .
}

