    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch17-09: not-empirically-resolvable, resolvability 0.24";
    dc:description "Stream lines are a redescription of whatever displacement field the organism shows once a coordinate map has been fitted. Departures from orthogonality are assigned to the tissue not being homogeneous. That structure has no measurable outcome that would count against the claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: The claim says organisms grow along stream lines of a suitable transformation, with non-orthogonal cases explained by inhomogeneity. Because the transformation is chosen to fit the growth, every smooth growth field satisfies the description, and no public dataset can separate it from a rival growth law.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cell-tracking volumes exist for a few model embryos and still leave the transformation free to be chosen afterward.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.241"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "not-empirically-resolvable".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch17-09 by Grok 4.7: 0.25";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
