sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch11-08: resolvable-now, resolvability 0.75";
    dc:description "A geometric series of whorl breadths is a direct measurement with a numerical Nautilus benchmark, and open photographs and scans cover nautiloids, ammonoids and many gastropods. The sample is not every species, but it is large enough to confirm or refute both the progression and the threefold Nautilus ratio. The arithmetic is ordinary and can be done in days to weeks.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure whorl breadth along a radius for Nautilus, ammonoids and spiral gastropods and test for a geometric progression, including the specific claim that a Nautilus whorl is about three times the previous one. A constant ratio supports the logarithmic spiral; a drifting or arithmetic series refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Early whorls are often hidden or crushed, so the series may start mid-growth.", "Photographic scale and oblique views add error, smaller on CT than on plates.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.78"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-08--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-08--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.748"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "CT and mesh models of nautiloids, ammonoids and gastropods for whorl-breadth series.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Digital Atlas of Ancient Life";
    dc:description "Scaled fossil-shell photographs from which successive whorl breadths can be measured.";
    prov:wasDerivedFrom <https://www.digitalatlasofancientlife.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-08--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iDigBio";
    dc:description "Additional specimen images of spiral shells for the same radial measurements.";
    prov:wasDerivedFrom <https://www.idigbio.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch11-08 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-08--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-08--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
