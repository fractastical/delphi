    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch05-19: partially-resolvable, resolvability 0.53";
    dc:description "The prediction is measurable, but 'physical force' and 'simple characters' require interpretation. Public phylogenetic and fossil records cover useful subsets, while a clean test of common descent is confounded by taxonomy, preservation, and incomplete linkage of form to genotype.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Quantify morphological complexity and similarity in minute organisms, then test whether genetically distant or independently sampled lineages converge on identical simple forms more often than complex forms do.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Morphological descriptions and molecular samples rarely come from the same individuals.", "Preservation and taxonomic practice can create apparent form identity.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.66"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-19--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-19--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.53"^^xsd:double;
