<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-19--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PR2: Protist Ribosomal Reference database";
    dc:description "Public protist taxonomy and sequence data for estimating genealogical distance among morphologically classified taxa.";
