<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-19--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Neotoma Paleoecology Database";
    dc:description "Fossil occurrence and taxonomic records that can test continuity of simple microfossil forms through time.";
    prov:wasDerivedFrom <https://www.neotomadb.org/>.
