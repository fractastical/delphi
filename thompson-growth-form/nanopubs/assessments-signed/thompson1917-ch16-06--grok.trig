sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch16-06--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch16-06: needs-new-data, resolvability 0.35";
    dc:description "The claim is a process, not the finished architecture. Public micro-CT can show that trabeculae end up aligned, which several mechanisms share. A decisive test needs longitudinal imaging of the same struts under controlled shear, and that kind of open time series is not available for the analysis Thompson's wording requires.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Track individual trabeculae through time under a known shear field and record whether oblique elements are displaced into the principal-stress directions while aligned elements stay put. Support would be shear-driven relocation on that time scale; loss and replacement by cell remodeling, with no displacement of the existing strut, would fail Thompson's mechanism even if the final pattern matches the stress lines.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "In-vivo loading series that do exist are small, scattered in papers, and rarely deposit the image time series.", "Static micro-CT shows the aligned end state and does not record whether shear moved the strut.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.56"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.353"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch16-06--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch16-06 by Grok 4.7: 0.3";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.3"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-06--grok>.
