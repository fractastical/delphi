    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch15-03: partially-resolvable, resolvability 0.67";
    dc:description "The within-individual prediction is direct and highly discriminating. Existing public records likely test subsets, but a dataset jointly containing laying sequence, size and shape across breeds is not assured.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Analyze hen-level longitudinal laying records with egg mass and shape index, testing whether first eggs are smaller and rounder than later eggs and whether breeds with smaller relative eggs have rounder shapes. Consistent within-hen trajectories and breed effects support the claim; absent or reversed effects refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Feed, age, housing and selection line confound breed comparisons.", "Public poultry datasets often omit egg shape or exact laying order.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-03--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-03--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.669"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch15-03--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Ag Data Commons";
    dc:description "Public agricultural research datasets that may include poultry egg production and quality measurements.";
    prov:wasDerivedFrom <https://agdatacommons.nal.usda.gov/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch15-03--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Dryad";
    dc:description "Open animal-science datasets potentially containing repeated egg measurements.";
    prov:wasDerivedFrom <https://datadryad.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-03--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
