sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-13--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch17-13: resolvable-now, resolvability 0.86";
    dc:description "The claim is a phylogenetic hypothesis about named living clades, and those clades are densely sampled in public trees built from molecular data independent of the skull transformation. A small team can read the relationship off existing syntheses in days. That is a direct confirm-or-refute test of the relatedness statement.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Place Perissodactyla, other ungulates, Leporidae and other rodents on genome-based trees and test the two sister-group claims: perissodactyls closer to rabbits than to other ungulates, and rabbits closer to perissodactyls than to other rodents. Either grouping is refuted if the credible trees put perissodactyls with other laurasiatheres and rabbits with rodents.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Deep mammal nodes still differ in a few published studies, though the Glires versus Laurasiatheria split is repeatedly recovered.", "The skull-flexure argument that motivated the claim is a separate morphological question and is not settled by the tree alone.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-13--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.861"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch17-13--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Open Tree of Life";
    dc:description "Synthetic phylogeny of mammals for the perissodactyl-lagomorph relationship";
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/opentree>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch17-13--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: TimeTree";
    dc:description "Compiled published divergence times and trees for the same clades";
    prov:wasDerivedFrom <https://timetree.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-13--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch17-13 by Grok 4.7: 0.88";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.88"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-13--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-13--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
