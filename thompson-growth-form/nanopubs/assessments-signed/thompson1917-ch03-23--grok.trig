    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/operationalizability";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--grok>.
<https://w3id.org/delphi/resource/claim/thompson1917-ch03-23> <https://w3id.org/delphi/ontology/hasAssessment> <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--grok>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--grok--analysis-feasibility>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--grok--data-adequacy>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--grok--data-existence>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--grok--discriminating-power>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--grok--operationalizability>
