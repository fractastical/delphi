    <http://www.w3.org/2000/01/rdf-schema#label> "Operationalizability of thompson1917-ch03-23 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability>;
