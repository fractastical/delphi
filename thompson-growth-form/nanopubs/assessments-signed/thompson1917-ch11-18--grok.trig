sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-18--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch11-18: partially-resolvable, resolvability 0.58";
    dc:description "The predicted association of spiral direction with shell shape is checkable from illustrated and scanned brachiopods, and those resources exist for the classical genera. They do not record the pressures inside the shell, so the causal clause is not directly measured. Phylogenetic conservatism can produce the same association, which limits how far a positive table would establish the mechanical explanation.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Pair brachidial spiral direction and form with shell outline across spire-bearing brachiopods: outward spirals with transverse shells such as Spirifer, inward spirals with rounded shells such as Atrypa, and discoid spirals with flattened shells. The association is supported or refuted by that cross-tabulation; the pressure mechanism remains an interpretation of the association.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Many specimens preserve the shell outline without the brachidium, so the paired sample is smaller than shell collections.", "Spiral direction and shell shape can be conserved together by ancestry rather than by spatial constraint.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-18--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-18--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-18--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-18--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Digital Atlas of Ancient Life";
    dc:description "Illustrated brachiopods, some with spiralia, for pairing shell shape with spiral direction.";
    prov:wasDerivedFrom <https://www.digitalatlasofancientlife.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-18--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "CT of brachiopods in which internal spiral brachidia are visible.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-18--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Taxonomic and occurrence framework for the spire-bearing groups being compared.";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-18--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch11-18 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
