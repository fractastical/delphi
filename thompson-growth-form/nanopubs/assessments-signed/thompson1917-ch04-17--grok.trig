    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-17--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-17--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch04-17 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
