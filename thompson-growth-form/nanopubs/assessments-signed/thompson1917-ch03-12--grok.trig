sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-12--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch03-12: resolvable-now, resolvability 0.73";
    dc:description "Fetal size by week of gestation is tabulated in a large public standard, and locating a velocity maximum is a direct calculation. The fifth-month inflection is specific enough to fail if the peak lies elsewhere. The remaining weakness is that the measured length is often a skeletal segment rather than whole-body length, so the test is exact only if that proxy tracks the length Thompson plotted. That is a limited measurement issue, not a missing dataset.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate human fetal length velocity by gestational age. A maximum near the fifth month, with velocity rising before it and falling after, would support the claim. A maximum far from that month, or no inflection, would refute it. Femur length or crown-rump length may stand in for crown-heel length if the two are shown to share the same velocity peak.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dating error and cross-sectional sampling can shift the apparent month of the inflection.", "Modern standards usually record femur length or crown-rump length rather than the crown-heel length of the older curves.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-12--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.728"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-12--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: INTERGROWTH-21st";
    dc:description "International fetal biometry by gestational age, used to locate the velocity maximum of prenatal linear growth";
    prov:wasDerivedFrom <https://intergrowth21.tghn.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-12--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-12 by Grok 4.7: 0.75";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.75"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-12--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-12--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch03-12 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
