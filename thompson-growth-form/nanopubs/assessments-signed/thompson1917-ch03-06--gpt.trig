    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-06--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-06: resolvable-now, resolvability 0.85";
    dc:description "Adult stature and age are directly measured in large public studies, and the age trend has an explicit refuting pattern. Longitudinal aging data can separate within-person loss from cohort differences sufficiently to resolve the claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Estimate measured standing height by age in adulthood, preferably longitudinally, and test whether decline begins before 50 and is appreciable by 60 and extreme old age. Stable stature through those ages would refute the timing and magnitude claims.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cross-sectional age differences include cohort effects.", "Posture and vertebral compression affect standing height measurement.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.91"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-06--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.85"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-06--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: CDC National Health and Nutrition Examination Survey";
    dc:description "Public measured adult stature across a wide age range.";
    prov:wasDerivedFrom <https://www.cdc.gov/nchs/nhanes/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-06--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
