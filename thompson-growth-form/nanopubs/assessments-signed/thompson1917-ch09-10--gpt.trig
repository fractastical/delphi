    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EMPIAR";
    dc:description "Open volumetric electron microscopy can provide cellular junction and spicule geometry in selected specimens.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/empiar/>.
