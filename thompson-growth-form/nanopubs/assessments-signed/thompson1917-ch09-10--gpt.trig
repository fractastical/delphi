<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-10--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch09-10: partially-resolvable, resolvability 0.59";
    dc:description "The angular predictions are precise and readily analyzed. Public morphology can test angle distributions, but resolving formation at cell junctions needs rare developmental volumes and controls for crystallography.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure ray angles and curvature in 3D spicules and, where developmental imaging exists, compare ray trajectories with three- and four-cell junctions. Support requires clustering near 120 and 109.47 degrees for equal-cell junctions and predictable deviations with unequal cells.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Crystal growth constraints can generate similar angles.", "Matched developing-cell and spicule datasets are scarce.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-10--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.593"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
