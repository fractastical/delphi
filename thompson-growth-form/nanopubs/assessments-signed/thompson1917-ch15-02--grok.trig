sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch15-02: partially-resolvable, resolvability 0.71";
    dc:description "The comparative rule, that the most tapered eggs are large relative to the parent, can be fit directly to open shape and adult-size data spanning most bird orders. Those same datasets have already been used to compare anatomical and incubation correlates, so the pattern is resolvable and the pressure mechanism is only proxied. A positive size–asymmetry slope would support the rule Thompson states and would still leave rival causes of taper in play.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Regress egg asymmetry on egg size relative to adult body size across species, with a phylogenetic control, and inspect named cases such as guillemots, sandpipers, terns, and Apteryx. The common rule is supported by a positive relationship and by the stated exceptions having large oviducts; the pressure explanation is not tested unless oviduct pressure, rather than relative size alone, is measured.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Oviduct dimensions in the open file are not pressure records along the forming egg.", "Relative size is a proxy for the pressure Thompson invokes, and flight or nesting correlates can produce the same pattern.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.73"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-02--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.711"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch15-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Avian egg shape, oviduct, and pelvis";
    dc:description "Species-level egg shape together with oviduct and pelvic measurements for a large sample of birds";
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.sj3tx9648>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch15-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Stoddard et al. 2017 egg-shape supplement";
    dc:description "Asymmetry, ellipticity, and egg length across bird species, joinable to adult body size";
    prov:wasDerivedFrom <https://doi.org/10.1126/science.aaj1945>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch15-02 by Grok 4.7: 0.78";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.78"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-02--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-02--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch15-02 by Grok 4.7: 0.68";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.68"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-02--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch15-02--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch15-02 by Grok 4.7: 0.8";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-existence>;
