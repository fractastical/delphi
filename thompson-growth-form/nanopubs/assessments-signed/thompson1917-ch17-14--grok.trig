sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-14--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch17-14: partially-resolvable, resolvability 0.58";
    dc:description "The interpolation test is well defined and the taxa are classical, with published measurements and a growing set of scans. Open 3D coverage of Mesohippus, Protohippus and Hyracotherium is incomplete, so a team would still compile plates and specimens. The geometric coincidence can be assessed for the available skulls and does not by itself prove the phylogenetic series.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Build a coordinate path from Hyracotherium to Equus and measure the distance of Mesohippus and Protohippus skulls to the interpolated shapes, relative to skulls that are not on that path. Close coincidence, closer than off-path equids, would support the claim; distances as large as those of unrelated perissodactyls would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "A linear morph between two endpoints can pass near intermediate fossils without those fossils lying on the phylogenetic path.", "Complete, undistorted skulls of the named fossil genera are few, and only some are openly scanned.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.56"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-14--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch17-14--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Scans of fossil and living equid skulls where museums have deposited them";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch17-14--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Taxonomic and occurrence framework for which equid skulls exist to be measured";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-14--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch17-14 by Grok 4.7: 0.52";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.52"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-14--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-14--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch17-14 by Grok 4.7: 0.46";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
