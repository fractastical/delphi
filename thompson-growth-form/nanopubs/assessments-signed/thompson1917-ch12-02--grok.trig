sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-02--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch12-02: partially-resolvable, resolvability 0.56";
    dc:description "Spiral versus non-spiral architecture can be scored from existing image libraries, including the radiolarian contrast Thompson draws. The causal step is harder: many shells grow by external addition without becoming logarithmic spirals, and many spirals arise by other routes, so a frequency difference would remain compatible with several growth rules. Available images support a comparative test on well-illustrated groups, not a direct measurement of incremental accretion.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Code shell coiling and growth mode for multilocular Foraminifera and for Radiolaria, then test whether exterior accretion predicts a higher frequency of logarithmic spirals. The tendency would be supported by a large excess of spirals among accretionary foraminifera after phylogenetic correction, and weakened if milioline and other accretionary tests are commonly non-spiral at rates similar to non-accretionary skeletons.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Coiling categories in taxonomic databases are coarse and phylogenetically clustered.", "Exterior accretion is how most foraminiferal tests grow, so the proposed cause is partly built into the materials being compared.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.62"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-02--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.559"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-02--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: pforams@mikrotax";
    dc:description "Illustrated taxonomy and morphological characters for planktonic foraminifera";
    prov:wasDerivedFrom <https://www.mikrotax.org/pforams/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-02--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Micro-CT of foraminifera and radiolaria for comparing spiral and non-spiral skeletons";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-02--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Endless Forams";
    dc:description "Species-level images of planktonic tests whose coiling can be scored";
    prov:wasDerivedFrom <http://www.endlessforams.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-02--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch12-02 by Grok 4.7: 0.65";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.65"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-02--grok>.
