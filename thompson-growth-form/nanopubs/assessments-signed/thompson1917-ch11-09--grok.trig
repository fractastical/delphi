sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch11-09: partially-resolvable, resolvability 0.60";
    dc:description "The parameter list maps onto the usual coiling model and can be fit to public shells, but all differences is stronger than a good fit to typical spires. Irregular, highly sculptured and heteromorph shells are present in the archives yet not in one harmonized morphospace. A large subset can show whether residuals are negligible, without exhausting every difference of form the claim includes.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit each univalve shell with the generating curve, its expansion, rotation about the pole, translation along the axis and inclination, and test whether residuals between shells are only quantitative. Small residuals support the claim that all form differences are of degree; structured residuals that need extra factors refute that completeness.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Open 3D coverage is uneven across living and fossil univalves.", "Sculpture, aperture deviations and uncoiling may sit outside the listed factors, so the residual test depends on how the generating curve is defined.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.55"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.602"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "3D univalve shells for fitting the growth-ratio parameters and inspecting residuals.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iDigBio";
    dc:description "Broad photographic coverage of gastropod and cephalopod shells for the same parameter fit.";
    prov:wasDerivedFrom <https://www.idigbio.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch11-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Digital Atlas of Ancient Life";
    dc:description "Fossil univalves, including irregular forms, used to see whether the parameter set still suffices.";
    prov:wasDerivedFrom <https://www.digitalatlasofancientlife.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch11-09 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-09--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch11-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch11-09 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
