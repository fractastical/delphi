    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-10--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch12-10: partially-resolvable, resolvability 0.39";
    dc:description "A restricted trait-dependent survival test is possible, but it captures only one meaning of fitness. The universal equality and proposed explanation are too broad to resolve cleanly with observational datasets.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Define fitness as lineage persistence or extinction risk and test whether shell-form traits predict survival across environmental transitions in fossil occurrence data. Detectable trait-dependent survival would refute the equal-fitness assertion, while no association under well-powered models would only weakly support it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "'Simple laws' and fitness are not uniquely defined.", "Fossil persistence is a noisy proxy for organismal fitness.", "Preservation and sampling strongly confound form-dependent survival.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.71"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-10--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.389"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-10--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Paleobiology Database";
    dc:description "Public occurrence records for estimating foraminiferal lineage durations and extinction patterns.";
    prov:wasDerivedFrom <https://paleobiodb.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-10--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PANGAEA";
    dc:description "Marine sediment records connecting assemblage changes with environmental conditions.";
    prov:wasDerivedFrom <https://www.pangaea.de/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-10--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
