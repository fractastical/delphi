    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-18--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch02-18: partially-resolvable, resolvability 0.67";
    dc:description "Modern cell-size and genome data can directly evaluate whether known organisms approach a plausible molecular lower bound and whether much smaller forms have been found. The phrase cannot be much smaller remains imprecise, and completeness of discovery cannot be guaranteed.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compile verified dimensions, genome sizes and molecular inventories of the smallest free-living and host-dependent organisms, estimate the minimum components required for autonomous life, and compare discovered cells with that bound. Organisms substantially below the proposed scale would refute the historical prediction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Dependence on hosts blurs the definition of organism and minimum autonomous machinery.", "Reported ultramicrobe sizes can reflect filtration artifacts or nonliving particles.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-18--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.673"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-18--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BacDive";
    dc:description "Public bacterial and archaeal phenotypes, including cell morphology and dimensions for many strains.";
    prov:wasDerivedFrom <https://bacdive.dsmz.de/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-18--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: NCBI Genome";
    dc:description "Public genome assemblies and sizes for microorganisms.";
