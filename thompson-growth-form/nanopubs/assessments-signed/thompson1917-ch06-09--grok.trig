sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch06-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch06-09: partially-resolvable, resolvability 0.43";
    dc:description "Image archives cover a wide range of unicellular outlines, so a restricted geometric reading can be tried on mineralized and a few imaged protists. The claim that those departures from symmetry are produced by local surface tension does not specify a result that would rule out other cortical forces. That gap in discriminating power, not a lack of photographs, is what keeps the claim only partly testable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: For unicells with a measured asymmetry, test whether the outline matches a surface whose local curvature corresponds to a localized change in surface tension, against a cytoskeletal template that survives membrane extraction. A curvature field that accounts for the asymmetry, and that disappears when cortical mechanics are altered, would support the claim; asymmetries that persist as patterned cytoskeleton with no curvature match would limit it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Almost any outline can be assigned a local tension after the fact, so a mere correlation is a weak decision rule.", "Tension is rarely measured on the same cells whose shapes fill the taxonomic image libraries.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.5"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-09--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.435"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch06-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: mikrotax";
    dc:description "Large public image sets of mineralized unicells whose departures from symmetry can be measured";
    prov:wasDerivedFrom <https://www.mikrotax.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch06-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Cell Image Library";
    dc:description "Reviewed cell images, including protists, for comparing cortical ultrastructure with outline asymmetry";
    prov:wasDerivedFrom <https://www.cellimagelibrary.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch06-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch06-09 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-09--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch06-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch06-09 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
