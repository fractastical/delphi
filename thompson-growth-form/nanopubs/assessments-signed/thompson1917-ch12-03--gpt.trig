<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-03--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch12-03: partially-resolvable, resolvability 0.54";
    dc:description "The geometric predictions are explicit, and public tomography can test them for selected taxa. The causal pressure-side inference remains indirect and confounded by secretion and tissue support.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure septal curvature and attachment boundaries in tomographic shells of Foraminifera and Nautilus, then compare observed surfaces with numerically computed minimum-area surfaces under inferred pressure orientation. Reversed curvature with good minimum-surface fits would support the claim; inconsistent orientation or poor fits would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Preservation and scan resolution can distort thin septa.", "Pressure at septum formation is generally absent from museum datasets.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.7"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-03--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.54"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
