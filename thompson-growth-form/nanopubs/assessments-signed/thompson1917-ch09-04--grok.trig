sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch09-04: partially-resolvable, resolvability 0.51";
    dc:description "The structural comparison is measurable, but the inference from shared structure to a shared physico-chemical mode is one interpretation among others. Otolith outlines are well archived, while matched sections of pearls, otoliths and laboratory calcospherites are not. A subset comparison is feasible from images and scans; it would not cleanly exclude other ways of building the same fabric.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare sectioned pearls, molluscan and teleost otoliths, and albumin-precipitated calcospherites for concentric zoning and radial fabric. A shared geometry supports a common precipitation mode; systematic differences in zoning or crystal habit refute the identification.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Pearls and artificial calcospherites are mostly illustrated in papers, not in the otolith catalogues.", "Similar concentric-radiate structure can arise from more than one precipitation chemistry.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.58"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-04--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.51"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch09-04--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AFORO";
    dc:description "Open catalogue of teleost sagitta images and outlines, a partial view of otolith form rather than sectioned internal fabric.";
    prov:wasDerivedFrom <http://aforo.cmima.csic.es/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch09-04--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Downloadable micro-CT of biomineral specimens, usable where otolith or concretion volumes resolve internal zonation.";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch09-04 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
