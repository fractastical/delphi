sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-09--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch12-09: partially-resolvable, resolvability 0.60";
    dc:description "Whether named forms are temporary variants or lineages is a standard species-delimitation question, and planktonic foraminifera now have both image libraries and public sequences. Those data cover only part of the benthic diversity the claim invokes, and life-cycle series that would show one individual passing through several 'species' remain scarce. Where sequences and morphology can be paired, the contrast between ecophenotypes and lineages is sharp.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Compare morphometric clusters with genetic clusters for genera Thompson treats as variable, especially Peneroplis and planktonic groups with many named forms. The claim is supported where single genetic lineages occupy several named species or genera and morphology shifts within a life cycle; it is refuted where those names correspond to stable, reciprocally monophyletic lineages.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cryptic species make the opposite error from ecophenotypes, so a single global test will not have one answer.", "Peneroplis, the example in the text, has far less public genetic and culture data than planktonic globigerinids.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.67"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-09--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-09--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: GenBank";
    dc:description "Public sequences of planktonic and some benthic foraminifera for species-boundary tests";
    prov:wasDerivedFrom <https://www.ncbi.nlm.nih.gov/genbank/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-09--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Endless Forams";
    dc:description "Expert-labeled images of 35 modern planktonic species for comparing named forms with continuous shape variation";
    prov:wasDerivedFrom <http://www.endlessforams.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-09--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: pforams@mikrotax";
    dc:description "Taxonomic concepts and images against which genetic clusters can be matched";
    prov:wasDerivedFrom <https://www.mikrotax.org/pforams/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-09--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch12-09 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-09--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-09--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
