sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-05--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch13-05: partially-resolvable, resolvability 0.56";
    dc:description "Separating a shared spiral angle from a differing shear is a well-posed 3D measurement and would cleanly support or reject the comparison among these sheep. Public scans and photographs of the three species are sparse and often show the skull without a full horn, so the test is limited to whatever intact specimens can be assembled. The decision criterion itself is strong; the sample is the obstacle.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Decompose each argali horn into a logarithmic angle in the generating plane and a helical pitch, then compare Ovis ammon, O. poli, and O. hodgsoni. The claim is supported if the logarithmic angles agree within measurement error while pitch differs; a species difference in the logarithmic angle as large as the difference in pitch would refute the stated partition.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Complete sheaths of all three named argali are scarce in open 3D repositories.", "Single photographs confound the in-plane angle with the helical component.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.52"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-05--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.557"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch13-05--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: MorphoSource";
    dc:description "Any open 3D Ovis crania from which spiral angle and helical pitch can be separated";
    prov:wasDerivedFrom <https://www.morphosource.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch13-05--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: iDigBio";
    dc:description "Specimen photographs of Asiatic wild sheep for a coarser two-view estimate";
    prov:wasDerivedFrom <https://www.idigbio.org/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-05--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch13-05 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.5"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-05--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-05--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch13-05 by Grok 4.7: 0.35";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.35"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-05--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-05--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data existence of thompson1917-ch13-05 by Grok 4.7: 0.4";
