sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch03-23: partially-resolvable, resolvability 0.64";
    dc:description "Seasonality and damping have direct statistical meanings and can be compared with nonperiodic growth models. Existing fish data can test population-level patterns, but the full claim needs longitudinal, seasonally resolved measurements in both fishes and humans.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Fit longitudinal length or mass trajectories with and without an annually periodic term whose amplitude declines with age, separately in plaice, haddock, and humans. Support requires improved out-of-sample fit and declining seasonal amplitude in each stated group.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cross-sectional fish surveys do not track the same individuals.", "Open human longitudinal records with fine seasonal resolution are limited.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.76"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-23--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-23--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.643"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-23--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: International Council for the Exploration of the Sea Data Centre";
    dc:description "Public fisheries survey data can provide repeated size-at-age observations for plaice and haddock.";
    prov:wasDerivedFrom <https://www.ices.dk/data/data-portals/Pages/default.aspx>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-23--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FishBase";
    dc:description "Growth parameters and life-history records can identify relevant species and growth series.";
    prov:wasDerivedFrom <https://www.fishbase.se/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-23--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-23 by GPT-5.6 Sol: 0.7";
