<https://w3id.org/delphi/resource/assessment/thompson1917-ch17-12--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch17-12: resolvable-now, resolvability 0.81";
    dc:description "The reconstruction statement supplies a strong quantitative criterion, and open 3D material spans living and fossil crocodilians. Annotation is substantial but feasible, and residuals can decisively assess whether one transformation accounts for the differences.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Apply one smooth coordinate transformation between homologous crocodilian skull surfaces, sutures and openings, and quantify bone-by-bone reconstruction error against flexible or modular alternatives.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Fossil distortion and missing regions affect fit.", "Sutures and vacuities require detailed annotation.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-12--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.813"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
