    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch15-10: partially-resolvable, resolvability 0.66";
    dc:description "The scaling relation and deviation are explicit. Relevant open measurements exist, but joining vessel-scale anatomy to local pressure across the complete arterial-capillary range requires heterogeneous sources.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure lumen radius, wall thickness and pressure along arterial trees and fit the predicted large-vessel proportionality and small-vessel downward deviation. Models with and without pressure decline can be compared.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Capillary wall thickness requires histology or microscopy.", "Geometry and local pressure are generally not measured in the same subjects.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.75"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-10--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.662"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
