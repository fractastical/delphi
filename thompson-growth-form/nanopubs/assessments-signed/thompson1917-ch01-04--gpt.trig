    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch01-04: partially-resolvable, resolvability 0.29";
    dc:description "Selected mechanisms can be checked against physical constraints, but the universal negative is not confirmable from datasets. Existing physiological records rarely include complete system boundaries needed for strong conservation tests.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Audit well-measured physiological processes for reproducible violations of conservation laws or established chemical and transport laws after closing their mass and energy budgets. A robust closed-system violation would refute the claim, but repeated compliance in sampled systems cannot confirm its unrestricted scope.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Apparent violations commonly reflect unmeasured fluxes or model error.", "No finite dataset covers every organism and physical law.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.8"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch01-04--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.293"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
