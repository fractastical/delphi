    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: PhysioNet";
    dc:description "Open physiological recordings for testing quantitative physical constraints in selected bodily systems.";
    prov:wasDerivedFrom <https://physionet.org/>.
