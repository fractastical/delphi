<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-10--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch02-10: partially-resolvable, resolvability 0.70";
    dc:description "The exponent is directly estimable with standard allometric models, and large open movement and trait resources exist. Coverage and standardization are uneven across all three modes, and the similar-construction condition reduces effective sample size.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Within each locomotor mode and among similarly constructed species, regress characteristic velocity on linear size and test whether the exponent is 0.5. Mode-specific exponents significantly different from one-half would refute the claimed common result.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Characteristic speed must be standardized across tracking studies.", "Construction, behavior and environment covary strongly with size.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.84"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-10--gpt--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-10--gpt--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.698"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-10--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Movebank";
    dc:description "Public tracking data for estimating walking, swimming and flight speeds.";
    prov:wasDerivedFrom <https://www.movebank.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-10--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AVONET";
    dc:description "Bird morphology and mass for flight scaling analyses.";
    prov:wasDerivedFrom <https://opentraits.org/datasets/avonet.html>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-10--gpt--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: FishBase";
    dc:description "Fish lengths and ecological traits for swimming comparisons.";
