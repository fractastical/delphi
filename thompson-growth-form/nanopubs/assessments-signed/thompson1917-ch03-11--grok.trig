sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch03-11: partially-resolvable, resolvability 0.66";
    dc:description "Rate and duration are separable on existing growth curves, and the three named species are represented in public life-history compilations and human growth standards. That is enough to check the rabbit-guinea pig and human-rabbit contrasts. Extending the result to mammals in general is limited by uneven raw curves, and model-based parameters partly build in the decomposition they are asked to test, so the general claim is only partly resolved.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Decompose adult size into a rate parameter and a duration for human, rabbit, and guinea pig, and then across mammals more generally. The named contrasts predict a higher rate for the rabbit than the guinea pig and a longer duration for the human than the rabbit. A model that uses only rate or only duration should fail if both factors matter.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Energy-budget parameters already impose a rate-duration decomposition, so they are not a fully independent test.", "Nutrition in the classical laboratory comparisons is not standardized across species.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.64"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.663"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Add-my-Pet";
    dc:description "Growth data and life-cycle parameters for human, rabbit, guinea pig, and many other mammals";
    prov:wasDerivedFrom <https://bio.vu.nl/thb/deb/deblab/add_my_pet/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: AnAge";
    dc:description "Adult body mass and longevity as coarse correlates of size and growth duration";
    prov:wasDerivedFrom <https://genomics.senescence.info/species/index.html>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch03-11--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: WHO Child Growth Standards";
    dc:description "Human postnatal growth rate and the long duration of human growth";
    prov:wasDerivedFrom <https://www.who.int/tools/child-growth-standards>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-11--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch03-11 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-11--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch03-11--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch03-11 by Grok 4.7: 0.5";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
