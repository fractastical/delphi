sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-23--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch05-23: partially-resolvable, resolvability 0.58";
    dc:description "Open trypanosome tomograms can decide whether the membrane along the flagellum is an empty film or a fold built on an axoneme. That resolves the structural core for Trypanosoma brucei and leaves the developmental story, the constancy of mean curvature, and the denial of active motility only partly tested. Related flagellates in the stated scope are not in the same deposits.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Segment the trypanosome undulating membrane in three-dimensional electron microscopy and test whether its surface has constant mean curvature and lacks internal cytoplasm and cytoskeleton. A naked film whose waves persist without flagellar bending would support the claim; a cytoplasmic fold waved by the flagellar apparatus would refute the soap-film account.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Available tomograms center on the axoneme and paraflagellar rod, so the mean curvature of the whole undulating membrane is only partly in frame.", "Trichomonas and spermatozoa with undulating membranes are outside this trypanosome archive, and static maps do not show whether the wave is actively driven.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.6"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-23--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-23--grok--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.583"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-23--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: EMDB EMD-23621";
    dc:description "Public cryo-electron tomogram of the bloodstream-form Trypanosoma brucei flagellum, for testing whether the flagellum-associated membrane is a structured fold or an empty film";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/emdb/EMD-23621>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch05-23--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Electron Microscopy Data Bank";
    dc:description "Further public trypanosome flagellar maps, including axoneme and paraflagellar-rod averages";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/emdb/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-23--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch05-23 by Grok 4.7: 0.55";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.55"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-23--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-23--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch05-23 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-data-adequacy>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/data-adequacy";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-23--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch05-23--grok--data-existence> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
