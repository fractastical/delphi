    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-11--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch04-11: resolvable-now, resolvability 0.78";
    dc:description "This prediction specifies observable trajectory geometry and a direct refuting result. Standard segmentation and tracking can test it in public time-lapse datasets, although exact species coverage may be limited.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Segment male and female pronuclei and the egg center in 3D time-lapse fertilization movies, then measure path curvature, convexity, meeting position, and post-meeting trajectory. The stated geometry is confirmed if non-diametric starts produce the predicted curves and precentral meeting consistently; contrary trajectories refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Projection of 3D paths into 2D can bias curvature.", "Public datasets may emphasize model organisms other than frogs.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-11--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.775"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch04-11--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioImage Archive";
    dc:description "Open fertilization and early-embryo time-lapse microscopy can supply pronuclear trajectories.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/bioimage-archive/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-11--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
