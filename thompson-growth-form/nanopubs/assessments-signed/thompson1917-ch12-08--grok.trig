sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-08--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch12-08: partially-resolvable, resolvability 0.60";
    dc:description "Coiling geometry and life habit are observable and widely described, and planktonic assemblages are already tabulated globally. No single open table pairs attachment, flattening, and coiling across benthic genera, so the test requires a compilation. Exceptions are informative where they have been illustrated, but phylogenetic structure will keep the result from being a clean mechanical demonstration.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Score planispiral versus trochospiral coiling, ventral flattening, and life habit (attached, free benthic, planktonic) across genera, then test the association with a phylogenetic model. The claim is supported if attached species are disproportionately plane and flattened on the attached face while planktonic species are disproportionately helicoid; abundant attached trochospirals or free planispiral plankton would undermine the stated contrast.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Attached versus free habit and the flattened face are not fields in the census databases and must be compiled from monographs.", "Coiling mode is phylogenetically conserved, so a habit correlation can be a clade effect.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.63"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-3>;
    <https://w3id.org/delphi/ontology/hasScore> "0.596"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: World Foraminifera Database";
    dc:description "Taxonomic catalogue of living foraminifera that can be joined to published habit and coiling codes";
    prov:wasDerivedFrom <https://www.marinespecies.org/foraminifera/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: ForCenS";
    dc:description "Global surface-sediment census of planktonic species, the floating end of the contrast";
    prov:wasDerivedFrom <https://doi.org/10.1594/PANGAEA.873570>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-3> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: bforams@mikrotax";
    dc:description "Images and morphological characters for benthic tests, including attached and coiled forms";
    prov:wasDerivedFrom <https://www.mikrotax.org/bforams/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-08--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch12-08 by Grok 4.7: 0.6";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.6"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-08--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch12-08--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Data adequacy of thompson1917-ch12-08 by Grok 4.7: 0.48";
