<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (GPT-5.6 Sol)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium>.
<https://w3id.org/delphi/resource/model/gpt-5.6-sol-medium> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-16--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch02-16: partially-resolvable, resolvability 0.72";
    dc:description "The variables and refuting pattern are clear, and extensive cellular images exist. However, data directly pairing individual body size, cell size and cell number across the claimed taxa and phenotypes are incomplete, so the broad law is only partially resolvable.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure volumes of matched cell types across dwarf, normal and giant individuals and regress cell size and cell number on body size. Nearly invariant cell size with number accounting for body-size differences supports the claim; strong within-type cell-size scaling refutes it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cell volume estimates depend on tissue preparation and segmentation.", "Matched body-size phenotypes and cell types are uncommon in one dataset.", "Some tissues vary by ploidy or hypertrophy.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.83"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-16--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-16--gpt--dataset-2>;
    <https://w3id.org/delphi/ontology/hasScore> "0.718"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-16--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Human Protein Atlas";
    dc:description "Open tissue microscopy for measuring cell dimensions across tissue types.";
    prov:wasDerivedFrom <https://www.proteinatlas.org/>.
<https://w3id.org/delphi/resource/evidence/thompson1917-ch02-16--gpt--dataset-2> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioImage Archive";
    dc:description "Public comparative microscopy datasets with cellular resolution.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/bioimage-archive/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch02-16--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch02-16 by GPT-5.6 Sol: 0.7";
