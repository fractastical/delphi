<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-16--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch04-16: partially-resolvable, resolvability 0.57";
    dc:description "Force-balance models make testable shape predictions in selected systems. Public images and perturbations can assess an important role for tension, but not its sufficiency across all segmentation and organization cases.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure cortical tension, cell-boundary curvature, and separation during egg segmentation and unicellular or multicellular morphogenesis, then perturb tension and compare predicted versus observed outlines. Support requires tension changes to account for boundary formation beyond adhesion, wall, and cytoskeletal alternatives.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Cell outline is jointly determined by cortex, adhesion, walls, and pressure.", "Most datasets lack direct tension measurements.", "The claim spans unrelated organizational scales.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.72"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-16--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.568"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
