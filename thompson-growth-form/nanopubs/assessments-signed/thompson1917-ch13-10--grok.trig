sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch13-10: partially-resolvable, resolvability 0.51";
    dc:description "Unequal flank growth is a measurable alternative to uniform elongation, and classic and later experiments report it for particular twiners. Those measurements are not assembled as a public dataset a team could download and reanalyze, and they rarely span the diversity of climbing stems. The comparison with horn growth is an analogy; the plant data that exist can test local differential growth in a few species only.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: During circumnutation, compare epidermal or cortical extension rates on opposite flanks along the elongating stem. The claim is supported if the revolving bend is accompanied by a rotating excess of growth on the convex side over a long zone of the stem; it is weakened if the stem revolves while flank growth rates remain equal.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Kinematic and local-strain measurements of twining stems are scattered in papers rather than held in one open repository.", "Most series cover one or two model climbers, not twining plants as a class.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.56"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.507"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch13-10 by Grok 4.7: 0.45";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.45"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
