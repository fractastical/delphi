sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-16--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch04-16: partially-resolvable, resolvability 0.40";
    dc:description "Visible cell outlines are imaged in quantity, but the claim identifies surface tension as the force that creates them. That identification needs tension manipulations that are scattered and confounded with yolk and adhesion. Existing movies can test a proxy, completion of furrows, for a limited set of eggs, not the force ranking as stated for cells in general.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Relate the presence of visible cell boundaries in cleaving eggs to measured cortical tension, contrasting partial and total segmentation and unicellular versus multicellular organisation. Boundaries that appear only where tension succeeds, and disappear when tension is removed while adhesion is held fixed, would support the claim; boundaries set by adhesion or yolk distribution with tension unchanged would refute it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Tension during cleavage is not an archived field.", "The phrase 'sphere of action of localised forces' adds no extra measurement.", "Yolk amount and cell-cell adhesion predict partial versus total cleavage as well as tension does.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.54"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-16--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch04-16 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
    dc:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-16--grok>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-16--grok--data-adequacy> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
