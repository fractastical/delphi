    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch04-02: resolvable-now, resolvability 0.71";
    dc:description "The categorical rejection of traction has clear observable consequences, and open perturbation microscopy can test whether microtubule mechanics account for spindle behavior. The unspecified nature of the alternative polarizing field lowers operationalizability but does not prevent refuting the claim.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Use live-cell spindle imaging and perturbation data to test whether spindle fibers transmit mechanical traction and whether a distinct magnetism-like bipolar field is needed to predict chromosome and particle motion. Evidence of tensile microtubule forces sufficient to explain the pattern refutes the exclusion of mechanical traction.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Images alone may not directly measure force.", "The proposed field is analogical rather than quantitatively specified.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.86"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-02--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.715"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "resolvable-now".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch04-02--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioImage Archive";
    dc:description "Public live-cell microscopy provides spindle and chromosome trajectories under perturbation.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/bioimage-archive/>.
