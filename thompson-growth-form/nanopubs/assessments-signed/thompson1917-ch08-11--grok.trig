sub:assertion {
<https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> a prov:SoftwareAgent;
    <http://www.w3.org/2000/01/rdf-schema#label> "delphisci dataset-resolvability assessor (Grok 4.7)";
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192>;
    <https://w3id.org/delphi/ontology/usesModel> <https://w3id.org/delphi/resource/model/grok-4.7-high-fast>.
<https://w3id.org/delphi/resource/model/grok-4.7-high-fast> a <https://w3id.org/delphi/ontology/LanguageModel>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7";
    dc:identifier "grok-4.7-high-fast".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch08-11--grok> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Grok 4.7 on thompson1917-ch08-11: partially-resolvable, resolvability 0.49";
    dc:description "A three-lineage sample of early embryos can show whether a few cell-partition types are shared. That is a fragment of a claim that also covers organs and the whole of plants and animals, most of which is uncompiled. Shared topology is only weakly discriminating once the number of legal partitions is already small.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Assemble partition topologies of small cell groups and of small organs across plants and animals, and test whether the same few graphs recur with weak phylogenetic signal. The same configurations in distant lineages, and relatedness adding little once topology is constrained, would support the claim; configurations clustering by clade would count against it.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "If only a few topologies are possible, recurrence is expected and does not by itself explain why those topologies were used.", "Organs, as opposed to early cell groups, are not coded as partition graphs in these databases.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.5"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-11--grok--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.493"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "partially-resolvable".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch08-11--grok--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: Arabidopsis embryo image collection";
    dc:description "Plant embryo partitions as the botanical side of the same comparison";
    prov:wasDerivedFrom <https://doi.org/10.15454/HIIBKW>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch08-11--grok--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Analysis feasibility of thompson1917-ch08-11 by Grok 4.7: 0.4";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-analysis-feasibility>;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0/analysis-feasibility";
    <https://w3id.org/delphi/ontology/hasScore> "0.4"^^xsd:double;
