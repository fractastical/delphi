    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol";
    dc:identifier "gpt-5.6-sol-medium".
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-08--gpt> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
    <http://www.w3.org/2000/01/rdf-schema#label> "GPT-5.6 Sol on thompson1917-ch04-08: needs-new-data, resolvability 0.47";
    dc:description "The claim is experimentally testable with modern voltage reporters and perturbations. Existing public data are unlikely to provide the species, spatial calibration, successive segmentations, and causal interventions needed for the full statement.";
    dc:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0>;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Proposed test with existing data: Measure membrane or intracellular electrical potential spatially through successive cleavages while simultaneously imaging division timing, chromatin, and polarity; perturb voltage independently and quantify effects on division. Support requires reproducible pole differences or reversals that causally alter segmentation.";
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium>;
    <https://w3id.org/delphi/ontology/assessmentType> "dataset-resolvability/0.2.0";
    <https://w3id.org/delphi/ontology/evidenceAgainst> "Association would not establish the asserted major causal role.", "Historical 'potential' does not map uniquely to membrane voltage.", "Public embryo datasets rarely combine calibrated voltage and full cleavage imaging.";
    <https://w3id.org/delphi/ontology/hasConfidence> "0.74"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasEvidence> <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-08--gpt--dataset-1>;
    <https://w3id.org/delphi/ontology/hasScore> "0.473"^^xsd:double;
    <https://w3id.org/delphi/ontology/hasVerdict> "needs-new-data".
<https://w3id.org/delphi/resource/evidence/thompson1917-ch04-08--gpt--dataset-1> a <https://w3id.org/delphi/ontology/EvidenceItem>;
    <http://www.w3.org/2000/01/rdf-schema#label> "Candidate dataset: BioImage Archive";
    dc:description "Some voltage-reporter and embryogenesis imaging is public, but matched successive-cleavage datasets are limited.";
    prov:wasDerivedFrom <https://www.ebi.ac.uk/bioimage-archive/>.
<https://w3id.org/delphi/resource/assessment/thompson1917-ch04-08--gpt--analysis-feasibility> a <https://w3id.org/delphi/ontology/LLMClaimAssessment>;
