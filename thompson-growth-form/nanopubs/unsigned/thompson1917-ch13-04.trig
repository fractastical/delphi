    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-04> a delphi:Claim ;
    rdfs:label "Goat and sheep horns form a series of homologous spirals of increasing angle" ;
    dct:description "Horns of wild goats and sheep form a series of homologous logarithmic spirals with increasing constant angle: under 40° in Oryx, under 70° in the Scinde wild goat, about 75° in Ovis ammon and a little more in the Highland ram." ;
    skos:notation "\\alpha < 40^\\circ (Oryx), < 70^\\circ (Scinde wild goat), \\approx 75^\\circ (Ovis ammon), > 75^\\circ (Highland ram)" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XIII, “The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion”; topic “Spiral angle of horns”. Scope: horns of Oryx, Capra and Ovis species" ;
    dct:type "empirical-generalization" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "we may easily arrange a series of forms, such for example as the Siberian ibex, the moufflon, _Ovis Ammon_, etc., and ending with the long-horned Highland ram: in which, as we pass from one to another, we recognise precisely homologous spirals, with an increasing angular constant, the spiral angle being, for instance, about 75° or rather less in _Ovis Ammon_, and in the Highland ram a very little more." ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=20430,20436> .

