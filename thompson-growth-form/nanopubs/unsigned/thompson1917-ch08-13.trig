    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "It is obvious that in the case of the oblong cells of the epidermis in the hyacinth the stomata will be found arranged in regular rows, while they will be irregularly distributed over the surface of the leaf in such a case as we have depicted in Sedum." ;
