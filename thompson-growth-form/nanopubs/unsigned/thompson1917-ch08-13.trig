    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-13> a delphi:Claim ;
    rdfs:label "Stomata lie in rows on oblong-celled leaves and scattered on polygonal-celled ones" ;
    dct:description "Because the stomatal mother cell is cut off by a minimal partition whose form depends on epidermal cell shape, stomata are arranged in regular rows where epidermal cells are oblong (as in hyacinth) and irregularly where they are polygonal (as in Sedum)." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter VIII, “The Forms of Tissues, or Cell-Aggregates (continued)”; topic “Arrangement of stomata”. Scope: leaf epidermis of monocotyledons with oblong cells and dicotyledons with polygonal cells" ;
    dct:type "prediction" .
}

