    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-09> a delphi:Claim ;
    rdfs:label "All differences of form between shells are differences of degree in a few growth ratios" ;
    dct:description "The form of any turbinate shell is fixed by a small set of factors (shape of the generating curve, its rate of growth, its rate of rotation about the pole, its rate of translation along the axis, and its inclination), and all differences of form between one shell and another are differences of degree in the relative magnitudes of these factors." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XI, “The Logarithmic Spiral”; topic “Factors of the shell’s form”. Scope: univalve (discoid and turbinate) molluscan shells" ;
    dct:type "mathematical-law" .
}

