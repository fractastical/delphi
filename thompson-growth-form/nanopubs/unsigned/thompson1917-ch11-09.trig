  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "In short it is obvious that _all_ the differences of form which we observe between one shell and another are referable to matters of _degree_, depending, one and all, upon the relative magnitudes of the various factors in the complex equation to the curve." ;
