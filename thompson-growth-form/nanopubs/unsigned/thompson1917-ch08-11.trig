sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-11> a delphi:Claim ;
    rdfs:label "Few partition patterns recur across organisms regardless of classification" ;
    dct:description "Because a closed surface divided into a small number of faces admits only a small number of arrangements, the same few configurations of cells (and of parts and organs) recur in all kinds of plants and animals with no relation to biological classification." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter VIII, “The Forms of Tissues, or Cell-Aggregates (continued)”; topic “Topology of space-partitioning”. Scope: small cell groups and partitioned organs across plants and animals" ;
    dct:type "empirical-generalization" .
}

