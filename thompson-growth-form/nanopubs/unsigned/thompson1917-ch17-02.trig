sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-02> a delphi:Claim ;
    rdfs:label "Specific differences in form are mainly differences of relative magnitude" ;
    dct:description "The essential differences in form between species of the same group are differences of proportion or relative magnitude (Aristotle's 'excess and defect'), and these are the main cause of specific differences." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVII, “On the Theory of Transformations, or the Comparison of Related Forms”; topic “Specific differences as excess and defect”. Scope: species within the same zoological class or genus" ;
    dct:type "empirical-generalization" .
}

