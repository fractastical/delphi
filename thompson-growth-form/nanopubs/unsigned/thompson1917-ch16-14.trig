sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-14> a delphi:Claim ;
    rdfs:label "Fish vertebral processes are set at about 120° to one another for uniform stiffness" ;
    dct:description "In ordinary fishes such as cod and haddock (and partly in whales), the backbone is stiffened by three series of ligament-connected processes, dorsal and two transverse, arranged at nearly equal angles of 120°, which gives the greatest and most uniform strength possible for such a system." ;
    skos:notation "three series of processes at \\approx 120^\\circ to one another" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVI, “On Form and Mechanical Efficiency”; topic “Aquatic animals and stiffness”. Scope: vertebral columns of round-bodied fishes and cetaceans" ;
    dct:type "mathematical-law" .
}

