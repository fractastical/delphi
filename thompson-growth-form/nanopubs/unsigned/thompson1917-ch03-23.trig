    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-23> a delphi:Claim ;
    rdfs:label "Seasonal growth in fish and man follows a damped sine curve" ;
    dct:description "In fishes such as plaice and haddock, and in man, growth is slower in winter than in summer, as if an annual sine curve were superimposed on the growth curve, and the amplitude of this fluctuation dies away as growth slows, giving a damped sine curve." ;
    skos:notation "L(t) = \\bar{L}(t) + A(t)\\sin(2\\pi t / 1\\,\\text{yr}), A(t) \\to 0 as d\\bar{L}/dt \\to 0 (damped sine)" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Seasonal fluctuations of growth”. Scope: fishes (plaice, haddock) and humans" ;
    dct:type "mathematical-law" .
}

