sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-09> a delphi:Claim ;
    rdfs:label "Organisms grow along stream lines definable by a mathematical transformation" ;
    dct:description "The law of growth implied by representing related forms as orthogonal coordinate transformations is that the organism grows along stream lines definable by a suitable mathematical transformation; departures from orthogonality reflect the organism not being homogeneous and isotropic." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVII, “On the Theory of Transformations, or the Comparison of Related Forms”; topic “Stream lines and law of growth”. Scope: growth of organisms in general" ;
    dct:type "mechanism" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "the “law of growth” which our biological analysis by means of orthogonal co-ordinate systems presupposes, or at least foreshadows, is one according to which the organism grows or develops along _stream lines_, which may be defined by a suitable mathematical transformation." ;
