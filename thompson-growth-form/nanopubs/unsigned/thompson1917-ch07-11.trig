sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-11> a delphi:Claim ;
    rdfs:label "The bee’s cell is a hexagonal prism capped by rhombic-dodecahedral facets" ;
    dct:description "The hive-bee’s cell is a hexagonal prism closed at one end by three rhombic facets of a rhombic dodecahedron meeting at about 109° 28′, the configuration that encloses a given volume with the least surface." ;
    skos:notation "hexagonal prism closed by three rhombic facets at 109^\\circ 28' (\\cos\\theta = -1/3); minimal surface for given volume" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter VII, “The Forms of Tissues, or Cell-Aggregates”; topic “The bee’s cell”. Scope: comb cells of the hive-bee" ;
    dct:type "mathematical-law" .
}

