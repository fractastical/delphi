    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "The bee’s cell, then, is this figure incompletely formed: it is a hexagonal prism with one open or unfinished end, and one trihedral apex of a rhombic dodecahedron." ;
