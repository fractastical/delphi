    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-15> a delphi:Claim ;
    rdfs:label "Outgrowths tend to arise from triangular rather than quadrangular cells" ;
    dct:description "Because quadrangular cells subdivide by periclinal walls that strengthen the boundary while triangular cells divide by oblique anticlines, outward growth is greater over triangular cells, so buds and outgrowths tend to arise from triangular rather than quadrangular cells, as is widely seen in cryptogams." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter VIII, “The Forms of Tissues, or Cell-Aggregates (continued)”; topic “Buds from triangular cells”. Scope: growing points and buds of cryptogams (mosses, liverworts, ferns, algae)" ;
    dct:type "prediction" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "As a direct and immediate consequence of this we might expect a tendency for special outgrowths, or “buds,” to arise from the triangular rather than from the quadrangular cells; and this turns out to be not merely a tendency towards which theoretical considerations point, but a widespread and important factor in the morphology of the cryptogams." ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=13721,13727> .

