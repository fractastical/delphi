sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-32> a delphi:Claim ;
    rdfs:label "Claw reversal after amputation depends on regeneration versus growth rates" ;
    dct:description "Whether an amputated large crustacean claw regenerates as the large claw, or the claws exchange roles, depends on the ratio between the regenerative growth rate of the amputated claw and the growth rate of the uninjured claw, since claw form follows claw size." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Regeneration”. Scope: Crustacea with asymmetric claws (lobster, Alpheus, crabs)" ;
    dct:type "mechanism" .
}

