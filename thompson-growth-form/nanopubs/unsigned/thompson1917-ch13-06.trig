sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-06> a delphi:Claim ;
    rdfs:label "A horn is a plane spiral only if fastest and slowest growth lie diametrically opposite" ;
    dct:description "If the maximal and minimal growth rates around the basal growth zone of a horn lie diametrically opposite, the horn is a plane spiral; otherwise it is a spiral in space with a helical component, which is the usual case because the horn's field of force has no such plane of symmetry." ;
    skos:notation "plane spiral iff the maximal and minimal growth rates around the base lie at \\Delta\\phi = 180^\\circ; otherwise helicospiral" ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XIII, “The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion”; topic “Summary of horn growth”. Scope: horns of ruminants" ;
    dct:type "mathematical-law" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "If the maximal and minimal velocities of growth be precisely at opposite sides of the zone of growth, the resultant spiral will be a plane spiral; but if they be not precisely or diametrically opposite, then the spiral will be a spiral in space, with a winding or helical component" ;
