sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-13> a delphi:Claim ;
    rdfs:label "Notched hydroid cups and annulated stems are both due to surface tension" ;
    dct:description "The notching of the rim of hydroid calycles and the annular constrictions of their cylindrical stems are phenomena of the same order, both produced by surface tension acting on the structures while they are still fluid or semifluid films, as in the beaded rim of a splash." ;
    delphi:context "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter V, “The Forms of Cells”; topic “Splashes and hydroid calycles”. Scope: calycles and stems of campanularian hydroids and other small organic cups" ;
    dct:type "mechanism" .
}

sub:provenance {
  sub:assertion prov:wasDerivedFrom <https://www.gutenberg.org/ebooks/55264> , sub:quote ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-thompson-growth-form-extractor> ;
    prov:wasGeneratedBy sub:extraction .

  sub:quote a prov:Entity ;
    schema:text "In the case of the hydroid calycle (Fig. 72), we are led to the conclusion that the two common and conspicuous features of notching or indentation of the cup, and of constriction or annulation of the long cylindrical stem, are phenomena of the same order and are due to surface-tension in both cases alike." ;
    prov:wasQuotedFrom <https://www.gutenberg.org/ebooks/55264> ;
    prov:hadPrimarySource <https://www.gutenberg.org/cache/epub/55264/pg55264.txt#line=8599,8604> .

