sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-01--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch09-01: partially-resolvable, resolvability 0.53" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.533"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The site of precipitation is a standard ultrastructural observation, so the rule is directly scorable where images resolve mineral and cytoplasm. Those images are spread through papers and image archives, with bone and a few protist groups far better covered than spicules and plant walls. A compiled subset can support or damage the rule, but assembling a taxonomically fair sample is months of work rather than a download-and-test." ;
    rdfs:comment "Proposed test with existing data: Score published ultrastructure of spicules, cartilage, bone, concretions and plant cell walls for whether the first mineral lies in extracellular matrix or cell wall rather than in active cytoplasm. A high extracellular fraction supports the rule; a large class of intracellular precipitation refutes it as a rule." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Dead or inactive tissue is not a label in image archives and has to be inferred from cell integrity.", "Intracellular calcification, as in coccolithophores, is well known but unevenly archived relative to vertebrate bone." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-01--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch09-01 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-01--grok--operationalizability> .
