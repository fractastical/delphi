  <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-01--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Cell Image Library" ;
    dct:description "Reviewed cell micrographs, including extracellular matrix and mineral skeletons, for locating crystals relative to cytoplasm." ;
    prov:wasDerivedFrom <https://www.cellimagelibrary.org/> .
