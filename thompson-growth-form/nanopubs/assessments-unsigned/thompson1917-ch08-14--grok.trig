sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-14--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-14: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.583"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Pollen shape and tetrad versus monad status are openly coded for a large angiosperm sample, which proxies the claim by asking whether retained tetrads are the faceted grains. The actual timing of solidification is in scattered ultrastructural studies, not in PalDat. Shape has several other causes, so the association is informative and confounded." ;
    rdfs:comment "Proposed test with existing data: Compare mature pollen and spore shape with whether the wall rigidified before the tetrad separated. Grains that hardened in the tetrad keeping plane facets and sharp angles, and grains that separated while soft becoming spherical, would support the claim; spherical grains that hardened in permanent tetrads, or angular grains that separated soft, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "PalDat records shape and whether grains are united, not the developmental timing of wall hardening relative to separation.", "Apertures, harmomegathy and drying also produce facets, and fern and red-algal spores are outside this pollen database." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-14--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-14 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-14--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-14--grok--operationalizability> .
