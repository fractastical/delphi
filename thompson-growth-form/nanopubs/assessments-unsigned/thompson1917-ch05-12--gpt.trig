sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-12--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-12--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch05-12: partially-resolvable, resolvability 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.722"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "The instability threshold and spacing are quantitative and distinguish the capillary model from arbitrary beading. Existing open microscopy can test the geometry in subsets, but matched rheology and formation movies are sparse." ;
    rdfs:comment "Proposed test with existing data: From calibrated orb-web images, measure coating radius, instability wavelength, bead spacing and size hierarchy, then compare them with Rayleigh-Plateau predictions for a viscous coating on a fiber. Support requires onset near the stated circumference criterion and systematic spacing shifts predicted by viscosity and core drag." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Public images may omit fluid radius, viscosity, or time of formation.", "Spider chemistry and active spinning introduce additional controls." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-12--gpt--dataset-2> .
