sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-31> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-31--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-31--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-31: partially-resolvable, resolvability 0.47" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.468"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Ordinary growth curves are easy to obtain, and the qualitative shape Thompson names can be scored. Regeneration series are not in the same archives, and the early limb he treats as decisive is the part most often missing. Because the likeness is defined loosely, many discordant curves would still be called the same essential shape." ;
    rdfs:comment "Proposed test with existing data: Align regeneration curves and whole-organism growth curves on a common time origin at the start of growth, and compare the sequence latent period, rise to a velocity maximum, then slow decline. Matching sequence and comparable scaled shape would support the claim; a regeneration curve that stays monotonic, or a full growth curve that lacks the rising limb, would refute a shared shape." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Regeneration lengths are scattered across papers and start after a latent period that is poorly sampled.", "Many unrelated processes share a rise-and-fall velocity curve.", "'Essential features' does not specify a numerical tolerance." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-31--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-31--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-31 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-31--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-31> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-31--grok--operationalizability> .
