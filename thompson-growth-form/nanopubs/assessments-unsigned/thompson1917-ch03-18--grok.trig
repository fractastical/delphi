sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-18--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-18: resolvable-now, resolvability 0.79" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.793"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "The months, the fixed-length comparison, and the spawning mechanism are all specified, and the relevant survey records are public. Immature fish are the discriminating control for the word wholly. Incomplete maturity staging and a feeding residual are real limits, but they are analysable in the same tables and do not leave the claim untestable." ;
    rdfs:comment "Proposed test with existing data: At fixed length, test whether plaice weight falls from about November to March or April and recovers from May or June to November, and whether that cycle is confined to mature fish and matched by gonad loss. The claim that spawning wholly explains the cycle is refuted by the same cycle in immature fish, or by a large residual cycle after gonad mass is removed." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Not every haul records individual weight and maturity together.", "Seasonal feeding can change somatic condition even when the gonad cycle is the larger term." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-18 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-18--grok--operationalizability> .
