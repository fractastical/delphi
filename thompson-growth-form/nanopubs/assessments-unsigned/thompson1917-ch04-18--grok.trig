sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-18--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-18--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch04-18: partially-resolvable, resolvability 0.39" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.393"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.53"^^xsd:double ;
    dct:description "Independence of overall form from cell number is a testable fragment, and it has been studied in a few model organisms whose descriptions can be compiled. MorphoSource supplies shape, not the cell counts. The stronger wording, a continuous force field running through the whole organism, is not separated by those data from ordinary intercellular coordination." ;
    rdfs:comment "Proposed test with existing data: Compare organismal shape in cases where cell number, cell size or cell form is altered, and ask whether the outline is unchanged. Shape that is invariant to cell number would support independence from the cellular partition; shape that scales with the cell grid would refute it. A continuous force field, as against cell-cell signalling, is not identified by that invariance." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Cell-number and cell-size series are not attached to most scans.", "Signalling across cells can coordinate form without a continuous physical field.", "The field is said to be unrestricted by protoplasmic continuity, which is not a column in morphological databases." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-18--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-18--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch04-18 by Grok 4.7: 0.4" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.4"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-18--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-18--grok--operationalizability> .
