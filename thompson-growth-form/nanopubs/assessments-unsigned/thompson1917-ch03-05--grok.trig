sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-05: resolvable-now, resolvability 0.91" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.91"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.88"^^xsd:double ;
    dct:description "National examinations and international growth standards record stature by age in very large samples, and velocity is obtained from them by ordinary smoothing. The four-phase pattern is specific enough to fail if the adolescent quickening is absent. Population differences in timing are a real caveat, but they do not prevent a direct confirmation or refutation of the stated sequence." ;
    rdfs:comment "Proposed test with existing data: Plot stature velocity against age from birth to adult height. The claim is confirmed by high infantile velocity, a lower and nearly steady childhood velocity, a distinct acceleration in the early teens, and a decline to zero at adult height. A single smooth peak, or no adolescent acceleration, would refute that phasing." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Populations differ in the age of the adolescent peak, so one universal calendar age is too strict.", "The original description was drawn largely from boys." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-05 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-05--grok--operationalizability> .
