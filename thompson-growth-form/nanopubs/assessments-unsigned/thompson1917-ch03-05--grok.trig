  <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-05--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: WHO Child Growth Standards" ;
    dct:description "Age-specific stature from birth through childhood, from which velocity phases can be estimated" ;
    prov:wasDerivedFrom <https://www.who.int/tools/child-growth-standards> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-05--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: NHANES" ;
    dct:description "Open measured stature by age from infancy through adulthood for the adolescent acceleration and the final arrest" ;
    prov:wasDerivedFrom <https://wwwn.cdc.gov/nchs/nhanes/> .
