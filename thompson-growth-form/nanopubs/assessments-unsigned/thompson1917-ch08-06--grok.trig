sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-06--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-06: needs-new-data, resolvability 0.46" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.46"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "The claim predicts both an order of division and two radius ratios under uniform disc growth. That is a clean test and it needs live, cell-resolved growth of that geometry. Such a series is not in current open datasets, so the constants cannot be confirmed or refuted without new observations." ;
    rdfs:comment "Proposed test with existing data: Follow a uniformly growing flat disc after a quadrant divides into a triangular and a quadrilateral daughter, and record which daughter divides next and at what radius. The triangular cell reaching division size first, near 1.35 times the starting radius against about 1.52 for the quadrilateral, would support the claim; simultaneous division, or the quadrilateral dividing first, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "No public time-lapse of Erythrotrichia or a similar disc records daughter area against disc radius through the next division.", "Fixed embryo collections cannot supply the division-time order this numerical prediction requires." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-06 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
