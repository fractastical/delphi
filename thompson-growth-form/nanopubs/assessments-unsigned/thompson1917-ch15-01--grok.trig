  <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-01--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Avian egg shape, oviduct, and pelvis" ;
    dct:description "Egg length and shape indices for 955 bird species in 39 orders, sufficient to detect an oblate egg" ;
    prov:wasDerivedFrom <https://doi.org/10.5061/dryad.sj3tx9648> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-01--grok--dataset-2> a delphi:EvidenceItem ;
