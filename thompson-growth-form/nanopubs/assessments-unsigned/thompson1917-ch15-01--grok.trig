sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch15-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-01--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch15-01: resolvable-now, resolvability 0.87" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.869"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "Prolate versus oblate is read directly from length and breadth, and two large open bird-egg compilations already contain those measurements. An oblate bird egg would be visible immediately, so the claim is decidable for the animals that dominate the chapter. Reptile eggs remain outside the files, which limits the stated scope without preventing a clear test for birds." ;
    rdfs:comment "Proposed test with existing data: Classify each egg by whether length exceeds width (prolate or spherical) or width exceeds length (oblate), using species-level shape measurements. The claim is confirmed if oblate eggs are absent across the measured hard-shelled eggs; a single well-measured oblate species would refute the universal negative." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Both open compilations are birds; tortoise and crocodile eggs are a stated part of the scope and are not in these files.", "Spherical eggs sit on the boundary and need a measurement-error rule before being called prolate." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-01--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch15-01 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch15-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-01--grok--operationalizability> .
