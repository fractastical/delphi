    rdfs:label "Candidate dataset: World Porifera Database" ;
    dct:description "Catalogue and linked images of siliceous sponge spicule types used as one side of the comparison." ;
    prov:wasDerivedFrom <https://www.marinespecies.org/porifera/> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: World Register of Marine Species" ;
