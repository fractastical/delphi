sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-09--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch09-09: partially-resolvable, resolvability 0.52" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.518"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Form overlap versus mineral class is a fair empirical reading of the argument, and both spicule faunas are extensively illustrated. The illustrations are not a joint morphometric dataset, and holothurian and sponge images sit in different literatures. Similar shapes would still be compatible with convergence for reasons other than cell confinement, so the chemistry-independence claim is only partly separated from its rivals." ;
    rdfs:comment "Proposed test with existing data: Embed siliceous sponge spicules and calcareous holothurian spicules in a common morphospace and test whether corresponding forms overlap. Overlap supports form set by shared external confinement; separation that tracks mineralogy rather than shape class would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The two groups are not a controlled contrast: cell geometry and ancestry differ along with chemistry.", "Quantitative spicule outlines are not in one downloadable table and would have to be measured from plates." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-09--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch09-09 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
