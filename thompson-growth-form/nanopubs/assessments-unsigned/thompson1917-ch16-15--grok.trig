sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-15--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-15--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch16-15: partially-resolvable, resolvability 0.45" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.454"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "Depth-to-length of a backbone is measurable on open scans, including some of the large animals named in the text. The reference cantilever and the requirement for flexibility are only loosely specified, so many observed depths can be reconciled with the claim. The data support a descriptive comparison and do not cleanly establish the functional reason." ;
    rdfs:comment "Proposed test with existing data: Compare vertebral depth-to-span ratios of large vertebrates with the depth an engineering cantilever of similar load would use, and test whether shallower columns are more flexible under the same material. A large, consistent shortfall in depth together with a flexibility gain would support the claim; depths inside the engineering range, or no link between depth and flexibility, would undermine it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "What an engineer would build depends on the allowable stress, safety factor and load case, none of which Thompson fixes.", "Shallow spines also follow development and phylogeny, so flexibility is hard to isolate as the reason." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-15--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-15--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch16-15 by Grok 4.7: 0.42" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.42"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-15--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-15> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-15--grok--operationalizability> .
