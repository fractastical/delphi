sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-01--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-01: resolvable-now, resolvability 0.72" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.72"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The longest-axis rule and the right-angle alternation are explicit and apply to a recognizable subset of cells in public embryo and meristem volumes. Standard geometric measurements can confirm or refute them for that subset within weeks. Adequacy is limited to model plants rather than rectangular dividing cells in general, which is still enough for the rule as a biological regularity." ;
    rdfs:comment "Proposed test with existing data: Among cells that are roughly rectangular and divide into near-equal daughters, test whether the new wall cuts the longest axis and whether the next wall is perpendicular to the previous one. That pattern would support the claim; equal divisions parallel to the long axis, or successive walls that are not orthogonal, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Many cells in these volumes are not rectangular, so the test has to be restricted to the shape the rule assumes.", "Tissue stress orients some divisions and can mimic or mask a pure longest-axis rule." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-01--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-01 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-01--grok--operationalizability> .
