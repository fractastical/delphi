sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-21--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch11-21: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.5"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "Suture frills can be measured from open plates and scans, so the descriptive pattern is accessible for complex ammonitic sutures. Identifying that pattern as surface tension, by analogy with milk on a greasy plate or oil on alkali, does not specify a statistic that excludes buckling and other branching processes. Existing images can test the geometry and cannot isolate the physical cause." ;
    rdfs:comment "Proposed test with existing data: Quantify the fine branching of ammonitic sutures, including rounded terminal arcs, and compare those statistics with surface-tension fingering patterns and with buckling or wrinkling alternatives. A unique match to surface-tension geometry would support the claim; an equal or better match to another generator would leave it unresolved." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Rounded, arborescent outlines are produced by several interfacial instabilities, not only by surface tension.", "Classical suture drawings emphasize the pattern the claim treats as diagnostic." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch11-21 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-21--grok--operationalizability> .
