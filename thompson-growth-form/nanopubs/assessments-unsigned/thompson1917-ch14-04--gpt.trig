  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-04--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch14-04: resolvable-now, resolvability 0.84" ;
