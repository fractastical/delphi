sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-08--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-08--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch05-08: partially-resolvable, resolvability 0.61" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.615"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.77"^^xsd:double ;
    dct:description "The geometric prediction is quantifiable from 3D surfaces, and public specimens can test the chamber-versus-whole contrast. The causal role of surface tension during the unobserved fluid stage is harder to establish from finished shells." ;
    rdfs:comment "Proposed test with existing data: Reconstruct successive chamber surfaces in living or growth-staged foraminifera and test each new chamber against constant-mean-curvature or minimum-area surfaces under its boundary conditions, while testing the aggregate shell separately. Support requires good fits for new chambers but not for the whole shell and evidence of subsequent rigidification." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Rigid shells record final rather than fluid chamber geometry.", "Boundary conditions and growth-stage timing are often unknown.", "Desmid coverage is limited." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-08--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-08--gpt--dataset-2> .
