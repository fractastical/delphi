  <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-12--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Paleobiology Database" ;
    dct:description "Fossil cephalopod occurrences and taxonomy used to place shell forms in time without treating the angle as a character." ;
    prov:wasDerivedFrom <https://paleobiodb.org/> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-12--grok--dataset-2> a delphi:EvidenceItem ;
