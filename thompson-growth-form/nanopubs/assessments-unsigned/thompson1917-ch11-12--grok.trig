sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-12--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch11-12: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.555"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "Living molluscs have trees that do not depend on shell angle, and shell scans can supply the angles, so a restricted test is possible. Fossil series from straight to coiled shells are the historically important case, and there the phylogeny is morphology-heavy. The analysis can show whether angle tracks ancestry in living groups and cannot cleanly vindicate or dismiss the fossil phylogenetic series Thompson rejects." ;
    rdfs:comment "Proposed test with existing data: Compare spiral angle with phylogenetic distance or ancestral states estimated without using coiling as a character. If angle does not predict which form is ancestral or intermediate, the claim that it is not evidence of ancestry is supported; a robust phylogenetic signal would refute that denial." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Ammonoid cladograms have often used coiling, so a fossil test can become circular.", "No evidence of ancestry is an epistemic claim: a weak correlation need not count as valid support, and the threshold is a judgement." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-12--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-12--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch11-12 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-12--grok--operationalizability> .
