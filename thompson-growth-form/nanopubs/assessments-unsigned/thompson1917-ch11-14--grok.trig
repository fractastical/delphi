sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-14--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch11-14: resolvable-now, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.668"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The claim names genera and the direction in which the angle should move, and those shells are figured in open museum and atlas collections. Photographs can test the narrowing and uncoiling profiles; scans, where present, separate the angle from other coiling parameters. The sample is uneven but large enough, with standard measurements, to confirm or refute the stated ontogenetic trends." ;
    rdfs:comment "Proposed test with existing data: Measure spiral angle through ontogeny in Oekotraustes, Scaphites, Ancyloceras, Lituites and similar shells. An increasing angle with narrowing whorls, and a decreasing angle toward an open hook, support the claim; constant angle despite those outlines, or the opposite angle trend, refutes it for those taxa." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "3D scans of these particular genera are fewer than photographs, and crushed specimens distort the later whorls.", "A change in outline can reflect translation or aperture shape as well as the spiral angle." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-14--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-14--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-14--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch11-14 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
