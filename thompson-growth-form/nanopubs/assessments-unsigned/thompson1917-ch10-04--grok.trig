  <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-04--grok--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Human cardiac diffusion MRI dataset" ;
    dct:description "Open cardiac diffusion-tensor imaging and derived myocardial orientation maps for testing fiber paths against geodesics." ;
    prov:wasDerivedFrom <https://doi.org/10.25740/yh756nh8583> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-04--grok--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Candidate dataset: Cardiac Atlas Project" ;
    dct:description "Ventricular shape models on which surface geodesics can be computed and compared with fiber directions." ;
    prov:wasDerivedFrom <https://www.cardiacatlas.org/> .
