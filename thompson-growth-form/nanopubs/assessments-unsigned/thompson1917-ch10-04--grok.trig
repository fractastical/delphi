sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch10-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch10-04: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.593"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "Shortest paths on a measured surface are a clear test, and public cardiac diffusion data plus ventricular shape models make the heart part feasible with specialist but existing tools. The claim names a list of hollow organs for which comparable open fiber maps are sparse. A heart-only result would resolve a restricted scope and leave the general automatic-arrangement claim open." ;
    rdfs:comment "Proposed test with existing data: On reconstructed surfaces of heart, stomach, arteries and gut, compare muscle-fiber trajectories with computed geodesics. Fibers lying on shortest paths, annular and longitudinal on a simple tube, support the claim; systematic extra length or a non-geodesic helix would refute it for that organ." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Open fiber-orientation data are concentrated on the human left ventricle, not the stomach, arteries, intestine or worm body wall.", "Myocardial fibers also follow sheet architecture and load, so a geodesic fit can be confounded with stress alignment." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch10-04 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch10-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-04--grok--data-existence> a delphi:LLMClaimAssessment ;
    rdfs:label "Data existence of thompson1917-ch10-04 by Grok 4.7: 0.6" ;
