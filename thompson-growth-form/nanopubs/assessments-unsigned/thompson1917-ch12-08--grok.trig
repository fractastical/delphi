sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-08> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-08--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-08--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch12-08: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.596"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "Coiling geometry and life habit are observable and widely described, and planktonic assemblages are already tabulated globally. No single open table pairs attachment, flattening, and coiling across benthic genera, so the test requires a compilation. Exceptions are informative where they have been illustrated, but phylogenetic structure will keep the result from being a clean mechanical demonstration." ;
    rdfs:comment "Proposed test with existing data: Score planispiral versus trochospiral coiling, ventral flattening, and life habit (attached, free benthic, planktonic) across genera, then test the association with a phylogenetic model. The claim is supported if attached species are disproportionately plane and flattened on the attached face while planktonic species are disproportionately helicoid; abundant attached trochospirals or free planispiral plankton would undermine the stated contrast." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Attached versus free habit and the flattened face are not fields in the census databases and must be compiled from monographs.", "Coiling mode is phylogenetically conserved, so a habit correlation can be a clade effect." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-08--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-08--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch12-08 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
