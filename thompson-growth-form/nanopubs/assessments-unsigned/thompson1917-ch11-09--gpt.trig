sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-09--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-09--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch11-09: partially-resolvable, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.708"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.77"^^xsd:double ;
    dct:description "Modern shell models make the proposed factors measurable and public scans offer broad coverage. The universal 'all differences' assertion and causal sufficiency are harder to discriminate because model flexibility and omitted ornament matter." ;
    rdfs:comment "Proposed test with existing data: Fit a generative shell model parameterizing aperture shape, expansion, rotation, translation and inclination to diverse univalve scans, then quantify unexplained shape variance and systematic residuals. The claim is supported if this parameter set reconstructs observed forms without additional qualitative mechanisms." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Ornament, aperture remodeling and local growth changes exceed the simple parameter set.", "A flexible model can fit shapes without identifying biological causation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-09--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-09--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch11-09 by GPT-5.6 Sol: 0.7" ;
