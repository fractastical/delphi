sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-14--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-14--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch09-14: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.54"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.63"^^xsd:double ;
    dct:description "Mesh statistics are a direct geometric test and radiolarian lattices are extensively imaged in an open taxonomic system. The developmental step, silica collecting in grooves between vesicles, is not in those images. Hexagonal order can therefore support the form prediction for a well-illustrated subset of species while leaving the groove mechanism interchangeable with other pattern-forming processes." ;
    rdfs:comment "Proposed test with existing data: On spherical lattice shells, measure the fraction of hexagonal meshes, node angles near 120 degrees, and whether irregularity of the mesh tracks irregularity that a vesicular foam would produce. Strong hexagonal order is consistent with groove collection; a different predominant polygon, or order unrelated to any foam, counts against that route." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Finished skeletons do not preserve the surface vesicles that supposedly moulded the grooves.", "Hexagonal nets are also expected from other physical models, including bubble packing and reaction-diffusion." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-14--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-14--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch09-14 by Grok 4.7: 0.55" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.55"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-14--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-14> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-14--grok--operationalizability> .
