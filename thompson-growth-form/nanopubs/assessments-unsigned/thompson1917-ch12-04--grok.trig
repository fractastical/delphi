sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-04--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch12-04: partially-resolvable, resolvability 0.73" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.73"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "Continued similarity is exactly the measurement Thompson uses to recognize a logarithmic spiral, and fusulinid outlines already record shape at each whorl. Image atlases extend the test to many other coiled genera, though not as precomputed spiral angles and not evenly across benthic families. Fitting a constant angle against alternatives is a standard morphometric job on the fusulinid file and a slower image-measurement job elsewhere, so the law is testable now for a large subset." ;
    rdfs:comment "Proposed test with existing data: On axial sections and 3D whorls, estimate the spiral angle at successive chambers and test self-similarity by superimposing younger and older outlines after scaling. A logarithmic spiral is supported when the angle is constant and scaled outlines coincide within measurement error; a changing angle, or a better fit by an Archimedean or multistage spiral, would refute it for that shell." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The open landmark series is fusulinid, a subset of the nautiloid and other spiral foraminifera named in the claim.", "Trochospiral tests need a 3D angle; equatorial photographs alone underdetermine the spiral." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-04--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-04--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch12-04 by Grok 4.7: 0.88" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.88"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-04--grok--operationalizability> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-04--grok--data-existence> a delphi:LLMClaimAssessment ;
