sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-18> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-18--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-18--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-18: resolvable-now, resolvability 0.80" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.8"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.89"^^xsd:double ;
    dct:description "Seasonal condition at fixed length can be estimated from extensive public fish surveys. Reproductive-stage fields and environmental covariates allow a strong, though not perfectly experimental, test of both pattern and exclusive mechanism." ;
    rdfs:comment "Proposed test with existing data: Model plaice weight conditional on length, month, gonad stage and tissue condition, testing for the stated winter decline and summer-autumn recovery. Mediation by gonad and spawning status supports the mechanism; persistence after reproductive controls or stronger environmental predictors refutes the claim that spawning wholly causes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Survey timing and fields vary among cruises.", "Food availability and temperature covary with spawning season.", "Wholly is difficult to establish observationally." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-18--gpt--dataset-2> .
