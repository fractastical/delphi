sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-17> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch02-17: partially-resolvable, resolvability 0.63" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.63"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.79"^^xsd:double ;
    dct:description "Neuron dimensions and cell counts are measurable and existing neuroanatomical resources support restricted comparisons. Taxonomic selection, missing ganglion totals and uncertain homology prevent resolution of the asserted general law." ;
    rdfs:comment "Proposed test with existing data: Across species, measure homologous ganglion-cell volumes and total cell counts per ganglion, then test whether cell size varies narrowly while ganglion cell number rises with species body size. Broad neuron-size scaling or no number-size association would refute the generalization." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Homologous ganglia and neuron classes are difficult to align across phyla.", "Repositories emphasize selected neurons rather than unbiased cell counts.", "Body-size metadata are often missing." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-17--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-17--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-17--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch02-17 by GPT-5.6 Sol: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
