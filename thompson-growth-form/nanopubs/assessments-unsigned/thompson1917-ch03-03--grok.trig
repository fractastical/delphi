sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-03--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-03: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.493"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.56"^^xsd:double ;
    dct:description "Unequal growth versus active bending is a genuine contrast, and chick and mouse embryos have been imaged in ways that can locate folds relative to expansion. Those maps are not a single open resource matched to neural and amniotic folds, and the two mechanisms co-occur. A small team could reanalyse a few published datasets, which tests the chick-centered case rather than vertebrate embryos in general." ;
    rdfs:comment "Proposed test with existing data: Map local expansion rate across the blastoderm and compare it with the sites of neural and amniotic folds. Folds sitting where an initially even sheet grows unequally would support the claim; folds formed by active bending where growth is uniform would count against growth inequality as the essential cause." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Strain and proliferation maps are in individual studies, not in a general embryo archive.", "Contractile folding can coincide with growth differences, so the two causes are hard to separate." .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-03 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
