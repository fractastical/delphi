sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-05--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch14-05: resolvable-now, resolvability 0.83" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.831"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.82"^^xsd:double ;
    dct:description "Size-dependent parastichy number is the pattern the sunflower study was built to capture, and both the counts and the images needed to measure disc size are public. Hundreds of heads span the Fibonacci pairs Thompson lists. Other composites are not in the file, but the stated example, and the scope centered on sunflower discs, can be confirmed or refuted directly." ;
    rdfs:comment "Proposed test with existing data: Measure disc diameter on the annotated sunflower images and test whether parastichy pairs (34/55, 55/89, 89/144 and others) shift upward with size. The claim is confirmed by an ordered increase of both counts with diameter; it is refuted if pair identity is independent of size or if small heads systematically carry the higher pairs." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The file is one cultivated species, whereas the claim also mentions other composite heads in passing.", "Some heads are too disordered for a single pair to be assigned." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-05--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch14-05 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
