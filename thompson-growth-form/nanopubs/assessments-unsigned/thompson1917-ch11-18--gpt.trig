  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-18--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch11-18: partially-resolvable, resolvability 0.69" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.693"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.77"^^xsd:double ;
    dct:description "The association is directly testable with fossil 3D morphology, including the named form classes. Demonstrating that pressure and available space cause the pattern is less discriminating than documenting the predicted correlation." ;
    rdfs:comment "Proposed test with existing data: Reconstruct shell interior and brachidium geometry across spire-bearing brachiopods, quantify shell elongation and flattening, and test the predicted association with outward, inward or discoid spiral direction. Phylogenetically controlled models should compare spatial constraint with clade-specific development." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Internal brachidia are incompletely preserved.", "Shell shape and arm direction are strongly confounded with phylogeny." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-18--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-18--gpt--dataset-2> .
