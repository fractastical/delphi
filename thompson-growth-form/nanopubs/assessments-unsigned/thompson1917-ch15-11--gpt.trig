  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-11--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch15-11: partially-resolvable, resolvability 0.74" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.741"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "The equation maps cleanly to imaging variables and can be tested with standard segmentation and surface analysis. Existing data permit a strong human test but do not match the full mammalian scope or uniform-pressure assumption." ;
    rdfs:comment "Proposed test with existing data: From segmented cardiac images, calculate local principal curvatures and wall thickness within each chamber, then test whether thickness times mean curvature is constant and whether the apex is thinnest." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Wall thickness varies with cardiac phase and loading.", "Most open cohorts emphasize humans rather than mammals broadly." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-11--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-11--gpt--dataset-2> .
