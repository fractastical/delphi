sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch14-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-12--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-12--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch14-12: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.602"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.72"^^xsd:double ;
    dct:description "The comparative effect can be quantified under explicit physical conditions, but Thompson leaves exposure and biological context underspecified. Existing architectures permit restricted simulation tests rather than a universal conclusion." ;
    rdfs:comment "Proposed test with existing data: Use 3D shoot architectures and radiative-transfer or airflow models to independently vary internode length and divergence angle, measuring marginal changes in light and air exposure. A consistently larger effect of internode elongation supports the prediction; equal or larger divergence effects refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Model results depend on canopy, sun angle, leaf posture and the definition of exposure.", "Open 3D shoot datasets cover few species.", "Internode length has costs and functions omitted from the comparison." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-12--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch14-12--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch14-12--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch14-12 by GPT-5.6 Sol: 0.78" ;
