sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-03--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-03--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch02-03: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.595"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The square-cube contrast is a definite prediction about bone allometry and maximum terrestrial mass, and both masses and scannable limb bones exist. They are not one joint dataset, mammal coverage is better than the full scope of terrestrial animals, and a thick elephant limb does not show that bone stress, rather than some other constraint, sets the ceiling. The analysis is feasible for a subset and takes more than a routine few weeks if scans must be measured and matched." ;
    rdfs:comment "Proposed test with existing data: Estimate compressive stress from body mass and limb-bone cross-section under gravity. The claim is supported if safety factor falls with size unless bones thicken faster than isometry, and if the largest land mammals sit near a practical ceiling; it is weakened if elephants retain small-mammal safety factors or if much larger terrestrial animals have ordinary limb proportions." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Bone meshes and body-mass tables are not linked individual by individual.", "Safety factors need posture and duty factor, which mass and diameter do not contain.", "Food, heat, and life history can limit size even when bone stress does not." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-03--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-03--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-03--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch02-03 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-03--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-03--grok--operationalizability> .
