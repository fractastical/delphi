sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-04--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch05-04: partially-resolvable, resolvability 0.53" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.53"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.6"^^xsd:double ;
    dct:description "Inhibition experiments can separate passive interfacial rounding from active contraction, and public image screens cover some of those perturbations. The decisive tension numbers are scattered, and the vocabulary of contractility has shifted since 1917, which makes the mapping only partly straightforward. For naked cells and blebs the test is informative; it is not yet a survey of protoplasm in general." ;
    rdfs:comment "Proposed test with existing data: Measure rounding of protoplasmic drops and pseudopod tips when actomyosin contractility is inhibited and when interfacial tension is altered. Rounding that persists without contractility and follows interfacial tension would support the claim; rounding that requires active contractility would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Modern cortical tension is itself often generated by actomyosin, so 'vital contractility' needs a stipulated inhibitor.", "Tension values are in papers more often than in the image archives.", "Pseudopod tips and bulk cytoplasmic drops may not obey the same balance." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-04--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch05-04 by Grok 4.7: 0.6" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.6"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-04--grok--operationalizability> .
