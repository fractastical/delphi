sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-21--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-21--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch03-21: partially-resolvable, resolvability 0.60" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.6"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "A Q10 between about 2 and 3 is a numerical criterion, and both raw rates and fitted temperature coefficients exist for many species. They are not one openly complete table for plants and animals inside normal limits, and the coefficient's dependence on the chosen interval is a built-in ambiguity the claim already flags. A compiled subset can test the order of magnitude; it does not cover the full scope in a single standard analysis." ;
    rdfs:comment "Proposed test with existing data: Below the optimum, compute the factor by which growth rate changes per 10°C. A factor of about 2 to 3, the same order as ordinary chemical reactions, would support the claim. A factor near 1 across the normal range, or systematically an order of magnitude larger, would refute the stated similarity. Intervals above the optimum are outside the qualified claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The coefficient itself falls as the temperature interval rises, so the test range has to be declared.", "Fitted temperature parameters are not the same object as a raw rate ratio, and tabulated Q10 values are a sparse sample." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-21--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-21--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-21--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-21 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-21--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-21--grok--operationalizability> .
