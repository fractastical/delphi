sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-03--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-03--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-03: resolvable-now, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.71"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "Modern live imaging and tissue mechanics directly expose the variables and allow rival models to be compared. Existing open developmental datasets and standard tracking methods can test the mechanism in representative vertebrate embryos now." ;
    rdfs:comment "Proposed test with existing data: Use time-lapse vertebrate embryo images to map local tissue growth and deformation before and during neural and amniotic folding, then fit mechanical sheet models. Spatially patterned growth that predicts fold initiation supports the mechanism; folding without the necessary differential growth or better prediction by active bending alone refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Growth, cell-shape change and active contractility can be difficult to separate.", "Amniotic-fold coverage is less abundant than neural-fold imaging." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-03--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-03--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-03 by GPT-5.6 Sol: 0.85" ;
