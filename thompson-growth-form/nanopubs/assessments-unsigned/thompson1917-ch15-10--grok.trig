sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch15-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-10--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-10--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch15-10: partially-resolvable, resolvability 0.58" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.578"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "The decision rule is the Laplace scaling Thompson states: thickness tracks radius while pressure is roughly constant, then falls off as pressure drops. Open whole-body anatomy shows the large-vessel half of that pattern in humans. Capillaries and non-human vertebrates are poorly represented in downloadable volumes, so a full test across the stated scope still needs a histological compilation." ;
    rdfs:comment "Proposed test with existing data: Along arterial trees, regress wall thickness on lumen radius separately for large arteries and for small arteries and capillaries. Support would be a near-proportional relation in the large vessels and a clear drop in thickness-to-radius in the small ones; a single proportion across the whole size range, or walls that stay thick in capillaries, would refute the stated pattern." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Visible Human resolution does not reach capillary walls, and the claim's small-vessel limb depends on histology scattered through papers.", "Elastic and muscular arteries differ in wall composition, so a single Laplace proportion is confounded by vessel class." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-10--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-10--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch15-10 by Grok 4.7: 0.84" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.84"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-10--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch15-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch15-10--grok--operationalizability> .
