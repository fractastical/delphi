sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-11--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch17-11: resolvable-now, resolvability 0.70" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.7"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.64"^^xsd:double ;
    dct:description "The claim is about two named forms, both of which are extensively photographed and present in museum collections. A pre-specified simple map with held-out landmarks is a standard test and can fail. That makes the external-transformation claim resolvable with existing images, with the usual caution that outline agreement is weaker than agreement of internal landmarks." ;
    rdfs:comment "Proposed test with existing data: Landmark outlines and homologous external points of Diodon and Mola, fit one low-parameter transformation of the sort Thompson drew, and score held-out points, including whether the head stays nearly unmoved. The claim is supported if that single map predicts the held-out anatomy; a need for separate local warps of body regions would refute the integral-transformation account." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "A sufficiently flexible warp can map any two outlines, so the test has to freeze a simple transformation and hold landmarks out.", "Individual and preservational variation in these deep-bodied fishes adds scatter around one diagrammatic map." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch17-11 by Grok 4.7: 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.78"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-11--grok--operationalizability> .
