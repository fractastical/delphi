sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-01--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-01--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch11-01: resolvable-now, resolvability 0.69" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.693"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.68"^^xsd:double ;
    dct:description "Competing spiral equations are standard to fit, and public images or scans exist for every class the claim names, including the cordate-leaf exception. Taxonomic depth is greatest for molluscs and thinner for horns and capitula, but a decisive mismatch in any named class would refute the universal. The curve-fitting itself is ordinary morphometrics on existing pictures." ;
    rdfs:comment "Proposed test with existing data: Fit logarithmic spirals against Archimedean, Fermat and other curves on ruminant horns, mollusc and foraminiferan shells, and sunflower floret parastichies, and fit the cordate leaf outline as the stated exception. A logarithmic spiral uniquely among those forms, and a poor log-spiral fit to the cordate leaf, supports the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Sunflower parastichies are often treated as Fermat spirals, so the curve family has to be fit rather than assumed.", "Horn scans and digitized leaf outlines are less uniformly available than mollusc photographs." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-01--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-01--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-01--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-01--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch11-01 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-01--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
