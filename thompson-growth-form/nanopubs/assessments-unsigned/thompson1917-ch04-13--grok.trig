sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-13--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch04-13: resolvable-now, resolvability 0.87" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.873"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "The claim is a frequency statement about germ-nucleus chromosome number, and both plants and animals now have open count compilations large enough to estimate the two tails. The analysis is a histogram. Uneven taxonomy and diploid reporting reduce adequacy below a complete census, but they do not prevent a clear decision about whether counts are mostly confined to six through sixteen." ;
    rdfs:comment "Proposed test with existing data: Using haploid counts for plant and animal species, compute the fraction with fewer than six chromosomes and the fraction with more than sixteen. The claim stands if both tails are small and the upper tail is the smaller; it falls if a large share of species lie outside 6–16, especially above 16." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Plant records are often sporophytic diploid numbers, so haploid values need a ploidy assumption.", "Animal sampling is uneven across phyla.", "B chromosomes and sex chromosomes create within-species ranges." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch04-13 by Grok 4.7: 0.95" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.95"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-13--grok--operationalizability> .
