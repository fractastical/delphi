    rdfs:label "Candidate dataset: MitoCarta3.0" ;
    dct:description "Inventory of mammalian mitochondrial proteins, sub-compartments and pathways, used to test whether these bodies have a specific identity" ;
    prov:wasDerivedFrom <https://personal.broadinstitute.org/scalvo/MitoCarta3.0/> .
