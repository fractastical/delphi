sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch06-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-05--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch06-05: resolvable-now, resolvability 0.83" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.833"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    dct:description "The claim denies that mitochondria and similar granules are special entities and treats them as surface-tension clumps. Open proteomes and image volumes show membrane-bounded organelles with pathway annotations and a cell-wide distribution, which is a direct and standard test of that denial. A counterexample of this clarity resolves the universal claim even though some minor fibrillar inclusions remain less studied." ;
    rdfs:comment "Proposed test with existing data: Ask whether mitochondria are bounded organelles with a characteristic proteome and functions, or unstructured clumps of mixed cytoplasm drawn to a cell pole. A double membrane, a mitochondrial proteome and a distributed network would refute the clump account; granules with no specific composition, gathered and drawn out with the cell axis, would support it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The same resources do not cover every non-mitochondrial fibril the wording also includes.", "Mammalian cultured cells dominate the image sets relative to germ cells and invertebrate tissues." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch06-05--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch06-05 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch06-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
