sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch04-02: resolvable-now, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.715"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "The categorical rejection of traction has clear observable consequences, and open perturbation microscopy can test whether microtubule mechanics account for spindle behavior. The unspecified nature of the alternative polarizing field lowers operationalizability but does not prevent refuting the claim." ;
    rdfs:comment "Proposed test with existing data: Use live-cell spindle imaging and perturbation data to test whether spindle fibers transmit mechanical traction and whether a distinct magnetism-like bipolar field is needed to predict chromosome and particle motion. Evidence of tensile microtubule forces sufficient to explain the pattern refutes the exclusion of mechanical traction." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "The proposed field is analogical rather than quantitatively specified.", "Images alone may not directly measure force." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-02--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-02--gpt--operationalizability> a delphi:LLMClaimAssessment ;
