sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-09--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-09--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-09: partially-resolvable, resolvability 0.53" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.53"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "The enumeration is largely a theorem about partitions, and datasets test only whether real surface groups obey its premises and look like the listed types. Public cleavage and embryo images support that conformity check for a few organisms. They do not convert the combinatorial statement into an independent empirical law, which limits both discriminating power and scope." ;
    rdfs:comment "Proposed test with existing data: Classify surface eight-cell groups, animal and plant, into the thirteen topological types implied by three-way meetings and no submerged cell, and count exceptions. Every group that meets those premises falling into one of the thirteen types would support the empirical rider; a recurring surface arrangement that meets the premises and fits none of the types would refute the enumeration." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "If the three-way and all-cells-on-the-surface premises hold, the thirteen types are a combinatorial list, and images cannot reveal a fourteenth type without breaking a premise.", "Many real eight-cell groups include an internal cell or a transient four-way junction and so sit outside the claim's antecedent." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-09--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-09--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-09 by Grok 4.7: 0.7" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.7"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-09--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-09--grok--operationalizability> .
