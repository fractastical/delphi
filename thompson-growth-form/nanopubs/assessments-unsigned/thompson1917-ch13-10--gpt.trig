sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-10> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-10--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch13-10: partially-resolvable, resolvability 0.59" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.593"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    dct:description "Modern kinematics makes the mechanism directly testable, and some public time-lapse studies can address it. Existing coverage is unlikely to resolve the full scope of twining plants." ;
    rdfs:comment "Proposed test with existing data: Analyze time-lapse stem growth to estimate side-specific elongation and test whether the moving growth asymmetry predicts circumvolution direction, phase and curvature. Correct temporal prediction supports the mechanism; twining without differential growth or phase mismatch refutes it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Repository coverage of side-specific elongation is uncertain.", "Twining species and growth conditions are heterogeneous." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-10--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-10--gpt--dataset-2> .
