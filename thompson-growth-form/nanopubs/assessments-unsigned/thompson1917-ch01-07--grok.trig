sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch01-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-07--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-07--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch01-07: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.563"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.62"^^xsd:double ;
    dct:description "Viscosity, yield under slight pressure, and the timescale of shape change are standard variables, so the contrast with water and with an elastic solid is a real decision criterion. The measurements exist but are scattered across microrheology papers, cover a modest set of naked cells, and do not by themselves separate passive treacle-like viscosity from active flow. Compilation and that confound make the test partial rather than immediate." ;
    rdfs:comment "Proposed test with existing data: Compare cytoplasmic viscosity and creep of Amoeba, or closely similar naked cells, with water under small stress, and compare the flow timescale with the timescale of shape change. The claim is confirmed by ready flow, viscosity orders of magnitude above water, and a slowing of shape change by that viscosity; it is refuted if the material is elastic on that timescale or near water in viscosity." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Viscosities differ by method and are not gathered in one downloadable rheology table.", "Active cytoskeletal flow can imitate high passive viscosity." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch01-07--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-07--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch01-07 by Grok 4.7: 0.75" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.75"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-07--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch01-07> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch01-07--grok--operationalizability> .
