sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch16-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-04--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch16-04--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch16-04: partially-resolvable, resolvability 0.78" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.782"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.86"^^xsd:double ;
    dct:description "The predicted profile is quantitative and scan analysis is straightforward. Available imaging can test humans and selected taxa, but estimating subject-specific bending moments and covering weight-bearing bones broadly limits resolution." ;
    rdfs:comment "Proposed test with existing data: Extract cortical wall thickness along CT-scanned femora and compare its longitudinal profile with bending moments from musculoskeletal or beam models. Correlation after accounting for axial and torsional loads supports the claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Muscle forces and habitual loading are usually not paired with bone scans.", "Epiphyses and shaft are subject to multiple load modes." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-04--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch16-04--gpt--dataset-2> .
