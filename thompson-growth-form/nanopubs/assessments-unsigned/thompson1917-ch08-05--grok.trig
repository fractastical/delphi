sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-05--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch08-05: partially-resolvable, resolvability 0.61" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.61"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The angular window is a sharp, refutable prediction, and some wedge-shaped cells in public apex and embryo volumes can be scored for wall orientation. Those cells are an imperfect match to the circular-sector geometry used to derive 62.5 degrees. The test is informative for growing points that have been segmented and incomplete for the wider scope." ;
    rdfs:comment "Proposed test with existing data: Measure the apical angle of sector-shaped cells and whether the next wall is anticlinal or periclinal. Anticlinal walls concentrated between about 62.5 and 90 degrees, and periclinal walls in narrower sectors, would support the claim; anticlinal walls common in narrow sectors would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Meristem surface cells are polygonal prisms more often than the flat circular sectors the threshold was derived for.", "Flattened discs and fern apices in the stated scope are mostly uncompiled." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-05--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch08-05--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch08-05 by Grok 4.7: 0.9" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.9"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch08-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch08-05--grok--operationalizability> .
