sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch10-02> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-02--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-02--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch10-02: resolvable-now, resolvability 0.71" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.71"^^xsd:double ;
    delphi:hasVerdict "resolvable-now" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Tightening coils on a cone are a specific alternative to a constant-pitch helix or to the shell's own logarithmic spiral, and both photographs and scans of Turritella-like shells are public. Coverage is good for common high-spired genera and thinner for the full diversity of turreted forms. Fitting the curve is a standard morphometric job on the order of weeks." ;
    rdfs:comment "Proposed test with existing data: Unroll or fit the suture and parallel striae of high-spired shells such as Turritella on a cone and test whether they are conical geodesics whose coils tighten toward the apex. A constant-pitch helix, or coils that do not close apically, would refute the stated curve." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Photographs give a profile of the suture; a full geodesic test is more secure on 3D scans, which are fewer than photos.", "Ornament and repaired breaks can locally displace the suture from the growth curve." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-02--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-02--grok--dataset-2>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch10-02--grok--dataset-3> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-02--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch10-02 by Grok 4.7: 0.85" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.85"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch10-02--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
