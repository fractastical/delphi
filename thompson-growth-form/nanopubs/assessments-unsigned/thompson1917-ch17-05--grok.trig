sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-05--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-05--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch17-05: partially-resolvable, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.491"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.5"^^xsd:double ;
    dct:description "The claim is a countable historical pattern: sheared fossils have often been named as separate species. Occurrence databases list candidate taxa and localities, while the strain measurements and later synonymies live in local geological papers. A team can assemble a partial test for well-studied slates and cannot yet survey deformed strata in general." ;
    rdfs:comment "Proposed test with existing data: For fossils from folded strata, compare shape differences with an independent tectonic strain estimate and ask whether names later treated as separate species collapse once that shear is removed. Support would be repeated cases where the residual biological difference is within species-level variation; persistent differences after retrodeformation would count against mistaking shear for taxonomy." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Strain markers and the taxonomic histories of supposed species are scattered by locality, not stored with the occurrence data.", "Biological variation and compaction can mimic tectonic shear." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch17-05--grok--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-05--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch17-05 by Grok 4.7: 0.66" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.66"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-05--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch17-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch17-05--grok--operationalizability> .
