sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch11-21> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-21--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-21--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch11-21: partially-resolvable, resolvability 0.56" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.565"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "Suture morphology is abundant and measurable, but the analogical mechanism is weakly discriminating because reaction-diffusion, differential growth and buckling can produce similar branching. Existing data can test model fit, not confidently identify surface tension as the cause." ;
    rdfs:comment "Proposed test with existing data: Quantify branch topology, tip curvature and wavelength in ammonitic sutures and compare them with explicit surface-tension instability models and rival growth or buckling models. A surface-tension account must uniquely reproduce scaling and branching statistics, not merely visual resemblance." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Pattern resemblance is non-unique across physical mechanisms.", "Interfacial tensions during septum formation are not preserved.", "Many fossils expose only 2D suture traces." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-21--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch11-21--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch11-21 by GPT-5.6 Sol: 0.55" ;
