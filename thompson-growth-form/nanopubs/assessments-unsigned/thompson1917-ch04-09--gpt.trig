sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-09> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-09--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-09--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch04-09: partially-resolvable, resolvability 0.50" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.498"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.73"^^xsd:double ;
    dct:description "Specific mechanical models are testable in selected animal and plant systems. Existing data cannot establish the claim for all cells, and its broad wording weakens discrimination." ;
    rdfs:comment "Proposed test with existing data: Across representative cell types, quantify cortical or interfacial tension and opposing spindle, ring, adhesion, and pressure forces during division, then test whether force-balance models predict furrow position and equatorial division. A division mode not involving a relevant surface-tension balance would refute the universal claim." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Surface tension is not directly measured in most imaging datasets.", "The universal scope includes highly divergent cell walls and division mechanisms.", "A broad force-balance description can be hard to falsify." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-09--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-09--gpt--operationalizability> a delphi:LLMClaimAssessment ;
