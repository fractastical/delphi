sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-12--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-12--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch13-12: partially-resolvable, resolvability 0.67" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.668"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.67"^^xsd:double ;
    dct:description "Fitting tine tips to one mirror-symmetric curved surface is a direct test, and enough antlered skulls are publicly scanned to try it on red deer, wapiti, and similar species. That is the comparison Thompson invites, but it is not yet a family-wide sample, and shed antlers cannot test the paired surface. The analysis itself is a short geometric exercise once paired meshes are chosen." ;
    rdfs:comment "Proposed test with existing data: Place landmarks on tine tips of paired antlers and fit a single ellipsoid or spheroid, allowing mirror symmetry across the midline. The claim is supported if one surface accounts for both antlers within a small residual and the tips lie on a continuous curve; systematically separate surfaces for left and right, or residuals that grow with tine length, would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Many scans are of skulls after the antlers were shed, or of a single antler.", "Open 3D coverage is good for a few deer species and poor for the rest of Cervidae." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-12--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-12--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-12--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch13-12 by Grok 4.7: 0.8" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.8"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-12--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-12> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-12--grok--operationalizability> .
