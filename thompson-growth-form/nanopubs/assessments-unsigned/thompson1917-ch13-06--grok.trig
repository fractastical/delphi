sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch13-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-06--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-06--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch13-06: partially-resolvable, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.476"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "The claim is a geometric rule linking the position of fastest and slowest growth to planarity, and it is testable when growth bands can be read around the horn. Existing 3D archives record the resulting curve much more often than the increment field that is supposed to cause it. A subset of photographed sheaths with clear rings could be measured, but a family-wide test would require new digitizing of increment positions." ;
    rdfs:comment "Proposed test with existing data: Around the basal growth zone, map which side of the horn thickened fastest using growth-line spacing or sheath increments, and relate the angular separation of the maximum and minimum to whether the centerline is planar. The claim is confirmed if planarity occurs when those extrema are opposite and a helical component appears when they are offset; it is refuted if planar horns regularly have offset extrema." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Circumferential growth-rate maps are rarely digitized; most archives store overall shape only.", "If the extrema are inferred from the centerline, the test repeats the geometric definition." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-06--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch13-06--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-06--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch13-06 by Grok 4.7: 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.64"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch13-06--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
