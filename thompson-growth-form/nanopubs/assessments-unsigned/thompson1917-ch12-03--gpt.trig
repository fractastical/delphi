sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch12-03> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-03--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-03--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch12-03: partially-resolvable, resolvability 0.54" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.54"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    dct:description "The geometric predictions are explicit, and public tomography can test them for selected taxa. The causal pressure-side inference remains indirect and confounded by secretion and tissue support." ;
    rdfs:comment "Proposed test with existing data: Measure septal curvature and attachment boundaries in tomographic shells of Foraminifera and Nautilus, then compare observed surfaces with numerically computed minimum-area surfaces under inferred pressure orientation. Reversed curvature with good minimum-surface fits would support the claim; inconsistent orientation or poor fits would refute it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Pressure at septum formation is generally absent from museum datasets.", "Preservation and scan resolution can distort thin septa." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch12-03--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch12-03--gpt--operationalizability> a delphi:LLMClaimAssessment ;
