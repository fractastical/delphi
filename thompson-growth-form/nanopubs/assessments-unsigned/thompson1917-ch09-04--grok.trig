sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch09-04: partially-resolvable, resolvability 0.51" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.51"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.58"^^xsd:double ;
    dct:description "The structural comparison is measurable, but the inference from shared structure to a shared physico-chemical mode is one interpretation among others. Otolith outlines are well archived, while matched sections of pearls, otoliths and laboratory calcospherites are not. A subset comparison is feasible from images and scans; it would not cleanly exclude other ways of building the same fabric." ;
    rdfs:comment "Proposed test with existing data: Compare sectioned pearls, molluscan and teleost otoliths, and albumin-precipitated calcospherites for concentric zoning and radial fabric. A shared geometry supports a common precipitation mode; systematic differences in zoning or crystal habit refute the identification." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Pearls and artificial calcospherites are mostly illustrated in papers, not in the otolith catalogues.", "Similar concentric-radiate structure can arise from more than one precipitation chemistry." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-04--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-04--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch09-04 by Grok 4.7: 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.65"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-04--grok--operationalizability> .
