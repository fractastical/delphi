sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-13--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-13--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch09-13: partially-resolvable, resolvability 0.44" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.44"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.52"^^xsd:double ;
    dct:description "Foreign particles in the test are observable, but volition versus surface energy is not a unique pattern in grain counts. Sediment and foraminiferal census data are public, while the particle-by-particle composition of tests is not systematically attached to them. Existing studies can test a subset of rhizopods and leave the mechanism underdetermined." ;
    rdfs:comment "Proposed test with existing data: Compare the grains in agglutinated tests with the surrounding sediment for size, shape and mineralogy, and ask whether the bias matches specific surface energies. A bias predicted by surface energy supports the physical account; a selectivity that surface energy does not predict is at least compatible with active choice." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "Grain preference is predicted both by surface energy and by biological selection, so the same bias fits both.", "Matched test-plus-sediment measurements are scattered in papers rather than linked in one archive." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-13--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch09-13--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-13--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch09-13 by Grok 4.7: 0.5" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.5"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-13--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch09-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch09-13--grok--operationalizability> .
