sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch05-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-13--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-13--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch05-13: needs-new-data, resolvability 0.49" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.49"^^xsd:double ;
    delphi:hasVerdict "needs-new-data" ;
    delphi:hasConfidence "0.71"^^xsd:double ;
    dct:description "A shared instability model could yield discriminating geometric and perturbational predictions. Existing specimens mainly record endpoints and are inadequate to establish surface tension as the cause during formation." ;
    rdfs:comment "Proposed test with existing data: Image hydroid calycle rims and stems during secretion, quantify notch and annulation wavelengths, and test whether one surface-tension instability model predicts both geometries and their response to tension perturbation. Distinct developmental patterning or formation after solidification would refute the shared mechanism." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Final museum morphology does not reveal whether tissue was fluid during patterning.", "Developmental time series and tension perturbations are scarce.", "The common-cause model lacks a specified parameterization." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch05-13--gpt--dataset-1> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch05-13--gpt--operationalizability> a delphi:LLMClaimAssessment ;
