sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-11--grok> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-11--grok> a delphi:LLMClaimAssessment ;
    rdfs:label "Grok 4.7 on thompson1917-ch02-11: partially-resolvable, resolvability 0.39" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.388"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.55"^^xsd:double ;
    dct:description "No existing dataset records terrestrial animals that evolved under doubled or halved gravity, so the literal prediction cannot be confirmed or refuted. Limb allometry against mass is a public proxy for the idea that gravitational load conditions form, and it is only a proxy: a short-legged large mammal is compatible with several selective stories. Discriminating power stays low for that reason." ;
    rdfs:comment "Proposed test with existing data: The doubled-gravity fauna is not in any dataset. A proxy is whether limb proportions become shorter and more heavily built as body weight, and thus skeletal load, increases. That pattern would support the scaling the counterfactual extrapolates; it would not show what animals would be like under twice or half Earth's gravity." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> ;
    delphi:evidenceAgainst "The claim is a counterfactual about a different gravitational constant.", "Short legs have many ecological causes besides skeletal load." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-11--grok--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-11--grok--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-11--grok--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch02-11 by Grok 4.7: 0.35" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
    delphi:assessmentType "dataset-resolvability/0.2.0/operationalizability" ;
    delphi:hasScore "0.35"^^xsd:double ;
    dct:isPartOf <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-11--grok> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-grok-4.7-high-fast> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-11> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-11--grok--operationalizability> .
