    rdfs:label "Candidate dataset: Stoddard et al. 2017 egg-shape supplement" ;
    dct:description "Species-level asymmetry and ellipticity used to test a membrane model of egg shape" ;
    prov:wasDerivedFrom <https://doi.org/10.1126/science.aaj1945> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch15-06--grok--dataset-2> a delphi:EvidenceItem ;
