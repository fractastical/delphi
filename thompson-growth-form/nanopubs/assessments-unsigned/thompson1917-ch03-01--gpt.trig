sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch03-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-01--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-01--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch03-01: partially-resolvable, resolvability 0.48" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.485"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.74"^^xsd:double ;
    dct:description "Directional growth and external form are measurable with modern imaging, but Thompson's universal accounting claim exceeds available taxonomic and temporal coverage. Existing data can resolve it in selected developmental systems only." ;
    rdfs:comment "Proposed test with existing data: Estimate spatial directional growth tensors from longitudinal images and test whether integrating their ratios predicts observed external shape trajectories. Predictive failure after measured growth is supplied would refute the relation in a system, while success across diverse taxa would support its restricted form." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Most morphology datasets are cross-sectional rather than longitudinal.", "Growth ratios can describe shape change without identifying its cause.", "The scope covers nearly all organisms." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-01--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch03-01--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch03-01--gpt--operationalizability> a delphi:LLMClaimAssessment ;
    rdfs:label "Operationalizability of thompson1917-ch03-01 by GPT-5.6 Sol: 0.65" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0-operationalizability> ;
