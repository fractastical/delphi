sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch02-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-06--gpt> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-06--gpt> a delphi:LLMClaimAssessment ;
    rdfs:label "GPT-5.6 Sol on thompson1917-ch02-06: partially-resolvable, resolvability 0.64" ;
    dct:subject <https://w3id.org/delphi/resource/concept/dataset-resolvability-0.2.0> ;
    delphi:assessmentType "dataset-resolvability/0.2.0" ;
    delphi:hasScore "0.638"^^xsd:double ;
    delphi:hasVerdict "partially-resolvable" ;
    delphi:hasConfidence "0.81"^^xsd:double ;
    dct:description "The scaling exponents give clear tests and open morphology plus movement data cover many birds. The exact energetic quantities require model-derived estimates and harmonization, so the claim is currently resolvable only under subsets and assumptions." ;
    rdfs:comment "Proposed test with existing data: Across geometrically similar birds, fit minimum sustained flight speed and flight power against linear size and test exponents of 0.5 and 3.5, while comparing available muscle power with an exponent of 3. Deviations outside uncertainty or successful flight above the predicted power margin would refute the model." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-resolvability-assessor-gpt-5.6-sol-medium> ;
    delphi:evidenceAgainst "Flight power and muscle power are seldom directly measured in open comparative datasets.", "Bird proportions and flight styles are not fixed across size." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-06--gpt--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch02-06--gpt--dataset-2> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-06--gpt--operationalizability> a delphi:LLMClaimAssessment ;
