sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch17-15> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Because the skull of Parahippus fits the interpolated transformation series from Eohippus to Equus poorly, Parahippus is not in the direct line of descent but represents a divergent branch of the Equidae.";
    dc:type "historical-inference";
    <http://www.w3.org/2000/01/rdf-schema#label> "Parahippus is a divergent offshoot, not on the direct line to Equus";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVII, “On the Theory of Transformations, or the Comparison of Related Forms”; topic “Interpolated intermediates in horse evolution”. Scope: phylogeny of fossil Equidae"
}
