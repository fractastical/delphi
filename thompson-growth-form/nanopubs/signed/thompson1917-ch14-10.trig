sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch14-10> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "That the phyllotactic fractions 1/2, 2/3, 3/5… converge to 0.618…, the golden mean, is a mathematical coincidence without biological significance; the precise divergence angle and orthostichies are likewise unimportant.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Convergence of phyllotactic ratios to the golden mean has no biological significance";
    <http://www.w3.org/2004/02/skos/core#notation> "\\tfrac{1}{2}, \\tfrac{2}{3}, \\tfrac{3}{5}, \\tfrac{5}{8}, \\dots \\to (\\sqrt{5} - 1)/2 \\approx 0.618";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XIV, “On Leaf-Arrangement, or Phyllotaxis”; topic “Divergence angle and the golden mean”. Scope: spiral phyllotaxis"
}
