sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch03-14> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Curves of growth show well-marked interruptions or changes of rate at physiological epochs such as birth and puberty, in man and in other animals, and most strikingly in animals that undergo a regular metamorphosis.";
    dc:type "empirical-generalization";
    <http://www.w3.org/2000/01/rdf-schema#label> "Growth rate is interrupted at physiological epochs such as birth, puberty, metamorphosis";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Growth epochs and metamorphosis”. Scope: animals, including man, mouse, silkworm, tadpole"
}
