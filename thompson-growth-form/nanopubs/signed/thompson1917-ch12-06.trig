sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch12-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Each foraminiferal chamber bears a constant ratio of size to the next because the rate of increase at each instant is proportional to the whole existing mass of the homogeneous organism.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Constant chamber-size ratio follows from growth proportional to existing mass";
    <http://www.w3.org/2004/02/skos/core#notation> "dM/dt \\propto M \\Rightarrow V_{n+1}/V_n = \\text{const}";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XII, “The Spiral Shells of the Foraminifera”; topic “Constant ratio of chamber sizes”. Scope: chambered Foraminifera"
}
