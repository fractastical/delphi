sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch11-23> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Natural Selection, in any strictly biological sense, has no necessary share in producing the varied forms of spiral shells, which arise from differences in growth rates and ratios.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Natural Selection plays no necessary part in producing spiral shell forms";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XI, “The Logarithmic Spiral”; topic “Shell forms and Natural Selection”. Scope: spiral shells of molluscs, foraminifera and worms"
}
