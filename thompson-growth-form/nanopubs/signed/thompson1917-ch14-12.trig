sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch14-12> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "If leaves benefit from being spread apart for exposure to air, lengthening the axis to separate them vertically has a far greater effect than any adjustment of the divergence angle, so the azimuthal 'ideal angle' cannot be the plant's means of optimising exposure.";
    dc:type "prediction";
    <http://www.w3.org/2000/01/rdf-schema#label> "Leaf exposure is changed far more by internode length than by divergence angle";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XIV, “On Leaf-Arrangement, or Phyllotaxis”; topic “Divergence angle and the golden mean”. Scope: leafy shoots of plants"
}
