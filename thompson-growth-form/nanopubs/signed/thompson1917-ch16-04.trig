sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch16-04> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Because bending strain is greatest at mid-length of a bent column, the walls of a long bone such as the femur are thickest in the middle of the shaft and thin gradually towards the ends, so that wall thickness forms a graph of the bending moments along the bone.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Femoral wall thickness follows the bending-moment distribution along the shaft";
    <http://www.w3.org/2004/02/skos/core#notation> "wall thickness t(x) \\propto bending moment M(x), maximal at mid-shaft";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVI, “On Form and Mechanical Efficiency”; topic “Tubular construction of bones and stems”. Scope: weight-bearing long bones, especially the human femur"
}
