sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch16-10> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In the vertebral girder, ligaments form the upper tension member, vertebral bodies the lower compression member and the spines the web, and the height of the vertebral spines at each point along the back is proportional to the bending moment at that point.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Height of vertebral spines is proportional to the local bending moment";
    <http://www.w3.org/2004/02/skos/core#notation> "height of vertebral spine h(x) \\propto bending moment M(x)";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XVI, “On Form and Mechanical Efficiency”; topic “Vertebral spines and bending moments”. Scope: vertebral columns of quadrupedal and bipedal vertebrates"
}
