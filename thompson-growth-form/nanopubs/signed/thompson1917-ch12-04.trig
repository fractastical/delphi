sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch12-04> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Spiral foraminiferal shells are logarithmic spirals, recognisable by continued similarity: the large many-chambered shell has the same shape as the smaller, younger shell.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Spiral foraminiferal shells are logarithmic spirals, large shells similar to small ones";
    <http://www.w3.org/2004/02/skos/core#notation> "r = a e^{\\theta\\cot\\alpha}, recognised by self-similarity of young and old shells";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XII, “The Spiral Shells of the Foraminifera”; topic “Logarithmic spiral of foraminiferal shells”. Scope: nautiloid and other spiral Foraminifera"
}
