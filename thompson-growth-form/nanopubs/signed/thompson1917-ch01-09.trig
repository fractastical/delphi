sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch01-09> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "In development, variation and inheritance, material elements such as the spermatozoon, nucleus, chromosomes or germ-plasm never act as matter alone, but only as seats of energy and centres of force.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Nuclei, chromosomes and germ-plasm act only as seats of energy and centres of force";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter I, “Introductory”; topic “Morphology as dynamics”. Scope: embryology and heredity"
}
