sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch12-10> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Foraminiferal shells grow by laws so simple and so in harmony with their material and the forces acting on them that no form is better, fitter or less fit to survive than another, which accounts for the great diversity of types and their persistence since the Cretaceous.";
    dc:type "conceptual";
    <http://www.w3.org/2000/01/rdf-schema#label> "Foraminiferal forms follow such simple laws that none is fitter than another to survive";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XII, “The Spiral Shells of the Foraminifera”; topic “Conclusion: evolution of foraminiferal form”. Scope: Foraminifera"
}
