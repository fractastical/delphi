sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch02-15> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Cell division keeps the ratio between a cell's surface and its mass approximately constant and restores the balance of surface energy with the cell's other energies; cleavage of an egg increases surface without increasing volume or mass.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Cell division restores the ratio of surface to mass";
    <http://www.w3.org/2004/02/skos/core#notation> "cell division keeps S/M \\approx \\text{const}; cleavage increases S at constant V and M";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter II, “On Magnitude”; topic “Cell division and surface-mass ratio”. Scope: dividing cells, including cleaving eggs"
}
