sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch01-06> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Like other fluid bodies, the surface of a cell such as an Amoeba carries a surface tension that depends on the substance it touches, and this surface tension strongly affects the cell's form.";
    dc:type "mechanism";
    <http://www.w3.org/2000/01/rdf-schema#label> "Surface tension at a cell's boundary strongly affects its form";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter I, “Introductory”; topic “Physical properties of the Amoeba”. Scope: fluid or semi-fluid cells such as Amoeba"
}
