sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch15-11> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Within each cavity of the heart, where pressure is uniform, wall thickness t varies inversely as the mean curvature, t(1/r + 1/r′) = C, so the highly curved apex of the left ventricle is thinnest.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Heart wall thickness varies inversely with the mean curvature of the chamber";
    <http://www.w3.org/2004/02/skos/core#notation> "t(1/r + 1/r') = C within each cavity of the heart";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter XV, “On the Shapes of Eggs, and of Certain Other Hollow Structures”; topic “Wall thickness of the heart”. Scope: heart chambers of mammals"
}
