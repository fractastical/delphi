sub:assertion {
<https://w3id.org/delphi/resource/claim/thompson1917-ch03-07> a <https://w3id.org/delphi/ontology/Claim>;
    dc:description "Whatever the law of increase in a linear dimension, volume and therefore weight tend to vary as the cube of linear dimensions, which mainly (though not wholly) explains why the human weight curve differs in shape from the stature curve.";
    dc:type "mathematical-law";
    <http://www.w3.org/2000/01/rdf-schema#label> "Weight tends to vary as the cube of linear dimensions during growth";
    <http://www.w3.org/2004/02/skos/core#notation> "W \\propto L^3 whatever the law of growth L(t)";
    <https://w3id.org/delphi/ontology/context> "D’Arcy Wentworth Thompson, On Growth and Form (1st ed., Cambridge: Cambridge University Press, 1917), Chapter III, “The Rate of Growth”; topic “Rate of growth in man”. Scope: growing humans (and organisms generally)"
}
