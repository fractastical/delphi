{
  "mcpServers": {
    "delphisci": {
      "command": "node",
      "args": ["${workspaceFolder}/mcp/server.mjs"]
    },
    "indra-cogex": {
      "url": "https://discovery.indra.bio/mcp"
    },
    "nebius-scientific-ai": {
      "url": "https://89.169.99.188/mcp",
      "headers": {
        "Authorization": "Bearer ${env:NEBIUS_SCIENTIFIC_AI_API_KEY}"
      }
    },
    "senti": {
      "command": "npx",
      "args": ["-y", "sentinelayer-cli@0.46.5", "mcp", "server", "run"],
      "env": {
        "SENTINELAYER_AGENT_ID": "delfie-claude"
      }
    }
  }
}
