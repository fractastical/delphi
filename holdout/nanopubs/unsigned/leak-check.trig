sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/holdout-leak-check-clean-2026-10-31> a delphi:Claim ;
    rdfs:label "Leak check: no builder file outside a reasoned allowlist names a held-out bird taxon (0 hits in 1087 files, 2026-10-31T14:47:23.966Z)" ;
    dct:description "Status: observed at 2026-10-31T14:47:23.966Z; it is a statement about the tree at that moment and is re-run before every exam. Method: holdout/check-leaks.mjs scans claim-tests, organism-design, swarm for the scientific name, slug, NCBI taxid and GBIF key of every held-out taxon in holdout/split.json; any line outside holdout/leak-allowlist.json is a hit and exits 1. Class-level words (Aves, bird, avian, AVONET) are warnings only. Allowlist entries each carry a reason: two source and derived tables of the Kimura test that contain bird rows the analysis drops before fitting; the swarm comparison folder for the burned pigeon claim; the organism thread's exam predictions, which must name roster species; and two homonyms of Troglodytes (an angiosperm genus and the word for cave-dwellers). It does not establish that no builder saw bird data outside this tree, and it does not detect a held-out species described without its name or identifier; it establishes that the files the project holds are blind to the roster except where a stated reason says otherwise." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/holdout-leak-check-2026-10-31T14-47-23-966Z> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/holdout-leak-check-2026-10-31T14-47-23-966Z> a delphi:EvidenceItem ;
    rdfs:label "check-leaks.mjs run of 2026-10-31T14:47:23.966Z: 0 non-allowlisted hits, 53821 class-level warnings, 6 allowlist entries" ;
    dct:description "Output of node holdout/check-leaks.mjs --json over the builders' folders, against the held-out taxa of the frozen split." ;
    delphi:statisticalTest "Exhaustive string match of held-out names and identifiers; no sampling" ;
    prov:wasDerivedFrom sub:frozen-split ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/holdout/data.json> .
  <https://w3id.org/delphi/resource/evidence/holdout-leak-check-2026-10-31T14-47-23-966Z> schema:additionalProperty sub:status .
  sub:status a schema:PropertyValue ;
    schema:propertyID "status" ;
    schema:value "observed: 0 hits outside the allowlist at 2026-10-31T14:47:23.966Z" ;
    schema:description "Status of this evidence item in the words of holdout/EXAM.md and AGENTS.md A10" .
  <https://w3id.org/delphi/resource/evidence/holdout-leak-check-2026-10-31T14-47-23-966Z> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ;
    schema:propertyID "n_files_scanned" ;
    schema:value "1087"^^xsd:integer ;
    schema:description "files read under the scanned folders" .
  <https://w3id.org/delphi/resource/evidence/holdout-leak-check-2026-10-31T14-47-23-966Z> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ;
    schema:propertyID "n_hits_outside_allowlist" ;
    schema:value "0"^^xsd:integer ;
    schema:description "lines naming a held-out taxon outside the allowlist (the exit code is 1 if this is not 0)" .
  <https://w3id.org/delphi/resource/evidence/holdout-leak-check-2026-10-31T14-47-23-966Z> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ;
    schema:propertyID "n_class_level_warnings" ;
    schema:value "53821"^^xsd:integer ;
    schema:description "lines with class-level words only (Aves, bird, avian, AVONET), reported, not failing" .
  <https://w3id.org/delphi/resource/evidence/holdout-leak-check-2026-10-31T14-47-23-966Z> schema:additionalProperty sub:m4 .
  sub:m4 a schema:PropertyValue ;
    schema:propertyID "n_allowlist_entries" ;
    schema:value "6"^^xsd:integer ;
    schema:description "entries in holdout/leak-allowlist.json, each with a reason" .
  <https://w3id.org/delphi/resource/evidence/holdout-leak-check-2026-10-31T14-47-23-966Z> schema:additionalProperty sub:m5 .
  sub:m5 a schema:PropertyValue ;
    schema:propertyID "n_held_out_taxa" ;
    schema:value "88"^^xsd:integer ;
    schema:description "held-out taxa whose names and identifiers are searched for" .
  sub:frozen-exam a prov:Entity ;
    dct:title "holdout/exam.json (frozen roster and rules of the held-out exam; clade confirmed 2026-10-31; roster first frozen 2026-10-31T05:52:44Z)" ;
    spdx:checksum sub:frozen-exam-sha ;
    schema:contentSize "36005"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T14:38:42Z"^^xsd:dateTime .
  sub:frozen-exam-sha a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "f59b7b8ca2bdee21960f6a773de60967bc5c2933ffc75ee9da64e089228f5c7e" .
  sub:frozen-split a prov:Entity ;
    dct:title "holdout/split.json (assignment of every inventory taxon to holdout, train or excluded)" ;
    spdx:checksum sub:frozen-split-sha ;
    schema:contentSize "282269"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T14:38:42Z"^^xsd:dateTime .
  sub:frozen-split-sha a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "d73dab71347e21e047ea2304b3ae669ed08b780b515aeba249097545246c0855" .
  <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> a prov:SoftwareAgent ;
    rdfs:label "delphisci holdout thread (session scienceclaw-93, Claude Fable 5.1): froze the held-out exam and runs it; built none of the work it examines" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

