    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/holdout/data.json> , <https://github.com/xX-its-amit-Xx/delphi/tree/da7e271b7015bb60d2d4759c21001895e09852b7/holdout> , sub:frozen-split ;
    prov:wasGeneratedBy sub:scan .
  sub:scan a prov:Activity ;
