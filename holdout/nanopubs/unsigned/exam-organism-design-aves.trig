sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/hypothesis/organism-design-blueprint-predicts-aves-anatomy> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/holdout-exam-organism-design-aves> ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> .
  <https://w3id.org/delphi/resource/assessment/holdout-exam-organism-design-aves> a delphi:Assessment ;
    rdfs:label "Held-out exam (Aves) of the organism-design blueprint tool: inconclusive, the panel lacks both pre-registered structures" ;
    delphi:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/organism-design-blueprint-predicts-aves-anatomy> ;
    delphi:assessmentType "held-out-clade-exam" ;
    delphi:hasVerdict "inconclusive" ;
    dct:description "Status: inconclusive. The exam could not score the pre-registered tests: the tool's structure panel (259 Uberon terms) contains no sternal-keel term and no foot-webbing term, so tests A and B have zero scored species against a minimum of 10, and the prediction file reports no conflicts field, so test C is not evaluable. the panel contains no sternal-keel term, so test A has no predictions to score; the panel contains no foot-webbing term, so test B has no predictions to score; the prediction file reports no reading.conflicts, so test C is not evaluable. It does not establish that the tool is right or wrong about bird anatomy; it establishes that this panel cannot be examined on these two structures, which is a finding about the panel's coverage. Exploratory and not pre-registered: the 48 roster species received only 2 distinct prediction vectors, so the tool's output barely varies across birds. This is run 3 of the exam, filed as result.run2.json; run 2 overwrote run 1 by a scripting error and that violation of the never-overwrite rule is recorded in holdout/exam-results/organism-design/NOTE.md. The prediction file was identical in every run (SHA-256 8137187c684d182b493190ca6349c24cafe94ba933ff35437984be98887af041)." ;
    delphi:evidenceAgainst "No pre-registered structure is in the tool's panel, so no accuracy could be computed." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> a delphi:EvidenceItem ;
    rdfs:label "organism-design on the Aves roster: A keel 0 scored, B webbing 0 scored, C conflicts not reported for 48 of 48 (inconclusive)" ;
    dct:description "Scored by holdout/exam-results/organism-design/score.mjs against the rule in PREREG.md. Preconditions: frozen split verified; prediction file cites the frozen exam.json SHA-256 (f59b7b8ca2bdee21960f6a773de60967bc5c2933ffc75ee9da64e089228f5c7e); leak check over organism-design/ exit 0 with organism-design/exam/ allowlisted because the prediction file necessarily names roster species. Ground truth: NCBI Taxonomy lineages (cached) and the AVONET extract (SHA-256 749b6481048b707f28ae9de522fbedead69fcb487b423823f179d3775f452e22)." ;
    delphi:statisticalTest "Accuracy of present/absent predictions against lineage-derived (keel) and AVONET-derived (webbing) ground truth over scored species; none scored" ;
    prov:wasDerivedFrom <https://doi.org/10.6084/m9.figshare.16586228> , sub:frozen-exam , sub:predictions ;
    rdfs:seeAlso <https://delphibio.org/t/holdout/data.json> .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> schema:additionalProperty sub:status .
  sub:status a schema:PropertyValue ;
    schema:propertyID "status" ;
    schema:value "inconclusive" ;
    schema:description "Status of this evidence item in the words of holdout/EXAM.md and AGENTS.md A10" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ;
    schema:propertyID "n_roster_species" ;
    schema:value "48"^^xsd:integer ;
    schema:description "held-out bird species on the frozen roster" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ;
    schema:propertyID "n_panel_structures" ;
    schema:value "259"^^xsd:integer ;
    schema:description "Uberon structures in the tool's panel" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ;
    schema:propertyID "n_scored_keel" ;
    schema:value "0"^^xsd:integer ;
    schema:description "species scored on test A (sternal keel); minimum for a verdict is 10" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> schema:additionalProperty sub:m4 .
  sub:m4 a schema:PropertyValue ;
    schema:propertyID "n_scored_webbing" ;
    schema:value "0"^^xsd:integer ;
    schema:description "species scored on test B (foot webbing); minimum for a verdict is 10" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> schema:additionalProperty sub:m5 .
  sub:m5 a schema:PropertyValue ;
    schema:propertyID "n_ratites_on_roster" ;
    schema:value "4"^^xsd:integer ;
    schema:description "palaeognath ratites on the roster, the keel-absent class" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> schema:additionalProperty sub:m6 .
  sub:m6 a schema:PropertyValue ;
    schema:propertyID "n_conflicts_not_reported" ;
    schema:value "48"^^xsd:integer ;
    schema:description "species whose blueprint carries no reading.conflicts field (test C not evaluable)" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-organism-design-aves> schema:additionalProperty sub:m7 .
  sub:m7 a schema:PropertyValue ;
    schema:propertyID "n_distinct_prediction_vectors" ;
    schema:value "2"^^xsd:integer ;
    schema:description "exploratory, not pre-registered: distinct prediction vectors across the roster" .
  sub:predictions a prov:Entity ;
    dct:title "organism-design/exam/aves-predictions.json (the organism thread's predictions for the roster)" ;
    spdx:checksum sub:predictions-sha .
  sub:predictions-sha a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "8137187c684d182b493190ca6349c24cafe94ba933ff35437984be98887af041" .
  sub:frozen-exam a prov:Entity ;
    dct:title "holdout/exam.json as frozen 2026-10-31T05:52:44Z (provisional), the freeze this exam ran against; superseded 2026-10-31T14:38:42Z by the confirmed freeze (exam.json SHA-256 f59b7b8ca2bdee21960f6a773de60967bc5c2933ffc75ee9da64e089228f5c7e) with the roster unchanged" ;
    spdx:checksum sub:frozen-exam-sha ;
    schema:contentSize "33717"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T05:52:44Z"^^xsd:dateTime .
  sub:frozen-exam-sha a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "06b797929a27fad5b7173dbaa0c2d9d297deea478a64b7a7935f85caec430360" .
  sub:frozen-split a prov:Entity ;
    dct:title "holdout/split.json (assignment of every inventory taxon to holdout, train or excluded, as frozen 2026-10-31T05:52:44Z)" ;
    spdx:checksum sub:frozen-split-sha ;
    schema:contentSize "279981"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T05:52:44Z"^^xsd:dateTime .
  sub:frozen-split-sha a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "1e57dabb9cb49dbf6dee0f007421d1d095cec86e4d1fe879e1ebde1166dea94a" .
  <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> a prov:SoftwareAgent ;
    rdfs:label "delphisci holdout thread (session scienceclaw-93, Claude Fable 5.1): froze the held-out exam and runs it; built none of the work it examines" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

