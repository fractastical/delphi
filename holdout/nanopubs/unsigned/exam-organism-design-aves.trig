  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> ;
    prov:wasDerivedFrom <https://delphibio.org/t/holdout/data.json> , <https://github.com/xX-its-amit-Xx/delphi/tree/da7e271b7015bb60d2d4759c21001895e09852b7/holdout> ;
    prov:wasGeneratedBy sub:exam .
  sub:exam a prov:Activity ;
    rdfs:label "node holdout/exam-results/organism-design/score.mjs --rerun --reason ... (protocol: holdout/EXAM.md and PREREG.md)" ;
    prov:wasAssociatedWith <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> ;
    prov:used sub:frozen-exam , sub:predictions ;
    prov:endedAtTime "2026-10-31T00:00:00Z"^^xsd:dateTime .
}

