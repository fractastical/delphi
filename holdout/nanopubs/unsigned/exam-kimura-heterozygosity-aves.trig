sub:assertion {
  <https://w3id.org/delphi/resource/claim/kimura-heterozygosity> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/holdout-exam-kimura-heterozygosity-aves> ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> .
  <https://w3id.org/delphi/resource/assessment/holdout-exam-kimura-heterozygosity-aves> a delphi:Assessment ;
    rdfs:label "Held-out exam (Aves) of kimura-heterozygosity: inconclusive, underpowered" ;
    delphi:evaluatesHypothesis <https://w3id.org/delphi/resource/claim/kimura-heterozygosity> ;
    delphi:assessmentType "held-out-clade-exam" ;
    delphi:hasVerdict "inconclusive" ;
    dct:description "Status: inconclusive (underpowered). Held out on 13 bird species, the exam could not distinguish the neutral-heterozygosity law from its refutation: the builder's pre-registered rule needs a minimum sample of 50. The exam applied the builder's own pre-registered decision rule, including its minimum sample size, to the held-out bird rows alone, after the builder reported status complete; the assessor did not build the test. Builder's verdict on the training species: refutes. It does not establish that the law holds or fails in birds: thirteen species cannot meet a rule written for fifty, and the bird slope is reported for the record only. It does not alter the builder's verdict on the training species, which the exam did not re-score. It says nothing about effective population size, which the test proxied by census size." ;
    delphi:evidenceAgainst "Underpowered by the builder's own rule: underpowered: 13 bird species, the pre-registered rule needs 50." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> a delphi:EvidenceItem ;
    rdfs:label "kimura-heterozygosity: OLS slope of log10(pi) on log10(census N) among held-out bird species only = 0.0686 (n = 13; inconclusive, below the pre-registered minimum)" ;
    dct:description "Measured on the frozen held-out roster (class Aves, frozen 2026-10-31T14:38:42.937Z, exam.json SHA-256 f59b7b8ca2bdee21960f6a773de60967bc5c2933ffc75ee9da64e089228f5c7e) by running the builder's analysis.py --exam on a scratch copy of claim-tests/math-bio-theorems/kimura-heterozygosity (analysis.py SHA-256 7e4f32425242a70de8119722b3ffa44b4f8d036b4b3fcec1e923781c4acaa86d; leak check exit 0; split verified). Pre-registration: the builder's pass and fail criteria were committed before download (local commit 9b73128, 2026-10-31 05:55 UTC) and amended to exclude class Aves at the holdout thread's request before any data were downloaded (local commit 6f5de70, 2026-10-31 05:57:42 UTC), after the exam was frozen at 2026-10-31T14:38:42.937Z. The criteria are quoted verbatim on the pre-registration node this item derives from." ;
    delphi:statisticalTest "Ordinary least-squares slope of log10 nucleotide diversity on log10 census population size, and Spearman rank correlation, over the held-out bird species alone (the builder's own analysis.py --exam, unchanged)" ;
    prov:wasDerivedFrom <https://doi.org/10.7554/eLife.67509> , <https://github.com/vsbuffalo/paradox_variation> , sub:frozen-exam , sub:preregistration ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/holdout/data.json> .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> schema:additionalProperty sub:status .
  sub:status a schema:PropertyValue ;
    schema:propertyID "status" ;
    schema:value "inconclusive" ;
    schema:description "Status of this evidence item in the words of holdout/EXAM.md and AGENTS.md A10" .
  sub:preregistration a prov:Entity, prov:Plan ;
    dct:title "Builder's pre-registered decision rule for kimura-heterozygosity (claim-tests/math-bio-theorems/kimura-heterozygosity/result.json, fields pass_criterion and fail_criterion)" ;
    prov:generatedAtTime "2026-10-31T05:57:42Z"^^xsd:dateTime ;
    prov:value "PASS: Pre-registered. Data: Buffalo (2021) combined_data.tsv from github.com/vsbuffalo/paradox_variation (commit b8f91d5, 2021-09-27), metazoan species (kingdom == Animalia) with a non-missing diversity value (pairwise nucleotide diversity, column 'diversity') and a non-missing census-size estimate (column 'log10_popsize', the posterior mean of log10 census size from the author's range x density model; if the file carries another census-size point estimate instead, the column actually used is recorded in 'method'). One row per species. SUPPORTS if Spearman rho(log10 pi, log10 N) > 0.5 with p < 0.001 AND the ordinary-least-squares slope of log10 pi on log10 N has a point estimate >= 0.3 with a 95% confidence interval that includes some value >= 0.5 (diversity rises at least about a third as fast as census size on a log scale, i.e. within a factor of about 3 of the law's slope of 1). AMENDMENT (2026-10-31, before any data were downloaded, at the request of the holdout thread): species of class Aves are excluded from the primary analysis and from all criteria above; bird rows are held out and only reported separately, unfitted, as a holdout check. The taxonomic class is taken from the file's own taxonomy columns. FAIL: Pre-registered. REFUTES if the 95% confidence interval of the slope lies entirely below 0.25 (diversity rises less than a quarter as fast as census size on a log scale, so the law with N as the proxy for Ne is quantitatively wrong by orders of magnitude across the range of N: the Lewontin's-paradox pattern) OR rho <= 0. MIXED otherwise. INCONCLUSIVE (underpowered) if fewer than 50 species qualify; INCONCLUSIVE (data-unavailable) if the file cannot be downloaded." .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ;
    schema:propertyID "n_species" ;
    schema:value "13"^^xsd:integer ;
    schema:description "held-out bird species with diversity and census-size values in the builder's table (the sample this evidence item rests on)" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ;
    schema:propertyID "builder_minimum_n" ;
    schema:value "50"^^xsd:integer ;
    schema:description "minimum species count the builder pre-registered for a verdict (INCONCLUSIVE below it)" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ;
    schema:propertyID "n_training_species" ;
    schema:value "160"^^xsd:integer ;
    schema:description "non-bird metazoan species the builder fitted; the builder's verdict rests on these" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> schema:additionalProperty sub:m4 .
  sub:m4 a schema:PropertyValue ;
    schema:propertyID "n_mammal_species_if_mammalia_held_out" ;
    schema:value "40"^^xsd:integer ;
    schema:description "power analysis: species that would be held out had Mammalia been the clade (still below the minimum of 50)" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> schema:additionalProperty sub:m5 .
  sub:m5 a schema:PropertyValue ;
    schema:propertyID "ols_slope_birds" ;
    schema:value "0.06858780076164865"^^xsd:double ;
    schema:description "OLS slope of log10 diversity on log10 census size, birds only" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> schema:additionalProperty sub:m6 .
  sub:m6 a schema:PropertyValue ;
    schema:propertyID "spearman_rho_birds" ;
    schema:value "0.5384615384615384"^^xsd:double ;
    schema:description "Spearman rho between log10 diversity and log10 census size, birds only" .
  <https://w3id.org/delphi/resource/evidence/holdout-exam-kimura-heterozygosity-aves> schema:additionalProperty sub:m7 .
  sub:m7 a schema:PropertyValue ;
    schema:propertyID "ols_slope_training" ;
    schema:value "0.10731485075894677"^^xsd:double ;
    schema:description "the builder's slope on the non-bird species, for comparison (the law predicts about 1)" .
  sub:frozen-exam a prov:Entity ;
    dct:title "holdout/exam.json as frozen 2026-10-31T05:52:44Z (provisional), the freeze this exam ran against; superseded 2026-10-31T14:38:42Z by the confirmed freeze (exam.json SHA-256 f59b7b8ca2bdee21960f6a773de60967bc5c2933ffc75ee9da64e089228f5c7e) with the roster unchanged" ;
    spdx:checksum sub:frozen-exam-sha ;
    schema:contentSize "33717"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T05:52:44Z"^^xsd:dateTime .
  sub:frozen-exam-sha a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "06b797929a27fad5b7173dbaa0c2d9d297deea478a64b7a7935f85caec430360" .
  sub:frozen-split a prov:Entity ;
    dct:title "holdout/split.json (assignment of every inventory taxon to holdout, train or excluded, as frozen 2026-10-31T05:52:44Z)" ;
    spdx:checksum sub:frozen-split-sha ;
    schema:contentSize "279981"^^xsd:integer ;
    prov:generatedAtTime "2026-10-31T05:52:44Z"^^xsd:dateTime .
  sub:frozen-split-sha a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "1e57dabb9cb49dbf6dee0f007421d1d095cec86e4d1fe879e1ebde1166dea94a" .
  <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> a prov:SoftwareAgent ;
    rdfs:label "delphisci holdout thread (session scienceclaw-93, Claude Fable 5.1): froze the held-out exam and runs it; built none of the work it examines" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
