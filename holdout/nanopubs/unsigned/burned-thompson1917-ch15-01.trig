sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/thompson1917-ch15-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/holdout-exam-eligibility-thompson1917-ch15-01> .
  <https://w3id.org/delphi/resource/assessment/holdout-exam-eligibility-thompson1917-ch15-01> a delphi:Assessment ;
    rdfs:label "Burned as a held-out exam item: thompson1917-ch15-01 (Eggs are prolate spheroids, never oblate)" ;
    delphi:evaluatesHypothesis <https://w3id.org/delphi/resource/claim/thompson1917-ch15-01> ;
    delphi:assessmentType "held-out-exam-eligibility" ;
    delphi:hasVerdict "burned" ;
    dct:description "Status: burned (retired as a blind exam item for the held-out clade Aves). Why: In the same swarm comparison set; about birds by subject although the inventory links it to no bird taxon, so check-leaks.mjs does not flag it. Disclosed by: swarm thread (scienceclaw-3d), swarm/compare/DEVIATIONS.md, 2026-10-31. A burned item is not a judgement on the claim itself: it stays a valid claim with whatever evidence it has; it can no longer serve as a blind test of a builder's bird predictions because a builder's agents read it before the clade was held out. It does not establish that any result about this claim is wrong, nor that the builder used bird data improperly." ;
    delphi:evidenceAgainst "Not blind: In the same swarm comparison set; about birds by subject although the inventory links it to no bird taxon, so check-leaks.mjs does not flag it." ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> a prov:SoftwareAgent ;
    rdfs:label "delphisci holdout thread (session scienceclaw-93, Claude Fable 5.1): froze the held-out exam and runs it; built none of the work it examines" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
  <https://w3id.org/delphi/resource/model/claude-fable-5-1> a delphi:LanguageModel ;
    rdfs:label "Claude Fable 5.1" ;
    dct:identifier "claude-fable-5-1" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> ;
    prov:wasDerivedFrom <https://delphi-mission-control.ashenoy000.workers.dev/t/holdout/data.json> , <https://github.com/xX-its-amit-Xx/delphi/tree/da7e271b7015bb60d2d4759c21001895e09852b7/holdout> ;
    prov:wasQuotedFrom "swarm thread (scienceclaw-3d), swarm/compare/DEVIATIONS.md, 2026-10-31 (swarm/compare/DEVIATIONS.md, recorded in holdout/burned.json)" .
}

