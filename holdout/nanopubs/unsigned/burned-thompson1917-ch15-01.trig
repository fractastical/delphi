  this: dct:created "2026-10-31T14:47:24Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> ;
    rdfs:label "Draft: Burned as a held-out exam item: thompson1917-ch15-01 (Eggs are prolate spheroids, never oblate)" ;
