sub:assertion {
  <https://w3id.org/delphi/resource/approach/trabecular-stress-alignment-wolffs-law--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Out-of-sample load inference from trabecular architecture" ;
    dct:subject <https://w3id.org/delphi/resource/problem/trabecular-stress-alignment-wolffs-law> ;
    dct:description "Turn the potentially circular agreement test into a prediction task. For each scanned bone, define a finite library of anatomically plausible load directions before inspecting trabecular fabric. Fit a mechanostat-remodelling model and a load-independent reaction-diffusion growth model on training specimens, then ask each model to rank the held-out specimen's true load direction from architecture alone. Use the same density field and material law in both models, and score top-one identification plus angular error; this tests whether stress leaves information in architecture that a developmental null does not." ;

    delphi:proposedTest "Stress causation gains support if the remodelling model identifies the held-out load within 15 degrees in at least 80% of at least 20 specimens and exceeds the developmental null by at least 25 percentage points with a permutation p-value below 0.05." ;
    delphi:context "Fails if: Equivalent predictive accuracy of the two models, strong dependence on a tuned boundary condition, or failure on synthetic recovery falsifies the proposed discriminator." ;
    delphi:hypothesisType "approach/simulation" ;
    skos:note "Steps: 1. Generate preregistered candidate load libraries and synthetic recovery tests. 2. Calibrate remodelling and developmental-null parameters only on training specimens. 3. Blind the held-out load label and rank candidate directions by posterior predictive discrepancy. 4. Repeat leave-one-specimen-out and report sensitivity to material anisotropy and boundary conditions." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: A public set of at least 20 specimens with known loading class is not yet established; static architecture cannot directly test reorientation after altered loading." ;
    skos:note "Tool: finite-element-analysis" ;
    skos:note "Tool: bayesian-model-comparison" ;
    skos:note "Tool: mechanobiology-simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-07> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-16> ;

    rdfs:seeAlso <https://doi.org/10.1038/35015116> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/trabecular-stress-alignment-wolffs-law> a delphi:Concept, schema:Question ;
    rdfs:label "Do trabeculae align with principal stress, and is that alignment causal?" .


  <https://doi.org/10.1038/35015116> dct:title "Effects of mechanical forces on maintenance and adaptation of form in trabecular bone" ;
    dct:bibliographicCitation "Huiskes et al. 2000, Effects of mechanical forces on maintenance and adaptation of form in trabecular bone" .
}

