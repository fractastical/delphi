sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/active-inference-morphogenesis-falsifiable--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Frozen generative model predicts regeneration times" ;
    dct:subject <https://w3id.org/delphi/resource/problem/active-inference-morphogenesis-falsifiable> ;
    dct:description "Choose one planarian regeneration series and fit a fixed generative model only to intact anatomy and unperturbed regeneration. Define sensory states, latent target morphology, likelihood variance and action dynamics before examining graded perturbations. Predict median regeneration time and failure probability as functions of initial variational surprise." ;

    delphi:proposedTest "The fixed model passes if at least 80% of held-out median times lie within its 90% intervals and surprise improves leave-intervention-out ELPD by at least 10; failure of interval coverage below 50% refutes this instantiation." ;
    delphi:context "Fails if: Predictions require changing likelihoods, priors or target morphology after observing each perturbation, demonstrating post hoc flexibility." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Publish the full generative model, priors and fitting data split before testing. 2. Compute surprise from initial fragment geometry and Vmem summaries. 3. Derive posterior predictive time and error curves for held-out perturbations. 4. Compare against size-only and flexible survival-model baselines." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Open specimen-level regeneration time courses with quantified initial perturbations." ;
    skos:note "Tool: variational-inference" ;
    skos:note "Tool: data-test" ;
    skos:note "Tool: bioelectric-simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-place-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-place-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2019-boundary-15> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-girardia-20> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/active-inference-morphogenesis-falsifiable> a delphi:Concept, schema:Question ;
    rdfs:label "A falsifiable form of active-inference morphogenesis" .



}

