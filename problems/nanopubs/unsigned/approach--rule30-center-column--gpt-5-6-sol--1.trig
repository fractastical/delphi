sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule30-center-column--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "SAT-certified lower bounds on center-column periods" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule30-center-column> ;
    dct:description "Encode the triangular Rule 30 light cone and the assertion that the center column is eventually p-periodic after preperiod q as SAT. Use incremental solving for all p up to a declared P and q up to Q, produce DRAT certificates for unsatisfiable cases, and verify certificates independently; formalize the reduction from a certificate to the excluded finite period claim." ;

    delphi:proposedTest "A Lean-checked theorem excluding every eventual period and preperiod in the stated rectangle, exceeding previous certified bounds." ;
    delphi:context "Fails if: A satisfying assignment reproduces from the single-cell seed and yields a genuine period; otherwise solver scaling before a novel bound defeats this approach." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Generate bit-blasted Rule 30 constraints with shared subformulas. 2. Exclude every pair p <= 100000 and q <= 100000 using incremental SAT and symmetry reductions. 3. Check all UNSAT certificates with an independent verifier. 4. Formalize the constraint semantics and certificate implication in Lean." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Finite lower bounds do not prove nonperiodicity." ;
    skos:note "Tool: sat-solving" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-14> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/rule30-center-column> a delphi:Concept, schema:Question ;
    rdfs:label "The Rule 30 center column" .



}

