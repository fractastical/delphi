sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/somite-number-control--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Clock-wavefront perturbation identifiability map" ;
    dct:subject <https://w3id.org/delphi/resource/problem/somite-number-control> ;
    dct:description "Build a stochastic delayed-oscillator plus moving-wavefront model and perform global sensitivity analysis over clock period, axis elongation, coupling delay and arrest-front speed. Reproduce published perturbation time courses, then identify perturbations whose somite-count outcomes discriminate period control from elongation control." ;

    delphi:proposedTest "A perturbation is decisive if competing mechanisms predict nonoverlapping 95% intervals separated by at least three somites; publish the top five preregisterable experiments." ;
    delphi:context "Fails if: All feasible perturbations have overlapping predictions because period and elongation parameters remain structurally nonidentifiable." ;
    delphi:hypothesisType "approach/simulation" ;
    skos:note "Steps: 1. Implement a spatial oscillator chain with explicit observation model. 2. Calibrate separately to each species using only time-course phase and axis length. 3. Run Sobol sensitivity and profile-likelihood identifiability analyses. 4. Rank feasible temperature, FGF and Notch perturbations by expected information gain." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: Executing the discriminating perturbations requires laboratory access." ;
    skos:note "Tool: developmental-simulation" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch17-04> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/somite-number-control> a delphi:Concept, schema:Question ;
    rdfs:label "What sets vertebrate somite number?" .



}

