sub:assertion {
  <https://w3id.org/delphi/resource/run/hollow-tube-mass-optimality--grok-4-7--1--2026-11-01> a prov:Activity ;
    rdfs:label "Run of approach hollow-tube-mass-optimality--grok-4-7--1 (2026-11-01): completed, settled its target" ;
    dct:description "Lean 4 (ThompsonLaws.HollowTube), no sorry, standard axioms only. At fixed second moment I the wall area is sqrt(4 pi I) sqrt((1-k^2)/(1+k^2)), strictly decreasing in k = r_in/R, so with a gas core no interior optimum exists; with a core of relative density q the mass factor mu(k) = (1 - k^2 + q k^2)/sqrt(1 - k^4) has its unique global minimum at k^2 = 1 - q for 0 < q < 1, and the solid rod is optimal for q >= 1; under a buckling bound t/R >= lambda the optimum is min(sqrt(1-q), 1-lambda). The approach's failure signature did not occur. Whether bones, culms and rachises sit at k* is the pre-registered morphometry test, not run." ;

    dct:subject <https://w3id.org/delphi/resource/problem/hollow-tube-mass-optimality> ;
    prov:qualifiedAssociation <https://w3id.org/delphi/resource/run/hollow-tube-mass-optimality--grok-4-7--1--2026-11-01#plan> ;
    prov:startedAtTime "2026-11-01"^^xsd:date ;
    prov:endedAtTime "2026-11-01"^^xsd:date ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty <https://w3id.org/delphi/resource/run/hollow-tube-mass-optimality--grok-4-7--1--2026-11-01#settled>, <https://w3id.org/delphi/resource/run/hollow-tube-mass-optimality--grok-4-7--1--2026-11-01#solves_problem> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-03> ;
    rdfs:seeAlso <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/run-reports/hollow-tube-mass-optimality--grok-4-7--1.md> ;
