sub:assertion {
  <https://w3id.org/delphi/resource/approach/hollow-tube-mass-optimality--claude-opus-5-5--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Measure K along the shaft from open CT and test the bending-moment profile" ;
    dct:subject <https://w3id.org/delphi/resource/problem/hollow-tube-mass-optimality> ;
    dct:description "Use open CT of limb bones (MorphoSource, with licences recorded) to measure K and cortical thickness at 5% increments along the diaphysis in at least 60 bones across mammals and birds spanning three orders of magnitude in body mass. This gives both a size-dependent test of K at mid-shaft and a direct test of the companion claim thompson1917-ch16-04 (already formalized in Lean as uniformStressThickness_max_mid): wall thickness should track the bending-moment profile of a stated load case. Segment cortical bone with a fixed threshold, compute second moments of area and K per slice, and regress the thickness profile on the bending-moment profile of a three-point-bending load case with the actual bone length." ;

    delphi:proposedTest "Distribution of mid-shaft K versus body mass and of the thickness-to-moment correlation across at least 60 bones, against the pre-registered thresholds." ;
    delphi:context "Fails if: Thickness profiles that peak away from mid-shaft in most bones (e.g. near muscle insertions), or too few open-download specimens to span the mass range." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Scout MorphoSource for open-download femora and humeri with voxel size below 1% of shaft diameter; record licences. 2. Pre-register slice spacing, threshold rule, load case and the pass criterion (Pearson r >= 0.7 between thickness and moment profiles in most bones; mid-shaft K within 0.05 of K*(q) from approach 1). 3. Run segmentation and cross-section geometry (BoneJ slice geometry). 4. Fit K versus log body mass with phylogenetic GLS; report the thickness-moment correlation per bone." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Many MorphoSource specimens require download requests; bone-specific load cases are approximations." ;
    skos:note "Tool: morphosource" ;
    skos:note "Tool: bonej" ;
    skos:note "Tool: python" ;
    skos:note "Tool: r-phylolm" ;
    skos:note "Tool: organisms-layer" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-04> ;
    rdfs:seeAlso <https://www.morphosource.org> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.bone.2010.08.023> ;
    rdfs:seeAlso <https://doi.org/10.1111/j.1469-7998.1985.tb03551.x> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/claude-opus-5-5.json> .
  <https://w3id.org/delphi/resource/problem/hollow-tube-mass-optimality> a delphi:Concept, schema:Question ;
    rdfs:label "Are biological hollow structures at the stiffness-per-mass optimum?" .

  <https://www.morphosource.org> dct:title "MorphoSource" ;
    dct:description "Open CT of vertebrate limb bones; per-specimen download permission varies and must be scouted." .
  <https://doi.org/10.1016/j.bone.2010.08.023> dct:title "BoneJ: Free and extensible bone image analysis in ImageJ" ;
    dct:bibliographicCitation "Doube et al. 2010, BoneJ" .
  <https://doi.org/10.1111/j.1469-7998.1985.tb03551.x> dct:title "The thickness of the walls of tubular bones" ;
    dct:bibliographicCitation "Currey and Alexander 1985, The thickness of the walls of tubular bones" .
}

