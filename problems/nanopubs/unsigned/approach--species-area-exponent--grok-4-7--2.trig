sub:assertion {
  <https://w3id.org/delphi/resource/approach/species-area-exponent--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "A logseries null for the island exponent" ;
    dct:subject <https://w3id.org/delphi/resource/problem/species-area-exponent> ;
    dct:description "Test the sampling explanation of z without fitting z on the same islands used to build the null. Fit Fisher's logseries to the single largest GIFT island, or to one pre-registered mainland GIFT region if the largest island is itself in the test set. Freeze those parameters. Place individuals independently onto the other islands with probability proportional to island area, thinning the same abundance vector. Estimate z by the same negative-binomial GLM as the data test, 1000 replicates. The empirical pooled z is a sampling consequence if it lies inside the central 95 percent of this null. The null uses the empirical area distribution and does not use the empirical species lists of the test islands." ;

    delphi:proposedTest "The empirical pooled z either lies inside the central 95 percent of the logseries-placement null or it does not. Inside means the cluster of z is reproduced by this sampling model." ;
    delphi:context "Fails if: The empirical z falls outside the null interval. A biological mechanism is then still required, and this approach has not explained the exponent. Using the test islands to fit the logseries is a failed pre-registration." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Choose the calibration region and freeze it before estimating z on the remainder. 2. Fit the logseries on the calibration region only. 3. Thin individuals onto the other islands proportional to area, 1000 times. 4. Estimate z with the same GLM as the data test. 5. Locate the empirical z in the null distribution." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: macroecology" ;
    skos:note "Tool: model-comparison" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch12-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch12-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch11-02> ;
    rdfs:seeAlso <https://gift.uni-goettingen.de/> ;
    rdfs:seeAlso <https://doi.org/10.1111/j.1461-0248.2009.01328.x> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/species-area-exponent> a delphi:Concept, schema:Question ;
    rdfs:label "Why does the species-area exponent cluster where it does?" .

  <https://gift.uni-goettingen.de/> dct:title "GIFT, Global Inventory of Floras and Traits" ;
    dct:description "Calibration-region abundances and the area distribution of the remaining islands." .
  <https://doi.org/10.1111/j.1461-0248.2009.01328.x> dct:title "Biodiversity scales from plots to biomes with a universal species–area curve" ;
    dct:bibliographicCitation "Harte et al. 2009, the MaxEnt logseries this null approximates in the calibration region" .
}

