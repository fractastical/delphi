sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/smallest-universal-turing-machine-2-3--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Search for periodic-background tag-system compilers" ;
    dct:subject <https://w3id.org/delphi/resource/problem/smallest-universal-turing-machine-2-3> ;
    dct:description "Treat an eventually periodic tape as left period, finite defect and right period. Enumerate periods up to 12 and defects up to 40 cells, then use symbolic execution and counterexample-guided synthesis to seek macro-configurations representing tag symbols and clock phases. Require compositional transitions, not isolated long transients, and certify candidates by exact simulation." ;

    delphi:proposedTest "A periodic-background compiler with exact certificates for both tag productions, erasure, appending and clock restoration, followed by a Lean simulation theorem." ;
    delphi:context "Fails if: No closed macro-transition set survives adversarial compositions of 10,000 random tag steps despite exhaustive periods and defect bounds; this falsifies the searched compiler family, not universality." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Implement the six-entry machine and symmetry-reduced eventually periodic configurations. 2. Mine recurring spacetime motifs and infer finite-state macro-boundaries. 3. Synthesize encodings of a cyclic tag system with bounded phase jitter. 4. For any candidate, prove finite transition certificates and formulate an induction invariant in Lean." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: No completeness theorem says universality must use a short periodic background or local tag encoding." ;
    skos:note "Tool: turing-machine-enumeration" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-28> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-23> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/smallest-universal-turing-machine-2-3> a delphi:Concept, schema:Question ;
    rdfs:label "Settle whether the (2,3) Turing machine is universal under a conventional definition" .



}

