sub:assertion {
  <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--1--2026-11-01> a prov:Activity ;
    rdfs:label "Run of approach species-area-exponent--grok-4-7--1 (2026-11-01): completed, settled its target" ;
    dct:description "Pre-registered (PREREG.md, sha256 6573bfe3) and run on GIFT: 1,124 islands and 232 mainland units, NB2 fits of power, curved power, Gleason, Lomolino and a logseries-placement surrogate for METE. Pooled z = 0.307 (95% CI 0.295 to 0.319). Universality refuted under the pre-registered falsifier: 46 of 120 pairs of 60x30 degree cells have disjoint z intervals (0.137 to 0.487), DerSimonian-Laird tau = 0.054. The METE-type surrogate loses to the power law by 409 AIC. Pre-registered classification: neither universal power law nor a single scale-dependent form. The claim-level test of darwin1859-ch12-04 supports it on this second, independent dataset (median observed/predicted richness 0.22 on 440 islands over 500 km offshore, Wilcoxon p = 5.5e-67, confidence 0.7). Not the problem's acceptance test: groups are grid cells, not archipelagos, and the METE arm is a surrogate, not meteR." ;

    dct:subject <https://w3id.org/delphi/resource/problem/species-area-exponent> ;
    prov:qualifiedAssociation <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--1--2026-11-01#plan> ;
    prov:startedAtTime "2026-11-01"^^xsd:date ;
    prov:endedAtTime "2026-11-01"^^xsd:date ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--1--2026-11-01#settled>, <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--1--2026-11-01#solves_problem> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch12-04> ;
    rdfs:seeAlso <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/runs/species-area-exponent/RESULTS.md> ;
    prov:generated <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/test-data/claim-tests/darwin-origin/darwin1859-ch12-04/problem-sar-gift/result.json>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-04--claim-test--problem-sar-gift> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/runs.json> .
  <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--1--2026-11-01#plan> a prov:Association ;
