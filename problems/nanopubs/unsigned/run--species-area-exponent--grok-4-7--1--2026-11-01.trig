  <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--1--2026-11-01#solves_problem> a schema:PropertyValue ;
    schema:propertyID "solves_problem" ;
    schema:value false ;
    schema:description "Whether the logged artifacts meet the problem's acceptance criteria or hit one of its falsifiers definitively" .
