sub:assertion {
  <https://w3id.org/delphi/resource/approach/limb-bone-scaling-vs-mechanical-similarity--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Preregistered phylogenetic model contest for limb-bone scaling" ;
    dct:subject <https://w3id.org/delphi/resource/problem/limb-bone-scaling-vs-mechanical-similarity> ;
    dct:description "Reanalyse the Campione and Evans quadruped measurements and an independently curated compilation, resolving taxa through the organisms layer. For circumference, cross-sectional area and section modulus separately, fit phylogenetic generalized least squares and multilevel models with bone, clade and posture interactions. Compare point hypotheses for area exponents 2/3, 3/4 and 1 using a predeclared equivalence margin of 0.04, while estimating phylogenetic uncertainty over a tree ensemble rather than one tree." ;

    delphi:proposedTest "A universal law is accepted only if the pooled exponent is within 0.04 of one candidate, the 95% interval excludes the other two margins, clade standard deviation is below 0.04, and the independent dataset reproduces that classification; otherwise universality is rejected." ;
    delphi:context "Fails if: Failure to reproduce the exponent independently, clade heterogeneity at least 0.04, or intervals overlapping multiple hypotheses defeats a single similarity law." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Vendor measurements, body masses, posture classes and a dated tree ensemble with provenance. 2. Freeze exclusion, log transformation, equivalence margin and outlier rules. 3. Fit pooled and clade-by-bone models and test heterogeneity before selecting a universal exponent. 4. Validate on the independent compilation and report prediction intervals, not only coefficients." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: An independent compilation with comparable posture metadata must be located; circumference alone does not identify safety factor." ;
    skos:note "Tool: phylogenetic-generalized-least-squares" ;
    skos:note "Tool: organisms-layer" ;
    skos:note "Tool: bayesian-multilevel-model" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch02-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-04> ;
    skos:note "Dataset (no resolvable link): Campione and Evans 2012 supplementary data. Proximal humerus and femur circumference, body mass and locomotor grouping." ;
    rdfs:seeAlso <https://doi.org/10.1186/1741-7007-10-60> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/limb-bone-scaling-vs-mechanical-similarity> a delphi:Concept, schema:Question ;
    rdfs:label "How do limb bones actually scale with body mass?" .


  <https://doi.org/10.1186/1741-7007-10-60> dct:title "A universal scaling relationship between body mass and proximal limb bone dimensions in quadrupedal terrestrial tetrapods" ;
    dct:bibliographicCitation "Campione and Evans 2012, A universal scaling relationship between body mass and proximal limb bone dimensions in quadrupedal terrestrial tetrapods" .
}

