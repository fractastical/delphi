sub:assertion {
  <https://w3id.org/delphi/resource/approach/grn-memory-generic-or-biological--grok-4-7--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Prove habituation for one nonlinear motif and not for linear ODEs" ;
    dct:subject <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> ;
    dct:description "Define habituation as three inequalities on a forced ODE: repeated identical pulses produce strictly decreasing peak responses; after a rest interval longer than a stated multiple of the pulse spacing, the next peak returns to within 10 percent of the first; the decrement happens for every pulse amplitude in an open interval. Prove that a three-variable system with slow negative feedback satisfies this on an open set of parameters. Prove that no linear system of the same input-output shape can satisfy decrement for all amplitudes in an interval and recovery after rest, because superposition fixes the gain. This shows habituation is generic for that motif and absent for linear kinetics. It does not show that BioModels are enriched. A failure here leaves the enrichment test untouched." ;

    delphi:proposedTest "A no-sorry existence theorem for the nonlinear motif and a no-sorry impossibility theorem for linear kinetics, under the stated habituation predicate." ;
    delphi:context "Fails if: The nonlinear motif fails recovery or fails decrement on every open set tried, or a linear system is found that meets the predicate. Either kills the generic-versus-linear claim." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Write the habituation inequalities as a Lean predicate. 2. Define the three-variable negative-feedback system. 3. Prove the predicate on an open parameter set. 4. Prove linear systems of the same shape fail the predicate. 5. Audit axioms." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: ode-simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-16> ;

    rdfs:seeAlso <https://doi.org/10.1016/j.isci.2021.102131> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> a delphi:Concept, schema:Question ;
    rdfs:label "Is memory in gene regulatory network models generic or a biological signature?" .


  <https://doi.org/10.1016/j.isci.2021.102131> dct:title "Gene regulatory networks exhibit several kinds of memory: Quantification of memory in biological and random transcriptional networks" ;
    dct:bibliographicCitation "Biswas et al. 2021, source of the habituation behaviour being formalized, not of the motif proof" .
}

