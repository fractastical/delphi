sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule54-universality--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Collision-circuit synthesis for Rule 54" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule54-universality> ;
    dct:description "Build a complete phase-resolved catalog of Rule 54 gliders and collisions, then use SAT-based spacetime synthesis to implement a universal cyclic tag system. Each gate must restore a common ether phase and tolerate every symbol context; exact traces become Lean certificates." ;

    delphi:proposedTest "A finite library of phase-restoring modules that exactly emulates a known universal cyclic tag system, plus checked traces and a compositional simulation invariant." ;
    delphi:context "Fails if: The exhaustive glider basis lacks either reliable fanout or conditional production under all contexts, closing this glider-circuit architecture within the declared bounds." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Enumerate periodic-domain defects of width at most 60 and classify velocity and phase. 2. Enumerate binary and ternary collisions over all relative phases. 3. Synthesize fanout, delay, annihilation and conditional production modules. 4. Compose modules into tag steps and test at least 100,000 adversarial random steps before Lean certification." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: Failure of one glider architecture would not prove Rule 54 nonuniversal." ;
    skos:note "Tool: cellular-automaton-simulation" ;
    skos:note "Tool: sat-solving" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-21> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-19> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-20> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/rule54-universality> a delphi:Concept, schema:Question ;
    rdfs:label "Is Rule 54 computationally universal?" .



}

