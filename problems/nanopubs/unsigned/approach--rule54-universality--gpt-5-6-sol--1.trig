    prov:wasGeneratedBy sub:proposal .
  sub:proposal a prov:Activity ;
    rdfs:label "Proposing approaches to rule54-universality, blind to other proposers, following problems/approaches/INSTRUCTIONS.md" ;
    prov:wasAssociatedWith <https://w3id.org/delphi/resource/agent/delphisci-approach-proposer-gpt-5-6-sol> ;
    prov:qualifiedAssociation sub:plan .
  sub:plan prov:hadPlan <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/INSTRUCTIONS.md> .
  <https://w3id.org/delphi/resource/agent/delphisci-approach-proposer-gpt-5-6-sol> a prov:SoftwareAgent ;
