sub:assertion {
  <https://w3id.org/delphi/resource/approach/hygromorph-bilayer-scaling--grok-4-7--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Lean bound on curvature error under a modulus perturbation" ;
    dct:subject <https://w3id.org/delphi/resource/problem/hygromorph-bilayer-scaling> ;
    dct:description "The equilibrium theorem already gives κ as a smooth function of the two moduli. Prove a perturbation bound: if both moduli are multiplied by factors within (1 − ε, 1 + ε) with ε < 1/2 and the thicknesses stay positive, the relative change in curvature is at most an explicit f(ε) derived from the formula, not a fitted constant. The bound covers modulus error only. Fibre angle, grading and viscosity are outside it, and the theorem says so. This is the piece of the deviation question that is an inequality rather than a sweep." ;

    delphi:proposedTest "A sorry-free theorem giving an explicit f such that the relative curvature change is ≤ f(ε) whenever both moduli move by at most the factor 1 + ε, ε < 1/2." ;
    delphi:context "Fails if: The bound does not close without assuming the curvature formula rather than the equilibrium hypotheses, or sorry remains. Fibre angle and viscosity are not a failure; they are out of scope and must not be smuggled into the statement." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Treat bilayerCurvature as a function of the two moduli. 2. Differentiate it under the existing positivity hypotheses. 3. Prove a concrete relative-error inequality for ε < 1/2. 4. Compile with no sorry." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch10-01> ;

    rdfs:seeAlso <https://doi.org/10.1364/josa.11.000233> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/hygromorph-bilayer-scaling> a delphi:Concept, schema:Question ;
    rdfs:label "Do real hygromorphs follow bilayer curvature and diffusive response-time scaling?" .


  <https://doi.org/10.1364/josa.11.000233> dct:title "Analysis of Bi-Metal Thermostats" ;
    dct:bibliographicCitation "Timoshenko 1925, Analysis of bi-metal thermostats" .
}

