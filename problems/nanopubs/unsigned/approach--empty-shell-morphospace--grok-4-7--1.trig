sub:assertion {
  <https://w3id.org/delphi/resource/approach/empty-shell-morphospace--grok-4-7--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Prove the planispiral non-intersection boundary" ;
    dct:subject <https://w3id.org/delphi/resource/problem/empty-shell-morphospace> ;
    dct:description "Raup's parameters are whorl expansion W, relative distance D of the generating curve from the coiling axis, and translation T. For the planispiral case T = 0, define the shell as the Thompson logarithmic spiral of expansion W with a circular generating curve of Raup's D. Prove the necessary and sufficient algebraic inequality on W and D such that the generating circle at angle θ does not meet the circle at angle θ minus 2π. The theorem is that inequality, derived inside Lean from the definitions, not copied from a secondary source. State the open solid-of-revolution case T ≠ 0 as out of scope. This is the developmental-constraint boundary the occupancy test will use." ;

    delphi:proposedTest "A no-sorry equivalence between non-intersection of successive planispiral whorls and an explicit inequality in W and D." ;
    delphi:context "Fails if: A numerically non-intersecting (W, D) pair that violates the inequality, or the converse. The statement is then false." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Define W, D and the planispiral logarithmic spiral. 2. Write the two successive generating circles. 3. Prove they are disjoint if and only if the derived inequality holds. 4. Leave T ≠ 0 unformalized and say so. 5. Audit axioms." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: theoretical-morphology" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-09> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-15> ;

    rdfs:seeAlso <https://doi.org/10.1111/brv.12276> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/empty-shell-morphospace> a delphi:Concept, schema:Question ;
    rdfs:label "Why is shell morphospace empty where it is?" .


  <https://doi.org/10.1111/brv.12276> dct:title "The geometry of morphospaces: lessons from the classic\n                    <scp>R</scp>\n                    aup shell coiling model" ;
    dct:bibliographicCitation "Gerber 2017, The geometry of morphospaces, used for the parameter definitions and the occupancy question" .
}

