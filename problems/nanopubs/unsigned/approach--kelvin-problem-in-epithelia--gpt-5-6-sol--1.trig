sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/kelvin-problem-in-epithelia--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Curvature-blinded scutoid frequency test" ;
    dct:subject <https://w3id.org/delphi/resource/problem/kelvin-problem-in-epithelia> ;
    dct:description "Segment at least 30 epithelial volumes spanning curvature and thickness, with at least 200 cells each. Before inspecting topology, predict scutoid frequency from a vertex-model energy minimized at measured curvature, cell-number mismatch and apicobasal tension ratio. Test predictions on held-out tissues and compare to topology-preserving random rearrangements." ;

    delphi:proposedTest "Energy minimization is supported if held-tissue scutoid-frequency error is below 0.1 and at least 50% lower than both baselines, with correct localization in 80% of volumes." ;
    delphi:context "Fails if: Predicted frequency is systematically wrong by more than 0.2 or segmentation uncertainty changes scutoid calls by over 10%." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Validate segmentation topology against manually annotated cells with F1 above 0.95. 2. Freeze energy parameters using flat epithelia only. 3. Predict per-volume scutoid fraction and spatial localization. 4. Compare absolute error and likelihood to random and curvature-only baselines." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Enough open volumetric epithelia with diverse measured curvatures." ;
    skos:note "Tool: morpholib" ;
    skos:note "Tool: 3d-segmentation" ;
    skos:note "Tool: mechanobiology-simulation" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-16> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/kelvin-problem-in-epithelia> a delphi:Concept, schema:Question ;
    rdfs:label "Kelvin's problem in epithelia" .



}

