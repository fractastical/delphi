sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/clade-trajectory-universality--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "PBDB subsampled hat-shape census" ;
    dct:subject <https://w3id.org/delphi/resource/problem/clade-trajectory-universality> ;
    dct:description "Query all PBDB marine orders and families with at least 200 occurrences, 20 genera and 10 occupied time bins. Apply shareholder-quorum subsampling at quorum 0.6, align each clade to fractional lifetime, and quantify hat shape by peak interiority and signed monotonicity before and after the peak. Compare against occurrence-preserving time randomizations." ;
    schema:additionalProperty <https://w3id.org/delphi/resource/approach/clade-trajectory-universality--gpt-5-6-sol--1#n_genera> ;
    delphi:proposedTest "Universality requires more than 75% of eligible clades to be significantly hat-shaped and the lower 95% interval above the 95th null percentile; equivalence to the null refutes it." ;
    delphi:context "Fails if: Results reverse across reasonable quorum values 0.4 to 0.7 or fewer than 50 clades meet inclusion, indicating sampling dependence." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Freeze taxonomy, time scale, quorum and clade thresholds before downloading occurrences. 2. Run 1000 subsampling replicates per clade. 3. Generate 10000 null trajectories preserving duration, total occurrences and bin-level sampling intensity. 4. Control false discovery rate at 0.05 and report the supported fraction with bootstrap intervals." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: pbdb" ;
    skos:note "Tool: paleobiology-statistics" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-07> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-02> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/clade-trajectory-universality> a delphi:Concept, schema:Question ;
    rdfs:label "Are clade diversity trajectories universally hat-shaped?" .
  <https://w3id.org/delphi/resource/approach/clade-trajectory-universality--gpt-5-6-sol--1#n_genera> a schema:PropertyValue ;
    schema:propertyID "n_genera" ;
    schema:value 20 ;
    schema:description "genera the approach proposes to use, as stated in its description (a planned sample size, not a measurement)" .


}

