sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> a delphi:Concept, schema:Question ;
    rdfs:label "Is memory in gene regulatory network models generic or a biological signature?" ;
    dct:description "Do the memory and habituation behaviours found in published ODE models of biological pathways occur at the same rate in random nonlinear ODE networks of matched size, sparsity and kinetics, or are they enriched in biological networks?" ;

    skos:historyNote "Known state: Biswas, Manicka, Hoel and Levin (2021) found several kinds of memory (UCS-based, pairing, associative, consolidation) in 35 BioModels pathway models, and habituation in 27 of them (levin-2022-grn-learning claims, top of the repo's testability ranking). No matched random-network null has been run, so it is unknown whether the result says anything about biology rather than about nonlinear dynamics in general." ;
    dct:subject "both" ;
    delphi:hypothesisType "open-problem/tier-C" ;
    skos:scopeNote "Resolved when: A pre-registered computational test re-running the Biswas protocol on the original 35 models and on at least 350 random networks matched on node count, edge density, kinetic form and parameter ranges; the enrichment statistic and its threshold stated in advance." ;
    skos:scopeNote "Resolved when: Code and seeds published so the result is reproducible." ;
    skos:scopeNote "Refuted if: Memory rates in random networks equal to or above the biological ones refute the biological-signature reading." ;
    skos:note "Data access: BioModels (open), Biswas et al. 2021 code (open access paper)." ;
    skos:note "Requires: ode-simulation" ;
    skos:note "Requires: biomodels" ;
    skos:note "Requires: random-network-nulls" ;
    skos:note "Requires: data-test" ;
    skos:note "Scale: molecular" ;
    skos:note "Scale: cellular" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-16> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.isci.2021.102131> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/problems.json> .

  <https://doi.org/10.1016/j.isci.2021.102131> dct:title "Gene regulatory networks exhibit several kinds of memory: Quantification of memory in biological and random transcriptional networks" ;
    dct:bibliographicCitation "Biswas, Manicka, Hoel and Levin 2021, Gene regulatory networks exhibit several kinds of memory" .
}

