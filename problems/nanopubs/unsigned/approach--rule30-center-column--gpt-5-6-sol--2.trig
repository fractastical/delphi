sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule30-center-column--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Algebraic dependency and entropy bounds" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule30-center-column> ;
    dct:description "Exploit left-permutivity to express center bits as Boolean polynomials of boundary variables, then seek a lemma that any eventual center period imposes repeated polynomial identities of increasing degree. Compute algebraic normal forms to identify a monotone leading monomial and formalize the resulting degree or influence lower bound." ;

    delphi:proposedTest "A Lean theorem proving non-eventual-periodicity, or a new theorem that center-bit algebraic degree or influence grows unboundedly." ;
    delphi:context "Fails if: The proposed distinguished monomial cancels infinitely often or the derivative recurrence admits periodic center sequences, invalidating the invariant." ;
    delphi:hypothesisType "approach/proof" ;
    skos:note "Steps: 1. Compute exact algebraic normal forms for center bits through n = 4096. 2. Conjecture and prove a recurrence for a distinguished monomial or discrete derivative. 3. Show an eventual period would force equality of incompatible derivatives. 4. Formalize the recurrence and contradiction in Lean." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: A currently unknown invariant connecting global left-permutivity to the single seeded center column." ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: symbolic-computation" ;
    skos:note "Tool: cellular-automaton-simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-14> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/rule30-center-column> a delphi:Concept, schema:Question ;
    rdfs:label "The Rule 30 center column" .



}

