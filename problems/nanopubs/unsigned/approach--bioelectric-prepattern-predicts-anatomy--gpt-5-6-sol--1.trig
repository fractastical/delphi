sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/bioelectric-prepattern-predicts-anatomy--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Held-perturbation Vmem phenotype decoder" ;
    dct:subject <https://w3id.org/delphi/resource/problem/bioelectric-prepattern-predicts-anatomy> ;
    dct:description "Digitize raw or supplementary Vmem images with specimen-level anatomical outcomes from one system only. Register maps to a common coordinate frame, train a spatial decoder on controls and selected perturbation classes, and hold out entire intervention mechanisms so the test measures pattern-based transfer rather than batch recognition." ;

    delphi:proposedTest "Predictive mapping requires held-intervention macro-F1 at least 0.75 and at least 0.15 above every baseline, with bootstrap 95% lower bound above 0.6." ;
    delphi:context "Fails if: Performance falls to chance when experiments or intervention mechanisms are held out, indicating batch-specific correlation rather than a transferable code." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Require at least 200 specimens, five perturbations and 30 specimens per held-out class. 2. Freeze normalization, masks and phenotype labels before model training. 3. Compare Vmem decoder with morphology-at-imaging-time, batch and permuted-map baselines. 4. Use nested cross-validation grouped by experiment and intervention." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Specimen-linked raw Vmem maps and later phenotype labels may not be publicly available at adequate sample size." ;
    skos:note "Tool: image-analysis" ;
    skos:note "Tool: data-test" ;
    skos:note "Tool: bioelectric-simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-girardia-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-16> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2019-boundary-14> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/bioelectric-prepattern-predicts-anatomy> a delphi:Concept, schema:Question ;
    rdfs:label "Does the bioelectric prepattern predict anatomical outcome?" .



}

