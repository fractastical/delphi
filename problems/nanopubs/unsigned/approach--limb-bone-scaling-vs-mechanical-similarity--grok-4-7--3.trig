sub:assertion {
  <https://w3id.org/delphi/resource/approach/limb-bone-scaling-vs-mechanical-similarity--grok-4-7--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Does the area-mass exponent differ by lifestyle?" ;
    dct:subject <https://w3id.org/delphi/resource/problem/limb-bone-scaling-vs-mechanical-similarity> ;
    dct:description "The problem asks whether the exponent depends on posture. These tables do not contain effective mechanical advantage. Amson and Bibi do code lifestyle (aerial, terrestrial, aquatic, subterranean) and deposit a timetree. Fit log(MeanArea) = α_L + β_L log(mass) by PGLS inside each lifestyle with at least 20 species, using their tree. Posture dependence, in this proxy, is supported if at least one pair of lifestyles has slope estimates differing by more than 0.08 (the gap between 2/3 and 3/4) and non-overlapping 95 percent intervals. Lifestyle is not joint posture, and the write-up says so. This does not test safety-factor flatness." ;
    schema:additionalProperty <https://w3id.org/delphi/resource/approach/limb-bone-scaling-vs-mechanical-similarity--grok-4-7--3#n_species> ;
    delphi:proposedTest "Four lifestyle slopes with intervals. Dependence is accepted only if some pair differs by more than 0.08 with disjoint intervals. Otherwise the deposited lifestyle codes do not identify a different similarity law." ;
    delphi:context "Fails if: Every lifestyle with at least 20 species has an interval that overlaps all three of 2/3, 3/4 and 1, or a lifestyle class falls under 20 species so the comparison cannot be made." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Pre-register the 0.08 gap and the minimum of 20 species before fitting. 2. Split the humerus table by the deposited lifestyle codes. 3. Fit one PGLS slope per lifestyle on the deposited timetree. 4. Compare intervals pairwise. 5. State that the covariate is lifestyle, not effective mechanical advantage." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: Effective mechanical advantage and in vivo strain are not in this file, so the safety-factor claim stays open." ;
    skos:note "Tool: python" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch02-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-04> ;
    rdfs:seeAlso <https://doi.org/10.6084/m9.figshare.12600440.v3> ;
    rdfs:seeAlso <https://doi.org/10.1186/s12915-021-01016-1> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/limb-bone-scaling-vs-mechanical-similarity> a delphi:Concept, schema:Question ;
    rdfs:label "How do limb bones actually scale with body mass?" .
  <https://w3id.org/delphi/resource/approach/limb-bone-scaling-vs-mechanical-similarity--grok-4-7--3#n_species> a schema:PropertyValue ;
    schema:propertyID "n_species" ;
    schema:value 20 ;
    schema:description "species named in the text (a sample size as stated there, not a measurement made here)" .
  <https://doi.org/10.6084/m9.figshare.12600440.v3> dct:title "Amson and Bibi 2021 humeral structure and timetree" ;
    dct:description "Lifestyle codes and AlteredTimetree.nex are in the deposit. Body mass and MeanArea are the regression pair." .
  <https://doi.org/10.1186/s12915-021-01016-1> dct:title "Differing effects of size and lifestyle on bone structure in mammals" ;
    dct:bibliographicCitation "Amson and Bibi 2021, Differing effects of size and lifestyle on bone structure in mammals" .
}

