sub:assertion {
  <https://w3id.org/delphi/resource/approach/active-inference-morphogenesis-falsifiable--grok-4-7--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Fix the generative model, then rank regeneration times" ;
    dct:subject <https://w3id.org/delphi/resource/problem/active-inference-morphogenesis-falsifiable> ;
    dct:description "Before opening a regeneration time course, fix the generative model to the shared target morphology used by Friston, Levin, Sengupta and Pezzulo 2015, with no free retargeting. Define the surprise of a cut as the variational free energy of that initial condition under the fixed target. The prediction is ordinal: among fragment classes of one species in one paper, the ordering of free energies must match the ordering of regeneration times, with Spearman rank correlation above 0.5. Planarian fragment series are the admissible data, and only series that report times for at least four fragment classes. Parameters of the target are taken from the 2015 paper, not from the time series. Fewer than four classes, or times that exist only as unlabeled cartoons, makes the test inconclusive." ;

    delphi:proposedTest "Spearman correlation above 0.5 between pre-registered free-energy rank and regeneration-time rank, on at least four fragment classes." ;
    delphi:context "Fails if: Correlation at most 0.5. Changing the target after seeing the times fails the approach and is the unfalsifiability pattern the problem names." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Transcribe the 2015 target morphology and freeze it. 2. Define free energy of a cut under that target. 3. List fragment classes and published times from one admissible series. 4. Compute Spearman correlation between free-energy rank and time rank. 5. Refute the fixed model if the correlation is at most 0.5." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Quantitative regeneration times for four or more fragment classes in one paper. If the papers only show cartoons, the test is inconclusive." ;
    skos:note "Tool: variational-inference" ;
    skos:note "Tool: developmental-biology" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-place-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-place-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2019-boundary-15> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-girardia-20> ;

    rdfs:seeAlso <https://doi.org/10.1098/rsif.2014.1383> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.plrev.2019.06.001> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/active-inference-morphogenesis-falsifiable> a delphi:Concept, schema:Question ;
    rdfs:label "A falsifiable form of active-inference morphogenesis" .


  <https://doi.org/10.1098/rsif.2014.1383> dct:title "Knowing one's place: a free-energy approach to pattern regulation" ;
    dct:bibliographicCitation "Friston, Levin, Sengupta and Pezzulo 2015, Knowing one's place" .
  <https://doi.org/10.1016/j.plrev.2019.06.001> dct:title "Morphogenesis as Bayesian inference: A variational approach to pattern formation and control in complex biological systems" ;
    dct:bibliographicCitation "Kuchling, Friston, Georgiev and Levin 2020, Morphogenesis as Bayesian inference" .
}

