sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/problem/lewontins-paradox-of-variation> a delphi:Concept, schema:Question ;
    rdfs:label "Lewontin's paradox of variation" ;
    dct:description "Why does nucleotide diversity scale so weakly with census population size across species, and can linked selection plus demographic history account quantitatively for the gap predicted by neutral theory?" ;

    skos:historyNote "Known state: Kimura's neutral theory predicts heterozygosity proportional to 4Nu; observed diversity spans about three orders of magnitude while census sizes span more than twelve (Lewontin 1974). Leffler et al. (2012) compiled diversity across 167 species; Corbett-Detig et al. (2015) argued linked selection explains part of it; Buffalo (2021) estimated the diversity-census slope with phylogenetic correction and found linked selection insufficient. The quantitative residual is unexplained." ;
    dct:subject "biology" ;
    delphi:hypothesisType "open-problem/tier-B" ;
    skos:scopeNote "Resolved when: A pre-registered test combining a current polymorphism compilation with census-size and range-size estimates (GBIF occurrence extents from the organisms layer) and recombination-rate or genome-size covariates, with explicit quantitative predictions from each hypothesis (neutral, linked selection, boom-bust demography) stated before analysis." ;
    skos:scopeNote "Resolved when: A verdict on whether linked selection models fitted to measured recombination landscapes close the gap." ;
    skos:scopeNote "Refuted if: If linked-selection models with measured parameters predict the observed slope, the paradox is resolved; if the residual stays at orders of magnitude, demographic explanations are required." ;
    skos:note "Data access: Leffler 2012 and Buffalo 2021 supplementary tables (open); GBIF via the organisms layer; recombination maps per species where published." ;
    skos:note "Requires: population-genetics" ;
    skos:note "Requires: phylogenetic-comparative-methods" ;
    skos:note "Requires: gbif" ;
    skos:note "Requires: data-test" ;
    skos:note "Scale: evolutionary" ;
    skos:note "Scale: ecological" ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-heterozygosity> ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-neutral-theory> ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-substitution-rate> ;
    rdfs:seeAlso <https://doi.org/10.1038/217624a0> ;
    rdfs:seeAlso <https://doi.org/10.1371/journal.pbio.1001388> ;
    rdfs:seeAlso <https://doi.org/10.1371/journal.pbio.1002112> ;
    rdfs:seeAlso <https://doi.org/10.7554/eLife.67509> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/problems.json> .

  <https://doi.org/10.1038/217624a0> dct:title "Evolutionary Rate at the Molecular Level" ;
    dct:bibliographicCitation "Kimura 1968, Evolutionary rate at the molecular level" .
  <https://doi.org/10.1371/journal.pbio.1001388> dct:title "Revisiting an Old Riddle: What Determines Genetic Diversity Levels within Species?" ;
    dct:bibliographicCitation "Leffler et al. 2012, Revisiting an old riddle: what determines genetic diversity levels within species?" .
  <https://doi.org/10.1371/journal.pbio.1002112> dct:title "Natural Selection Constrains Neutral Diversity across A Wide Range of Species" ;
    dct:bibliographicCitation "Corbett-Detig, Hartl and Sackton 2015, Natural selection constrains neutral diversity across a wide range of species" .
  <https://doi.org/10.7554/eLife.67509> dct:title "Quantifying the relationship between genetic diversity and population size suggests natural selection cannot explain Lewontin’s Paradox" ;
    dct:bibliographicCitation "Buffalo 2021, Quantifying the relationship between genetic diversity and population size suggests natural selection cannot explain Lewontin's paradox" .
}

