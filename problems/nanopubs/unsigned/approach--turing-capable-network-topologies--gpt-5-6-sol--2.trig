sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/turing-capable-network-topologies--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Asymptotic capability fraction for random sign graphs" ;
    dct:subject <https://w3id.org/delphi/resource/problem/turing-capable-network-topologies> ;
    dct:description "Define an explicit random topology ensemble with independent directed edges, signs and m diffusers. For n = 3 through 8, estimate existence of Turing parameters by global optimization followed by interval verification, stratified by feedback-cycle signatures. Fit finite-size scaling and seek constructive sufficient conditions based on an embedded capable motif plus weak couplings." ;

    delphi:proposedTest "A verified lower bound on the capable fraction with 99% binomial intervals and a theorem showing a stated motif family remains capable for all n." ;
    delphi:context "Fails if: Capability fraction remains bounded away from one after conditioning on feedback, or supposed motif extensions lose instability under every admissible coupling." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Pre-register graph ensemble, parameter box and interval verification criterion. 2. Enumerate n <= 5 exactly and sample at least 100000 graphs for each larger n and m. 3. Verify candidate instabilities with interval eigenvalue bounds. 4. Prove an embedding lemma that preserves instability under sufficiently small added couplings." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Sampling cannot by itself settle the almost-all conjecture." ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: interval-arithmetic" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-ddi> ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-wavelength> ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-morphogen-hypothesis> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/turing-capable-network-topologies> a delphi:Concept, schema:Question ;
    rdfs:label "Classify the network topologies that admit diffusion-driven instability" .



}

