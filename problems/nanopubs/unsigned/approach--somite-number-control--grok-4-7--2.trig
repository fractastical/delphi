    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/somite-number-control--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Rank unmeasured species by expected variance reduction" ;
    dct:subject <https://w3id.org/delphi/resource/problem/somite-number-control> ;
    dct:description "The second acceptance criterion is a ranked list of species whose clock measurement would most reduce uncertainty. Use FishBase vertebral counts as the response and the Open Tree vertebrate subtree as the covariance. The model is N = α T / τ with log α a phylogenetic Gaussian process. Species that already have a clock measurement anchor the process. For every FishBase species without a clock measurement, compute the expected reduction in posterior variance of α from observing its clock period, using the current phylogenetic covariance. Rank by that reduction. Extremes that are phylogenetically redundant with zebrafish, chick, mouse or snake should rank low. The list is the result; it does not test the mechanism." ;

    delphi:proposedTest "A ranked list of unmeasured species with the expected reduction in variance of the clock-and-wavefront coefficient." ;
    delphi:context "Fails if: The ranking is unchanged if phylogenetic covariance is replaced by a star phylogeny, in which case the list is only a ranking by vertebral-count extremity and does not use the tree. Report that degeneration rather than hiding it." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Assemble FishBase vertebral counts and the Open Tree distances. 2. Anchor the phylogenetic regression at species with published clock data. 3. Compute expected variance reduction for each unmeasured species. 4. Publish the ranked list with the variance reductions. 5. Note species that cannot be ranked because they are absent from the tree." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: FishBase does not cover tetrapods. Tetrapod counts enter only from literature sources named in the result, and species without a count are omitted." ;
    skos:note "Tool: comparative-data" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch17-04> ;
    rdfs:seeAlso <https://www.fishbase.se/> ;
    skos:note "Dataset (no resolvable link): Open Tree of Life. Vertebrate subtree supplying phylogenetic covariance." ;
    rdfs:seeAlso <https://doi.org/10.1038/nature07020> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/somite-number-control> a delphi:Concept, schema:Question ;
    rdfs:label "What sets vertebrate somite number?" .

  <https://www.fishbase.se/> dct:title "FishBase" ;
    dct:description "Vertebral counts used as the response for the value-of-information ranking." .
  <https://doi.org/10.1038/nature07020> dct:title "Control of segment number in vertebrate embryos" ;
    dct:bibliographicCitation "Gomez et al. 2008, the measured species that anchor the ranking" .
}

