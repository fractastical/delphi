sub:assertion {
  <https://w3id.org/delphi/resource/approach/biomineral-form-physical-vs-biological-control--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Twelve pentagons are a topological count" ;
    dct:subject <https://w3id.org/delphi/resource/problem/biomineral-form-physical-vs-biological-control> ;
    dct:description "A spherical lattice of hexagons and pentagons with three edges at every vertex has exactly twelve pentagons, by Euler's formula. Prove it in Lean from the handshaking hypotheses the statement names: V − E + F = 2, 2E = 3V, and 2E = 5P + 6H with F = P + H, hence P = 12. The count does not depend on a material parameter. That is the mineral-independence of this one integer, for thompson1917-ch09-15, and it does not say the angles are 120 degrees. Applicability is an empirical gate owned by the image test: if more than 20 percent of segmented vertices have degree other than 3, the hypothesis is not the biological case. The proof itself does not wait on that count." ;

    delphi:proposedTest "A sorry-free proof that any such lattice has exactly twelve pentagons, independent of material." ;
    delphi:context "Fails if: The counting argument needs a graph library the development does not have and sorry remains, or the hypotheses cannot be stated without assuming the conclusion." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. State the handshaking hypotheses. 2. Prove P = 12. 3. Prove the count is unchanged if a material parameter is added to the context and never used. 4. Compile with no sorry." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-07> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-15> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/biomineral-form-physical-vs-biological-control> a delphi:Concept, schema:Question ;
    rdfs:label "How much of biomineral form is physical, and how much is cell-controlled?" .



}

