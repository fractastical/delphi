}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/biocomposite-toughness-from-hierarchy--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Measurement-aware leave-family-out toughness meta-analysis" ;
    dct:subject <https://w3id.org/delphi/resource/problem/biocomposite-toughness-from-hierarchy> ;
    dct:description "Build a provenance-locked table of at least 40 records from nacre, cortical bone, dentin, antler and one additional mineralized composite. Record crack orientation, specimen dimensions, toughness protocol, hydration, mineral fraction, constituent moduli and strengths, platelet or fibril aspect ratio, interface compliance and a rule-based count of hierarchical levels. Fit a constituent-only mixing-law baseline and a hierarchical model with protocol-specific measurement error; test architecture by leave-one-family-out prediction rather than in-sample significance." ;

    delphi:proposedTest "Architecture explains a dataset-wide effect if the descriptor model reduces held-out log-toughness RMSE by at least 20% versus the constituent-only model in at least four of five held-out families; compounding requires a positive hierarchy-count coefficient whose 95% interval excludes zero after all controls." ;
    delphi:context "Fails if: Fewer than 40 commensurable records, no held-out RMSE gain, or a hierarchy-count interval containing zero defeats the corresponding claim." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Publish an extraction codebook and dual-extract a 20% paper sample before resolving disagreements. 2. Convert toughness measures only where standards make them commensurable; otherwise model protocol strata separately. 3. Fit constituent-only, descriptor and hierarchy-count models with family-level random effects. 4. Run leave-one-family-out prediction and a monotonicity test for hierarchy count." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: The records are scattered and fracture-toughness protocols are heterogeneous; enough commensurable open records may not survive the exclusion rules." ;
    skos:note "Tool: literature-extraction" ;
    skos:note "Tool: bayesian-meta-analysis" ;
    skos:note "Tool: leave-one-family-out-validation" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-02> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-16> ;
    skos:note "Dataset (no resolvable link): Published biocomposite property records. Paper tables and supplements, retained only with specimen, hydration and fracture-protocol provenance." ;
    rdfs:seeAlso <https://doi.org/10.1038/nmat4089> ;
    rdfs:seeAlso <https://doi.org/10.1038/natrevmats.2016.7> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/biocomposite-toughness-from-hierarchy> a delphi:Concept, schema:Question ;
    rdfs:label "Does hierarchy itself explain the toughness of biological composites?" .


  <https://doi.org/10.1038/nmat4089> dct:title "Bioinspired structural materials" ;
    dct:bibliographicCitation "Wegst et al. 2015, Bioinspired structural materials" .
  <https://doi.org/10.1038/natrevmats.2016.7> dct:title "Structure and mechanics of interfaces in biological materials" ;
    dct:bibliographicCitation "Barthelat et al. 2016, Structure and mechanics of interfaces in biological materials" .
}

