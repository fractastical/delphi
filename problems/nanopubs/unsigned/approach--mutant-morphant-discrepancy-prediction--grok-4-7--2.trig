sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/mutant-morphant-discrepancy-prediction--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Family-held-out logistic model with an INDRA ablation" ;
    dct:subject <https://w3id.org/delphi/resource/problem/mutant-morphant-discrepancy-prediction> ;
    dct:description "Same labels and the same paralogue-family holdout. Fit an L2-regularized logistic regression. Feature block S: the NMD indicator, maximum paralogue identity, and paralogue count from Ensembl. Feature block I: INDRA degree and the presence of an INDRA edge to a paralogue. The full model uses both. Predictability is an area under the ROC curve above 0.70 on held-out families. The sequence block is the carrier if it beats the INDRA-only model by a DeLong test at p below 0.01 and the INDRA-only model does not itself clear 0.70. Nested cross-validation inside the training families chooses the L2 penalty. Do not use a random gene split, which leaks paralogues." ;

    delphi:proposedTest "Held-out AUROC above 0.70 for the sequence block, and a DeLong p-value below 0.01 against the INDRA-only block if that comparison is needed to assign the signal." ;
    delphi:context "Fails if: Held-out AUROC at or below 0.70 for every block. Present features then do not predict discrepancy. An AUROC that collapses when families are held out after looking strong on a random split is leakage, not a result." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Reuse the ZFIN labels and the family partition. 2. Build sequence features and INDRA features. 3. Choose the L2 penalty inside training families only. 4. Score held-out AUROC for the full model, block S and block I. 5. DeLong-test block S against block I." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: zfin" ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: machine-learning" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch05-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;
    rdfs:seeAlso <https://zfin.org/downloads> ;
    rdfs:seeAlso <https://www.ensembl.org/> ;
    rdfs:seeAlso <https://discovery.indra.bio/> ;
    rdfs:seeAlso <https://doi.org/10.1038/s41586-019-1064-z> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.devcel.2014.11.018> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/mutant-morphant-discrepancy-prediction> a delphi:Concept, schema:Question ;
    rdfs:label "Predict which genes show mutant-morphant discrepancies" .

  <https://zfin.org/downloads> dct:title "ZFIN downloads" ;
    dct:description "Labels from Morpholinos.txt, CRISPR.txt and phenoGeneCleanData_fish.txt." .
  <https://www.ensembl.org/> dct:title "Ensembl" ;
    dct:description "Paralogue and exon features." .
  <https://discovery.indra.bio/> dct:title "INDRA CoGEx" ;
    dct:description "Degree and paralogue-edge features for the ablation." .
  <https://doi.org/10.1038/s41586-019-1064-z> dct:title "Genetic compensation triggered by mutant mRNA degradation" ;
    dct:bibliographicCitation "El-Brolosy et al. 2019, the sequence mechanism the sequence block encodes" .
  <https://doi.org/10.1016/j.devcel.2014.11.018> dct:title "Reverse Genetic Screening Reveals Poor Correlation between Morpholino-Induced and Mutant Phenotypes in Zebrafish" ;
    dct:bibliographicCitation "Kok et al. 2015, the phenotype discrepancy being predicted" .
}

