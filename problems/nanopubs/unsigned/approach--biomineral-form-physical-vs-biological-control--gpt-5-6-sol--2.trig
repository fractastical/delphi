sub:assertion {
  <https://w3id.org/delphi/resource/approach/biomineral-form-physical-vs-biological-control--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Morphology fingerprints of templating versus self-organization" ;
    dct:subject <https://w3id.org/delphi/resource/problem/biomineral-form-physical-vs-biological-control> ;
    dct:description "Generate preregistered morphology fingerprints for three mechanisms on a curved surface: equal-area vesicle packing with deposition in interfaces, Cahn-Hilliard phase separation with mineral precipitation, and an explicit cell-template field with controlled spatial correlations. Match only area fraction and mean spacing, then compare higher-order observables that were not fitted: defect charge versus curvature, three-point correlations, edge-width distribution and concentric-layer registration. Apply the frozen classifier to the image set from the geometry test." ;

    delphi:proposedTest "A bounded mechanism is distinguished if synthetic held-out accuracy exceeds 90% and at least 70% of biological images receive posterior probability above 0.8 for one class; otherwise the tested morphology is non-identifying." ;
    delphi:context "Fails if: Synthetic mechanisms overlap after matching area fraction and spacing, classifier calibration fails, or biological images mostly trigger abstention, showing geometry alone cannot separate control modes." ;
    delphi:hypothesisType "approach/simulation" ;
    skos:note "Steps: 1. Implement and convergence-test all three mechanism classes on identical spherical meshes. 2. Generate a balanced simulation library over nuisance parameters. 3. Train a classifier on simulations using only preregistered higher-order observables. 4. Run simulation-based calibration and then classify biological images with an abstention threshold." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: This can reject morphological sufficiency but cannot prove cellular control without developmental imaging or perturbation data." ;
    skos:note "Tool: phase-field-simulation" ;
    skos:note "Tool: curved-surface-meshing" ;
    skos:note "Tool: simulation-based-inference" ;
    skos:note "Tool: morpholib" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-07> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-15> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/biomineral-form-physical-vs-biological-control> a delphi:Concept, schema:Question ;
    rdfs:label "How much of biomineral form is physical, and how much is cell-controlled?" .



}

