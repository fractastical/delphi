sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/active-inference-morphogenesis-falsifiable--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Identifiability and universal-fit stress test" ;
    dct:subject <https://w3id.org/delphi/resource/problem/active-inference-morphogenesis-falsifiable> ;
    dct:description "Test falsifiability directly. Generate synthetic morphogenetic trajectories from reaction-diffusion, mechanical relaxation and random state-space models, then fit the same bounded active-inference model class without changing its latent dimension or priors. Estimate how often it fits non-active-inference processes as well as genuine ones." ;

    delphi:proposedTest "The framework is discriminative only if power and specificity both exceed 0.8 on held-out trajectories; specificity below 0.6 shows the tested formulation can absorb unrelated dynamics." ;
    delphi:context "Fails if: Equivalent predictive scores occur across all generators or posterior parameters are nonidentifiable, making empirical attribution unsupported." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Predefine model class, parameter bounds and predictive scoring rule. 2. Generate 1000 datasets per mechanism over matched noise and sample sizes. 3. Fit blindly and perform simulation-based calibration. 4. Compute specificity, power and parameter identifiability for labeling active inference." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: variational-inference" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-place-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-place-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2019-boundary-15> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-girardia-20> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/active-inference-morphogenesis-falsifiable> a delphi:Concept, schema:Question ;
    rdfs:label "A falsifiable form of active-inference morphogenesis" .



}

