    delphi:usesModel <https://w3id.org/delphi/resource/model/gpt-5-6-sol> ;
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
  <https://w3id.org/delphi/resource/model/gpt-5-6-sol> a delphi:LanguageModel ;
    rdfs:label "gpt-5-6-sol" ;
    dct:identifier "gpt-5-6-sol" .
}

