sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/morphogenesis-cognition-gene-overlap--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Mechanistic-pathway convergence in INDRA" ;
    dct:subject <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> ;
    dct:description "Move beyond gene lists by constructing evidence-weighted INDRA subnetworks connecting curated morphogenesis phenotypes and learning phenotypes. Compare shared causal intermediates and signed paths to degree-preserving, evidence-count-matched network rewires; require statement-level provenance and hold out papers mentioning both domains." ;

    delphi:proposedTest "Mechanistic convergence requires at least twofold excess shared intermediates with empirical P below 0.001 and replication after removing all ion-channel genes; null-level paths refute broad convergence." ;
    delphi:context "Fails if: The result is driven by fewer than five hubs or by statements from cross-domain review papers." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Ground phenotype-associated genes and retain statements with primary evidence. 2. Remove cross-domain papers to prevent literature leakage. 3. Compute shared intermediates, signed-path enrichment and pathway conductance. 4. Run 10000 constrained rewires preserving node degree and statement evidence bins." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: INDRA literature coverage and causal direction are uneven across developmental systems." ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: network-statistics" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> a delphi:Concept, schema:Question ;
    rdfs:label "Do morphogenesis and learning share a gene set beyond pleiotropy?" .



}

