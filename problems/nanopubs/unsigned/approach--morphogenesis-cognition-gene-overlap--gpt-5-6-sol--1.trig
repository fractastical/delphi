sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/morphogenesis-cognition-gene-overlap--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Degree-matched ontology overlap test" ;
    dct:subject <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> ;
    dct:description "Freeze GO terms for morphogenesis and learning or memory, propagate annotations under a declared relation set, and restrict to experimentally supported human and mouse genes. Test overlap against 100000 permutations matched jointly on total annotation count, publication count, protein-interaction degree and gene length; repeat after removing generic signaling and housekeeping terms." ;

    delphi:proposedTest "Wide overlap requires odds ratio at least 2, empirical P below 0.001 and replication in both human and mouse after generic-term removal; an odds ratio between 0.8 and 1.25 supports no enrichment." ;
    delphi:context "Fails if: Balance diagnostics retain standardized covariate differences above 0.1 or enrichment disappears under leave-one-ontology-term-out analysis." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Timestamp ontology and evidence-code filters before retrieving genes. 2. Fit propensity scores for membership in each gene set from bias covariates. 3. Compute matched-null overlap z score, odds ratio and semantic-specificity-weighted overlap. 4. Repeat for ion-channel and gap-junction genes and across species." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: gene-ontology" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> a delphi:Concept, schema:Question ;
    rdfs:label "Do morphogenesis and learning share a gene set beyond pleiotropy?" .



}

