sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule54-universality--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Prove a defect invariant that blocks unbounded memory" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule54-universality> ;
    dct:description "Attempt a negative theorem that applies to every finite perturbation of the ether, not only to the 2006 gliders. Rule 54's ether is periodic. Treat gliders as defects. Search for a conserved quantity taking values in a finite monoid: a sum of local window weights modulo m, or a pairing between left-going and right-going defects, that every space-time diagram must preserve. The universality-refuting conclusion is that the set of defects reachable from a finite perturbation is a regular language, so the diagram cannot encode an arbitrary binary work string. The conservation law has to be proved from the 8-bit table for every configuration, then specialized to finite ether perturbations. Compatibility of the invariant with a glider that stores an arbitrary string is an immediate failure of this route." ;

    delphi:proposedTest "A proof that every finite perturbation of the Rule 54 ether has space-time defect language regular, hence cannot emulate a cyclic tag system on all inputs." ;
    delphi:context "Fails if: The invariant, if it exists, still permits a defect whose internal tape is an arbitrary finite word. The route has then failed even if the invariant is true." ;
    delphi:hypothesisType "approach/proof" ;
    skos:note "Steps: 1. Define the ether and the defect of a finite window relative to it. 2. Enumerate small modular weightings and test them against the 8-bit table. 3. Prove any surviving weighting is invariant for every configuration. 4. Prove that finite perturbations stay inside a regular defect language. 5. Conclude that no such perturbation simulates a cyclic tag system on arbitrary inputs." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: No published conservation law of this strength. The swarm lacks a theorem, not a dataset." ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: cellular-automaton-simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-21> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-19> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-20> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/rule54-universality> a delphi:Concept, schema:Question ;
    rdfs:label "Is Rule 54 computationally universal?" .



}

