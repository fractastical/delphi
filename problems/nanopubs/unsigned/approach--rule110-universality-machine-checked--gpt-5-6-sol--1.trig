sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule110-universality-machine-checked--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Refinement proof from cyclic tag systems to Rule 110" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule110-universality-machine-checked> ;
    dct:description "Define finite Rule 110 windows with a periodic ether outside, cyclic tag systems, and a decoding relation in Lean 4. Prove a one-step simulation theorem by decomposing each compiled tag step into a finite sequence of glider phases; discharge each collision lemma with a kernel-evaluated finite trace and compose them by induction on tag-system runs." ;

    delphi:proposedTest "A compiling Lean module whose theorem maps every finite cyclic-tag execution of length k to a Rule 110 execution decoding the same k transitions, with all collision and ether lemmas proved and only standard axioms." ;
    delphi:context "Fails if: A required compiler collision has no finite spacetime trace with Cook's advertised phase and separation constraints, or collision lemmas cannot be composed because debris enters another light cone." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Formalize Rule 110 evolution on integers and prove locality and light-cone lemmas. 2. Encode Cook's ether phases, gliders and compiler from cyclic tag words. 3. Generate every required collision trace and prove its decoded precondition and postcondition by decide. 4. Prove phase synchronization, noninterference and the global simulation theorem without sorry." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: A machine-readable transcription of Cook's complete glider phase table and substantial Lean proof engineering." ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: cellular-automaton-simulation" ;
    skos:note "Tool: large-scale-computation" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-07> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/rule110-universality-machine-checked> a delphi:Concept, schema:Question ;
    rdfs:label "Machine-check the universality of Rule 110" .



}

