    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/smallest-universal-turing-machine-2-3--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Decidability via bounded crossing sequences" ;
    dct:subject <https://w3id.org/delphi/resource/problem/smallest-universal-turing-machine-2-3> ;
    dct:description "Seek a negative result for eventually periodic tapes. Define crossing sequences at cell boundaries and prove that the 2-state control plus periodic tails forces either bounded crossing complexity or a pumpable translation cycle. A finite quotient of boundary state, tape color and tail phase would then decide halting and exclude conventional universality." ;

    delphi:proposedTest "A Lean theorem that every eventually periodic input either enters a computably detected cycle or halts, with an explicit computable bound from the finite defect and periods." ;
    delphi:context "Fails if: A generated family has unbounded nonrepeating crossing sequences or simulates an unbounded counter, directly refuting the proposed bounded-crossing lemma." ;
    delphi:hypothesisType "approach/proof" ;
    skos:note "Steps: 1. Enumerate local boundary-return types for each left and right tail period up to symbolic period p. 2. Conjecture a monotone measure or pumping lemma from exhaustive runs up to 10^9 steps. 3. Formalize crossing sequences and the tail-phase quotient in Lean. 4. Derive a halting decider if the bounded-crossing lemma is proved." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: A viable global invariant; finite experiments cannot establish decidability." ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: turing-machine-enumeration" ;
    skos:note "Tool: computability-theory" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-28> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-23> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/smallest-universal-turing-machine-2-3> a delphi:Concept, schema:Question ;
    rdfs:label "Settle whether the (2,3) Turing machine is universal under a conventional definition" .



}

