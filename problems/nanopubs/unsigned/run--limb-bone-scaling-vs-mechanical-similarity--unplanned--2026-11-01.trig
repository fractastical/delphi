sub:assertion {
  <https://w3id.org/delphi/resource/run/limb-bone-scaling-vs-mechanical-similarity--unplanned--2026-11-01> a prov:Activity ;
    rdfs:label "Run of an unplanned test on limb-bone-scaling-vs-mechanical-similarity (2026-11-01): completed, did not settle its target" ;
    dct:description "Claim-level PGLS of humeral cross-sectional area on body mass for 84 terrestrial mammals (Amson and Bibi 2021 deposit, their timetree, Pagel's lambda by ML = 0): b = 0.709, 95% CI 0.673 to 0.746, entirely above the geometric 2/3, so the claim is supported (0.6). The interval excludes all three similarity exponents (2/3, 3/4, 1), which is the problem's live question, but this run followed its own pre-registration, not any proposed approach: one table, no circumference data, no clade fits, no 300-taxon count. It is a data point for the problem, not a run of grok-4-7 n=1 or claude-opus-5-5 n=1." ;

    dct:subject <https://w3id.org/delphi/resource/problem/limb-bone-scaling-vs-mechanical-similarity> ;
    prov:startedAtTime "2026-11-01"^^xsd:date ;
    prov:endedAtTime "2026-11-01"^^xsd:date ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty <https://w3id.org/delphi/resource/run/limb-bone-scaling-vs-mechanical-similarity--unplanned--2026-11-01#settled>, <https://w3id.org/delphi/resource/run/limb-bone-scaling-vs-mechanical-similarity--unplanned--2026-11-01#solves_problem> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch02-03> ;
    prov:generated <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/test-data/claim-tests/thompson-growth-form/thompson1917-ch02-03/limb-bone-pgls-01/result.json>, <https://w3id.org/delphi/resource/assessment/thompson1917-ch02-03--claim-test--limb-bone-pgls-01> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/runs.json> .
  <https://w3id.org/delphi/resource/problem/limb-bone-scaling-vs-mechanical-similarity> a delphi:Concept, schema:Question ;
    rdfs:label "How do limb bones actually scale with body mass?" .
  <https://w3id.org/delphi/resource/run/limb-bone-scaling-vs-mechanical-similarity--unplanned--2026-11-01#settled> a schema:PropertyValue ;
    schema:propertyID "settled" ;
    schema:value false ;
    schema:description "Whether the run settled the piece of the problem its approach names (forecasts/INSTRUCTIONS.md)" .
  <https://w3id.org/delphi/resource/run/limb-bone-scaling-vs-mechanical-similarity--unplanned--2026-11-01#solves_problem> a schema:PropertyValue ;
