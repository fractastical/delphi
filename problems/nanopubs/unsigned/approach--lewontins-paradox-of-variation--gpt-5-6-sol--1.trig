sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/lewontins-paradox-of-variation--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Phylogenetic decomposition of diversity constraints" ;
    dct:subject <https://w3id.org/delphi/resource/problem/lewontins-paradox-of-variation> ;
    dct:description "Pre-register a phylogenetic hierarchical model for autosomal synonymous diversity across at least 150 animal species. Predict log diversity from log census proxy, recombination-map length, functional genomic density, body size, range area from GBIF, and generation time, with clade random slopes and measurement error. Compare neutral, linked-selection and boom-bust models by leave-one-clade-out expected log predictive density." ;

    delphi:proposedTest "Linked selection closes the gap only if its model improves leave-one-clade-out ELPD by at least 10 and leaves an absolute census-diversity slope residual below 0.05; otherwise the residual is quantitatively unresolved." ;
    delphi:context "Fails if: Fewer than 30 independent recombination landscapes or posterior predictions dominated by range-size measurement error make the mechanism comparison underpowered." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Freeze taxon inclusion, one diversity estimate per species and GBIF coverage rules before fitting. 2. Require at least 30 species with measured recombination maps and 150 total with range proxies. 3. Fit matched neutral, background-selection and recurrent-sweep models with a fixed phylogeny. 4. Report slope residuals, variance explained and held-out calibration." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Comparable recombination maps and defensible census sizes are sparse outside model organisms." ;
    skos:note "Tool: gbif" ;
    skos:note "Tool: phylogenetic-comparative-methods" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-heterozygosity> ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-neutral-theory> ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-substitution-rate> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/lewontins-paradox-of-variation> a delphi:Concept, schema:Question ;
    rdfs:label "Lewontin's paradox of variation" .



}

