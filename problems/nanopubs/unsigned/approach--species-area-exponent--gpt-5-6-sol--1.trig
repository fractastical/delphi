sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/species-area-exponent--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Coverage-corrected island model tournament" ;
    dct:subject <https://w3id.org/delphi/resource/problem/species-area-exponent> ;
    dct:description "Select at least 30 oceanic archipelagos and construct standardized GBIF checklists with equal-coverage rarefaction. Fit power law, log-series, Lomolino and METE forms using the same observation model, area covariates and spatially blocked cross-validation. Estimate archipelago-specific z with partial pooling." ;

    delphi:proposedTest "A universal power law requires ELPD at least 10 above every alternative and between-archipelago SD(z) below 0.03 around a mean within 0.03 of 0.25; nonoverlapping z intervals or superior non-power prediction refutes it." ;
    delphi:context "Fails if: Coverage estimates below 0.5 for more than one third of archipelagos or severe geographic sampling clustering makes the test inconclusive." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Freeze island polygons, taxonomic groups, dates and minimum 1000 occurrences per archipelago. 2. Estimate completeness from singleton and doubleton frequencies and rarefy to 80% coverage. 3. Fit all candidate forms with identical detection offsets. 4. Hold out whole islands and compare predictive log density and z heterogeneity." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Reliable island polygons and absence-aware inventories for poorly sampled archipelagos." ;
    skos:note "Tool: gbif" ;
    skos:note "Tool: macroecology" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch12-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch12-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch11-02> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/species-area-exponent> a delphi:Concept, schema:Question ;
    rdfs:label "Why does the species-area exponent cluster where it does?" .



}

