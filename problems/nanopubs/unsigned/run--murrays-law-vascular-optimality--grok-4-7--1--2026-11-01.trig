sub:assertion {
  <https://w3id.org/delphi/resource/run/murrays-law-vascular-optimality--grok-4-7--1--2026-11-01> a prov:Activity ;
    rdfs:label "Run of approach murrays-law-vascular-optimality--grok-4-7--1 (2026-11-01): completed, settled its target" ;
    dct:description "Lean 4 (ThompsonLaws.MurrayCubic), no sorry, standard axioms only. For cost k Q^2/r^4 + m r^2 the stationary radius is the strict global minimizer and a junction with Q0 = Q1 + Q2 and shared constants gives r0^3 = r1^3 + r2^3. Generalized to k Q^a/r^b + m r^c: junction exponent (b+c)/a. Correction to the approach: 7/3 is not a unique pair ((3,5) and (6,12) both give it); along the Darcy-Weisbach family with friction factor proportional to Re^(-beta) the exponent is 7/3 only for beta = 0 (fully rough), laminar gives 3 and Blasius gives 27/11. Whether real vasculature obeys 3 or 7/3 is the data test, not run." ;

    dct:subject <https://w3id.org/delphi/resource/problem/murrays-law-vascular-optimality> ;
    prov:qualifiedAssociation <https://w3id.org/delphi/resource/run/murrays-law-vascular-optimality--grok-4-7--1--2026-11-01#plan> ;
    prov:startedAtTime "2026-11-01"^^xsd:date ;
    prov:endedAtTime "2026-11-01"^^xsd:date ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty <https://w3id.org/delphi/resource/run/murrays-law-vascular-optimality--grok-4-7--1--2026-11-01#settled>, <https://w3id.org/delphi/resource/run/murrays-law-vascular-optimality--grok-4-7--1--2026-11-01#solves_problem> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch15-13> ;
    rdfs:seeAlso <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/run-reports/murrays-law-vascular-optimality--grok-4-7--1.md> ;
    prov:generated <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/claim-sources/thompson-growth-form/lean/reports/MurrayCubic.json> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/runs.json> .
