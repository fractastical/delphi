sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/turing-capable-network-topologies--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Quantifier-eliminate all three-node sign patterns" ;
    dct:subject <https://w3id.org/delphi/resource/problem/turing-capable-network-topologies> ;
    dct:description "Represent a three-species Jacobian with prescribed zero/sign entries and diagonal diffusion with one to three positive diffusivities. Turing capability is an existential semialgebraic formula: stability at wave number zero plus instability for some q > 0. Use cylindrical algebraic decomposition per sign pattern, then translate compact certificates into determinant, trace and Routh-Hurwitz lemmas checked in Lean." ;

    delphi:proposedTest "Necessary and sufficient conditions for every canonical 3-node sign pattern, with exact rational witnesses for capable classes and checked algebraic contradictions for incapable classes." ;
    delphi:context "Fails if: Quantifier elimination cannot finish after decomposition, or numerical capability disagrees with an exact certificate, exposing an encoding error." ;
    delphi:hypothesisType "approach/mixed" ;
    skos:note "Steps: 1. Canonicalize all 3-node signed directed graphs under permutation and global rescaling. 2. Write exact Routh-Hurwitz and diffusion-shift inequalities. 3. Run exact quantifier elimination and extract parameter witnesses or infeasibility certificates. 4. Prove the classification theorem and check every graph against numerical witnesses." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Efficient proof-certificate translation from quantifier elimination into Lean." ;
    skos:note "Tool: symbolic-computation" ;
    skos:note "Tool: enumeration" ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: linear-algebra" ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-ddi> ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-wavelength> ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-morphogen-hypothesis> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/turing-capable-network-topologies> a delphi:Concept, schema:Question ;
    rdfs:label "Classify the network topologies that admit diffusion-driven instability" .



}

