sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/clade-trajectory-universality--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Birth-death observation-model discrimination" ;
    dct:subject <https://w3id.org/delphi/resource/problem/clade-trajectory-universality> ;
    dct:description "Fit each clade with a state-space birth-death model whose fossil observations have bin-specific sampling probability. Compare constant-rate, diversity-dependent, symmetric hat and asymmetric rise-decline processes by simulation-based calibration and leave-future-bins-out prediction. Include only clades passing posterior identifiability checks." ;

    delphi:proposedTest "A biological hat process is supported if calibrated posterior probability exceeds 0.9 in a majority of identifiable clades and outpredicts sampling-only models; failure to recover simulated hats first invalidates the test." ;
    delphi:context "Fails if: Simulation-based calibration confuses hats with sampling heterogeneity in more than 20% of cases, so observed symmetry cannot identify the process." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Simulate 10000 clades per model across PBDB-like sampling regimes to calibrate model recovery. 2. Specify priors and identifiability thresholds before fitting real clades. 3. Fit at least 50 eligible clades and evaluate posterior model probabilities. 4. Repeat with monophyletic clades only and quantify pull-of-the-recent sensitivity." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Reliable monophyly annotations and computationally intensive state-space inference." ;
    skos:note "Tool: pbdb" ;
    skos:note "Tool: bayesian-computation" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-07> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-02> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/clade-trajectory-universality> a delphi:Concept, schema:Question ;
    rdfs:label "Are clade diversity trajectories universally hat-shaped?" .



}

