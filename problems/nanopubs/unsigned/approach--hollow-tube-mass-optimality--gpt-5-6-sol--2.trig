sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/hollow-tube-mass-optimality--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Cross-structure distance to the constrained tube optimum" ;
    dct:subject <https://w3id.org/delphi/resource/problem/hollow-tube-mass-optimality> ;
    dct:description "Measure outer radius, wall-thickness distribution, length and ovality from at least 100 published cross-sections spanning long bones, bamboo or grass culms, stems and feather rachises. Use modulus and failure-property values from the same specimen or narrowly matched tissue, propagate those uncertainties through the formal Pareto envelope, and estimate each structure's log-distance from bending-optimal, local-buckling and Euler-buckling boundaries. Pre-register structure type, body size and safety factor as predictors in a hierarchical model." ;

    delphi:proposedTest "A constraint explains a structure type if at least 70% of its records lie within 20% of that boundary and are at least twice as far from each competing boundary; otherwise that type is not classified as mechanically optimal under the model." ;
    delphi:context "Fails if: Insufficient matched material properties, no concentration near any boundary, or classification reversal under plausible loads refutes the cross-taxon optimum claim." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Scout records and freeze matching rules for geometry, material properties and loads. 2. Segment cross-sections with blinded duplicate measurements on 10% of records. 3. Compute uncertainty distributions over the three candidate constraint boundaries. 4. Fit type-specific and allometric models and perform leave-one-type-out validation." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Same-specimen loads and tissue moduli are uncommon, especially for feathers and plants, and may reduce the admissible sample below 100." ;
    skos:note "Tool: ct-morphometry" ;
    skos:note "Tool: image-segmentation" ;
    skos:note "Tool: hierarchical-statistics" ;
    skos:note "Tool: mechanics-modelling" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-04> ;
    skos:note "Dataset (no resolvable link): Published tube cross-sections and open CT. Only records with specimen-level geometry and same-specimen or narrowly matched tissue properties are admissible." ;

    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/hollow-tube-mass-optimality> a delphi:Concept, schema:Question ;
    rdfs:label "Are biological hollow structures at the stiffness-per-mass optimum?" .



}

