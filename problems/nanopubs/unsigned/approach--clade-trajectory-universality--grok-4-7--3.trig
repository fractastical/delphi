sub:assertion {
  <https://w3id.org/delphi/resource/approach/clade-trajectory-universality--grok-4-7--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Diversity-dependent extinction versus constant rates" ;
    dct:subject <https://w3id.org/delphi/resource/problem/clade-trajectory-universality> ;
    dct:description "If hats survive the sampling nulls, ask whether diversity-dependent extinction fits the declines better than constant rates. On each SQS curve that passed the occurrence floor, fit two birth-death models by Poisson likelihood of the stage-to-stage richness changes: constant origination and extinction, and constant origination with extinction linear in standing SQS richness. Compare by AIC. Diversity dependence is supported only if it beats the constant model by more than 10 in AIC for a fraction of clades whose bootstrap interval lies above 0.5. This can fail while the hat-shape test succeeds: symmetric-looking curves need not have diversity-dependent rates. It is the Red Queen piece of the question, not a second hat statistic." ;

    delphi:proposedTest "Bootstrap interval, entirely above 0.5, for the fraction of clades in which diversity-dependent extinction beats constant rates by AIC of more than 10." ;
    delphi:context "Fails if: The interval is not entirely above 0.5. Diversity-dependent extinction then does not explain the declines in this model class, whether or not the curves look hat-shaped." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Freeze the linear extinction model and the AIC gap. 2. Fit both likelihoods on each SQS curve. 3. Record the fraction of clades with AIC gap above 10. 4. Bootstrap that fraction. 5. Require the interval to lie above 0.5." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: pbdb" ;
    skos:note "Tool: paleobiology-statistics" ;
    skos:note "Tool: model-comparison" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-07> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch10-02> ;
    rdfs:seeAlso <https://paleobiodb.org/data1.2/> ;
    rdfs:seeAlso <https://doi.org/10.1126/science.1239431> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/clade-trajectory-universality> a delphi:Concept, schema:Question ;
    rdfs:label "Are clade diversity trajectories universally hat-shaped?" .

  <https://paleobiodb.org/data1.2/> dct:title "Paleobiology Database data service 1.2" ;
    dct:description "Stage-to-stage SQS richness used as the likelihood data." .
  <https://doi.org/10.1126/science.1239431> dct:title "How the Red Queen Drives Terrestrial Mammals to Extinction" ;
    dct:bibliographicCitation "Quental and Marshall 2013, diversity-dependent decline is the hypothesis" .
}

