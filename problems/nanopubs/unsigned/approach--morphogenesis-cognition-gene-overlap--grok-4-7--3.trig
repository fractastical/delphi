sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/morphogenesis-cognition-gene-overlap--grok-4-7--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Repeat the overlap using only pre-2015 annotations" ;
    dct:subject <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> ;
    dct:description "Annotation fashion after Levin's papers would inflate overlap. Repeat the matched odds-ratio test using only GO annotations whose assignment date is before 2015, if QuickGO exposes that date. Keep the same sets, the same exclusion of IEA, and the same thresholds. If dates are not in the download, the approach stops as inconclusive rather than using a proxy such as the paper's publication year. A signal present in the full ontology and absent before 2015 is evidence of later annotation, not of a standing shared gene set. A signal present before 2015 survives that objection." ;

    delphi:proposedTest "The pre-2015 odds ratio either clears the same threshold as the full test or it does not. Clearing it supports overlap that predates the recent annotation wave." ;
    delphi:context "Fails if: The pre-2015 odds ratio falls inside the null while the full-ontology test does not. The apparent overlap is then carried by later annotations." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Check whether annotation dates are present before computing the odds ratio. 2. Restrict to dates before 2015. 3. Reuse the matched permutation null. 4. Apply the odds-ratio and p-value thresholds. 5. If dates are absent, record inconclusive and stop." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: GO assignment dates may be absent from the query used. The approach then cannot run, and that is a stated stop." ;
    skos:note "Tool: gene-set-statistics" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;
    rdfs:seeAlso <https://geneontology.org/> ;
    rdfs:seeAlso <https://doi.org/10.3389/fnsys.2022.768201> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> a delphi:Concept, schema:Question ;
    rdfs:label "Do morphogenesis and learning share a gene set beyond pleiotropy?" .

  <https://geneontology.org/> dct:title "Gene Ontology" ;
    dct:description "Annotation dates, used only if the download actually contains them." .
  <https://doi.org/10.3389/fnsys.2022.768201> dct:title "Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds" ;
    dct:bibliographicCitation "Levin 2022, the date cut is chosen to precede this paper" .
}

