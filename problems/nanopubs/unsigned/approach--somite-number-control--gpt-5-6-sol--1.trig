sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/somite-number-control--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Cross-species clock-ratio prediction test" ;
    dct:subject <https://w3id.org/delphi/resource/problem/somite-number-control> ;
    dct:description "Pre-register a comparative dataset of every vertebrate species with independently measured segmentation-clock period, somitogenesis duration and final somite count. Predict count as duration divided by period with no fitted slope, propagate measurement error, and use phylogenetic residual analysis. Require at least 15 species spanning fish, amphibians, reptiles, birds and mammals." ;
    schema:additionalProperty <https://w3id.org/delphi/resource/approach/somite-number-control--gpt-5-6-sol--1#n_species> ;
    delphi:proposedTest "Clock-and-wavefront count control is supported if at least 80% of species fall within 15% of the parameter-free prediction and phylogenetic residual SD is below 0.1 log units." ;
    delphi:context "Fails if: Three or more independently measured species miss by over 30% in the same direction, or fewer than 10 species have all three direct measurements." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Define admissible live-imaging measurements and exclude inferred clock periods. 2. Blindly extract clock, duration and count in duplicate. 3. Compute posterior predictive intervals from measurement uncertainties only. 4. Test absolute percentage error and clade-structured bias." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Direct elongation-duration and clock-period measurements exist for too few species." ;
    skos:note "Tool: data-test" ;
    skos:note "Tool: phylogenetic-comparative-methods" ;
    skos:note "Tool: organisms-layer" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch17-04> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/somite-number-control> a delphi:Concept, schema:Question ;
    rdfs:label "What sets vertebrate somite number?" .
  <https://w3id.org/delphi/resource/approach/somite-number-control--gpt-5-6-sol--1#n_species> a schema:PropertyValue ;
    schema:propertyID "n_species" ;
    schema:value 15 ;
    schema:description "species the approach proposes to use, as stated in its description (a planned sample size, not a measurement)" .


}

