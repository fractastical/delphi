    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/empty-shell-morphospace--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Held-out occupancy models on museum meshes" ;
    dct:subject <https://w3id.org/delphi/resource/problem/empty-shell-morphospace> ;
    dct:description "Measure W, D and T with the morpholib MorphoEval pipeline on open gastropod and cephalopod meshes from MorphoSource, supplemented by iDigBio specimen records for provenance. A taxon enters only if it resolves to a GBIF key or an Open Tree taxon. Pre-register a minimum of 30 species; below that the verdict is underpowered. Three predictive models, scored by log predictive density on families held out one at a time. Developmental constraint: the planispiral inequality from the Lean theorem, with a Gaussian likelihood inside the allowed region and a fixed penalty outside. Functional: from each mesh, the center of mass must project inside the aperture-down contact footprint, and a thickness proxy from the mesh, if the mesh has a wall, supplies a strength score; meshes without a wall use only the stability score. Phylogenetic: a phylogenetic Gaussian process on the Open Tree subtree. The developmental or functional model wins only if its expected log predictive density beats the phylogenetic model by an interval that excludes 0. If neither does, the question stays open, which is the stated falsifier." ;
    schema:additionalProperty <https://w3id.org/delphi/resource/approach/empty-shell-morphospace--grok-4-7--2#n_species> ;
    delphi:proposedTest "A held-out log-predictive comparison. A non-phylogenetic model wins only if its advantage over the phylogenetic Gaussian process has an interval excluding 0, on at least 30 species." ;
    delphi:context "Fails if: Neither geometric nor functional model beats the phylogenetic model, or fewer than 30 species have measurable meshes. The question then stays open on present public scans." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Freeze the 30-species floor and the scoring rule before measuring meshes. 2. Measure W, D, T on MorphoSource shells with MorphoEval and keep provenance from iDigBio. 3. Fit the geometric, functional and phylogenetic models. 4. Score them by family-held-out log predictive density. 5. Declare a winner only if it beats the phylogenetic model with an interval excluding 0." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Most shells are not scanned. The test is built to return underpowered if the open meshes do not reach 30 species." ;
    skos:note "Tool: morpholib" ;
    skos:note "Tool: 3d-shape-analysis" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-09> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-15> ;
    rdfs:seeAlso <https://www.morphosource.org/> ;
    rdfs:seeAlso <https://www.idigbio.org/> ;
    skos:note "Dataset (no resolvable link): Open Tree of Life. Induced subtree for the phylogenetic Gaussian process." ;
    rdfs:seeAlso <https://doi.org/10.1111/brv.12276> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/empty-shell-morphospace> a delphi:Concept, schema:Question ;
    rdfs:label "Why is shell morphospace empty where it is?" .
  <https://w3id.org/delphi/resource/approach/empty-shell-morphospace--grok-4-7--2#n_species> a schema:PropertyValue ;
    schema:propertyID "n_species" ;
    schema:value 30 ;
    schema:description "species named in the text (a sample size as stated there, not a measurement made here)" .
  <https://www.morphosource.org/> dct:title "MorphoSource" ;
    dct:description "Open 3D meshes of gastropod and cephalopod shells." .
  <https://www.idigbio.org/> dct:title "iDigBio" ;
    dct:description "Specimen provenance for the meshes." .
  <https://doi.org/10.1111/brv.12276> dct:title "The geometry of morphospaces: lessons from the classic\n                    <scp>R</scp>\n                    aup shell coiling model" ;
    dct:bibliographicCitation "Gerber 2017, the occupancy question and Raup-space geometry" .
}

