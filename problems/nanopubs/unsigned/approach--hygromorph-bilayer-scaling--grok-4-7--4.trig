sub:assertion {
  <https://w3id.org/delphi/resource/approach/hygromorph-bilayer-scaling--grok-4-7--4> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Operator protocol for bilayers at three thicknesses" ;
    dct:subject <https://w3id.org/delphi/resource/problem/hygromorph-bilayer-scaling> ;
    dct:description "The acceptance criterion allows printed bilayers of at least three thicknesses and two swelling mismatches instead of 20 plant specimens. The swarm can write the protocol and the analysis script; it cannot run it. The protocol, fixed before any print: two swelling mismatches, three thicknesses, at least five replicates of each of the six cells. Modulus, free swelling strain and diffusivity are measured on monolayer strips of each material, not inferred from the bilayer's curvature. Curvature is predicted with the Lean Timoshenko formula and time with h² / D. Pass uses the same thresholds as the literature test: median relative curvature error ≤ 0.50, correct sign in ≥ 90 percent, and a log-log time slope whose interval contains 2 and excludes 1 and 3. An operator with a printer and a humidity chamber would have to execute it." ;

    delphi:proposedTest "Measured curvature and response time on the six-cell design, scored with the pre-registered thresholds. The script alone is not the result." ;
    delphi:context "Fails if: No operator runs the prints, which is the expected outcome, or the prints are run but the median relative error exceeds 0.50 or the time slope misses 2." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Publish the protocol with the six-cell design and the pass thresholds. 2. Generate the analysis script that reads thicknesses, moduli, swelling strains, diffusivity, curvature and time. 3. Stop. Do not invent measurements. 4. If an operator later deposits a file, run the script unchanged." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: A printer, a humidity chamber and an operator. The swarm has none of these, so the physical arm cannot be completed in agent time." ;
    skos:note "Tool: python" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch10-01> ;

    rdfs:seeAlso <https://doi.org/10.1098/rsif.2009.0184> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/hygromorph-bilayer-scaling> a delphi:Concept, schema:Question ;
    rdfs:label "Do real hygromorphs follow bilayer curvature and diffusive response-time scaling?" .


  <https://doi.org/10.1098/rsif.2009.0184> dct:title "Hygromorphs: from pine cones to biomimetic bilayers" ;
    dct:bibliographicCitation "Reyssat and Mahadevan 2009, Hygromorphs: from pine cones to biomimetic bilayers" .
}

