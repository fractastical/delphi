sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> a delphi:Concept, schema:Question ;
    rdfs:label "Do morphogenesis and learning share a gene set beyond pleiotropy?" ;
    dct:description "Do genes annotated to morphogenesis and genes annotated to learning and memory overlap more than expected from gene-set size, pleiotropy and shared housekeeping components, as Levin's TAME framework predicts?" ;

    skos:historyNote "Known state: Levin (2022) predicts wide overlap because, on his account, morphogenesis uses the same problem-solving machinery as cognition. The repo's one test (levin-2022-tame-19) returned refutes at confidence 0.7 using GO term overlap, but did not control for pleiotropy, annotation bias or gene-set size. INDRA CoGEx allows a mechanistically grounded, permutation-controlled test." ;
    dct:subject "biology" ;
    delphi:hypothesisType "open-problem/tier-C" ;
    skos:scopeNote "Resolved when: A pre-registered test using INDRA CoGEx gene sets for morphogenesis and learning/memory (GO and HPO), a permutation null matched on gene-set size, pleiotropy degree and annotation count, and a stated effect-size threshold for 'wide overlap'." ;
    skos:scopeNote "Resolved when: The same test on ion-channel and gap-junction subsets, which Levin names specifically." ;
    skos:scopeNote "Refuted if: Overlap within the matched null refutes the prediction; overlap well above it (especially in the bioelectric subset) supports it and would revise the current verdict." ;
    skos:note "Data access: INDRA CoGEx MCP (public), Gene Ontology, HPO." ;
    skos:note "Requires: indra-cogex" ;
    skos:note "Requires: gene-set-statistics" ;
    skos:note "Requires: data-test" ;
    skos:note "Scale: molecular" ;
    skos:note "Scale: cellular" ;
    skos:note "Scale: developmental" ;
    skos:note "Scale: neural" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;
    rdfs:seeAlso <https://doi.org/10.3389/fnsys.2022.768201> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/problems.json> .

  <https://doi.org/10.3389/fnsys.2022.768201> dct:title "Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds" ;
    dct:bibliographicCitation "Levin 2022, Technological approach to mind everywhere (TAME)" .
}

