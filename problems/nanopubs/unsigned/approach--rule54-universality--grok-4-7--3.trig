sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule54-universality--grok-4-7--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Lean-check the published gates and their generated monoid" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule54-universality> ;
    dct:description "Formalize only the collisions Martínez, Adamatzky and McIntosh actually used to build gates, as kernel-checked lemmas of the same kind as the Rule 110 table, then stop at the algebra those gates generate. Represent each gate as a relation on a finite set of glider occupancy vectors. Compute the monoid generated by composition up to a stated vector length. Prove either that the monoid contains a copy of a cyclic-tag append, or that every element is a function of a finite set of counters that cannot store an arbitrary work string. This can succeed as a non-universality proof for this gate set while the wider Rule 54 question stays open, and it fails differently from the census: the census can find a new glider that this monoid never sees." ;

    delphi:proposedTest "Either a checked embedding of one cyclic-tag step in the monoid of the 2006 gates, or a proof that this monoid cannot store an arbitrary work string." ;
    delphi:context "Fails if: The monoid is too large to close and no embedding is found. That is an inconclusive stop, not a non-universality proof. A simulator mismatch on a published gate also fails the approach." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Transcribe the published gate collisions and check them by kernel reduction. 2. Encode each gate as a relation on occupancy vectors. 3. Close the monoid under composition up to the stated length. 4. Test whether a cyclic-tag append embeds in that monoid. 5. If it does not, prove the monoid's memory is bounded by the counters found in the closure." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: cellular-automaton-simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-21> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-19> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-20> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/rule54-universality> a delphi:Concept, schema:Question ;
    rdfs:label "Is Rule 54 computationally universal?" .



}

