sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/murrays-law-vascular-optimality--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Formal derivation and robust optimality envelope" ;
    dct:subject <https://w3id.org/delphi/resource/problem/murrays-law-vascular-optimality> ;
    dct:description "Formalize Poiseuille pumping cost plus volume-maintenance cost for a bifurcating vessel in Lean. Prove strict convexity, derive the optimal radius-flow relation, and derive the cubic junction law under flow conservation. Then vary the drag exponent and maintenance cost to obtain a theorem mapping physical assumptions to branching exponent." ;

    delphi:proposedTest "A no-sorry Lean theorem proving p = 3 exactly under named assumptions and a generalized theorem quantifying how p changes when each assumption changes." ;
    delphi:context "Fails if: The optimization requires an unacknowledged flow-radius premise equivalent to the cubic law, making the standard derivation circular." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Define positive radii, flows and cost with explicit viscosity and length hypotheses. 2. Prove existence and uniqueness of the radius minimizer. 3. Derive the generalized exponent for resistance proportional to r^-k. 4. Construct counterexamples with load-bearing or nonlaminar cost terms." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: calculus" ;
    skos:note "Tool: fluid-mechanics" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch15-13> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-03> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/murrays-law-vascular-optimality> a delphi:Concept, schema:Question ;
    rdfs:label "Does real vasculature obey Murray's law?" .



}

