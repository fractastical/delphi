sub:assertion {
  <https://w3id.org/delphi/resource/approach/morphogenesis-cognition-gene-overlap--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "INDRA statement density inside the intersection" ;
    dct:subject <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> ;
    dct:description "Set overlap can be shared annotation fashion. This test asks whether genes in the intersection are mechanistically tied. Count INDRA statements with evidence count at least 5 that connect a GO:0009653 gene to a GO:0007611 gene. Compare with 10,000 random bipartitions that preserve the two set sizes and the joint degree sequence. The pre-registered effect is a statement count above the 99th percentile of that null. Repeat for the ion-channel subset and the gap-junction subset. A gene-set hit with a null statement density means the shared genes are not preferentially wired to each other in INDRA, which is a different negative from a failed overlap test." ;

    delphi:proposedTest "Cross-set INDRA statement count above the 99th percentile of the degree-preserving null, overall and in the two bioelectric subsets." ;
    delphi:context "Fails if: The count lies within the null. Overlap of annotations, if it exists, is then not matched by INDRA evidence between the sets." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Build the morphogenesis and learning sets as in the overlap test. 2. Count INDRA statements of evidence count at least 5 across the cut. 3. Permute bipartitions preserving sizes and degrees, 10,000 times. 4. Apply the 99th-percentile threshold. 5. Repeat for ion channels and gap junctions." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: gene-set-statistics" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;
    rdfs:seeAlso <https://discovery.indra.bio/> ;
    rdfs:seeAlso <https://geneontology.org/> ;
    rdfs:seeAlso <https://doi.org/10.3389/fnsys.2022.768201> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> a delphi:Concept, schema:Question ;
    rdfs:label "Do morphogenesis and learning share a gene set beyond pleiotropy?" .

  <https://discovery.indra.bio/> dct:title "INDRA CoGEx" ;
    dct:description "Statements and evidence counts between the two gene sets." .
  <https://geneontology.org/> dct:title "Gene Ontology" ;
    dct:description "Set membership." .
  <https://doi.org/10.3389/fnsys.2022.768201> dct:title "Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds" ;
    dct:bibliographicCitation "Levin 2022, the bioelectric subset is part of the prediction" .
}

