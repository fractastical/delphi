sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/hygromorph-bilayer-scaling--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Independent-parameter audit of plant bilayer predictions" ;
    dct:subject <https://w3id.org/delphi/resource/problem/hygromorph-bilayer-scaling> ;
    dct:description "Extract specimen-level or reconstructable measurements for at least 20 hygromorphs from five species: layer thicknesses, orthotropic moduli, free swelling strains, moisture diffusivity, curvature-time traces and humidity step. Predict equilibrium curvature with the Timoshenko bilayer formula and response time with the first diffusion eigenmode without fitting either outcome. Pre-register error tolerances, digitization uncertainty and a graded orthotropic alternative, then use leave-species-out prediction to prevent species-specific calibration." ;

    delphi:proposedTest "The simple scaling passes if at least 16 of 20 equilibrium curvatures are within 25% of prediction and the fitted log response-time versus log thickness slope is within 0.25 of 2 with a 95% interval; otherwise report which extension achieves at least a 20% held-out error reduction." ;
    delphi:context "Fails if: Fewer than 20 jointly parameterized specimens, systematic curvature error above 25%, or a response-time slope interval excluding 2 by more than 0.25 refutes the simple model for the assembled species." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Scout papers and supplements for jointly reported inputs and outcomes. 2. Dual-digitize figures and reject records lacking independently measured inputs. 3. Compute parameter-free bilayer predictions and uncertainty intervals. 4. Compare simple, orthotropic and viscoelastic models by leave-species-out predictive error." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Published papers may not expose enough specimen-level combinations of moduli, swelling mismatch, diffusivity and time courses to reach 20 records." ;
    skos:note "Tool: figure-digitization" ;
    skos:note "Tool: continuum-mechanics" ;
    skos:note "Tool: diffusion-model" ;
    skos:note "Tool: leave-species-out-validation" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch10-01> ;
    skos:note "Dataset (no resolvable link): Published plant hygromorph measurements. Only records with independently measured thickness, swelling or diffusivity and an observed outcome are admissible." ;

    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/hygromorph-bilayer-scaling> a delphi:Concept, schema:Question ;
    rdfs:label "Do real hygromorphs follow bilayer curvature and diffusive response-time scaling?" .



}

