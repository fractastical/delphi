sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/mutant-morphant-discrepancy-prediction--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Mechanistic compensation score from decay and paralogs" ;
    dct:subject <https://w3id.org/delphi/resource/problem/mutant-morphant-discrepancy-prediction> ;
    dct:description "Build an interpretable score from predicted premature termination and NMD, mutant-transcript abundance, sequence similarity to expressed paralogs, and signed compensatory paths in INDRA. Evaluate the prespecified score without learned weights, then use causal mediation on datasets containing mutant RNA-seq to test whether paralog upregulation mediates phenotype absence." ;

    delphi:proposedTest "Mechanistic support requires odds ratio at least 2 per score SD, AUROC above 0.7 and a positive mediated fraction above 0.3 with 95% interval excluding zero." ;
    delphi:context "Fails if: NMD and paralog induction do not precede phenotype rescue, mediation is null, or discrimination is at chance." ;
    delphi:hypothesisType "approach/mixed" ;
    skos:note "Steps: 1. Define the score and thresholds before joining phenotype labels. 2. Select at least 50 mutants with RNA-seq, matched knockdown phenotype and paralog information. 3. Test score discrimination and paralog-expression mediation with bootstrap uncertainty. 4. Rank untested genes only after the held-out threshold is met." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Public mutant RNA-seq paired to rigorously matched morphant and mutant phenotypes." ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: transcriptomics" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch05-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/mutant-morphant-discrepancy-prediction> a delphi:Concept, schema:Question ;
    rdfs:label "Predict which genes show mutant-morphant discrepancies" .



}

