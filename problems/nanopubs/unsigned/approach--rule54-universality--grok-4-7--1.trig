sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule54-universality--grok-4-7--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Exhaustive collision census of the 2006 glider catalog" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule54-universality> ;
    dct:description "Take every glider and compound glider named by Martínez, Adamatzky and McIntosh 2006, on the periodic ether they use, and collide every ordered pair at every separation from 1 to 256 cells. Evolve each collision for 10^5 steps or until the configuration is a disjoint union of catalogued gliders on the ether. Two independent simulators must agree. From the resulting table, search for a finite gate set that simulates one append of a cyclic tag system: a memory-carrying glider that survives a round trip, a fan-out, and a collision sequence whose net effect is that append. New logic gates that do not compose into that append are recorded and then counted as failure, matching the problem's falsifier that partial gates leave the question open." ;

    delphi:proposedTest "A collision sequence, reproduced by both simulators, whose net glider content is one step of a cyclic tag system, or a complete census up to separation 256 with no such sequence." ;
    delphi:context "Fails if: The census finds gates, oscillators or a new glider but no composition that implements a tag append. That is the partial-result failure the problem already names. Disagreement between the two simulators invalidates the census." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Transcribe the 2006 glider words and ether; do not invent new names. 2. Collide all pairs at separations 1 through 256, cutoff 10^5 steps, with two simulators. 3. Classify products as ether, catalogued gliders, or a new persistent object. 4. Search the table for a cyclic-tag append realized as a finite collision sequence. 5. If found, emit the sequence as a witness; if not, emit the census and stop." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: cellular-automaton-simulation" ;
    skos:note "Tool: glider-collision-search" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-21> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-19> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-20> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/rule54-universality> a delphi:Concept, schema:Question ;
    rdfs:label "Is Rule 54 computationally universal?" .



}

