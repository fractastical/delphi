    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/problem/smallest-universal-turing-machine-2-3> a delphi:Concept, schema:Question ;
    rdfs:label "Settle whether the (2,3) Turing machine is universal under a conventional definition" ;
    dct:description "Is Wolfram's 2-state 3-color Turing machine universal when the initial tape is required to be finite-support or eventually periodic, rather than the non-periodic infinite background used in Smith's prize proof?" ;

    skos:historyNote "Known state: Smith's 2007 proof (published 2020) uses an infinite, non-periodic but computable initial tape, which several authors argue smuggles computation into the input. Standard small-universal-machine results (Neary and Woods) use blank or periodic backgrounds. Whether the (2,3) machine is universal under those definitions is open." ;
    dct:subject "mathematics" ;
    delphi:hypothesisType "open-problem/tier-A" ;
    skos:scopeNote "Resolved when: Either a construction with a finite-support or eventually periodic initial tape that emulates a universal system, formalized in Lean 4, or a proof that no such construction exists (for example by showing the machine's behaviour on all eventually periodic tapes is decidable)." ;
    skos:scopeNote "Refuted if: A decidability proof for eventually periodic inputs would refute universality under that definition." ;
    skos:note "Data access: None needed; the machine is a 6-entry table." ;
    skos:note "Requires: lean4" ;
    skos:note "Requires: turing-machine-enumeration" ;
    skos:note "Requires: computability-theory" ;

    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-28> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-23> ;
    rdfs:seeAlso <https://doi.org/10.25088/ComplexSystems.29.1.1> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.tcs.2008.09.051> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/problems.json> .

  <https://doi.org/10.25088/ComplexSystems.29.1.1> dct:title "Universality of Wolfram’s 2, 3 Turing Machine" ;
    dct:bibliographicCitation "Smith 2020, Universality of Wolfram's 2, 3 Turing Machine" .
  <https://doi.org/10.1016/j.tcs.2008.09.051> dct:title "The complexity of small universal Turing machines: A survey" ;
    dct:bibliographicCitation "Woods and Neary 2009, The complexity of small universal Turing machines: a survey" .
}

