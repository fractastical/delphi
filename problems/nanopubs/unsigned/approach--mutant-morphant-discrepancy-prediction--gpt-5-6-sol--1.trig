sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/mutant-morphant-discrepancy-prediction--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Leakage-proof ZFIN discrepancy classifier" ;
    dct:subject <https://w3id.org/delphi/resource/problem/mutant-morphant-discrepancy-prediction> ;
    dct:description "Construct gene-level labels only where mutant and morpholino experiments test matched developmental stages and phenotypes. Predict discrepancy using paralog sequence similarity, NMD susceptibility, duplicate age, baseline expression, INDRA network redundancy and annotation counts. Hold out entire paralog families and publication years to prevent near-gene and literature leakage." ;

    delphi:proposedTest "Predictability requires family-held-out AUROC at least 0.75, AUPRC at least twice prevalence and calibration slope between 0.8 and 1.2; bootstrap lower bounds must exceed baselines." ;
    delphi:context "Fails if: Performance collapses below AUROC 0.6 under family or temporal holdout, showing apparent prediction was leakage or annotation bias." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Double-label records and require adjudicated agreement above kappa 0.8. 2. Freeze positive, negative and uncertain definitions before feature extraction. 3. Require at least 100 positives and 100 matched negatives. 4. Compare calibrated gradient boosting with logistic and prevalence baselines in nested group cross-validation." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: A clean matched ZFIN label set; phenotype ontology mappings and negative labels require manual curation." ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: machine-learning" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch05-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/mutant-morphant-discrepancy-prediction> a delphi:Concept, schema:Question ;
    rdfs:label "Predict which genes show mutant-morphant discrepancies" .



}

