sub:assertion {
  <https://w3id.org/delphi/resource/run/hamiltons-rule-exact-scope--grok-4-7--2--2026-11-01> a prov:Activity ;
    rdfs:label "Run of approach hamiltons-rule-exact-scope--grok-4-7--2 (2026-11-01): completed, did not settle its target" ;
    dct:description "Exact (rational arithmetic) enumeration of all 64 configurations of six haploids in three fixed pairs. The proposed seven-state count chain is not well defined: counts 2, 3 and 4 each contain configurations with distinct expected frequency changes, and the no-mutation chain is absorbing. With uniform weighting within counts the refit regression disagreed with the aggregate sign at counts 2 and 3, so the pre-registered criterion failed. Verdict inconclusive (not-operationalizable, 0.99): the failure comes from collapsing non-lumpable configurations, not from a counterexample to the within-state regression identity." ;

    dct:subject <https://w3id.org/delphi/resource/problem/hamiltons-rule-exact-scope> ;
    prov:qualifiedAssociation <https://w3id.org/delphi/resource/run/hamiltons-rule-exact-scope--grok-4-7--2--2026-11-01#plan> ;
