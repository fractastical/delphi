sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule110-universality-machine-checked--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Certified collision-table reconstruction" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule110-universality-machine-checked> ;
    dct:description "Independently reconstruct Cook's construction before formalizing it. Enumerate all ether-relative glider phases and pair/triple collisions inside exact light cones, canonicalize traces modulo translation and ether period, and search for a closed macro-transition system implementing the cyclic tag productions. Emit proof certificates containing initial words, horizons and decoded products for Lean replay." ;

    delphi:proposedTest "A closed, independently generated set of certified macro-transitions sufficient for both cyclic-tag productions and all routing operations, with every trace replayed by Lean." ;
    delphi:context "Fails if: Exhaustive bounded search finds that at least one required macro-transition has no phase-consistent realization within the stated bounds, leaving no complete emulation certificate." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Enumerate minimal periodic-ether defects up to width 80 and classify velocities over 500 steps. 2. Enumerate phase-separated collisions up to distance 400 and retain stable products. 3. Model compilation as a constraint problem over collision phases and spacings. 4. Replay every selected certificate in Lean and compare the reconstructed table with the published construction." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Completeness beyond finite phase and spacing bounds would still require a mathematical argument." ;
    skos:note "Tool: cellular-automaton-simulation" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-07> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/rule110-universality-machine-checked> a delphi:Concept, schema:Question ;
    rdfs:label "Machine-check the universality of Rule 110" .



}

