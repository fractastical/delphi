    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/morphogenesis-cognition-gene-overlap--grok-4-7--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Pleiotropy-matched overlap of morphogenesis and learning genes" ;
    dct:subject <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> ;
    dct:description "Pre-register human genes with GO:0009653 (anatomical structure morphogenesis) and GO:0007611 (learning or memory). Primary run excludes evidence code IEA; a second run includes it and is labeled. Background is human protein-coding genes. The statistic is the odds ratio of the intersection. The null is 10,000 permutations that preserve both set sizes and match genes on the number of GO annotations and on degree in the public INDRA statement graph. Wide overlap, the pre-registered threshold, is an odds ratio above 2 and a permutation p-value below 0.01. The same threshold is a primary endpoint, not a subgroup glance, for the subsets annotated with GO:0005216 (monoatomic ion channel activity; the synonym is ion channel activity) and with GO:0005921 (gap junction). Housekeeping is partly absorbed by the annotation-count match; it is not a separate covariate invented after the test." ;

    delphi:proposedTest "Odds ratio above 2 and permutation p below 0.01 for the full sets and, separately, for the ion-channel subset and the gap-junction subset." ;
    delphi:context "Fails if: The full-set odds ratio falls inside the matched null. That refutes wide overlap beyond pleiotropy and annotation volume. A hit that appears only in the IEA-included run is annotation noise and does not count." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Freeze the two GO sets, the IEA rule, the odds-ratio threshold and the permutation scheme. 2. Pull annotations from Gene Ontology and degrees from INDRA. 3. Compute the observed odds ratio. 4. Run 10,000 matched permutations. 5. Apply the same test to the ion-channel and gap-junction subsets as primary endpoints." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: gene-set-statistics" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;
    rdfs:seeAlso <https://geneontology.org/> ;
    rdfs:seeAlso <https://discovery.indra.bio/> ;
    rdfs:seeAlso <https://doi.org/10.3389/fnsys.2022.768201> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> a delphi:Concept, schema:Question ;
    rdfs:label "Do morphogenesis and learning share a gene set beyond pleiotropy?" .

  <https://geneontology.org/> dct:title "Gene Ontology" ;
    dct:description "Annotations for GO:0009653, GO:0007611, GO:0005216 and GO:0005921." .
  <https://discovery.indra.bio/> dct:title "INDRA CoGEx" ;
    dct:description "Statement degree used to match the permutation null." .
  <https://doi.org/10.3389/fnsys.2022.768201> dct:title "Technological Approach to Mind Everywhere: An Experimentally-Grounded Framework for Understanding Diverse Bodies and Minds" ;
    dct:bibliographicCitation "Levin 2022, Technological approach to mind everywhere, the overlap prediction" .
}

