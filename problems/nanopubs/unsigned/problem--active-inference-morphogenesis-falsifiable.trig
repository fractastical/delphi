sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/problem/active-inference-morphogenesis-falsifiable> a delphi:Concept, schema:Question ;
    rdfs:label "A falsifiable form of active-inference morphogenesis" ;
    dct:description "Can the claim that morphogenesis is variational free-energy minimization be stated as a quantitative prediction that a regeneration or development experiment could refute, and does existing data refute it?" ;

    skos:historyNote "Known state: Friston, Levin, Sengupta and Pezzulo (2015) modelled morphogenesis as active inference by identical cells sharing a generative model; Kuchling et al. (2020) extended it to regeneration. Critics hold the framework is unfalsifiable because any outcome can be described as free-energy minimization under some generative model. No prediction has been derived that fixes the generative model in advance and could fail. The repo's levin-2015-place and levin-2019-boundary claims are untested for this reason." ;
    dct:subject "both" ;
    delphi:hypothesisType "open-problem/tier-C" ;
    skos:scopeNote "Resolved when: A derivation, from a generative model fixed before looking at data, of a quantitative prediction (for example regeneration time or error rate scaling with a stated surprise measure under graded perturbations) together with the observation that would refute it." ;
    skos:scopeNote "Resolved when: A pre-registered test of that prediction on published planarian or Xenopus regeneration time courses." ;
    skos:scopeNote "Refuted if: If every candidate prediction can be rescued by changing the generative model post hoc, the framework is not empirically testable in its current form; that is itself a result." ;
    skos:note "Data access: Published regeneration time courses (open-access Levin lab papers)." ;
    skos:note "Requires: variational-inference" ;
    skos:note "Requires: developmental-biology" ;
    skos:note "Requires: philosophy-of-science" ;
    skos:note "Requires: data-test" ;
    skos:note "Scale: cellular" ;
    skos:note "Scale: tissue" ;
    skos:note "Scale: developmental" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-place-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-place-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2019-boundary-15> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-girardia-20> ;
    rdfs:seeAlso <https://doi.org/10.1098/rsif.2014.1383> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.plrev.2019.06.001> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/problems.json> .

  <https://doi.org/10.1098/rsif.2014.1383> dct:title "Knowing one's place: a free-energy approach to pattern regulation" ;
    dct:bibliographicCitation "Friston, Levin, Sengupta and Pezzulo 2015, Knowing one's place: a free-energy approach to pattern regulation" .
  <https://doi.org/10.1016/j.plrev.2019.06.001> dct:title "Morphogenesis as Bayesian inference: A variational approach to pattern formation and control in complex biological systems" ;
    dct:bibliographicCitation "Kuchling, Friston, Georgiev and Levin 2020, Morphogenesis as Bayesian inference" .
}

