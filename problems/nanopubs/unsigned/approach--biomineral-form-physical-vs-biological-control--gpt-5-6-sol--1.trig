sub:assertion {
  <https://w3id.org/delphi/resource/approach/biomineral-form-physical-vs-biological-control--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Spherical-lattice geometry contest across mineral classes" ;
    dct:subject <https://w3id.org/delphi/resource/problem/biomineral-form-physical-vs-biological-control> ;
    dct:description "Assemble at least 30 calibrated, near-orthographic SEM or optical images spanning silica radiolarians, strontium-sulphate acantharians and organic Clathrulina-like lattices, with at least eight specimens per material class. Segment vertices and edges blind to material, correct spherical projection where possible, and measure polygon-side counts, vertex angles, edge-length coefficient of variation and topological defects. Compare a noisy equal-area foam model, a spherical Poisson-Voronoi null and a phylogenetically structured material model using held-out image likelihood." ;

    delphi:proposedTest "Packing physics is supported for mature geometry if the foam model improves held-out log predictive density over random Voronoi in all three materials and material class explains under 5% additional variance; a material effect above 20% refutes mineral independence." ;
    delphi:context "Fails if: No advantage over random Voronoi, segmentation error comparable to model differences, or fewer than eight usable specimens in any material class defeats this comparison." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Scout images with taxon, scale and composition provenance and freeze inclusion criteria. 2. Validate segmentation against duplicate manual annotations on 20% of images. 3. Simulate matched-size foam and random-Voronoi nulls on the sphere. 4. Fit material and phylogenetic effects and perform leave-taxon-out prediction." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: The availability and licensing of enough calibrated acantharian and organic-lattice SEM images are uncertain; mature images cannot establish the developmental vesicle mechanism." ;
    skos:note "Tool: image-segmentation" ;
    skos:note "Tool: spherical-geometry" ;
    skos:note "Tool: topological-data-analysis" ;
    skos:note "Tool: phylogenetic-model" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-07> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-15> ;
    skos:note "Dataset (no resolvable link): Open protist lattice-shell image archives. Images require specimen identity, scale and mineral-class provenance; historical drawings are excluded from the primary analysis." ;

    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/biomineral-form-physical-vs-biological-control> a delphi:Concept, schema:Question ;
    rdfs:label "How much of biomineral form is physical, and how much is cell-controlled?" .



}

