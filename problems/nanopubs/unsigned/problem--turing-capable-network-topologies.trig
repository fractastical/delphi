sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/problem/turing-capable-network-topologies> a delphi:Concept, schema:Question ;
    rdfs:label "Classify the network topologies that admit diffusion-driven instability" ;
    dct:description "For reaction networks of n species with m diffusing, which interaction sign-patterns (topologies) admit a Turing instability for some parameters, and is it true that for n >= 3 almost all topologies with at least one feedback loop do?" ;

    skos:historyNote "Known state: Turing (1952) settled n = 2 (activator-inhibitor or substrate-depletion sign patterns, with the inhibitor diffusing faster). Marcon et al. (2016) and Scholes et al. (2019) enumerated 2- and 3-node topologies numerically and found many that pattern without differential diffusivity, but there is no proof characterizing the Turing-capable set for general n, and the genericity conjecture is numerical only. turing-ddi has formal status partial in the repo." ;
    dct:subject "both" ;
    delphi:hypothesisType "open-problem/tier-A" ;
    skos:scopeNote "Resolved when: A theorem, machine-checked in Lean 4 or at least rigorously proved, giving necessary and sufficient sign-pattern conditions for the existence of parameters producing a Turing instability for n = 3, and" ;
    skos:scopeNote "Resolved when: An exhaustive, reproducible enumeration for n = 3 and n = 4 against which the theorem is checked." ;
    skos:scopeNote "Refuted if: A 3-node topology that the enumeration finds Turing-capable but the theorem excludes, or vice versa." ;
    skos:note "Data access: None needed; verification against published topology atlases (Marcon 2016, Scholes 2019) which are open access." ;
    skos:note "Requires: linear-algebra" ;
    skos:note "Requires: sign-pattern-matrices" ;
    skos:note "Requires: enumeration" ;
    skos:note "Requires: lean4" ;
    skos:note "Scale: tissue" ;
    skos:note "Scale: developmental" ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-ddi> ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-wavelength> ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-morphogen-hypothesis> ;
    rdfs:seeAlso <https://doi.org/10.1098/rstb.1952.0012> ;
    rdfs:seeAlso <https://doi.org/10.7554/eLife.14022> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.cels.2019.07.007> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/problems.json> .

  <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" ;
    dct:bibliographicCitation "Turing 1952, The chemical basis of morphogenesis" .
  <https://doi.org/10.7554/eLife.14022> dct:title "High-throughput mathematical analysis identifies Turing networks for patterning with equally diffusing signals" ;
    dct:bibliographicCitation "Marcon et al. 2016, High-throughput mathematical analysis identifies Turing networks for patterning with equally diffusing signals" .
  <https://doi.org/10.1016/j.cels.2019.07.007> dct:title "A Comprehensive Network Atlas Reveals That Turing Patterns Are Common but Not Robust" ;
    dct:bibliographicCitation "Scholes et al. 2019, A comprehensive network atlas reveals that Turing patterns are common but not robust" .
}

