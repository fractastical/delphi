sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/hamiltons-rule-exact-scope--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Exhaustive finite-population boundary map" ;
    dct:subject <https://w3id.org/delphi/resource/problem/hamiltons-rule-exact-scope> ;
    dct:description "Enumerate finite haploid models with population size 2 through 8, binary action, mutation, assortment and all rational payoff tables on a coarse grid. Compute exact one-generation allele change, regression r, b and c, and causal intervention effects. Classify disagreements among identity, additive and causal readings and mine minimal assumption sets with decision trees." ;

    delphi:proposedTest "A complete exact atlas for the declared model class, with minimal counterexamples and zero unexplained disagreements between implementation and formal definitions." ;
    delphi:context "Fails if: Classification depends primarily on arbitrary regression conventions rather than model structure, preventing a stable scope taxonomy." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Predefine each Hamilton-rule estimator and degeneracy handling. 2. Enumerate transition kernels using exact rational arithmetic. 3. Record minimal models where each reading predicts the wrong sign. 4. Generalize recurring boundaries into conjectured lemmas for Lean." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: population-genetics" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/hamilton-rule> ;
    skos:related <https://w3id.org/delphi/resource/claim/hamilton-haplodiploidy> ;
    skos:related <https://w3id.org/delphi/resource/claim/hamilton-lmc> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/hamiltons-rule-exact-scope> a delphi:Concept, schema:Question ;
    rdfs:label "The exact scope of Hamilton's rule" .



}

