sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/bioelectric-prepattern-predicts-anatomy--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Intervention-generalizing bioelectric simulator" ;
    dct:subject <https://w3id.org/delphi/resource/problem/bioelectric-prepattern-predicts-anatomy> ;
    dct:description "Construct a bounded tissue graph with measured channel classes, gap-junction coupling and cell-state transitions. Fit conductances only on control and one perturbation, then predict spatial Vmem and phenotype under unseen channel, gap-junction and pump interventions. Compare mechanistic predictions to a flexible image-only decoder." ;

    delphi:proposedTest "Mechanistic support requires held-intervention Vmem spatial correlation above 0.7 and phenotype accuracy above 0.75 for at least three distinct intervention classes." ;
    delphi:context "Fails if: No single posterior parameter region predicts both Vmem and anatomy, or image-only prediction strongly outperforms simulation on held interventions." ;
    delphi:hypothesisType "approach/simulation" ;
    skos:note "Steps: 1. Ground intervention targets and signed channel effects through INDRA CoGEx. 2. Specify prior parameter ranges and identifiability checks. 3. Calibrate with simulation-based inference on preregistered training interventions. 4. Predict held-out Vmem maps and anatomical classes without parameter refitting." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: Quantitative conductance, coupling and longitudinal imaging data for the same specimens." ;
    skos:note "Tool: frontier-simulate" ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: bioelectric-simulation" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2015-girardia-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2018-hcn2-16> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2019-boundary-14> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/bioelectric-prepattern-predicts-anatomy> a delphi:Concept, schema:Question ;
    rdfs:label "Does the bioelectric prepattern predict anatomical outcome?" .



}

