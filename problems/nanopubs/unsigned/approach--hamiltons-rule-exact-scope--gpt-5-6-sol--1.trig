sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/hamiltons-rule-exact-scope--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Lean taxonomy of Hamilton-rule statements" ;
    dct:subject <https://w3id.org/delphi/resource/problem/hamiltons-rule-exact-scope> ;
    dct:description "Formalize finite populations as weighted probability spaces and allele-frequency change as a covariance identity. Separate three statements: the Price-equation regression identity, an additive causal fitness theorem with exogenous coefficients, and a frequency-dependent predictive rule. Prove the first two under explicit hypotheses and encode a minimal counterexample to the third." ;

    delphi:proposedTest "A no-sorry Lean module whose theorem boundaries exactly identify when rb > c is an identity, a predictive theorem, or false, including a checked finite countermodel." ;
    delphi:context "Fails if: The proposed countermodel disappears when relatedness and costs are defined consistently, or the predictive theorem needs assumptions equivalent to its conclusion." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Define reproductive value, fitness, genotype and social-partner genotype on a finite probability space. 2. Prove the Price covariance identity and least-squares decomposition including zero-variance cases. 3. Derive rb > c iff positive allele-frequency change under additive linear fitness and transmission assumptions. 4. Exhaustively search two- and three-player games for a rational frequency-dependent counterexample and check it in Lean." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: population-genetics" ;
    skos:note "Tool: finite-enumeration" ;
    skos:related <https://w3id.org/delphi/resource/claim/hamilton-rule> ;
    skos:related <https://w3id.org/delphi/resource/claim/hamilton-haplodiploidy> ;
    skos:related <https://w3id.org/delphi/resource/claim/hamilton-lmc> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/hamiltons-rule-exact-scope> a delphi:Concept, schema:Question ;
    rdfs:label "The exact scope of Hamilton's rule" .



}

