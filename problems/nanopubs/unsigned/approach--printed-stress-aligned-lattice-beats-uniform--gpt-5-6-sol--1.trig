sub:assertion {
  <https://w3id.org/delphi/resource/approach/printed-stress-aligned-lattice-beats-uniform--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Robust virtual tournament of aligned and uniform lattices" ;
    dct:subject <https://w3id.org/delphi/resource/problem/printed-stress-aligned-lattice-beats-uniform> ;
    dct:description "Define three load cases and generate paired stress-aligned and uniform lattices with equal mass, strut count, bounding volume and minimum printable diameter. Evaluate nonlinear finite-element failure under resin-like elastic-plastic and brittle laws while sampling print-realistic diameter error, missing struts, anisotropy and load misalignment. Include a topology-optimized positive control so failure of the aligned design can be separated from failure of the solver or design space." ;

    delphi:proposedTest "A robust virtual advantage requires at least 20% higher median peak load or energy and a positive paired effect in the worst decile for every load case; topology optimization must beat or match both as a solver sanity check." ;
    delphi:context "Fails if: An advantage that vanishes under modest load misalignment or diameter noise, reverses for a load case, or depends on unequal feature size refutes general robust superiority in simulation." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Freeze geometry-matching and load definitions and verify mesh convergence. 2. Generate at least 100 matched design pairs per load case. 3. Sample at least 1,000 manufacturing-error realizations per pair using preregistered distributions. 4. Compare peak load and absorbed energy with hierarchical paired effects and worst-decile performance." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: The assumed defect and resin models need eventual calibration against a real printer; this approach settles only the computational robustness claim." ;
    skos:note "Tool: generative-design" ;
    skos:note "Tool: nonlinear-finite-elements" ;
    skos:note "Tool: uncertainty-quantification" ;
    skos:note "Tool: topology-optimization" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-06> ;

    rdfs:seeAlso <https://doi.org/10.1038/nature23911> ;
    rdfs:seeAlso <https://doi.org/10.1007/s00158-016-1420-7> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/printed-stress-aligned-lattice-beats-uniform> a delphi:Concept, schema:Question ;
    rdfs:label "Does a stress-aligned lattice beat a uniform lattice at equal mass, when printed?" .


  <https://doi.org/10.1038/nature23911> dct:title "Giga-voxel computational morphogenesis for structural design" ;
    dct:bibliographicCitation "Aage, Andreassen, Lazarov and Sigmund 2017, Giga-voxel computational morphogenesis for structural design" .
  <https://doi.org/10.1007/s00158-016-1420-7> dct:title "On the (non-)optimality of Michell structures" ;
    dct:bibliographicCitation "Sigmund, Aage and Andreassen 2016, On the non-optimality of Michell structures" .
}

