sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/hygromorph-bilayer-scaling--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Identifiability map for bilayer, graded and viscoelastic hygromorphs" ;
    dct:subject <https://w3id.org/delphi/resource/problem/hygromorph-bilayer-scaling> ;
    dct:description "Implement finite-element models for a sharp isotropic bilayer, an orthotropic bilayer, a continuous stiffness/swelling gradient and a viscoelastic bilayer. Sweep thickness ratio, modulus ratio, fibre angle, Biot number and relaxation-to-diffusion time ratio, then create synthetic curvature-time traces with realistic noise. Fit all four models blind to determine when curvature and response time can distinguish the simple law from its extensions and which additional observable is required when they cannot." ;

    delphi:proposedTest "The approach succeeds with a reproducible map identifying parameter regions where the true model is recovered with at least 90% accuracy and a ranked extra observable, such as through-thickness strain or relaxation after humidity reversal, for non-identifiable regions." ;
    delphi:context "Fails if: Failure to recover even the generating model under low noise, or universal non-identifiability across the sweep, shows curvature-time data cannot test the proposed deviations." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Verify the simple solver against the existing bilayer curvature and diffusion limits. 2. Run a Latin-hypercube sweep with mesh and time-step convergence. 3. Perform blinded model recovery from synthetic traces. 4. Publish a decision map and minimal measurement design for future specimens." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: The result designs and validates a discriminator but does not supply new biological measurements." ;
    skos:note "Tool: finite-element-analysis" ;
    skos:note "Tool: global-sensitivity-analysis" ;
    skos:note "Tool: model-identifiability" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch10-01> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/hygromorph-bilayer-scaling> a delphi:Concept, schema:Question ;
    rdfs:label "Do real hygromorphs follow bilayer curvature and diffusive response-time scaling?" .



}

