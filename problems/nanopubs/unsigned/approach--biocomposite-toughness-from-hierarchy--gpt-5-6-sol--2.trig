sub:assertion {
  <https://w3id.org/delphi/resource/approach/biocomposite-toughness-from-hierarchy--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Factorial fracture simulation isolates hierarchy from constituents" ;
    dct:subject <https://w3id.org/delphi/resource/problem/biocomposite-toughness-from-hierarchy> ;
    dct:description "Construct a two-dimensional discrete cohesive-zone model with identical mineral fraction, constituent elastic laws and interface fracture energy across designs. Enumerate single-level brick-and-mortar, two-level nested and three-level nested architectures over platelet aspect ratio and interface-compliance grids. Match total mass and smallest feature size, compute J-integral or work-to-failure under mode-I and mixed-mode loading, and use a factorial decomposition to estimate the pure hierarchy interaction after controlling for tortuosity and interface area." ;

    delphi:proposedTest "Hierarchy compounds toughness in the model only if each added level raises median work-to-failure by at least 25% at fixed constituents, mass, interface area and minimum feature size across at least 75% of the preregistered parameter grid." ;
    delphi:context "Fails if: No mesh-converged gain, gains attributable entirely to extra interface area, or frequent decreases after adding levels refutes a generic hierarchy effect in this model class." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Validate the solver against analytic laminate and single-crack limits. 2. Generate matched architectures over a preregistered parameter grid with mesh-convergence checks. 3. Compute peak stress, work-to-failure and crack-path tortuosity under two loading modes. 4. Fit a response surface and locate regions where adding a level helps, harms or is neutral." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: This settles a controlled theoretical piece, not whether real tissues occupy the beneficial parameter region; three-dimensional validation would require more compute and measurements." ;
    skos:note "Tool: cohesive-zone-finite-elements" ;
    skos:note "Tool: parameter-sweep" ;
    skos:note "Tool: factorial-analysis" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-02> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-16> ;

    rdfs:seeAlso <https://doi.org/10.1038/nmat4089> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/biocomposite-toughness-from-hierarchy> a delphi:Concept, schema:Question ;
    rdfs:label "Does hierarchy itself explain the toughness of biological composites?" .


  <https://doi.org/10.1038/nmat4089> dct:title "Bioinspired structural materials" ;
    dct:bibliographicCitation "Wegst et al. 2015, Bioinspired structural materials" .
}

