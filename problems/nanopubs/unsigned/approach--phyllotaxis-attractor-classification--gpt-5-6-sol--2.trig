sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/phyllotaxis-attractor-classification--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Empirical basin frequencies from randomized primordia" ;
    dct:subject <https://w3id.org/delphi/resource/problem/phyllotaxis-attractor-classification> ;
    dct:description "Pre-register a computational experiment over growth parameters and perturbation amplitudes. Sample 100000 initial states per stratum using a declared uniform phase measure, simulate until convergence diagnostics stabilize, classify parastichy pairs, and estimate basin probabilities with simultaneous multinomial confidence intervals. Compare cylinder and disc geometries." ;

    delphi:proposedTest "A reproducible basin atlas with 99% lower confidence bound above 0.999 for the Fibonacci basin in any claimed small-growth interval, or a measured non-Fibonacci mass exceeding 0.001." ;
    delphi:context "Fails if: Classifier instability under precision doubling or discovery of persistent unclassified trajectories above 0.1% prevents the full-measure inference." ;
    delphi:hypothesisType "approach/simulation" ;
    skos:note "Steps: 1. Fix repulsion kernel, numerical precision, initial-state measure and attractor classifier. 2. Validate convergence classifications against high-precision reruns. 3. Estimate basin probabilities on an adaptive parameter grid. 4. Search rare trajectories for unknown attractors and hand them to interval certification." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Missing: Simulation cannot prove full measure." ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: simulation" ;
    skos:note "Tool: interval-arithmetic" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-09> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-02> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/phyllotaxis-attractor-classification> a delphi:Concept, schema:Question ;
    rdfs:label "Rigorous classification of attractors in dynamical phyllotaxis" .



}

