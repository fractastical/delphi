}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/morphogenesis-cognition-gene-overlap--claude-opus-5-5--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Mechanistic proximity: network separation of the two modules in INDRA's causal graph" ;
    dct:subject <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> ;
    dct:description "Overlap counts shared members. TAME's claim is better read as shared machinery: the modules may be mechanistically adjacent without sharing genes. Use the network separation s_AB = ⟨d_AB⟩ − (⟨d_AA⟩ + ⟨d_BB⟩)/2 of Menche et al. 2015, computed on INDRA CoGEx's causal statement graph between human genes (indra_rel edges with evidence_count ≥ 2, undirected for distance). A = core morphogenesis set and B = core learning/memory set (experimental GO annotations), with SynGO synaptic genes as a positive-control module expected to be near B. Null: degree-preserving randomization, sampling gene sets with matched degree distribution (binned), 10^4 draws. Pre-registered: s_AB < 0 with z < −3 against the degree-matched null supports shared machinery; s_AB ≥ 0 refutes it. Repeat after removing the top 1% highest-degree hubs to check that shared housekeeping hubs do not drive proximity." ;

    delphi:proposedTest "Network separation s_AB with z-score against a degree-matched null, with and without hubs. Negative separation surviving hub removal would support Levin's shared-machinery prediction in a form the overlap test cannot detect; non-negative separation would refute it." ;
    delphi:context "Fails if: INDRA's causal graph is so dominated by literature-heavy genes that degree matching cannot remove study bias (separation tracks publication count), so the result reflects literature structure rather than biology." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Pre-register edge filters, gene sets, null and thresholds. 2. Export the INDRA causal subgraph via execute_cypher; record the query and statement-hash counts. 3. Compute s_AB and the null distribution; run the hub-removal sensitivity check. 4. For gene pairs driving proximity, cite INDRA statement hashes and PMIDs as mechanistic evidence." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: indra-cogex" ;
    skos:note "Tool: network-statistics" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-tame-19> ;
    rdfs:seeAlso <https://discovery.indra.bio/> ;
    rdfs:seeAlso <https://geneontology.org/> ;
    rdfs:seeAlso <https://doi.org/10.1126/science.1257601> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/claude-opus-5-5.json> .
  <https://w3id.org/delphi/resource/problem/morphogenesis-cognition-gene-overlap> a delphi:Concept, schema:Question ;
    rdfs:label "Do morphogenesis and learning share a gene set beyond pleiotropy?" .

  <https://discovery.indra.bio/> dct:title "INDRA CoGEx" ;
    dct:description "Causal statements between genes with evidence counts" .
  <https://geneontology.org/> dct:title "Gene Ontology" ;
    dct:description "Module definitions" .
  <https://doi.org/10.1126/science.1257601> dct:title "Uncovering disease-disease relationships through the incomplete interactome" ;
    dct:bibliographicCitation "Menche et al. 2015, Uncovering disease-disease relationships through the incomplete interactome (network separation)" .
}

