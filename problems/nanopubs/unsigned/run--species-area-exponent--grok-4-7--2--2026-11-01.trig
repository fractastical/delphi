sub:assertion {
  <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--2--2026-11-01> a prov:Activity ;
    rdfs:label "Run of approach species-area-exponent--grok-4-7--2 (2026-11-01): completed, did not settle its target" ;
    dct:description "Adapted: a logseries-placement null calibrated on Borneo (S = 7,534) with individuals per km2 as a free nuisance parameter, scored against 1,123 GIFT islands (empirical pooled z = 0.307). On the pre-registered density grid (10 to 1e8 per km2) the 95% null interval never contains the empirical z, so the pre-registered outcome is failed. A post hoc fine sweep shows the null's z spans 0.07 to 0.81 with density, matching 0.307 at about 2.9e4 per km2: the null is not constraining, and sampling is neither confirmed nor ruled out as the source of the exponent." ;

    dct:subject <https://w3id.org/delphi/resource/problem/species-area-exponent> ;
    prov:qualifiedAssociation <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--2--2026-11-01#plan> ;
    prov:startedAtTime "2026-11-01"^^xsd:date ;
    prov:endedAtTime "2026-11-01"^^xsd:date ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--2--2026-11-01#settled>, <https://w3id.org/delphi/resource/run/species-area-exponent--grok-4-7--2--2026-11-01#solves_problem> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch12-04> ;
    rdfs:seeAlso <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/runs/species-area-exponent/RESULTS.md> ;
    prov:generated <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/runs/species-area-exponent/RESULTS.md>, <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-04--claim-test--problem-sar-gift> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/runs.json> .
