sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/species-area-exponent--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Scale-transition test within nested surveys" ;
    dct:subject <https://w3id.org/delphi/resource/problem/species-area-exponent> ;
    dct:description "Use nested quadrat and island inventories to test whether apparent z changes predictably with sampled area. Pre-register local-slope estimators d log S/d log A for power-law and METE curves, and compare them on datasets with at least six nested area scales and 50 species." ;
    schema:additionalProperty <https://w3id.org/delphi/resource/approach/species-area-exponent--gpt-5-6-sol--2#n_species> ;
    delphi:proposedTest "Scale dependence is supported if at least 70% of series show directional local-slope change and the non-power model improves total ELPD by at least 20; otherwise a constant exponent remains adequate." ;
    delphi:context "Fails if: Fewer than 30 series retain six scales after harmonization or richness estimates are dominated by unequal effort." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Assemble at least 50 independent nested sampling series without pooling nonnested sites. 2. Estimate local slopes with a monotone spline whose smoothing is fixed by simulation. 3. Compare constant-slope and METE-predicted slope curves by leave-one-scale-out prediction. 4. Meta-analyze effects with biome and taxon moderators." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: A harmonized public collection of genuinely nested surveys." ;
    skos:note "Tool: macroecology" ;
    skos:note "Tool: data-test" ;
    skos:note "Tool: large-scale-computation" ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch12-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch12-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/darwin1859-ch11-02> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/species-area-exponent> a delphi:Concept, schema:Question ;
    rdfs:label "Why does the species-area exponent cluster where it does?" .
  <https://w3id.org/delphi/resource/approach/species-area-exponent--gpt-5-6-sol--2#n_species> a schema:PropertyValue ;
    schema:propertyID "n_species" ;
    schema:value 50 ;
    schema:description "species the approach proposes to use, as stated in its description (a planned sample size, not a measurement)" .


}

