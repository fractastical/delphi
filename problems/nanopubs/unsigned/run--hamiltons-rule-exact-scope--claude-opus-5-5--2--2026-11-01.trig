sub:assertion {
  <https://w3id.org/delphi/resource/run/hamiltons-rule-exact-scope--claude-opus-5-5--2--2026-11-01> a prov:Activity ;
    rdfs:label "Run of approach hamiltons-rule-exact-scope--claude-opus-5-5--2 (2026-11-01): completed, settled its target" ;
    dct:description "Lean 4, no sorry, standard axioms only. In a two-player synergy game with assortment r and deterministic replicator update: the exact sign condition is r b - c + d (r + (1-r) p) (generalizedHamilton), valid for any selection strength; with d = 0 the simple rule r b > c is exact (simpleHamilton_additive); with synergy it is neither sufficient nor necessary (two explicit counterexamples, and a frequency flip). This settles the parameter reading of the rule in one standard model. It does not touch the regression reading (Gardner et al. 2011), which is the problem's falsifier, and no Lean report entry was written because hamilton-rule is stated in regression form." ;

    dct:subject <https://w3id.org/delphi/resource/problem/hamiltons-rule-exact-scope> ;
    prov:qualifiedAssociation <https://w3id.org/delphi/resource/run/hamiltons-rule-exact-scope--claude-opus-5-5--2--2026-11-01#plan> ;
    prov:startedAtTime "2026-11-01"^^xsd:date ;
    prov:endedAtTime "2026-11-01"^^xsd:date ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty <https://w3id.org/delphi/resource/run/hamiltons-rule-exact-scope--claude-opus-5-5--2--2026-11-01#settled>, <https://w3id.org/delphi/resource/run/hamiltons-rule-exact-scope--claude-opus-5-5--2--2026-11-01#solves_problem> ;
    skos:related <https://w3id.org/delphi/resource/claim/hamilton-rule> ;
    rdfs:seeAlso <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/run-reports/hamiltons-rule-exact-scope--claude-opus-5-5--2.md> ;
    prov:generated <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/claim-sources/thompson-growth-form/lean/ThompsonLaws/HamiltonScope.lean> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/runs.json> .
  <https://w3id.org/delphi/resource/run/hamiltons-rule-exact-scope--claude-opus-5-5--2--2026-11-01#plan> a prov:Association ;
    prov:hadPlan <https://w3id.org/delphi/resource/approach/hamiltons-rule-exact-scope--claude-opus-5-5--2> .
  <https://w3id.org/delphi/resource/approach/hamiltons-rule-exact-scope--claude-opus-5-5--2> a prov:Plan ;
    rdfs:label "Formal counterexamples: synergistic games where parameter-based rb > c mispredicts" .
