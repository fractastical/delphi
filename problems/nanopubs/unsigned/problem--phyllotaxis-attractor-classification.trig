    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/problem/phyllotaxis-attractor-classification> a delphi:Concept, schema:Question ;
    rdfs:label "Rigorous classification of attractors in dynamical phyllotaxis" ;
    dct:description "In the Douady-Couder class of models (new primordium placed at the point of least repulsion from existing ones on a growing cylinder or disc), what is the complete set of attractors and their basins as the growth parameter varies, and does the golden-angle Fibonacci branch have full-measure basin for small growth parameter?" ;

    skos:historyNote "Known state: Douady and Couder (1992) showed numerically and experimentally that the Fibonacci branch is selected; Levitov (1991) explained the energetics; Atela, Golé and Hotton (2002) proved convergence to Fibonacci lattices for a cylindrical model under restrictions. Pennybacker, Shipman and Newell (2015) review the gap: no rigorous classification covering Lucas and bijugate branches, basin boundaries, or the disc geometry. Thompson's phyllotaxis claims (ch14) sit on this." ;
    dct:subject "both" ;
    delphi:hypothesisType "open-problem/tier-A" ;
    skos:scopeNote "Resolved when: A theorem characterizing the attractors for the cylindrical Douady-Couder map over a stated parameter range, including the Lucas branch, with proof (Lean 4 or rigorous computer-assisted interval proof)." ;
    skos:scopeNote "Resolved when: Numerical basin maps matching the theorem." ;
    skos:scopeNote "Refuted if: Numerical discovery of an attractor outside the classified set." ;
    skos:note "Data access: None needed; sunflower and cone parastichy counts in the repo (thompson1917-ch14-05/06 tests) can check predictions." ;
    skos:note "Requires: dynamical-systems" ;
    skos:note "Requires: interval-arithmetic" ;
    skos:note "Requires: lean4" ;
    skos:note "Requires: simulation" ;
    skos:note "Scale: organ" ;
    skos:note "Scale: developmental" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-09> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-02> ;
    rdfs:seeAlso <https://doi.org/10.1103/PhysRevLett.68.2098> ;
    rdfs:seeAlso <https://doi.org/10.1103/PhysRevLett.66.224> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.physd.2015.05.003> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/problems.json> .

  <https://doi.org/10.1103/PhysRevLett.68.2098> dct:title "Phyllotaxis as a physical self-organized growth process" ;
    dct:bibliographicCitation "Douady and Couder 1992, Phyllotaxis as a physical self-organized growth process" .
  <https://doi.org/10.1103/PhysRevLett.66.224> dct:title "Phyllotaxis of flux lattices in layered superconductors" ;
    dct:bibliographicCitation "Levitov 1991, Phyllotaxis of flux lattices in layered superconductors" .
  <https://doi.org/10.1016/j.physd.2015.05.003> dct:title "Phyllotaxis: Some progress, but a story far from over" ;
    dct:bibliographicCitation "Pennybacker, Shipman and Newell 2015, Phyllotaxis: some progress, but a story far from over" .
}

