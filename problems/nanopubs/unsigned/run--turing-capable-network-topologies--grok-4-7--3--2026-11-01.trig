sub:assertion {
  <https://w3id.org/delphi/resource/run/turing-capable-network-topologies--grok-4-7--3--2026-11-01> a prov:Activity ;
    rdfs:label "Run of approach turing-capable-network-topologies--grok-4-7--3 (2026-11-01): completed, did not settle its target" ;
    dct:description "Same-method n=3 baseline over all 19,683 sign patterns and seven diffusion supports (200 parameter draws each, seed 470003): 3,782 detected Turing-capable (0.192). Pre-registered n=4 sample of 2,000 cyclic patterns, 100 draws each: 392 capable (0.196, Clopper-Pearson 95% 0.179 to 0.214), entirely below the 0.9 the operational claim required, so that claim is refuted (0.95). Finite parameter search can miss existential witnesses, so this does not refute the mathematical capability conjecture or classify the topologies." ;

    dct:subject <https://w3id.org/delphi/resource/problem/turing-capable-network-topologies> ;
    prov:qualifiedAssociation <https://w3id.org/delphi/resource/run/turing-capable-network-topologies--grok-4-7--3--2026-11-01#plan> ;
    prov:startedAtTime "2026-11-01"^^xsd:date ;
    prov:endedAtTime "2026-11-01"^^xsd:date ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty <https://w3id.org/delphi/resource/run/turing-capable-network-topologies--grok-4-7--3--2026-11-01#settled>, <https://w3id.org/delphi/resource/run/turing-capable-network-topologies--grok-4-7--3--2026-11-01#solves_problem> ;
    skos:related <https://w3id.org/delphi/resource/claim/turing-ddi> ;
    rdfs:seeAlso <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/forecasts/run-reports/turing-capable-network-topologies--grok-4-7--3.md> ;
