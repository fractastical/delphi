    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/phyllotaxis-attractor-classification--claude-opus-5-5--3> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Simulated basin measures tested against citizen-science sunflower counts" ;
    dct:subject <https://w3id.org/delphi/resource/problem/phyllotaxis-attractor-classification> ;
    dct:description "Turn the model into a quantitative prediction about real plants. Simulate the Douady–Couder disc model and the cylindrical model over a slowly decreasing growth parameter Γ (the ontogenetic path from seedling to capitulum), starting from initial fronts sampled from a stated distribution (cotyledon arrangement: decussate or two-fold at stated rates, plus Gaussian positional noise σ ∈ {0.01, 0.03, 0.1}). Record the terminal parastichy pair class (Fibonacci, Lucas, double Fibonacci, other) and the basin measures with Wilson intervals from 10^5 runs per setting. Pre-register predicted class frequencies at each σ and compare with the Swinton et al. 2016 sunflower data and the repo's thompson1917-ch14-05/06 parastichy count tests, using a multinomial likelihood-ratio test. The pre-registered rule: the model supports the data if some σ in the grid gives p > 0.05 for the class distribution; it is refuted if all σ give p < 0.001 or if the model cannot produce the observed non-Fibonacci classes at all." ;

    delphi:proposedTest "A pre-registered verdict on whether the Douady–Couder model, with one noise parameter, reproduces the observed frequencies of Fibonacci, Lucas and other classes in sunflowers. If it does, the basin measures are what the rigorous classification must explain." ;
    delphi:context "Fails if: Model frequencies cannot match the observed share of non-Fibonacci heads for any σ, or the data lack enough class detail to distinguish Lucas from other non-Fibonacci heads (then inconclusive, underpowered)." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Implement disc and cylinder simulators with an inhibition-field placement rule; validate against Douady and Couder 1996 diagrams. 2. Write result.json with predictions per σ and the decision rule before downloading the Swinton data. 3. Run 10^5 simulations per setting; estimate class frequencies. 4. Fetch the sunflower data, classify heads by published parastichy counts, run the multinomial test." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: simulation" ;
    skos:note "Tool: data-test" ;
    skos:note "Tool: large-scale-computation" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-09> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-02> ;
    rdfs:seeAlso <https://doi.org/10.1098/rsos.160091> ;
    rdfs:seeAlso <https://doi.org/10.1098/rsos.160091> ;
    rdfs:seeAlso <https://doi.org/10.1006/jtbi.1996.0024> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/claude-opus-5-5.json> .
  <https://w3id.org/delphi/resource/problem/phyllotaxis-attractor-classification> a delphi:Concept, schema:Question ;
    rdfs:label "Rigorous classification of attractors in dynamical phyllotaxis" .

  <https://doi.org/10.1098/rsos.160091> dct:title "Swinton et al. 2016 sunflower parastichy counts (supplementary data to the Royal Society Open Science article)" ;
    dct:description "Parastichy counts and class labels for citizen-science sunflower heads" .
  <https://doi.org/10.1098/rsos.160091> dct:title "Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment" ;
    dct:bibliographicCitation "Swinton, Ochu et al. 2016, Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment" .
  <https://doi.org/10.1006/jtbi.1996.0024> dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" ;
    dct:bibliographicCitation "Douady and Couder 1996, spiral modes resulting from time-periodic iterations" .
}

