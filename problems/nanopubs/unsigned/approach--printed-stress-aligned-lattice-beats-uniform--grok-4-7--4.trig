sub:assertion {
  <https://w3id.org/delphi/resource/approach/printed-stress-aligned-lattice-beats-uniform--grok-4-7--4> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Printed replicates the swarm cannot test itself" ;
    dct:subject <https://w3id.org/delphi/resource/problem/printed-stress-aligned-lattice-beats-uniform> ;
    dct:description "Write the pre-registered physical protocol that matches the problem's acceptance criterion, and generate the STL files from the ideal-strut layouts. At least ten replicates of each layout, three load cases, equal mass and equal strut count, same resin and the same stereolithography process. Outcomes are peak load and energy to failure. Alignment wins only if it exceeds the uniform lattice by more than the replicate-to-replicate standard deviation on both outcomes, on every load case. A ranking that flips across load cases refutes a general advantage. The swarm stops at the protocol and the files. An operator would have to print and test." ;

    delphi:proposedTest "Peak load and energy to failure for at least ten replicates of each layout on three load cases. Alignment is supported only if both outcomes exceed the uniform lattice by more than the print-to-print standard deviation on every load case." ;
    delphi:context "Fails if: No prints are run, or the printed aligned lattice does not clear the replicate scatter, or the ranking reverses between load cases." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Freeze the replicate count, the outcomes and the variability rule. 2. Export STL files of both layouts for the three load cases. 3. Write the analysis script that compares peak load and energy against the replicate scatter. 4. Do not invent test results. 5. If an operator deposits a results file, run the script unchanged." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: An SLA printer, a tough resin, a universal testing machine and a post-processing line. The problem states that an operator has to print and test; the swarm cannot." ;
    skos:note "Tool: python" ;
    skos:note "Tool: fenics" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-06> ;

    rdfs:seeAlso <https://doi.org/10.1038/nature23911> ;
    rdfs:seeAlso <https://doi.org/10.1038/nmat4089> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/printed-stress-aligned-lattice-beats-uniform> a delphi:Concept, schema:Question ;
    rdfs:label "Does a stress-aligned lattice beat a uniform lattice at equal mass, when printed?" .


  <https://doi.org/10.1038/nature23911> dct:title "Giga-voxel computational morphogenesis for structural design" ;
    dct:bibliographicCitation "Aage, Andreassen, Lazarov and Sigmund 2017, Giga-voxel computational morphogenesis for structural design" .
  <https://doi.org/10.1038/nmat4089> dct:title "Bioinspired structural materials" ;
    dct:bibliographicCitation "Wegst, Bai, Saiz, Tomsia and Ritchie 2015, Bioinspired structural materials" .
}

