sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/grn-memory-generic-or-biological--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Matched random-network memory enrichment test" ;
    dct:subject <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> ;
    dct:description "Reimplement the exact stimulation and memory criteria for all 35 biological ODE models, then generate 100 matched nulls per model preserving node count, signed degree sequence, kinetic-law family, parameter marginal distributions and stiffness. Blindly apply identical protocols and estimate enrichment with a model-paired conditional logistic regression." ;

    delphi:proposedTest "Biological enrichment requires paired odds ratio at least 2 with 99% interval excluding 1 for a memory class and replication across two null generators; odds ratio at or below 1 refutes enrichment." ;
    delphi:context "Fails if: Fewer than 80% of published calls reproduce or null convergence filtering changes network dynamics enough to break covariate balance." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Freeze executable model versions and numerical tolerances. 2. Validate protocol reproduction against all reported memory calls. 3. Generate at least 3500 convergent null networks with fixed seeds. 4. Classify memory, habituation and consolidation using preregistered effect thresholds." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: ode-simulation" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-16> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> a delphi:Concept, schema:Question ;
    rdfs:label "Is memory in gene regulatory network models generic or a biological signature?" .



}

