sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/empty-shell-morphospace--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Mechanics-derived forbidden-region simulation" ;
    dct:subject <https://w3id.org/delphi/resource/problem/empty-shell-morphospace> ;
    dct:description "Generate shells across a dense W-D-T lattice and simulate growth, self-intersection, center-of-mass stability and pressure loading. Use interval geometry for self-intersection and validated finite-element convergence for failure. Compare the predicted infeasible boundary to observed morphospace without fitting boundary parameters to occupancy." ;

    delphi:proposedTest "Functional constraint explains emptiness if at least 90% of observed shells are feasible and at least 70% of well-sampled empty voxels are infeasible across the full material range." ;
    delphi:context "Fails if: Large connected empty regions remain mechanically feasible, or more than 10% of observed shells are classified impossible." ;
    delphi:hypothesisType "approach/simulation" ;
    skos:note "Steps: 1. Evaluate at least one million W-D-T points with adaptive refinement near constraints. 2. Certify self-intersection and aperture occlusion geometrically. 3. Compute dimensionless stress and stability under preregistered material ranges. 4. Test whether observed taxa lie inside the feasible set and empty voxels outside it." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Species-specific shell material properties and loading regimes." ;
    skos:note "Tool: mechanobiology-simulation" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: morphometrics" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-09> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch11-15> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/empty-shell-morphospace> a delphi:Concept, schema:Question ;
    rdfs:label "Why is shell morphospace empty where it is?" .



}

