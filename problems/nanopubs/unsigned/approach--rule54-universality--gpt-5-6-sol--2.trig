sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule54-universality--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Finite-factor obstruction to universality" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule54-universality> ;
    dct:description "Search for a symbolic-dynamics obstruction: a finite-state transducer or invariant cone showing every finite perturbation of each Rule 54 periodic domain decomposes into ballistic particles with ultimately periodic interactions. Infer candidate invariants from de Bruijn graphs, then prove closure and an upper bound on crossing-sequence complexity in Lean." ;

    delphi:proposedTest "A machine-checked theorem that finite perturbations of specified periodic backgrounds have decidable long-term behavior via a finite particle quotient." ;
    delphi:context "Fails if: Future-equivalence class counts grow without stabilization and collision products generate unbounded novel defects, defeating the finite-factor premise." ;
    delphi:hypothesisType "approach/proof" ;
    skos:note "Steps: 1. Construct order-k de Bruijn graphs for k through 24 and minimize future-equivalence classes. 2. Infer conserved additive charges and particle interaction normal forms. 3. Attempt a finite-defect decomposition and confluence theorem. 4. If obtained, prove finite-defect prediction decidable and state the exact restricted nonuniversality result." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: Even a finite-defect theorem may not cover arbitrary computable initial configurations." ;
    skos:note "Tool: symbolic-dynamics" ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-21> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-19> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-20> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/rule54-universality> a delphi:Concept, schema:Question ;
    rdfs:label "Is Rule 54 computationally universal?" .



}

