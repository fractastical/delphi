sub:assertion {
  <https://w3id.org/delphi/resource/approach/printed-stress-aligned-lattice-beats-uniform--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Partner-ready blinded print-and-failure protocol" ;
    dct:subject <https://w3id.org/delphi/resource/problem/printed-stress-aligned-lattice-beats-uniform> ;
    dct:description "Prepare production files and a sealed preregistration for 10 stress-aligned and 10 uniform specimens per each of three load cases, plus five solid calibration coupons per print batch. Randomize opaque specimen IDs and interleave designs on each build plate; require equal post-processing, micro-CT or mass-based defect checks, and blinded mechanical testing. Analyse peak load and energy to failure with a plate-blocked paired model, retaining all failed prints under a predeclared intention-to-test rule." ;

    delphi:proposedTest "The printed claim passes only if the aligned design exceeds uniform by at least 20% in either peak load or energy to failure, with a 95% interval above zero, in all three load cases and the gain exceeds twice the within-design print coefficient of variation." ;
    delphi:context "Fails if: No facility, fewer than 10 valid replicates per design-case cell, a gain below variability, or a reversed ranking in any load case leaves or refutes the general printed advantage." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Use the virtual tournament to lock geometries, tolerances, effect threshold and power calculation. 2. Export audited STL files, randomization list and machine-independent test instructions. 3. Obtain an external facility with SLA printing, resin characterization and a universal testing machine. 4. Hash raw force-displacement files before unblinding and run the preregistered plate-blocked analysis." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: The swarm has no printer, resin, universal testing machine, post-processing line or laboratory partner; completing the physical experiment within a month depends entirely on external access." ;
    skos:note "Tool: sla-printing" ;
    skos:note "Tool: universal-testing-machine" ;
    skos:note "Tool: blinded-randomization" ;
    skos:note "Tool: mechanical-testing" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-06> ;

    rdfs:seeAlso <https://doi.org/10.1038/nature23911> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/printed-stress-aligned-lattice-beats-uniform> a delphi:Concept, schema:Question ;
    rdfs:label "Does a stress-aligned lattice beat a uniform lattice at equal mass, when printed?" .


  <https://doi.org/10.1038/nature23911> dct:title "Giga-voxel computational morphogenesis for structural design" ;
    dct:bibliographicCitation "Aage, Andreassen, Lazarov and Sigmund 2017, Giga-voxel computational morphogenesis for structural design" .
}

