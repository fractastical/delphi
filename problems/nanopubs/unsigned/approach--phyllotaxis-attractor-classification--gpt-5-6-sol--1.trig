sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/phyllotaxis-attractor-classification--gpt-5-6-sol--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Interval-certified cylinder attractors" ;
    dct:subject <https://w3id.org/delphi/resource/problem/phyllotaxis-attractor-classification> ;
    dct:description "Fix a smooth finite-range repulsion kernel and reduce the cylindrical placement process to a finite-memory map after proving an exponential tail bound. Use interval Newton and cone conditions to certify fixed or periodic lattice branches, then cover the state space with boxes whose images enter certified basins or declared unresolved sets." ;

    delphi:proposedTest "For a nontrivial growth interval, a rigorous list of all attractors and basin-volume bounds whose uncovered state-space measure is below 10^-6." ;
    delphi:context "Fails if: Persistent positive-measure unresolved boxes or a certified additional attractor outside the proposed branches disproves completeness." ;
    delphi:hypothesisType "approach/proof" ;
    skos:note "Steps: 1. Specify kernel, growth parameter interval and finite-memory truncation error. 2. Continue Fibonacci, Lucas and bijugate branches with interval arithmetic. 3. Certify hyperbolicity and trapping neighborhoods. 4. Run a validated box-cover basin computation and formally check interval certificates." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: Validated numerics infrastructure for the model's discontinuous least-repulsion placement rule." ;
    skos:note "Tool: interval-arithmetic" ;
    skos:note "Tool: dynamical-systems" ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: simulation" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-06> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-09> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch14-02> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/phyllotaxis-attractor-classification> a delphi:Concept, schema:Question ;
    rdfs:label "Rigorous classification of attractors in dynamical phyllotaxis" .



}

