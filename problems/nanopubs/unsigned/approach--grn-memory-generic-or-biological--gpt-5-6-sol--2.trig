sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/grn-memory-generic-or-biological--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Dynamical motif attribution of memory" ;
    dct:subject <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> ;
    dct:description "Identify whether memory enrichment is explained by specific feedback motifs rather than biological origin. Enumerate signed three- and four-node motifs, sample kinetic parameters by Latin hypercube, and estimate each motif's memory probability. Decompose each BioModels network's prediction with motif counts and targeted edge ablations." ;

    delphi:proposedTest "A motif mechanism is established if its presence increases memory probability by at least 0.25 and deleting it abolishes memory in at least 80% of predicted biological models while matched control deletions do not." ;
    delphi:context "Fails if: Memory depends on diffuse parameter combinations and no motif has stable effects across kinetic families." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Enumerate nonisomorphic signed motifs with self-loops handled explicitly. 2. Run at least 10000 parameter sets per motif under the fixed memory protocol. 3. Fit a sparse hierarchical predictor from motif content to memory behavior. 4. Ablate predicted motifs in biological models and matched nulls." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Combinatorial parameter sweeps are expensive and motif effects may be context-dependent." ;
    skos:note "Tool: ode-simulation" ;
    skos:note "Tool: network-enumeration" ;
    skos:note "Tool: large-scale-computation" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-16> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> a delphi:Concept, schema:Question ;
    rdfs:label "Is memory in gene regulatory network models generic or a biological signature?" .



}

