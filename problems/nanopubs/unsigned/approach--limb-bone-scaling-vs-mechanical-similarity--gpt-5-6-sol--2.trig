sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/limb-bone-scaling-vs-mechanical-similarity--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Mechanistic safety-factor scaling with posture compensation" ;
    dct:subject <https://w3id.org/delphi/resource/problem/limb-bone-scaling-vs-mechanical-similarity> ;
    dct:description "For a mammal subset with force-plate or published peak ground-reaction forces, combine body mass, limb effective mechanical advantage, bone length and CT-derived section modulus to estimate peak bending plus axial stress and safety factor. Fit two causal models: geometry-only similarity and posture-compensated stress similarity. Use measurement-error propagation and leave-clade-out prediction; the target is whether nearly flat safety factors arise only after posture is included." ;

    delphi:proposedTest "Posture compensation is supported if the mass slope of log safety factor has absolute value below 0.05 only in the posture model, and that model lowers held-out stress RMSE by at least 20% relative to geometry-only similarity." ;
    delphi:context "Fails if: Fewer than 40 matched species, a non-flat safety-factor slope after posture, or no predictive gain means the approach fails to explain scaling by mechanical similarity." ;
    delphi:hypothesisType "approach/mixed" ;
    skos:note "Steps: 1. Scout at least 40 species with matchable gait force, posture and limb geometry records. 2. Pre-register load decomposition, muscle-force bounds and admissible taxonomic matching. 3. Estimate stress and safety-factor allometry with and without posture. 4. Test predictions in a held-out clade and conduct sensitivity analysis over material strength." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: The necessary force, posture, CT geometry and material-strength measurements are not known to coexist publicly for 40 species." ;
    skos:note "Tool: comparative-biomechanics" ;
    skos:note "Tool: ct-morphometry" ;
    skos:note "Tool: phylogenetic-regression" ;
    skos:note "Tool: uncertainty-propagation" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch02-03> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch16-04> ;
    skos:note "Dataset (no resolvable link): Published mammalian locomotor force and limb-geometry records. Species are admissible only when posture and geometry can be matched without genus-level substitution." ;

    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/limb-bone-scaling-vs-mechanical-similarity> a delphi:Concept, schema:Question ;
    rdfs:label "How do limb bones actually scale with body mass?" .



}

