sub:assertion {
  <https://w3id.org/delphi/resource/approach/rule110-universality-machine-checked--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Formalize cyclic-tag universality before any glider" ;
    dct:subject <https://w3id.org/delphi/resource/problem/rule110-universality-machine-checked> ;
    dct:description "Separate the computability half of Cook's argument from the cellular-automaton half, so a bug in a glider collision cannot hide inside a tag-system lemma. Define a cyclic tag system as a finite list of appendants, a binary work string, and the rotation that appends the next word and deletes the front bit. Formalize the Cocke–Minsky simulation of a binary Turing machine by a 2-tag system, then Cook's simulation of a 2-tag system by a cyclic tag system. The main theorem is: for every Turing machine and input there is a cyclic tag system and an encoding of the input such that the tag system halts if and only if the machine does, with an explicit bound on the number of tag steps per machine step. Do not mention Rule 110 in this module. Hypotheses that Cook leaves informal (the precise halting convention, the treatment of the empty appendant) stay as named hypotheses rather than as sorry." ;

    delphi:proposedTest "A no-sorry theorem that cyclic tag systems simulate every Turing machine, with the step overhead as a proved bound." ;
    delphi:context "Fails if: A one-step correspondence fails on a finite witness (a tag system whose encoded run disagrees with the machine), or the halting convention cannot be stated without an extra axiom." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Define Turing machines, 2-tag systems and cyclic tag systems with explicit halting. 2. Formalize the Cocke–Minsky encoding and prove one-step correspondence. 3. Formalize Cook's tag-to-cyclic-tag encoding and prove one-step correspondence. 4. Compose the two simulations and extract the overhead bound. 5. Audit axioms. Leave Rule 110 out of the imports." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: lean4" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch11-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch01-07> ;

    rdfs:seeAlso <https://doi.org/10.25088/ComplexSystems.15.1.1> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.tcs.2008.09.051> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/rule110-universality-machine-checked> a delphi:Concept, schema:Question ;
    rdfs:label "Machine-check the universality of Rule 110" .


  <https://doi.org/10.25088/ComplexSystems.15.1.1> dct:title "Universality in Elementary Cellular Automata" ;
    dct:bibliographicCitation "Cook 2004, cyclic tag systems and the reduction from tag systems" .
  <https://doi.org/10.1016/j.tcs.2008.09.051> dct:title "The complexity of small universal Turing machines: A survey" ;
    dct:bibliographicCitation "Woods and Neary 2009, survey of the small-machine and tag-system chain" .
}

