    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/kelvin-problem-in-epithelia--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Certified local optimality of Weaire-Phelan" ;
    dct:subject <https://w3id.org/delphi/resource/problem/kelvin-problem-in-epithelia> ;
    dct:description "Restrict the mathematical problem to periodic partitions with fixed Weaire-Phelan combinatorics and finite-dimensional face perturbations. Compute the second variation of area under volume constraints, quotient translation and gauge modes, and certify positive definiteness with interval arithmetic; formalize the constrained Hessian argument in Lean." ;

    delphi:proposedTest "A checked positive lower bound on the constrained Hessian after all symmetry zero modes are removed, proving strict local optimality for the declared perturbation class." ;
    delphi:context "Fails if: A certified negative mode gives an explicit area-lowering perturbation, disproving local optimality in that class." ;
    delphi:hypothesisType "approach/proof" ;
    skos:note "Steps: 1. Specify a finite periodic fundamental cell and exact constraint manifold. 2. Derive first- and second-variation formulas symbolically. 3. Bound geometric coefficients and Hessian eigenvalues by intervals. 4. Check a Lean theorem converting the certificate to strict local minimality in the restricted class." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: A tractable exact representation of curved interfaces and a bridge from finite perturbations to arbitrary variations." ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: interval-arithmetic" ;
    skos:note "Tool: surface-optimization" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-16> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/kelvin-problem-in-epithelia> a delphi:Concept, schema:Question ;
    rdfs:label "Kelvin's problem in epithelia" .



}

