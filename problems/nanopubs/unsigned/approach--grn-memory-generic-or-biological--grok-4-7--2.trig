sub:assertion {
  <https://w3id.org/delphi/resource/approach/grn-memory-generic-or-biological--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Factor topology against kinetics in the memory rate" ;
    dct:subject <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> ;
    dct:description "Cross two factors the single matched null confounds. Arm A keeps the biological reaction graph and redraws parameters from the same magnitude distribution. Arm B rewires the graph to the same degree sequence and keeps the original parameters. Arm C does both and is the null from the first approach. Each arm has the same 10 networks per model. The biological-signature claim for topology survives only if arm A still shows the enrichment and arm B does not. The claim for kinetics survives only if arm B shows it and arm A does not. If arm A already loses the enrichment, topology is not the carrier. Pre-register that split before looking at which arm wins." ;

    delphi:proposedTest "A four-way call: enrichment in A only (topology), B only (kinetics), both, or neither, using the same p-value and 20-of-35 rule in each arm." ;
    delphi:context "Fails if: Arm C differs from the first approach's null on the same seeds, which means the factor arms are not comparable. Substantively, enrichment in neither arm refutes a biological signature of either factor." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Build arms A, B and C with the shared size match. 2. Run the same five probes. 3. Test enrichment separately in each arm. 4. Assign the effect to topology, kinetics, both, or neither by the pre-registered pattern. 5. Do not reinterpret the pattern after seeing it." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Tool: ode-simulation" ;
    skos:note "Tool: biomodels" ;
    skos:note "Tool: random-network-nulls" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-16> ;
    rdfs:seeAlso <https://www.ebi.ac.uk/biomodels/> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.isci.2021.102131> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> a delphi:Concept, schema:Question ;
    rdfs:label "Is memory in gene regulatory network models generic or a biological signature?" .

  <https://www.ebi.ac.uk/biomodels/> dct:title "BioModels" ;
    dct:description "Source graphs and parameter magnitudes for the three arms." .
  <https://doi.org/10.1016/j.isci.2021.102131> dct:title "Gene regulatory networks exhibit several kinds of memory: Quantification of memory in biological and random transcriptional networks" ;
    dct:bibliographicCitation "Biswas et al. 2021, the probes held fixed across arms" .
}

