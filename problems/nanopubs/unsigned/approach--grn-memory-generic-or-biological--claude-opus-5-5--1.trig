sub:assertion {
  <https://w3id.org/delphi/resource/approach/grn-memory-generic-or-biological--claude-opus-5-5--1> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Re-run the Biswas protocol on 35 BioModels and ≥ 350 matched random ODE networks" ;
    dct:subject <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> ;
    dct:description "Reimplement the Biswas et al. 2021 protocol: choose stimulus nodes (UCS, CS) and a response node, apply the stimulus schedules for each memory type (UCS-based, pairing, transfer, associative, consolidation) and score memory by the paper's criteria and thresholds. Validate by reproducing their per-model memory calls on the 35 BioModels models (agreement ≥ 90% required before proceeding). Null ensemble: for each biological model, generate 10 random networks matched on node count, edge count and density, in- and out-degree sequences (configuration model), kinetic forms (mass-action and Hill terms in the same proportions, with Hill coefficients drawn from the model's empirical distribution), parameter values drawn from the model's own log-parameter distribution, and stability (retain only networks with a stable steady state from the default initial condition, as biological models have). Simulate with libRoadRunner. Statistic: per memory type, the fraction of (network, stimulus/response triple) combinations showing memory, biological versus random. Pre-registered: 'biological signature' if the biological rate exceeds the random rate by ≥ 2× with a stratified permutation p < 0.01; 'generic' if the ratio is ≤ 1.2." ;

    delphi:proposedTest "Per memory type, the ratio of memory rates in biological versus matched random networks with permutation p. A ratio ≥ 2 supports the biological-signature reading and ≤ 1.2 supports 'generic nonlinear dynamics', which is the problem's stated falsifier." ;
    delphi:context "Fails if: Reproduction of the original calls falls below 90% agreement because protocol details are underspecified in the paper, so any comparison tests a different protocol." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Reimplement the protocol; validate against the paper's reported calls; publish the discrepancy list. 2. Write result.json with matching criteria, statistic and thresholds before simulating random networks. 3. Generate ≥ 350 matched random networks; check matching statistics. 4. Run all protocols; compute rates and ratios with stratified permutation p-values; publish code and seeds." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): tractable" ;
    skos:note "Tool: ode-simulation" ;
    skos:note "Tool: biomodels" ;
    skos:note "Tool: random-network-nulls" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-14> ;
    skos:related <https://w3id.org/delphi/resource/claim/levin-2022-grn-learning-16> ;
    rdfs:seeAlso <https://www.ebi.ac.uk/biomodels/> ;
    rdfs:seeAlso <https://doi.org/10.1016/j.isci.2021.102131> ;
    rdfs:seeAlso <https://doi.org/10.3390/ijms24010285> ;
    rdfs:seeAlso <https://github.com/sys-bio/roadrunner> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/claude-opus-5-5.json> .
  <https://w3id.org/delphi/resource/problem/grn-memory-generic-or-biological> a delphi:Concept, schema:Question ;
    rdfs:label "Is memory in gene regulatory network models generic or a biological signature?" .

  <https://www.ebi.ac.uk/biomodels/> dct:title "BioModels" ;
    dct:description "The 35 curated SBML models used by Biswas et al." .
  <https://doi.org/10.1016/j.isci.2021.102131> dct:title "Gene regulatory networks exhibit several kinds of memory: Quantification of memory in biological and random transcriptional networks" ;
    dct:bibliographicCitation "Biswas, Manicka, Hoel and Levin 2021, Gene regulatory networks exhibit several kinds of memory" .
  <https://doi.org/10.3390/ijms24010285> dct:title "Learning in Transcriptional Network Models: Computational Discovery of Pathway-Level Memory and Effective Interventions" ;
    dct:bibliographicCitation "Biswas, Clawson and Levin 2022, Learning in transcriptional network models" .
  <https://github.com/sys-bio/roadrunner> dct:bibliographicCitation "libRoadRunner SBML simulator" .
}

