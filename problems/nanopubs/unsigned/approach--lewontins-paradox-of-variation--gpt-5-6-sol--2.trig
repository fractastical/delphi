sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/lewontins-paradox-of-variation--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Genome-window test of linked-selection predictions" ;
    dct:subject <https://w3id.org/delphi/resource/problem/lewontins-paradox-of-variation> ;
    dct:description "Within species, use genome windows to avoid uncertain census sizes. For at least 20 species with polymorphism, recombination and annotation data, preregister the reduction in neutral diversity near conserved or selected sites predicted by background-selection maps, then aggregate the measured maximum genome-wide reduction into a cross-species upper bound on how much linked selection can compress diversity." ;
    schema:additionalProperty <https://w3id.org/delphi/resource/approach/lewontins-paradox-of-variation--gpt-5-6-sol--2#n_species> ;
    delphi:proposedTest "If linked selection explains at least 80% of within-genome neutral-diversity variance and corrected cross-species diversity spans under two orders of magnitude, it is sufficient for the tested taxa; a corrected span above three orders refutes sufficiency." ;
    delphi:context "Fails if: Neutral-site definitions or recombination maps are incomparable enough that chromosome-held-out prediction R2 is below 0.1 in more than half the species." ;
    delphi:hypothesisType "approach/data-test" ;
    skos:note "Steps: 1. Select species and neutral-site filters without inspecting diversity-recombination associations. 2. Fit a common monotone recombination-diversity model with species-specific intercepts. 3. Cross-validate chromosome-held-out predictions and estimate diversity absent linked selection. 4. Regress corrected diversity on GBIF range and life-history proxies." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Harmonized population-genomic callsets and recombination maps." ;
    skos:note "Tool: large-scale-computation" ;
    skos:note "Tool: gbif" ;
    skos:note "Tool: data-test" ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-heterozygosity> ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-neutral-theory> ;
    skos:related <https://w3id.org/delphi/resource/claim/kimura-substitution-rate> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/lewontins-paradox-of-variation> a delphi:Concept, schema:Question ;
    rdfs:label "Lewontin's paradox of variation" .
  <https://w3id.org/delphi/resource/approach/lewontins-paradox-of-variation--gpt-5-6-sol--2#n_species> a schema:PropertyValue ;
    schema:propertyID "n_species" ;
    schema:value 20 ;
    schema:description "species the approach proposes to use, as stated in its description (a planned sample size, not a measurement)" .


}

