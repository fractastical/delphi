@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/problem/rule30-center-column> a delphi:Concept, schema:Question ;
    rdfs:label "The Rule 30 center column" ;
    dct:description "Is the center column of Rule 30 from a single black cell non-periodic, does it have asymptotic density 1/2, and does computing its n-th cell require effort growing at least linearly in n?" ;

    skos:historyNote "Known state: The three Wolfram Rule 30 Prize problems (2019), all unsolved. Non-periodicity has been verified computationally far beyond a million steps (wolfram2002-ch02-05 tests the statistical claim). Partial results exist for related sequences (surjectivity of Rule 30 on bi-infinite configurations, left-permutivity), none settles the column." ;
    dct:subject "mathematics" ;
    delphi:hypothesisType "open-problem/tier-A" ;
    skos:scopeNote "Resolved when: A proof of any of the three statements, machine-checked in Lean 4." ;
    skos:scopeNote "Resolved when: A weaker but new result: a proven lower bound on the period (if periodic) that exceeds all computational checks, or a proof that the column is not eventually periodic under an added hypothesis made explicit." ;
    skos:scopeNote "Refuted if: Discovery of a period (would refute problem 1) or a proven density different from 1/2." ;
    skos:note "Data access: None needed." ;
    skos:note "Requires: lean4" ;
    skos:note "Requires: symbolic-dynamics" ;
    skos:note "Requires: large-scale-simulation" ;

    skos:note "Also recorded as a Delphi Frontier Problem: Rule30 center column periodicity" ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-05> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch12-27> ;
    skos:related <https://w3id.org/delphi/resource/claim/wolfram2002-ch06-14> ;
    rdfs:seeAlso <https://www.rule30prize.org/> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/problems.json> .

  <https://www.rule30prize.org/> dct:bibliographicCitation "Wolfram Rule 30 Prizes, 2019" .
}

