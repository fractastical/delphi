sub:assertion {
  <https://w3id.org/delphi/resource/approach/kelvin-problem-in-epithelia--grok-4-7--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Anneal equal-volume foams against Weaire–Phelan" ;
    dct:subject <https://w3id.org/delphi/resource/problem/kelvin-problem-in-epithelia> ;
    dct:description "Use Brakke's Surface Evolver. First reproduce the surface area per unit volume of Kelvin's truncated octahedron and of the Weaire–Phelan foam in the same normalization, to a relative tolerance of 10^{-4}. Then anneal 200 random equal-volume periodic foams with 8 cells and 200 with 16 cells, from random seeds declared in advance, with a fixed iteration budget. A counterexample is a foam whose area per unit volume is lower than the reproduced Weaire–Phelan value by more than 10^{-4}. Failure to find one does not prove optimality. The approach settles the mathematical problem only in the counterexample direction. Reproducing the two known areas is a check, not a solution of Kelvin's problem." ;

    delphi:proposedTest "A periodic equal-volume foam whose Surface Evolver area is more than 10^{-4} below the reproduced Weaire–Phelan area, or an honest negative record of the 400-foam search." ;
    delphi:context "Fails if: The search returns Weaire–Phelan as the best candidate. Kelvin's problem stays open. A failure of reproduction beyond 10^{-4} invalidates the comparison." ;
    delphi:hypothesisType "approach/computation" ;
    skos:note "Steps: 1. Reproduce Kelvin and Weaire–Phelan areas to relative 10^{-4}. 2. Declare seeds and the iteration budget. 3. Anneal 200 eight-cell foams and 200 sixteen-cell foams. 4. Compare the best area with Weaire–Phelan. 5. Publish the best foam if it wins, otherwise the negative search record." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): long-shot" ;
    skos:note "Missing: A certificate of global optimality. Annealing cannot supply one. Thirty years of search have not beaten Weaire–Phelan, so a month of random starts is unlikely to." ;
    skos:note "Tool: surface-evolver" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-04> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-11> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch07-08> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch09-16> ;
    rdfs:seeAlso <https://kenbrakke.com/evolver/evolver.html> ;
    rdfs:seeAlso <https://doi.org/10.1080/09500839408241577> ;
    rdfs:seeAlso <https://doi.org/10.1007/s004540010071> ;
    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/ee98025a1960b300fcc06aa2106f51118b60f565/problems/approaches/grok-4-7.json> .
  <https://w3id.org/delphi/resource/problem/kelvin-problem-in-epithelia> a delphi:Concept, schema:Question ;
    rdfs:label "Kelvin's problem in epithelia" .

  <https://kenbrakke.com/evolver/evolver.html> dct:title "Surface Evolver" ;
    dct:description "Ken Brakke's Surface Evolver, used for both reproduction and the random search." .
  <https://doi.org/10.1080/09500839408241577> dct:title "A counter-example to Kelvin's conjecture on minimal surfaces" ;
    dct:bibliographicCitation "Weaire and Phelan 1994, A counter-example to Kelvin's conjecture" .
  <https://doi.org/10.1007/s004540010071> dct:title "The Honeycomb Conjecture" ;
    dct:bibliographicCitation "Hales 2001, The honeycomb conjecture, the settled two-dimensional analogue, not the target" .
}

