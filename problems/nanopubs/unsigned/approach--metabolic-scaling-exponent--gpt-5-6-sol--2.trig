sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/approach/metabolic-scaling-exponent--gpt-5-6-sol--2> a prov:Plan, delphi:TestableHypothesis ;
    rdfs:label "Formal audit of the WBE exponent derivation" ;
    dct:subject <https://w3id.org/delphi/resource/problem/metabolic-scaling-exponent> ;
    dct:description "Encode an idealized branching network with branch ratio, length ratio, radius ratio, terminal-unit invariance and space-filling assumptions. Prove each exponent implication separately in Lean, including where area preservation or impedance minimization enters, and construct countermodels when assumptions are weakened." ;

    delphi:proposedTest "A no-sorry theorem stating the minimal explicit hypotheses implying exponent 3/4, plus checked countermodels showing which omitted hypotheses destroy the conclusion." ;
    delphi:context "Fails if: The biological assumptions cannot be stated without directly assuming the desired scaling relation, showing that the derivation has no independent formal content." ;
    delphi:hypothesisType "approach/formalization" ;
    skos:note "Steps: 1. Represent finite self-similar trees and derive total serviced volume and network volume. 2. Prove logarithmic exponent lemmas with positivity and nondegeneracy hypotheses. 3. Derive 3/4 only from a named minimal assumption set. 4. Use exact finite trees to exhibit assumption-compatible alternatives producing 2/3 or other exponents." ;
    skos:note "Difficulty (proposer's estimate of completion within about a month of agent time): hard" ;
    skos:note "Missing: Formalization settles logical validity, not whether organisms satisfy the assumptions." ;
    skos:note "Tool: lean4" ;
    skos:note "Tool: symbolic-computation" ;
    skos:note "Tool: allometry" ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch03-07> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch02-01> ;
    skos:related <https://w3id.org/delphi/resource/claim/thompson1917-ch03-10> ;


    rdfs:isDefinedBy <https://github.com/fractastical/delphi/blob/e77f4bcffb077981b60f1e3aea24b72c7a36b2fc/problems/approaches/gpt-5-6-sol.json> .
  <https://w3id.org/delphi/resource/problem/metabolic-scaling-exponent> a delphi:Concept, schema:Question ;
    rdfs:label "Is there a universal metabolic scaling exponent?" .



}

