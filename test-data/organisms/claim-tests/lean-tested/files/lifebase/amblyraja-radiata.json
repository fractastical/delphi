  "morphdat": [
   {
    "autoctr": 1871,
    "Speccode": 2565,
    "StockCode": 2761,
    "MorphDatRefNo": 3167,
    "BodyShapeI": "other",
    "TypeofScales": "placoid scales",
    "Spiracle": "present",
    "Dfinno": 2,
    "Adifin": "absent",
    "PectoralAttributes": "transformed to 'aerofoils'",
    "PelvicsAttributes": "more or less normal",
    "VPosition": "abdominal",
    "VPosition2": "before origin of D1",
    "Entered": 113,
    "DateEntered": "1996-11-25T00:00:00",
    "Modified": 303,
    "DateModified": "2017-11-15T00:00:00",
    "AddChars": "Adults are rhomboid in shape, young are rounder (Ref. 7251). Short, stiff, bluntly triangular snout; tail shorter than body (Ref. 5578). Upper surface very rough, with solid thornlets scattered all over disc and tail, underside smooth, except for some prickles on snout; a constant pattern of separate orbital thorns, a regular row of 13-17 large thorns from nape to first dorsal fin (Ref. 3167); large, close-set thorns with star-shaped bases at upper disc (Ref. 5578). Coloration highly variable; brownish grey with scattered irregular black blotches dorsally; white ventrally; with darker spots and blotches on tail and pelvic fins; black spot on tip of tail (Ref. 2708).",
    "SimilarSpecies1": 2059,
    "SimilarSpec1Remarks": "<i>Raja clavata</i> can be differentiated by its different color patterns, the location of the\r\ndorsal fins, and different arrangements of thorns, including far more numerous thorns\r\non the dorsal surface and in the median row.\r\n",
    "OtherRef1": 5578,
    "OtherRef2": 6902
   }
