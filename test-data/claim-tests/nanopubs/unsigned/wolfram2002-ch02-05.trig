    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-05--claim-test> a delphi:Assessment ;
    rdfs:label "Claim test of wolfram2002-ch02-05: supports, confidence 0.85" ;
    delphi:assessmentType "claim-test/0.1.0" ;
    delphi:hasVerdict "supports" ;
    delphi:hasConfidence "0.85"^^xsd:double ;
    delphi:hypothesis "The first 1,000,000 values of the centre column of elementary rule 30 started from a single black cell are not eventually periodic within that range, and the bit sequence passes the NIST SP 800-22 statistical test battery at the standard significance level." ;
    delphi:passCriterion "Pre-registered. (1) Non-repetition: for every period p in 1..500000, the final matching suffix of x[t] = x[t - p] has length less than p (no tail of the million-step sequence consists of at least two full periods of any period p <= N/2). (2) Randomness: run the following tests, implemented in numpy following NIST SP 800-22 rev. 1a, on the 1,000,000-bit sequence: frequency (monobit), block frequency (M = 128), runs, longest run of ones (M = 10000), binary matrix rank (32 x 32), discrete Fourier transform, non-overlapping template matching (m = 9, template 000000001, N = 8 blocks), overlapping template matching (m = 9, M = 1032), Maurer's universal (L = 7, Q = 1280), linear complexity (M = 500), serial (m = 16; two p-values), approximate entropy (m = 10), cumulative sums (forward and backward), random excursions (8 states) and random excursions variant (18 states), i.e. about 41 p-values. 'supports' if (1) holds, no p-value is below 1e-4, and at most 2 p-values are below 0.01 (the NIST alpha; with 41 p-values the chance of 3 or more below 0.01 under randomness is about 0.8 %). Cross-check (not part of the verdict): the first 100,000 computed bits must agree with the OEIS A051023 b-file; a disagreement means the generator is wrong and the verdict becomes 'inconclusive' with reason 'other'." ;
    delphi:failCriterion "Pre-registered. 'refutes' if any period is found under (1), or if any p-value is below 1e-6, or if 4 or more p-values are below 0.01. Otherwise (e.g. exactly 3 p-values below 0.01, or one between 1e-6 and 1e-4) -> 'mixed'. Random-excursions tests are only applied if the number of cycles J >= 500 as NIST requires; if not applicable they are simply omitted from the count." ;
    delphi:expectedObservation "Pre-registered. (1) Non-repetition: for every period p in 1..500000, the final matching suffix of x[t] = x[t - p] has length less than p (no tail of the million-step sequence consists of at least two full periods of any period p <= N/2). (2) Randomness: run the following tests, implemented in numpy following NIST SP 800-22 rev. 1a, on the 1,000,000-bit sequence: frequency (monobit), block frequency (M = 128), runs, longest run of ones (M = 10000), binary matrix rank (32 x 32), discrete Fourier transform, non-overlapping template matching (m = 9, template 000000001, N = 8 blocks), overlapping template matching (m = 9, M = 1032), Maurer's universal (L = 7, Q = 1280), linear complexity (M = 500), serial (m = 16; two p-values), approximate entropy (m = 10), cumulative sums (forward and backward), random excursions (8 states) and random excursions variant (18 states), i.e. about 41 p-values. 'supports' if (1) holds, no p-value is below 1e-4, and at most 2 p-values are below 0.01 (the NIST alpha; with 41 p-values the chance of 3 or more below 0.01 under randomness is about 0.8 %). Cross-check (not part of the verdict): the first 100,000 computed bits must agree with the OEIS A051023 b-file; a disagreement means the generator is wrong and the verdict becomes 'inconclusive' with reason 'other'." ;
    delphi:disconfirmingObservation "Pre-registered. 'refutes' if any period is found under (1), or if any p-value is below 1e-6, or if 4 or more p-values are below 0.01. Otherwise (e.g. exactly 3 p-values below 0.01, or one between 1e-6 and 1e-4) -> 'mixed'. Random-excursions tests are only applied if the number of cycles J >= 500 as NIST requires; if not applicable they are simply omitted from the count." ;
    delphi:admissibleDatasets "Planned datasets: nks-ch02-05-rule30-center-column-generator, oeis-a051023-bfile" ;
    delphi:inferenceMethod "analysis.py evolves rule 30 from a single black cell for 10^6 steps with bit-packed numpy (uint64 words), updating only the words inside the light cone of the centre cell at the final step, and records the centre cell at every step (generation 17 s). The first 100,001 bits were compared with the OEIS A051023 b-file. Eventual periodicity was tested for every p <= 500000 by computing the length of the longest suffix with x[t] = x[t-p] using big-integer XOR, counting a period when that length is at least p and at least 64 bits. Fifteen NIST SP 800-22 statistics (frequency, block frequency M=128, runs, longest run M=10000, 32x32 matrix rank, DFT, non-overlapping template 000000001, overlapping template m=9, Maurer universal L=7/Q=1280, linear complexity M=500 via Berlekamp-Massey, serial m=16 (2), approximate entropy m=10, cumulative sums forward/backward) were implemented in numpy/scipy from the NIST specification and validated on numpy pseudo-random bits before use; random excursions were not applicable (J = 340 cycles < 500)." ;
    delphi:preregistered false ;
    delphi:dataKind "computational" ;
    dct:description "analysis.py evolves rule 30 from a single black cell for 10^6 steps with bit-packed numpy (uint64 words), updating only the words inside the light cone of the centre cell at the final step, and records the centre cell at every step (generation 17 s). The first 100,001 bits were compared with the OEIS A051023 b-file. Eventual periodicity was tested for every p <= 500000 by computing the length of the longest suffix with x[t] = x[t-p] using big-integer XOR, counting a period when that length is at least p and at least 64 bits. Fifteen NIST SP 800-22 statistics (frequency, block frequency M=128, runs, longest run M=10000, 32x32 matrix rank, DFT, non-overlapping template 000000001, overlapping template m=9, Maurer universal L=7/Q=1280, linear complexity M=500 via Berlekamp-Massey, serial m=16 (2), approximate entropy m=10, cumulative sums forward/backward) were implemented in numpy/scipy from the NIST specification and validated on numpy pseudo-random bits before use; random excursions were not applicable (J = 340 cycles < 500)." ;
    rdfs:comment "Measured: [object Object] count of periods p <= 500000 with at least two full periods (>= 64 bits) at the end of the sequence; NIST p-values (n = 1000000, deterministic sequence; p-values are those of the NIST statistics). Interpretation: 'Never repeats' is read as 'is not eventually periodic within the first million steps' (an eventually periodic sequence shows at least two full periods before the end). 'Statistical tests show no meaningful deviation from perfect randomness' is read relative to the fixed, public NIST SP 800-22 battery at alpha = 0.01, as the assessors suggested; passing it cannot establish randomness, only the absence of the deviations those tests detect, so the test can refute but only weakly confirm. The battery is implemented from the NIST specification in analysis.py rather than by running the NIST C code, so the p-values are reproducible from a clean checkout." ;
    delphi:evidenceAgainst "Deviation from the literal pre-registration, decided on synthetic random bits before the rule 30 sequence was examined: the periodicity criterion 'suffix length >= p' flags chance matches at tiny p (a random sequence ending in 0101 has two full periods of p = 2), so a minimum matching-suffix length of 64 bits was added. For rule 30 the longest periodic suffix over all p is 17 bits (at p = 166992), so the verdict is the same under either version of the criterion." ;
    delphi:evidenceAgainst "The battery is a faithful numpy re-implementation of 15 NIST SP 800-22 statistics, not the NIST reference C code; it was checked on pseudo-random input, on an LFSR of known linear complexity and on constructed periodic sequences. Every p-value lies between 0.10 and 0.82, with none below 0.01, so no test detected a deviation; passing a finite battery cannot establish 'perfect randomness', only the absence of the regularities these tests detect, and that is the scope the claim's own wording ('none of the tests I have ever done') allows." ;
    delphi:evidenceAgainst "Random excursions and random excursions variant were omitted because the sequence has only 340 zero-crossing cycles, below the 500 NIST requires." ;
    delphi:evidenceAgainst "Black-cell frequency over the million steps is 0.50077 (frequency-test p = 0.12), consistent with the claim's implicit 50/50 balance." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-05--claim-test--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-05--claim-test--dataset-2> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-claude-fable-5-1> ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/ad1bcb137661aae2fecd70fc14b1ae33fda5f2c9/test-data/claim-tests/wolfram-nks/wolfram2002-ch02-05/result.json> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-05--claim-test--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Centre column of elementary cellular automaton rule 30 from a single black cell, steps 0..999999, computed exactly by analysis.py (bit-packed numpy evolution restricted to the light cone of the centre cell at step 10^6)" ;
    dct:description "the sequence under test" ;
    prov:wasDerivedFrom <https://www.wolframscience.com/nks/p28--how-do-simple-programs-behave/> ;
    dct:license "generated" .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-05--claim-test--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Dataset: OEIS A051023 (centre column of rule 30), b-file with 100001 terms" ;
    dct:description "independent published copy of the first 100,000 terms, used to validate the generator" ;
    delphi:hasChecksum "sha256:4d0c4a0272bc2b0fb5c1e91281d6dffc757d67cd6ffd8aa9f7486dac4685c1a9" ;
    prov:atLocation <https://oeis.org/A051023/b051023.txt> ;
    prov:wasDerivedFrom <https://oeis.org/A051023> ;
    dct:license "CC BY-SA 4.0 (OEIS)" .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-05--claim-test> .
}

