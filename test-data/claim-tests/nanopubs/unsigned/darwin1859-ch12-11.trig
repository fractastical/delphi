    delphi:hasChecksum "sha256:06bccfc9b300b9b335a65d1432bc64090022358d48f9fb550ad84216d3adad60" ;
    prov:atLocation <https://api.gbif.org/v1/species/match?name=Chiroptera&rank=ORDER&kingdom=Animalia&strict=true> ;
