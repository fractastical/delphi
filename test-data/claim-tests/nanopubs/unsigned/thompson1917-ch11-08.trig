    dct:license "CC0 1.0" .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-08--claim-test--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Data from: Iterative ontogenetic development of ammonoid conch shapes from the Devonian through to the Jurassic (Walton & Korn)" ;
    dct:description "ammonoid diameter series" ;
    delphi:hasChecksum "sha256:fbe2012f1d420ef7b292141ae0ed0ea8d046c4c15303663565dc72e0727ebe40" ;
    prov:atLocation <https://zenodo.org/api/records/4937032/files/Ontogenetic_Conch_Parameter_Data.xlsx/content> ;
