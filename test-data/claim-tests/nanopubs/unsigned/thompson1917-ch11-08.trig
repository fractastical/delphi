    dct:license "CC0 1.0" .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch11-08--claim-test--dataset-3> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Data associated with: Going round the twist - An empirical analysis of shell coiling in helicospiral gastropods" ;
    dct:description "gastropod aperture-radius series" ;
    delphi:hasChecksum "sha256:edab9e356820a43984bcf8130359ec29f7e6c00ca3995292fcd922ba2cb3a2a9" ;
