    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--claim-test> a delphi:Assessment ;
    rdfs:label "Claim test of darwin1859-ch12-05: supports, confidence 0.85" ;
    delphi:assessmentType "claim-test/0.1.0" ;
    delphi:hasVerdict "supports" ;
    delphi:hasConfidence "0.85"^^xsd:double ;
    delphi:hypothesis "Oceanic islands have few native vascular plant species but a high proportion of them are endemic (found nowhere else), higher than mainland regions have, even though the islands are far smaller." ;
    delphi:passCriterion "Pre-registered. Using the World Checklist of Vascular Plants, for every TDWG level-3 area compute the native accepted species count S and the proportion E/S of those species that are native to no other level-3 area. Oceanic islands are the 63 level-3 areas pre-registered as 'oceanic' in derived/island_classes.csv; the mainland comparison set is every level-3 area not listed in that file as any kind of island. Areas (km2) are computed from the TDWG WGSRPD level-3 polygons. The claim is SUPPORTED if (i) the median S of oceanic islands is below the median S of mainland areas ('scanty'), (ii) the median E/S of oceanic islands with at least 20 native species is at least twice the median E/S of mainland areas, and (iii) at least 70% of oceanic islands with at least 20 native species lie above the mainland regression line of logit(E/S) on log10(area) ('extremely large relative to their area'). Islands with fewer than 20 native species are excluded from (ii) and (iii) because a proportion is unstable for them." ;
    delphi:failCriterion "Pre-registered. The claim is REFUTED if the median E/S of oceanic islands is not greater than the mainland median, or if fewer than 50% of oceanic islands lie above the mainland area regression line. Other outcomes are 'mixed'. Supplementary: the fraction of oceanic islands with E/S >= 0.25, and the same statistics for the 'other-island' class (continental and arc islands), are reported." ;
    delphi:expectedObservation "Pre-registered. Using the World Checklist of Vascular Plants, for every TDWG level-3 area compute the native accepted species count S and the proportion E/S of those species that are native to no other level-3 area. Oceanic islands are the 63 level-3 areas pre-registered as 'oceanic' in derived/island_classes.csv; the mainland comparison set is every level-3 area not listed in that file as any kind of island. Areas (km2) are computed from the TDWG WGSRPD level-3 polygons. The claim is SUPPORTED if (i) the median S of oceanic islands is below the median S of mainland areas ('scanty'), (ii) the median E/S of oceanic islands with at least 20 native species is at least twice the median E/S of mainland areas, and (iii) at least 70% of oceanic islands with at least 20 native species lie above the mainland regression line of logit(E/S) on log10(area) ('extremely large relative to their area'). Islands with fewer than 20 native species are excluded from (ii) and (iii) because a proportion is unstable for them." ;
    delphi:disconfirmingObservation "Pre-registered. The claim is REFUTED if the median E/S of oceanic islands is not greater than the mainland median, or if fewer than 50% of oceanic islands lie above the mainland area regression line. Other outcomes are 'mixed'. Supplementary: the fraction of oceanic islands with E/S >= 0.25, and the same statistics for the 'other-island' class (continental and arc islands), are reported." ;
    delphi:admissibleDatasets "Planned datasets: kew-wcvp, tdwg-wgsrpd-level3" ;
    delphi:inferenceMethod "Native (non-introduced, non-doubtful) occurrences of 358,113 accepted non-hybrid WCVP v16 species were tabulated by TDWG level-3 area; a species native to exactly one area was counted as endemic to it. Areas (km2) were computed from the WGSRPD level-3 GeoJSON by spherical polygon area. Islands were classified in advance (derived/island_classes.csv): 63 oceanic, 61 other islands, the rest mainland (Antarctica excluded). Medians of native richness and endemic proportion were compared between the 60 oceanic islands with >= 20 native species and 247 mainland areas; logit(endemic proportion) was regressed on log10(area) for mainland areas and the fraction of oceanic islands above that line computed; a one-sided Mann-Whitney test compared the distributions." ;
    delphi:preregistered false ;
    delphi:dataKind "biological" ;
    dct:description "Native (non-introduced, non-doubtful) occurrences of 358,113 accepted non-hybrid WCVP v16 species were tabulated by TDWG level-3 area; a species native to exactly one area was counted as endemic to it. Areas (km2) were computed from the WGSRPD level-3 GeoJSON by spherical polygon area. Islands were classified in advance (derived/island_classes.csv): 63 oceanic, 61 other islands, the rest mainland (Antarctica excluded). Medians of native richness and endemic proportion were compared between the 60 oceanic islands with >= 20 native species and 247 mainland areas; logit(endemic proportion) was regressed on log10(area) for mainland areas and the fraction of oceanic islands above that line computed; a one-sided Mann-Whitney test compared the distributions." ;
    rdfs:comment "Measured: 0.1255 median proportion of native vascular plant species endemic to a single level-3 area, oceanic islands with >= 20 native species (n = 60, Mann-Whitney one-sided p vs mainland = 2.32e-05; IQR 0.031-0.248). Interpretation: Darwin's 'oceanic islands' are read as islands of volcanic or coral origin that have never been connected to a continent (list fixed in derived/island_classes.csv before any data were inspected; continental fragments, island arcs adjacent to continents and shelf islands are placed in a separate 'other-island' class). 'Kinds of inhabitants' is restricted to native vascular plant species because that is what WCVP records; introduced species are excluded. 'Found nowhere else in the world' is read as native to exactly one level-3 area, so for mainland areas 'endemic' means endemic to that botanical country, which is the fairest available analogue. Area is included because the claim says the proportion is large relative to the islands' size." ;
    delphi:evidenceAgainst "Endemism at level-3 scale for mainland areas depends on political boundaries (e.g. 'Peru', 'India') and is inflated in Scandinavia and other parts of Europe by apomictic microspecies (Hieracium, Taraxacum, Ranunculus auricomus group) that WCVP accepts as species, so the mainland baseline is biased upward and the test is conservative with respect to the claim." ;
    delphi:evidenceAgainst "Eleven oceanic islands, nearly all low coral atolls (Cocos-Keeling, Maldives, Laccadives, Marshall, Tuvalu, Phoenix, Nauru, Howland-Baker, Marcus) or recently glaciated sub-Antarctic islands (Crozet, Heard), have no endemic species; the claim's 'often extremely large' is borne out by the high-island group (Hawaii 86%, St Helena 58%, Juan Fernandez 49%, Tristan da Cunha 47%) rather than by every oceanic island, and 25% of oceanic islands exceed 25% endemism." ;
    delphi:evidenceAgainst "Continental and arc islands (the 'other-island' class) show similar endemism (median 11%), so high endemism is a property of isolation generally, not exclusively of oceanic origin; the claim as stated concerns oceanic islands only and is supported for them." ;
    delphi:evidenceAgainst "Island groups are single level-3 units (e.g. the whole Hawaiian archipelago), so single-island endemics within an archipelago are pooled; this does not affect the comparison with mainland units." ;
    delphi:evidenceAgainst "WCVP inventory completeness is uneven, and a species recorded from only one area may sometimes reflect incomplete recording elsewhere rather than true endemism; this affects islands and mainland alike." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--claim-test--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--claim-test--dataset-2> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-claude-fable-5-1> ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/1a9d4d282b93b0233edbeefd3225299a7353333a/test-data/claim-tests/darwin-origin/darwin1859-ch12-05/result.json> .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--claim-test--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Dataset: World Checklist of Vascular Plants (WCVP), Royal Botanic Gardens, Kew" ;
    dct:description "native species per level-3 area and single-area endemics" ;
    delphi:hasChecksum "sha256:d32ea2b3a85e489b14e83bcc9eae7274532e1d113753f7be290d4b2dfde573fa" ;
    prov:atLocation <https://sftp.kew.org/pub/data-repositories/WCVP/wcvp.zip> ;
    prov:wasDerivedFrom <https://powo.science.kew.org/about-wcvp> ;
    dct:license "CC BY 3.0 (per README_WCVP.xlsx in the download)" .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-05--claim-test--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Dataset: TDWG World Geographical Scheme for Recording Plant Distributions, level-3 polygons (GeoJSON, github.com/tdwg/wgsrpd)" ;
    dct:description "area of each level-3 unit and the gazetteer used to classify islands" ;
    delphi:hasChecksum "sha256:c172bcf6aba20e19477adc60aebf0023068f0175dca8480f0760b090dcf64840" ;
    prov:atLocation <https://raw.githubusercontent.com/tdwg/wgsrpd/master/geojson/level3.geojson> ;
    prov:wasDerivedFrom <https://github.com/tdwg/wgsrpd> ;
    dct:license "CC BY 4.0" .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-05> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-05--claim-test> .
}

