    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-16--claim-test> a delphi:Assessment ;
    rdfs:label "Claim test of darwin1859-ch11-16: refutes, confidence 0.7" ;
    delphi:assessmentType "claim-test/0.1.0" ;
    delphi:hasVerdict "refutes" ;
    delphi:hasConfidence "0.7"^^xsd:double ;
    delphi:hypothesis "If Darwin is right, many more European species have become naturalised in La Plata (and, to a lesser degree, in Australia) than species from those southern regions have become naturalised anywhere in Europe: the Europe-to-south naturalisation count should exceed the south-to-Europe count several-fold for each region." ;
    delphi:passCriterion "Using World Checklist of Vascular Plants native and introduced distribution records by TDWG level-3 unit: A_LP = number of species native in Europe (TDWG level-1 region 1) and not native in La Plata that are recorded as introduced in La Plata (units AGE Argentina Northeast and URU Uruguay); B_LP = number of species native in La Plata and not native in Europe that are recorded as introduced in any European unit; likewise A_AU and B_AU for Australia (TDWG level-2 region 50: WAU, NTA, SOA, QLD, NSW, VIC, TAS). Supports if A_LP >= 5 * B_LP and A_AU >= 5 * B_AU." ;
    delphi:failCriterion "Refutes if A_LP < 2 * B_LP or A_AU < 2 * B_AU (no strong asymmetry, or reversed). Otherwise mixed. The secondary clause 'in a lesser degree in Australia' is evaluated as A_LP > A_AU and reported, but is not part of the verdict rule because absolute counts now depend on two centuries of differing colonisation history." ;
    delphi:expectedObservation "Using World Checklist of Vascular Plants native and introduced distribution records by TDWG level-3 unit: A_LP = number of species native in Europe (TDWG level-1 region 1) and not native in La Plata that are recorded as introduced in La Plata (units AGE Argentina Northeast and URU Uruguay); B_LP = number of species native in La Plata and not native in Europe that are recorded as introduced in any European unit; likewise A_AU and B_AU for Australia (TDWG level-2 region 50: WAU, NTA, SOA, QLD, NSW, VIC, TAS). Supports if A_LP >= 5 * B_LP and A_AU >= 5 * B_AU." ;
    delphi:disconfirmingObservation "Refutes if A_LP < 2 * B_LP or A_AU < 2 * B_AU (no strong asymmetry, or reversed). Otherwise mixed. The secondary clause 'in a lesser degree in Australia' is evaluated as A_LP > A_AU and reported, but is not part of the verdict rule because absolute counts now depend on two centuries of differing colonisation history." ;
    delphi:admissibleDatasets "Planned datasets: wcvp-world-checklist-vascular-plants" ;
    delphi:inferenceMethod "analysis.py reads the WCVP distribution table for accepted species, defines Europe as TDWG level-1 region 1, La Plata as level-3 units AGE (Argentina Northeast) + URU (Uruguay), and Australia as level-2 region 50. A_LP is the number of species native in Europe, not native in La Plata, and flagged introduced in La Plata; B_LP is the number native in La Plata, not native in Europe, and flagged introduced in any European unit; A_AU and B_AU likewise for Australia. The pre-registered rule compares A/B ratios with thresholds 5 (supports) and 2 (refutes). Two sensitivity analyses are reported but do not enter the verdict: a wider La Plata (AGE, AGW, AGS, URU, PAR) and a restriction of each source pool to species whose entire native range lies in one TDWG continent (Europe, South America, Australasia)." ;
    delphi:preregistered false ;
    delphi:dataKind "biological" ;
    dct:description "analysis.py reads the WCVP distribution table for accepted species, defines Europe as TDWG level-1 region 1, La Plata as level-3 units AGE (Argentina Northeast) + URU (Uruguay), and Australia as level-2 region 50. A_LP is the number of species native in Europe, not native in La Plata, and flagged introduced in La Plata; B_LP is the number native in La Plata, not native in Europe, and flagged introduced in any European unit; A_AU and B_AU likewise for Australia. The pre-registered rule compares A/B ratios with thresholds 5 (supports) and 2 (refutes). Two sensitivity analyses are reported but do not enter the verdict: a wider La Plata (AGE, AGW, AGS, URU, PAR) and a restriction of each source pool to species whose entire native range lies in one TDWG continent (Europe, South America, Australasia)." ;
    rdfs:comment "Measured: 1.364 ratio of European plant species naturalised in La Plata to La Plata species naturalised in Europe (WCVP) (n = 806, exact counts from WCVP status flags; depends on completeness of introduced-status coding). Interpretation: Darwin's 'productions' is tested for vascular plants, the group for which native and introduced status is coded worldwide at consistent regional units; his La Plata examples (cardoon, thistles, fennel) are plants. 'Naturalised' is mapped to WCVP's 'introduced' flag, which records established alien occurrences in a unit (casual records and cultivated plants are excluded by WCVP's criteria). 'Europe' is TDWG level-1 region 1 (Iceland to the Urals, including the Mediterranean islands and European Russia; Macaronesia is in Africa in TDWG). 'La Plata' is the Rio de la Plata basin lowlands, mapped to Argentina Northeast (which includes Buenos Aires and Entre Rios provinces) plus Uruguay. Species native to both source and recipient regions are excluded. Counts are reported raw (Darwin's 'very many' versus 'extremely few') and as a fraction of each source flora. The claim is about the pattern, not its cause; propagule pressure is discussed in caveats only." ;
    delphi:evidenceAgainst "Primary result: A_LP = 465 European species naturalised in La Plata versus B_LP = 341 La Plata species naturalised in Europe (ratio 1.36, below the refute threshold of 2); A_AU = 837 versus B_AU = 274 (ratio 3.06, between the thresholds). Darwin's direction of asymmetry holds for both regions, but its magnitude ('very many' versus 'extremely few') does not: hundreds of South American and Australian species are coded as introduced in Europe." ;
    delphi:evidenceAgainst "Per source species the pattern is reversed for La Plata: 58 of every 1000 La Plata natives are naturalised in Europe, versus 17 of every 1000 European natives naturalised in La Plata, because the European native pool (27,000 species) is far larger than that of AGE+URU (5,832)." ;
    delphi:evidenceAgainst "WCVP's 'introduced' flag mixes long-established invaders with regionally established aliens whose European foothold may be small; many Australian species recorded as introduced in Europe (Atriplex, Austrostipa, Calotis, Acacia) were historically wool or garden aliens, and some may now be casual or extinct. WCVP intends to exclude casuals, but its coding leans on regional floras of varying strictness, so B counts may be inflated relative to Darwin's 'naturalised'." ;
    delphi:evidenceAgainst "Conversely, the South-American-to-Europe list includes pantropical or widespread weeds (Amaranthus, Alternanthera, Bidens pilosa) that are native in La Plata but may have reached Europe from elsewhere. The continent-confined sensitivity removes these and gives ratios of 0.09 (La Plata) and 0.43 (Australia), but that restriction is biased against Europe, whose natives are mostly shared with Asia or North Africa (only 15 Europe-confined species are naturalised in La Plata), so it is a lower bound on the asymmetry, not a preferred estimate." ;
    delphi:evidenceAgainst "The secondary clause 'in a lesser degree in Australia' is not borne out: more European species are coded introduced in Australia (837) than in AGE+URU (465), in part because Australia is a continent-sized recipient with seven level-3 units and an intensive alien-flora census, whereas La Plata here is two units." ;
    delphi:evidenceAgainst "Darwin's observation dates from the 1830s; naturalisation counts now reflect two centuries of horticultural, agricultural and wool-trade propagule pressure in both directions, which Darwin could not have anticipated. The test addresses the present-day pattern, not whether Darwin's 1859 reading of it was reasonable." ;
    delphi:evidenceAgainst "Only vascular plants are tested; Darwin's 'productions' could include animals, for which no comparably coded global native/introduced checklist exists at regional resolution." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-16--claim-test--dataset-1> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-claude-fable-5-1> ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/ad1bcb137661aae2fecd70fc14b1ae33fda5f2c9/test-data/claim-tests/darwin-origin/darwin1859-ch11-16/result.json> .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch11-16--claim-test--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Dataset: World Checklist of Vascular Plants (WCVP), Royal Botanic Gardens, Kew: wcvp_names.csv and wcvp_distribution.csv in wcvp.zip" ;
    dct:description "accepted species with native and introduced status per TDWG level-3 unit (records flagged extinct or doubtful are dropped)" ;
    delphi:hasChecksum "sha256:d32ea2b3a85e489b14e83bcc9eae7274532e1d113753f7be290d4b2dfde573fa" ;
    prov:atLocation <https://sftp.kew.org/pub/data-repositories/WCVP/wcvp.zip> ;
    prov:wasDerivedFrom <https://powo.science.kew.org/about-wcvp> ;
    dct:license "CC BY 4.0" .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch11-16> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch11-16--claim-test> .
}

