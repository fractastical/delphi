    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-01--claim-test> a delphi:Assessment ;
    rdfs:label "Claim test of darwin1859-ch12-01: supports, confidence 0.75" ;
    delphi:assessmentType "claim-test/0.1.0" ;
    delphi:hasVerdict "supports" ;
    delphi:hasConfidence "0.75"^^xsd:double ;
    delphi:hypothesis "Within each of three classes (insects, molluscs, flowering plants), species of fresh-water families occupy more continents than species of related terrestrial families, and fresh-water genera are more often spread over several continents than terrestrial genera." ;
    delphi:passCriterion "Pre-registered: for every family in the fixed fresh-water and terrestrial lists, GBIF occurrence facets give the set of species and genera recorded (>= 3 records) on each of the six inhabited continents. Per class, compute P_sp = proportion of species recorded on >= 3 continents and P_gen = proportion of genera recorded on >= 3 continents, separately for the fresh-water and the terrestrial family set. SUPPORTS if in all three classes P_sp(fresh-water) > P_sp(terrestrial) AND P_gen(fresh-water) > P_gen(terrestrial), and the pooled species-level continent counts differ in the fresh-water direction (one-sided Mann-Whitney, p < 0.001)." ;
    delphi:failCriterion "Pre-registered: REFUTES if, in at least two of the three classes, P_sp(fresh-water) <= P_sp(terrestrial) or P_gen(fresh-water) <= P_gen(terrestrial). Any other outcome is MIXED. A class with fewer than 200 species in either habitat set is dropped; with fewer than two classes remaining the result is inconclusive (underpowered)." ;
    delphi:expectedObservation "Pre-registered: for every family in the fixed fresh-water and terrestrial lists, GBIF occurrence facets give the set of species and genera recorded (>= 3 records) on each of the six inhabited continents. Per class, compute P_sp = proportion of species recorded on >= 3 continents and P_gen = proportion of genera recorded on >= 3 continents, separately for the fresh-water and the terrestrial family set. SUPPORTS if in all three classes P_sp(fresh-water) > P_sp(terrestrial) AND P_gen(fresh-water) > P_gen(terrestrial), and the pooled species-level continent counts differ in the fresh-water direction (one-sided Mann-Whitney, p < 0.001)." ;
    delphi:disconfirmingObservation "Pre-registered: REFUTES if, in at least two of the three classes, P_sp(fresh-water) <= P_sp(terrestrial) or P_gen(fresh-water) <= P_gen(terrestrial). Any other outcome is MIXED. A class with fewer than 200 species in either habitat set is dropped; with fewer than two classes remaining the result is inconclusive (underpowered)." ;
    delphi:admissibleDatasets "Planned datasets: gbif-occurrence-search-api" ;
    delphi:inferenceMethod "Each pre-registered family was resolved to a GBIF backbone key and, for each of six continents, the occurrence API returned facet counts of speciesKey and genusKey (coordinates present, no geospatial issue, PRESENT, 1900-2026, fossil/living specimens excluded); a species or genus was scored present on a continent with >= 3 records. Per class and habitat set the proportion of species (P_sp) and of genera (P_gen) recorded on >= 3 continents was computed and the fresh-water and terrestrial sets compared; continents-per-species distributions were compared with one-sided Mann-Whitney tests per class and pooled." ;
    delphi:preregistered false ;
    delphi:dataKind "biological" ;
    dct:description "Each pre-registered family was resolved to a GBIF backbone key and, for each of six continents, the occurrence API returned facet counts of speciesKey and genusKey (coordinates present, no geospatial issue, PRESENT, 1900-2026, fossil/living specimens excluded); a species or genus was scored present on a continent with >= 3 records. Per class and habitat set the proportion of species (P_sp) and of genera (P_gen) recorded on >= 3 continents was computed and the fresh-water and terrestrial sets compared; continents-per-species distributions were compared with one-sided Mann-Whitney tests per class and pooled." ;
    rdfs:comment "Measured: 3 classes (of 3 usable) in which both the proportion of species and of genera on >= 3 continents is higher for fresh-water than for terrestrial families (n = 108061, pooled one-sided Mann-Whitney on continents per species (fresh-water > terrestrial): p=3.42e-17). Interpretation: 'Fresh-water species of quite different classes' is operationalised with three classes Darwin names in this section (insects, molluscs, plants), using families whose members live in fresh water, each paired with terrestrial families of the same class and, where possible, the same order (aquatic Adephaga beetles vs. Carabidae; aquatic Heteroptera vs. terrestrial Heteroptera; freshwater snails and mussels vs. land snails; aquatic angiosperm families vs. a fixed list of common terrestrial angiosperm families). 'Enormous range' is given a comparison group as both assessors demanded: a species recorded on three or more continents. 'Allied species prevail throughout the world' = the genus is recorded on three or more continents. Continents follow GBIF's continent field (derived from coordinates), excluding Antarctica. Human-mediated introductions are present in both habitat sets and cannot be separated in GBIF; this is a caveat, not a filter." ;
    delphi:evidenceAgainst "The species-level effect in insects is small (P_sp 0.021 vs 0.018, mean continents 1.14 vs 1.12) although the genus-level effect is large (0.22 vs 0.12); the verdict for insects rests mainly on genera, which is the 'allied species prevail throughout the world' half of the claim." ;
    delphi:evidenceAgainst "Human-mediated introductions inflate multi-continent occurrence in both sets (e.g. Physa acuta, Pomacea, Sphaeriidae among fresh-water taxa; Helicidae, Achatinidae, Rosaceae and Solanaceae crops and weeds among terrestrial taxa) and cannot be separated in GBIF." ;
    delphi:evidenceAgainst "GBIF 'continent' is interpreted from coordinates; records of Oceania and islands are coarse, and species with >= 3 records on 3 continents is a crude proxy for 'enormous range'." ;
    delphi:evidenceAgainst "Family lists were fixed in advance but are a judgement sample, not the whole class; several fresh-water families (Hydrophilidae, Elmidae, Haloragaceae, Menyanthaceae) include terrestrial or amphibious members, which dilutes the contrast." ;
    delphi:evidenceAgainst "Taxonomic splitting differs between groups (e.g. cryptic diversity in fresh-water snails and mussels) and the GBIF backbone's synonymy decides what counts as one species." ;
    delphi:evidenceAgainst "GBIF is a live resource; re-running reproduces the method but counts drift as records are added." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-01--claim-test--dataset-1> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-claude-fable-5-1> ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/ee98025a1960b300fcc06aa2106f51118b60f565/test-data/claim-tests/darwin-origin/darwin1859-ch12-01/result.json> .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch12-01--claim-test--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Dataset: GBIF occurrence search API (facet counts of speciesKey and genusKey per family and continent; GBIF Backbone Taxonomy for family keys)" ;
    dct:description "species and genus occurrence by continent for 11-16 fresh-water and 10-15 terrestrial families in each of three classes" ;
    delphi:hasChecksum "sha256:043da1961a9b3b58c12fa717e28645feecf3ce29b55a8f0c28e58e0b1e51fb65" ;
    prov:atLocation <https://api.gbif.org/v1/species/match?name=Dytiscidae&rank=FAMILY&kingdom=Animalia&strict=true> ;
    delphi:hasChecksum "sha256:cc76c0d39b562738212357a720a3a26a8f41b6f4a78bcd8e912a2cd248ab0117" ;
    prov:atLocation <https://api.gbif.org/v1/occurrence/search?taxonKey=7824&continent=AFRICA&hasCoordinate=true&hasGeospatialIssue=false&occurrenceStatus=PRESENT&year=1900%2C2026&facet=speciesKey&facet=genusKey&facetLimit=100000&limit=0&basisOfRecord=PRESERVED_SPECIMEN&basisOfRecord=HUMAN_OBSERVATION&basisOfRecord=MACHINE_OBSERVATION&basisOfRecord=MATERIAL_SAMPLE&basisOfRecord=OBSERVATION&basisOfRecord=OCCURRENCE&basisOfRecord=MATERIAL_CITATION> ;
    delphi:hasChecksum "sha256:3552cf1a9bf0085e4d8e49c00324a0f8a4204b00d3cac3c4ae4dd7d5f10a940a" ;
    prov:atLocation <https://api.gbif.org/v1/occurrence/search?taxonKey=7824&continent=ASIA&hasCoordinate=true&hasGeospatialIssue=false&occurrenceStatus=PRESENT&year=1900%2C2026&facet=speciesKey&facet=genusKey&facetLimit=100000&limit=0&basisOfRecord=PRESERVED_SPECIMEN&basisOfRecord=HUMAN_OBSERVATION&basisOfRecord=MACHINE_OBSERVATION&basisOfRecord=MATERIAL_SAMPLE&basisOfRecord=OBSERVATION&basisOfRecord=OCCURRENCE&basisOfRecord=MATERIAL_CITATION> ;
    prov:wasDerivedFrom <https://www.gbif.org/developer/occurrence> ;
    dct:license "varies by publisher (CC0 / CC BY / CC BY-NC); API output is aggregated counts" .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch12-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch12-01--claim-test> .
}

