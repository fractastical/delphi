    prov:atLocation <https://upload.wikimedia.org/wikipedia/commons/d/de/Morphology_of_human_corneal_endothelium_in_situ.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled> ;
    prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Morphology_of_human_corneal_endothelium_in_situ.jpg> ;
