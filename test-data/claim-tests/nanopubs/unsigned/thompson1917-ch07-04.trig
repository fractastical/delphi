    delphi:hasChecksum "sha256:4db3ac777f705ce93cdfe2798c6ab05d9998829741fff430e60b946acc67d17e" ;
    prov:atLocation <https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c0/Epidermis_of_Festuca_arundinacea.jpg/1920px-Epidermis_of_Festuca_arundinacea.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail> ;
    prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Epidermis_of_Festuca_arundinacea.jpg> ;
    dct:license "CC BY-SA 4.0" .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch07-04--claim-test--dataset-5> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Aloe vera Cells, 150X.jpg (Wikimedia Commons)" ;
    dct:description "Aloe vera, lower leaf epidermis" ;
    delphi:hasChecksum "sha256:431fcd7480aa2c80e5014e2705fd8036ef24a4b0ff9d8decb39e9b0e432789ba" ;
    prov:atLocation <https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Aloe_vera_Cells%2C_150X.jpg/1920px-Aloe_vera_Cells%2C_150X.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail> ;
    prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Aloe_vera_Cells,_150X.jpg> ;
    dct:license "CC BY-SA 4.0" .
  <https://w3id.org/delphi/resource/activity/thompson1917-ch07-04--claim-test--revision-1> a prov:Activity ;
    rdfs:label "Revision 1 of the thompson1917-ch07-04 claim test (2026-10-31)" ;
    dct:description "Segmenter-bias null (claim-sources/cell-geometry/segmenter_bias.py, results/segmenter-bias/): the same CPSAM v2 checkpoint turns a brick-wall tiling with 100% T-junctions into 3-16% T-junctions and compresses angle SD from 40.5 to 25-26 degrees; a grass-like cell-file tiling goes from 100% to 48-59% T; random Voronoi goes from 14% to 28-31% of junctions within 15 degrees of 120. Cell counts were exact, so the bias is in boundary shape. The measured 0-3% T fractions in the four conforming tissues are below the segmenter floor for a tissue that truly has 100% T-junctions, and grass (49%) matches the segmented cell-file tiling, so its true T fraction is probably near 100%." ;
    prov:startedAtTime "2026-10-31"^^xsd:date ;
    prov:used <https://github.com/fractastical/delphisci/blob/f0720a27be6412b9705e2f221a1710c8442283e3/claim-sources/cell-geometry/results/segmenter-bias/summary.json> ;
    delphi:evidenceAgainst "Before: 4 of 5 tissues conform (confidence 0.6). After: 4 of 5 tissues are not cell-file tissues; margin over the random control is inflated by the segmenter (confidence 0.35)." ;
    prov:wasInformedBy <https://w3id.org/delphi/resource/agent/moltbook-vina>, <https://w3id.org/delphi/resource/agent/moltbook-hivefound> .
  <https://w3id.org/delphi/resource/agent/moltbook-vina> a prov:Agent ;
    foaf:name "vina" ;
    rdfs:comment "asked for a null in which the junction statistics are run on segmenter output for synthetic masks with known non-hexagonal packing" ;
    rdfs:seeAlso <https://www.moltbook.com/post/e06b5458-f19e-4177-ba05-9b0c990af69f#b3696eb0-2271-44af-9d4d-6086324ae860> .
  <https://w3id.org/delphi/resource/agent/moltbook-hivefound> a prov:Agent ;
    foaf:name "hivefound" ;
    rdfs:comment "proposed that every claim carry a disconfirming observation, admissible dataset constraints and inference method as separate fields" ;
    rdfs:seeAlso <https://www.moltbook.com/post/e06b5458-f19e-4177-ba05-9b0c990af69f#a55aa7a0-cf2b-442b-b58a-8ff6018d4165> .
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-04--claim-test> prov:qualifiedRevision <https://w3id.org/delphi/resource/activity/thompson1917-ch07-04--claim-test--revision-1> ;
    dct:contributor <https://w3id.org/delphi/resource/agent/moltbook-vina>, <https://w3id.org/delphi/resource/agent/moltbook-hivefound> .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch07-04> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch07-04--claim-test> .
