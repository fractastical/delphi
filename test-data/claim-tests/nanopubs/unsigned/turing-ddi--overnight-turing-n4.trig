sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/assessment/turing-ddi--claim-test--overnight-turing-n4> a delphi:Assessment ;
    rdfs:label "Claim test of turing-ddi (overnight-turing-n4): refutes, confidence 0.95" ;
    delphi:assessmentType "claim-test/0.1.0" ;
    delphi:hasVerdict "refutes" ;
    delphi:hasConfidence "0.95"^^xsd:double ;
    delphi:hypothesis "Among uniformly sampled four-species interaction sign patterns whose directed interaction graph contains at least one feedback cycle, more than 90% are detected as admitting a diffusion-driven linear instability for at least one of 100 sampled parameter realizations and one non-empty diffusion support." ;
    delphi:passCriterion "A detected Turing-capable fraction greater than 0.9 supports the operational 'almost all' claim; because this is a finite Monte Carlo parameter search, it cannot prove the existential topological claim." ;
    delphi:failCriterion "A two-sided exact Clopper-Pearson 95% interval for the detected Turing-capable fraction lying entirely below 0.9 refutes the pre-registered n=4 operational claim." ;
    delphi:expectedObservation "More than 90% of sampled cyclic n=4 sign patterns are detected as Turing-capable by the fixed finite parameter and wave-number search." ;
    delphi:disconfirmingObservation "The exact 95% binomial interval for the detected-capable fraction lies entirely below 0.9." ;
    delphi:admissibleDatasets "No external dataset; only seeded computational output from the enumerated n=3 and sampled n=4 sign-pattern ensembles." ;
    delphi:inferenceMethod "Count a topology once any sampled stable Jacobian becomes non-Hurwitz after diagonal diffusion at a tested positive wave number; apply a two-sided 95% Clopper-Pearson interval to the n=4 detected-capable count." ;
    delphi:preregistered false ;
    delphi:dataKind "computational" ;
    dct:description "Seed 470003 was fixed before execution. Because no n=3 census existed in the repository, all 3^9 sign patterns and all seven non-empty diffusion supports were first searched with 200 draws per pattern-support pair. Nonzero reaction magnitudes and positive diffusion coefficients were sampled log-uniformly on [0.01, 100], and 121 wave numbers were swept logarithmically on [0.001, 1000]. Then 2,000 distinct n=4 sign patterns were sampled uniformly conditional on a directed cycle, one non-empty support was sampled uniformly for each, and 100 parameter draws were tested. Strict cubic and quartic Routh-Hurwitz inequalities defined stability; capability required stable J and non-Hurwitz J-k^2D at some tested k > 0." ;
    rdfs:comment "Measured: 0.196 detected-capable fraction (n = 2000, exact two-sided Clopper-Pearson 95% interval [0.1788079205547995, 0.21408794619692778]). Interpretation: This operationalizes topology capability as detection within fixed bounded rate, diffusion, and wave-number searches. It directly tests the stated Monte Carlo approach, but non-detection is not a proof that no parameters exist." ;
    delphi:evidenceAgainst "The exact interval lies far below 0.9 and therefore refutes the pre-registered operational n=4 detection claim." ;
    delphi:evidenceAgainst "A finite random parameter search has false negatives for existential capability; consequently this result does not settle or rigorously refute the mathematical conjecture that parameters exist for almost all cyclic topologies." ;
    delphi:evidenceAgainst "The sample can refute the threshold under this fixed procedure but cannot prove 'almost all'; even a detected fraction above 0.9 would only support, not prove, the claim." ;
    delphi:evidenceAgainst "The n=3 baseline exhausts sign patterns and diffusion supports but not the continuous parameter domain, so it is not the interval-certified exact census proposed in the approach file." ;
    delphi:hasEvidence () ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-gpt-5-6-sol> ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/ee98025a1960b300fcc06aa2106f51118b60f565/test-data/claim-tests/math-bio-claims/turing-ddi/overnight-turing-n4/result.json> .
  <https://w3id.org/delphi/resource/claim/turing-ddi> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-ddi--claim-test--overnight-turing-n4> .
}

