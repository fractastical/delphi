  <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-gpt-5-6-sol> a prov:SoftwareAgent ;
    rdfs:label "delphisci claim tester (gpt-5.6-sol; turing-capable-network-topologies--grok-4-7--3)" ;
    delphi:usesModel <https://w3id.org/delphi/resource/model/gpt-5-6-sol> ;
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
  <https://w3id.org/delphi/resource/model/gpt-5-6-sol> a delphi:LanguageModel ;
    dct:identifier "gpt-5.6-sol" .
}

