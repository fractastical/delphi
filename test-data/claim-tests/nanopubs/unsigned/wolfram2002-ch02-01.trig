sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-01--claim-test> a delphi:Assessment ;
    rdfs:label "Claim test of wolfram2002-ch02-01: supports, confidence 0.99" ;
    delphi:assessmentType "claim-test/0.1.0" ;
    delphi:hasVerdict "supports" ;
    delphi:hasConfidence "0.99"^^xsd:double ;
    delphi:hypothesis "Rule 90 evolved from a single black cell produces a pattern in which the triangle of the first 2^k steps is composed exactly of three copies of the triangle of the first 2^(k-1) steps (one on top, two below, with an all-white inverted triangle between them), for every k up to the depth simulated, and its rows coincide with Pascal's triangle modulo 2 as tabulated independently in OEIS A001317." ;
    delphi:passCriterion "Pre-registered: (1) for every k = 1..11 the 2^k-step triangle decomposes exactly (zero mismatching cells) into three copies of the 2^(k-1)-step triangle plus an all-white central inverted triangle; and (2) every simulated row t whose value is present in the OEIS A001317 b-file equals A001317(t) when the row's cells at positions of parity t are read as a binary number (zero mismatching rows)." ;
    delphi:failCriterion "Pre-registered: any cell of the simulated pattern violates the three-copy decomposition at some k <= 11, or any simulated row differs from the independently tabulated A001317 value." ;
    delphi:expectedObservation "Pre-registered: (1) for every k = 1..11 the 2^k-step triangle decomposes exactly (zero mismatching cells) into three copies of the 2^(k-1)-step triangle plus an all-white central inverted triangle; and (2) every simulated row t whose value is present in the OEIS A001317 b-file equals A001317(t) when the row's cells at positions of parity t are read as a binary number (zero mismatching rows)." ;
    delphi:disconfirmingObservation "Pre-registered: any cell of the simulated pattern violates the three-copy decomposition at some k <= 11, or any simulated row differs from the independently tabulated A001317 value." ;
    delphi:admissibleDatasets "Planned datasets: eca-rule90-single-cell-2048-steps, oeis-a001317-bfile" ;
    delphi:inferenceMethod "analysis.py evolves rule 90 from a single black cell for 2048 steps on a 4097-cell line (boundary never reached, asserted). For k = 1..11 it reconstructs the 2^k-row triangle from three translated copies of the 2^(k-1)-row triangle (top centred, bottom copies shifted by -2^(k-1) and +2^(k-1)) over a white background and counts mismatching cells against the simulated triangle, also counting black cells inside the central inverted triangle. It then downloads the OEIS A001317 b-file (3322 terms), reads each simulated row's cells at positions x = -t, -t+2, ..., t as a binary number and compares with A001317(t) for all 2048 rows." ;
    delphi:preregistered false ;
    delphi:dataKind "computational" ;
    dct:description "analysis.py evolves rule 90 from a single black cell for 2048 steps on a 4097-cell line (boundary never reached, asserted). For k = 1..11 it reconstructs the 2^k-row triangle from three translated copies of the 2^(k-1)-row triangle (top centred, bottom copies shifted by -2^(k-1) and +2^(k-1)) over a white background and counts mismatching cells against the simulated triangle, also counting black cells inside the central inverted triangle. It then downloads the OEIS A001317 b-file (3322 terms), reads each simulated row's cells at positions x = -t, -t+2, ..., t as a binary number and compares with A001317(t) for all 2048 rows." ;
    rdfs:comment "Measured: 0 mismatching cells in the three-copy decomposition, summed over k = 1..11 (n = 11180714, exact). Interpretation: 'Nested triangular pieces that all have exactly the same form' is operationalised as exact self-similarity under doubling: the pattern of the first 2^k steps is three translated copies of the pattern of the first 2^(k-1) steps separated by an empty (white) inverted triangle; iterated down to k = 1 this means every triangular piece is a scaled copy of the whole. The rule is the Wolfram rule 90 (new colour = XOR of the two neighbours), started from one black cell on an otherwise white infinite line, which is simulated exactly on a line wide enough that boundaries never matter. As an independent external check the rows are compared with OEIS A001317 (Sierpinski's triangle rows read as binary numbers), which is tabulated independently of any cellular-automaton code." ;
    delphi:evidenceAgainst "Exact self-similarity was verified up to depth 2^11 = 2048 steps; the extension to all depths follows from the row formula a(t,x) = C(t,(t+x)/2) mod 2 and Lucas's theorem, which the OEIS comparison confirms independently for every simulated row but which this test does not prove." ;
    delphi:evidenceAgainst "OEIS A001317 is itself computed from Pascal's triangle mod 2, not from a cellular automaton, so the agreement is a check against an independent construction of the same mathematical object, not against a physical dataset." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-01--claim-test--dataset-1>, <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-01--claim-test--dataset-2> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-claude-fable-5-1> ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/ad1bcb137661aae2fecd70fc14b1ae33fda5f2c9/test-data/claim-tests/wolfram-nks/wolfram2002-ch02-01/result.json> .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-01--claim-test--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Elementary cellular automaton rule 90 from a single black cell, 2048 steps (generated by analysis.py)" ;
    dct:description "the pattern whose nesting is tested" ;
    dct:license "" .
  <https://w3id.org/delphi/resource/evidence/wolfram2002-ch02-01--claim-test--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Dataset: OEIS A001317: Sierpinski's triangle (Pascal's triangle mod 2) converted to decimal, b-file" ;
    dct:description "independent tabulation of rule-90 rows from a single cell (row t read as binary)" ;
    delphi:hasChecksum "sha256:fc61a63ffcdbfe524aee0ebf372f4a91653244cb466a94fba3b5ee48ccb04f19" ;
    prov:atLocation <https://oeis.org/A001317/b001317.txt> ;
    prov:wasDerivedFrom <https://oeis.org/A001317> ;
    dct:license "CC BY-SA 4.0 (OEIS)" .
  <https://w3id.org/delphi/resource/claim/wolfram2002-ch02-01> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/wolfram2002-ch02-01--claim-test> .
}

