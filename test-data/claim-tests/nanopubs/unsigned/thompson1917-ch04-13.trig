sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-13--claim-test> a delphi:Assessment ;
    rdfs:label "Claim test of thompson1917-ch04-13: refutes, confidence 0.9" ;
    delphi:assessmentType "claim-test/0.1.0" ;
    delphi:hasVerdict "refutes" ;
    delphi:hasConfidence "0.9"^^xsd:double ;
    delphi:hypothesis "Across plant and animal species, the gametic (haploid) chromosome number n lies mostly between 6 and 16: the fraction of taxa with n < 6 is small and the fraction with n > 16 is smaller still." ;
    delphi:passCriterion "Pre-registered. Plants: species-level gametic numbers from the Chromosome Counts Database (CCDB) statistics service for all four major groups (Angiosperms, Gymnosperms, Pteridophytes, Bryophytes), using each species' median parsed n. Animals: the Animal Chromosome Count Database (ACC) table (haploid N where given, else 2N/2), one median value per species. For each kingdom compute f_low = fraction of taxa with n < 6, f_mid = fraction with 6 <= n <= 16, f_high = fraction with n > 16, at two resolutions: species level, and genus level (median of species values per genus, the primary resolution, to damp sampling bias toward well-studied genera). Supports if at genus level, in both kingdoms, f_low <= 0.10 and f_high <= 0.10 and f_high <= f_low." ;
    delphi:failCriterion "Refutes if at genus level f_high >= 0.25 in either kingdom (more than a quarter of genera above 16 is not 'fewer still'), or if f_high > f_low in both kingdoms (the upper tail is the larger tail, inverting the claim). Mixed otherwise (e.g. one kingdom satisfies the bounds and the other does not, without reaching the refutation thresholds)." ;
    delphi:expectedObservation "Pre-registered. Plants: species-level gametic numbers from the Chromosome Counts Database (CCDB) statistics service for all four major groups (Angiosperms, Gymnosperms, Pteridophytes, Bryophytes), using each species' median parsed n. Animals: the Animal Chromosome Count Database (ACC) table (haploid N where given, else 2N/2), one median value per species. For each kingdom compute f_low = fraction of taxa with n < 6, f_mid = fraction with 6 <= n <= 16, f_high = fraction with n > 16, at two resolutions: species level, and genus level (median of species values per genus, the primary resolution, to damp sampling bias toward well-studied genera). Supports if at genus level, in both kingdoms, f_low <= 0.10 and f_high <= 0.10 and f_high <= f_low." ;
    delphi:disconfirmingObservation "Refutes if at genus level f_high >= 0.25 in either kingdom (more than a quarter of genera above 16 is not 'fewer still'), or if f_high > f_low in both kingdoms (the upper tail is the larger tail, inverting the claim). Mixed otherwise (e.g. one kingdom satisfies the bounds and the other does not, without reaching the refutation thresholds)." ;
    delphi:admissibleDatasets "Planned datasets: ccdb-statistics-by-major-group, acc-animal-chromosome-counts" ;
    delphi:inferenceMethod "Fetched the CCDB statistics CSV for each of the four plant major groups (69,948 species rows; median parsed n per species) and parsed the ACC data table embedded in its download page (12,221 animal records; haploid N where given, else 2N/2). Collapsed to one median value per species and per genus, then computed the fractions of taxa with n < 6, 6 <= n <= 16 and n > 16 for plants and animals at both resolutions, plus breakdowns by plant major group and animal phylum and a histogram (derived/histograms.csv)." ;
    delphi:preregistered false ;
    dct:description "Fetched the CCDB statistics CSV for each of the four plant major groups (69,948 species rows; median parsed n per species) and parsed the ACC data table embedded in its download page (12,221 animal records; haploid N where given, else 2N/2). Collapsed to one median value per species and per genus, then computed the fractions of taxa with n < 6, 6 <= n <= 16 and n > 16 for plants and animals at both resolutions, plus breakdowns by plant major group and animal phylum and a histogram (derived/histograms.csv)." ;
    rdfs:comment "Measured: 0.4119205298013245 fraction of animal genera with haploid n > 16 (plant genera: 0.320); fraction with n < 6: animals 0.080, plants 0.011 (n = 13699, database census; genus-level n = 8414 plant and 5285 animal genera, species-level n = 64926 and 12221). Interpretation: Thompson's 'germ-nuclei' chromosome number is the gametic number n (half the somatic 2n), which both databases provide or allow (CCDB parses counts to gametophytic n; ACC lists N or 2N). 'Few' and 'fewer still' are read as tail fractions of at most 10%, with the upper tail no larger than the lower. The claim is about organisms generally, so species (or genera) are the units, each counted once, with no phylogenetic weighting; the species-level figures are reported alongside the primary genus-level ones. Databases are biased toward studied taxa (crops, insects, vertebrates), which is noted but not corrected beyond the genus-level aggregation." ;
    delphi:evidenceAgainst "The lower bound holds (only 1.1% of plant genera and 8.0% of animal genera have n < 6) and the modal haploid number (9-13) sits inside Thompson's 6-16 window, so the claim is half right; what fails is the upper bound: 32% of plant genera and 41% of animal genera have n > 16, so the upper tail is roughly 30 and 5 times larger than the lower tail, the reverse of 'fewer still'." ;
    delphi:evidenceAgainst "Both databases over-represent studied taxa (crops, insects, vertebrates) and plants are counted as gametophytic numbers including polyploids (hexaploid wheat is n = 21). Even taking the most favourable subsets (gymnosperms 5.8% > 16; bryophytes 11%), ferns (96% > 16), vertebrates (74%) and molluscs (60%) leave the general claim refuted." ;
    delphi:evidenceAgainst "ACC records with non-numeric or range entries for 2N and N were dropped; odd 2N values (XO systems) give half-integer n, which does not affect the 6-16 binning." ;
    delphi:evidenceAgainst "Thompson wrote in 1917 from a handful of counted species; the finding reflects a century of counting rather than an error in his reading of the data available to him." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-13--claim-test--dataset-1>, <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-13--claim-test--dataset-2> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-claude-fable-5-1> ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/f0720a27be6412b9705e2f221a1710c8442283e3/test-data/claim-tests/thompson-growth-form/thompson1917-ch04-13/result.json> .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-13--claim-test--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Chromosome Counts Database (CCDB), species-level statistics for Angiosperms, Gymnosperms, Pteridophytes, Bryophytes" ;
    dct:description "median parsed gametophytic chromosome number n per plant species" ;
    delphi:hasChecksum "sha256:c97736983a98cca240ddce9af3db1ecc5d020534a0dd84f2637f09105e1fdfc2" ;
    prov:atLocation <https://ccdb.tau.ac.il/services/statistics/?majorGroup=Angiosperms&format=csv> ;
    delphi:hasChecksum "sha256:4711c9757315b9f8f791586a67211176ee677bba50a885bf21cd2a033630317d" ;
    prov:atLocation <https://ccdb.tau.ac.il/services/statistics/?majorGroup=Gymnosperms&format=csv> ;
    delphi:hasChecksum "sha256:a6a6c7cce021a960711a00c52069687d55b9e82527eedbd2dc971b32cd2cb141" ;
    prov:atLocation <https://ccdb.tau.ac.il/services/statistics/?majorGroup=Pteridophytes&format=csv> ;
    delphi:hasChecksum "sha256:20d9ea1b469199d13c5e94dab13c4c09549bc7a796126f66c7a7f47c1b3c6028" ;
    prov:atLocation <https://ccdb.tau.ac.il/services/statistics/?majorGroup=Bryophytes&format=csv> ;
    prov:wasDerivedFrom <https://ccdb.tau.ac.il/> ;
    dct:license "CC BY (CCDB terms; Rice et al. 2015)" .
  <https://w3id.org/delphi/resource/evidence/thompson1917-ch04-13--claim-test--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Animal Chromosome Count Database (ACC; Roman-Palacios et al. 2021), table embedded in the download page" ;
    dct:description "2N and N per animal record, reduced to one median haploid value per species" ;
    delphi:hasChecksum "sha256:0ccf654f2b4dfe655a9ce287c961163c722bd153dd35596526fa63c8f2854680" ;
    prov:atLocation <https://cromanpa94.github.io/ACC/category/download.html> ;
    prov:wasDerivedFrom <https://cromanpa94.github.io/ACC/> ;
    dct:license "see repository LICENSE.md (github.com/cromanpa94/ACC)" .
  <https://w3id.org/delphi/resource/claim/thompson1917-ch04-13> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/thompson1917-ch04-13--claim-test> .
}

