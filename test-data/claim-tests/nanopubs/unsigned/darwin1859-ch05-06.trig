    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-06--claim-test> a delphi:Assessment ;
    rdfs:label "Claim test of darwin1859-ch05-06: supports, confidence 0.8" ;
    delphi:assessmentType "claim-test/0.1.0" ;
    delphi:hasVerdict "supports" ;
    delphi:hasConfidence "0.8"^^xsd:double ;
    delphi:hypothesis "In a phylogeny containing obligate cave (troglobitic/stygobitic) animals and surface animals from North America and Europe, each cave lineage is nested among, or sister to, taxa of its own continent; American and European cave taxa do not form clades with each other to the exclusion of surface taxa." ;
    delphi:passCriterion "Pre-registered. Using the Open Tree of Life synthetic tree induced on the taxa listed in derived/taxa.csv (continent assignment verified with GBIF occurrences), for every cave taxon compute the node-count distance to the nearest same-continent taxon (cave or surface, d_same) and to the nearest other-continent cave taxon (d_othercave). The claim is SUPPORTED if (i) d_same <= d_othercave for at least 70% of cave taxa, and (ii) the induced tree contains no clade that includes at least one North American and at least one European cave taxon while containing no surface taxon ('exclusive transcontinental cave clade')." ;
    delphi:failCriterion "Pre-registered. The claim is REFUTED if fewer than 50% of cave taxa satisfy d_same <= d_othercave, or if two or more independent exclusive transcontinental cave clades occur (in different taxonomic groups). Results between the two thresholds, or a single such clade, are recorded as 'mixed'. If fewer than 10 cave taxa (across at least 3 groups) can be placed in the tree, the verdict is inconclusive/underpowered." ;
    delphi:expectedObservation "Pre-registered. Using the Open Tree of Life synthetic tree induced on the taxa listed in derived/taxa.csv (continent assignment verified with GBIF occurrences), for every cave taxon compute the node-count distance to the nearest same-continent taxon (cave or surface, d_same) and to the nearest other-continent cave taxon (d_othercave). The claim is SUPPORTED if (i) d_same <= d_othercave for at least 70% of cave taxa, and (ii) the induced tree contains no clade that includes at least one North American and at least one European cave taxon while containing no surface taxon ('exclusive transcontinental cave clade')." ;
    delphi:disconfirmingObservation "Pre-registered. The claim is REFUTED if fewer than 50% of cave taxa satisfy d_same <= d_othercave, or if two or more independent exclusive transcontinental cave clades occur (in different taxonomic groups). Results between the two thresholds, or a single such clade, are recorded as 'mixed'. If fewer than 10 cave taxa (across at least 3 groups) can be placed in the tree, the verdict is inconclusive/underpowered." ;
    delphi:admissibleDatasets "Planned datasets: open-tree-of-life-synth-v15, gbif-occurrence-api" ;
    delphi:inferenceMethod "81 pre-registered species (40 obligate cave, 41 surface; 5 groups) were matched to Open Tree taxonomy with the TNRS (1 unmatched: Neaphaenops tellkampfi), and their continent was checked against GBIF occurrence counts in North America vs Europe (1 dropped: Crangonyx pseudogracilis, now mostly recorded in Europe where it is introduced). The induced subtree of synthetic tree opentree16.1 was requested for the remaining 79 taxa. For each of the 38 cave taxa the node-count distance to the nearest same-continent taxon and to the nearest other-continent cave taxon was computed, and all clades were scanned for ones containing cave taxa of both continents but no surface taxon." ;
    delphi:preregistered false ;
    delphi:dataKind "biological" ;
    dct:description "81 pre-registered species (40 obligate cave, 41 surface; 5 groups) were matched to Open Tree taxonomy with the TNRS (1 unmatched: Neaphaenops tellkampfi), and their continent was checked against GBIF occurrence counts in North America vs Europe (1 dropped: Crangonyx pseudogracilis, now mostly recorded in Europe where it is introduced). The induced subtree of synthetic tree opentree16.1 was requested for the remaining 79 taxa. For each of the 38 cave taxa the node-count distance to the nearest same-continent taxon and to the nearest other-continent cave taxon was computed, and all clades were scanned for ones containing cave taxa of both continents but no surface taxon." ;
    rdfs:comment "Measured: 0.9474 fraction of cave taxa with nearest same-continent taxon at least as close as nearest other-continent cave taxon (n = 38, 95% Wilson CI [0.827, 0.985]). Interpretation: Darwin's 'cave-animals of America' and 'of Europe' are read as obligate subterranean species of North America and Europe; 'affinities to the other inhabitants of that continent' is read as phylogenetic relationship (sister-group or nesting) to surface lineages of the same continent, versus the alternative he rejects, that the two continents' cave faunas are specially allied to each other. Taxa were chosen before any tree was inspected and are listed in derived/taxa.csv; groups are Amphibia (Urodela), Amphipoda, Isopoda, Coleoptera (Trechini and Leiodidae) and Orthoptera (Rhaphidophoridae), the groups in which both continents have well-known troglobites. Continent assignment of each species is verified post hoc against GBIF: a species is kept only if at least 90% of its GBIF occurrences on the two continents fall on the pre-registered continent; names that the Open Tree TNRS cannot match are dropped. Phylogenetic 'affinity' is measured by node counts on the synthetic tree because it has no branch lengths; polytomies produce ties, which count in favour of whichever criterion they satisfy (a tie between a same-continent and an other-continent cave neighbour satisfies d_same <= d_othercave)." ;
    delphi:evidenceAgainst "The synthetic tree has no branch lengths and several groups are poorly resolved (Asellidae genera, Niphargus/Crangonyctidae, Cholevinae), so node-count distances are coarse; both failing cases (Monolistra caeca, Ptomaphagus hirtus) arise where the induced tree places same-continent relatives in a deeper or unresolved position, and Ptomaphagus hirtus sits in a Staphylinoidea polytomy with the European Leptodirini." ;
    delphi:evidenceAgainst "The surface comparators are a pre-registered selection, not an exhaustive sample of each continent's fauna; adding taxa could only shorten d_same, so the design is lenient toward the claim in that respect, but the second criterion (no exclusive transcontinental cave clade) does not depend on how many surface taxa were sampled within the included families." ;
    delphi:evidenceAgainst "Proteus anguinus (Europe) is sister to Necturus (North America, surface) in the tree: a transatlantic family-level link that is not a cave-to-cave link; d_same for Proteus is the distance to European Salamandridae." ;
    delphi:evidenceAgainst "No European obligate cave fishes were available, so Amblyopsidae were not included; the cross-continent comparison therefore covers salamanders, amphipods, isopods, beetles and cave crickets only." ;
    delphi:evidenceAgainst "Open Tree synthesis is itself built from published phylogenies plus taxonomy, so this is a test against the current synthesis of the literature rather than a de novo molecular analysis." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--claim-test--dataset-1>, <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--claim-test--dataset-2> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-claim-tester-claude-fable-5-1> ;
    rdfs:seeAlso <https://github.com/fractastical/delphisci/blob/1a9d4d282b93b0233edbeefd3225299a7353333a/test-data/claim-tests/darwin-origin/darwin1859-ch05-06/result.json> .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--claim-test--dataset-1> a delphi:EvidenceItem ;
    rdfs:label "Dataset: Open Tree of Life synthetic tree (current version via API v3)" ;
    dct:description "phylogenetic placement of cave and surface taxa (induced subtree, TNRS matching)" ;
    delphi:hasChecksum "sha256:aa8103ee4fe56d946d224583eeccbcc1294fdb6bafbfb2f6ba2c44897c5b317c" ;
    prov:atLocation <https://api.opentreeoflife.org/v3/tree_of_life/about> ;
    delphi:hasChecksum "sha256:c467178741c7503f0e6a3258d86ab413e0ae4877db354ce29aea544d279196f1" ;
    prov:atLocation <https://api.opentreeoflife.org/v3/tnrs/match_names> ;
    delphi:hasChecksum "sha256:f98b7a617ce645fe0afe8bc24f6278516a4f7a70ae3b04594dfd0e32dab7154b" ;
    prov:atLocation <https://api.opentreeoflife.org/v3/tree_of_life/induced_subtree> ;
    prov:wasDerivedFrom <https://tree.opentreeoflife.org/> ;
    dct:license "CC0 1.0" .
  <https://w3id.org/delphi/resource/evidence/darwin1859-ch05-06--claim-test--dataset-2> a delphi:EvidenceItem ;
    rdfs:label "Dataset: GBIF occurrence search API (continent facet)" ;
    dct:description "verification of the continent of each sampled species" ;
    delphi:hasChecksum "sha256:d52b6600e5cef86aff400612f7b8c1043d6995d459800c0442720d8dfcacda66" ;
    rdfs:comment "Location (not a URL): https://api.gbif.org/v1/species/match and https://api.gbif.org/v1/occurrence/search?limit=0&taxonKey=<k>&continent=<c> (per-call list in derived/files.json)" ;
    prov:wasDerivedFrom <https://www.gbif.org/occurrence/search> ;
    dct:license "varies by dataset (CC0 / CC BY / CC BY-NC); counts only used here" .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch05-06> delphi:hasAssessment <https://w3id.org/delphi/resource/assessment/darwin1859-ch05-06--claim-test> .
}

